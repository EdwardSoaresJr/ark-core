e === 'light') return 'light';\\n\n            if (preference === 'system') return media.matches ? 'dark' : 'light';\\n\n            return media.matches ? 'dark' : 'light';\\n\n        };\\n\n\\n\n        const apply = (resolved) => {\\n\n            const isDark = resolved === 'dark';\\n\n            document.documentElement.classList.toggle('dark', isDark);\\n\n            document.documentElement.setAttribute('data-bs-theme', resolved);\\n\n            document.documentElement.style.colorScheme = resolved;\\n\n            // Legacy key kept as last-resolved paint hint only \u2014 never the preference authority.\\n\n            try {\\n\n                localStorage.setItem('ark_theme', resolved);\\n\n                localStorage.removeItem('hs_theme');\\n\n            } catch (_) {}\\n\n        };\\n\n\\n\n        apply(resolve());\\n\n\\n\n        if (preference === 'system') {\\n\n            const onChange = () => apply(resolve());\\n\n            if (typeof media.addEventListener === 'function') {\\n\n                media.addEventListener('change', onChange);\\n\n            } else if (typeof media.addListener === 'function') {\\n\n                media.addListener(onChange);\\n\n            }\\n\n        }\\n\n\\n\n        window.arkApplyDisplayThemePreference = (nextPreference) => {\\n\n            const next = nextPreference === 'dark' || nextPreference === 'light' || nextPreference === 'system'\\n\n                ? nextPreference\\n\n                : 'light';\\n\n            const resolved = next === 'system'\\n\n                ? (media.matches ? 'dark' : 'light')\\n\n                : next;\\n\n            document.documentElement.setAttribute('data-ark-display-theme-preference', next);\\n\n            apply(resolved);\\n\n        };\\n\n\\n\n        document.documentElement.setAttribute('data-ark-display-theme-preference', preference);\\n\n\\n\n        window.arkToggleTheme = () => {\\n\n            const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';\\n\n            window.arkApplyDisplayThemePreference(nextTheme);\\n\n\\n\n            const token = document.querySelector('meta[name=\"csrf-token\"]')?.content;\\n\n            const url = \"http:\\/\\/localhost\\/app\\/profile\\/display-theme\";\\n\n            if (!token || !url) {\\n\n                return;\\n\n            }\\n\n\\n\n            fetch(url, {\\n\n                method: 'PATCH',\\n\n                headers: {\\n\n                    'Content-Type': 'application/json',\\n\n                    Accept: 'application/json',\\n\n                    'X-CSRF-TOKEN': token,\\n\n                },\\n\n                body: JSON.stringify({ display_theme: nextTheme }),\\n\n                credentials: 'same-origin',\\n\n            }).catch(() => {});\\n\n        };\\n\n    })();\\n\n</script>\\n\n    <title>Inspection \u00b7 RO #1</title>\\n\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/favicon/favicon.ico\">\\n\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/favicon/ark-32x32.png\">\\n\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/favicon/ark-16x16.png\">\\n\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/ios/ark-180x180.png\">\\n\n<link rel=\"manifest\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/manifest.json\">\\n\n        <script>\\n\n    window.arkShopChannel = (name) => '' + name;\\n\n</script>\\n\n    <!-- vite: resources/css/app.css,resources/css/tabler.css,resources/js/app.js,resources/js/tabler.js --></head>\\n\n<body>\\n\n    <div class=\"page\" data-inspection-tablet-shell>\\n\n        <div class=\"page-wrapper\">\\n\n            <main>\\n\n                <div class=\"page-body\" data-inspection-surface=\"tablet\">\\n\n            <div class=\"container-narrow d-flex flex-column gap-3\">\\n\n                <header class=\"card\" data-inspection-tablet-header>\\n\n                    <div class=\"card-body p-3\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm\" style=\"min-width: 0\">\\n\n                                <div class=\"subheader\">Vehicle inspection</div>\\n\n                                <h1 class=\"mb-1 text-break\">2016 Toyota Tacoma</h1>\\n\n                                <div class=\"text-secondary fw-medium\">\\n\n                                    RO #1\\n\n                                    \u00b7 <span data-inspection-coverage>0 of 41 checked \u00b7 41 remaining</span>\\n\n                                </div>\\n\n                            </div>\\n\n                                                            <div class=\"col-12 col-sm-auto\">\\n\n                                    <a href=\"http://localhost/app/repair-orders/1/inspection?surface=tablet\" class=\"btn btn-lg w-100\" data-inspection-sections-back>\\n\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n                                        Back to sections\\n\n                                    </a>\\n\n                                </div>\\n\n                                                    </div>\\n\n                    </div>\\n\n                </header>\\n\n\\n\n                \\n\n                                    <div\\n\n    class=\"d-flex flex-column gap-3\"\\n\n    id=\"inspection-walk\"\\n\n    data-inspection-walk\\n\n    data-surface=\"tablet\"\\n\n    x-data=\"arkInspectionWalk(JSON.parse('{\\u0022updateUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/points\\\\\\/2\\u0022,\\u0022csrf\\u0022:\\u0022t4ICRaWJ4o7aApB32xHzouVECmsr7nLrvChHrEmX\\u0022,\\u0022currentStatus\\u0022:null,\\u0022note\\u0022:\\u0022\\u0022,\\u0022measurementValue\\u0022:\\u0022\\u0022,\\u0022measurementUnit\\u0022:\\u0022\\\\\\/32\\\\u0022\\u0022,\\u0022measurementSlots\\u0022:[{\\u0022key\\u0022:\\u0022outer\\u0022,\\u0022name\\u0022:\\u0022Outer\\u0022,\\u0022unit\\u0022:\\u0022\\\\\\/32\\\\u0022\\u0022,\\u0022required\\u0022:true,\\u0022type\\u0022:\\u0022number\\u0022,\\u0022value\\u0022:\\u0022\\u0022},{\\u0022key\\u0022:\\u0022center\\u0022,\\u0022name\\u0022:\\u0022Center\\u0022,\\u0022unit\\u0022:\\u0022\\\\\\/32\\\\u0022\\u0022,\\u0022required\\u0022:true,\\u0022type\\u0022:\\u0022number\\u0022,\\u0022value\\u0022:\\u0022\\u0022},{\\u0022key\\u0022:\\u0022inner\\u0022,\\u0022name\\u0022:\\u0022Inner\\u0022,\\u0022unit\\u0022:\\u0022\\\\\\/32\\\\u0022\\u0022,\\u0022required\\u0022:true,\\u0022type\\u0022:\\u0022number\\u0022,\\u0022value\\u0022:\\u0022\\u0022},{\\u0022key\\u0022:\\u0022psi\\u0022,\\u0022name\\u0022:\\u0022Pressure\\u0022,\\u0022unit\\u0022:\\u0022PSI\\u0022,\\u0022required\\u0022:true,\\u0022type\\u0022:\\u0022number\\u0022,\\u0022value\\u0022:\\u0022\\u0022}],\\u0022rearAxleBrakeType\\u0022:null,\\u0022isAxleGate\\u0022:false,\\u0022roadTestFindingLocked\\u0022:false,\\u0022roadTestForceNa\\u0022:false,\\u0022brakePrompts\\u0022:[],\\u0022missingSlots\\u0022:[\\u0022Outer\\u0022,\\u0022Center\\u0022,\\u0022Inner\\u0022,\\u0022Pressure\\u0022]}'))\"\\n\n>\\n\n    <div class=\"card\">\\n\n        <div class=\"card-body p-3\">\\n\n            <div class=\"d-flex align-items-start gap-2\">\\n\n                <div class=\"flex-fill\" style=\"min-width: 0\">\\n\n                    <div class=\"small text-secondary\">\\n\n                                                    Standard Vehicle Inspection \u00b7\\n\n                                                Point 2 of 41\\n\n                        \u00b7 0/41 checked\\n\n                    </div>\\n\n                    <h2 class=\"mb-0 text-break h1\" data-inspection-walk-title>LF Tire</h2>\\n\n                                            <div class=\"text-secondary\">Left Front</div>\\n\n                                    </div>\\n\n                            </div>\\n\n\\n\n                            <div class=\"progress progress-sm mt-3\" aria-hidden=\"true\" data-inspection-walk-meter>\\n\n                    <div class=\"progress-bar\" style=\"width: 0%\"></div>\\n\n                </div>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n            <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-lg-7 d-flex flex-column gap-3\">\\n\n    \\n\n            <section class=\"card\" aria-labelledby=\"inspection-condition-heading\">\\n\n            <div class=\"card-body p-3\">\\n\n                <h3 id=\"inspection-condition-heading\" class=\"card-title mb-2\">\\n\n                                            Condition\\n\n                                    </h3>\\n\n                                                            <div class=\"row g-2\" role=\"group\" aria-label=\"Set condition\">\\n\n                                                            <div class=\"col-6\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-xl w-100 h-100 px-2 text-wrap\"\\n\n                                        :class=\"currentStatus === 'good' ? 'btn-success' : 'btn-outline-success'\"\\n\n                                        :aria-pressed=\"currentStatus === 'good' ? 'true' : 'false'\"\\n\n                                        data-condition=\"good\"\\n\n                                        x-on:click=\"setCondition('good')\"\\n\n                                    >Good</button>\\n\n                                </div>\\n\n                                                            <div class=\"col-6\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-xl w-100 h-100 px-2 text-wrap\"\\n\n                                        :class=\"currentStatus === 'monitor' ? 'btn-warning' : 'btn-outline-warning'\"\\n\n                                        :aria-pressed=\"currentStatus === 'monitor' ? 'true' : 'false'\"\\n\n                                        data-condition=\"monitor\"\\n\n                                        x-on:click=\"setCondition('monitor')\"\\n\n                                    >Monitor</button>\\n\n                                </div>\\n\n                                                            <div class=\"col-6\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-xl w-100 h-100 px-2 text-wrap\"\\n\n                                        :class=\"currentStatus === 'needs_attention' ? 'btn-danger' : 'btn-outline-danger'\"\\n\n                                        :aria-pressed=\"currentStatus === 'needs_attention' ? 'true' : 'false'\"\\n\n                                        data-condition=\"needs_attention\"\\n\n                                        x-on:click=\"setCondition('needs_attention')\"\\n\n                                    >Needs Attention</button>\\n\n                                </div>\\n\n                                                            <div class=\"col-6\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-xl w-100 h-100 px-2 text-wrap\"\\n\n                                        :class=\"currentStatus === 'failed' ? 'btn-danger' : 'btn-outline-danger'\"\\n\n                                        :aria-pressed=\"currentStatus === 'failed' ? 'true' : 'false'\"\\n\n                                        data-condition=\"failed\"\\n\n                                        x-on:click=\"setCondition('failed')\"\\n\n                                    >Failed</button>\\n\n                                </div>\\n\n                                                            <div class=\"col-12\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-xl w-100 h-100 px-2 text-wrap\"\\n\n                                        :class=\"currentStatus === 'na' ? 'btn-secondary' : 'btn-outline-secondary'\"\\n\n                                        :aria-pressed=\"currentStatus === 'na' ? 'true' : 'false'\"\\n\n                                        data-condition=\"na\"\\n\n                                        x-on:click=\"setCondition('na')\"\\n\n                                    >N/A</button>\\n\n                                </div>\\n\n                                                    </div>\\n\n                                        <div class=\"small mt-2\" aria-live=\"polite\">\\n\n                        <span class=\"text-secondary\" x-show=\"saving\" x-cloak>Saving\u2026</span>\\n\n                        <span class=\"text-success\" x-show=\"saved\" x-cloak>Saved</span>\\n\n                        <span class=\"text-danger\" x-show=\"saveError\" x-cloak>Save failed - tap condition again to retry</span>\\n\n                    </div>\\n\n                            </div>\\n\n        </section>\\n\n    \\n\n                </div>\\n\n            <div class=\"col-12 col-lg-5 d-flex flex-column gap-3\">\\n\n    \\n\n            <section class=\"card\" aria-labelledby=\"inspection-measurement-heading\">\\n\n            <div class=\"card-body p-3\">\\n\n                <h3 id=\"inspection-measurement-heading\" class=\"card-title mb-2\">\\n\n                    Measurements\\n\n                                            <span class=\"text-danger\">\u00b7 required</span>\\n\n                                    </h3>\\n\n                                    <div class=\"d-flex flex-column gap-2\">\\n\n                        <template x-for=\"(slot, index) in measurementSlots\" :key=\"slot.key\">\\n\n                            <div class=\"row g-2 align-items-center\">\\n\n                                <label class=\"col-5 col-sm-4 col-form-label\" :for=\"'inspection-slot-' + slot.key\" x-text=\"slot.name + (slot.required ? ' *' : '')\"></label>\\n\n                                <div class=\"col\">\\n\n                                    <template x-if=\"slot.type === 'condition'\">\\n\n                                        <select\\n\n                                            class=\"form-select form-select-lg\"\\n\n                                            :id=\"'inspection-slot-' + slot.key\"\\n\n                                            x-model=\"slot.value\"\\n\n                                            x-on:change=\"saveSlots()\"\\n\n                                        >\\n\n                                            <option value=\"\">-</option>\\n\n                                            <option value=\"good\">Good</option>\\n\n                                            <option value=\"monitor\">Monitor</option>\\n\n                                            <option value=\"needs_attention\">Needs Attention</option>\\n\n                                            <option value=\"failed\">Failed</option>\\n\n                                            <option value=\"na\">N/A</option>\\n\n                                        </select>\\n\n                                    </template>\\n\n                                    <template x-if=\"slot.type !== 'condition'\">\\n\n                                        <div class=\"input-group input-group-lg\">\\n\n                                            <input\\n\n                                                type=\"text\"\\n\n                                                class=\"form-control\"\\n\n                                                :id=\"'inspection-slot-' + slot.key\"\\n\n                                                :placeholder=\"slot.name\"\\n\n                                                x-model=\"slot.value\"\\n\n                                                x-on:change.debounce.500ms=\"saveSlots()\"\\n\n                                                inputmode=\"decimal\"\\n\n                                            >\\n\n                                            <span class=\"input-group-text\" x-show=\"slot.unit\" x-text=\"slot.unit\"></span>\\n\n                                        </div>\\n\n                                    </template>\\n\n                                </div>\\n\n                            </div>\\n\n                        </template>\\n\n                    </div>\\n\n                    <p class=\"small text-secondary mt-2 mb-0\" x-show=\"missingSlots.length\" x-cloak>\\n\n                        Still needed: <span x-text=\"missingSlots.join(', ')\"></span>\\n\n                    </p>\\n\n                            </div>\\n\n        </section>\\n\n    \\n\n    <template x-if=\"brakePrompts.length\">\\n\n        <section class=\"alert alert-info mb-0\" aria-label=\"Brake comparison\">\\n\n            <template x-for=\"(prompt, index) in brakePrompts\" :key=\"index\">\\n\n                <div class=\"mb-2\">\\n\n                    <div class=\"fw-bold\" x-text=\"prompt.message\"></div>\\n\n                    <div class=\"text-secondary\" x-text=\"prompt.helper\"></div>\\n\n                </div>\\n\n            </template>\\n\n        </section>\\n\n    </template>\\n\n\\n\n    \\n\n                        <section class=\"card\" aria-labelledby=\"inspection-camera-heading\" data-inspection-walk-camera>\\n\n                <div class=\"card-body p-3\">\\n\n                    <h3 id=\"inspection-camera-heading\" class=\"card-title mb-2\">Photo</h3>\\n\n                    <form\\n\n                        method=\"post\"\\n\n                        action=\"http://localhost/app/repair-orders/1/inspection/items/2/photos?surface=tablet\"\\n\n                        enctype=\"multipart/form-data\"\\n\n                        class=\"mb-3\"\\n\n                        data-inspection-walk-upload\\n\n                    >\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"t4ICRaWJ4o7aApB32xHzouVECmsr7nLrvChHrEmX\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"surface\" value=\"tablet\">\\n\n                        <input type=\"hidden\" name=\"purpose\" value=\"internal\">\\n\n                        <label class=\"btn btn-primary btn-xl w-100\">\\n\n                            Take photo\\n\n                            <input\\n\n                                type=\"file\"\\n\n                                name=\"photo\"\\n\n                                accept=\"image/jpeg,image/png,image/webp\"\\n\n                                capture=\"environment\"\\n\n                                class=\"visually-hidden\"\\n\n                                onchange=\"this.form.submit()\"\\n\n                            >\\n\n                        </label>\\n\n                    </form>\\n\n                    <div class=\"row g-2\" data-inspection-walk-evidence>\\n\n                    <div class=\"col-4 col-sm-3\">\\n\n                <div class=\"ratio ratio-1x1 rounded border overflow-hidden\">\\n\n                                            <button\\n\n                            type=\"button\"\\n\n                            class=\"btn p-0 border-0 w-100 h-100\"\\n\n                            data-ops-lightbox=\"http://localhost/app/repair-orders/1/inspection/photos/1\"\\n\n                            data-ops-lightbox-alt=\"LF Tire\"\\n\n                            aria-label=\"View photo larger\"\\n\n                        >\\n\n                            <img\\n\n                                src=\"http://localhost/app/repair-orders/1/inspection/photos/1\"\\n\n                                alt=\"\"\\n\n                                class=\"w-100 h-100 object-fit-cover\"\\n\n                            >\\n\n                        </button>\\n\n                                    </div>\\n\n\\n\n                                    <form\\n\n                        method=\"post\"\\n\n                        action=\"http://localhost/app/repair-orders/1/inspection/photos/1\"\\n\n                        class=\"mt-1\"\\n\n                        onsubmit=\"return confirm('Remove this photo?');\"\\n\n                        data-inspection-walk-evidence-delete\\n\n                    >\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"t4ICRaWJ4o7aApB32xHzouVECmsr7nLrvChHrEmX\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"_method\" value=\"delete\">                                                    <input type=\"hidden\" name=\"surface\" value=\"tablet\">\\n\n                                                <button\\n\n                            type=\"submit\"\\n\n                            class=\"btn btn-ghost-danger w-100\"\\n\n                            aria-label=\"Remove photo\"\\n\n                            title=\"Remove photo\"\\n\n                        >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 7l16 0\"/><path d=\"M10 11l0 6\"/><path d=\"M14 11l0 6\"/><path d=\"M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12\"/><path d=\"M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3\"/></svg>\\n\n                            Remove\\n\n                        </button>\\n\n                    </form>\\n\n                            </div>\\n\n            </div>\\n\n                </div>\\n\n            </section>\\n\n        \\n\n        <section class=\"card\" data-inspection-walk-more>\\n\n            <div class=\"accordion accordion-flush\">\\n\n                <div class=\"accordion-item\">\\n\n                    <h3 class=\"accordion-header\" id=\"inspection-walk-more-heading\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"accordion-button py-3 collapsed\"\\n\n                            data-bs-toggle=\"collapse\"\\n\n                            data-bs-target=\"#inspection-walk-more\"\\n\n                            aria-controls=\"inspection-walk-more\"\\n\n                            aria-expanded=\"false\"\\n\n                        >Previous visit &amp; notes</button>\\n\n                    </h3>\\n\n                    <div\\n\n                        id=\"inspection-walk-more\"\\n\n                        class=\"accordion-collapse collapse\"\\n\n                        aria-labelledby=\"inspection-walk-more-heading\"\\n\n                    >\\n\n                        <div class=\"accordion-body d-flex flex-column gap-3\">\\n\n                            <section aria-labelledby=\"inspection-prior-heading\">\\n\n                                <h4 id=\"inspection-prior-heading\" class=\"subheader mb-2\">Previous visit</h4>\\n\n                                                                    <div class=\"text-secondary\">No prior history for this inspection point yet.</div>\\n\n                                                            </section>\\n\n\\n\n                            <section aria-labelledby=\"inspection-note-heading\">\\n\n                                <h4 id=\"inspection-note-heading\" class=\"subheader mb-2\">\\n\n                                                                            <label for=\"inspection-walk-note\" class=\"mb-0\">Notes</label>\\n\n                                                                    </h4>\\n\n                                                                    <textarea\\n\n                                        id=\"inspection-walk-note\"\\n\n                                        rows=\"3\"\\n\n                                        class=\"form-control form-control-lg\"\\n\n                                        placeholder=\"Optional note for this inspection point\"\\n\n                                        x-model=\"note\"\\n\n                                        x-on:change.debounce.500ms=\"saveNote()\"\\n\n                                    ></textarea>\\n\n                                                            </section>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </section>\\n\n    \\n\n                </div>\\n\n        </div>\\n\n\\n\n        <nav class=\"sticky-bottom bg-body border-top py-2\" aria-label=\"Walk navigation\" data-inspection-walk-nav>\\n\n            <div class=\"row g-2 align-items-center\">\\n\n                <div class=\"col\">\\n\n                                            <a href=\"http://localhost/app/repair-orders/1/inspection?point=1&amp;surface=tablet\" class=\"btn btn-lg w-100\" data-inspection-walk-prior>\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n                            Prev\\n\n                        </a>\\n\n                                    </div>\\n\n                <div class=\"col-auto fw-bold text-secondary\">2/41</div>\\n\n                <div class=\"col\">\\n\n                                            <a href=\"http://localhost/app/repair-orders/1/inspection?point=3&amp;surface=tablet\" class=\"btn btn-primary btn-lg w-100\" data-inspection-walk-next>\\n\n                            Next\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M13 18l6 -6\"/><path d=\"M13 6l6 6\"/></svg>\\n\n                        </a>\\n\n                                    </div>\\n\n            </div>\\n\n        </nav>\\n\n    </div>\\n\n                \\n\n                <section class=\"card\" data-inspection-other-findings>\\n\n                    <div class=\"accordion accordion-flush\">\\n\n                        <div class=\"accordion-item\">\\n\n                            <h2 class=\"accordion-header\" id=\"inspection-other-findings-title\">\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"accordion-button py-3 fs-3 collapsed\"\\n\n                                    data-bs-toggle=\"collapse\"\\n\n                                    data-bs-target=\"#inspection-other-findings\"\\n\n                                    aria-controls=\"inspection-other-findings\"\\n\n                                    aria-expanded=\"false\"\\n\n                                >Other Findings</button>\\n\n                            </h2>\\n\n                            <div\\n\n                                id=\"inspection-other-findings\"\\n\n                                class=\"accordion-collapse collapse\"\\n\n                                aria-labelledby=\"inspection-other-findings-title\"\\n\n                            >\\n\n                                <div class=\"accordion-body\">\\n\n                                    <p class=\"text-secondary mb-3\">See something that wasn't covered above? Add it here.</p>\\n\n                                    <div\\n\n    data-inspection-capture\\n\n    x-data=\"{\\n\n        open: false,\\n\n        intent: 'safety',\\n\n        showNote: false,\\n\n        showFab: false,\\n\n        init() {\\n\n            if (! this.$refs.primaryBtn) {\\n\n                return;\\n\n            }\\n\n\\n\n            const observer = new IntersectionObserver(([entry]) => {\\n\n                this.showFab = ! entry.isIntersecting && ! this.open;\\n\n            }, { threshold: 0.15 });\\n\n\\n\n            observer.observe(this.$refs.primaryBtn);\\n\n\\n\n            this.$watch('open', (value) => {\\n\n                if (value) {\\n\n                    this.showFab = false;\\n\n                }\\n\n            });\\n\n        },\\n\n        openCapture() {\\n\n            this.open = true;\\n\n            document.body.classList.add('overflow-hidden');\\n\n            this.$nextTick(() => this.$refs.titleInput?.focus());\\n\n        },\\n\n        closeCapture() {\\n\n            this.open = false;\\n\n            document.body.classList.remove('overflow-hidden');\\n\n\\n\n            const url = new URL(window.location.href);\\n\n\\n\n            if (url.searchParams.has('capture') || url.searchParams.has('concern')) {\\n\n                url.searchParams.delete('capture');\\n\n                url.searchParams.delete('concern');\\n\n                const query = url.searchParams.toString();\\n\n                window.history.replaceState({}, '', url.pathname + (query ? `?${query}` : '') + url.hash);\\n\n            }\\n\n        },\\n\n    }\"\\n\n    x-on:ark-open-finding-capture.window=\"openCapture()\"\\n\n    x-on:keydown.escape.window=\"if (open) closeCapture()\"\\n\n            x-on:keydown.n.window=\"\\n\n            if (open || $event.target.closest('input, textarea, select, [contenteditable=true]')) return;\\n\n            $event.preventDefault();\\n\n            openCapture();\\n\n        \"\\n\n    >\\n\n            <button\\n\n            type=\"button\"\\n\n            class=\"btn btn-primary btn-lg w-100\"\\n\n            data-inspection-finding-btn\\n\n            x-ref=\"primaryBtn\"\\n\n            x-on:click=\"openCapture()\"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M5 12l14 0\"/></svg>\\n\n            Add Finding\\n\n        </button>\\n\n    \\n\n    <div x-show=\"open\" x-cloak x-transition.opacity>\\n\n        <div class=\"modal-backdrop show\" x-on:click=\"closeCapture()\"></div>\\n\n        <div\\n\n            class=\"modal d-block\"\\n\n            tabindex=\"-1\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            aria-labelledby=\"finding-capture-title\"\\n\n            x-on:click.self=\"closeCapture()\"\\n\n            data-inspection-capture-sheet\\n\n        >\\n\n            <div class=\"modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n                <form\\n\n                    method=\"post\"\\n\n                    action=\"http://localhost/app/repair-orders/1/inspection/findings\"\\n\n                    enctype=\"multipart/form-data\"\\n\n                    class=\"modal-content\"\\n\n                >\\n\n                    <div class=\"modal-header\">\\n\n                        <h2 id=\"finding-capture-title\" class=\"modal-title\">Record finding</h2>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close\" x-on:click=\"closeCapture()\"></button>\\n\n                    </div>\\n\n\\n\n                    <div class=\"modal-body\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"t4ICRaWJ4o7aApB32xHzouVECmsr7nLrvChHrEmX\" autocomplete=\"off\">\\n\n                        <input type=\"hidden\" name=\"intent\" x-model=\"intent\">\\n\n\\n\n                        <fieldset class=\"mb-2\">\\n\n                            <legend class=\"visually-hidden\">Finding intent</legend>\\n\n                            <div class=\"btn-list\">\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'safety' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'safety' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'safety'\"\\n\n                                    >Safety</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'maintenance' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'maintenance' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'maintenance'\"\\n\n                                    >Maintenance</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'diagnostic' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'diagnostic' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'diagnostic'\"\\n\n                                    >Diagnostic</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'verification' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'verification' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'verification'\"\\n\n                                    >Verification</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'observation' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'observation' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'observation'\"\\n\n                                    >Observation</button>\\n\n                                                            </div>\\n\n                        </fieldset>\\n\n\\n\n                        <p class=\"form-hint mb-3\">\\n\n                            Finding intent describes the condition - not part source, OEM/aftermarket type, or warranty. Use part line fields when selling parts.\\n\n                        </p>\\n\n\\n\n                        <div class=\"mb-3\">\\n\n                            <label class=\"form-label\" for=\"finding-capture-label\">What did you find?</label>\\n\n                            <input\\n\n                                type=\"text\"\\n\n                                id=\"finding-capture-label\"\\n\n