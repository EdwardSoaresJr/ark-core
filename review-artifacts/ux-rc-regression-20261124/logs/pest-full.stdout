ap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5\"/></svg>\\n\n                    Check In\\n\n                </a>\\n\n            </div>\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\" class=\"d-flex\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"p2qZFGeEJdKKPA99urYKnJIfxOOsbmSB6cz8Vl5O\" autocomplete=\"off\">            <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:18:28+00:00\">\\n\n            <button type=\"submit\" class=\"btn btn-sm w-100\" data-comms-work-unread>\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                Mark unread\\n\n            </button>\\n\n        </form>\\n\n    </div>\\n\n                </section>\\n\n            \\n\n            <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-vehicle\">\\n\n                <div class=\"subheader mb-1\" id=\"comms-context-vehicle\">Vehicle &amp; visit</div>\\n\n                                                    <div class=\"text-secondary small\">No current visit</div>\\n\n                                            </section>\\n\n\\n\n            <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-visits\">\\n\n                <div class=\"subheader mb-1\" id=\"comms-context-visits\">Recent visits</div>\\n\n                                    <div class=\"text-secondary small\">No visits yet</div>\\n\n                            </section>\\n\n        </div>\\n\n    </div>\\n\n            </aside>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"p2qZFGeEJdKKPA99urYKnJIfxOOsbmSB6cz8Vl5O\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox\",\"disabled_reason\":null},{\"id\":\"nav.reports\",\"title\":\"Reports\",\"group\":\"Navigate\",\"keywords\":[\"reports\",\"end of day\",\"operational\"],\"url\":\"http:\\/\\/localhost\\/app\\/reports\",\"disabled_reason\":null},{\"id\":\"create.repair-order\",\"title\":\"New Repair Order\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"ro\",\"repair\",\"intake\",\"check in\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.customer\",\"title\":\"New Customer\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"customer\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.vehicle\",\"title\":\"New Vehicle\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"vehicle\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.appointment\",\"title\":\"New Appointment\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"appointment\",\"schedule\"],\"url\":\"http:\\/\\/localhost\\/app\\/appointments\\/create\",\"disabled_reason\":null},{\"id\":\"create.message\",\"title\":\"New Message\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"message\",\"text\",\"sms\",\"email\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose\",\"disabled_reason\":null},{\"id\":\"create.sms\",\"title\":\"New SMS\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"sms\",\"text\",\"phone\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=sms\",\"disabled_reason\":null},{\"id\":\"create.email\",\"title\":\"New Email\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"email\",\"mail\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=email\",\"disabled_reason\":null},{\"id\":\"search.customer\",\"title\":\"Search Customers\",\"group\":\"Search\",\"keywords\":[\"search\",\"customer\",\"phone\",\"name\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.vehicle\",\"title\":\"Search Vehicles\",\"group\":\"Search\",\"keywords\":[\"search\",\"vehicle\",\"vin\",\"plate\",\"license\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.vin\",\"title\":\"Search by VIN\",\"group\":\"Search\",\"keywords\":[\"search\",\"vin\",\"vehicle\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.plate\",\"title\":\"Search by License Plate\",\"group\":\"Search\",\"keywords\":[\"search\",\"plate\",\"license\",\"tag\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.phone\",\"title\":\"Search by Phone\",\"group\":\"Search\",\"keywords\":[\"search\",\"phone\",\"customer\",\"number\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.repair-order\",\"title\":\"Search Repair Orders\",\"group\":\"Search\",\"keywords\":[\"search\",\"ro\",\"repair\",\"order\",\"number\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.estimate\",\"title\":\"Search Estimates\",\"group\":\"Search\",\"keywords\":[\"search\",\"estimate\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.invoice\",\"title\":\"Search Invoices\",\"group\":\"Search\",\"keywords\":[\"search\",\"invoice\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"ops.print-key-tag\",\"title\":\"Print Key Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"key\",\"tag\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-oil-sticker\",\"title\":\"Print Oil Sticker\",\"group\":\"Operations\",\"keywords\":[\"print\",\"oil\",\"sticker\",\"change\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-service-tag\",\"title\":\"Print Service Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"service\",\"tag\",\"tech\",\"sheet\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.take-payment\",\"title\":\"Take Payment\",\"group\":\"Operations\",\"keywords\":[\"payment\",\"pay\",\"square\",\"collect\",\"balance\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.record-deposit\",\"title\":\"Record Deposit\",\"group\":\"Operations\",\"keywords\":[\"deposit\",\"payment\",\"record\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.open-active-ro\",\"title\":\"Open Active RO\",\"group\":\"Operations\",\"keywords\":[\"active\",\"ro\",\"open\",\"workboard\",\"repair\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null}]</script>\\n\n        <div class=\"modal d-block\" tabindex=\"-1\">\\n\n            <div class=\"modal-backdrop show z-0\" data-ops-global-search-backdrop></div>\\n\n            <div\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable\"\\n\n                data-ops-global-search-dialog\\n\n                role=\"dialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-label=\"Command palette\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header p-2\">\\n\n                        <label class=\"visually-hidden\" for=\"ops-global-search-input\">Search commands and records</label>\\n\n                        <div class=\"input-icon w-100\">\\n\n                            <span class=\"input-icon-addon\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                            </span>\\n\n                            <input\\n\n                                id=\"ops-global-search-input\"\\n\n                                type=\"search\"\\n\n                                class=\"form-control form-control-lg\"\\n\n                                data-ops-global-search-input\\n\n                                placeholder=\"Type a command or search\u2026\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"modal-body p-0\">\\n\n                        <div class=\"list-group list-group-flush\" data-ops-global-search-results>\\n\n                            <div class=\"list-group-item small text-secondary\">\u2318K \u00b7 Enter runs \u00b7 Esc closes</div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <div\\n\n    x-data=\"arkLearnGuideModal()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ark-learn-guide-modal\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"title || 'ARKademy guide'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close guide preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header align-items-start\">\\n\n                    <div class=\"overflow-hidden\">\\n\n                        <div class=\"subheader\" x-show=\"sectionLabel\" x-text=\"sectionLabel\"></div>\\n\n                        <h2 class=\"modal-title\" x-text=\"title || 'ARKademy'\"></h2>\\n\n                        <div class=\"small text-secondary\" x-show=\"summary\" x-text=\"summary\"></div>\\n\n                    </div>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"close()\" aria-label=\"Close\"></button>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-body\">\\n\n                    <div class=\"text-secondary\" x-show=\"loading\">\\n\n                        <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading guide\u2026\\n\n                    </div>\\n\n                    <div class=\"alert alert-danger mb-0\" role=\"alert\" x-show=\"error\" x-text=\"error\"></div>\\n\n                    \\n\n                    <div\\n\n                        class=\"ark-legacy bg-white text-dark rounded p-3 ops-learn-prose ops-learn-guide-modal__prose\"\\n\n                        x-show=\"! loading && ! error && html\"\\n\n                        x-html=\"html\"\\n\n                    ></div>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-footer\">\\n\n                                            <div class=\"small text-secondary me-auto\">Preview from ARK - open ARKademy for search, print, and full navigation.</div>\\n\n                                        <button type=\"button\" class=\"btn\" @click=\"close()\">Close</button>\\n\n                                            <a\\n\n                            :href=\"arkademyUrl\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-primary\"\\n\n                            x-show=\"arkademyUrl\"\\n\n                        >\\n\n                            Open in ARKademy\\n\n                        </a>\\n\n                                    </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n    <div x-data=\"arkCommsInterrupt()\" data-ark-comms-interrupt data-conversation-url-template=\"http://localhost/app/communications/inbox?conversation=__CONVERSATION__\" data-waiting-url=\"http://localhost/app/communications/inbox?filter=needs\">\\n\n        <div x-show=\"activeCall !== null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"callInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeCall\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-green\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"d-flex align-items-start gap-2\">\\n\n                                    <div class=\"flex-fill overflow-hidden\">\\n\n                                        <div class=\"small fw-bold text-uppercase text-green\" x-text=\"callEyebrow()\"></div>\\n\n                                        <template x-if=\"activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0 text-truncate\" x-text=\"activeCall.customer_name\"></div>\\n\n                                        </template>\\n\n                                        <template x-if=\"! activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0\">Unknown Caller</div>\\n\n                                        </template>\\n\n                                        <div class=\"text-secondary\" x-text=\"activeCall.display_phone\"></div>\\n\n                                        <template x-if=\"activeCall.owned_by_name\">\\n\n                                            <div class=\"small text-secondary mt-1\" x-text=\"ownerLabel()\"></div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                    <button type=\"button\" class=\"btn btn-sm\" @click=\"dismissCall()\">Dismiss</button>\\n\n                                </div>\\n\n\\n\n                                <template x-if=\"activeCall.matched\">\\n\n                                    <div class=\"mt-2\">\\n\n                                        <div class=\"small fw-medium text-truncate\" x-text=\"vehicleSummary()\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"openRoSummary()\"></div>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeCall.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeCall.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeCall.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeCall.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall.matched && previewOpenRos().length > 0\">\\n\n                                    <div class=\"list-group mt-2\">\\n\n                                        <template x-for=\"openRepairOrder in previewOpenRos()\" :key=\"openRepairOrder.repair_order_id\">\\n\n                                            <a\\n\n                                                :href=\"openRepairOrder.url\"\\n\n                                                class=\"list-group-item list-group-item-action d-flex align-items-center gap-2 small\"\\n\n                                                @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                            >\\n\n                                                <span class=\"fw-bold text-nowrap\" x-text=\"'RO #' + openRepairOrder.repair_order_id\"></span>\\n\n                                                <span class=\"flex-fill text-truncate text-secondary\" x-text=\"openRepairOrder.vehicle_name\"></span>\\n\n                                                <span class=\"text-secondary text-nowrap\" x-text=\"openRepairOrder.status_label\"></span>\\n\n                                            </a>\\n\n                                        </template>\\n\n                                        <template x-if=\"extraOpenRoCount() > 0 && activeCall.customer_url\">\\n\n                                            <a :href=\"activeCall.customer_url\" class=\"list-group-item list-group-item-action small\" @click=\"markCallHandledForId(activeCall.call_session_id)\">\\n\n                                                +<span x-text=\"extraOpenRoCount()\"></span> more on Customer Hub\\n\n                                            </a>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"lastConversationSnippet()\">\\n\n                                    <p class=\"small text-secondary mt-2 mb-0\" x-text=\"lastConversationSnippet()\"></p>\\n\n                                </template>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther() && activeCall.show_callback_action\"\\n\n                                    type=\"button\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"window.arkInitiateTelephonyCallback?.({\\n\n                                        customerId: activeCall.callback_customer_id,\\n\n                                        phone: activeCall.callback_phone,\\n\n                                        callSessionId: activeCall.call_session_id,\\n\n                                        button: $event.currentTarget,\\n\n                                    }); activeCall = null;\"\\n\n                                >Callback</button>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && activeCall.matched && activeCall.customer_url\"\\n\n                                    :href=\"activeCall.customer_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Open Customer</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched && activeCall.create_contact_url\"\\n\n                                    :href=\"activeCall.create_contact_url\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Create Contact</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched\"\\n\n                                    :href=\"activeCall.intake_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Start Check In</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther()\"\\n\n                                    :href=\"activeCall.lookup_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Caller Lookup</a>\\n\n\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther()\"\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-ghost-secondary\"\\n\n                                    @click=\"markCallHandled()\"\\n\n                                >Mark Handled</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"activeMessage !== null && activeCall === null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"messageInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeMessage\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-azure\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"small fw-bold text-uppercase text-azure\" x-text=\"channelLabel()\"></div>\\n\n                                <div class=\"h3 mb-0 text-truncate\" x-text=\"activeMessage.headline ?? 'Unknown'\"></div>\\n\n                                <div class=\"text-secondary\" x-text=\"activeMessage.display_phone\"></div>\\n\n\\n\n                                <p\\n\n                                    class=\"fw-medium text-break mt-2 mb-0\"\\n\n                                    x-show=\"snippetPreview() !== ''\"\\n\n                                    x-text=\"snippetPreview()\"\\n\n                                ></p>\\n\n                                <a\\n\n                                    x-show=\"moreCount > 0 && waitingUrl() !== ''\"\\n\n                                    :href=\"waitingUrl()\"\\n\n                                    class=\"d-inline-block small mt-2\"\\n\n                                    data-comms-interrupt-more\\n\n                                    x-text=\"moreLabel()\"\\n\n                                ></a>\\n\n                                <template x-if=\"activeMessage?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeMessage.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeMessage.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeMessage.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeMessage.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n                                <template x-if=\"messageAttachments().length > 0\">\\n\n                                    <div class=\"d-grid gap-2 mt-2\">\\n\n                                        <template x-for=\"attachment in messageAttachments()\" :key=\"attachment.id\">\\n\n                                            <template x-if=\"attachment.is_image && attachment.url\">\\n\n                                                <button\\n\n                                                    type=\"button\"\\n\n                                                    class=\"btn p-0 border-0 w-100\"\\n\n                                                    :data-ops-lightbox=\"attachment.url\"\\n\n                                                    data-ops-lightbox-alt=\"Message attachment\"\\n\n                                                    aria-label=\"View attachment\"\\n\n                                                >\\n\n                                                    <img\\n\n                                                        :src=\"attachment.url\"\\n\n                                                        alt=\"Attachment\"\\n\n                                                        class=\"w-100 rounded border object-fit-cover\"\\n\n                                                        style=\"max-height: 9rem\"\\n\n                                                    >\\n\n                                                </button>\\n\n                                            </template>\\n\n                                            <template x-if=\"attachment.is_video && attachment.url\">\\n\n                                                <video\\n\n                                                    controls\\n\n                                                    class=\"w-100 rounded border\"\\n\n                                                    style=\"max-height: 9rem\"\\n\n                                                    preload=\"metadata\"\\n\n                                                >\\n\n                                                    <source :src=\"attachment.url\" :type=\"attachment.content_type\">\\n\n                                                </video>\\n\n                                            </template>\\n\n                                            <template x-if=\"attachment.is_audio && attachment.url\">\\n\n                                                <audio\\n\n                                                    controls\\n\n                                                    class=\"w-100\"\\n\n                                                    preload=\"metadata\"\\n\n                                                >\\n\n                                                    <source :src=\"attachment.url\" :type=\"attachment.content_type\">\\n\n                                                </audio>\\n\n                                            </template>\\n\n                                            <template x-if=\"! attachment.is_image && ! attachment.is_video && ! attachment.is_audio && attachment.url\">\\n\n                                                <a\\n\n                                                    :href=\"attachment.url\"\\n\n                                                    target=\"_blank\"\\n\n                                                    rel=\"noopener\"\\n\n                                                    class=\"btn btn-sm\"\\n\n                                                    x-text=\"attachment.is_pdf ? 'PDF attachment' : 'Download attachment'\"\\n\n                                                ></a>\\n\n                                            </template>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n                                <p\\n\n                                    class=\"small text-secondary mt-2 mb-0\"\\n\n                                    x-show=\"activeMessage.context_summary\"\\n\n                                    x-text=\"activeMessage.context_summary\"\\n\n                                ></p>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind === 'website_lead' && activeMessage?.intake_url\"\\n\n                                    :href=\"activeMessage.intake_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"openWebsiteLeadIntake($event)\"\\n\n                                >Check In</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind === 'portal' && activeMessage?.repair_order_url\"\\n\n                                    :href=\"activeMessage.repair_order_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"activeMessage?.show_mark_read_action ? markMessageRead() : dismissPortal()\"\\n\n                                >Open RO</a>\\n\n                                <a\\n\n                                    x-show=\"(activeMessage?.kind === 'sms' || activeMessage?.kind === 'mms') && conversationUrl() !== ''\"\\n\n                                    :href=\"conversationUrl()\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    data-comms-interrupt-open\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"openConversation($event)\"\\n\n                                >Open conversation</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind !== 'portal' && activeMessage?.direction === 'inbound' && activeMessage?.reply_url\"\\n\n                                    :href=\"activeMessage.reply_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"replyToMessage($event)\"\\n\n                                >Reply</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.matched && activeMessage?.customer_url\"\\n\n                                    :href=\"activeMessage.customer_url\"\\n\n                                    class=\"btn\"\\n\n                                >Open Customer</a>\\n\n                                <a\\n\n                                    x-show=\"! activeMessage?.matched && activeMessage?.create_contact_url && activeMessage?.kind !== 'website_lead'\"\\n\n                                    :href=\"activeMessage.create_contact_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                >Create Contact</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind === 'website_lead' && ! activeMessage?.matched && activeMessage?.create_contact_url\"\\n\n                                    :href=\"activeMessage.create_contact_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"dismissWebsiteLead()\"\\n\n                                >Create contact</a>\\n\n                                <a\\n\n                                    x-show=\"! activeMessage?.matched && activeMessage?.intake_url && ! activeMessage?.reply_url && activeMessage?.kind !== 'website_lead'\"\\n\n                                    :href=\"activeMessage.intake_url\"\\n\n                                    class=\"btn\"\\n\n                                >Start Check In</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.lookup_url\"\\n\n                                    :href=\"activeMessage.lookup_url\"\\n\n                                    class=\"btn\"\\n\n                                >Lookup</a>\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-ghost-secondary\"\\n\n                                    @click=\"activeMessage?.kind === 'website_lead'\\n\n                                        ? dismissWebsiteLead()\\n\n                                        : (activeMessage?.kind === 'portal' ? dismissPortal() : dismissMessage())\"\\n\n                                >Dismiss</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    