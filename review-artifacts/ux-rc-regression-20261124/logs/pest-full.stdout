,\\n\n            laborGuideMenu: false,\\n\n            laborGuideDefaultKey: 'rte',\\n\n            laborGuideItems: JSON.parse('[{\\u0022key\\u0022:\\u0022rte\\u0022,\\u0022label\\u0022:\\u0022Labor Guide\\u0022,\\u0022kind\\u0022:\\u0022rte\\u0022,\\u0022can_open\\u0022:true,\\u0022can_pull_quote\\u0022:false,\\u0022title\\u0022:\\u0022Labor times are not imported on this environment.\\u0022,\\u0022blocked_reason\\u0022:\\u0022Labor times are not imported on this environment.\\u0022,\\u0022labor_guide\\u0022:null},{\\u0022key\\u0022:\\u0022alldata\\u0022,\\u0022label\\u0022:\\u0022AllData\\u0022,\\u0022kind\\u0022:\\u0022external\\u0022,\\u0022can_open\\u0022:true,\\u0022can_pull_quote\\u0022:false,\\u0022title\\u0022:\\u0022Open AllData - VIN copied for vehicle search\\u0022,\\u0022blocked_reason\\u0022:null,\\u0022labor_guide\\u0022:{\\u0022url\\u0022:\\u0022https:\\\\\\/\\\\\\/my.alldata.com\\\\\\/repair\\u0022,\\u0022vin\\u0022:\\u00222HGFC2F59MH123456\\u0022,\\u0022notice\\u0022:\\u0022AllData: VIN 2HGFC2F59MH123456 copied to clipboard. After sign-in, paste the VIN into the guide vehicle search. These guides do not load vehicle data from ARK URLs yet. Vehicle: 2021 Honda Civic. Scope: Brake inspection.\\u0022,\\u0022windowName\\u0022:\\u0022ark-labor-alldata-ro-1\\u0022}},{\\u0022key\\u0022:\\u0022prodemand\\u0022,\\u0022label\\u0022:\\u0022ProDemand\\u0022,\\u0022kind\\u0022:\\u0022external\\u0022,\\u0022can_open\\u0022:true,\\u0022can_pull_quote\\u0022:false,\\u0022title\\u0022:\\u0022Open ProDemand - VIN copied for vehicle search\\u0022,\\u0022blocked_reason\\u0022:null,\\u0022labor_guide\\u0022:{\\u0022url\\u0022:\\u0022https:\\\\\\/\\\\\\/www.prodemand.com\\u0022,\\u0022vin\\u0022:\\u00222HGFC2F59MH123456\\u0022,\\u0022notice\\u0022:\\u0022ProDemand: VIN 2HGFC2F59MH123456 copied to clipboard. After sign-in, paste the VIN into the guide vehicle search. These guides do not load vehicle data from ARK URLs yet. Vehicle: 2021 Honda Civic. Scope: Brake inspection.\\u0022,\\u0022windowName\\u0022:\\u0022ark-labor-prodemand-ro-1\\u0022}}]'),\\n\n            estimateToolbarPersistUrl: 'http:\\/\\/localhost\\/app\\/estimate-toolbar\\/default',\\n\n            estimateContext: null,\\n\n            clearLaborGuideNotice() {\\n\n                this.laborGuideNotice = '';\\n\n            },\\n\n            partsCatalogSelected() {\\n\n                const catalogs = this.partsCatalogItems.filter((item) => item.mode === 'catalog');\\n\n\\n\n                if (catalogs.length) {\\n\n                    return catalogs.find((item) => item.key === this.partsCatalogSelectedKey) || catalogs[0] || null;\\n\n                }\\n\n\\n\n                return this.partsCatalogItems.find((item) => item.key === this.partsCatalogSelectedKey) || this.partsCatalogItems[0] || null;\\n\n            },\\n\n            partsCatalogByKey(key) {\\n\n                return this.partsCatalogItems.find((item) => item.key === key) || null;\\n\n            },\\n\n            activatePartsCatalogItem(item) {\\n\n                if (! item) {\\n\n                    return;\\n\n                }\\n\n\\n\n                if (item.mode === 'link') {\\n\n                    this.openPartsCatalog(item.key);\\n\n                    this.partsCatalogMenu = false;\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                this.selectPartsCatalog(item.key);\\n\n            },\\n\n            selectPartsCatalog(key) {\\n\n                if (! this.partsCatalogByKey(key)) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.partsCatalogSelectedKey = key;\\n\n                this.partsCatalogMenu = false;\\n\n            },\\n\n            laborGuidePrimary() {\\n\n                return this.laborGuideItems.find((item) => item.key === this.laborGuideDefaultKey) || this.laborGuideItems[0] || null;\\n\n            },\\n\n            laborGuideSecondary() {\\n\n                const key = this.laborGuidePrimary()?.key;\\n\n\\n\n                return this.laborGuideItems.filter((item) => item.key !== key);\\n\n            },\\n\n            focusLaborGuideConcern() {\\n\n                const sections = [...document.querySelectorAll('section[id^=concern-]')]\\n\n                    .filter((el) => /^concern-\\d+$/.test(el.id));\\n\n\\n\n                if (sections.length === 0 || ! this.rteLabor) {\\n\n                    return;\\n\n                }\\n\n\\n\n                const nearest = sections\\n\n                    .map((el) => ({ el, top: el.getBoundingClientRect().top }))\\n\n                    .sort((a, b) => Math.abs(a.top - 140) - Math.abs(b.top - 140))[0];\\n\n                const id = Number(nearest.el.id.replace('concern-', ''));\\n\n\\n\n                if (Number.isFinite(id)) {\\n\n                    this.rteLabor.concernId = id;\\n\n                }\\n\n            },\\n\n            runLaborGuideItem(item) {\\n\n                if (! item) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.focusLaborGuideConcern();\\n\n                this.laborGuideMenu = false;\\n\n\\n\n                if (item.kind === 'rte') {\\n\n                    this.openRteLaborGuide();\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                if (item.labor_guide) {\\n\n                    this.openLaborGuide(\\n\n                        item.labor_guide.url,\\n\n                        item.labor_guide.vin,\\n\n                        item.labor_guide.notice,\\n\n                        item.labor_guide.windowName,\\n\n                    );\\n\n                }\\n\n            },\\n\n            setEstimateToolbarDefault(kind, key) {\\n\n                if (kind === 'parts_catalog') {\\n\n                    this.partsCatalogDefaultKey = key;\\n\n                    this.partsCatalogSelectedKey = key;\\n\n                    this.partsCatalogMenu = false;\\n\n                } else {\\n\n                    this.laborGuideDefaultKey = key;\\n\n                    this.laborGuideMenu = false;\\n\n                }\\n\n\\n\n                const token = document.querySelector('meta[name=csrf-token]')?.content || '';\\n\n\\n\n                fetch(this.estimateToolbarPersistUrl, {\\n\n                    method: 'POST',\\n\n                    headers: {\\n\n                        'Content-Type': 'application/json',\\n\n                        Accept: 'application/json',\\n\n                        'X-CSRF-TOKEN': token,\\n\n                        'X-Requested-With': 'XMLHttpRequest',\\n\n                    },\\n\n                    body: JSON.stringify({ kind, key }),\\n\n                }).catch(() => {});\\n\n            },\\n\n            initEstimateContextFromHash() {\\n\n                const hash = (window.location.hash || '').replace(/^#/, '');\\n\n\\n\n                if (hash === 'auth' || hash === 'authorization-rail') {\\n\n                    this.estimateContext = 'auth';\\n\n                } else if (hash === 'portal' || hash === 'portal-rail' || hash === 'customer-view') {\\n\n                    this.estimateContext = 'portal';\\n\n                } else if (hash === 'parts' || hash === 'parts-rail') {\\n\n                    this.estimateContext = 'parts';\\n\n                }\\n\n            },\\n\n            toggleEstimateContext(name) {\\n\n                this.estimateContext = this.estimateContext === name ? null : name;\\n\n            },\\n\n            openPartsCatalog(key, forceCartSwitch = false, concernId = null) {\\n\n                const catalog = this.partsCatalogByKey(key);\\n\n                this.partsCatalogActionLabel = catalog?.label || '';\\n\n\\n\n                if (key === 'partstech') {\\n\n                    return this.openPartsTechCatalog(forceCartSwitch, concernId);\\n\n                }\\n\n\\n\n                if (catalog?.launch) {\\n\n                    this.openLaborGuide(\\n\n                        catalog.launch.url,\\n\n                        catalog.launch.vin,\\n\n                        catalog.launch.notice,\\n\n                        catalog.launch.windowName || (catalog.mode === 'link' ? '_blank' : null),\\n\n                    );\\n\n                }\\n\n            },\\n\n            pullPartsCatalogQuote(key) {\\n\n                if (key !== 'partstech' || this.partsCatalogSelectedKey !== 'partstech') {\\n\n                    return;\\n\n                }\\n\n\\n\n                const catalog = this.partsCatalogByKey(key);\\n\n                this.partsCatalogActionLabel = catalog?.cart_label || catalog?.label || '';\\n\n\\n\n                this.$dispatch(\\n\n                    'ark:partstech-pull-quote',\\n\n                    this.partstechPreferredConcernId ? { concernId: this.partstechPreferredConcernId } : {},\\n\n                );\\n\n            },\\n\n            partsTechCatalogUrlWithConcern(catalogUrl, concernId) {\\n\n                if (! catalogUrl || ! concernId) {\\n\n                    return catalogUrl;\\n\n                }\\n\n\\n\n                try {\\n\n                    const url = new URL(catalogUrl);\\n\n\\n\n                    url.searchParams.set('concern_id', String(concernId));\\n\n\\n\n                    return url.toString();\\n\n                } catch {\\n\n                    return catalogUrl;\\n\n                }\\n\n            },\\n\n            async openPartsTechCatalog(forceCartSwitch = false, concernId = null) {\\n\n                if (! this.partstechCatalogUrl || this.partstechCatalogOpening || this.partstechPullLoading) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.partstechPreferredConcernId = concernId != null && concernId !== ''\\n\n                    ? String(concernId)\\n\n                    : '';\\n\n\\n\n                this.partstechPoCopied = false;\\n\n\\n\n                if (this.partstechPoNumber) {\\n\n                    try {\\n\n                        await navigator.clipboard.writeText(this.partstechPoNumber);\\n\n                        this.partstechPoCopied = true;\\n\n                    } catch {\\n\n                        this.partstechPoCopied = false;\\n\n                    }\\n\n                }\\n\n\\n\n                let catalogUrl = this.partstechCatalogUrl;\\n\n                const preferredConcernId = this.partstechPreferredConcernId || null;\\n\n\\n\n                let stampedOrderCount = 0;\\n\n\\n\n                if (this.partstechPrepareUrl) {\\n\n                    this.partstechCatalogOpening = true;\\n\n\\n\n                    try {\\n\n                        const response = await fetch(this.partstechPrepareUrl, {\\n\n                            method: 'POST',\\n\n                            credentials: 'same-origin',\\n\n                            headers: {\\n\n                                Accept: 'application/json',\\n\n                                'Content-Type': 'application/json',\\n\n                                'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]')?.content || '',\\n\n                            },\\n\n                            body: JSON.stringify({\\n\n                                force_cart_switch: forceCartSwitch,\\n\n                                concern_id: preferredConcernId,\\n\n                            }),\\n\n                        });\\n\n\\n\n                        const payload = await response.json().catch(() => ({}));\\n\n\\n\n                        if (payload?.cart_locked) {\\n\n                            this.partstechCartLocked = true;\\n\n                            this.partstechBlockingReference = payload?.blocking_cart_reference || '';\\n\n                            this.partstechNotice = payload?.message || 'PartsTech is busy on another repair order.';\\n\n\\n\n                            return;\\n\n                        }\\n\n\\n\n                        if (! response.ok && ! payload?.catalog_url) {\\n\n                            this.partstechNotice = payload?.message || 'PartsTech Catalog is unavailable.';\\n\n\\n\n                            return;\\n\n                        }\\n\n\\n\n                        this.partstechCartLocked = false;\\n\n                        this.partstechBlockingReference = '';\\n\n\\n\n                        if (payload?.catalog_url) {\\n\n                            catalogUrl = payload.catalog_url;\\n\n                        }\\n\n\\n\n                        stampedOrderCount = Number(payload?.stamped_order_count || 0);\\n\n\\n\n                        if (! response.ok || payload?.prepared === false) {\\n\n                            const loginHint = payload?.partstech_login\\n\n                                ? 'Sign into PartsTech in your browser as ' + payload.partstech_login + '. '\\n\n                                : 'Sign into PartsTech using the same login ARK uses for your profile (or shop default). ';\\n\n\\n\n                            this.partstechNotice = payload?.message || (loginHint + 'Confirm PO shows ' + (this.partstechPoNumber || 'R{RO}') + ' after ARK prepares the cart.');\\n\n                        } else {\\n\n                            const notices = [];\\n\n\\n\n                            if (payload?.partstech_login) {\\n\n                                const seat = payload?.partstech_login_source === 'user'\\n\n                                    ? 'Using your PartsTech account (' + payload.partstech_login + ')'\\n\n                                    : 'Using the shop PartsTech account (' + payload.partstech_login + ')';\\n\n                                notices.push(seat + ' \u00b7 PO ' + (payload.cart_reference || this.partstechPoNumber || 'R{RO}'));\\n\n                            }\\n\n\\n\n                            if (Array.isArray(payload?.warnings)) {\\n\n                                payload.warnings.forEach((warning) => {\\n\n                                    if (warning) {\\n\n                                        notices.push(warning);\\n\n                                    }\\n\n                                });\\n\n                            }\\n\n\\n\n                            this.partstechNotice = notices.join(' ');\\n\n                        }\\n\n                    } catch {\\n\n                        this.partstechNotice = 'Could not reach ARK to prepare the PartsTech cart. Opening catalog anyway.';\\n\n                    } finally {\\n\n                        this.partstechCatalogOpening = false;\\n\n                    }\\n\n                }\\n\n\\n\n                catalogUrl = this.partsTechCatalogUrlWithConcern(catalogUrl, preferredConcernId);\\n\n\\n\n                if (this.partstechCatalogWarning && ! this.partstechCartLocked && ! this.partstechNotice) {\\n\n                    this.partstechNotice = this.partstechCatalogWarning;\\n\n                }\\n\n\\n\n                if (! this.partstechCartLocked) {\\n\n                    this.partstechNotice = this.partsTechPastePoNotice(this.partstechNotice);\\n\n                }\\n\n\\n\n                this.partstechOpenedCatalogUrl = catalogUrl;\\n\n                this.partstechLastStampedOrders = stampedOrderCount;\\n\n                this.partstechCatalogWindow = window.open(catalogUrl, 'ark-partstech-catalog');\\n\n                window.dispatchEvent(new CustomEvent('ark:partstech-launched', {\\n\n                    detail: { repairOrderId: 1, concernId: preferredConcernId, catalogWindow: this.partstechCatalogWindow },\\n\n                }));\\n\n                this.startPartsTechPoWatch();\\n\n            },\\n\n            partsTechPastePoNotice(existing) {\\n\n                const po = this.partstechPoNumber || 'R{RO}';\\n\n                const paste = this.partstechPoCopied\\n\n                    ? po + ' is copied. Paste it into PartsTech PO Number if the box is empty. After the first part, refresh PartsTech once if it still is.'\\n\n                    : 'Copy ' + po + ' and paste it into PartsTech PO Number. After the first part, refresh PartsTech once if the box is still empty.';\\n\n\\n\n                return existing ? (existing + ' ' + paste) : paste;\\n\n            },\\n\n            startPartsTechPoWatch() {\\n\n                this.stopPartsTechPoWatch();\\n\n\\n\n                if (! this.partstechPrepareUrl) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.partstechPoWatchUntil = Date.now() + (4 * 60 * 1000);\\n\n                this.partstechPoWatchTimer = window.setInterval(() => {\\n\n                    this.syncPartsTechCheckoutPo();\\n\n                }, 1500);\\n\n            },\\n\n            stopPartsTechPoWatch() {\\n\n                if (this.partstechPoWatchTimer) {\\n\n                    window.clearInterval(this.partstechPoWatchTimer);\\n\n                    this.partstechPoWatchTimer = null;\\n\n                }\\n\n            },\\n\n            async syncPartsTechCheckoutPo() {\\n\n                if (Date.now() > this.partstechPoWatchUntil) {\\n\n                    this.stopPartsTechPoWatch();\\n\n                    return;\\n\n                }\\n\n\\n\n                if (this.partstechCatalogWindow && this.partstechCatalogWindow.closed) {\\n\n                    this.stopPartsTechPoWatch();\\n\n                    return;\\n\n                }\\n\n\\n\n                if (! this.partstechPrepareUrl || this.partstechCatalogOpening) {\\n\n                    return;\\n\n                }\\n\n\\n\n                try {\\n\n                    const response = await fetch(this.partstechPrepareUrl, {\\n\n                        method: 'POST',\\n\n                        credentials: 'same-origin',\\n\n                        headers: {\\n\n                            Accept: 'application/json',\\n\n                            'Content-Type': 'application/json',\\n\n                            'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]')?.content || '',\\n\n                        },\\n\n                        body: JSON.stringify({\\n\n                            stamp_only: true,\\n\n                            concern_id: this.partstechPreferredConcernId || null,\\n\n                        }),\\n\n                    });\\n\n\\n\n                    const payload = await response.json().catch(() => ({}));\\n\n\\n\n                    if (payload?.cart_locked) {\\n\n                        this.stopPartsTechPoWatch();\\n\n                        return;\\n\n                    }\\n\n\\n\n                    const stamped = Number(payload?.stamped_order_count || 0);\\n\n\\n\n                    if (stamped > this.partstechLastStampedOrders) {\\n\n                        this.partstechLastStampedOrders = stamped;\\n\n                        const po = this.partstechPoNumber || 'R{RO}';\\n\n                        this.partstechNotice = po + ' is on the PartsTech order. Refresh the PartsTech tab if PO Number is still empty.';\\n\n                    }\\n\n                } catch {\\n\n                    // Keep watching while the catalog tab is open.\\n\n                }\\n\n            },\\n\n            async switchPartsTechToThisRo() {\\n\n                await this.openPartsTechCatalog(true, this.partstechPreferredConcernId || null);\\n\n            },\\n\n            clearPartstechNotice() {\\n\n                this.partstechNotice = '';\\n\n                this.partstechCartLocked = false;\\n\n                this.partstechBlockingReference = '';\\n\n            },\\n\n            openLaborGuideFromTrigger(trigger) {\\n\n                if (! trigger?.dataset?.laborGuide) {\\n\n                    return;\\n\n                }\\n\n\\n\n                let payload = {};\\n\n\\n\n                try {\\n\n                    payload = JSON.parse(trigger.dataset.laborGuide);\\n\n                } catch {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.openLaborGuide(\\n\n                    payload.url || null,\\n\n                    payload.vin || null,\\n\n                    payload.notice || null,\\n\n                    payload.windowName || null,\\n\n                );\\n\n            },\\n\n            openLaborGuide(url, vin, notice, windowName) {\\n\n                if (! url) {\\n\n                    return;\\n\n                }\\n\n\\n\n                const clipboardVin = typeof vin === 'string' ? vin.trim() : '';\\n\n\\n\n                if (clipboardVin !== '') {\\n\n                    try {\\n\n                        navigator.clipboard.writeText(clipboardVin);\\n\n                    } catch {\\n\n                        // Clipboard is optional; launch still proceeds.\\n\n                    }\\n\n                }\\n\n\\n\n                if (notice) {\\n\n                    window.dispatchEvent(new CustomEvent('ark:labor-guide-notice', {\\n\n                        detail: { message: notice },\\n\n                    }));\\n\n                }\\n\n\\n\n                if (windowName === '_blank') {\\n\n                    const opened = window.open(url, '_blank');\\n\n\\n\n                    if (opened) {\\n\n                        opened.opener = null;\\n\n                    }\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                window.open(url, windowName || 'ark-labor-guide', 'noopener,noreferrer');\\n\n            },\\n\n            rteLabor: window.arkRteLaborGuide(JSON.parse('{\\u0022available\\u0022:false,\\u0022blockedReason\\u0022:\\u0022Labor times are not imported on this environment.\\u0022,\\u0022vehicleLabel\\u0022:null,\\u0022vehicleEngineLabel\\u0022:null,\\u0022modelYear\\u0022:null,\\u0022defaultCarIdCode\\u0022:null,\\u0022carCandidates\\u0022:[],\\u0022defaultConcernId\\u0022:1,\\u0022concerns\\u0022:[{\\u0022id\\u0022:1,\\u0022summary\\u0022:\\u0022Brake inspection\\u0022}],\\u0022searchUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/rte-labor\\\\\\/search\\u0022,\\u0022applyUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/rte-labor\\\\\\/apply\\u0022,\\u0022estimateVersionField\\u0022:\\u0022opened_estimate_version\\u0022,\\u0022estimateVersion\\u0022:1,\\u0022defaultHoursBasis\\u0022:\\u0022avg\\u0022}')),\\n\n            openRteLaborGuide() {\\n\n                this.rteLabor.openPanel();\\n\n            },\\n\n        })\"\\n\n        x-init=\"initWorksheetCollaboration(); initEstimateContextFromHash()\"\\n\n        @ark:partstech-warning.window=\"partstechNotice = $event.detail.message || ''; partstechCartLocked = Boolean($event.detail.cartLocked)\"\\n\n        @ark:partstech-pull-quote-state.window=\"partstechPullLoading = Boolean($event.detail?.loading); partstechPullStatus = $event.detail?.status || ''\"\\n\n        @ark:labor-guide-notice.window=\"laborGuideNotice = $event.detail.message || ''\"\\n\n        @ark:partstech-open.window=\"openPartsCatalog('partstech', false, $event.detail?.concernId ?? null)\"\\n\n        @keydown.escape.window=\"partsCatalogMenu = false; laborGuideMenu = false\"\\n\n    >\\n\n                \\n\n        <div class=\"page-body\">\\n\n    <div class=\"container-fluid\">\\n\n        <div x-show=\"partstechCatalogOpening || partstechPullLoading\" x-cloak role=\"status\" aria-live=\"polite\">\\n\n                <div class=\"alert alert-info d-flex align-items-center gap-2\">\\n\n                    <span class=\"spinner-border spinner-border-sm\" aria-hidden=\"true\"></span>\\n\n                    <span x-text=\"partstechCatalogOpening\\n\n                        ? ('Preparing ' + (partsCatalogActionLabel || 'PartsTech') + ' cart\u2026')\\n\n                        : (partstechPullStatus || ('Pulling ' + (partsCatalogActionLabel || 'PT Cart') + '\u2026'))\"></span>\\n\n                </div>\\n\n            </div>\\n\n\\n\n        <div\\n\n    x-show=\"worksheetSaving\"\\n\n    x-cloak\\n\n    class=\"fixed-top h-100 bg-dark bg-opacity-25\"\\n\n    data-worksheet-busy-overlay\\n\n    aria-live=\"polite\"\\n\n    aria-busy=\"true\"\\n\n>\\n\n    \\n\n    <div class=\"d-flex align-items-center justify-content-center h-100\">\\n\n        <div class=\"card card-sm shadow-lg\">\\n\n            <div class=\"card-body d-flex flex-column align-items-center gap-3 px-4 py-3\">\\n\n                <span class=\"spinner-border text-primary\" aria-hidden=\"true\"></span>\\n\n                <p class=\"fw-bold small text-center mb-0\" x-text=\"worksheetSavingLabel || 'Saving\u2026'\"></p>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n        \\n\n        <div id=\"worksheet-status-flash\">\\n\n            \\n\n                                            <div\\n\n                    data-worksheet-server-status\\n\n                    role=\"status\"\\n\n                    class=\"alert alert-warning\"\\n\n                >\\n\n                    Communication logged.\\n\n                </div>\\n\n            \\n\n            \\n\n            \\n\n                    </div>\\n\n\\n\n        <div x-show=\"partstechNotice\" x-cloak role=\"status\">\\n\n            <div class=\"alert alert-warning d-flex align-items-start gap-3\">\\n\n                <div class=\"flex-fill min-w-0\">\\n\n                    <p class=\"mb-0\" x-text=\"partstechNotice\"></p>\\n\n                    <p x-show=\"partstechCartLocked\" x-cloak class=\"small mt-1 mb-0\">\\n\n                        PartsTech is currently working with <span x-text=\"partstechBlockingReference || 'another RO'\"></span>. Switch to this RO if you are done with that cart, or pull that quote first.\\n\n                    </p>\\n\n                    <button\\n\n                        x-show=\"partstechCartLocked\"\\n\n                        x-cloak\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-warning btn-sm mt-2\"\\n\n                        @click=\"switchPartsTechToThisRo()\"\\n\n                    >\\n\n                        Switch PartsTech to this RO\\n\n                    </button>\\n\n                </div>\\n\n                <button type=\"button\" class=\"btn btn-ghost-warning btn-sm\" @click=\"clearPartstechNotice()\">Dismiss</button>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"laborGuideNotice\" x-cloak role=\"status\">\\n\n            <div class=\"alert alert-info d-flex align-items-start gap-3\">\\n\n                <p class=\"flex-fill mb-0\" x-text=\"laborGuideNotice\"></p>\\n\n                <button type=\"button\" class=\"btn btn-ghost-info btn-sm\" @click=\"clearLaborGuideNotice()\">Dismiss</button>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"presenceMessage\" x-cloak role=\"status\">\\n\n    <div class=\"alert alert-info\">\\n\n        <p class=\"mb-0\" x-text=\"presenceMessage\"></p>\\n\n    </div>\\n\n</div>\\n\n\\n\n<div x-show=\"versionDriftNotice\" x-cloak role=\"status\">\\n\n    <div class=\"alert alert-warning d-flex align-items-start gap-3\">\\n\n        <p class=\"flex-fill mb-0\" x-text=\"versionDriftNotice\"></p>\\n\n        <button type=\"button\" class=\"btn btn-ghost-warning btn-sm\" @click=\"reconcileAfterDraftDiscard()\">Refresh</button>\\n\n    </div>\\n\n</div>\\n\n\\n\n<div x-show=\"staleNotice\" x-cloak role=\"status\">\\n\n    <div class=\"alert alert-warning d-flex align-items-start gap-3\">\\n\n        <p class=\"flex-fill mb-0\" x-text=\"staleNotice\"></p>\\n\n        <button type=\"button\" class=\"btn btn-ghost-warning btn-sm\" @click=\"clearStaleNotice()\">Dismiss</button>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n        <div class=\"card mb-3\" id=\"ro-identity-band\" data-identity-band>\\n\n    <div class=\"row g-0 ark-identity-panel\">\\n\n        <section class=\"col-md-4 p-2 p-md-3 min-w-0\" data-identity-present=\"customer\" aria-labelledby=\"ro-identity-customer-heading\">\\n\n            <h3 class=\"subheader mb-1\" id=\"ro-identity-customer-heading\">Customer</h3>\\n\n            <div class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                    <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-link p-0 fw-bold text-reset text-start\"\\n\n                        title=\"Open to edit customer\"\\n\n                        data-identity-edit=\"customer\"\\n\n                        @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'customer-identity', invokeEl: $event.currentTarget } }))\"\\n\n                    >\\n\n                        Pickup Customer\\n\n                    </button>\\n\n                                <span class=\"d-inline-flex align-items-center gap-1\">\\n\n                    <span class=\"badge bg-secondary-lt\">Retail</span>\\n\n                                            <span\\n\n    class=\"position-relative d-inline-flex align-items-center\"\\n\n    x-data=\"{ helpOpen: false }\"\\n\n    @mouseenter=\"helpOpen = true\"\\n\n    @mouseleave=\"helpOpen = false\"\\n\n    @focusin=\"helpOpen = true\"\\n\n    @focusout=\"helpOpen = false\"\\n\n    @keydown.escape=\"helpOpen = false\"\\n\n    data-help-tip\\n\n>\\n\n    <span class=\"form-help\" tabindex=\"0\" role=\"button\" aria-label=\"Billing class help\">\\n\n                    <span aria-hidden=\"true\">?</span>\\n\n            </span>\\n\n    <span\\n\n        class=\"dropdown-menu top-100 start-0 mt-1 p-2 small text-wrap fw-normal text-body\"\\n\n        :class=\"{ show: helpOpen }\"\\n\n        style=\"width: 16rem\"\\n\n        role=\"tooltip\"\\n\n    >\\n\n                    Billing class sets default scope billing and standing discounts. Scope billing posture on each concern is financial authority. Changing billing class does not change billing on scopes already on this estimate.\\n\n            </span>\\n\n</span>\\n\n                                    </span>\\n\n            </div>\\n\n            <div class=\"d-flex flex-wrap gap-2 small mt-1\">\\n\n                <a href=\"#communication-rail\">Message</a>\\n\n                                                    <a href=\"http://localhost/app/intake/new?customer_id=1&amp;vehicle_id=1&amp;source_repair_order_id=1\" title=\"Open another repair order for this customer and vehicle\">New RO</a>\\n\n                            </div>\\n\n\\n\n                            <div class=\"mt-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center gap-2\" data-customer-identity-pressure=\"incomplete\">\\n\n            <span\\n\n                class=\"badge bg-yellow-lt\"\\n\n                                    title=\"Missing: Address\"\\n\n                            >Customer info incomplete</span>\\n\n                            <span class=\"small text-secondary\">Missing: Address</span>\\n\n                    </div>\\n\n                    </div>\\n\n            \\n\n            <dl class=\"row g-0 small mt-2 mb-0\">\\n\n                                    <dt class=\"col-4 text-secondary fw-normal\">Email</dt>\\n\n                    <dd class=\"col-8 mb-1 fw-medium text-break\">\\n\n                                                    <a href=\"mailto:customer@example.test\" class=\"text-reset\">customer@example.test</a>\\n\n                                                                        </dd>\\n\n                                    <dt class=\"col-4 text-secondary fw-normal\">Phone</dt>\\n\n                    <dd class=\"col-8 mb-1 fw-medium text-break\">\\n\n                                                    <a href=\"tel:5550100\" class=\"text-reset\">5550100</a>\\n\n                                                                        </dd>\\n\n                            </dl>\\n\n        </section>\\n\n\\n\n        <section class=\"col-md-4 p-2 p-md-3 min-w-0\" data-identity-present=\"vehicle\" aria-labelledby=\"ro-identity-vehicle-heading\">\\n\n            <h3 class=\"subheader mb-1\" id=\"ro-identity-vehicle-heading\">Vehicle</h3>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-link p-0 fw-bold text-reset text-start\"\\n\n                    title=\"Open to edit vehicle\"\\n\n                    data-identity-edit=\"vehicle\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'vehicle-identity', invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    2021 Honda Civic\\n\n                </button>\\n\n\\n\n                            \\n\n            \\n\n            \\n\n            <dl class=\"row g-0 small mt-2 mb-0\">\\n\n                                    <dt class=\"col-4 text-secondary fw-normal\">VIN</dt>\\n\n                    <dd class=\"col-8 mb-1 fw-medium text-break\">\\n\n                                                    <span\\n\n        class=\"d-inline-flex align-items-center gap-1\"\\n\n        x-data=\"arkVinDisplay('2HGFC2F59MH123456')\"\\n\n        data-vin-display\\n\n    >\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"trigger\"\\n\n            class=\"btn btn-link p-0 font-monospace text-reset ops-vin-copyable\"\\n\n            @click=\"copy()\"\\n\n            title=\"Click to copy VIN\"\\n\n            :aria-label=\"'Copy VIN ' + vin\"\\n\n        >\\n\n                            <span class=\"text-secondary\">2HGFC2F59</span>\\n\n                        <span class=\"fw-bold\">MH123456</span>\\n\n        </button>\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"readback\"\\n\n            class=\"btn btn-sm btn-ghost-secondary btn-icon p-0 ops-vin-readback-btn\"\\n\n            @click.stop=\"toggleReadback()\"\\n\n            @mouseenter=\"onReadbackHoverEnter()\"\\n\n            @mouseleave=\"onReadbackHoverLeave()\"\\n\n            @focus=\"onReadbackHoverEnter()\"\\n\n            @blur=\"onReadbackHoverLeave()\"\\n\n            :aria-expanded=\"readbackOpen ? 'true' : 'false'\"\\n\n            aria-controls=\"vin-readback-6b05bedf6e222\"\\n\n            aria-haspopup=\"dialog\"\\n\n            aria-label=\"VIN readback\"\\n\n            title=\"VIN readback\"\\n\n            data-vin-readback-trigger\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 16v-6a2 2 0 1 1 4 0v6\"/><path d=\"M3 13h4\"/><path d=\"M10 8v6a2 2 0 1 0 4 0v-1a2 2 0 1 0 -4 0v1\"/><path d=\"M20.732 12a2 2 0 0 0 -3.732 1v1a2 2 0 0 0 3.726 1.01\"/></svg>\\n\n        </button>\\n\n        <span class=\"badge bg-green-lt\" x-show=\"copied\" x-cloak role=\"status\" aria-live=\"polite\">VIN copied</span>\\n\n\\n\n        <template x-teleport=\"body\">\\n\n            <div x-show=\"readbackOpen\" x-cloak data-vin-readback-layer>\\n\n                <div\\n\n                    x-ref=\"backdrop\"\\n\n                    x-show=\"sheetMode\"\\n\n                    x-cloak\\n\n                    class=\"offcanvas-backdrop fade show ops-vin-readback-backdrop\"\\n\n                    @click=\"closeReadback()\"\\n\n                ></div>\\n\n                <div\\n\n                    id=\"vin-readback-6b05bedf6e222\"\\n\n                    x-ref=\"panel\"\\n\n                    :class=\"sheetMode\\n\n                        ? 'offcanvas offcanvas-bottom h-auto show ops-vin-readback-sheet'\\n\n                        : 'card card-sm shadow position-fixed p-2 ops-vin-tooltip-layer ops-vin-readback-popover'\"\\n\n                    :style=\"sheetMode ? '' : tooltipStyle\"\\n\n                    role=\"dialog\"\\n\n                    aria-modal=\"true\"\\n\n                    aria-label=\"VIN readback\"\\n\n                    tabindex=\"-1\"\\n\n                    data-vin-phonetic-readback\\n\n                    @mouseenter=\"onReadbackHoverEnter()\"\\n\n                    @mouseleave=\"onReadbackHoverLeave()\"\\n\n                    @keydown.escape.stop=\"closeReadback()\"\\n\n                >\\n\n                    <div class=\"d-flex align-items-start justify-content-between gap-2 mb-2\">\\n\n                        <span class=\"subheader mb-0\">VIN readback</span>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close VIN readback\" @click=\"closeReadback()\"></button>\\n\n                    </div>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small text-secondary\">\\n\n                                WMI\\n\n                                <span class=\"text-secondary fw-normal\">1\u20133 \u00b7 manufacturer</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">2</span>\\n\n                                        <span class=\"small text-secondary\">Two</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">H</span>\\n\n                                        <span class=\"small text-secondary\">Hotel</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">G</span>\\n\n                                        <span class=\"small text-secondary\">Golf</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small text-secondary\">\\n\n                                VDS\\n\n                                <span class=\"text-secondary fw-normal\">4\u20139 \u00b7 descriptor</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">F</span>\\n\n                                        <span class=\"small text-secondary\">Foxtrot</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">C</span>\\n\n                                        <span class=\"small text-secondary\">Charlie</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">2</span>\\n\n                                        <span class=\"small text-secondary\">Two</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">F</span>\\n\n                                        <span class=\"small text-secondary\">Foxtrot</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">5</span>\\n\n                                        <span class=\"small text-secondary\">Five</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">9</span>\\n\n                                        <span class=\"small text-secondary\">Nine</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small fw-bold\">\\n\n                                Serial\\n\n                                <span class=\"text-secondary fw-normal\">10\u201317 \u00b7 VIS</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">M</span>\\n\n                                        <span class=\"small text-secondary\">Mike</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">H</span>\\n\n                                        <span class=\"small text-secondary\">Hotel</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">1</span>\\n\n                                        <span class=\"small text-secondary\">One</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">2</span>\\n\n                                        <span class=\"small text-secondary\">Two</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">3</span>\\n\n                                        <span class=\"small text-secondary\">Three</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">4</span>\\n\n                                        <span class=\"small text-secondary\">Four</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">5</span>\\n\n                                        <span class=\"small text-secondary\">Five</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">6</span>\\n\n                                        <span class=\"small text-secondary\">Six</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                    </div>\\n\n            </div>\\n\n        </template>\\n\n    </span>\\n\n                                            </dd>\\n\n                                    <dt class=\"col-4 text-secondary fw-normal\">Plate</dt>\\n\n                    <dd class=\"col-8 mb-1 fw-medium text-break\">\\n\n                                                    COM123\\n\n                                            </dd>\\n\n                            </dl>\\n\n        </section>\\n\n\\n\n        <section class=\"col-md-4 p-2 p-md-3 min-w-0 ark-identity-panel__visit\" data-identity-present=\"visit\" aria-labelledby=\"ro-identity-visit-heading\">\\n\n            <h3 class=\"subheader mb-1\" id=\"ro-identity-visit-heading\">Visit</h3>\\n\n            <div class=\"ark-ro-visit\">\\n\n                \\n\n                \\n\n                \\n\n                <div class=\"min-w-0 ark-ro-visit__details\">\\n\n                                            <div id=\"review-toolbar\" class=\"ark-ro-visit-commands\" data-ro-command-bar>\\n\n    <div class=\"ark-ro-visit-commands__workflow small\" data-ro-command-workflow>\\n\n                        <div class=\"row g-0 align-items-baseline ark-ro-visit-commands__status\">\\n\n        <div class=\"col-4 text-secondary\">Status</div>\\n\n        <div class=\"col-8\">\\n\n            \\n\n            <form\\n\n                id=\"repair-order-workflow\"\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/lifecycle\"\\n\n                class=\"m-0\"\\n\n                data-lifecycle-form\\n\n                data-continuity-region=\"workflow\"\\n\n                data-refresh-scope=\"toolbar\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"TKrsC4Y5a2boFcrekL394tblQHZzBSbBWjaa4CQi\" autocomplete=\"off\">                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n\\n\n                <div class=\"dropdown\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"ops-visit-inline-trigger fw-medium\"\\n\n                        data-bs-toggle=\"dropdown\"\\n\n                        data-bs-display=\"static\"\\n\n                        aria-expanded=\"false\"\\n\n                        aria-haspopup=\"listbox\"\\n\n                        aria-controls=\"status-move-menu-1\"\\n\n                        aria-label=\"Repair order status\"\\n\n                        title=\"Click to change status\"\\n\n                        data-lifecycle-trigger\\n\n                    >\\n\n                        <span class=\"ops-visit-inline-value\">Ready for Pickup</span>\\n\n                    </button>\\n\n                    <ul\\n\n                        id=\"status-move-menu-1\"\\n\n                        class=\"dropdown-menu\"\\n\n                        role=\"listbox\"\\n\n                        aria-label=\"Repair order status\"\\n\n                    >\\n\n                        <li>\\n\n                            <button\\n\n                                type=\"button\"\\n\n                                class=\"dropdown-item active\"\\n\n                                role=\"option\"\\n\n                                aria-selected=\"true\"\\n\n                                data-lifecycle-option\\n\n                                data-status-value=\"ready_pickup\"\\n\n                            >Ready for Pickup</button>\\n\n                        </li>\\n\n                                                    <li>\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"dropdown-item\"\\n\n                                    role=\"option\"\\n\n                                    aria-selected=\"false\"\\n\n                                    data-lifecycle-option\\n\n                                    data-status-value=\"in_progress\"\\n\n                                     data-blocked-reason=\"Assign a technician first.\"                                      data-needs-technician=\"1\"                                 >\\n\n                                    In Progress - Assign a technician first.                                </button>\\n\n                            </li>\\n\n                                                                                            </ul>\\n\n                </div>\\n\n\\n\n                \\n\n                <label class=\"visually-hidden\" for=\"status-move-1\">Repair order status</label>\\n\n                <select\\n\n                    id=\"status-move-1\"\\n\n                    name=\"status\"\\n\n                    required\\n\n                    class=\"visually-hidden\"\\n\n                    tabindex=\"-1\"\\n\n                    aria-hidden=\"true\"\\n\n                    data-lifecycle-select\\n\n                    data-current-status=\"ready_pickup\"\\n\n                >\\n\n                    <option value=\"ready_pickup\" selected>Ready for Pickup</option>\\n\n                                            <option\\n\n                            value=\"in_progress\"\\n\n                             data-blocked-reason=\"Assign a technician first.\"                              data-needs-technician=\"1\"                         >\\n\n                            In Progress - Assign a technician first.                        </option>\\n\n                                                                            </select>\\n\n\\n\n                <div\\n\n                    class=\"hidden card card-sm mt-2 border-warning\" style=\"max-width: 20rem\"\\n\n                    data-lost-reason-panel\\n\n                    hidden\\n\n                >\\n\n                    <div class=\"card-body p-2\"><div class=\"fw-bold small mb-2\">Why is this repair order closing lost?</div>\\n\n                    <label for=\"lost-reason-key-1\" class=\"sr-only\">Lost reason</label>\\n\n                    <select\\n\n                        id=\"lost-reason-key-1\"\\n\n                        name=\"lost_reason_key\"\\n\n                        class=\"form-select mb-2\"\\n\n                    >\\n\n                        <option value=\"\">Choose lost reason\u2026</option>\\n\n                                                    <option value=\"no_response\" >\\n\n                                No response\\n\n                            </option>\\n\n                                                    <option value=\"price_declined\" >\\n\n                                Price declined\\n\n                            </option>\\n\n                                                    <option value=\"vehicle_sold\" >\\n\n                                Vehicle sold\\n\n                            </option>\\n\n                                                    <option value=\"went_elsewhere\" >\\n\n                                Went elsewhere\\n\n                            </option>\\n\n                                                    <option value=\"diagnostic_only\" >\\n\n                                Diagnostic only\\n\n                            </option>\\n\n                                                    <option value=\"not_economical\" >\\n\n                                Not economical to repair\\n\n                            </option>\\n\n                                                    <option value=\"duplicate_cleanup\" >\\n\n                                Duplicate / cleanup\\n\n                            </option>\\n\n                                                    <option value=\"other\" >\\n\n                                Other\\n\n                            </option>\\n\n                                            </select>\\n\n                    <label for=\"lost-reason-note-1\" class=\"sr-only\">Lost reason note</label>\\n\n                    <input\\n\n                        id=\"lost-reason-note-1\"\\n\n                        type=\"text\"\\n\n                        name=\"lost_reason_note\"\\n\n                        value=\"\"\\n\n                        maxlength=\"500\"\\n\n                        placeholder=\"Required when reason is Other\"\\n\n                        class=\"form-control mb-2\"\\n\n                    >\\n\n                    <div class=\"btn-list\">\\n\n                        <button type=\"submit\" class=\"btn btn-warning btn-sm\">\\n\n                            Confirm close lost\\n\n                        </button>\\n\n                        <button type=\"button\" class=\"btn btn-link btn-sm\" data-lost-reason-cancel>\\n\n                            Cancel\\n\n                        </button>\\n\n                    </div>\\n\n                    </div>\\n\n                </div>\\n\n\\n\n                                <div\\n\n                    class=\"card card-sm mt-2 border-warning hidden\"\\n\n                    style=\"max-width: 24rem\"\\n\n                    data-operational-closeout-panel\\n\n                     hidden                 >\\n\n                    <div class=\"card-body p-2\">\\n\n                        <div class=\"fw-bold small mb-1\">Unfinished work on this RO</div>\\n\n                        <div class=\"text-secondary small mb-2\">ARK found items that have not been completed. Document why you are proceeding \u2014 this does not mark the work finished.</div>\\n\n                        <ul class=\"list-unstyled small mb-2\" data-operational-closeout-items>\\n\n                                                    </ul>\\n\n                        <label for=\"operational-closeout-reason-1\" class=\"form-label small mb-1\">Reason for proceeding</label>\\n\n                        <textarea\\n\n                            id=\"operational-closeout-reason-1\"\\n\n                            name=\"operational_closeout_reason\"\\n\n                            rows=\"3\"\\n\n                            maxlength=\"1000\"\\n\n                            class=\"form-control form-control-sm mb-2\"\\n\n                            placeholder=\"Example: Customer requested vehicle release. Parts will be installed during a return visit.\"\\n\n                            data-operational-closeout-reason\\n\n                        ></textarea>\\n\n                        <input\\n\n                            type=\"hidden\"\\n\n                            name=\"operational_closeout_fingerprint\"\\n\n                            value=\"\"\\n\n                            data-operational-closeout-fingerprint\\n\n                        >\\n\n                        <div class=\"btn-list\">\\n\n                            <button type=\"submit\" class=\"btn btn-warning btn-sm\" data-operational-closeout-confirm>\\n\n                                Confirm closeout\\n\n                            </button>\\n\n                            <button type=\"button\" class=\"btn btn-link btn-sm\" data-operational-closeout-cancel>\\n\n                                Cancel\\n\n                            </button>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </form>\\n\n        </div>\\n\n    </div>\\n\n        \\n\n        <div class=\"row g-0 align-items-baseline ark-ro-visit-commands__tech\">\\n\n            <div class=\"col-4 text-secondary\">Technician</div>\\n\n            <div class=\"col-8\">\\n\n                                <form\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/repair-orders/1/technician-assignment\"\\n\n                    data-refresh-scope=\"toolbar\"\\n\n                    @submit.prevent=\"submitWorksheetForm($event)\"\\n\n                    class=\"m-0\"\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"TKrsC4Y5a2boFcrekL394tblQHZzBSbBWjaa4CQi\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                    <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n\\n\n                    <div class=\"dropdown\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"ops-visit-inline-trigger fw-medium\"\\n\n                            data-bs-toggle=\"dropdown\"\\n\n                            data-bs-display=\"static\"\\n\n                            aria-expanded=\"false\"\\n\n                            aria-haspopup=\"listbox\"\\n\n                            aria-controls=\"assigned-technician-toolbar-1-menu\"\\n\n                            aria-label=\"Technician\"\\n\n                            data-technician-trigger\\n\n                        >\\n\n                            <span class=\"ops-visit-inline-value\">Assign tech\u2026</span>\\n\n                        </button>\\n\n                        <ul\\n\n                            id=\"assigned-technician-toolbar-1-menu\"\\n\n                            class=\"dropdown-menu\"\\n\n                            role=\"listbox\"\\n\n                            aria-label=\"Technician\"\\n\n                        >\\n\n                                                            <li>\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"dropdown-item active\"\\n\n                                        role=\"option\"\\n\n                                        aria-selected=\"true\"\\n\n                                        data-technician-option\\n\n                                        data-technician-value=\"\"\\n\n                                    >Assign tech\u2026</button>\\n\n                                </li>\\n\n                                                                                        <li>\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"dropdown-item\"\\n\n                                        role=\"option\"\\n\n                                        aria-selected=\"false\"\\n\n                                        data-technician-option\\n\n                                        data-technician-value=\"1\"\\n\n                                    >Napoleon Kovacek</button>\\n\n                                </li>\\n\n                                                    </ul>\\n\n                    </div>\\n\n\\n\n                    <label class=\"visually-hidden\" for=\"assigned-technician-toolbar-1\">Technician</label>\\n\n                    <select\\n\n                        id=\"assigned-technician-toolbar-1\"\\n\n                        name=\"assigned_technician_id\"\\n\n                        class=\"visually-hidden\"\\n\n                        tabindex=\"-1\"\\n\n                        aria-hidden=\"true\"\\n\n                        data-technician-select\\n\n                        onchange=\"if (String(this.value || '') !== '') { this.form.requestSubmit(); }\"\\n\n                    >\\n\n                                                    <option value=\"\" selected>Assign tech\u2026</option>\\n\n                                                                            <option value=\"1\" >Napoleon Kovacek</option>\\n\n                                            </select>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n        \\n\n    </div>\\n\n\\n\n    <div class=\"d-none\" data-ro-mode-toolbar-slot></div>\\n\n</div>\\n\n                    \\n\n                    <dl class=\"row g-0 small mb-0 ark-ro-visit__facts\">\\n\n                        <dt class=\"col-4 text-secondary fw-normal\">Visit type</dt>\\n\n                        <dd class=\"col-8 fw-medium\" data-identity-present=\"visit-posture\">\\n\n                                                            <button\\n\n                                    type=\"button\"\\n\n                                    class=\"ops-visit-inline-trigger fw-medium\"\\n\n                                    title=\"Open to edit visit type\"\\n\n                                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'visit-posture', invokeEl: $event.currentTarget } }))\"\\n\n                                ><span class=\"ops-visit-inline-value\">Not set</span></button>\\n\n                                                    </dd>\\n\n                                                    <dt class=\"col-4 text-secondary fw-normal\">Mileage</dt>\\n\n    <dd\\n\n        class=\"col-8 d-flex flex-wrap align-items-center gap-2 fw-medium ark-mileage-fields\"\\n\n        data-mileage-inline\\n\n        x-data=\"arkRepairOrderMileage({\\n\n            url: 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/mileage',\\n\n            csrf: 'TKrsC4Y5a2boFcrekL394tblQHZzBSbBWjaa4CQi',\\n\n            estimateVersionField: 'opened_estimate_version',\\n\n            estimateVersion: 1,\\n\n            mileageIn: null,\\n\n            mileageOut: null,\\n\n            legacyMileageIn: null,\\n\n        })\"\\n\n        x-effect=\"syncDraftMarker()\"\\n\n    >\\n\n                                            <span class=\"inline-flex items-center gap-1\" data-mileage-field=\"in\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    x-show=\"!editingIn\"\\n\n                    @click=\"openIn()\"\\n\n                    class=\"ark-mileage-trigger\"\\n\n                    aria-label=\"Edit mileage in\"\\n\n                    :aria-label=\"'Edit mileage in, ' + (displayIn() === '-' ? 'not set' : displayIn())\"\\n\n                    data-mileage-trigger=\"in\"\\n\n                >\\n\n                    <span class=\"ark-mileage-trigger__label\">In</span>\\n\n                    <span class=\"ark-mileage-trigger__value\" x-text=\"displayIn()\">-</span>\\n\n                </button>\\n\n                <span x-show=\"editingIn\" x-cloak class=\"text-secondary text-uppercase small\" aria-hidden=\"true\">In</span>\\n\n                <input\\n\n                    x-show=\"editingIn\"\\n\n                    x-cloak\\n\n                    x-ref=\"mileageInInput\"\\n\n                    type=\"text\"\\n\n                    inputmode=\"numeric\"\\n\n                    autocomplete=\"off\"\\n\n                    aria-label=\"Mileage in\"\\n\n                    x-model=\"mileageIn\"\\n\n                    @blur.debounce.350ms=\"finishIn()\"\\n\n                    @keydown.enter.prevent=\"$event.target.blur()\"\\n\n                    @keydown.escape.prevent=\"cancelIn()\"\\n\n                                        class=\"form-control form-control-sm ark-mileage-input\"\\n\n                    style=\"width: 6.5rem\"\\n\n                    data-mileage-input=\"in\"\\n\n                >\\n\n            </span>\\n\n                                                <span class=\"text-secondary\" aria-hidden=\"true\">\u00b7</span>\\n\n                        <span class=\"inline-flex items-center gap-1\" data-mileage-field=\"out\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    x-show=\"!editingOut\"\\n\n                    @click=\"openOut()\"\\n\n                    class=\"ark-mileage-trigger\"\\n\n                    aria-label=\"Edit mileage out\"\\n\n                    :aria-label=\"'Edit mileage out, ' + (displayOut() === '-' ? 'not set' : displayOut())\"\\n\n                    data-mileage-trigger=\"out\"\\n\n                >\\n\n                    <span class=\"ark-mileage-trigger__label\">Out</span>\\n\n                    <span class=\"ark-mileage-trigger__value\" x-text=\"displayOut()\">-</span>\\n\n                </button>\\n\n                <span x-show=\"editingOut\" x-cloak class=\"text-secondary text-uppercase small\" aria-hidden=\"true\">Out</span>\\n\n                <input\\n\n                    x-show=\"editingOut\"\\n\n                    x-cloak\\n\n                    x-ref=\"mileageOutInput\"\\n\n                    type=\"text\"\\n\n                    inputmode=\"numeric\"\\n\n                    autocomplete=\"off\"\\n\n                    aria-label=\"Mileage out\"\\n\n                    x-model=\"mileageOut\"\\n\n                    @blur.debounce.350ms=\"finishOut()\"\\n\n                    @keydown.enter.prevent=\"$event.target.blur()\"\\n\n                    @keydown.escape.prevent=\"cancelOut()\"\\n\n                                        class=\"form-control form-control-sm ark-mileage-input\"\\n\n                    style=\"width: 6.5rem\"\\n\n                    data-mileage-input=\"out\"\\n\n                >\\n\n            </span>\\n\n                <span x-show=\"saving\" x-cloak class=\"small text-secondary\">Saving\u2026</span>\\n\n        <span x-show=\"error\" x-cloak x-text=\"error\" class=\"small text-danger\"></span>\\n\n    </dd>\\n\n                                                                            \\n\n                            <dt class=\"col-4 text-secondary fw-normal\">Opened</dt>\\n\n                            <dd class=\"col-8 fw-medium text-break\">Nov 24, 2026 9:44 AM</dd>\\n\n                                                                    </dl>\\n\n\\n\n                    \\n\n                                    </div>\\n\n            </div>\\n\n        </section>\\n\n    </div>\\n\n\\n\n    </div>\\n\n    \\n\n        <div class=\"ops-estimate-layout gap-2 mt-2\">\\n\n            <div class=\"ops-estimate-main min-w-0\">\\n\n                <div\\n\n    id=\"repair-order-workspace-tabs\"\\n\n    class=\"card scroll-mt-6\"\\n\n    x-data=\"arkRoWorkspaceTabs({\\n\n        defaultTab: 'builder',\\n\n        storageKey: 'ark:ro-workspace-tab:review:1',\\n\n        tabs: JSON.parse('[\\u0022builder\\u0022,\\u0022inspect\\u0022,\\u0022recommendations\\u0022,\\u0022comms\\u0022,\\u0022history\\u0022]'),\\n\n        lazyTabs: JSON.parse('[\\u0022inspect\\u0022,\\u0022recommendations\\u0022,\\u0022comms\\u0022,\\u0022history\\u0022]'),\\n\n        tabUrl: 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/workspace-tabs',\\n\n        workspaceMode: 'review',\\n\n    })\"\\n\n>\\n\n            <div class=\"card-header\">\\n\n            <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Repair order workspace\">\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                        