\u0022:[],\\u0022measurement_slots\\u0022:[],\\u0022note\\u0022:null,\\u0022selected_observations\\u0022:[],\\u0022observation_options\\u0022:[],\\u0022expand_when\\u0022:[\\u0022monitor\\u0022,\\u0022needs_attention\\u0022,\\u0022failed\\u0022],\\u0022photo_count\\u0022:0,\\u0022photos\\u0022:[],\\u0022is_axle_gate\\u0022:false,\\u0022gate_group\\u0022:null,\\u0022road_test_finding_locked\\u0022:false,\\u0022road_test_force_na\\u0022:false,\\u0022condition_options\\u0022:[{\\u0022value\\u0022:\\u0022good\\u0022,\\u0022label\\u0022:\\u0022Good\\u0022,\\u0022display\\u0022:\\u0022Good\\u0022},{\\u0022value\\u0022:\\u0022monitor\\u0022,\\u0022label\\u0022:\\u0022Monitor\\u0022,\\u0022display\\u0022:\\u0022Monitor\\u0022},{\\u0022value\\u0022:\\u0022needs_attention\\u0022,\\u0022label\\u0022:\\u0022Needs Attention\\u0022,\\u0022display\\u0022:\\u0022Needs Attention\\u0022},{\\u0022value\\u0022:\\u0022failed\\u0022,\\u0022label\\u0022:\\u0022Failed\\u0022,\\u0022display\\u0022:\\u0022Failed\\u0022},{\\u0022value\\u0022:\\u0022na\\u0022,\\u0022label\\u0022:\\u0022N\\\\\\/A\\u0022,\\u0022display\\u0022:\\u0022N\\\\\\/A\\u0022}],\\u0022condition_palette\\u0022:null,\\u0022needs_expand_default\\u0022:false,\\u0022update_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/points\\\\\\/32\\u0022,\\u0022deep_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection?point=32\\\\u0026surface=tablet\\u0022,\\u0022photo_store_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/items\\\\\\/32\\\\\\/photos?surface=tablet\\u0022,\\u0022brake_prompts\\u0022:[]},{\\u0022id\\u0022:33,\\u0022label\\u0022:\\u0022Obvious body \\\\\\/ underbody damage (ground view)\\u0022,\\u0022category_name\\u0022:\\u0022Arrival \\\\\\/ outside\\u0022,\\u0022point_key\\u0022:\\u0022std_body_damage\\u0022,\\u0022group\\u0022:null,\\u0022corner\\u0022:null,\\u0022status\\u0022:null,\\u0022status_label\\u0022:\\u0022-\\u0022,\\u0022addressed\\u0022:false,\\u0022missing_measurement_slots\\u0022:[],\\u0022measurement_slots\\u0022:[],\\u0022note\\u0022:null,\\u0022selected_observations\\u0022:[],\\u0022observation_options\\u0022:[],\\u0022expand_when\\u0022:[\\u0022monitor\\u0022,\\u0022needs_attention\\u0022,\\u0022failed\\u0022],\\u0022photo_count\\u0022:0,\\u0022photos\\u0022:[],\\u0022is_axle_gate\\u0022:false,\\u0022gate_group\\u0022:null,\\u0022road_test_finding_locked\\u0022:false,\\u0022road_test_force_na\\u0022:false,\\u0022condition_options\\u0022:[{\\u0022value\\u0022:\\u0022good\\u0022,\\u0022label\\u0022:\\u0022Good\\u0022,\\u0022display\\u0022:\\u0022Good\\u0022},{\\u0022value\\u0022:\\u0022monitor\\u0022,\\u0022label\\u0022:\\u0022Monitor\\u0022,\\u0022display\\u0022:\\u0022Monitor\\u0022},{\\u0022value\\u0022:\\u0022needs_attention\\u0022,\\u0022label\\u0022:\\u0022Needs Attention\\u0022,\\u0022display\\u0022:\\u0022Needs Attention\\u0022},{\\u0022value\\u0022:\\u0022failed\\u0022,\\u0022label\\u0022:\\u0022Failed\\u0022,\\u0022display\\u0022:\\u0022Failed\\u0022},{\\u0022value\\u0022:\\u0022na\\u0022,\\u0022label\\u0022:\\u0022N\\\\\\/A\\u0022,\\u0022display\\u0022:\\u0022N\\\\\\/A\\u0022}],\\u0022condition_palette\\u0022:null,\\u0022needs_expand_default\\u0022:false,\\u0022update_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/points\\\\\\/33\\u0022,\\u0022deep_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection?point=33\\\\u0026surface=tablet\\u0022,\\u0022photo_store_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/items\\\\\\/33\\\\\\/photos?surface=tablet\\u0022,\\u0022brake_prompts\\u0022:[]}]}],\\u0022state\\u0022:\\u0022not_started\\u0022,\\u0022addressed\\u0022:0,\\u0022total\\u0022:10},{\\u0022key\\u0022:\\u0022road_test\\u0022,\\u0022label\\u0022:\\u0022Road test\\u0022,\\u0022optional\\u0022:true,\\u0022hint\\u0022:\\u0022Only when the concern, diagnosis, or verification needs it - not required for every visit.\\u0022,\\u0022sections\\u0022:[{\\u0022key\\u0022:\\u0022road_operational\\u0022,\\u0022label\\u0022:\\u0022Road \\\\\\/ Operational\\u0022,\\u0022stage_key\\u0022:\\u0022road_test\\u0022,\\u0022optional\\u0022:true,\\u0022state\\u0022:\\u0022not_started\\u0022,\\u0022state_label\\u0022:\\u0022Not started\\u0022,\\u0022addressed\\u0022:0,\\u0022total\\u0022:2,\\u0022points\\u0022:[{\\u0022id\\u0022:48,\\u0022label\\u0022:\\u0022Road test performed\\u0022,\\u0022category_name\\u0022:\\u0022Road \\\\\\/ operational\\u0022,\\u0022point_key\\u0022:\\u0022std_road_test_performed\\u0022,\\u0022group\\u0022:null,\\u0022corner\\u0022:null,\\u0022status\\u0022:null,\\u0022status_label\\u0022:\\u0022-\\u0022,\\u0022addressed\\u0022:false,\\u0022missing_measurement_slots\\u0022:[],\\u0022measurement_slots\\u0022:[],\\u0022note\\u0022:null,\\u0022selected_observations\\u0022:[],\\u0022observation_options\\u0022:[],\\u0022expand_when\\u0022:[\\u0022monitor\\u0022,\\u0022needs_attention\\u0022,\\u0022failed\\u0022],\\u0022photo_count\\u0022:0,\\u0022photos\\u0022:[],\\u0022is_axle_gate\\u0022:false,\\u0022gate_group\\u0022:\\u0022road_test_performed\\u0022,\\u0022road_test_finding_locked\\u0022:false,\\u0022road_test_force_na\\u0022:false,\\u0022condition_options\\u0022:[{\\u0022value\\u0022:\\u0022good\\u0022,\\u0022label\\u0022:\\u0022Good\\u0022,\\u0022display\\u0022:\\u0022Good\\u0022},{\\u0022value\\u0022:\\u0022monitor\\u0022,\\u0022label\\u0022:\\u0022Monitor\\u0022,\\u0022display\\u0022:\\u0022Monitor\\u0022},{\\u0022value\\u0022:\\u0022needs_attention\\u0022,\\u0022label\\u0022:\\u0022Needs Attention\\u0022,\\u0022display\\u0022:\\u0022Needs Attention\\u0022},{\\u0022value\\u0022:\\u0022failed\\u0022,\\u0022label\\u0022:\\u0022Failed\\u0022,\\u0022display\\u0022:\\u0022Failed\\u0022},{\\u0022value\\u0022:\\u0022na\\u0022,\\u0022label\\u0022:\\u0022N\\\\\\/A\\u0022,\\u0022display\\u0022:\\u0022N\\\\\\/A\\u0022}],\\u0022condition_palette\\u0022:null,\\u0022needs_expand_default\\u0022:false,\\u0022update_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/points\\\\\\/48\\u0022,\\u0022deep_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection?point=48\\\\u0026surface=tablet\\u0022,\\u0022photo_store_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/items\\\\\\/48\\\\\\/photos?surface=tablet\\u0022,\\u0022brake_prompts\\u0022:[]},{\\u0022id\\u0022:49,\\u0022label\\u0022:\\u0022Road-test noise \\\\\\/ vibration \\\\\\/ drivability observation\\u0022,\\u0022category_name\\u0022:\\u0022Road \\\\\\/ operational\\u0022,\\u0022point_key\\u0022:\\u0022std_road_test_observation\\u0022,\\u0022group\\u0022:null,\\u0022corner\\u0022:null,\\u0022status\\u0022:null,\\u0022status_label\\u0022:\\u0022-\\u0022,\\u0022addressed\\u0022:false,\\u0022missing_measurement_slots\\u0022:[],\\u0022measurement_slots\\u0022:[],\\u0022note\\u0022:null,\\u0022selected_observations\\u0022:[],\\u0022observation_options\\u0022:[],\\u0022expand_when\\u0022:[\\u0022monitor\\u0022,\\u0022needs_attention\\u0022,\\u0022failed\\u0022],\\u0022photo_count\\u0022:0,\\u0022photos\\u0022:[],\\u0022is_axle_gate\\u0022:false,\\u0022gate_group\\u0022:\\u0022road_test_findings\\u0022,\\u0022road_test_finding_locked\\u0022:true,\\u0022road_test_force_na\\u0022:false,\\u0022condition_options\\u0022:[{\\u0022value\\u0022:\\u0022good\\u0022,\\u0022label\\u0022:\\u0022Good\\u0022,\\u0022display\\u0022:\\u0022Good\\u0022},{\\u0022value\\u0022:\\u0022monitor\\u0022,\\u0022label\\u0022:\\u0022Monitor\\u0022,\\u0022display\\u0022:\\u0022Monitor\\u0022},{\\u0022value\\u0022:\\u0022needs_attention\\u0022,\\u0022label\\u0022:\\u0022Needs Attention\\u0022,\\u0022display\\u0022:\\u0022Needs Attention\\u0022},{\\u0022value\\u0022:\\u0022failed\\u0022,\\u0022label\\u0022:\\u0022Failed\\u0022,\\u0022display\\u0022:\\u0022Failed\\u0022},{\\u0022value\\u0022:\\u0022na\\u0022,\\u0022label\\u0022:\\u0022N\\\\\\/A\\u0022,\\u0022display\\u0022:\\u0022N\\\\\\/A\\u0022}],\\u0022condition_palette\\u0022:null,\\u0022needs_expand_default\\u0022:true,\\u0022update_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/points\\\\\\/49\\u0022,\\u0022deep_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection?point=49\\\\u0026surface=tablet\\u0022,\\u0022photo_store_url\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/inspection\\\\\\/items\\\\\\/49\\\\\\/photos?surface=tablet\\u0022,\\u0022brake_prompts\\u0022:[]}]}],\\u0022state\\u0022:\\u0022not_started\\u0022,\\u0022addressed\\u0022:0,\\u0022total\\u0022:2}],\\u0022focusSectionKey\\u0022:\\u0022rear_axle\\u0022,\\u0022rearAxleBrakeType\\u0022:null,\\u0022progress\\u0022:{\\u0022addressed\\u0022:0,\\u0022total\\u0022:41,\\u0022remaining\\u0022:41}}'))\"\\n\n>\\n\n    <div class=\"card\">\\n\n        <div class=\"card-body p-3\">\\n\n            <div class=\"subheader\">\\n\n                                    Standard Vehicle Inspection\\n\n                            </div>\\n\n            <h2 class=\"card-title mb-1\">Section walk</h2>\\n\n            <div class=\"text-secondary\" x-text=\"`${progress.addressed} of ${progress.total} \u00b7 ${progress.remaining} remaining`\"></div>\\n\n            <div class=\"progress progress-sm mt-2\">\\n\n                <div\\n\n                    class=\"progress-bar bg-success\"\\n\n                    role=\"progressbar\"\\n\n                    aria-label=\"Inspection coverage\"\\n\n                    :style=\"{ width: (progress.total > 0 ? Math.round(progress.addressed / progress.total * 100) : 0) + '%' }\"\\n\n                    :aria-valuenow=\"progress.addressed\"\\n\n                    aria-valuemin=\"0\"\\n\n                    :aria-valuemax=\"progress.total\"\\n\n                ></div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <nav class=\"card\" aria-label=\"Inspection coverage\" data-inspection-sections-toc>\\n\n        <div class=\"card-header\">\\n\n            <h2 class=\"card-title\">Coverage</h2>\\n\n            <div class=\"card-actions d-md-none\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn\"\\n\n                    data-bs-toggle=\"collapse\"\\n\n                    data-bs-target=\"#inspection-sections-toc-list\"\\n\n                    aria-controls=\"inspection-sections-toc-list\"\\n\n                    aria-expanded=\"false\"\\n\n                >Sections</button>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"collapse d-md-block\" id=\"inspection-sections-toc-list\">\\n\n            <template x-for=\"stage in stages\" :key=\"stage.key\">\\n\n                <div>\\n\n                    <div class=\"subheader px-3 pt-3 pb-1\">\\n\n                        <span x-text=\"stage.label\"></span>\\n\n                        <span class=\"badge bg-secondary-lt ms-1\" x-show=\"stage.optional\" x-cloak>Optional</span>\\n\n                    </div>\\n\n                    <div class=\"list-group list-group-flush\">\\n\n                        <template x-for=\"section in stage.sections\" :key=\"section.key\">\\n\n                            <button\\n\n                                type=\"button\"\\n\n                                class=\"list-group-item list-group-item-action py-3\"\\n\n                                :class=\"{\\n\n                                    'is-complete': section.state === 'complete',\\n\n                                    'is-progress': section.state === 'in_progress',\\n\n                                    'is-pending': section.state === 'not_started',\\n\n                                }\"\\n\n                                x-on:click=\"openSectionKeys[section.key] = true; $nextTick(() => document.getElementById('section-' + section.key)?.scrollIntoView({ behavior: 'smooth', block: 'start' }))\"\\n\n                            >\\n\n                                <span class=\"row g-2 align-items-center\">\\n\n                                    <span\\n\n                                        class=\"col-auto fw-bold\"\\n\n                                        :class=\"section.state === 'complete' ? 'text-success' : (section.state === 'in_progress' ? 'text-warning' : 'text-secondary')\"\\n\n                                        aria-hidden=\"true\"\\n\n                                        x-text=\"section.state === 'complete' ? '\u2713' : (section.state === 'in_progress' ? '\u25cf' : '\u25cb')\"\\n\n                                    ></span>\\n\n                                    <span class=\"col text-truncate\" x-text=\"section.label\"></span>\\n\n                                    <span class=\"col-auto small text-secondary\" x-text=\"`${section.addressed}/${section.total}`\"></span>\\n\n                                </span>\\n\n                            </button>\\n\n                        </template>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n        </div>\\n\n        <div class=\"card-footer small\">\\n\n            <p class=\"mb-0 text-secondary\" x-show=\"progress.remaining > 0\" x-cloak>\\n\n                <span x-text=\"progress.remaining\"></span> points remaining\\n\n            </p>\\n\n            <p class=\"mb-0 text-success fw-medium\" x-show=\"progress.remaining === 0 && progress.total > 0\" x-cloak>\\n\n                All visible points addressed\\n\n            </p>\\n\n        </div>\\n\n    </nav>\\n\n\\n\n    <template x-for=\"stage in stages\" :key=\"'body-' + stage.key\">\\n\n        <section :data-stage=\"stage.key\">\\n\n            <div class=\"mb-2\">\\n\n                <h3 class=\"h3 mb-0\" x-text=\"stage.label\"></h3>\\n\n                <p class=\"text-secondary small mb-0\" x-show=\"stage.hint\" x-text=\"stage.hint\" x-cloak></p>\\n\n            </div>\\n\n\\n\n            <div class=\"d-flex flex-column gap-2\">\\n\n                <template x-for=\"section in stage.sections\" :key=\"section.key\">\\n\n                    <section\\n\n                        class=\"card\"\\n\n                        :id=\"'section-' + section.key\"\\n\n                        :class=\"{\\n\n                            'border-success': section.state === 'complete',\\n\n                            'is-complete': section.state === 'complete',\\n\n                            'is-open': isSectionOpen(section.key),\\n\n                        }\"\\n\n                        data-inspection-section\\n\n                    >\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"card-header w-100 text-start text-reset bg-transparent border-0 py-3\"\\n\n                            x-on:click=\"toggleSection(section.key)\"\\n\n                            :aria-expanded=\"isSectionOpen(section.key) ? 'true' : 'false'\"\\n\n                        >\\n\n                            <span class=\"row g-2 align-items-center w-100\">\\n\n                                <span\\n\n                                    class=\"col-auto fw-bold\"\\n\n                                    :class=\"section.state === 'complete' ? 'text-success' : (section.state === 'in_progress' ? 'text-warning' : 'text-secondary')\"\\n\n                                    aria-hidden=\"true\"\\n\n                                    x-text=\"section.state === 'complete' ? '\u2713' : (section.state === 'in_progress' ? '\u25cf' : '\u25cb')\"\\n\n                                ></span>\\n\n                                <span class=\"col card-title mb-0\" x-text=\"section.label\"></span>\\n\n                                <span class=\"col-auto small text-secondary\">\\n\n                                    <span x-text=\"section.state_label\"></span>\\n\n                                    \u00b7\\n\n                                    <span x-text=\"`${section.addressed}/${section.total}`\"></span>\\n\n                                </span>\\n\n                            </span>\\n\n                        </button>\\n\n\\n\n                        <div x-show=\"isSectionOpen(section.key)\" x-cloak>\\n\n                            <div class=\"list-group list-group-flush border-top\">\\n\n                                <template x-for=\"point in section.points\" :key=\"point.id\">\\n\n                                    <article\\n\n                                        class=\"list-group-item p-3\"\\n\n                                        :class=\"{\\n\n                                            'is-addressed': point.addressed,\\n\n                                            'is-expanded': point.expanded,\\n\n                                            'has-error': point.saveState === 'error',\\n\n                                            'bg-red-lt': point.saveState === 'error',\\n\n                                        }\"\\n\n                                        :data-point-id=\"point.id\"\\n\n                                        data-inspection-point\\n\n                                    >\\n\n                                        <div class=\"d-flex align-items-center gap-2 mb-2\">\\n\n                                            <h4 class=\"mb-0 flex-fill\" x-text=\"point.label\"></h4>\\n\n                                            <span class=\"text-success\" x-show=\"point.addressed\" x-cloak>\\n\n                                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M9 12l2 2l4 -4\"/></svg>\\n\n                                                <span class=\"visually-hidden\">Addressed</span>\\n\n                                            </span>\\n\n                                        </div>\\n\n\\n\n                                        <div role=\"group\" :aria-label=\"'Condition for ' + point.label\">\\n\n                                            <template x-if=\"point.is_axle_gate && true\">\\n\n                                                <div class=\"d-flex gap-2\">\\n\n                                                    <button type=\"button\" class=\"btn btn-lg flex-fill\" :class=\"rearAxleBrakeType === 'disc' ? 'btn-primary' : 'btn-outline-primary'\" :aria-pressed=\"rearAxleBrakeType === 'disc' ? 'true' : 'false'\" x-on:click=\"setRearAxle(point, 'disc')\">Disc</button>\\n\n                                                    <button type=\"button\" class=\"btn btn-lg flex-fill\" :class=\"rearAxleBrakeType === 'drum' ? 'btn-primary' : 'btn-outline-primary'\" :aria-pressed=\"rearAxleBrakeType === 'drum' ? 'true' : 'false'\" x-on:click=\"setRearAxle(point, 'drum')\">Drum</button>\\n\n                                                </div>\\n\n                                            </template>\\n\n\\n\n                                            <template x-if=\"!point.is_axle_gate\">\\n\n                                                <div class=\"d-flex flex-wrap gap-2\">\\n\n                                                                                                            <template x-for=\"option in point.condition_options\" :key=\"option.value\">\\n\n                                                            <button\\n\n                                                                type=\"button\"\\n\n                                                                class=\"btn btn-lg flex-fill\"\\n\n                                                                :class=\"point.status === option.value ? 'btn-' + ({ good: &#039;success&#039;, monitor: &#039;warning&#039;, needs_attention: &#039;danger&#039;, failed: &#039;danger&#039;, na: &#039;secondary&#039; }[option.value] ?? &#039;primary&#039;) : 'btn-outline-' + ({ good: &#039;success&#039;, monitor: &#039;warning&#039;, needs_attention: &#039;danger&#039;, failed: &#039;danger&#039;, na: &#039;secondary&#039; }[option.value] ?? &#039;primary&#039;)\"\\n\n                                                                :aria-pressed=\"point.status === option.value ? 'true' : 'false'\"\\n\n                                                                :data-condition=\"option.value\"\\n\n                                                                :disabled=\"point.road_test_finding_locked || point.saveState === 'saving'\"\\n\n                                                                x-on:click=\"setCondition(point, option.value)\"\\n\n                                                                x-text=\"option.display\"\\n\n                                                            ></button>\\n\n                                                        </template>\\n\n                                                                                                    </div>\\n\n                                            </template>\\n\n                                        </div>\\n\n\\n\n                                        <div x-show=\"(point.measurement_slots ?? []).length > 0\" x-cloak>\\n\n                                            <div class=\"row g-2 mt-1\">\\n\n                                                <template x-for=\"slot in point.measurement_slots\" :key=\"slot.key\">\\n\n                                                    <label class=\"col-6 col-sm-4\">\\n\n                                                        <span class=\"form-label mb-1\" x-text=\"slot.name\"></span>\\n\n                                                        <span class=\"input-group input-group-lg\">\\n\n                                                            <input\\n\n                                                                type=\"text\"\\n\n                                                                inputmode=\"decimal\"\\n\n                                                                class=\"form-control\"\\n\n                                                                :class=\"{ 'is-invalid': (point.missing_measurement_slots ?? []).includes(slot.name) }\"\\n\n                                                                x-model=\"slot.value\"\\n\n                                                                                                                                    x-on:input=\"scheduleSlots(point)\"\\n\n                                                                    x-on:change=\"saveSlots(point)\"\\n\n                                                                                                                            >\\n\n                                                            <span class=\"input-group-text\" x-text=\"slot.unit ?? ''\" x-show=\"slot.unit\"></span>\\n\n                                                        </span>\\n\n                                                    </label>\\n\n                                                </template>\\n\n                                            </div>\\n\n                                        </div>\\n\n\\n\n                                        <div class=\"small mt-2\" aria-live=\"polite\">\\n\n                                            <span class=\"text-secondary\" x-show=\"point.saveState === 'saving'\" x-cloak>Saving\u2026</span>\\n\n                                            <span class=\"text-success\" x-show=\"point.saveState === 'saved'\" x-cloak>Saved</span>\\n\n                                            <button\\n\n                                                type=\"button\"\\n\n                                                class=\"btn btn-outline-danger\"\\n\n                                                x-show=\"point.saveState === 'error'\"\\n\n                                                x-cloak\\n\n                                                x-on:click=\"retry(point)\"\\n\n                                            >Save failed \u00b7 Retry</button>\\n\n                                        </div>\\n\n\\n\n                                        \\n\n                                        <div class=\"mt-2\" x-show=\"shouldExpandForStatus(point, point.status)\" x-cloak>\\n\n                                            <button\\n\n                                                type=\"button\"\\n\n                                                class=\"btn\"\\n\n                                                :aria-expanded=\"point.expanded ? 'true' : 'false'\"\\n\n                                                x-on:click=\"toggleExpand(point)\"\\n\n                                                x-text=\"point.expanded ? 'Hide details' : 'Details'\"\\n\n                                            ></button>\\n\n                                        </div>\\n\n\\n\n                                        <div\\n\n                                            x-show=\"point.expanded && shouldExpandForStatus(point, point.status)\"\\n\n                                            x-cloak\\n\n                                            x-transition.opacity.duration.100ms\\n\n                                        >\\n\n                                            <div class=\"d-flex flex-column gap-3 mt-3\">\\n\n                                                <div class=\"alert alert-warning mb-0\" x-show=\"point.road_test_finding_locked\" x-cloak>Mark road test performed before recording findings.</div>\\n\n\\n\n                                                <div x-show=\"(point.observation_options ?? []).length > 0\" x-cloak>\\n\n                                                    <div class=\"form-label\">Observation</div>\\n\n                                                    <div class=\"btn-list\" role=\"group\" :aria-label=\"'Observations for ' + point.label\">\\n\n                                                        <template x-for=\"option in point.observation_options\" :key=\"option.key\">\\n\n                                                            <button\\n\n                                                                type=\"button\"\\n\n                                                                class=\"btn\"\\n\n                                                                :class=\"(point.selected_observations ?? []).includes(option.key) ? 'btn-primary' : 'btn-outline-secondary'\"\\n\n                                                                :aria-pressed=\"(point.selected_observations ?? []).includes(option.key) ? 'true' : 'false'\"\\n\n                                                                                                                                    x-on:click=\"toggleObservation(point, option.key)\"\\n\n                                                                                                                                x-text=\"option.label\"\\n\n                                                            ></button>\\n\n                                                        </template>\\n\n                                                    </div>\\n\n                                                </div>\\n\n\\n\n                                                                                                    <label class=\"d-block\">\\n\n                                                        <span class=\"form-label\">Technician note</span>\\n\n                                                        <textarea\\n\n                                                            class=\"form-control\"\\n\n                                                            rows=\"2\"\\n\n                                                            x-model=\"point.note\"\\n\n                                                            x-on:input=\"scheduleNote(point)\"\\n\n                                                            x-on:change=\"saveNote(point)\"\\n\n                                                            placeholder=\"Observation only - not a recommendation or diagnosis\"\\n\n                                                        ></textarea>\\n\n                                                    </label>\\n\n\\n\n                                                    <form\\n\n                                                        method=\"post\"\\n\n                                                        enctype=\"multipart/form-data\"\\n\n                                                        :action=\"point.photo_store_url + (point.photo_store_url.includes('?') ? '&' : '?') + 'return=sections&section=' + encodeURIComponent(section.key)\"\\n\n                                                        data-inspection-point-photo\\n\n                                                    >\\n\n                                                        <input type=\"hidden\" name=\"_token\" value=\"XExcAF2XPWqb3qtHq9sbb5jhDcQ4LJpqCJY039C9\" autocomplete=\"off\">                                                        <div class=\"form-label\">Photo / video</div>\\n\n                                                        <div class=\"row g-2\">\\n\n                                                            <div class=\"col-12 col-sm-4\">\\n\n                                                                <select name=\"purpose\" class=\"form-select form-select-lg\" aria-label=\"Photo purpose\" required>\\n\n                                                                                                                                            <option value=\"internal\" >\\n\n                                                                            Internal\\n\n                                                                        </option>\\n\n                                                                                                                                            <option value=\"customer\" selected>\\n\n                                                                            Customer view\\n\n                                                                        </option>\\n\n                                                                                                                                            <option value=\"before\" >\\n\n                                                                            Before\\n\n                                                                        </option>\\n\n                                                                                                                                            <option value=\"after\" >\\n\n                                                                            After\\n\n                                                                        </option>\\n\n                                                                                                                                    </select>\\n\n                                                            </div>\\n\n                                                            <div class=\"col-12 col-sm\">\\n\n                                                                <input type=\"file\" name=\"photo\" accept=\"image/*,video/mp4,video/quicktime,video/webm\" required class=\"form-control form-control-lg\" aria-label=\"Photo or video file\">\\n\n                                                            </div>\\n\n                                                            <div class=\"col-12 col-sm-auto\">\\n\n                                                                <button type=\"submit\" class=\"btn w-100 btn-lg\">Attach</button>\\n\n                                                            </div>\\n\n                                                        </div>\\n\n                                                    </form>\\n\n                                                \\n\n                                                <div x-show=\"(point.photos ?? []).length > 0\" x-cloak>\\n\n                                                    <div class=\"btn-list\">\\n\n                                                        <template x-for=\"photo in point.photos\" :key=\"photo.id\">\\n\n                                                            <a :href=\"photo.url\" target=\"_blank\" rel=\"noopener\" class=\"avatar avatar-xl rounded\" aria-label=\"Open photo or video\">\\n\n                                                                <img x-show=\"photo.is_image\" :src=\"photo.url\" alt=\"\" class=\"avatar avatar-xl rounded object-fit-cover\">\\n\n                                                                <span class=\"small\" x-show=\"photo.is_video\" x-cloak>Video</span>\\n\n                                                            </a>\\n\n                                                        </template>\\n\n                                                    </div>\\n\n                                                </div>\\n\n                                            </div>\\n\n                                        </div>\\n\n                                    </article>\\n\n                                </template>\\n\n                            </div>\\n\n                        </div>\\n\n                    </section>\\n\n                </template>\\n\n            </div>\\n\n        </section>\\n\n    </template>\\n\n</div>\\n\n                \\n\n                <section class=\"card\" data-inspection-other-findings>\\n\n                    <div class=\"accordion accordion-flush\">\\n\n                        <div class=\"accordion-item\">\\n\n                            <h2 class=\"accordion-header\" id=\"inspection-other-findings-title\">\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"accordion-button py-3 fs-3 collapsed\"\\n\n                                    data-bs-toggle=\"collapse\"\\n\n                                    data-bs-target=\"#inspection-other-findings\"\\n\n                                    aria-controls=\"inspection-other-findings\"\\n\n                                    aria-expanded=\"false\"\\n\n                                >Other Findings</button>\\n\n                            </h2>\\n\n                            <div\\n\n                                id=\"inspection-other-findings\"\\n\n                                class=\"accordion-collapse collapse\"\\n\n                                aria-labelledby=\"inspection-other-findings-title\"\\n\n                            >\\n\n                                <div class=\"accordion-body\">\\n\n                                    <p class=\"text-secondary mb-3\">See something that wasn't covered above? Add it here.</p>\\n\n                                    <div\\n\n    data-inspection-capture\\n\n    x-data=\"{\\n\n        open: false,\\n\n        intent: 'safety',\\n\n        showNote: false,\\n\n        showFab: false,\\n\n        init() {\\n\n            if (! this.$refs.primaryBtn) {\\n\n                return;\\n\n            }\\n\n\\n\n            const observer = new IntersectionObserver(([entry]) => {\\n\n                this.showFab = ! entry.isIntersecting && ! this.open;\\n\n            }, { threshold: 0.15 });\\n\n\\n\n            observer.observe(this.$refs.primaryBtn);\\n\n\\n\n            this.$watch('open', (value) => {\\n\n                if (value) {\\n\n                    this.showFab = false;\\n\n                }\\n\n            });\\n\n        },\\n\n        openCapture() {\\n\n            this.open = true;\\n\n            document.body.classList.add('overflow-hidden');\\n\n            this.$nextTick(() => this.$refs.titleInput?.focus());\\n\n        },\\n\n        closeCapture() {\\n\n            this.open = false;\\n\n            document.body.classList.remove('overflow-hidden');\\n\n\\n\n            const url = new URL(window.location.href);\\n\n\\n\n            if (url.searchParams.has('capture') || url.searchParams.has('concern')) {\\n\n                url.searchParams.delete('capture');\\n\n                url.searchParams.delete('concern');\\n\n                const query = url.searchParams.toString();\\n\n                window.history.replaceState({}, '', url.pathname + (query ? `?${query}` : '') + url.hash);\\n\n            }\\n\n        },\\n\n    }\"\\n\n    x-on:ark-open-finding-capture.window=\"openCapture()\"\\n\n    x-on:keydown.escape.window=\"if (open) closeCapture()\"\\n\n            x-on:keydown.n.window=\"\\n\n            if (open || $event.target.closest('input, textarea, select, [contenteditable=true]')) return;\\n\n            $event.preventDefault();\\n\n            openCapture();\\n\n        \"\\n\n    >\\n\n            <button\\n\n            type=\"button\"\\n\n            class=\"btn btn-primary btn-lg w-100\"\\n\n            data-inspection-finding-btn\\n\n            x-ref=\"primaryBtn\"\\n\n            x-on:click=\"openCapture()\"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M5 12l14 0\"/></svg>\\n\n            Add Finding\\n\n        </button>\\n\n    \\n\n    <div x-show=\"open\" x-cloak x-transition.opacity>\\n\n        <div class=\"modal-backdrop show\" x-on:click=\"closeCapture()\"></div>\\n\n        <div\\n\n            class=\"modal d-block\"\\n\n            tabindex=\"-1\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            aria-labelledby=\"finding-capture-title\"\\n\n            x-on:click.self=\"closeCapture()\"\\n\n            data-inspection-capture-sheet\\n\n        >\\n\n            <div class=\"modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n                <form\\n\n                    method=\"post\"\\n\n                    action=\"http://localhost/app/repair-orders/1/inspection/findings\"\\n\n                    enctype=\"multipart/form-data\"\\n\n                    class=\"modal-content\"\\n\n                >\\n\n                    <div class=\"modal-header\">\\n\n                        <h2 id=\"finding-capture-title\" class=\"modal-title\">Record finding</h2>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close\" x-on:click=\"closeCapture()\"></button>\\n\n                    </div>\\n\n\\n\n                    <div class=\"modal-body\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"XExcAF2XPWqb3qtHq9sbb5jhDcQ4LJpqCJY039C9\" autocomplete=\"off\">\\n\n                        <input type=\"hidden\" name=\"intent\" x-model=\"intent\">\\n\n\\n\n                        <fieldset class=\"mb-2\">\\n\n                            <legend class=\"visually-hidden\">Finding intent</legend>\\n\n                            <div class=\"btn-list\">\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'safety' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'safety' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'safety'\"\\n\n                                    >Safety</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'maintenance' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'maintenance' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'maintenance'\"\\n\n                                    >Maintenance</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'diagnostic' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'diagnostic' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'diagnostic'\"\\n\n                                    >Diagnostic</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'verification' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'verification' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'verification'\"\\n\n                                    >Verification</button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn\"\\n\n                                        x-bind:class=\"intent === 'observation' ? 'btn-primary' : ''\"\\n\n                                        x-bind:aria-pressed=\"intent === 'observation' ? 'true' : 'false'\"\\n\n                                        x-on:click=\"intent = 'observation'\"\\n\n                                    >Observation</button>\\n\n                                                            </div>\\n\n                        </fieldset>\\n\n\\n\n                        <p class=\"form-hint mb-3\">\\n\n                            Finding intent describes the condition - not part source, OEM/aftermarket type, or warranty. Use part line fields when selling parts.\\n\n                        </p>\\n\n\\n\n                        <div class=\"mb-3\">\\n\n                            <label class=\"form-label\" for=\"finding-capture-label\">What did you find?</label>\\n\n                            <input\\n\n                                type=\"text\"\\n\n                                id=\"finding-capture-label\"\\n\n                                name=\"label\"\\n\n                                x-ref=\"titleInput\"\\n\n                                value=\"\"\\n\n                                required\\n\n                                maxlength=\"191\"\\n\n                                placeholder=\"Front brake pads, battery leak, tire tread\u2026\"\\n\n                                class=\"form-control form-control-lg\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n\\n\n                        <div class=\"row g-2 mb-3\">\\n\n                            <div class=\"col\">\\n\n                                <label class=\"form-label\" for=\"finding-capture-measurement\">Measurement</label>\\n\n                                <input\\n\n                                    type=\"text\"\\n\n                                    id=\"finding-capture-measurement\"\\n\n                                    name=\"measurement_value\"\\n\n                                    value=\"\"\\n\n                                    maxlength=\"64\"\\n\n                                    placeholder=\"3\"\\n\n                                    inputmode=\"decimal\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-4\">\\n\n                                <label class=\"form-label\" for=\"finding-capture-unit\">Unit</label>\\n\n                                <input\\n\n                                    type=\"text\"\\n\n                                    id=\"finding-capture-unit\"\\n\n                                    name=\"measurement_unit\"\\n\n                                    value=\"mm\"\\n\n                                    maxlength=\"32\"\\n\n                                    placeholder=\"mm\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n\\n\n                        <div class=\"mb-3\">\\n\n                            <label class=\"form-label\" for=\"finding-capture-photo\">Photo or video</label>\\n\n                            <input\\n\n                                type=\"file\"\\n\n                                id=\"finding-capture-photo\"\\n\n                                name=\"photo\"\\n\n                                accept=\"image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime\"\\n\n                                capture=\"environment\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                            <div class=\"form-hint\">Camera strongly encouraged - photo or short video of the condition.</div>\\n\n                        </div>\\n\n\\n\n                        <div class=\"mb-3\">\\n\n                            <button\\n\n                                type=\"button\"\\n\n                                class=\"btn btn-ghost-primary\"\\n\n                                x-show=\"! showNote\"\\n\n                                x-on:click=\"showNote = true; $nextTick(() => $refs.noteInput?.focus())\"\\n\n                            >+ Add note (optional)</button>\\n\n\\n\n                            <div x-show=\"showNote\" x-cloak>\\n\n                                <label class=\"form-label\" for=\"finding-capture-notes\">Note</label>\\n\n                                <textarea\\n\n                                    id=\"finding-capture-notes\"\\n\n                                    name=\"notes\"\\n\n                                    x-ref=\"noteInput\"\\n\n                                    rows=\"2\"\\n\n                                    maxlength=\"5000\"\\n\n                                    placeholder=\"Location, severity, customer context\u2026\"\\n\n                                    class=\"form-control\"\\n\n                                ></textarea>\\n\n                            </div>\\n\n                        </div>\\n\n\\n\n                                                    <div class=\"mb-3\">\\n\n                                <label class=\"form-label\" for=\"finding-capture-concern\">Link to concern (optional)</label>\\n\n                                <select id=\"finding-capture-concern\" name=\"repair_order_concern_id\" class=\"form-select\">\\n\n                                    <option value=\"\">None</option>\\n\n                                                                            <option value=\"1\" >Brakes grinding</option>\\n\n                                                                    </select>\\n\n                            </div>\\n\n                        \\n\n                                            </div>\\n\n\\n\n                    <div class=\"modal-footer\">\\n\n                        <button type=\"button\" class=\"btn btn-ghost-secondary\" x-on:click=\"closeCapture()\">Cancel</button>\\n\n                        <button type=\"submit\" name=\"add_another\" value=\"1\" class=\"btn\">Save &amp; add another</button>\\n\n                        <button type=\"submit\" class=\"btn btn-primary\">Save finding</button>\\n\n                    </div>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n            \\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"btn btn-primary btn-lg position-fixed end-0 m-3 shadow z-3 d-md-none\"\\n\n             style=\"bottom: 3.5rem\"             x-show=\"showFab && ! open\"\\n\n            x-cloak\\n\n            x-on:click=\"openCapture()\"\\n\n            aria-label=\"Add finding\"\\n\n            data-inspection-finding-fab\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M5 12l14 0\"/></svg>\\n\n            Add Finding\\n\n        </button>\\n\n    </div>\\n\n                                </div>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </section>\\n\n            </div>\\n\n        </div>\\n\n            </main>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div\\n\n    x-data=\"arkImageLightbox()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ops-image-lightbox\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"alt || 'Image preview'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close image preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-dialog-centered modal-xl\" data-bs-theme=\"dark\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header flex-wrap gap-2 py-2\">\\n\n                    <div class=\"small fw-bold text-truncate flex-fill\" x-text=\"alt || 'Attachment preview'\"></div>\\n\n                    <div class=\"btn-list flex-nowrap\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomOut()\"\\n\n                            :disabled=\"scale <= minScale + 0.001\"\\n\n                            aria-label=\"Zoom out\"\\n\n                        >\\n\n                            \u2212\\n\n                        </button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            @click=\"fitToView()\"\\n\n                            x-text=\"zoomPercentLabel()\"\\n\n                            aria-label=\"Reset zoom to fit\"\\n\n                        ></button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomIn()\"\\n\n                            :disabled=\"scale >= maxScale - 0.001\"\\n\n                            aria-label=\"Zoom in\"\\n\n                        >\\n\n                            +\\n\n                        </button>\\n\n                        <a\\n\n                            :href=\"src\"\\n\n                      