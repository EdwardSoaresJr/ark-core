"[]\"\\n\n            data-section=\"inbox\"\\n\n        >\\n\n            <aside\\n\n                id=\"ops-comms-workspace-list\"\\n\n                class=\"col-12 col-lg-4 col-xl-3 flex-column\"\\n\n                :class=\"threadOpen ? 'd-none d-lg-flex' : 'd-flex'\"\\n\n                aria-label=\"Needs attention\"\\n\n            >\\n\n                <div class=\"card flex-fill overflow-hidden\">\\n\n                                        <div id=\"ops-comms-workspace-list-body\" class=\"d-flex flex-column flex-fill overflow-hidden\">\\n\n                        <div class=\"d-flex flex-column flex-fill overflow-hidden\" data-comms-list-panel>\\n\n            <nav class=\"p-2 border-bottom\" aria-label=\"Advisor filter\">\\n\n            <div class=\"btn-group w-100\">\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs&amp;owner=everyone\"\\n\n                        class=\"btn btn-sm active\"\\n\n                         aria-current=\"page\"                     >\\n\n                        Everyone\\n\n                        <span class=\"text-secondary ms-1 d-lg-none d-xxl-inline\">0</span>\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs&amp;owner=mine\"\\n\n                        class=\"btn btn-sm\"\\n\n                                            >\\n\n                        Mine\\n\n                        <span class=\"text-secondary ms-1 d-lg-none d-xxl-inline\">0</span>\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs&amp;owner=unassigned\"\\n\n                        class=\"btn btn-sm\"\\n\n                                            >\\n\n                        Unassigned\\n\n                        <