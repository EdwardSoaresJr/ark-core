    <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We can get you on the schedule. What day works best for you to bring the vehicle in?'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Scheduling\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for your patience - we are running a little behind today but will get back to you as soon as possible.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Running behind\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We offer several payment options at checkout. Let us know if you would like an estimate sent over to review.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Financing\\n\n            </button>\\n\n            </div>\\n\n                    </div>\\n\n                    <div class=\"small text-secondary text-truncate mt-1\" x-show=\"attachmentLabel\" x-text=\"attachmentLabel\" x-cloak></div>\\n\n                    <div class=\"small text-danger fw-medium mt-1\" x-show=\"error !== ''\" x-text=\"error\" x-cloak></div>\\n\n                </div>\\n\n                <div class=\"d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-top\" role=\"group\" aria-label=\"Conversation commands\">\\n\n                    <details\\n\n                        class=\"position-relative\"\\n\n                        x-ref=\"actionsMenu\"\\n\n                        @toggle=\"onActionsMenuToggle($event)\"\\n\n                        @click.outside