          type=\"button\"\\n\n                                        class=\"dropdown-item active\"\\n\n                                        role=\"option\"\\n\n                                        aria-selected=\"true\"\\n\n                                        data-technician-option\\n\n                                        data-technician-value=\"\"\\n\n                                    >Assign tech\u2026</button>\\n\n                                </li>\\n\n                                                                                        <li>\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"dropdown-item\"\\n\n                                        role=\"option\"\\n\n                                        aria-selected=\"false\"\\n\n                                        data-technician-option\\n\n                                        data-technician-value=\"2\"\\n\n                                    >Alex Tech</button>\\n\n                                </li>\\n\n                                                    </ul>\\n\n                    </div>\\n\n\\n\n                    <label class=\"visually-hidden\" for=\"assigned-technician-toolbar-1\">Technician</label>\\n\n                    <select\\n\n                        id=\"assigned-technician-toolbar-1\"\\n\n                        name=\"assigned_technician_id\"\\n\n                        class=\"visually-hidden\"\\n\n                        tabindex=\"-1\"\\n\n                        aria-hidden=\"true\"\\n\n                        data-technician-select\\n\n                        onchange=\"if (String(this.value || '') !== '') { this.form.requestSubmit(); }\"\\n\n                    >\\n\n                                                    <option value=\"\" selected>Assign tech\u2026</option>\\n\n                                                                            <option value=\"2\" >Alex Tech</option>\\n\n                                            </select>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n        \\n\n    </div>\\n\n\\n\n    <div class=\"d-none\" data-ro-mode-toolbar-slot></div>\\n\n</div>\\n\n                    \\n\n                    <dl class=\"row g-0 small mb-0 ark-ro-visit__facts\">\\n\n                        <dt class=\"col-4 text-secondary fw-normal\">Visit type</dt>\\n\n                        <dd class=\"col-8 fw-medium\" data-identity-present=\"visit-posture\">\\n\n                                                            <button\\n\n                                    type=\"button\"\\n\n                                    class=\"ops-visit-inline-trigger fw-medium\"\\n\n                                    title=\"Open to edit visit type\"\\n\n                                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'visit-posture', invokeEl: $event.currentTarget } }))\"\\n\n                                ><span class=\"ops-visit-inline-value\">Not set</span></button>\\n\n                                                    </dd>\\n\n                                                    <dt class=\"col-4 text-secondary fw-normal\">Mileage</dt>\\n\n    <dd\\n\n        class=\"col-8 d-flex flex-wrap align-items-center gap-2 fw-medium ark-mileage-fields\"\\n\n        data-mileage-inline\\n\n        x-data=\"arkRepairOrderMileage({\\n\n            url: 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/mileage',\\n\n            csrf: 'TSsB5A77bGiRLSg2gQlgTLoU6chJe9pENu0pwOT5',\\n\n            estimateVersionField: 'opened_estimate_version',\\n\n            estimateVersion: 1,\\n\n            mileageIn: null,\\n\n            mileageOut: null,\\n\n            legacyMileageIn: null,\\n\n        })\"\\n\n        x-effect=\"syncDraftMarker()\"\\n\n    >\\n\n                                            <span class=\"inline-flex items-center gap-1\" data-mileage-field=\"in\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    x-show=\"!editingIn\"\\n\n                    @click=\"openIn()\"\\n\n                    class=\"ark-mileage-trigger\"\\n\n                    aria-label=\"Edit mileage in\"\\n\n                    :aria-label=\"'Edit mileage in, ' + (displayIn() === '-' ? 'not set' : displayIn())\"\\n\n                    data-mileage-trigger=\"in\"\\n\n                >\\n\n                    <span class=\"ark-mileage-trigger__label\">In</span>\\n\n                    <span class=\"ark-mileage-trigger__value\" x-text=\"displayIn()\">-</span>\\n\n                </button>\\n\n                <span x-show=\"editingIn\" x-cloak class=\"text-secondary text-uppercase small\" aria-hidden=\"true\">In</span>\\n\n                <input\\n\n                    x-show=\"editingIn\"\\n\n                    x-cloak\\n\n                    x-ref=\"mileageInInput\"\\n\n                    type=\"text\"\\n\n                    inputmode=\"numeric\"\\n\n                    autocomplete=\"off\"\\n\n                    aria-label=\"Mileage in\"\\n\n                    x-model=\"mileageIn\"\\n\n                    @blur.debounce.350ms=\"finishIn()\"\\n\n                    @keydown.enter.prevent=\"$event.target.blur()\"\\n\n                    @keydown.escape.prevent=\"cancelIn()\"\\n\n                                        class=\"form-control form-control-sm ark-mileage-input\"\\n\n                    style=\"width: 6.5rem\"\\n\n                    data-mileage-input=\"in\"\\n\n                >\\n\n            </span>\\n\n                                                <span class=\"text-secondary\" aria-hidden=\"true\">\u00b7</span>\\n\n                        <span class=\"inline-flex items-center gap-1\" data-mileage-field=\"out\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    x-show=\"!editingOut\"\\n\n                    @click=\"openOut()\"\\n\n                    class=\"ark-mileage-trigger\"\\n\n                    aria-label=\"Edit mileage out\"\\n\n                    :aria-label=\"'Edit mileage out, ' + (displayOut() === '-' ? 'not set' : displayOut())\"\\n\n                    data-mileage-trigger=\"out\"\\n\n                >\\n\n                    <span class=\"ark-mileage-trigger__label\">Out</span>\\n\n                    <span class=\"ark-mileage-trigger__value\" x-text=\"displayOut()\">-</span>\\n\n                </button>\\n\n                <span x-show=\"editingOut\" x-cloak class=\"text-secondary text-uppercase small\" aria-hidden=\"true\">Out</span>\\n\n                <input\\n\n                    x-show=\"editingOut\"\\n\n                    x-cloak\\n\n                    x-ref=\"mileageOutInput\"\\n\n                    type=\"text\"\\n\n                    inputmode=\"numeric\"\\n\n                    autocomplete=\"off\"\\n\n                    aria-label=\"Mileage out\"\\n\n                    x-model=\"mileageOut\"\\n\n                    @blur.debounce.350ms=\"finishOut()\"\\n\n                    @keydown.enter.prevent=\"$event.target.blur()\"\\n\n                    @keydown.escape.prevent=\"cancelOut()\"\\n\n                                        class=\"form-control form-control-sm ark-mileage-input\"\\n\n                    style=\"width: 6.5rem\"\\n\n                    data-mileage-input=\"out\"\\n\n                >\\n\n            </span>\\n\n                <span x-show=\"saving\" x-cloak class=\"small text-secondary\">Saving\u2026</span>\\n\n        <span x-show=\"error\" x-cloak x-text=\"error\" class=\"small text-danger\"></span>\\n\n    </dd>\\n\n                                                                            \\n\n                            <dt class=\"col-4 text-secondary fw-normal\">Opened</dt>\\n\n                            <dd class=\"col-8 fw-medium text-break\">Nov 24, 2026 10:02 AM</dd>\\n\n                                                                    </dl>\\n\n\\n\n                    \\n\n                                    </div>\\n\n            </div>\\n\n        </section>\\n\n    </div>\\n\n\\n\n    </div>\\n\n    \\n\n        <div class=\"ops-estimate-layout gap-2 mt-2\">\\n\n            <div class=\"ops-estimate-main min-w-0\">\\n\n                <div\\n\n    id=\"repair-order-workspace-tabs\"\\n\n    class=\"card scroll-mt-6\"\\n\n    x-data=\"arkRoWorkspaceTabs({\\n\n        defaultTab: 'builder',\\n\n        storageKey: 'ark:ro-workspace-tab:review:1',\\n\n        tabs: JSON.parse('[\\u0022builder\\u0022,\\u0022inspect\\u0022,\\u0022recommendations\\u0022,\\u0022comms\\u0022,\\u0022history\\u0022]'),\\n\n        lazyTabs: JSON.parse('[\\u0022inspect\\u0022,\\u0022recommendations\\u0022,\\u0022comms\\u0022,\\u0022history\\u0022]'),\\n\n        tabUrl: 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/workspace-tabs',\\n\n        workspaceMode: 'review',\\n\n    })\"\\n\n>\\n\n            <div class=\"card-header\">\\n\n            <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Repair order workspace\">\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-builder\"\\n\n                            aria-controls=\"repair-order-workspace-panel-builder\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"builder\"\\n\n                            :class=\"{ active: tab === 'builder' }\"\\n\n                            x-on:click=\"selectTab('builder')\"\\n\n                            :aria-selected=\"tab === 'builder'\"\\n\n                        >\\n\n                            Estimate\\n\n                                                                                </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-inspect\"\\n\n                            aria-controls=\"repair-order-workspace-panel-inspect\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"inspect\"\\n\n                            :class=\"{ active: tab === 'inspect' }\"\\n\n                            x-on:click=\"selectTab('inspect')\"\\n\n                            :aria-selected=\"tab === 'inspect'\"\\n\n                        >\\n\n                            Inspection\\n\n                                                            \\n\n                                <span\\n\n                                    id=\"ro-inspection-tab-signal\"\\n\n                                    class=\"d-inline-flex align-items-center gap-1 ms-2 small fw-normal text-secondary\"\\n\n                                    data-inspection-posture=\"not_started\"\\n\n                                    title=\"Inspection \u00b7 Not Started \u00b7 Standard Vehicle Inspection\"\\n\n                                >\\n\n                                    <span class=\"status-dot status-secondary\" aria-hidden=\"true\"></span>\\n\n                                    <span class=\"d-none d-sm-inline\">Not Started</span>\\n\n                                    <span class=\"visually-hidden d-sm-none\">Not Started</span>\\n\n                                </span>\\n\n                                                                                </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-recommendations\"\\n\n                            aria-controls=\"repair-order-workspace-panel-recommendations\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"recommendations\"\\n\n                            :class=\"{ active: tab === 'recommendations' }\"\\n\n                            x-on:click=\"selectTab('recommendations')\"\\n\n                            :aria-selected=\"tab === 'recommendations'\"\\n\n                        >\\n\n                            Recommendations\\n\n                                                                                </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-comms\"\\n\n                            aria-controls=\"repair-order-workspace-panel-comms\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"comms\"\\n\n                            :class=\"{ active: tab === 'comms' }\"\\n\n                            x-on:click=\"selectTab('comms')\"\\n\n                            :aria-selected=\"tab === 'comms'\"\\n\n                        >\\n\n                            Communications\\n\n                                                                                </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-history\"\\n\n                            aria-controls=\"repair-order-workspace-panel-history\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"history\"\\n\n                            :class=\"{ active: tab === 'history' }\"\\n\n                            x-on:click=\"selectTab('history')\"\\n\n                            :aria-selected=\"tab === 'history'\"\\n\n                        >\\n\n                            History\\n\n                                                                                </button>\\n\n                    </li>\\n\n                            </ul>\\n\n        </div>\\n\n    \\n\n    <div class=\"card-body\">\\n\n        <div\\n\n            x-show=\"tab === 'builder'\"\\n\n            role=\"tabpanel\"\\n\n            id=\"repair-order-workspace-panel-builder\"\\n\n             aria-labelledby=\"repair-order-workspace-tab-builder\"         >\\n\n            <div class=\"visually-hidden\" data-estimate-tools aria-hidden=\"true\">\\n\n            Dealer quote import is available from Tools and Parts.\\n\n    </div>\\n\n\\n\n                <div id=\"visit-reason\" class=\"card card-sm mb-3 scroll-mt-6\">\\n\n    <div class=\"card-body\">\\n\n        <div class=\"d-flex align-items-start justify-content-between gap-2\">\\n\n            <div class=\"flex-fill\" style=\"min-width: 0\">\\n\n                <h2 class=\"subheader mb-1\">Reason for Visit</h2>\\n\n                                    <p class=\"mb-0 text-secondary fst-italic\">Not recorded yet.</p>\\n\n                            </div>\\n\n                            <div class=\"btn-list flex-nowrap\">\\n\n                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-sm\"\\n\n                        @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'visit-reason', invokeEl: $event.currentTarget } }))\"\\n\n                    >\\n\n                        Add\\n\n                    </button>\\n\n                </div>\\n\n                    </div>\\n\n\\n\n            </div>\\n\n</div>\\n\n\\n\n                <div id=\"estimate-lines\" class=\"scroll-mt-6\" :class=\"worksheetBusyPending ? 'opacity-75 pe-none' : ''\">\\n\n                    <div class=\"mb-2\">\\n\n    <div class=\"d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-1\">\\n\n        <h2 class=\"subheader mb-0\">Recommended Work</h2>\\n\n        <span id=\"worksheet-count\" class=\"small text-secondary\" data-continuity-region=\"worksheet-count\">1 scopes \u00b7 1 lines</span>\\n\n    </div>\\n\n\\n\n    <div id=\"estimate-instruments\" data-continuity-region=\"authorized-money\">\\n\n    <div class=\"row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2\" aria-label=\"Estimate instruments\" data-estimate-instruments>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100 ops-estimate-instrument-opens-context\"\\n\n                                            data-estimate-context-open=\"portal\"\\n\n                        role=\"button\"\\n\n                        tabindex=\"0\"\\n\n                        @click=\"toggleEstimateContext('portal')\"\\n\n                        @keydown.enter.prevent=\"toggleEstimateContext('portal')\"\\n\n                        @keydown.space.prevent=\"toggleEstimateContext('portal')\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"total\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Customer total</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">$150.00</span>\\n\n                                                                                            </span>\\n\n                                                                                        <span class=\"d-block small text-secondary mt-1\">Customer View</span>\\n\n                                                    </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Estimate total</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$150.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Subtotal</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$150.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Customer total</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$150.00</span>\\n\n                    </span>\\n\n                            </span>\\n\n                            <span class=\"d-block small fw-medium text-secondary border-top mt-2 pt-2\">Customer-facing breakdown</span>\\n\n                    </span>\\n\n    </span>\\n\n                </div>\\n\n            </div>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"margin\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Margin</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">100%</span>\\n\n                                                                    <span class=\"badge bg-green-lt\">Excellent</span>\\n\n                                                                                            </span>\\n\n                                                            <span class=\"progress progress-sm mt-2\" aria-hidden=\"true\">\\n\n                                    <span\\n\n                                        class=\"progress-bar bg-green\"\\n\n                              