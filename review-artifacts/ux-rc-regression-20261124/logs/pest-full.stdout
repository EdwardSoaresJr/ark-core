    );\\n\n            }\\n\n        } else if (stoppedHard && pec === 'PRINT_LOCK') {\\n\n            if (window.toastr && typeof window.toastr.warning === 'function') {\\n\n                window.toastr.warning('Print queue stopped (another print is in progress).');\\n\n            }\\n\n        }\\n\n        arkLastPrintSuccessToastAt = 0;\\n\n        var fail = n - ok;\\n\n        if (!stoppedHard) {\\n\n            if (fail > 0 && ok > 0) {\\n\n                if (window.toastr && typeof window.toastr.warning === 'function') {\\n\n                    window.toastr.warning('Printed ' + ok + ', failed or skipped ' + fail);\\n\n                }\\n\n            } else if (fail > 0 && ok === 0) {\\n\n                if (window.toastr && typeof window.toastr.error === 'function') {\\n\n                    window.toastr.error('Parts label batch did not complete (' + fail + ' issue(s))');\\n\n                }\\n\n            } else if (ok > 0) {\\n\n                var doneMsg =\\n\n                    'All print jobs completed - ' +\\n\n                    ok +\\n\n                    ' parts label' +\\n\n                    (ok === 1 ? '' : 's') +\\n\n                    ' sent to printer';\\n\n                if (window.toastr && typeof window.toastr.success === 'function') {\\n\n                    window.toastr.success(doneMsg);\\n\n                }\\n\n            }\\n\n        }\\n\n    } catch (err) {\\n\n        console.error(err);\\n\n        arkNotifyPrintError(err);\\n\n    } finally {\\n\n        if (lockOwner) {\\n\n            arkReleaseLock(lockOwner);\\n\n        }\\n\n        if (btn) {\\n\n            btn.disabled = false;\\n\n            btn.dataset.printing = '';\\n\n        }\\n\n    }\\n\n}\\n\n\\n\nwindow.arkPrintPartsLabelsBatch = arkPrintPartsLabelsBatch;\\n\n\\n\ndocument.addEventListener('DOMContentLoaded', function() {\\n\n    if (typeof arkMonitorQZReconnect === 'function') {\\n\n        arkMonitorQZReconnect();\\n\n    }\\n\n    if (ty