_column_archive\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\\\\\/archive\\u0022,\\u0022labor_column_restore\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\\\\\/restore\\u0022,\\u0022labor_column_destroy\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\\\\\/destroy\\u0022}}'))\"\\n\n    @labor-open-class-settings.window=\"openClassSettings($event.detail?.key)\"\\n\n    @labor-open-create-billing-class.window=\"openCreate()\"\\n\n>\\n\n    \\n\n    <div\\n\n        class=\"modal modal-blur\"\\n\n        tabindex=\"-1\"\\n\n        data-billing-class-settings-modal\\n\n        x-cloak\\n\n        :class=\"{ show: !!draft }\"\\n\n        :style=\"draft ? 'display: block !important; background: rgba(22, 28, 45, 0.45);' : 'display: none !important'\"\\n\n    >\\n\n        <div class=\"modal-dialog modal-dialog-centered modal-lg\" role=\"document\">\\n\n            <div class=\"modal-content\" x-show=\"draft\">\\n\n                <div class=\"modal-header\">\\n\n                    <div>\\n\n                        <h5 class=\"modal-title mb-0\" x-text=\"draft?.key ? ('Class Settings \u00b7 ' + draft.name) : 'Add Billing Class'\"></h5>\\n\n                        <div class=\"text-secondary small\">\\n\n                            Shared commercial settings for all work types. Hourly rates, Min Hrs, and Round To stay on the Labor matrix row.\\n\n                        </div>\\n\n                    </div>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"closeEditor()\"></button>\\n\n                </div>\\n\n                <div class=\"modal-body\" x-show=\"draft\">\\n\n                    <div class=\"alert alert-danger small\" x-show=\"Object.keys(errors).length\" x-cloak>\\n\n                        <template x-for=\"(messages, field) in errors\" :key=\"field\">\\n\n                            <div x-text=\"Array.isArray(messages) ? messages[0] : messages\"></div>\\n\n                        </template>\\n\n                    </div>\\n\n\\n\n                    <div class=\"mb-3\">\\n\n                        <div class=\"subheader mb-2\">Identity</div>\\n\n                        <div class=\"row g-2\">\\n\n                            <div class=\"col-12 col-md-6\">\\n\n                                <label class=\"form-label mb-1\">Billing class name</label>\\n\n                                <input type=\"text\" class=\"form-control form-control-sm\" x-model=\"draft.name\" maxlength=\"255\">\\n\n                            </div>\\n\n                            <div class=\"col-12 col-md-6\">\\n\n                                <label class=\"form-label mb-1\">Pill color</label>\\n\n                                <div class=\"d-flex align-items-center gap-2\">\\n\n                                    <select class=\"form-select form-select-sm\" x-model=\"draft.pill_color\">\\n\n                                        <template x-for=\"color in catalog.pill_colors\" :key=\"color.key\">\\n\n                                            <option :value=\"color.key\" x-text=\"color.label\"></option>\\n\n                                        </template>\\n\n                                    </select>\\n\n                                    <span class=\"badge\" :class=\"pillBadgeClass(draft)\" x-text=\"draft.name || 'Preview'\"></span>\\n\n                                </div>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"mb-3\">\\n\n                        <div class=\"subheader mb-2\">Pricing</div>\\n\n                        <template x-if=\"billingProfile(draft) === 'warranty'\">\\n\n                            <p class=\"form-hint mb-0\">Warranty never collects shop fees. Parts matrix is under Defaults.</p>\\n\n                        </template>\\n\n                        <template x-if=\"billingProfile(draft) !== 'warranty'\">\\n\n                            <div class=\"row g-2\">\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label class=\"form-label mb-1\" x-text=\"billingProfile(draft) === 'fleet' ? 'Fleet shop fees' : 'Shop fees'\"></label>\\n\n                                    <select\\n\n                                        class=\"form-select form-select-sm\"\\n\n                                        :value=\"draft.shop_fees_enabled ? '1' : '0'\"\\n\n                                        @change=\"draft.shop_fees_enabled = $event.target.value === '1'\"\\n\n                                    >\\n\n                                        <option value=\"1\">Use shop rate</option>\\n\n                                        <option value=\"0\">None</option>\\n\n                                    </select>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label class=\"form-label mb-1\" x-text=\"billingProfile(draft) === 'fleet' ? 'Fleet fee rate override %' : 'Fee rate override %'\"></label>\\n\n                                    <input type=\"text\" class=\"form-control form-control-sm\" inputmode=\"decimal\" placeholder=\"Shop default\" x-model=\"draft.shop_fee_rate_override\" :disabled=\"! draft.shop_fees_enabled\">\\n\n                                </div>\\n\n                                <template x-if=\"billingProfile(draft) !== 'fleet'\">\\n\n                                    <div class=\"col-12 col-md-6\">\\n\n                                        <label class=\"form-label mb-1\">Standing discount</label>\\n\n                                        <select class=\"form-select form-select-sm\" x-model=\"draft.discount_type\">\\n\n                                            <option value=\"none\">None</option>\\n\n                                            <option value=\"labor\">Labor</option>\\n\n                                            <option value=\"parts\">Parts</option>\\n\n                                            <option value=\"both\">Labor &amp; parts</option>\\n\n                                        </select>\\n\n                                    </div>\\n\n                                </template>\\n\n                                <template x-if=\"billingProfile(draft) !== 'fleet'\">\\n\n                                    <div class=\"col-12 col-md-6\">\\n\n                                        <label class=\"form-label mb-1\">Discount %</label>\\n\n                                        <input type=\"text\" class=\"form-control form-control-sm\" inputmode=\"decimal\" x-model=\"draft.discount_amount\" placeholder=\"No discount\">\\n\n                                    </div>\\n\n                                </template>\\n\n                            </div>\\n\n                        </template>\\n\n                    </div>\\n\n\\n\n                    <div class=\"mb-3\">\\n\n                        <div class=\"subheader mb-2\">Defaults</div>\\n\n                        <div class=\"row g-2\">\\n\n                            <div class=\"col-12 col-md-6\">\\n\n                                <label class=\"form-label mb-1\" x-text=\"billingProfile(draft) === 'warranty' ? 'Warranty parts matrix' : (billingProfile(draft) === 'fleet' ? 'Fleet parts matrix' : 'Default parts matrix')\"></label>\\n\n                                <select class=\"form-select form-select-sm\" x-model=\"draft.default_parts_matrix_key\">\\n\n                                    <option value=\"\">Shop default</option>\\n\n                                    <template x-for=\"matrix in catalog.parts_matrices\" :key=\"'m-'+matrix.key\">\\n\n                                        <option :value=\"matrix.key\" x-text=\"matrix.name\"></option>\\n\n                                    </template>\\n\n                                </select>\\n\n                            </div>\\n\n                            <div class=\"col-12 col-md-6\">\\n\n                                <label class=\"form-check mt-4\">\\n\n                                    <input class=\"form-check-input\" type=\"checkbox\" x-model=\"draft.is_default\">\\n\n                                    <span class=\"form-check-label\">Shop Default (new customers)</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <template x-if=\"billingProfile(draft) !== 'fleet' && billingProfile(draft) !== 'warranty'\">\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label class=\"form-label mb-1\">New concerns bill as</label>\\n\n                                    <select class=\"form-select form-select-sm\" x-model=\"draft.concern_billing_posture\">\\n\n                                        <option value=\"\">Shop default (from the class name)</option>\\n\n                                        <template x-for=\"posture in catalog.postures\" :key=\"posture.value\">\\n\n                                            <option :value=\"posture.value\" x-text=\"posture.label\"></option>\\n\n                                        </template>\\n\n                                    </select>\\n\n                                </div>\\n\n                            </template>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"mb-3\">\\n\n                        <div class=\"subheader mb-2\">Warranty</div>\\n\n                        <div class=\"row g-2\">\\n\n                            <div class=\"col-12 col-md-6\">\\n\n                                <label class=\"form-label mb-1\">Warranty mode</label>\\n\n                                <select class=\"form-select form-select-sm\" x-model=\"draft.warranty_mode\">\\n\n                                    <template x-for=\"mode in (catalog.warranty_modes || [])\" :key=\"'wm-'+mode.value\">\\n\n                                        <option :value=\"mode.value\" x-text=\"mode.label\"></option>\\n\n                                    </template>\\n\n                                </select>\\n\n                            </div>\\n\n                            <template x-if=\"draft.warranty_mode === 'class_specific'\">\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label class=\"form-check mt-4\">\\n\n                                        <input class=\"form-check-input\" type=\"checkbox\" x-model=\"draft.warranty.third_party\">\\n\n                                        <span class=\"form-check-label\">Third-party administrator</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                            </template>\\n\n                            <template x-if=\"draft.warranty_mode === 'class_specific'\">\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label class=\"form-label mb-1\">Months</label>\\n\n                                    <input type=\"number\" min=\"0\" class=\"form-control form-control-sm\" x-model=\"draft.warranty.months\">\\n\n                                </div>\\n\n                            </template>\\n\n                            <template x-if=\"draft.warranty_mode === 'class_specific'\">\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label class=\"form-label mb-1\">Miles</label>\\n\n                                    <input type=\"number\" min=\"0\" class=\"form-control form-control-sm\" x-model=\"draft.warranty.miles\">\\n\n                                </div>\\n\n                            </template>\\n\n                            <template x-if=\"draft.warranty_mode === 'class_specific'\">\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label class=\"form-check\">\\n\n                                        <input class=\"form-check-input\" type=\"checkbox\" x-model=\"draft.warranty.covers_parts\">\\n\n                                        <span class=\"form-check-label\">Covers parts</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check ms-3\">\\n\n                                        <input class=\"form-check-input\" type=\"checkbox\" x-model=\"draft.warranty.covers_labor\">\\n\n                                        <span class=\"form-check-label\">Covers labor</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                            </template>\\n\n                            <template x-if=\"draft.warranty_mode === 'class_specific'\">\\n\n                                <div class=\"col-12\">\\n\n                                    <label class=\"form-label mb-1\">Description</label>\\n\n                                    <textarea class=\"form-control form-control-sm\" rows=\"2\" x-model=\"draft.warranty.description\"></textarea>\\n\n                                </div>\\n\n                            </template>\\n\n                            <template x-if=\"draft.warranty_mode === 'class_specific'\">\\n\n                                <div class=\"col-12\">\\n\n                                    <label class=\"form-label mb-1\">Exclusions</label>\\n\n                                    <textarea class=\"form-control form-control-sm\" rows=\"2\" x-model=\"draft.warranty.exclusions\"></textarea>\\n\n                                </div>\\n\n                            </template>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"mb-3\">\\n\n                        <div class=\"subheader mb-2\">Document terms</div>\\n\n                        <div class=\"row g-2\">\\n\n                            <div class=\"col-12 col-md-6\">\\n\n                                <label class=\"form-label mb-1\">Terms mode</label>\\n\n                                <select class=\"form-select form-select-sm\" x-model=\"draft.document_terms_mode\">\\n\n                                    <template x-for=\"mode in (catalog.document_terms_modes || [])\" :key=\"'dtm-'+mode.value\">\\n\n                                        <option :value=\"mode.value\" x-text=\"mode.label\"></option>\\n\n                                    </template>\\n\n                                </select>\\n\n                            </div>\\n\n                            <template x-if=\"draft.document_terms_mode !== 'shop_defaults'\">\\n\n                                <div class=\"col-12\">\\n\n                                    <label class=\"form-label mb-1\">Class terms</label>\\n\n                                    <textarea class=\"form-control form-control-sm\" rows=\"3\" x-model=\"draft.document_terms\" placeholder=\"Shown on estimates and invoices for concerns on this class\"></textarea>\\n\n                                </div>\\n\n                            </template>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"mb-2\">\\n\n                        <div class=\"subheader mb-2\">Customer Documents</div>\\n\n                        <p class=\"form-hint mb-2\">Part description is always shown on customer estimates and invoices. Choose optional identifiers for this billing class only.</p>\\n\n                        <div class=\"form-check mb-1\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" id=\"billing-doc-part-number\" x-model=\"draft.document_show_part_number\">\\n\n                            <label class=\"form-check-label\" for=\"billing-doc-part-number\">Show part number</label>\\n\n                        </div>\\n\n                        <div class=\"form-check mb-1\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" id=\"billing-doc-part-brand\" x-model=\"draft.document_show_part_brand\">\\n\n                            <label class=\"form-check-label\" for=\"billing-doc-part-brand\">Show part brand</label>\\n\n                        </div>\\n\n                        <div class=\"form-check mb-0\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" id=\"billing-doc-vendor\" x-model=\"draft.document_show_vendor\">\\n\n                            <label class=\"form-check-label\" for=\"billing-doc-vendor\">Show vendor/supplier</label>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <p class=\"form-hint mb-0 mt-3\" x-show=\"draft.labor_column_key\" :title=\"'Key: ' + draft.labor_column_key\">\\n\n                        Linked labor pricing: <span x-text=\"draft.name\"></span>\\n\n                    </p>\\n\n                    <p class=\"form-hint mb-0 mt-3\" x-show=\"!draft.labor_column_key\">\\n\n                        Legacy unlinked class \u2014 open Save after linking from Add Billing Class, or archive if unused.\\n\n                    </p>\\n\n                </div>\\n\n                <div class=\"modal-footer justify-content-between\">\\n\n                    <div class=\"btn-list\" x-show=\"draft?.key && !creating\">\\n\n                        <button type=\"button\" class=\"btn btn-outline-secondary btn-sm\" x-show=\"draft?.is_active !== false\" @click=\"archiveDraft()\">Archive</button>\\n\n                        <button type=\"button\" class=\"btn btn-outline-primary btn-sm\" x-show=\"draft?.is_active === false\" @click=\"restoreDraft()\">Restore</button>\\n\n                        <button type=\"button\" class=\"btn btn-outline-danger btn-sm\" @click=\"deleteDraft()\">Delete</button>\\n\n                    </div>\\n\n                    <div class=\"btn-list ms-auto\">\\n\n                        <button type=\"button\" class=\"btn\" @click=\"closeEditor()\">Cancel</button>\\n\n                        <button type=\"button\" class=\"btn btn-primary\" @click=\"saveDraft()\" :disabled=\"status === 'saving'\">\\n\n                            <span x-text=\"status === 'saving' ? 'Saving\u2026' : 'Save'\"></span>\\n\n                        </button>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n<script>\\n\ndocument.addEventListener('alpine:init', () => {\\n\n    Alpine.data('arkBillingClasses', (initial) => ({\\n\n        catalog: initial,\\n\n        draft: null,\\n\n        creating: false,\\n\n        status: 'idle',\\n\n        statusMessage: '',\\n\n        errors: {},\\n\n        init() {\\n\n            this.$watch('status', (value) => {\\n\n                if (value === 'saved') {\\n\n                    setTimeout(() => { if (this.status === 'saved') this.status = 'idle'; }, 1800);\\n\n                }\\n\n            });\\n\n            const url = new URL(window.location.href);\\n\n            if (url.searchParams.has('manage-billing-classes')) {\\n\n                url.searchParams.delete('manage-billing-classes');\\n\n                window.history.replaceState({}, '', url);\\n\n            }\\n\n        },\\n\n        shopSettings() {\\n\n            const el = this.$el.closest('[data-shop-settings]');\\n\n            return el ? Alpine.$data(el) : null;\\n\n        },\\n\n        csrf() {\\n\n            return document.querySelector('meta[name=\"csrf-token\"]')?.content || '';\\n\n        },\\n\n        billingProfile(row) {\\n\n            const name = (row?.name || '').toLowerCase().trim();\\n\n            if (name === 'fleet') return 'fleet';\\n\n            if (name === 'warranty') return 'warranty';\\n\n            return 'standard';\\n\n        },\\n\n        pillBadgeClass(row) {\\n\n            const map = {\\n\n                slate: 'bg-secondary-lt',\\n\n                blue: 'bg-blue-lt',\\n\n                green: 'bg-green-lt',\\n\n                amber: 'bg-yellow-lt',\\n\n                orange: 'bg-orange-lt',\\n\n                rose: 'bg-red-lt',\\n\n                violet: 'bg-purple-lt',\\n\n            };\\n\n            return map[row?.pill_color] || 'bg-secondary-lt';\\n\n        },\\n\n        openCreate() {\\n\n            this.creating = true;\\n\n            this.errors = {};\\n\n            this.draft = {\\n\n                key: null,\\n\n                name: '',\\n\n                pill_color: 'slate',\\n\n                document_show_part_number: false,\\n\n                document_show_part_brand: false,\\n\n                document_show_vendor: false,\\n\n                shop_fees_enabled: true,\\n\n                shop_fee_rate_override: null,\\n\n                default_parts_matrix_key: '',\\n\n                discount_type: 'none',\\n\n                discount_amount: null,\\n\n                concern_billing_posture: '',\\n\n                labor_column_key: null,\\n\n                is_default: false,\\n\n                warranty_mode: 'inherit_shop',\\n\n                warranty: { months: null, miles: null, covers_parts: false, covers_labor: false, description: '', exclusions: '', third_party: false },\\n\n                document_terms_mode: 'shop_defaults',\\n\n                document_terms: '',\\n\n            };\\n\n        },\\n\n        openClassSettings(key) {\\n\n            if (!key) {\\n\n                this.status = 'error';\\n\n                this.statusMessage = 'That labor column has no linked customer Billing Class. Use the row actions to archive or delete it.';\\n\n                return;\\n\n            }\\n\n            const row = (this.catalog.classes || []).find((item) => item.key === key);\\n\n            if (!row) {\\n\n                this.refreshCatalog().then(() => {\\n\n                    const again = (this.catalog.classes || []).find((item) => item.key === key);\\n\n                    if (!again) {\\n\n                        this.status = 'error';\\n\n                        this.statusMessage = 'Billing class not found.';\\n\n                        return;\\n\n                    }\\n\n                    this.creating = false;\\n\n                    this.errors = {};\\n\n                    this.draft = this.cloneDraft(again);\\n\n                });\\n\n                return;\\n\n            }\\n\n            this.creating = false;\\n\n            this.errors = {};\\n\n            this.draft = this.cloneDraft(row);\\n\n        },\\n\n        cloneDraft(row) {\\n\n            const warranty = row.warranty || {};\\n\n            return {\\n\n                key: row.key,\\n\n                name: row.name,\\n\n                pill_color: row.pill_color || 'slate',\\n\n                document_show_part_number: !!row.document_show_part_number,\\n\n                document_show_part_brand: !!row.document_show_part_brand,\\n\n                document_show_vendor: !!row.document_show_vendor,\\n\n                shop_fees_enabled: !!row.shop_fees_enabled,\\n\n                shop_fee_rate_override: row.shop_fee_rate_override,\\n\n                default_parts_matrix_key: row.default_parts_matrix_key || '',\\n\n                discount_type: row.discount_type || 'none',\\n\n                discount_amount: row.discount_amount,\\n\n                concern_billing_posture: row.concern_billing_posture || '',\\n\n                labor_column_key: row.labor_column_key || null,\\n\n                is_active: row.is_active !== false,\\n\n                is_default: !!row.is_default,\\n\n                is_customer_only: !!row.is_customer_only,\\n\n                warranty_mode: row.warranty_mode || 'inherit_shop',\\n\n                warranty: {\\n\n                    months: warranty.months ?? null,\\n\n                    miles: warranty.miles ?? null,\\n\n                    covers_parts: !!warranty.covers_parts,\\n\n                    covers_labor: !!warranty.covers_labor,\\n\n                    description: warranty.description || '',\\n\n                    exclusions: warranty.exclusions || '',\\n\n                    third_party: !!warranty.third_party,\\n\n                },\\n\n                document_terms_mode: row.document_terms_mode || 'shop_defaults',\\n\n                document_terms: row.document_terms || '',\\n\n            };\\n\n        },\\n\n        lifecycleUrl(template, key) {\\n\n            return String(template || '').replace('__KEY__', encodeURIComponent(key));\\n\n        },\\n\n        async postLifecycle(url, successMessage) {\\n\n            this.status = 'saving';\\n\n            this.errors = {};\\n\n            try {\\n\n                const response = await fetch(url, {\\n\n                    method: 'POST',\\n\n                    headers: {\\n\n                        'Accept': 'application/json',\\n\n                        'X-CSRF-TOKEN': this.csrf(),\\n\n                        'X-Requested-With': 'XMLHttpRequest',\\n\n                    },\\n\n                });\\n\n                const payload = await response.json().catch(() => ({}));\\n\n                if (!response.ok) {\\n\n                    this.errors = payload.errors || { form: [payload.message || successMessage] };\\n\n                    this.status = 'error';\\n\n                    this.statusMessage = Array.isArray(this.errors.key) ? this.errors.key[0] : (payload.message || 'Request failed');\\n\n                    if (Array.isArray(this.errors.references)) {\\n\n                        this.statusMessage += ' \u2014 ' + this.errors.references.join('; ');\\n\n                    }\\n\n                    return false;\\n\n                }\\n\n                if (payload.catalog) this.catalog = payload.catalog;\\n\n                this.status = 'saved';\\n\n                this.statusMessage = payload.status || successMessage;\\n\n                window.dispatchEvent(new CustomEvent('labor-matrix-refresh'));\\n\n                return true;\\n\n            } catch (error) {\\n\n                this.status = 'error';\\n\n                this.statusMessage = error.message || 'Request failed';\\n\n                return false;\\n\n            }\\n\n        },\\n\n        async archiveDraft() {\\n\n            if (!this.draft?.key) return;\\n\n            if (!window.confirm('Archive \u201c' + this.draft.name + '\u201d? It will leave new customer selections but keep historical records.')) return;\\n\n            if (await this.postLifecycle(this.lifecycleUrl(this.catalog.routes?.archive, this.draft.key), 'Archived')) {\\n\n                this.closeEditor();\\n\n            }\\n\n        },\\n\n        async restoreDraft() {\\n\n            if (!this.draft?.key) return;\\n\n            if (await this.postLifecycle(this.lifecycleUrl(this.catalog.routes?.restore, this.draft.key), 'Restored')) {\\n\n                this.closeEditor();\\n\n            }\\n\n        },\\n\n        async deleteDraft() {\\n\n            if (!this.draft?.key) return;\\n\n            if (!window.confirm('Delete \u201c' + this.draft.name + '\u201d only if it was never used? Referenced classes must be archived instead.')) return;\\n\n            const url = this.lifecycleUrl(this.catalog.routes?.destroy, this.draft.key);\\n\n            this.status = 'saving';\\n\n            try {\\n\n                const response = await fetch(url, {\\n\n                    method: 'DELETE',\\n\n                    headers: {\\n\n                        'Accept': 'application/json',\\n\n                        'X-CSRF-TOKEN': this.csrf(),\\n\n                        'X-Requested-With': 'XMLHttpRequest',\\n\n                    },\\n\n                });\\n\n                const payload = await response.json().catch(() => ({}));\\n\n                if (!response.ok) {\\n\n                    this.errors = payload.errors || { form: [payload.message || 'Delete refused'] };\\n\n                    this.status = 'error';\\n\n                    this.statusMessage = Array.isArray(this.errors.key) ? this.errors.key[0] : (payload.message || 'Delete refused');\\n\n                    if (Array.isArray(this.errors.references)) {\\n\n                        this.statusMessage += ' \u2014 ' + this.errors.references.join('; ');\\n\n                    }\\n\n                    return;\\n\n                }\\n\n                if (payload.catalog) this.catalog = payload.catalog;\\n\n                this.status = 'saved';\\n\n                this.statusMessage = payload.status || 'Deleted';\\n\n                this.closeEditor();\\n\n                window.dispatchEvent(new CustomEvent('labor-matrix-refresh'));\\n\n            } catch (error) {\\n\n                this.status = 'error';\\n\n                this.statusMessage = error.message || 'Delete failed';\\n\n            }\\n\n        },\\n\n        closeEditor() {\\n\n            this.draft = null;\\n\n            this.creating = false;\\n\n            this.errors = {};\\n\n        },\\n\n        async refreshCatalog() {\\n\n            this.status = 'loading';\\n\n            try {\\n\n                const response = await fetch('http:\\/\\/localhost\\/app\\/settings\\/shop\\/customer-types', {\\n\n                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },\\n\n                });\\n\n                const payload = await response.json();\\n\n                if (!response.ok) throw new Error('Unable to load billing classes');\\n\n                this.catalog = payload;\\n\n                this.status = 'idle';\\n\n            } catch (error) {\\n\n                this.status = 'error';\\n\n                this.statusMessage = error.message || 'Unable to load billing classes';\\n\n            }\\n\n        },\\n\n        payloadFromDraft() {\\n\n            const draft = this.draft;\\n\n            const warrantyProfile = this.billingProfile(draft) === 'warranty';\\n\n            return {\\n\n                key: draft.key || undefined,\\n\n                name: draft.name,\\n\n                pill_color: draft.pill_color,\\n\n                document_show_part_number: !!draft.document_show_part_number,\\n\n                document_show_part_brand: !!draft.document_show_part_brand,\\n\n                document_show_vendor: !!draft.document_show_vendor,\\n\n                shop_fees_enabled: warrantyProfile ? false : !!draft.shop_fees_enabled,\\n\n                shop_fee_rate_override: warrantyProfile || !draft.shop_fees_enabled ? null : (draft.shop_fee_rate_override || null),\\n\n                default_parts_matrix_key: draft.default_parts_matrix_key || null,\\n\n                discount_type: this.billingProfile(draft) === 'fleet' ? 'none' : (draft.discount_type || 'none'),\\n\n                discount_amount: this.billingProfile(draft) === 'fleet' ? null : draft.discount_amount,\\n\n                labor_column_key: draft.labor_column_key || null,\\n\n                is_default: !!draft.is_default,\\n\n                warranty_mode: draft.warranty_mode || 'inherit_shop',\\n\n                warranty: draft.warranty_mode === 'class_specific' ? {\\n\n                    months: draft.warranty?.months === '' || draft.warranty?.months === null ? null : Number(draft.warranty.months),\\n\n                    miles: draft.warranty?.miles === '' || draft.warranty?.miles === null ? null : Number(draft.warranty.miles),\\n\n                    covers_parts: !!draft.warranty?.covers_parts,\\n\n                    covers_labor: !!draft.warranty?.covers_labor,\\n\n                    description: draft.warranty?.description || '',\\n\n                    exclusions: draft.warranty?.exclusions || '',\\n\n                    third_party: !!draft.warranty?.third_party,\\n\n                } : null,\\n\n                document_terms_mode: draft.document_terms_mode || 'shop_defaults',\\n\n                document_terms: draft.document_terms_mode === 'shop_defaults' ? null : (draft.document_terms || null),\\n\n            };\\n\n        },\\n\n        async saveDraft() {\\n\n            if (!this.draft) return;\\n\n            this.status = 'saving';\\n\n            this.errors = {};\\n\n            const creating = this.creating || !this.draft.key;\\n\n            const url = creating\\n\n                ? 'http:\\/\\/localhost\\/app\\/settings\\/shop\\/customer-types'                : 'http:\\/\\/localhost\\/app\\/settings\\/shop\\/customer-types\\/__KEY__'.replace('__KEY__', encodeURIComponent(this.draft.key));\\n\n            try {\\n\n                const response = await fetch(url, {\\n\n                    method: creating ? 'POST' : 'PATCH',\\n\n                    headers: {\\n\n                        'Content-Type': 'application/json',\\n\n                        'Accept': 'application/json',\\n\n                        'X-CSRF-TOKEN': this.csrf(),\\n\n                        'X-Requested-With': 'XMLHttpRequest',\\n\n                    },\\n\n                    body: JSON.stringify(this.payloadFromDraft()),\\n\n                });\\n\n                const payload = await response.json().catch(() => ({}));\\n\n                if (!response.ok) {\\n\n                    this.errors = payload.errors || { form: [payload.message || 'Save failed'] };\\n\n                    this.status = 'error';\\n\n                    this.statusMessage = payload.message || 'Not saved';\\n\n                    return;\\n\n                }\\n\n                if (payload.catalog) this.catalog = payload.catalog;\\n\n                this.status = 'saved';\\n\n                this.statusMessage = payload.status || 'Saved';\\n\n                this.closeEditor();\\n\n                window.dispatchEvent(new CustomEvent('labor-matrix-refresh'));\\n\n            } catch (error) {\\n\n                this.status = 'error';\\n\n                this.statusMessage = error.message || 'Not saved';\\n\n            }\\n\n        },\\n\n    }));\\n\n});\\n\n</script>\\n\n                </section>\\n\n\\n\n                <section class=\"card\" x-show=\"active === 'overhead'\" x-cloak data-settings-section=\"overhead\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Shop Overhead</div>\\n\n                            <h2 class=\"card-title\">Shop overhead worksheet</h2>\\n\n                            <div class=\"card-subtitle\">Build the shop\u2019s monthly fixed-cost pool and spread it across expected <strong>billed labor hours</strong>. That produces <strong>shop overhead / billed hr</strong>, which feeds each technician\u2019s loaded cost under Staff. Technician wages are entered per tech - not here.</div>\\n\n                            <div class=\"small text-secondary mt-1\">\\n\n                                Full walkthrough:\\n\n                                <button\\n\n        type=\"button\" class=\"ops-learn-guide-link btn btn-link p-0 align-baseline small\"\\n\n        data-arkademy-guide=\"admin:shop-overhead-setup\"\\n\n    >\\n\n        ARKademy \u2192 Shop overhead and loaded labor cost\\n\n    </button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    \\n\n                    <form\\n\n    method=\"POST\"\\n\n    action=\"http://localhost/app/settings/shop/overhead\"\\n\n    @submit.prevent=\"saveOverhead()\"\\n\n    x-data=\"shopOverheadCalculator({\\n\n        technicianCount: 1,\\n\n        workdayHours: 8,\\n\n        billableUtilization: 85,\\n\n        cardProcessingPercent: 2.9,\\n\n        workdaysPerMonth: 22,\\n\n        saveUrl: 'http:\\/\\/localhost\\/app\\/settings\\/shop\\/overhead',\\n\n        initialState: null,\\n\n    })\"\\n\n    data-settings-overhead\\n\n>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n    <div x-data=\"{ overheadGuideOpen: true }\" class=\"card-body border-bottom\" data-overhead-walkthrough>\\n\n        <button\\n\n            type=\"button\"\\n\n            @click=\"overheadGuideOpen = ! overheadGuideOpen\"\\n\n            :aria-expanded=\"overheadGuideOpen.toString()\"\\n\n            aria-controls=\"overhead-walkthrough\"\\n\n            class=\"btn btn-link p-0 w-100 d-flex align-items-center justify-content-between gap-2 text-reset text-decoration-none\"\\n\n        >\\n\n            <span class=\"fw-medium\">Setup walkthrough - start here</span>\\n\n            <span class=\"small text-secondary text-uppercase\" x-text=\"overheadGuideOpen ? 'Hide' : 'Show'\"></span>\\n\n        </button>\\n\n        <div id=\"overhead-walkthrough\" x-show=\"overheadGuideOpen\" x-cloak class=\"mt-3\">\\n\n            <div class=\"alert alert-warning small mb-3\" role=\"note\">\\n\n                <h4 class=\"alert-title\">Payroll is split on purpose - there is no single \u201cpayroll\u201d box for everything.</h4>\\n\n                <ul class=\"text-secondary mb-0 ps-3\" style=\"list-style: disc\">\\n\n                    <li><strong>Technician wages</strong> - Settings \u2192 Staff \u2192 each tech \u2192 Loaded cost calculator (base pay + burden % + shop overhead / hr).</li>\\n\n                    <li><strong>Advisor, front desk, owner (non-billing)</strong> - Fixed Costs tab \u2192 <strong>Office and advisor payroll</strong> (monthly total).</li>\\n\n                    <li><strong>Break-even on Margin Health</strong> - uses this worksheet\u2019s fixed-cost monthly total once saved (shown under Owner Targets). Technician pay is already counted there as labor cost.</li>\\n\n                </ul>\\n\n            </div>\\n\n            <ol class=\"small ps-3 mb-2\" style=\"list-style: decimal\">\\n\n                <li><strong>Fixed Costs</strong> - rent, utilities, insurance, software, equipment, office/advisor payroll, other. <em>Exclude technician straight wages.</em></li>\\n\n                <li><strong>Payment Processing</strong> - estimated card volume, processor %, optional merchant financing.</li>\\n\n                <li><strong>Billing Capacity</strong> - active technicians, workdays, hours, utilization \u2192 monthly billable hours.</li>\\n\n                <li>Review <strong>Shop overhead / billed hr</strong> at the top \u2192 <strong>Save shop overhead</strong>.</li>\\n\n                <li><strong>Settings \u2192 Staff</strong> - for each technician: base pay, burden %, click <strong>Use calculated loaded cost</strong>, save.</li>\\n\n            </ol>\\n\n            <p class=\"small text-secondary mb-0\">Example: $8,700/mo overhead \u00f7 299 billable hr \u2248 <strong>$29.08/hr</strong> shop allocation. A tech at $30/hr base + 28% burden + $29.08 overhead \u2248 <strong>$67/hr</strong> loaded cost on billed hours.</p>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body border-bottom\">\\n\n        <div class=\"row g-3 align-items-center\">\\n\n            <div class=\"col-12 col-md\">\\n\n                <div class=\"subheader\">Monthly overhead pool</div>\\n\n                <p class=\"small text-secondary mb-0\">Fixed shop costs for the whole business - not per technician. Click <strong>Save shop overhead</strong> to persist; staff loaded cost calculators pick up the saved rate, and the monthly total replaces Owner Targets monthly fixed costs.</p>\\n\n            </div>\\n\n            <div class=\"col-12 col-md-auto text-md-end\">\\n\n                <div class=\"subheader\">Shop overhead / billed hr</div>\\n\n                <div class=\"h2 mb-0\" x-text=\"formattedOverheadPerHour()\" data-overhead-rate></div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-header\">\\n\n        <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Shop overhead worksheet\">\\n\n                            <li class=\"nav-item\" role=\"presentation\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"nav-link\"\\n\n                        role=\"tab\"\\n\n                        id=\"overhead-tab-fixed-costs\"\\n\n                        aria-controls=\"overhead-panel-fixed-costs\"\\n\n                        :class=\"{ 'active': overheadTab === 'fixed-costs' }\"\\n\n                        :aria-selected=\"(overheadTab === 'fixed-costs').toString()\"\\n\n                        @click=\"setOverheadTab('fixed-costs')\"\\n\n                    >Fixed Costs</button>\\n\n                </li>\\n\n                            <li class=\"nav-item\" role=\"presentation\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"nav-link\"\\n\n                        role=\"tab\"\\n\n                        id=\"overhead-tab-payments\"\\n\n                        aria-controls=\"overhead-panel-payments\"\\n\n                        :class=\"{ 'active': overheadTab === 'payments' }\"\\n\n                        :aria-selected=\"(overheadTab === 'payments').toString()\"\\n\n                        @click=\"setOverheadTab('payments')\"\\n\n                    >Payment Processing</button>\\n\n                </li>\\n\n                            <li class=\"nav-item\" role=\"presentation\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"nav-link\"\\n\n                        role=\"tab\"\\n\n                        id=\"overhead-tab-capacity\"\\n\n                        aria-controls=\"overhead-panel-capacity\"\\n\n                        :class=\"{ 'active': overheadTab === 'capacity' }\"\\n\n                        :aria-selected=\"(overheadTab === 'capacity').toString()\"\\n\n                        @click=\"setOverheadTab('capacity')\"\\n\n                    >Billing Capacity</button>\\n\n                </li>\\n\n                    </ul>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body\" id=\"overhead-panel-fixed-costs\" role=\"tabpanel\" aria-labelledby=\"overhead-tab-fixed-costs\" x-show=\"overheadTab === 'fixed-costs'\">\\n\n        <h3 class=\"mb-1\">Fixed shop costs</h3>\\n\n        <p class=\"text-secondary small\">Enter each cost with how often you pay it - ARK converts to a monthly total for break-even. Payroll can be weekly; rent is usually monthly. Technician straight wages still belong under <a href=\"http://localhost/app/settings/shop?section=staff\" @click.prevent=\"setActive('staff')\" data-overhead-staff-link>Settings \u2192 Staff</a> when you split loaded cost.</p>\\n\n\\n\n        <div class=\"row g-2 px-3 mb-1 d-none d-md-flex subheader\" aria-hidden=\"true\">\\n\n            <div class=\"col-md-4\">Cost</div>\\n\n            <div class=\"col-md-3\">Amount</div>\\n\n            <div class=\"col-md-2\">Period</div>\\n\n            <div class=\"col-md-2 text-end\">Monthly</div>\\n\n            <div class=\"col-md-1\"></div>\\n\n        </div>\\n\n        <div class=\"list-group\" data-overhead-fixed-costs>\\n\n            <template x-for=\"(line, index) in fixedCostLines\" :key=\"line._key ?? index\">\\n\n                <div class=\"list-group-item\" data-overhead-fixed-cost>\\n\n                    <div class=\"row g-2 align-items-center\">\\n\n                        <div class=\"col-12 col-md-4\">\\n\n                            <label class=\"form-label d-md-none\" :for=\"`overhead-cost-${index}-label`\">Cost</label>\\n\n                            <input\\n\n                                type=\"text\"\\n\n                                :id=\"`overhead-cost-${index}-label`\"\\n\n                                x-model=\"line.label\"\\n\n                                placeholder=\"Rent, payroll, Cintas\u2026\"\\n\n                                :aria-label=\"`Cost ${index + 1}`\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"col-6 col-md-3\">\\n\n                            <label class=\"form-label d-md-none\" :for=\"`overhead-cost-${index}-amount`\">Amount</label>\\n\n                            <div class=\"input-group\">\\n\n                                <span class=\"input-group-text\">$</span>\\n\n                                <input\\n\n                                    type=\"number\"\\n\n                                    min=\"0\"\\n\n                                    step=\"0.01\"\\n\n                                    :id=\"`overhead-cost-${index}-amount`\"\\n\n                                    x-model=\"line.amount\"\\n\n                                    placeholder=\"0\"\\n\n                                    :aria-label=\"`Amount, cost ${index + 1}`\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                        <div class=\"col-6 col-md-2\">\\n\n                            <label class=\"form-label d-md-none\" :for=\"`overhead-cost-${index}-period`\">Period</label>\\n\n                            <select\\n\n                                :id=\"`overhead-cost-${index}-period`\"\\n\n                                x-model=\"line.period\"\\n\n                                :aria-label=\"`Period, cost ${index + 1}`\"\\n\n                                class=\"form-select\"\\n\n                            >\\n\n                                                                    <option value=\"weekly\">Weekly</option>\\n\n                                                                    <option value=\"biweekly\">Biweekly</option>\\n\n                                                                    <option value=\"monthly\">Monthly</option>\\n\n                                                                    <option value=\"annual\">Annual</option>\\n\n                                                            </select>\\n\n                        </div>\\n\n                        <div class=\"col-8 col-md-2 text-md-end\">\\n\n                            <div class=\"small text-secondary d-md-none\">Monthly</div>\\n\n                            <span class=\"fw-medium\" x-text=\"money(monthlyEquivalentForLine(line))\"></span>\\n\n                        </div>\\n\n                        <div class=\"col-4 col-md-1 text-end\">\\n\n                            <button\\n\n                                type=\"button\"\\n\n                                @click=\"removeFixedCostLine(index)\"\\n\n                                title=\"Remove row\"\\n\n                                :aria-label=\"`Remove cost ${index + 1}`\"\\n\n                                class=\"btn btn-sm btn-ghost-danger\"\\n\n                            >\u00d7</button>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n        </div>\\n\n\\n\n        <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3\">\\n\n            <button type=\"button\" @click=\"addFixedCostLine()\" class=\"btn btn-sm\">Add cost</button>\\n\n            <div class=\"small\">\\n\n                <span class=\"text-secondary\">Fixed costs monthly total</span>\\n\n                <strong class=\"ms-2\" x-text=\"money(monthlyFixedOverheadTotal())\"></strong>\\n\n            </div>\\n\n        </div>\\n\n        <p class=\"small text-secondary mt-2 mb-0\">Saving shop overhead also updates <strong>Owner Targets \u2192 Monthly fixed costs</strong> for Margin Health break-even.</p>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body\" id=\"overhead-panel-payments\" role=\"tabpanel\" aria-labelledby=\"overhead-tab-payments\" x-show=\"overheadTab === 'payments'\" x-cloak>\\n\n        <h3 class=\"mb-1\">Card processing &amp; merchant financing</h3>\\n\n        <p class=\"text-secondary small\">Square, Stripe, and similar processors charge a percentage of card volume. Merchant loans and cash advances often take a holdback from deposits <strong>after</strong> processing fees.</p>\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-xl-6\">\\n\n                <label for=\"overhead-card-volume\" class=\"form-label\">Estimated monthly card volume</label>\\n\n                <div class=\"input-group\">\\n\n                    <span class=\"input-group-text\">$</span>\\n\n                    <input id=\"overhead-card-volume\" x-model=\"monthlyCardVolume\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"85000.00\" class=\"form-control\">\\n\n                </div>\\n\n                <div class=\"form-hint\">Typical month of customer card payments - RO closeouts, deposits, and invoices paid by card.</div>\\n\n            </div>\\n\n            <div class=\"col-12 col-md-6 col-xl-3\">\\n\n                <label for=\"overhead-card-processing\" class=\"form-label\">Processing fee %</label>\\n\n                <div class=\"input-group\">\\n\n                    <input id=\"overhead-card-processing\" x-model=\"cardProcessingPercent\" type=\"number\" min=\"0\" step=\"0.01\" class=\"form-control\">\\n\n                    <span class=\"input-group-text\">%</span>\\n\n                </div>\\n\n                <div class=\"form-hint\">Effective card rate from your processor statement. Many shops see 2.6\u20133.3% all-in.</div>\\n\n            </div>\\n\n            <div class=\"col-12 col-md-6 col-xl-3\">\\n\n                <label for=\"overhead-financing-holdback\" class=\"form-label\">Merchant loan holdback %</label>\\n\n                <div class=\"input-group\">\\n\n                    <input id=\"overhead-financing-holdback\" x-model=\"merchantFinancingHoldbackPercent\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"0\" class=\"form-control\">\\n\n                    <span class=\"input-group-text\">%</span>\\n\n                </div>\\n\n                <div class=\"form-hint\">Repayment holdback on deposits after processing fees. Leave blank if no active merchant advance.</div>\\n\n            </div>\\n\n            <div class=\"col-12 col-xl-6\">\\n\n                <label for=\"overhead-financing-payment\" class=\"form-label\">Or fixed monthly financing payment</label>\\n\n                <div class=\"input-group\">\\n\n                    <span class=\"input-group-text\">$</span>\\n\n                    <input id=\"overhead-financing-payment\" x-model=\"fixedMonthlyFinancingPayment\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"0.00\" class=\"form-control\">\\n\n                </div>\\n\n                <div class=\"form-hint\">Use this instead of holdback % when you pay a flat monthly merchant loan or equipment finance payment.</div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"small mt-3\">\\n\n            <div x-show.important=\"monthlyProcessingCost() > 0\" class=\"d-flex justify-content-between gap-3\">\\n\n                <span class=\"text-secondary\">Processing fees</span>\\n\n                <span class=\"fw-medium\" x-text=\"money(monthlyProcessingCost())\"></span>\\n\n            </div>\\n\n            <div x-show.important=\"monthlyFinancingCost() > 0\" class=\"d-flex justify-content-between gap-3\">\\n\n                <span class=\"text-secondary\">Merchant financing</span>\\n\n                <span class=\"fw-medium\" x-text=\"money(monthlyFinancingCost())\"></span>\\n\n            </div>\\n\n            <div x-show.important=\"monthlyPaymentOverheadTotal() > 0\" class=\"d-flex justify-content-between gap-3 border-top pt-1 mt-1\">\\n\n                <span class=\"text-secondary\">Payment costs subtotal</span>\\n\n                <span class=\"fw-medium\" x-text=\"money(monthlyPaymentOverheadTotal())\"></span>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"d-flex justify-content-between gap-3 border-top pt-2 mt-2\">\\n\n            <strong>Monthly overhead total</strong>\\n\n            <strong x-text=\"money(monthlyOverheadTotal())\"></strong>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body\" id=\"overhead-panel-capacity\" role=\"tabpanel\" aria-labelledby=\"overhead-tab-capacity\" x-show=\"overheadTab === 'capacity'\" x-cloak>\\n\n        <h3 class=\"mb-1\">Shop billing capacity</h3>\\n\n        <p class=\"text-secondary small\">Expected billed hours the whole shop produces in a typical month. Technician count is prefilled from active staff - adjust if your real capacity differs.</p>\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                <label for=\"overhead-technician-count\" class=\"form-label\">Active technicians</label>\\n\n                <input id=\"overhead-technician-count\" x-model=\"technicianCount\" type=\"number\" min=\"1\" step=\"1\" class=\"form-control\">\\n\n                <div class=\"form-hint\">How many techs bill labor in a typical month.</div>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                <label for=\"overhead-workdays\" class=\"form-label\">Workdays / month</label>\\n\n                <input id=\"overhead-workdays\" x-model=\"workdaysPerMonth\" type=\"number\" min=\"1\" max=\"31\" step=\"0.5\" class=\"form-control\">\\n\n                <div class=\"form-hint\">Paid shop days in a typical month. Default 22 \u2248 Mon\u2013Fri minus holidays.</div>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                <label for=\"overhead-workday-hours\" class=\"form-label\">Workday hours</label>\\n\n                <input id=\"overhead-workday-hours\" x-model=\"workdayHours\" type=\"number\" min=\"1\" max=\"24\" step=\"0.25\" class=\"form-control\">\\n\n                <div class=\"form-hint\">Average clock hours per technician per workday.</div>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                <label for=\"overhead-utilization\" class=\"form-label\">Billable utilization %</label>\\n\n                <input id=\"overhead-utilization\" x-model=\"billableUtilization\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" class=\"form-control\">\\n\n                <div class=\"form-hint\">Share of paid time that becomes billable hours across the shop.</div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"overheadPerBilledHour() !== null\" x-cloak class=\"small border-top pt-3 mt-3\" data-overhead-breakdown>\\n\n            <div class=\"subheader mb-2\">How this adds up</div>\\n\n            <div class=\"mb-2\">\\n\n                <div class=\"d-flex justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">Monthly overhead pool</span>\\n\n                    <span class=\"fw-medium\" x-text=\"money(monthlyOverheadTotal())\"></span>\\n\n                </div>\\n\n                <div class=\"text-secondary\">fixed costs + card processing + merchant financing</div>\\n\n            </div>\\n\n            <div class=\"mb-2\">\\n\n                <div class=\"d-flex justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">Monthly billable hours</span>\\n\n                    <span class=\"fw-medium\" x-text=\"`${monthlyBillableHours()} hr`\"></span>\\n\n                </div>\\n\n                <div class=\"text-secondary\">technicians \u00d7 workdays \u00d7 workday hours \u00d7 utilization</div>\\n\n            </div>\\n\n            <div class=\"border-top pt-2\">\\n\n                <div class=\"d-flex justify-content-between gap-3\">\\n\n                    <strong>Shop overhead / billed hr</strong>\\n\n                    <strong x-text=\"formattedOverheadPerHour()\"></strong>\\n\n                </div>\\n\n                <div class=\"text-secondary\">monthly overhead \u00f7 monthly billable hours</div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-footer\">\\n\n        <div class=\"row g-3 align-items-center\">\\n\n            <div class=\"col-12 col-md\" data-overhead-status>\\n\n                <p x-show=\"dirty && ! saving && ! saved\" x-cloak class=\"small fw-medium text-warning mb-1\">Unsaved changes - save before leaving this page.</p>\\n\n                <p x-show=\"saved\" x-cloak class=\"small fw-medium text-success mb-1\">Shop overhead saved. Staff loaded cost calculators will pick this up.</p>\\n\n                <p x-show=\"saveError\" x-cloak class=\"small fw-medium text-danger mb-1\" role=\"alert\" x-text=\"saveError\"></p>\\n\n                <p class=\"small text-secondary mb-0\">Next: under <a href=\"http://localhost/app/settings/shop?section=staff\" @click.prevent=\"setActive('staff')\" data-overhead-staff-link>Settings \u2192 Staff</a>, edit each <strong>technician</strong> - enter base pay and burden, confirm overhead / hr prefilled, click <strong>Use calculated loaded cost</strong>, then <strong>Save changes</strong>. Advisors do not use loaded labor cost - their payroll belongs in Office and advisor payroll above.</p>\\n\n            </div>\\n\n            <div class=\"col-12 col-md-auto\">\\n\n                <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"saving\">\\n\n                    <span x-show=\"! saving\">Save shop overhead</span>\\n\n                    <span x-show=\"saving\" x-cloak>Saving\u2026</span>\\n\n                </button>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</form>\\n\n                </section>\\n\n\\n\n                <section class=\"card\" x-show=\"active === 'operations'\" x-cloak data-settings-section=\"operations\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Appointments &amp; Setup</div>\\n\n                            <h2 class=\"card-title\">Appointments, bays, and shop setup</h2>\\n\n                            <div class=\"card-subtitle\">Shop-wide options: appointments and bays, station presence, shop profile presets, and importing customers from a spreadsheet.</div>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\">\\n\n                        <h3 class=\"mb-1\">Appointments</h3>\\n\n                        <p class=\"text-secondary small\">Booking rules, scheduling hours, customer request windows, and bays. Also controls Today&apos;s Appointments on Work.</p>\\n\n\\n\n                        <form method=\"POST\" action=\"http://localhost/app/settings/shop/appointments\" style=\"max-width: 48rem\" data-settings-appointments>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n    <div class=\"d-flex flex-wrap align-items-start justify-content-between gap-3\">\\n\n        <div>\\n\n            <h4 class=\"mb-1\">Enable Appointments</h4>\\n\n            <p class=\"text-secondary small mb-0\">\\n\n                Turn scheduling on when staff are trained and appointments have a clear path into Check In or repair orders.\\n\n                Disabled by default - Work stays the advisor front door until you are ready.\\n\n            </p>\\n\n        </div>\\n\n        <label class=\"form-check form-switch mb-0 flex-shrink-0\">\\n\n            <input type=\"hidden\" name=\"appointments_enabled\" value=\"0\">\\n\n            <input\\n\n                type=\"checkbox\"\\n\n                name=\"appointments_enabled\"\\n\n                value=\"1\"\\n\n                class=\"form-check-input\"\\n\n                            >\\n\n            <span class=\"form-check-label\">Disabled</span>\\n\n        </label>\\n\n    </div>\\n\n\\n\n    <div class=\"border-top pt-3 mt-3\">\\n\n        <h4 class=\"mb-1\">Appointment time steps</h4>\\n\n        <p class=\"text-secondary small\">\\n\n            Schedule grid and book/edit time pickers use this increment - no scrolling minute-by-minute.\\n\n        </p>\\n\n        <div style=\"max-width: 20rem\">\\n\n            <label for=\"settings-appointment-slot-minutes\" class=\"form-label\">Increment</label>\\n\n            <select id=\"settings-appointment-slot-minutes\" name=\"appointment_slot_minutes\" class=\"form-select\">\\n\n                                    <option value=\"15\" >\\n\n                        15 minutes\\n\n                    </option>\\n\n                                    <option value=\"30\" selected>\\n\n                        30 minutes\\n\n                    </option>\\n\n                                    <option value=\"60\" >\\n\n                        60 minutes\\n\n                    </option>\\n\n                            </select>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"border-top pt-3 mt-3\">\\n\n        <h4 class=\"mb-1\">Scheduling capacity</h4>\\n\n        <p class=\"text-secondary small\">\\n\n            Appointments reserve soft shop capacity. Bay and technician assignments are optional planning - not required to book.\\n\n        </p>\\n\n\\n\n        <fieldset class=\"mb-3\">\\n\n            <legend class=\"form-label\">Capacity basis</legend>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_capacity_basis\"\\n\n                        value=\"technicians\"\\n\n                        class=\"form-check-input\"\\n\n                                            >\\n\n                    <span class=\"form-check-label\">Technicians</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_capacity_basis\"\\n\n                        value=\"bays\"\\n\n                        class=\"form-check-input\"\\n\n                                            >\\n\n                    <span class=\"form-check-label\">Bays</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_capacity_basis\"\\n\n                        value=\"limiting_resource\"\\n\n                        class=\"form-check-input\"\\n\n                        checked                    >\\n\n                    <span class=\"form-check-label\">Limiting resource</span>\\n\n                </label>\\n\n                    </fieldset>\\n\n\\n\n        <div class=\"mb-3\" style=\"max-width: 20rem\">\\n\n            <label for=\"settings-appointment-scheduling-target\" class=\"form-label\">Scheduling target</label>\\n\n            <div class=\"input-group\">\\n\n                <input\\n\n                    id=\"settings-appointment-scheduling-target\"\\n\n                    type=\"number\"\\n\n                    name=\"appointment_scheduling_target_percent\"\\n\n                    min=\"25\"\\n\n                    max=\"300\"\\n\n                    value=\"100\"\\n\n                    class=\"form-control\"\\n\n                >\\n\n                <span class=\"input-group-text\">%</span>\\n\n                            </div>\\n\n            <div class=\"form-hint\">100% matches base capacity. Above 100% intentionally overpacks the day.</div>\\n\n        </div>\\n\n\\n\n        <fieldset>\\n\n            <legend class=\"form-label\">When target is exceeded</legend>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_capacity_enforcement\"\\n\n                        value=\"warn\"\\n\n                        class=\"form-check-input\"\\n\n                        checked                    >\\n\n                    <span class=\"form-check-label\">Warn and allow</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_capacity_enforcement\"\\n\n                        value=\"block\"\\n\n                        class=\"form-check-input\"\\n\n                                            >\\n\n                    <span class=\"form-check-label\">Block scheduling</span>\\n\n                </label>\\n\n                    </fieldset>\\n\n    </div>\\n\n\\n\n    \\n\n    <div\\n\n        class=\"border-top pt-3 mt-3\"\\n\n        x-data=\"{ followShop: true }\"\\n\n    >\\n\n        <h4 class=\"mb-1\">Scheduling hours</h4>\\n\n        <p class=\"text-secondary small\">\\n\n            Staff appointment booking follows shop Business Hours by default.\\n\n            Customize only when scheduling should blacklist a day or use narrower windows than the phones.\\n\n        </p>\\n\n\\n\n        <label class=\"form-check\">\\n\n            <input type=\"hidden\" name=\"scheduling_hours_follow_shop\" value=\"0\">\\n\n            <input\\n\n                type=\"checkbox\"\\n\n                name=\"scheduling_hours_follow_shop\"\\n\n                value=\"1\"\\n\n                class=\"form-check-input\"\\n\n                x-model=\"followShop\"\\n\n            >\\n\n            <span class=\"form-check-label\">Follow Business Hours</span>\\n\n            <span class=\"form-check-description\">\\n\n                Mon\u2013Fri 9:00 AM \u2013 6:00 PM\\n\n                \u00b7\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=general\"\\n\n                >Edit Business Hours</a>\\n\n            </span>\\n\n        </label>\\n\n\\n\n        <div x-show=\"!followShop\" x-cloak class=\"mt-3\">\\n\n            <div class=\"subheader mb-1\">Custom scheduling windows</div>\\n\n            <p class=\"text-secondary small\">Uncheck a day to blacklist it for appointments. Open/close may be narrower than Business Hours.</p>\\n\n            <div class=\"list-group\">\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"monday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[monday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[monday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                        checked                                    >\\n\n                                    <span class=\"form-check-label fw-medium\">Monday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[monday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Monday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[monday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Monday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"tuesday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[tuesday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[tuesday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                        checked                                    >\\n\n                                    <span class=\"form-check-label fw-medium\">Tuesday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[tuesday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Tuesday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[tuesday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Tuesday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"wednesday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[wednesday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[wednesday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                        checked                                    >\\n\n                                    <span class=\"form-check-label fw-medium\">Wednesday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[wednesday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Wednesday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[wednesday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Wednesday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"thursday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[thursday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[thursday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                        checked                                    >\\n\n                                    <span class=\"form-check-label fw-medium\">Thursday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[thursday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Thursday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[thursday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Thursday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"friday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[friday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[friday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                        checked                                    >\\n\n                                    <span class=\"form-check-label fw-medium\">Friday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[friday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Friday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[friday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Friday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"saturday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[saturday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[saturday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                                                            >\\n\n                                    <span class=\"form-check-label fw-medium\">Saturday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[saturday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Saturday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[saturday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Saturday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                                        <div class=\"list-group-item\" data-scheduling-day=\"sunday\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm-3\">\\n\n                                <label class=\"form-check mb-0\">\\n\n                                    <input type=\"hidden\" name=\"scheduling_hours[sunday][enabled]\" value=\"0\">\\n\n                                    <input\\n\n                                        type=\"checkbox\"\\n\n                                        name=\"scheduling_hours[sunday][enabled]\"\\n\n                                        value=\"1\"\\n\n                                        class=\"form-check-input\"\\n\n                                                                            >\\n\n                                    <span class=\"form-check-label fw-medium\">Sunday</span>\\n\n                                </label>\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[sunday][open]\"\\n\n                                    value=\"09:00\"\\n\n                                    aria-label=\"Sunday opens\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            <div class=\"col-6 col-sm\">\\n\n                                <input\\n\n                                    type=\"time\"\\n\n                                    name=\"scheduling_hours[sunday][close]\"\\n\n                                    value=\"18:00\"\\n\n                                    aria-label=\"Sunday closes\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                            </div>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n    \\n\n    <div class=\"border-top pt-3 mt-3\">\\n\n        <h4 class=\"mb-1\">Appointment Request Availability</h4>\\n\n        <p class=\"text-secondary small\">\\n\n            Controls which days online booking may offer. Independent of Business Hours and staff Scheduling hours above.\\n\n            Closed dates, daily limits, and whether online customers may take an open time are in <a href=\"http://localhost/app/settings/booking\">Online requests</a>.\\n\n        </p>\\n\n\\n\n        <fieldset class=\"mb-3\">\\n\n            <legend class=\"form-label\">Accept requests</legend>\\n\n            <div class=\"row g-2\">\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][monday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][monday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                checked                            >\\n\n                            <span class=\"form-check-label\">Monday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][tuesday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][tuesday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                checked                            >\\n\n                            <span class=\"form-check-label\">Tuesday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][wednesday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][wednesday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                checked                            >\\n\n                            <span class=\"form-check-label\">Wednesday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][thursday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][thursday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                checked                            >\\n\n                            <span class=\"form-check-label\">Thursday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][friday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][friday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                checked                            >\\n\n                            <span class=\"form-check-label\">Friday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][saturday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][saturday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                                            >\\n\n                            <span class=\"form-check-label\">Saturday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                                    <div class=\"col-6 col-sm-3\">\\n\n                        <label class=\"form-check mb-0\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[weekly][sunday][enabled]\" value=\"0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"appointment_request_availability[weekly][sunday][enabled]\"\\n\n                                value=\"1\"\\n\n                                class=\"form-check-input\"\\n\n                                                            >\\n\n                            <span class=\"form-check-label\">Sunday</span>\\n\n                        </label>\\n\n                    </div>\\n\n                            </div>\\n\n        </fieldset>\\n\n\\n\n                <fieldset class=\"mb-3\">\\n\n            <legend class=\"form-label\">How far ahead can customers request?</legend>\\n\n            <input type=\"hidden\" name=\"appointment_request_availability[horizon_is_custom]\" value=\"0\">\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_request_availability[horizon_days]\"\\n\n                        value=\"7\"\\n\n                        class=\"form-check-input\"\\n\n                                                onclick=\"this.form.elements['appointment_request_availability[horizon_is_custom]'].value='0'\"\\n\n                    >\\n\n                    <span class=\"form-check-label\">7 days</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_request_availability[horizon_days]\"\\n\n                        value=\"14\"\\n\n                        class=\"form-check-input\"\\n\n                        checked                        onclick=\"this.form.elements['appointment_request_availability[horizon_is_custom]'].value='0'\"\\n\n                    >\\n\n                    <span class=\"form-check-label\">14 days</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_request_availability[horizon_days]\"\\n\n                        value=\"30\"\\n\n                        class=\"form-check-input\"\\n\n                                                onclick=\"this.form.elements['appointment_request_availability[horizon_is_custom]'].value='0'\"\\n\n                    >\\n\n                    <span class=\"form-check-label\">30 days</span>\\n\n                </label>\\n\n                        <label class=\"form-check mb-0\">\\n\n                <input\\n\n                    type=\"radio\"\\n\n                    name=\"appointment_request_availability[horizon_days]\"\\n\n                    value=\"custom\"\\n\n                    class=\"form-check-input\"\\n\n                                        onclick=\"this.form.elements['appointment_request_availability[horizon_is_custom]'].value='1'\"\\n\n                >\\n\n                <span class=\"form-check-label d-inline-flex flex-wrap align-items-center gap-2\">\\n\n                    Custom:\\n\n                    <input\\n\n                        type=\"number\"\\n\n                        min=\"1\"\\n\n                        max=\"90\"\\n\n                        name=\"appointment_request_availability[horizon_custom_days]\"\\n\n                        value=\"21\"\\n\n                        aria-label=\"Custom request horizon in days\"\\n\n                        class=\"form-control form-control-sm\"\\n\n                        style=\"width: 5rem\"\\n\n                        onfocus=\"this.form.querySelector('input[name=\\'appointment_request_availability[horizon_days]\\'][value=custom]').checked=true; this.form.elements['appointment_request_availability[horizon_is_custom]'].value='1'\"\\n\n                    >\\n\n                    <span class=\"text-secondary\">days</span>\\n\n                </span>\\n\n            </label>\\n\n        </fieldset>\\n\n\\n\n        <fieldset class=\"mb-3\">\\n\n            <legend class=\"form-label\">Minimum notice</legend>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_request_availability[minimum_notice_days]\"\\n\n                        value=\"0\"\\n\n                        class=\"form-check-input\"\\n\n                        checked                    >\\n\n                    <span class=\"form-check-label\">Same day allowed</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_request_availability[minimum_notice_days]\"\\n\n                        value=\"1\"\\n\n                        class=\"form-check-input\"\\n\n                                            >\\n\n                    <span class=\"form-check-label\">1 day</span>\\n\n                </label>\\n\n                            <label class=\"form-check\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"appointment_request_availability[minimum_notice_days]\"\\n\n                        value=\"2\"\\n\n                        class=\"form-check-input\"\\n\n                                            >\\n\n                    <span class=\"form-check-label\">2 days</span>\\n\n                </label>\\n\n                    </fieldset>\\n\n\\n\n                <fieldset class=\"mb-3\">\\n\n            <legend class=\"form-label\">Appointment request preferences</legend>\\n\n            <p class=\"text-secondary small\">\\n\n                These settings control the times customers can <strong>request</strong>. Staff still confirms an exact appointment time.\\n\n            </p>\\n\n\\n\n            <div class=\"list-group mb-3\">\\n\n                                    <div class=\"list-group-item\" data-request-window=\"morning\">\\n\n                        <label class=\"form-check mb-2\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[request_windows][morning][enabled]\" value=\"0\">\\n\n                            <input type=\"checkbox\" name=\"appointment_request_availability[request_windows][morning][enabled]\" value=\"1\" class=\"form-check-input\" checked>\\n\n                            <span class=\"form-check-label fw-medium\">Accept morning requests</span>\\n\n                        </label>\\n\n                        <div class=\"row g-2\">\\n\n                            <div class=\"col-6\">\\n\n                                <label for=\"settings-request-window-morning-open\" class=\"form-label\">From</label>\\n\n                                <input id=\"settings-request-window-morning-open\" type=\"time\" name=\"appointment_request_availability[request_windows][morning][open]\" value=\"09:00\" class=\"form-control\">\\n\n                            </div>\\n\n                            <div class=\"col-6\">\\n\n                                <label for=\"settings-request-window-morning-close\" class=\"form-label\">To</label>\\n\n                                <input id=\"settings-request-window-morning-close\" type=\"time\" name=\"appointment_request_availability[request_windows][morning][close]\" value=\"12:00\" class=\"form-control\">\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                                    <div class=\"list-group-item\" data-request-window=\"afternoon\">\\n\n                        <label class=\"form-check mb-2\">\\n\n                            <input type=\"hidden\" name=\"appointment_request_availability[request_windows][afternoon][enabled]\" value=\"0\">\\n\n                            <input type=\"checkbox\" name=\"appointment_request_availability[request_windows][afternoon][enabled]\" value=\"1\" class=\"form-check-input\" checked>\\n\n                            <span class=\"form-check-label fw-medium\">Accept afternoon requests</span>\\n\n                        </label>\\n\n                        <div class=\"row g-2\">\\n\n                            <div class=\"col-6\">\\n\n                                <label for=\"settings-request-window-afternoon-open\" class=\"form-label\">From</label>\\n\n                                <input id=\"settings-request-window-afternoon-open\" type=\"time\" name=\"appointment_request_availability[request_windows][afternoon][open]\" value=\"12:00\" class=\"form-control\">\\n\n                            </div>\\n\n                            <div class=\"col-6\">\\n\n                                <label for=\"settings-request-window-afternoon-close\" class=\"form-label\">To</label>\\n\n                                <input id=\"settings-request-window-afternoon-close\" type=\"time\" name=\"appointment_request_availability[request_windows][afternoon][close]\" value=\"16:00\" class=\"form-control\">\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                            </div>\\n\n\\n\n            <label class=\"form-check mb-0\">\\n\n                <input type=\"hidden\" name=\"appointment_request_availability[request_windows][flexible_enabled]\" value=\"0\">\\n\n                <input type=\"checkbox\" name=\"appointment_request_availability[request_windows][flexible_enabled]\" value=\"1\" class=\"form-check-input\" checked>\\n\n                <span class=\"form-check-label\">Accept flexible / any-time requests</span>\\n\n            </label>\\n\n        </fieldset>\\n\n\\n\n        <fieldset>\\n\n            <legend class=\"form-label\">Optional latest arrival</legend>\\n\n            <p class=\"text-secondary small\">\\n\n                Request windows (Morning / Afternoon above) only describe customer preference.\\n\n                Confirmed appointments may still use any valid time within shop scheduling hours unless you enable a cutoff here.\\n\n            </p>\\n\n            <label class=\"form-check\">\\n\n                <input type=\"hidden\" name=\"appointment_request_availability[request_windows][latest_appointment_arrival_enabled]\" value=\"0\">\\n\n                <input\\n\n                    type=\"checkbox\"\\n\n                    name=\"appointment_request_availability[request_windows][latest_appointment_arrival_enabled]\"\\n\n                    value=\"1\"\\n\n                    class=\"form-check-input\"\\n\n                                    >\\n\n                <span class=\"form-check-label\">Limit how late staff can schedule appointment starts</span>\\n\n            </label>\\n\n            <div style=\"max-width: 20rem\">\\n\n                <label for=\"settings-latest-appointment-arrival\" class=\"form-label\">Latest appointment arrival</label>\\n\n                <input\\n\n                    id=\"settings-latest-appointment-arrival\"\\n\n                    type=\"time\"\\n\n                    name=\"appointment_request_availability[request_windows][latest_appointment_arrival]\"\\n\n                    value=\"16:00\"\\n\n                    class=\"form-control\"\\n\n                >\\n\n                <div class=\"form-hint\">Optional. Leave unchecked to allow starts through normal scheduling hours (e.g. close at 6:00 PM).</div>\\n\n            </div>\\n\n                    </fieldset>\\n\n    </div>\\n\n\\n\n    <div class=\"border-top pt-3 mt-3\" data-settings-station-presence>\\n\n    <h4 class=\"mb-1\">Station presence</h4>\\n\n    <p class=\"text-secondary small mb-0\">\\n\n        ARK no longer uses a full-screen station lock. Basic shops work without choosing a station; the bind prompt stays off until stations are explicitly enabled from Advanced Settings (no enablement flag exists yet\u2014only the retired idle-lock minutes field).\\n\n        Station names and phones live under <strong>Stations &amp; Phones</strong>. Optional station PINs remain under Profile for legacy handoff only.\\n\n    </p>\\n\n    <input type=\"hidden\" name=\"workstation_idle_lock_minutes\" value=\"0\">\\n\n</div>\\n\n\\n\n    <div class=\"d-flex flex-wrap align-items-center justify-content-end gap-3 border-top pt-3 mt-3\">\\n\n                <button type=\"submit\" class=\"btn btn-primary\">\\n\n            Save appointment settings\\n\n        </button>\\n\n    </div>\\n\n</form>\\n\n\\n\n\\n\n<div class=\"border-top pt-4 mt-4\" style=\"max-width: 48rem\" data-settings-bays>\\n\n    <h4 class=\"mb-1\">Bays</h4>\\n\n    <p class=\"text-secondary small\">\\n\n        Operational work locations. They may contribute to schedule-capacity planning. Appointments do not require a bay assignment. Front Counter and phone places stay under Communications \u2192 Stations.\\n\n    </p>\\n\n\\n\n    <div class=\"list-group mb-3\">\\n\n                    <div class=\"list-group-item text-secondary small\">No bays yet. Add Bay 1 when you want bay capacity or optional bay planning on appointments.</div>\\n\n            </div>\\n\n\\n\n    <form method=\"POST\" action=\"http://localhost/app/settings/shop/appointments/bays\" class=\"card card-sm\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <div class=\"card-body\">\\n\n            <div class=\"subheader mb-2\">Add a bay</div>\\n\n            <div class=\"row g-2\">\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <input\\n\n                        type=\"text\"\\n\n                        name=\"name\"\\n\n                        value=\"\"\\n\n                        required\\n\n                        placeholder=\"Bay 1\"\\n\n                        aria-label=\"Bay name\"\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                                    </div>\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <input\\n\n                        type=\"text\"\\n\n                        name=\"location_label\"\\n\n                        value=\"\"\\n\n                        placeholder=\"Location (optional)\"\\n\n                        aria-label=\"Bay location\"\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                </div>\\n\n            </div>\\n\n            <div class=\"mt-2\">\\n\n                <button type=\"submit\" class=\"btn btn-sm\">\\n\n                    Add bay\\n\n                </button>\\n\n            </div>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\">\\n\n                        <div data-settings-operational-profile>\\n\n    <h3 class=\"mb-1\">Shop profile</h3>\\n\n    <p class=\"text-secondary small\">\\n\n        Defaults only - not a different product. Applying a profile updates appointments, Check In visit mode, and printing.\\n\n        Staff-based solo behavior still comes from who is on the roster.\\n\n    </p>\\n\n\\n\n    <form method=\"POST\" action=\"http://localhost/app/settings/shop/operational-profile\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <div class=\"form-selectgroup form-selectgroup-boxes d-flex flex-column flex-md-row\">\\n\n                            <label class=\"form-selectgroup-item flex-fill\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"operational_profile\"\\n\n                        value=\"repair_shop\"\\n\n                                                class=\"form-selectgroup-input\"\\n\n                        required\\n\n                    >\\n\n                    <span class=\"form-selectgroup-label d-flex align-items-start p-3 h-100\">\\n\n                        <span class=\"me-3\">\\n\n                            <span class=\"form-selectgroup-check\"></span>\\n\n                        </span>\\n\n                        <span class=\"form-selectgroup-label-content text-start\">\\n\n                            <span class=\"d-block fw-medium text-body\">\\n\n                                Repair Shop\\n\n                                                            </span>\\n\n                            <span class=\"d-block small text-secondary mt-1\">Bays, appointments, and printing-friendly defaults for a full shop floor.</span>\\n\n                        </span>\\n\n                    </span>\\n\n                </label>\\n\n                            <label class=\"form-selectgroup-item flex-fill\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"operational_profile\"\\n\n                        value=\"solo_shop\"\\n\n                                                class=\"form-selectgroup-input\"\\n\n                        required\\n\n                    >\\n\n                    <span class=\"form-selectgroup-label d-flex align-items-start p-3 h-100\">\\n\n                        <span class=\"me-3\">\\n\n                            <span class=\"form-selectgroup-check\"></span>\\n\n                        </span>\\n\n                        <span class=\"form-selectgroup-label-content text-start\">\\n\n                            <span class=\"d-block fw-medium text-body\">\\n\n                                Solo Shop\\n\n                                                            </span>\\n\n                            <span class=\"d-block small text-secondary mt-1\">Owner-operator defaults - appointments off until you turn them on.</span>\\n\n                        </span>\\n\n                    </span>\\n\n                </label>\\n\n                            <label class=\"form-selectgroup-item flex-fill\">\\n\n                    <input\\n\n                        type=\"radio\"\\n\n                        name=\"operational_profile\"\\n\n                        value=\"mobile_mechanic\"\\n\n                                                class=\"form-selectgroup-input\"\\n\n                        required\\n\n                    >\\n\n                    <span class=\"form-selectgroup-label d-flex align-items-start p-3 h-100\">\\n\n                        <span class=\"me-3\">\\n\n                            <span class=\"form-selectgroup-check\"></span>\\n\n                        </span>\\n\n                        <span class=\"form-selectgroup-label-content text-start\">\\n\n                            <span class=\"d-block fw-medium text-body\">\\n\n                                Mobile Mechanic\\n\n                                                            </span>\\n\n                            <span class=\"d-block small text-secondary mt-1\">On-site intake default; route-friendly scheduling on; label printing off.</span>\\n\n                        </span>\\n\n                    </span>\\n\n                </label>\\n\n                    </div>\\n\n\\n\n        \\n\n        <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">\\n\n                Apply profile defaults\\n\n            </button>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\">\\n\n                        <div data-settings-shop-import>\\n\n    <h3 class=\"mb-1\">Shop import</h3>\\n\n    <p class=\"text-secondary small\">\\n\n        Bring customers (and vehicles) from a spreadsheet so the shop feels familiar on day one.\\n\n        Creates customer and vehicle records only. Repair history is not imported.\\n\n    </p>\\n\n\\n\n    <p class=\"small text-secondary\">\\n\n        <a href=\"http://localhost/app/settings/shop/import/template\">Download CSV template</a>\\n\n        \u00b7 Match by phone, then email \u00b7 Max 5000 rows\\n\n    </p>\\n\n\\n\n    <form method=\"POST\" action=\"http://localhost/app/settings/shop/import/preview\" enctype=\"multipart/form-data\" class=\"row g-2 align-items-end\" style=\"max-width: 36rem\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <div class=\"col-12 col-sm\">\\n\n            <label for=\"shop-csv-file\" class=\"form-label required\">CSV file</label>\\n\n            <input id=\"shop-csv-file\" type=\"file\" name=\"csv\" accept=\".csv,text/csv\" required class=\"form-control\">\\n\n                    </div>\\n\n        <div class=\"col-12 col-sm-auto\">\\n\n            <button type=\"submit\" class=\"btn\">\\n\n                Preview\\n\n            </button>\\n\n        </div>\\n\n    </form>\\n\n\\n\n    </div>\\n\n                    </div>\\n\n                </section>\\n\n\\n\n                                    <section class=\"card\" x-show=\"active === 'staff'\" x-cloak data-settings-section=\"staff\">\\n\n                        <div class=\"card-header\">\\n\n                            <div>\\n\n                                <div class=\"subheader\">Staff Access</div>\\n\n                                <h2 class=\"card-title\">Team logins and roles</h2>\\n\n                                <div class=\"card-subtitle\">Add name, email, and roles - ARK emails a secure setup link so they choose their own password. Select every hat someone wears: admin, advisor, and/or technician.</div>\\n\n                            </div>\\n\n                        </div>\\n\n                        <div class=\"card-body\" data-settings-staff-invite>\\n\n    \\n\n    <h3 class=\"mb-1\">Add team member</h3>\\n\n    <p class=\"text-secondary small\">Sends a setup email with a signed link (valid 7 days).</p>\\n\n\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/settings/staff\"\\n\n        x-data=\"{ roles: JSON.parse('[\\u0022advisor\\u0022]') }\"\\n\n        style=\"max-width: 48rem\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-md-6\">\\n\n                <label for=\"staff-name\" class=\"form-label required\">Name</label>\\n\n                <input id=\"staff-name\" name=\"name\" value=\"\" required class=\"form-control\" autocomplete=\"name\">\\n\n            </div>\\n\n            <div class=\"col-12 col-md-6\">\\n\n                <label for=\"staff-email\" class=\"form-label required\">Email</label>\\n\n                <input id=\"staff-email\" name=\"email\" type=\"email\" value=\"\" required class=\"form-control\" autocomplete=\"username\">\\n\n            </div>\\n\n            <div class=\"col-12 col-md-6\">\\n\n                <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                    <label for=\"staff-phone\" class=\"form-label mb-0\">Cell phone</label>\\n\n                    <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Cell phone help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Used for inbound call ringing when this person is selected in Communications settings.\"\\n\n>?</span>\\n\n                </div>\\n\n                <input id=\"staff-phone\" name=\"phone\" type=\"text\" value=\"\" class=\"form-control\" autocomplete=\"tel\" placeholder=\"(719) 555-0100\">\\n\n            </div>\\n\n            <fieldset class=\"col-12 col-md-6\">\\n\n                <legend class=\"form-label\">Roles</legend>\\n\n                <div class=\"d-flex flex-wrap gap-3\">\\n\n                                            <label class=\"form-check mb-0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"roles[]\"\\n\n                                value=\"admin\"\\n\n                                x-model=\"roles\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Admin</span>\\n\n                        </label>\\n\n                                            <label class=\"form-check mb-0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"roles[]\"\\n\n                                value=\"advisor\"\\n\n                                x-model=\"roles\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Advisor</span>\\n\n                        </label>\\n\n                                            <label class=\"form-check mb-0\">\\n\n                            <input\\n\n                                type=\"checkbox\"\\n\n                                name=\"roles[]\"\\n\n                                value=\"technician\"\\n\n                                x-model=\"roles\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Technician</span>\\n\n                        </label>\\n\n                                    </div>\\n\n            </fieldset>\\n\n            <div class=\"col-12\" x-show=\"roles.includes('technician')\" x-cloak>\\n\n                <label for=\"staff-labor-cost\" class=\"form-label\">Estimated labor cost / hr</label>\\n\n                <input id=\"staff-labor-cost\" name=\"labor_cost\" type=\"number\" min=\"0\" step=\"0.01\" value=\"\" class=\"form-control\" style=\"max-width: 12rem\" placeholder=\"35.00\">\\n\n                <div class=\"form-hint\">Cost per billed hour for labor GP on closed ROs - not a paycheck. Set shop overhead first under Settings \u2192 Shop Overhead.</div>\\n\n                <div\\n\n    x-data=\"loadedLaborCostCalculator({\\n\n        targetInputId: 'staff-labor-cost',\\n\n        shopOverheadPerHour: null,\\n\n        laborPayBasis: 'hourly',\\n\n        flagRate: '',\\n\n        floorRate: '15.16',\\n\n        floorSuggestion: 15.16,\\n\n        floorSuggestionLabel: '2026 Colorado statewide minimum wage suggestion',\\n\n        burdenPercent: 28,\\n\n        billableUtilization: 85,\\n\n    })\"\\n\n    class=\"card card-sm mt-3\"\\n\n    data-loaded-labor-calculator\\n\n>\\n\n    <div class=\"card-body\">\\n\n        <div class=\"d-flex flex-wrap align-items-start justify-content-between gap-3\">\\n\n            <div style=\"max-width: 36rem\">\\n\n                <div class=\"subheader\">Estimated labor cost</div>\\n\n                <p class=\"small text-secondary mb-0\">\\n\n                    Margin planning only - not a paycheck.\\n\n                    Output is cost per <strong>billed</strong> hour for labor GP and efficiency.\\n\n                    <span x-show=\"isHourlyPay()\">Hourly: spread clock wage across billable utilization, then add shop overhead.</span>\\n\n                    <span x-show=\"isFlagPay()\" x-cloak>Flag: take the higher of flag rate and floor \u00f7 utilization, then burden and overhead.</span>\\n\n                </p>\\n\n            </div>\\n\n            <div class=\"text-end\">\\n\n                <div class=\"subheader\">Est. cost / billed hr</div>\\n\n                <div class=\"h2 mb-0 font-monospace\" x-text=\"formattedResult()\" data-loaded-labor-result></div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"row g-3 mt-1\">\\n\n            <fieldset class=\"col-12\">\\n\n                <legend class=\"form-label mb-1\">Pay type</legend>\\n\n                <div class=\"small text-secondary mb-2\">How this technician is paid. Estimated labor cost is for margin - not payroll settlement.</div>\\n\n                \\n\n                <input type=\"hidden\" name=\"labor_pay_basis\" :value=\"payBasis\">\\n\n                <div>\\n\n                                            <label class=\"form-check form-check-inline\">\\n\n                            <input\\n\n                                type=\"radio\"\\n\n                                value=\"hourly\"\\n\n                                x-model=\"payBasis\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Hourly (clock)</span>\\n\n                        </label>\\n\n                                            <label class=\"form-check form-check-inline\">\\n\n                            <input\\n\n                                type=\"radio\"\\n\n                                value=\"flag\"\\n\n                                x-model=\"payBasis\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Flag / book time</span>\\n\n                        </label>\\n\n                                    </div>\\n\n            </fieldset>\\n\n\\n\n            <template x-if=\"isFlagPay()\">\\n\n                <div class=\"col-12\">\\n\n                    <div class=\"row g-3\">\\n\n                        <div class=\"col-12 col-sm-6\">\\n\n                            <label for=\"loaded-labor-staff-labor-cost-flag-rate\" class=\"form-label\">Flag rate</label>\\n\n                            <input id=\"loaded-labor-staff-labor-cost-flag-rate\" name=\"flag_rate\" x-model=\"flagRate\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"30.00\" class=\"form-control\">\\n\n                            <div class=\"form-hint\">What the technician earns for completed flagged production.</div>\\n\n                        </div>\\n\n                        <div class=\"col-12 col-sm-6\">\\n\n                            <label for=\"loaded-labor-staff-labor-cost-floor-rate\" class=\"form-label\">Hourly floor</label>\\n\n                            <input id=\"loaded-labor-staff-labor-cost-floor-rate\" name=\"floor_rate\" x-model=\"floorRate\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"15.16\" class=\"form-control\">\\n\n                            <div class=\"form-hint\">The hourly amount the technician is guaranteed for time worked when flag pay does not cover it.</div>\\n\n                        </div>\\n\n                        <div x-show=\"floorNeedsReview()\" x-cloak class=\"col-12\">\\n\n                            <div class=\"alert alert-warning small mb-0\" role=\"status\">\\n\n                                <div class=\"fw-bold\">Hourly floor may need review</div>\\n\n                                <div class=\"font-monospace\">\\n\n                                    Stored: $<span x-text=\"Number(floorRate).toFixed(2)\"></span>\\n\n                                    \u00b7 Current shop suggestion: $<span x-text=\"Number(floorSuggestion).toFixed(2)\"></span>\\n\n                                </div>\\n\n                                <div x-text=\"floorSuggestionLabel\"></div>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n\\n\n            <div class=\"col-12 col-sm-6\" x-show=\"isHourlyPay()\">\\n\n                <label for=\"loaded-labor-staff-labor-cost-base-wage\" class=\"form-label\" x-text=\"basePayLabel()\"></label>\\n\n                <input id=\"loaded-labor-staff-labor-cost-base-wage\" x-model=\"baseWage\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"30.00\" class=\"form-control\">\\n\n                <div class=\"form-hint\" x-text=\"basePayHint()\"></div>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                    <label for=\"loaded-labor-staff-labor-cost-burden\" class=\"form-label mb-0\">Burden %</label>\\n\n                    <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Burden help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Employer cost on top of wage: payroll tax, benefits, workers comp, retirement match. Most shops land around 25\u201335%; default is 28%.\"\\n\n>?</span>\\n\n                </div>\\n\n                <input id=\"loaded-labor-staff-labor-cost-burden\" x-model=\"burdenPercent\" type=\"number\" min=\"0\" step=\"0.1\" class=\"form-control\">\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                    <label for=\"loaded-labor-staff-labor-cost-overhead\" class=\"form-label mb-0\">Overhead / billed hr</label>\\n\n                    <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Overhead per billed hour help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Shop cost per billed hour from Settings \u2192 Shop Overhead. Prefills automatically when set.\"\\n\n>?</span>\\n\n                </div>\\n\n                <input id=\"loaded-labor-staff-labor-cost-overhead\" x-model=\"overheadPerHour\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"5.00\" class=\"form-control\">\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\" x-show=\"isHourlyPay() || isFlagPay()\">\\n\n                <label for=\"loaded-labor-staff-labor-cost-utilization\" class=\"form-label\">Billable utilization %</label>\\n\n                <input id=\"loaded-labor-staff-labor-cost-utilization\" x-model=\"billableUtilization\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" class=\"form-control\">\\n\n                <div class=\"form-hint\">\\n\n                    <span x-show=\"isHourlyPay()\">How much paid clock time becomes billable hours. Non-billable time includes cleanup, comebacks, training, and shop tasks. 85% on an 8.0-hr day \u2248 6.8 billable hrs.</span>\\n\n                    <span x-show=\"isFlagPay()\" x-cloak>Assumed flagged/billed hours \u00f7 compensable hours. Used only to estimate what the hourly floor costs per produced hour - not a pay rate.</span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"calculationBreakdown()\" x-cloak class=\"border-top pt-3 mt-3 small\" data-loaded-labor-breakdown>\\n\n            <div class=\"subheader mb-2\">How this adds up</div>\\n\n            <template x-if=\"calculationBreakdown()\">\\n\n                <div class=\"font-monospace\">\\n\n                    <div class=\"mb-1\" x-show=\"calculationBreakdown().showsFloorEquivalent\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">Floor-equivalent production cost</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().floorEquivalent)}/billed hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\" x-text=\"`floor \u00f7 ${calculationBreakdown().utilization}% utilization - planning only`\"></div>\\n\n                    </div>\\n\n                    <div class=\"mb-1\" x-show=\"isFlagPay()\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">Effective wage cost</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().effectiveWage)}/billed hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\">max(flag rate, floor-equivalent) - not a stored pay rate</div>\\n\n                    </div>\\n\n                    <div class=\"mb-1\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">After burden</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().payrollLoaded)}/hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\">effective \u00d7 (1 + burden)</div>\\n\n                    </div>\\n\n                    <div class=\"mb-1\" x-show=\"calculationBreakdown().usesUtilization\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">\u00f7 utilization</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().afterUtilization)}/hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\" x-text=\"`spread across ${calculationBreakdown().utilization}% billable time`\"></div>\\n\n                    </div>\\n\n                    <div class=\"mb-1 d-flex justify-content-between gap-2\" x-show.important=\"calculationBreakdown().overhead > 0\">\\n\n                        <span class=\"text-secondary\">+ overhead</span>\\n\n                        <span class=\"fw-medium\" x-text=\"money(calculationBreakdown().overhead)\"></span>\\n\n                    </div>\\n\n                    <div class=\"d-flex justify-content-between gap-2 border-top pt-1\">\\n\n                        <span class=\"fw-medium\">Estimated labor cost / billed hr</span>\\n\n                        <span class=\"fw-bold\" x-text=\"`${money(calculationBreakdown().total)}/hr`\"></span>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n        </div>\\n\n    </div>\\n\n\\n\n            <div class=\"card-footer\">\\n\n            <div class=\"d-flex flex-wrap align-items-center justify-content-end gap-3\">\\n\n                <span x-show=\"applied\" x-cloak class=\"small text-success fw-medium\" role=\"status\">Applied to estimated labor cost.</span>\\n\n                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    @click.prevent=\"applyLoadedCost()\"\\n\n                    :disabled=\"! canApply()\"\\n\n                >\\n\n                    Use estimated labor cost\\n\n                </button>\\n\n            </div>\\n\n            <div class=\"small text-secondary mt-2\">Or just <strong>Save changes</strong> - if the calculator has a rate, ARK applies the estimated labor cost automatically.</div>\\n\n        </div>\\n\n    </div>\\n\n            </div>\\n\n            <div class=\"col-12 col-md-6\" x-show=\"roles.includes('technician')\" x-cloak>\\n\n                <label for=\"staff-workday-hours\" class=\"form-label\">Workday hours</label>\\n\n                <input id=\"staff-workday-hours\" name=\"workday_hours\" type=\"number\" min=\"1\" max=\"24\" step=\"0.25\" value=\"\" class=\"form-control\" placeholder=\"8\">\\n\n                <div class=\"form-hint\">Defaults to 8 hours for efficiency math when left blank.</div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">Invite member</button>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n\\n\n<div class=\"card-body\" data-settings-staff-list>\\n\n    <div class=\"d-flex align-items-center justify-content-between gap-2 mb-2\">\\n\n        <h3 class=\"mb-0\">Team</h3>\\n\n        <span class=\"badge bg-secondary-lt\">1 members</span>\\n\n    </div>\\n\n\\n\n    <div class=\"row g-2 px-3 mb-1 d-none d-md-flex subheader\" aria-hidden=\"true\">\\n\n        <div class=\"col-md-5\">Member</div>\\n\n        <div class=\"col-md-3\">Roles</div>\\n\n        <div class=\"col-md-2\">Status</div>\\n\n        <div class=\"col-md-2 text-end\">Actions</div>\\n\n    </div>\\n\n\\n\n    <div class=\"list-group\">\\n\n                    \\n\n            <div\\n\n                x-data=\"{ editing: false, roles: JSON.parse('[\\u0022admin\\u0022]') }\"\\n\n                class=\"list-group-item\"\\n\n                data-staff-member=\"1\"\\n\n                            >\\n\n                <div x-show=\"! editing\" class=\"row g-2 align-items-center\">\\n\n                    <div class=\"col-12 col-md-5\">\\n\n                        <div class=\"fw-medium\">Earline O&#039;Conner</div>\\n\n                        <div class=\"small text-secondary text-break\">moses88@example.org</div>\\n\n                                                                                                                                                    <a\\n\n                                href=\"http://localhost/app/owner/staff/1/coaching\"\\n\n                                class=\"small\"\\n\n                            >Coaching history</a>\\n\n                                            </div>\\n\n\\n\n                    <div class=\"col-6 col-md-3\">\\n\n                        <div class=\"d-flex flex-wrap gap-1\">\\n\n                                                                                                                                <span class=\"badge bg-secondary-lt\">Admin</span>\\n\n                                                                                    </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"col-6 col-md-2\">\\n\n                                                    <span class=\"badge bg-green-lt\" data-staff-status=\"active\">Active</span>\\n\n                                            </div>\\n\n\\n\n                    <div class=\"col-12 col-md-2\">\\n\n                        <div class=\"btn-list justify-content-md-end\">\\n\n                            <button type=\"button\" class=\"btn btn-sm\" @click=\"editing = true\">Edit</button>\\n\n                                                                                                                                            </div>\\n\n                    </div>\\n\n                </div>\\n\n\\n\n                <form\\n\n                    x-show=\"editing\"\\n\n                    x-cloak\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/settings/staff/1\"\\n\n                    data-staff-member-form\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                    <input type=\"hidden\" name=\"_member\" value=\"1\">\\n\n\\n\n                    <div class=\"row g-3\">\\n\n                        <div class=\"col-12 col-md-6\">\\n\n                            <label for=\"staff-name-1\" class=\"form-label required\">Name</label>\\n\n                            <input id=\"staff-name-1\" name=\"name\" value=\"Earline O&#039;Conner\" required class=\"form-control\">\\n\n                        </div>\\n\n                        <fieldset class=\"col-12 col-md-6\">\\n\n                            <legend class=\"form-label\">Roles</legend>\\n\n                                                        <div class=\"d-flex flex-wrap gap-3\">\\n\n                                                                    <label class=\"form-check mb-0\">\\n\n                                        <input\\n\n                                            type=\"checkbox\"\\n\n                                            name=\"roles[]\"\\n\n                                            value=\"admin\"\\n\n                                            x-model=\"roles\"\\n\n                                                                                        class=\"form-check-input\"\\n\n                                        >\\n\n                                        <span class=\"form-check-label\">Admin</span>\\n\n                                    </label>\\n\n                                                                    <label class=\"form-check mb-0\">\\n\n                                        <input\\n\n                                            type=\"checkbox\"\\n\n                                            name=\"roles[]\"\\n\n                                            value=\"advisor\"\\n\n                                            x-model=\"roles\"\\n\n                                                                                        class=\"form-check-input\"\\n\n                                        >\\n\n                                        <span class=\"form-check-label\">Advisor</span>\\n\n                                    </label>\\n\n                                                                    <label class=\"form-check mb-0\">\\n\n                                        <input\\n\n                                            type=\"checkbox\"\\n\n                                            name=\"roles[]\"\\n\n                                            value=\"technician\"\\n\n                                            x-model=\"roles\"\\n\n                                                                                        class=\"form-check-input\"\\n\n                                        >\\n\n                                        <span class=\"form-check-label\">Technician</span>\\n\n                                    </label>\\n\n                                                            </div>\\n\n                                                    </fieldset>\\n\n                        <div class=\"col-12 col-md-6\">\\n\n                            <label for=\"staff-email-1\" class=\"form-label required\">Email</label>\\n\n                            <input id=\"staff-email-1\" name=\"email\" type=\"email\" value=\"moses88@example.org\" required class=\"form-control\">\\n\n                        </div>\\n\n                        <div class=\"col-12 col-md-6\">\\n\n                            <label for=\"staff-phone-1\" class=\"form-label\">Cell phone</label>\\n\n                            <input id=\"staff-phone-1\" name=\"phone\" type=\"text\" value=\"\" class=\"form-control\" autocomplete=\"tel\" placeholder=\"(719) 555-0100\">\\n\n                        </div>\\n\n                        <div class=\"col-12 col-md-6\">\\n\n                            <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                                <label for=\"staff-operator-pin-1\" class=\"form-label mb-0\">Workstation PIN</label>\\n\n                                <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Workstation PIN help for Earline O&amp;#039;Conner\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Used to unlock shared workstations - not the ARK login password.\"\\n\n>?</span>\\n\n                            </div>\\n\n                            <input\\n\n                                id=\"staff-operator-pin-1\"\\n\n                                name=\"operator_pin\"\\n\n                                type=\"password\"\\n\n                                inputmode=\"numeric\"\\n\n                                pattern=\"\\d{4}\"\\n\n                                maxlength=\"4\"\\n\n                                class=\"form-control\"\\n\n                                placeholder=\"4 digits\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"col-12\" x-show=\"roles.includes('technician')\" x-cloak>\\n\n                            <label for=\"staff-labor-cost-1\" class=\"form-label\">Estimated labor cost / hr</label>\\n\n                            <input\\n\n                                id=\"staff-labor-cost-1\"\\n\n                                name=\"labor_cost\"\\n\n                                type=\"number\"\\n\n                                min=\"0\"\\n\n                                step=\"0.01\"\\n\n                                value=\"\"\\n\n                                class=\"form-control\"\\n\n                                style=\"max-width: 12rem\"\\n\n                                placeholder=\"35.00\"\\n\n                            >\\n\n                            <div class=\"form-hint\">Margin cost per billed hour - not a paycheck. Set shop overhead first under Settings \u2192 Shop Overhead.</div>\\n\n                            <div\\n\n    x-data=\"loadedLaborCostCalculator({\\n\n        targetInputId: 'staff-labor-cost-1',\\n\n        shopOverheadPerHour: null,\\n\n        laborPayBasis: 'hourly',\\n\n        flagRate: '',\\n\n        floorRate: '',\\n\n        floorSuggestion: 15.16,\\n\n        floorSuggestionLabel: '2026 Colorado statewide minimum wage suggestion',\\n\n        burdenPercent: 28,\\n\n        billableUtilization: 85,\\n\n    })\"\\n\n    class=\"card card-sm mt-3\"\\n\n    data-loaded-labor-calculator\\n\n>\\n\n    <div class=\"card-body\">\\n\n        <div class=\"d-flex flex-wrap align-items-start justify-content-between gap-3\">\\n\n            <div style=\"max-width: 36rem\">\\n\n                <div class=\"subheader\">Estimated labor cost</div>\\n\n                <p class=\"small text-secondary mb-0\">\\n\n                    Margin planning only - not a paycheck.\\n\n                    Output is cost per <strong>billed</strong> hour for labor GP and efficiency.\\n\n                    <span x-show=\"isHourlyPay()\">Hourly: spread clock wage across billable utilization, then add shop overhead.</span>\\n\n                    <span x-show=\"isFlagPay()\" x-cloak>Flag: take the higher of flag rate and floor \u00f7 utilization, then burden and overhead.</span>\\n\n                </p>\\n\n            </div>\\n\n            <div class=\"text-end\">\\n\n                <div class=\"subheader\">Est. cost / billed hr</div>\\n\n                <div class=\"h2 mb-0 font-monospace\" x-text=\"formattedResult()\" data-loaded-labor-result></div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"row g-3 mt-1\">\\n\n            <fieldset class=\"col-12\">\\n\n                <legend class=\"form-label mb-1\">Pay type</legend>\\n\n                <div class=\"small text-secondary mb-2\">How this technician is paid. Estimated labor cost is for margin - not payroll settlement.</div>\\n\n                \\n\n                <input type=\"hidden\" name=\"labor_pay_basis\" :value=\"payBasis\">\\n\n                <div>\\n\n                                            <label class=\"form-check form-check-inline\">\\n\n                            <input\\n\n                                type=\"radio\"\\n\n                                value=\"hourly\"\\n\n                                x-model=\"payBasis\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Hourly (clock)</span>\\n\n                        </label>\\n\n                                            <label class=\"form-check form-check-inline\">\\n\n                            <input\\n\n                                type=\"radio\"\\n\n                                value=\"flag\"\\n\n                                x-model=\"payBasis\"\\n\n                                class=\"form-check-input\"\\n\n                            >\\n\n                            <span class=\"form-check-label\">Flag / book time</span>\\n\n                        </label>\\n\n                                    </div>\\n\n            </fieldset>\\n\n\\n\n            <template x-if=\"isFlagPay()\">\\n\n                <div class=\"col-12\">\\n\n                    <div class=\"row g-3\">\\n\n                        <div class=\"col-12 col-sm-6\">\\n\n                            <label for=\"loaded-labor-staff-labor-cost-1-flag-rate\" class=\"form-label\">Flag rate</label>\\n\n                            <input id=\"loaded-labor-staff-labor-cost-1-flag-rate\" name=\"flag_rate\" x-model=\"flagRate\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"30.00\" class=\"form-control\">\\n\n                            <div class=\"form-hint\">What the technician earns for completed flagged production.</div>\\n\n                        </div>\\n\n                        <div class=\"col-12 col-sm-6\">\\n\n                            <label for=\"loaded-labor-staff-labor-cost-1-floor-rate\" class=\"form-label\">Hourly floor</label>\\n\n                            <input id=\"loaded-labor-staff-labor-cost-1-floor-rate\" name=\"floor_rate\" x-model=\"floorRate\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"15.16\" class=\"form-control\">\\n\n                            <div class=\"form-hint\">The hourly amount the technician is guaranteed for time worked when flag pay does not cover it.</div>\\n\n                        </div>\\n\n                        <div x-show=\"floorNeedsReview()\" x-cloak class=\"col-12\">\\n\n                            <div class=\"alert alert-warning small mb-0\" role=\"status\">\\n\n                                <div class=\"fw-bold\">Hourly floor may need review</div>\\n\n                                <div class=\"font-monospace\">\\n\n                                    Stored: $<span x-text=\"Number(floorRate).toFixed(2)\"></span>\\n\n                                    \u00b7 Current shop suggestion: $<span x-text=\"Number(floorSuggestion).toFixed(2)\"></span>\\n\n                                </div>\\n\n                                <div x-text=\"floorSuggestionLabel\"></div>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n\\n\n            <div class=\"col-12 col-sm-6\" x-show=\"isHourlyPay()\">\\n\n                <label for=\"loaded-labor-staff-labor-cost-1-base-wage\" class=\"form-label\" x-text=\"basePayLabel()\"></label>\\n\n                <input id=\"loaded-labor-staff-labor-cost-1-base-wage\" x-model=\"baseWage\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"30.00\" class=\"form-control\">\\n\n                <div class=\"form-hint\" x-text=\"basePayHint()\"></div>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                    <label for=\"loaded-labor-staff-labor-cost-1-burden\" class=\"form-label mb-0\">Burden %</label>\\n\n                    <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Burden help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Employer cost on top of wage: payroll tax, benefits, workers comp, retirement match. Most shops land around 25\u201335%; default is 28%.\"\\n\n>?</span>\\n\n                </div>\\n\n                <input id=\"loaded-labor-staff-labor-cost-1-burden\" x-model=\"burdenPercent\" type=\"number\" min=\"0\" step=\"0.1\" class=\"form-control\">\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                    <label for=\"loaded-labor-staff-labor-cost-1-overhead\" class=\"form-label mb-0\">Overhead / billed hr</label>\\n\n                    <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Overhead per billed hour help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Shop cost per billed hour from Settings \u2192 Shop Overhead. Prefills automatically when set.\"\\n\n>?</span>\\n\n                </div>\\n\n                <input id=\"loaded-labor-staff-labor-cost-1-overhead\" x-model=\"overheadPerHour\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"5.00\" class=\"form-control\">\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\" x-show=\"isHourlyPay() || isFlagPay()\">\\n\n                <label for=\"loaded-labor-staff-labor-cost-1-utilization\" class=\"form-label\">Billable utilization %</label>\\n\n                <input id=\"loaded-labor-staff-labor-cost-1-utilization\" x-model=\"billableUtilization\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" class=\"form-control\">\\n\n                <div class=\"form-hint\">\\n\n                    <span x-show=\"isHourlyPay()\">How much paid clock time becomes billable hours. Non-billable time includes cleanup, comebacks, training, and shop tasks. 85% on an 8.0-hr day \u2248 6.8 billable hrs.</span>\\n\n                    <span x-show=\"isFlagPay()\" x-cloak>Assumed flagged/billed hours \u00f7 compensable hours. Used only to estimate what the hourly floor costs per produced hour - not a pay rate.</span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"calculationBreakdown()\" x-cloak class=\"border-top pt-3 mt-3 small\" data-loaded-labor-breakdown>\\n\n            <div class=\"subheader mb-2\">How this adds up</div>\\n\n            <template x-if=\"calculationBreakdown()\">\\n\n                <div class=\"font-monospace\">\\n\n                    <div class=\"mb-1\" x-show=\"calculationBreakdown().showsFloorEquivalent\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">Floor-equivalent production cost</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().floorEquivalent)}/billed hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\" x-text=\"`floor \u00f7 ${calculationBreakdown().utilization}% utilization - planning only`\"></div>\\n\n                    </div>\\n\n                    <div class=\"mb-1\" x-show=\"isFlagPay()\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">Effective wage cost</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().effectiveWage)}/billed hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\">max(flag rate, floor-equivalent) - not a stored pay rate</div>\\n\n                    </div>\\n\n                    <div class=\"mb-1\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">After burden</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().payrollLoaded)}/hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\">effective \u00d7 (1 + burden)</div>\\n\n                    </div>\\n\n                    <div class=\"mb-1\" x-show=\"calculationBreakdown().usesUtilization\">\\n\n                        <div class=\"d-flex justify-content-between gap-2\">\\n\n                            <span class=\"text-secondary\">\u00f7 utilization</span>\\n\n                            <span class=\"fw-medium\" x-text=\"`${money(calculationBreakdown().afterUtilization)}/hr`\"></span>\\n\n                        </div>\\n\n                        <div class=\"text-secondary\" x-text=\"`spread across ${calculationBreakdown().utilization}% billable time`\"></div>\\n\n                    </div>\\n\n                    <div class=\"mb-1 d-flex justify-content-between gap-2\" x-show.important=\"calculationBreakdown().overhead > 0\">\\n\n                        <span class=\"text-secondary\">+ overhead</span>\\n\n                        <span class=\"fw-medium\" x-text=\"money(calculationBreakdown().overhead)\"></span>\\n\n                    </div>\\n\n                    <div class=\"d-flex justify-content-between gap-2 border-top pt-1\">\\n\n                        <span class=\"fw-medium\">Estimated labor cost / billed hr</span>\\n\n                        <span class=\"fw-bold\" x-text=\"`${money(calculationBreakdown().total)}/hr`\"></span>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n        </div>\\n\n    </div>\\n\n\\n\n            <div class=\"card-footer\">\\n\n            <div class=\"d-flex flex-wrap align-items-center justify-content-end gap-3\">\\n\n                <span x-show=\"applied\" x-cloak class=\"small text-success fw-medium\" role=\"status\">Applied to estimated labor cost.</span>\\n\n                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    @click.prevent=\"applyLoadedCost()\"\\n\n                    :disabled=\"! canApply()\"\\n\n                >\\n\n                    Use estimated labor cost\\n\n                </button>\\n\n            </div>\\n\n            <div class=\"small text-secondary mt-2\">Or just <strong>Save changes</strong> - if the calculator has a rate, ARK applies the estimated labor cost automatically.</div>\\n\n        </div>\\n\n    </div>\\n\n                        </div>\\n\n                        <div class=\"col-12 col-md-6\" x-show=\"roles.includes('technician')\" x-cloak>\\n\n                            <label for=\"staff-workday-hours-1\" class=\"form-label\">Workday hours</label>\\n\n                            <input\\n\n                                id=\"staff-workday-hours-1\"\\n\n                                name=\"workday_hours\"\\n\n                                type=\"number\"\\n\n                                min=\"1\"\\n\n                                max=\"24\"\\n\n                                step=\"0.25\"\\n\n                                value=\"\"\\n\n                                class=\"form-control\"\\n\n                                placeholder=\"8\"\\n\n                            >\\n\n                        </div>\\n\n                                                    <div class=\"col-12 col-md-6\">\\n\n                                <label for=\"staff-password-1\" class=\"form-label\">New password</label>\\n\n                                <input id=\"staff-password-1\" name=\"password\" type=\"password\" placeholder=\"Leave blank to keep\" class=\"form-control\">\\n\n                            </div>\\n\n                                            </div>\\n\n\\n\n                    <div class=\"btn-list justify-content-end border-top pt-3 mt-3\">\\n\n                        <button type=\"button\" class=\"btn btn-ghost-secondary\" @click=\"editing = false\">Cancel</button>\\n\n                        <button type=\"submit\" class=\"btn btn-primary\">Save changes</button>\\n\n                    </div>\\n\n                </form>\\n\n            </div>\\n\n            </div>\\n\n</div>\\n\n\\n\n<div class=\"card-footer small\" data-settings-staff-legend>\\n\n    <p class=\"mb-1\"><span class=\"badge bg-secondary-lt\">Admin</span> settings, staff, and full shop control.</p>\\n\n    <p class=\"mb-1\"><span class=\"badge bg-orange-lt\">Advisor</span> customers, estimates, approvals, and closeout.</p>\\n\n    <p class=\"mb-1\"><span class=\"badge bg-blue-lt\">Technician</span> assignable on ROs and estimated labor cost for report GP.</p>\\n\n    <p class=\"text-secondary mb-0\">The <strong>master admin</strong> account keeps admin permanently. Shop owners can also check <strong>Advisor</strong> + <strong>Technician</strong> to show up in technician assignment and labor reporting.</p>\\n\n</div>\\n\n                    </section>\\n\n                \\n\n                <section class=\"card\" x-show=\"active === 'excellence'\" x-cloak data-settings-section=\"excellence\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Owner Targets &amp; Reporting</div>\\n\n                            <h2 class=\"card-title\">Shop performance targets</h2>\\n\n                            <div class=\"card-subtitle\">Targets for posted sales, margins, and the owner digest. They set the green and amber hints on the Operational Report and Margin Health.</div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"card-body\">\\n\n    <div class=\"border rounded px-3 py-2 small\" style=\"max-width: 48rem\" data-excellence-posted-sales>\\n\n        <div class=\"subheader mb-1\">Posted sales</div>\\n\n        <p class=\"text-secondary mb-0\">\\n\n            <strong class=\"text-body\">Posted invoice sales</strong> uses the frozen invoice on repair orders posted in the range, before tax.\\n\n            <strong class=\"text-body\">Cash Collected</strong> uses ledger payment/deposit dates (Payment Details / Total Cashiered).\\n\n            Deposits and partial payments never inflate posted sales until the RO is posted.\\n\n            Close - Paid posts automatically; paid ROs can also be posted from the repair order when ready.\\n\n        </p>\\n\n    </div>\\n\n</div>\\n\n\\n\n<form method=\"POST\" action=\"http://localhost/app/settings/shop/excellence\" data-settings-excellence>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n    <div class=\"card-body\">\\n\n        <div style=\"max-width: 48rem\">\\n\n            <h3 class=\"mb-1\">Margin targets</h3>\\n\n            <p class=\"text-secondary small mb-1\">ELR floor, ARO, parts margin, sales mix, and net profit targets.</p>\\n\n            <p class=\"text-secondary small\">Posted labor rate comes from <a href=\"http://localhost/app/settings/shop?section=financial&amp;financial-tab=labor\" @click.prevent=\"setActive('financial'); setFinancialTab('labor')\">Financial Rules \u2192 Labor</a>.</p>\\n\n\\n\n            <div class=\"row g-3\">\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                        <label for=\"excellence-elr-floor\" class=\"form-label mb-0\">ELR floor</label>\\n\n                        <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"ELR floor help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"Minimum acceptable effective labor rate on posted work.\"\\n\n>?</span>\\n\n                    </div>\\n\n                    <div class=\"input-group\">\\n\n                        <span class=\"input-group-text\">$</span>\\n\n                        <input\\n\n                            id=\"excellence-elr-floor\"\\n\n                            type=\"number\"\\n\n                            name=\"effective_labor_rate_floor\"\\n\n                            min=\"0\"\\n\n                            step=\"0.01\"\\n\n                            value=\"\"\\n\n                            placeholder=\"165.00\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">/hr</span>\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-aro-target\" class=\"form-label required\">ARO target</label>\\n\n                    <div class=\"input-group\">\\n\n                        <span class=\"input-group-text\">$</span>\\n\n                        <input\\n\n                            id=\"excellence-aro-target\"\\n\n                            type=\"number\"\\n\n                            name=\"aro_target\"\\n\n                            min=\"0\"\\n\n                            step=\"0.01\"\\n\n                            required\\n\n                            value=\"750.00\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-parts-margin\" class=\"form-label required\">Parts margin target</label>\\n\n                    <div class=\"input-group\">\\n\n                        <input\\n\n                            id=\"excellence-parts-margin\"\\n\n                            type=\"number\"\\n\n                            name=\"parts_margin_target_percent\"\\n\n                            min=\"1\"\\n\n                            max=\"99\"\\n\n                            required\\n\n                            value=\"55\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">%</span>\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                                    <div class=\"col-12 col-sm-6\">\\n\n                        <label for=\"excellence-monthly-fixed-costs\" class=\"form-label\">Monthly fixed costs ($)</label>\\n\n                        <div class=\"input-group\">\\n\n                            <span class=\"input-group-text\">$</span>\\n\n                            <input\\n\n                                id=\"excellence-monthly-fixed-costs\"\\n\n                                type=\"number\"\\n\n                                name=\"monthly_fixed_costs\"\\n\n                                min=\"0\"\\n\n                                step=\"0.01\"\\n\n                                value=\"\"\\n\n                                placeholder=\"25000.00\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                                                    </div>\\n\n                        <div class=\"form-hint\">Break-even on Margin Health. Once you save fixed costs in the <a href=\"http://localhost/app/settings/shop?section=overhead\" @click.prevent=\"setActive('overhead')\">Shop Overhead worksheet</a>, its monthly total is used here instead.</div>\\n\n                    </div>\\n\n                \\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-labor-sales-mix\" class=\"form-label required\">Labor sales mix target</label>\\n\n                    <div class=\"input-group\">\\n\n                        <input\\n\n                            id=\"excellence-labor-sales-mix\"\\n\n                            type=\"number\"\\n\n                            name=\"labor_sales_target_percent\"\\n\n                            min=\"1\"\\n\n                            max=\"99\"\\n\n                            required\\n\n                            value=\"55\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">%</span>\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-parts-sales-mix\" class=\"form-label required\">Parts sales mix target</label>\\n\n                    <div class=\"input-group\">\\n\n                        <input\\n\n                            id=\"excellence-parts-sales-mix\"\\n\n                            type=\"number\"\\n\n                            name=\"parts_sales_target_percent\"\\n\n                            min=\"1\"\\n\n                            max=\"99\"\\n\n                            required\\n\n                            value=\"45\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">%</span>\\n\n                                            </div>\\n\n                </div>\\n\n            </div>\\n\n\\n\n            <h4 class=\"mt-4 mb-2\">P&amp;L &amp; tax estimates</h4>\\n\n            <div class=\"row g-3\">\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <div class=\"d-flex align-items-center gap-1 mb-2\">\\n\n                        <label for=\"excellence-net-profit\" class=\"form-label required mb-0\">Net profit target</label>\\n\n                        <span\\n\n    class=\"form-help\"\\n\n    tabindex=\"0\"\\n\n    role=\"button\"\\n\n    aria-label=\"Net profit target help\"\\n\n    data-bs-toggle=\"popover\"\\n\n    data-bs-trigger=\"hover focus\"\\n\n    data-bs-placement=\"top\"\\n\n    data-bs-content=\"~20% net on service revenue benchmark.\"\\n\n>?</span>\\n\n                    </div>\\n\n                    <div class=\"input-group\">\\n\n                        <input\\n\n                            id=\"excellence-net-profit\"\\n\n                            type=\"number\"\\n\n                            name=\"net_profit_target_percent\"\\n\n                            min=\"1\"\\n\n                            max=\"99\"\\n\n                            required\\n\n                            value=\"20\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">%</span>\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-income-tax-reserve\" class=\"form-label required\">Income tax reserve</label>\\n\n                    <div class=\"input-group\">\\n\n                        <input\\n\n                            id=\"excellence-income-tax-reserve\"\\n\n                            type=\"number\"\\n\n                            name=\"income_tax_reserve_percent\"\\n\n                            min=\"0\"\\n\n                            max=\"99\"\\n\n                            required\\n\n                            value=\"25\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">%</span>\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-payroll-tax-reserve\" class=\"form-label required\">Payroll tax reserve</label>\\n\n                    <div class=\"input-group\">\\n\n                        <input\\n\n                            id=\"excellence-payroll-tax-reserve\"\\n\n                            type=\"number\"\\n\n                            name=\"payroll_tax_reserve_percent\"\\n\n                            min=\"0\"\\n\n                            max=\"99\"\\n\n                            required\\n\n                            value=\"10\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                        <span class=\"input-group-text\">%</span>\\n\n                                            </div>\\n\n                    <div class=\"form-hint\">Percent of technician labor cost. Not used when Monthly payroll tax is above $0.</div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-monthly-payroll-tax\" class=\"form-label\">Monthly payroll tax</label>\\n\n                    <div class=\"input-group\">\\n\n                        <span class=\"input-group-text\">$</span>\\n\n                        <input\\n\n                            id=\"excellence-monthly-payroll-tax\"\\n\n                            type=\"number\"\\n\n                            name=\"monthly_payroll_tax\"\\n\n                            min=\"0\"\\n\n                            step=\"0.01\"\\n\n                            value=\"\"\\n\n                            placeholder=\"Optional\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                                            </div>\\n\n                    <div class=\"form-hint\">When above $0, used instead of the payroll tax reserve %.</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body\">\\n\n        <div style=\"max-width: 48rem\">\\n\n            <h3 class=\"mb-1\">Operating scoreboard</h3>\\n\n            <p class=\"text-secondary small\">Blank means this shop has not set a target. The scoreboard shows the actual number and does not mark it good or behind. A blank stall age uses the median cycle target. If that is also blank, the stalled queue stays off.</p>\\n\n            <div class=\"row g-3\">\\n\n                                    <div class=\"col-12 col-sm-6\">\\n\n                        <label for=\"excellence-opportunity_ros_per_open_day\" class=\"form-label\">ROs / open day</label>\\n\n                        <div class=\"\">\\n\n                            <input id=\"excellence-opportunity_ros_per_open_day\" type=\"number\" name=\"opportunity_ros_per_open_day\" min=\"0\" max=\"999\" step=\"0.1\" value=\"\" class=\"form-control\">\\n\n                                                                                </div>\\n\n                    </div>\\n\n                                    <div class=\"col-12 col-sm-6\">\\n\n                        <label for=\"excellence-dollar_close_target_percent\" class=\"form-label\">Dollar close</label>\\n\n                        <div class=\"input-group\">\\n\n                            <input id=\"excellence-dollar_close_target_percent\" type=\"number\" name=\"dollar_close_target_percent\" min=\"0\" max=\"100\" step=\"0.1\" value=\"\" class=\"form-control\">\\n\n                                                            <span class=\"input-group-text\">%</span>\\n\n                                                                                </div>\\n\n                    </div>\\n\n                                    <div class=\"col-12 col-sm-6\">\\n\n                        <label for=\"excellence-sold_labor_hours_per_open_day\" class=\"form-label\">Sold hours / open day</label>\\n\n                        <div class=\"\">\\n\n                            <input id=\"excellence-sold_labor_hours_per_open_day\" type=\"number\" name=\"sold_labor_hours_per_open_day\" min=\"0\" max=\"999\" step=\"0.1\" value=\"\" class=\"form-control\">\\n\n                                                                                </div>\\n\n                    </div>\\n\n                                    <div class=\"col-12 col-sm-6\">\\n\n                        <label for=\"excellence-median_cycle_target_days\" class=\"form-label\">Median cycle</label>\\n\n                        <div class=\"input-group\">\\n\n                            <input id=\"excellence-median_cycle_target_days\" type=\"number\" name=\"median_cycle_target_days\" min=\"0\" max=\"365\" step=\"0.1\" value=\"\" class=\"form-control\">\\n\n                                                            <span class=\"input-group-text\">days</span>\\n\n                                                                                </div>\\n\n                    </div>\\n\n                                    <div class=\"col-12 col-sm-6\">\\n\n                        <label for=\"excellence-stalled_ro_age_days\" class=\"form-label\">Stall age</label>\\n\n                        <div class=\"input-group\">\\n\n                            <input id=\"excellence-stalled_ro_age_days\" type=\"number\" name=\"stalled_ro_age_days\" min=\"0.1\" max=\"365\" step=\"0.1\" value=\"\" class=\"form-control\">\\n\n                                                            <span class=\"input-group-text\">days</span>\\n\n                                                                                </div>\\n\n                    </div>\\n\n                            </div>\\n\n            <label class=\"form-check mt-3 mb-0\">\\n\n                <input type=\"checkbox\" name=\"parts_margin_target_active\" value=\"1\"  class=\"form-check-input\">\\n\n                <span class=\"form-check-label\">Judge parts margin on the scoreboard against the parts margin target above</span>\\n\n            </label>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body\">\\n\n        <div style=\"max-width: 48rem\">\\n\n            <h3 class=\"mb-1\">Owner digest and review</h3>\\n\n            <p class=\"text-secondary small\">Daily digest timing and quarterly target review.</p>\\n\n\\n\n            <div class=\"row g-3 align-items-end\">\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label class=\"form-check form-switch mb-0\">\\n\n                        <input\\n\n                            type=\"checkbox\"\\n\n                            name=\"owner_digest_enabled\"\\n\n                            value=\"1\"\\n\n                            checked                            class=\"form-check-input\"\\n\n                        >\\n\n                        <span class=\"form-check-label\">Email daily owner digest</span>\\n\n                    </label>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-sm-6\">\\n\n                    <label for=\"excellence-owner-digest-time\" class=\"form-label required\">Digest send time (shop time)</label>\\n\n                    <input\\n\n                        id=\"excellence-owner-digest-time\"\\n\n                        type=\"time\"\\n\n                        name=\"owner_digest_time\"\\n\n                        required\\n\n                        value=\"18:00\"\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                                    </div>\\n\n            </div>\\n\n\\n\n            <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-3 border-top pt-3 mt-3\">\\n\n                <label class=\"form-check mb-0\">\\n\n                    <input\\n\n                        type=\"checkbox\"\\n\n                        name=\"mark_target_reviewed\"\\n\n                        value=\"1\"\\n\n                        class=\"form-check-input\"\\n\n                    >\\n\n                    <span class=\"form-check-label\">Mark quarterly target review complete today</span>\\n\n                </label>\\n\n                            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-footer\">\\n\n        <div class=\"btn-list justify-content-end\">\\n\n            <a href=\"http://localhost/app/reports/operations?tab=margin-health\" class=\"btn\">Open Margin Health</a>\\n\n            <a href=\"http://localhost/app/owner/day-review\" class=\"btn\">Day Review</a>\\n\n            <button type=\"submit\" class=\"btn btn-primary\">Save owner targets</button>\\n\n        </div>\\n\n    </div>\\n\n</form>\\n\n                </section>\\n\n\\n\n                <section class=\"card\" x-show=\"active === 'payments'\" x-cloak data-settings-section=\"payments\">\\n\n                    <div class=\"card-header\">\\n\n    <div>\\n\n        <div class=\"subheader\">Payment methods</div>\\n\n        <h2 class=\"card-title\">How this shop records payments</h2>\\n\n                    <div class=\"card-subtitle\">\\n\n                Record cash, check, or a card taken on a standalone terminal. Integrated card capture belongs to ARK Shop.\\n\n            </div>\\n\n            </div>\\n\n</div>\\n\n\\n\n<div class=\"card-body\">\\n\n            <div class=\"alert alert-secondary\" role=\"status\" data-card-capture-status=\"not-connected\">\\n\n            Integrated card capture is not available on standalone Core. Record Payment still works on the repair order.\\n\n        </div>\\n\n    \\n\n    </div>\\n\n\\n\n\\n\n<div class=\"card-body\">\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/settings/shop/manual-payment-methods\"\\n\n        x-data=\"{ methods: JSON.parse('[{\\u0022key\\u0022:\\u0022check\\u0022,\\u0022label\\u0022:\\u0022Check\\u0022},{\\u0022key\\u0022:\\u0022card\\u0022,\\u0022label\\u0022:\\u0022External Card\\u0022},{\\u0022key\\u0022:\\u0022eft\\u0022,\\u0022label\\u0022:\\u0022EFT\\u0022}]') }\"\\n\n        style=\"max-width: 48rem\"\\n\n        data-settings-manual-payment-methods\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <div class=\"subheader\">Take payment</div>\\n\n        <h3 class=\"mb-1\">Other ways to pay</h3>\\n\n        <p class=\"text-secondary small\">These buttons sit under Cash. Check, External Card, and EFT start on every shop. Rename one, add one, or remove one.</p>\\n\n\\n\n        \\n\n        <div class=\"list-group\">\\n\n            <template x-for=\"(method, index) in methods\" :key=\"index\">\\n\n                <div class=\"list-group-item\">\\n\n                    <div class=\"d-flex align-items-center gap-2\">\\n\n                        <input type=\"hidden\" :name=\"'methods[' + index + '][key]'\" x-model=\"method.key\">\\n\n                        <label class=\"visually-hidden\" :for=\"'manual-payment-method-' + index\">Name</label>\\n\n                        <input :id=\"'manual-payment-method-' + index\" class=\"form-control fw-medium\" :name=\"'methods[' + index + '][label]'\" x-model=\"method.label\" maxlength=\"24\" required>\\n\n                        <button type=\"button\" class=\"btn btn-ghost-danger\" @click=\"methods.splice(index, 1)\">Delete</button>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n        </div>\\n\n\\n\n        <div class=\"btn-list justify-content-end border-top pt-3 mt-3\">\\n\n            <button type=\"button\" class=\"btn\" :disabled=\"methods.length >= 8\" @click=\"methods.push({ key: '', label: '' })\">Add</button>\\n\n            <button type=\"submit\" class=\"btn btn-primary\">Save</button>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n                </section>\\n\n\\n\n                <section class=\"card\" x-show=\"active === 'partstech'\" x-cloak data-settings-section=\"partstech\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Parts catalogs</div>\\n\n                            <h2 class=\"card-title\">Catalog buttons on the estimate</h2>\\n\n                            <div class=\"card-subtitle\">PartsTech, RepairLink, Nexpart, and any other catalog the estimate toolbar opens.</div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"card-body\" data-settings-partstech>\\n\n    <div style=\"max-width: 48rem\">\\n\n        <div class=\"subheader\">PartsTech</div>\\n\n        <h3 class=\"mb-1\">Parts catalog</h3>\\n\n                    <p class=\"text-secondary small\">\\n\n                This shop does not store a shop-wide PartsTech password. Shop catalog access belongs to ARK Shop.\\n\n                Optional personal seats stay on each person\u2019s profile (avatar menu \u2192 Profile).\\n\n            </p>\\n\n                <form method=\"POST\" action=\"http://localhost/app/settings/shop/partstech\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <div style=\"max-width: 20rem\">\\n\n                <label for=\"settings-catalog-partstech-color\" class=\"form-label\">Button color</label>\\n\n<select id=\"settings-catalog-partstech-color\" name=\"partstech_color\" class=\"form-select\">\\n\n                <option value=\"yellow\" selected>Yellow</option>\\n\n            <option value=\"green\" >Green</option>\\n\n            <option value=\"orange\" >Orange</option>\\n\n            <option value=\"red\" >Red</option>\\n\n            <option value=\"blue\" >Blue</option>\\n\n            <option value=\"navy\" >Navy</option>\\n\n            <option value=\"slate\" >Slate</option>\\n\n    </select>\\n\n            </div>\\n\n            <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n                <button type=\"submit\" class=\"btn btn-primary\">\\n\n                    Save button color\\n\n                </button>\\n\n            </div>\\n\n        </form>\\n\n    </div>\\n\n</div>\\n\n\\n\n<div class=\"card-body\" data-settings-repairlink>\\n\n    <form method=\"POST\" action=\"http://localhost/app/settings/shop/repairlink\" style=\"max-width: 48rem\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n        <div class=\"subheader\">RepairLink</div>\\n\n        <h3 class=\"mb-1\">New-tab catalog link</h3>\\n\n        <p class=\"text-secondary small\">\\n\n            Opens RepairLink in a new tab from the estimate toolbar. It does not replace PartsTech on the main catalog button. ARK does not sign in, pull a cart, or send vehicle data in the URL. VIN is copied to the clipboard when present.\\n\n        </p>\\n\n\\n\n        <div class=\"alert small alert-secondary\" role=\"status\">\\n\n                            RepairLink stays closed until it is enabled with an https:// launch address.\\n\n                    </div>\\n\n\\n\n        <label class=\"form-check form-switch\">\\n\n            <input type=\"hidden\" name=\"repairlink_enabled\" value=\"0\">\\n\n            <input type=\"checkbox\" name=\"repairlink_enabled\" value=\"1\"  class=\"form-check-input\">\\n\n            <span class=\"form-check-label\">Show RepairLink on the estimate toolbar</span>\\n\n        </label>\\n\n\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-md-8\">\\n\n                <label for=\"settings-repairlink-url\" class=\"form-label\">Launch URL</label>\\n\n                <input\\n\n                    id=\"settings-repairlink-url\"\\n\n                    type=\"text\"\\n\n                    name=\"repairlink_url\"\\n\n                    value=\"\"\\n\n                    class=\"form-control font-monospace\"\\n\n                    placeholder=\"https://repairlinkshop.com\"\\n\n                    autocomplete=\"off\"\\n\n                >\\n\n                                <div class=\"form-hint\">HTTPS only. Enter the shop\u2019s RepairLink address. ARK will add https:// if the scheme is missing.</div>\\n\n            </div>\\n\n\\n\n            <div class=\"col-12 col-md-4\">\\n\n                <label for=\"settings-catalog-repairlink-color\" class=\"form-label\">Button color</label>\\n\n<select id=\"settings-catalog-repairlink-color\" name=\"repairlink_color\" class=\"form-select\">\\n\n                <option value=\"yellow\" >Yellow</option>\\n\n            <option value=\"green\" >Green</option>\\n\n            <option value=\"orange\" >Orange</option>\\n\n            <option value=\"red\" >Red</option>\\n\n            <option value=\"blue\" selected>Blue</option>\\n\n            <option value=\"navy\" >Navy</option>\\n\n            <option value=\"slate\" >Slate</option>\\n\n    </select>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">\\n\n                Save RepairLink settings\\n\n            </button>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n\\n\n<div class=\"card-body\" data-settings-nexpart>\\n\n    <form method=\"POST\" action=\"http://localhost/app/settings/shop/nexpart\" style=\"max-width: 48rem\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n        <div class=\"subheader\">Nexpart</div>\\n\n        <h3 class=\"mb-1\">Catalog or new-tab link</h3>\\n\n        <p class=\"text-secondary small\">\\n\n                            If this shop has ARK Shop parts catalog, Nexpart sits on the estimate catalog button (Open and VIN copy; no cart pull). Otherwise it opens in a new tab like RepairLink. ARK does not sign in or pull a Nexpart cart.\\n\n                    </p>\\n\n\\n\n        <div class=\"alert small alert-secondary\" role=\"status\">\\n\n                            Nexpart stays closed until it is enabled with an https:// launch address.\\n\n                    </div>\\n\n\\n\n        <label class=\"form-check form-switch\">\\n\n            <input type=\"hidden\" name=\"nexpart_enabled\" value=\"0\">\\n\n            <input type=\"checkbox\" name=\"nexpart_enabled\" value=\"1\"  class=\"form-check-input\">\\n\n            <span class=\"form-check-label\">Enable Nexpart for this shop</span>\\n\n        </label>\\n\n\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-md-8\">\\n\n                <label for=\"settings-nexpart-url\" class=\"form-label\">Launch URL</label>\\n\n                <input\\n\n                    id=\"settings-nexpart-url\"\\n\n                    type=\"text\"\\n\n                    name=\"nexpart_url\"\\n\n                    value=\"\"\\n\n                    class=\"form-control font-monospace\"\\n\n                    placeholder=\"https://\"\\n\n                    autocomplete=\"off\"\\n\n                >\\n\n                                <div class=\"form-hint\">HTTPS only. ARK will add https:// if the scheme is missing.</div>\\n\n            </div>\\n\n\\n\n            <div class=\"col-12 col-md-4\">\\n\n                <label for=\"settings-catalog-nexpart-color\" class=\"form-label\">Button color</label>\\n\n<select id=\"settings-catalog-nexpart-color\" name=\"nexpart_color\" class=\"form-select\">\\n\n                <option value=\"yellow\" >Yellow</option>\\n\n            <option value=\"green\" >Green</option>\\n\n            <option value=\"orange\" >Orange</option>\\n\n            <option value=\"red\" >Red</option>\\n\n            <option value=\"blue\" >Blue</option>\\n\n            <option value=\"navy\" selected>Navy</option>\\n\n            <option value=\"slate\" >Slate</option>\\n\n    </select>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">\\n\n                Save Nexpart settings\\n\n            </button>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n\\n\n\\n\n<div class=\"card-body\" data-settings-catalog-links>\\n\n    <form method=\"POST\" action=\"http://localhost/app/settings/shop/catalog-links\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n        <div class=\"subheader\">More catalogs</div>\\n\n        <h3 class=\"mb-1\">Shop catalog links</h3>\\n\n        <p class=\"text-secondary small\" style=\"max-width: 48rem\">\\n\n            Add O\u2019Reilly Pro, First Call, AutoZone Pro, or any other https:// catalog. Choose Catalog to put it on the estimate button like PartsTech, or Link to open it in a new tab. PartsTech cannot be added or edited here.\\n\n        </p>\\n\n\\n\n        \\n\n        \\n\n        <div class=\"card card-sm\" data-catalog-link-add>\\n\n            <div class=\"card-body\">\\n\n                <div class=\"row g-2 align-items-end\">\\n\n                    <div class=\"col-12 col-sm-6 col-lg-3\">\\n\n                        <label for=\"settings-catalog-link-create-label\" class=\"form-label\">Add name</label>\\n\n                        <input\\n\n                            id=\"settings-catalog-link-create-label\"\\n\n                            type=\"text\"\\n\n                            name=\"create[label]\"\\n\n                            value=\"\"\\n\n                            maxlength=\"64\"\\n\n                            placeholder=\"O\u2019Reilly Pro\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                    </div>\\n\n                    <div class=\"col-12 col-sm-6 col-lg-4\">\\n\n                        <label for=\"settings-catalog-link-create-url\" class=\"form-label\">Add URL</label>\\n\n                        <input\\n\n                            id=\"settings-catalog-link-create-url\"\\n\n                            type=\"text\"\\n\n                            name=\"create[url]\"\\n\n                            value=\"\"\\n\n                            placeholder=\"https://\"\\n\n                            class=\"form-control font-monospace\"\\n\n                            autocomplete=\"off\"\\n\n                        >\\n\n                    </div>\\n\n                    <div class=\"col-6 col-lg-2\">\\n\n                        <label for=\"settings-catalog-create-mode\" class=\"form-label\">Type</label>\\n\n<select id=\"settings-catalog-create-mode\" name=\"create[mode]\" class=\"form-select\">\\n\n    <option value=\"link\" selected>Link (new tab)</option>\\n\n    <option value=\"catalog\" >Catalog</option>\\n\n</select>\\n\n                    </div>\\n\n                    <div class=\"col-6 col-lg-3\">\\n\n                        <label for=\"settings-catalog-create-color\" class=\"form-label\">Button color</label>\\n\n<select id=\"settings-catalog-create-color\" name=\"create[color]\" class=\"form-select\">\\n\n            <option value=\"\" selected>Automatic</option>\\n\n                <option value=\"yellow\" >Yellow</option>\\n\n            <option value=\"green\" >Green</option>\\n\n            <option value=\"orange\" >Orange</option>\\n\n            <option value=\"red\" >Red</option>\\n\n            <option value=\"blue\" >Blue</option>\\n\n            <option value=\"navy\" >Navy</option>\\n\n            <option value=\"slate\" >Slate</option>\\n\n    </select>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">\\n\n                Save catalog links\\n\n            </button>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n                </section>\\n\n\\n\n                                <section class=\"card\" x-show=\"active === 'communications'\" x-cloak data-settings-section=\"communications\">\\n\n                    <div class=\"card-header\">\\n\n    <div>\\n\n        <div class=\"subheader\">Communications</div>\\n\n        <h2 class=\"card-title\">Phone, SMS, and email</h2>\\n\n        <div class=\"card-subtitle\">\\n\n            Business phone, SMS, email, Messenger, and call routing.\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n<div class=\"card-header\">\\n\n    <ul class=\"nav nav-tabs card-header-tabs flex-wrap\">\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=general\"\\n\n                    class=\"nav-link active\"\\n\n                     aria-current=\"page\"                 >General</a>\\n\n            </li>\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=email\"\\n\n                    class=\"nav-link\"\\n\n                                    >Email</a>\\n\n            </li>\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=messenger\"\\n\n                    class=\"nav-link\"\\n\n                                    >Messenger</a>\\n\n            </li>\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=hours\"\\n\n                    class=\"nav-link\"\\n\n                                    >Hours</a>\\n\n            </li>\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=recording\"\\n\n                    class=\"nav-link\"\\n\n                                    >Recording</a>\\n\n            </li>\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=ring\"\\n\n                    class=\"nav-link\"\\n\n                                    >Call routing</a>\\n\n            </li>\\n\n                    <li class=\"nav-item\">\\n\n                <a\\n\n                    href=\"http://localhost/app/settings/shop?section=communications&amp;communications-tab=mobile\"\\n\n                    class=\"nav-link\"\\n\n                                    >Mobile</a>\\n\n            </li>\\n\n            </ul>\\n\n</div>\\n\n\\n\n<div class=\"card-body d-flex flex-column gap-3\">\\n\n    \\n\n    \\n\n        <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/settings/shop/telephony\"\\n\n        class=\"d-flex flex-column gap-3\"\\n\n        x-data=\"{\\n\n            endpoints: [],\\n\n            callerRingMode: 'standard',\\n\n            callerRingPromoUrl: '',\\n\n            validationErrors: [],\\n\n            staffMembers: JSON.parse('[{\\u0022id\\u0022:\\u00221\\u0022,\\u0022name\\u0022:\\u0022Earline O\\\\u0027Conner\\u0022,\\u0022phone\\u0022:null,\\u0022hasPhone\\u0022:false}]'),\\n\n            addEndpoint() {\\n\n                this.endpoints.push({ name: '', type: 'cell', destination: '', user_id: '', ring_schedule: 'always', ring_delay_seconds: 0, presence_timeout_minutes: 30, enabled: true });\\n\n            },\\n\n            removeEndpoint(index) {\\n\n                this.endpoints.splice(index, 1);\\n\n            },\\n\n            staffHasPhone(userId) {\\n\n                const member = this.staffMembers.find((entry) => entry.id === String(userId));\\n\n                return member?.hasPhone ?? false;\\n\n            },\\n\n            endpointError(index, field) {\\n\n                const messages = this.validationErrors[`endpoints.${index}.${field}`];\\n\n                return Array.isArray(messages) ? messages[0] : null;\\n\n            },\\n\n            syncCellEndpoint(endpoint) {\\n\n                if (endpoint.type !== 'cell' || ! endpoint.user_id) {\\n\n                    return;\\n\n                }\\n\n                const member = this.staffMembers.find((entry) => entry.id === String(endpoint.user_id));\\n\n                if (member && ! endpoint.name) {\\n\n                    endpoint.name = `${member.name} Cell`;\\n\n                }\\n\n            },\\n\n        }\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"communications_tab\" value=\"general\">\\n\n\\n\n        \\n\n                <div class=\"d-flex flex-column gap-3\">\\n\n            <div class=\"d-flex flex-column gap-3\">\\n\n    <div class=\"row g-2\">\\n\n        <div class=\"col-12 col-md-6 col-xl-4\">\\n\n            <div class=\"alert alert-secondary mb-0 py-2 small h-100\">\\n\n                <div class=\"subheader\">Phone</div>\\n\n                <div class=\"fw-bold\">Voice transport not configured</div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-md-6 col-xl-4\">\\n\n            <div class=\"alert alert-danger mb-0 py-2 small h-100\">\\n\n                <div class=\"subheader\">Connection</div>\\n\n                <div class=\"fw-bold\">Not connected</div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-md-6 col-xl-4\">\\n\n            <div class=\"alert alert-danger mb-0 py-2 small h-100\">\\n\n                <div class=\"subheader\">Voice webhook</div>\\n\n                <div class=\"fw-bold\">Error</div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-md-6 col-xl-4\">\\n\n            <div class=\"alert alert-danger mb-0 py-2 small h-100\">\\n\n                <div class=\"subheader\">SMS / MMS webhook</div>\\n\n                <div class=\"fw-bold\">Error</div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-md-6 col-xl-4\">\\n\n            <div class=\"alert alert-secondary mb-0 py-2 small h-100\">\\n\n                <div class=\"subheader\">Messenger webhook</div>\\n\n                <div class=\"fw-bold\">Disabled</div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-md-6 col-xl-4\">\\n\n            <div class=\"alert alert-secondary mb-0 py-2 small h-100\">\\n\n                <div class=\"subheader\">Screen pop</div>\\n\n                <div class=\"fw-bold\">Off</div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"row g-2\">\\n\n        <div class=\"col-12 col-lg-6 col-xl-3\">\\n\n            <div class=\"border rounded px-3 py-2 h-100\">\\n\n                <div class=\"subheader\">Last incoming call</div>\\n\n                                    <div class=\"small fw-semibold text-secondary\">No inbound calls recorded yet.</div>\\n\n                            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-lg-6 col-xl-3\">\\n\n            <div class=\"border rounded px-3 py-2 h-100\">\\n\n                <div class=\"subheader\">Last voice webhook</div>\\n\n                                    <div class=\"small fw-semibold text-secondary\">Waiting for the first inbound call webhook.</div>\\n\n                            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-lg-6 col-xl-3\">\\n\n            <div class=\"border rounded px-3 py-2 h-100\">\\n\n                <div class=\"subheader\">Last SMS / MMS webhook</div>\\n\n                                    <div class=\"small fw-semibold text-secondary\">Waiting for the first inbound message webhook.</div>\\n\n                            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-lg-6 col-xl-3\">\\n\n            <div class=\"border rounded px-3 py-2 h-100\">\\n\n                <div class=\"subheader\">Last Messenger webhook</div>\\n\n                                    <div class=\"small fw-semibold text-secondary\">Waiting for the first inbound Messenger webhook.</div>\\n\n                            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n            <div class=\"alert alert-warning small mb-0\">\\n\n            <ul class=\"mb-0 ps-3\">\\n\n                                    <li>Twilio auth token is missing from deployment configuration.</li>\\n\n                                    <li>Outbound SMS transport is not configured in stock Core.</li>\\n\n                            </ul>\\n\n        </div>\\n\n    \\n\n    <div class=\"small text-secondary\">\\n\n        <div class=\"d-flex flex-wrap align-items-baseline justify-content-between column-gap-3\">\\n\n            <p class=\"fw-semibold text-body mb-0\">Connected transports</p>\\n\n            <p class=\"small text-muted mb-0\">Not configured</p>\\n\n        </div>\\n\n        <div class=\"border rounded px-3 py-2 mt-2\">\\n\n            Stock Core does not publish carrier webhook URLs. SMS, voice, and Messenger stay unavailable until a transport implementation is installed.\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n            <div\\n\n    class=\"d-flex flex-column gap-3\"\\n\n    x-data=\"{\\n\n        rows: JSON.parse('[{\\u0022id\\u0022:\\u002296f41569-161a-401c-92b6-ce89f5eff55e\\u0022,\\u0022label\\u0022:\\u0022Estimate received\\u0022,\\u0022body\\u0022:\\u0022Thanks for reaching out - we received your request and will follow up shortly with next steps.\\u0022,\\u0022color\\u0022:\\u0022neutral\\u0022},{\\u0022id\\u0022:\\u002204452ca2-20d1-476d-b3c1-53e67b2d708c\\u0022,\\u0022label\\u0022:\\u0022Scheduling\\u0022,\\u0022body\\u0022:\\u0022We can get you on the schedule. What day works best for you to bring the vehicle in?\\u0022,\\u0022color\\u0022:\\u0022neutral\\u0022},{\\u0022id\\u0022:\\u00222d50e205-b6f3-4968-b88a-8ccc2da8f1b1\\u0022,\\u0022label\\u0022:\\u0022Running behind\\u0022,\\u0022body\\u0022:\\u0022Thanks for your patience - we are running a little behind today but will get back to you as soon as possible.\\u0022,\\u0022color\\u0022:\\u0022neutral\\u0022},{\\u0022id\\u0022:\\u00220cb93187-dd90-46cc-adec-0328af2427e7\\u0022,\\u0022label\\u0022:\\u0022Financing\\u0022,\\u0022body\\u0022:\\u0022We offer several payment options at checkout. Let us know if you would like an estimate sent over to review.\\u0022,\\u0022color\\u0022:\\u0022neutral\\u0022}]'),\\n\n        add() {\\n\n            this.rows.push({ id: crypto.randomUUID(), label: '', body: '', color: 'neutral' });\\n\n        },\\n\n        remove(id) {\\n\n            this.rows = this.rows.filter((row) => row.id !== id);\\n\n        },\\n\n    }\"\\n\n>\\n\n    <input type=\"hidden\" name=\"quick_reply_templates_present\" value=\"1\">\\n\n\\n\n    <div>\\n\n        <div class=\"subheader\">Canned responses</div>\\n\n        <p class=\"text-secondary small mb-0\">\\n\n            Each block is one reply. The name is the chip. Color is how that chip looks in the composer.\\n\n        </p>\\n\n    </div>\\n\n\\n\n        \\n\n    <div class=\"d-flex flex-column gap-3\">\\n\n        <template x-for=\"(row, index) in rows\" :key=\"row.id\">\\n\n            <article class=\"card card-sm\">\\n\n                <header class=\"card-header d-flex align-items-center justify-content-between gap-3\">\\n\n                    <h4 class=\"mb-0 text-truncate\" style=\"min-width: 0\" x-text=\"row.label || 'New response'\"></h4>\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        @click=\"remove(row.id)\"\\n\n                        class=\"btn btn-sm btn-ghost-danger flex-shrink-0\"\\n\n                    >\\n\n                        Delete\\n\n                    </button>\\n\n                </header>\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"row g-3\">\\n\n                        <label class=\"col-12 col-sm-8\">\\n\n                            <span class=\"form-label\">Label</span>\\n\n                            <input\\n\n                                type=\"text\"\\n\n                                :name=\"`quick_reply_templates[${index}][label]`\"\\n\n                                x-model=\"row.label\"\\n\n                                maxlength=\"40\"\\n\n                                required\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </label>\\n\n                        <label class=\"col-12 col-sm-4\">\\n\n                            <span class=\"form-label\">Chip color</span>\\n\n                            <select\\n\n                                :name=\"`quick_reply_templates[${index}][color]`\"\\n\n                                x-model=\"row.color\"\\n\n                                class=\"form-select\"\\n\n                            >\\n\n                                                                    <option value=\"neutral\">Neutral</option>\\n\n                                                                    <option value=\"slate\">Slate</option>\\n\n                                                                    <option value=\"blue\">Blue</option>\\n\n                                                                    <option value=\"amber\">Amber</option>\\n\n                                                                    <option value=\"orange\">Orange</option>\\n\n                                                                    <option value=\"green\">Green</option>\\n\n                                                            </select>\\n\n                        </label>\\n\n                        <label class=\"col-12\">\\n\n                            <span class=\"form-label\">Message</span>\\n\n                            <textarea\\n\n                                :name=\"`quick_reply_templates[${index}][body]`\"\\n\n                                x-model=\"row.body\"\\n\n                                rows=\"2\"\\n\n                                maxlength=\"1600\"\\n\n                                required\\n\n                                class=\"form-control\"\\n\n                            ></textarea>\\n\n                        </label>\\n\n                    </div>\\n\n                </div>\\n\n            </article>\\n\n        </template>\\n\n    </div>\\n\n\\n\n    <div>\\n\n        <button\\n\n            type=\"button\"\\n\n            @click=\"add()\"\\n\n            class=\"btn\"\\n\n        >\\n\n            Add response\\n\n        </button>\\n\n    </div>\\n\n</div>\\n\n\\n\n            <div class=\"d-flex flex-column gap-3\">\\n\n    <div>\\n\n        <div class=\"subheader\">Message Actions</div>\\n\n        <p class=\"text-secondary small mb-0\">\\n\n            Each block is one Actions menu item. Color is the bar on that item. Empty tow or Wi-Fi fields stay hidden.\\n\n        </p>\\n\n    </div>\\n\n\\n\n                    <article class=\"card card-sm\" style=\"border-left: 4px solid #94a3b8\">\\n\n            <header class=\"card-header d-block\">\\n\n                <h4 class=\"mb-1\">Send Address</h4>\\n\n                <p class=\"text-secondary small mb-0\">The address text comes from shop settings. Color is only how this item looks in Actions.</p>\\n\n            </header>\\n\n            <div class=\"card-body\">\\n\n                <div class=\"row g-3\">\\n\n                    <label class=\"col-12 col-sm-6\">\\n\n                        <span class=\"form-label\">Menu color</span>\\n\n                        <select name=\"message_actions[colors][address]\" class=\"form-select\">\\n\n                                                            <option value=\"neutral\" selected>Neutral</option>\\n\n                                                            <option value=\"slate\" >Slate</option>\\n\n                                                            <option value=\"blue\" >Blue</option>\\n\n                                                            <option value=\"amber\" >Amber</option>\\n\n                                                            <option value=\"orange\" >Orange</option>\\n\n                                                            <option value=\"green\" >Green</option>\\n\n                                                    </select>\\n\n                    </label>\\n\n\\n\n                                    </div>\\n\n            </div>\\n\n        </article>\\n\n                    <article class=\"card card-sm\" style=\"border-left: 4px solid #94a3b8\">\\n\n            <header class=\"card-header d-block\">\\n\n                <h4 class=\"mb-1\">Send Hours</h4>\\n\n                <p class=\"text-secondary small mb-0\">Hours text comes from shop hours. Color is only how this item looks in Actions.</p>\\n\n            </header>\\n\n            <div class=\"card-body\">\\n\n                <div class=\"row g-3\">\\n\n                    <label class=\"col-12 col-sm-6\">\\n\n                        <span class=\"form-label\">Menu color</span>\\n\n                        <select name=\"message_actions[colors][hours]\" class=\"form-select\">\\n\n                                                            <option value=\"neutral\" selected>Neutral</option>\\n\n                                                            <option value=\"slate\" >Slate</option>\\n\n                                                            <option value=\"blue\" >Blue</option>\\n\n                                                            <option value=\"amber\" >Amber</option>\\n\n                                                            <option value=\"orange\" >Orange</option>\\n\n                                                            <option value=\"green\" >Green</option>\\n\n                                                    </select>\\n\n                    </label>\\n\n\\n\n                                    </div>\\n\n            </div>\\n\n        </article>\\n\n                    <article class=\"card card-sm\" style=\"border-left: 4px solid #94a3b8\">\\n\n            <header class=\"card-header d-block\">\\n\n                <h4 class=\"mb-1\">Send Pickup Info</h4>\\n\n                <p class=\"text-secondary small mb-0\">Uses the shop address, plus the after-hours note below when you fill it in.</p>\\n\n            </header>\\n\n            <div class=\"card-body\">\\n\n                <div class=\"row g-3\">\\n\n                    <label class=\"col-12 col-sm-6\">\\n\n                        <span class=\"form-label\">Menu color</span>\\n\n                        <select name=\"message_actions[colors][pickup]\" class=\"form-select\">\\n\n                                                            <option value=\"neutral\" selected>Neutral</option>\\n\n                                                            <option value=\"slate\" >Slate</option>\\n\n                                                            <option value=\"blue\" >Blue</option>\\n\n                                                            <option value=\"amber\" >Amber</option>\\n\n                                                            <option value=\"orange\" >Orange</option>\\n\n                                                            <option value=\"green\" >Green</option>\\n\n                                                    </select>\\n\n                    </label>\\n\n\\n\n                                            <label class=\"col-12\">\\n\n                            <span class=\"form-label\">After-hours pickup notes</span>\\n\n                            <textarea name=\"message_actions[after_hours_pickup]\" rows=\"2\" class=\"form-control\" placeholder=\"Keys in drop box by Unit D door. Pay link must be complete first.\"></textarea>\\n\n                        </label>\\n\n                                    </div>\\n\n            </div>\\n\n        </article>\\n\n                    <article class=\"card card-sm\" style=\"border-left: 4px solid #94a3b8\">\\n\n            <header class=\"card-header d-block\">\\n\n                <h4 class=\"mb-1\">Send Tow Info</h4>\\n\n                <p class=\"text-secondary small mb-0\">Shown in Actions once a tow phone is saved.</p>\\n\n            </header>\\n\n            <div class=\"card-body\">\\n\n                <div class=\"row g-3\">\\n\n                    <label class=\"col-12 col-sm-6\">\\n\n                        <span class=\"form-label\">Menu color</span>\\n\n                        <select name=\"message_actions[colors][tow]\" class=\"form-select\">\\n\n                                                            <option value=\"neutral\" selected>Neutral</option>\\n\n                                                            <option value=\"slate\" >Slate</option>\\n\n                                                            <option value=\"blue\" >Blue</option>\\n\n                                                            <option value=\"amber\" >Amber</option>\\n\n                                                            <option value=\"orange\" >Orange</option>\\n\n                                                            <option value=\"green\" >Green</option>\\n\n                                                    </select>\\n\n                    </label>\\n\n\\n\n                                            <label class=\"col-12 col-sm-6\">\\n\n                            <span class=\"form-label\">Tow company</span>\\n\n                            <input type=\"text\" name=\"message_actions[tow_company]\" value=\"\" class=\"form-control\" placeholder=\"Pinky's Towing\">\\n\n                        </label>\\n\n                        <label class=\"col-12 col-sm-6\">\\n\n                            <span class=\"form-label\">Tow phone</span>\\n\n                            <input type=\"text\" name=\"message_actions[tow_phone]\" value=\"\" class=\"form-control\" placeholder=\"719-555-0100\">\\n\n                        </label>\\n\n                        <label class=\"col-12\">\\n\n                            <span class=\"form-label\">Tow notes</span>\\n\n                            <textarea name=\"message_actions[tow_notes]\" rows=\"2\" class=\"form-control\" placeholder=\"Tell them it's for LugsNPlugs - Unit D.\"></textarea>\\n\n                        </label>\\n\n                                    </div>\\n\n            </div>\\n\n        </article>\\n\n                    <article class=\"card card-sm\" style=\"border-left: 4px solid #94a3b8\">\\n\n            <header class=\"card-header d-block\">\\n\n                <h4 class=\"mb-1\">Send Wi-Fi</h4>\\n\n                <p class=\"text-secondary small mb-0\">Shown in Actions once a network name is saved.</p>\\n\n            </header>\\n\n            <div class=\"card-body\">\\n\n                <div class=\"row g-3\">\\n\n                    <label class=\"col-12 col-sm-6\">\\n\n                        <span class=\"form-label\">Menu color</span>\\n\n                        <select name=\"message_actions[colors][wifi]\" class=\"form-select\">\\n\n                                                            <option value=\"neutral\" selected>Neutral</option>\\n\n                                                            <option value=\"slate\" >Slate</option>\\n\n                                                            <option value=\"blue\" >Blue</option>\\n\n                                                            <option value=\"amber\" >Amber</option>\\n\n                                                            <option value=\"orange\" >Orange</option>\\n\n                                                            <option value=\"green\" >Green</option>\\n\n                                                    </select>\\n\n                    </label>\\n\n\\n\n                                            <label class=\"col-12 col-sm-6\">\\n\n                            <span class=\"form-label\">Waiting room Wi-Fi network</span>\\n\n                            <input type=\"text\" name=\"message_actions[wifi_ssid]\" value=\"\" class=\"form-control\">\\n\n                        </label>\\n\n                        <label class=\"col-12 col-sm-6\">\\n\n                            <span class=\"form-label\">Wi-Fi password</span>\\n\n                            <input type=\"text\" name=\"message_actions[wifi_password]\" value=\"\" class=\"form-control\">\\n\n                        </label>\\n\n                                    </div>\\n\n            </div>\\n\n        </article>\\n\n    </div>\\n\n\\n\n            <div class=\"border rounded p-3\">\\n\n                <div class=\"border-bottom pb-3 mb-3\">\\n\n                    <div class=\"subheader\">Texting</div>\\n\n                    <p class=\"text-secondary small mb-0 mt-1\">\\n\n                        Customer texts are sent through ARK Texting when this shop is connected.\\n\n                        This shop does not store a messaging provider account.\\n\n                    </p>\\n\n                    <p class=\"small fw-medium mb-0 mt-2\">\\n\n                                                    ARK Texting is not connected. The composer still works; messages will not send until ARK Shop connects texting for this shop.\\n\n                                            </p>\\n\n                </div>\\n\n\\n\n                                    <div style=\"max-width: 28rem\">\\n\n                        <label for=\"settings-telephony-inbound-number\" class=\"form-label\">Business number</label>\\n\n                        <input\\n\n                            id=\"settings-telephony-inbound-number\"\\n\n                            type=\"text\"\\n\n                            name=\"telephony_inbound_number\"\\n\n                            value=\"\"\\n\n                            class=\"form-control\"\\n\n                            placeholder=\"+1 (719) 555-0100\"\\n\n                        >\\n\n                        <div class=\"form-hint\">The number customers call and see on outbound shop calls.</div>\\n\n                    </div>\\n\n                            </div>\\n\n\\n\n            <div\\n\n                x-data=\"{\\n\n                    phone: '7195551234',\\n\n                    testing: false,\\n\n                    testMessage: '',\\n\n                    testTone: 'muted',\\n\n                    async testIncomingCall() {\\n\n                        this.testing = true;\\n\n                        this.testMessage = '';\\n\n\\n\n                        try {\\n\n                            const response = await fetch('http://localhost/app/settings/telephony/test-incoming-call', {\\n\n                                method: 'POST',\\n\n                                headers: {\\n\n                                    'Content-Type': 'application/json',\\n\n                                    'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]')?.content ?? '',\\n\n                                    Accept: 'application/json',\\n\n                                },\\n\n                                body: JSON.stringify({ phone: this.phone }),\\n\n                            });\\n\n\\n\n                            const payload = await response.json();\\n\n\\n\n                            if (! response.ok) {\\n\n                                this.testTone = 'danger';\\n\n                                this.testMessage = payload.message ?? 'Test call failed.';\\n\n                                return;\\n\n                            }\\n\n\\n\n                            this.testTone = 'success';\\n\n                            this.testMessage = payload.matched\\n\n                                ? `Screen pop fired for matched customer #${payload.customer_id}.`\\n\n                                : 'Screen pop fired for unknown caller.';\\n\n                        } catch (error) {\\n\n                            this.testTone = 'danger';\\n\n                            this.testMessage = 'Test call failed to reach ARK.';\\n\n                        } finally {\\n\n                            this.testing = false;\\n\n                        }\\n\n                    },\\n\n                }\"\\n\n                class=\"border rounded p-3 d-flex flex-column gap-2\"\\n\n            >\\n\n                <div>\\n\n                    <div class=\"subheader\">Operational test</div>\\n\n                    <h3 class=\"mb-1\">Test incoming call</h3>\\n\n                    <p class=\"text-secondary small mb-0\">\\n\n                        Fires the incoming-call banner without placing a real phone call.\\n\n                    </p>\\n\n                </div>\\n\n\\n\n                <div class=\"d-flex flex-wrap align-items-end gap-2\">\\n\n                    <div class=\"flex-fill\" style=\"min-width: 12rem; max-width: 20rem\">\\n\n                        <label for=\"settings-telephony-test-phone\" class=\"form-label\">Caller phone</label>\\n\n                        <input\\n\n                            id=\"settings-telephony-test-phone\"\\n\n                            type=\"text\"\\n\n                            x-model=\"phone\"\\n\n                            class=\"form-control\"\\n\n                            placeholder=\"7195551234\"\\n\n                        >\\n\n                    </div>\\n\n\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        @click=\"testIncomingCall()\"\\n\n                        :disabled=\"testing\"\\n\n                        class=\"btn\"\\n\n                    >\\n\n                        <span x-text=\"testing ? 'Testing\u2026' : 'Test incoming call'\"></span>\\n\n                    </button>\\n\n                </div>\\n\n\\n\n                <div\\n\n                    x-show=\"testMessage\"\\n\n                    x-text=\"testMessage\"\\n\n                    class=\"alert small fw-medium mb-0 py-2\"\\n\n                    :class=\"{\\n\n                        'alert-success': testTone === 'success',\\n\n                        'alert-danger': testTone === 'danger',\\n\n                        'alert-secondary': testTone === 'muted',\\n\n                    }\"\\n\n                    role=\"status\"\\n\n                ></div>\\n\n            </div>\\n\n        </div>\\n\n        \\n\n        \\n\n        \\n\n        \\n\n        <div class=\"d-flex justify-content-end border-top pt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">\\n\n                Save telephony settings\\n\n            </button>\\n\n        </div>\\n\n    </form>\\n\n    </div>\\n\n                </section>\\n\n                \\n\n                <section class=\"card\" x-show=\"active === 'runtime-health'\" x-cloak data-settings-section=\"runtime-health\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Troubleshooting</div>\\n\n                            <h2 class=\"card-title\">Runtime health</h2>\\n\n                            <div class=\"card-subtitle\">\\n\n                                Infrastructure may observe local time. ARK records facts in UTC and projects them into the shop timezone at display time.\\n\n                                Use this page after deploys or VPS timezone changes - not for daily operations.\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"card-body\" data-runtime-live-clocks>\\n\n    <div class=\"subheader mb-2\">Live clocks</div>\\n\n    <div\\n\n        class=\"row g-2\"\\n\n        title=\"Server (PHP): UTC \u00b7 MySQL clock unavailable \u00b7 Shop display: America/Denver\"\\n\n        x-data=\"arkOperationalClock(JSON.parse('{\\u0022server_utc_iso\\u0022:\\u00222026-11-24T16:29:33+00:00\\u0022,\\u0022db_utc_iso\\u0022:null,\\u0022db_session_now_iso\\u0022:null,\\u0022db_available\\u0022:false,\\u0022db_matches_utc\\u0022:false,\\u0022db_session_timezone\\u0022:null,\\u0022db_global_timezone\\u0022:null,\\u0022php_default_timezone\\u0022:\\u0022UTC\\u0022,\\u0022php_is_utc\\u0022:true,\\u0022shop_timezone\\u0022:\\u0022America\\\\\\/Denver\\u0022,\\u0022shop_short_label\\u0022:\\u0022Denver\\u0022,\\u0022shop_abbreviation\\u0022:\\u0022MST\\u0022}'))\"\\n\n        x-init=\"init()\"\\n\n        aria-label=\"Operational clocks\"\\n\n        data-runtime-operational-clock\\n\n    >\\n\n        <div class=\"col-12 col-sm-4\">\\n\n            <div class=\"border rounded px-3 py-2\" :class=\"{ 'border-warning bg-warning-lt': !phpIsUtc }\" data-runtime-clock-segment=\"utc\">\\n\n                <div class=\"subheader\">UTC</div>\\n\n                <div class=\"font-monospace fw-bold\" x-text=\"serverUtc\"></div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-12 col-sm-4\">\\n\n            <div class=\"border rounded px-3 py-2\" :class=\"{ 'border-warning bg-warning-lt': dbAvailable && !dbMatchesUtc }\" data-runtime-clock-segment=\"db\">\\n\n                <div class=\"subheader\">DB</div>\\n\n                <div class=\"font-monospace fw-bold\" x-text=\"dbUtc\"></div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-12 col-sm-4\">\\n\n            <div class=\"border rounded px-3 py-2\" data-runtime-clock-segment=\"shop\">\\n\n                <div class=\"subheader\">Denver</div>\\n\n                <div class=\"font-monospace fw-bold\">\\n\n                    <span x-text=\"shopLocal\"></span>\\n\n                    <span class=\"text-secondary fw-normal\" x-text=\"shopAbbr\"></span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <p class=\"small text-secondary mt-2 mb-0\">\\n\n        UTC and DB should match. Shop time should track Settings \u2192 Shop timezone.\\n\n        Amber means PHP or MySQL drifted off UTC.\\n\n    </p>\\n\n</div>\\n\n\\n\n<div class=\"card-body\">\\n\n    <div class=\"row g-4\">\\n\n        <div class=\"col-12 col-lg-6\" data-runtime-timezone-sources>\\n\n            <div class=\"subheader mb-2\">Time zone sources</div>\\n\n            <div class=\"list-group small\">\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">Laravel <code>app.timezone</code></span>\\n\n                    <span class=\"font-monospace fw-bold\">UTC</span>\\n\n                </div>\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">PHP default timezone</span>\\n\n                    <span class=\"font-monospace fw-bold\">UTC</span>\\n\n                </div>\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">Shop display timezone</span>\\n\n                    <span class=\"font-monospace fw-bold\">America/Denver</span>\\n\n                </div>\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\"><code>app.display_timezone</code></span>\\n\n                    <span class=\"font-monospace fw-bold\">America/Denver</span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div class=\"col-12 col-lg-6\" data-runtime-mysql-session>\\n\n            <div class=\"subheader mb-2\">MySQL session</div>\\n\n                            <p class=\"small text-secondary mb-0\">MySQL clock probe unavailable on this connection.</p>\\n\n                    </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n<div class=\"card-body\" data-runtime-realtime>\\n\n    <div class=\"subheader mb-2\">Realtime endpoint</div>\\n\n    <div class=\"row g-2 small\">\\n\n        <div class=\"col-12 col-sm-6\">\\n\n            <div class=\"list-group\">\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">WebSocket host</span>\\n\n                    <span class=\"font-monospace fw-bold text-break text-end\">app.lugsnplugs.test</span>\\n\n                </div>\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">Host source</span>\\n\n                    <span class=\"font-monospace fw-bold text-break text-end\">APP_URL</span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-12 col-sm-6\">\\n\n            <div class=\"list-group\">\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">Health JSON</span>\\n\n                    <a href=\"http://localhost/up/reverb\" target=\"_blank\" rel=\"noopener\" class=\"font-monospace fw-bold\">\\n\n                        /up/reverb\\n\n                    </a>\\n\n                </div>\\n\n                <div class=\"list-group-item d-flex align-items-baseline justify-content-between gap-3\">\\n\n                    <span class=\"text-secondary\">App URL</span>\\n\n                    <span class=\"font-monospace fw-bold text-break text-end\">https://app.lugsnplugs.test</span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n                    </section>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <p class=\"text-end small mt-3 mb-0\">\\n\n            <a\\n\n                href=\"http://localhost/app/settings/shop?section=runtime-health\"\\n\n                class=\"text-secondary\"\\n\n                @click.prevent=\"setActive('runtime-health')\"\\n\n            >Runtime health</a>\\n\n        </p>\\n\n    </section>\\n\n    </div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox\",\"disabled_reason\":null},{\"id\":\"nav.reports\",\"title\":\"Reports\",\"group\":\"Navigate\",\"keywords\":[\"reports\",\"end of day\",\"operational\"],\"url\":\"http:\\/\\/localhost\\/app\\/reports\",\"disabled_reason\":null},{\"id\":\"nav.settings\",\"title\":\"Settings\",\"group\":\"Navigate\",\"keywords\":[\"settings\",\"shop\",\"config\"],\"url\":\"http:\\/\\/localhost\\/app\\/settings\\/shop\",\"disabled_reason\":null},{\"id\":\"create.repair-order\",\"title\":\"New Repair Order\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"ro\",\"repair\",\"intake\",\"check in\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.customer\",\"title\":\"New Customer\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"customer\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.vehicle\",\"title\":\"New Vehicle\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"vehicle\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.appointment\",\"title\":\"New Appointment\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"appointment\",\"schedule\"],\"url\":\"http:\\/\\/localhost\\/app\\/appointments\\/create\",\"disabled_reason\":null},{\"id\":\"create.message\",\"title\":\"New Message\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"message\",\"text\",\"sms\",\"email\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose\",\"disabled_reason\":null},{\"id\":\"create.sms\",\"title\":\"New SMS\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"sms\",\"text\",\"phone\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=sms\",\"disabled_reason\":null},{\"id\":\"create.email\",\"title\":\"New Email\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"email\",\"mail\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=email\",\"disabled_reason\":null},{\"id\":\"search.customer\",\"title\":\"Search Customers\",\"group\":\"Search\",\"keywords\":[\"search\",\"customer\",\"phone\",\"name\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.vehicle\",\"title\":\"Search Vehicles\",\"group\":\"Search\",\"keywords\":[\"search\",\"vehicle\",\"vin\",\"plate\",\"license\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.vin\",\"title\":\"Search by VIN\",\"group\":\"Search\",\"keywords\":[\"search\",\"vin\",\"vehicle\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.plate\",\"title\":\"Search by License Plate\",\"group\":\"Search\",\"keywords\":[\"search\",\"plate\",\"license\",\"tag\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.phone\",\"title\":\"Search by Phone\",\"group\":\"Search\",\"keywords\":[\"search\",\"phone\",\"customer\",\"number\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.repair-order\",\"title\":\"Search Repair Orders\",\"group\":\"Search\",\"keywords\":[\"search\",\"ro\",\"repair\",\"order\",\"number\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.estimate\",\"title\":\"Search Estimates\",\"group\":\"Search\",\"keywords\":[\"search\",\"estimate\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.invoice\",\"title\":\"Search Invoices\",\"group\":\"Search\",\"keywords\":[\"search\",\"invoice\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"ops.print-key-tag\",\"title\":\"Print Key Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"key\",\"tag\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-oil-sticker\",\"title\":\"Print Oil Sticker\",\"group\":\"Operations\",\"keywords\":[\"print\",\"oil\",\"sticker\",\"change\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-service-tag\",\"title\":\"Print Service Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"service\",\"tag\",\"tech\",\"sheet\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.take-payment\",\"title\":\"Take Payment\",\"group\":\"Operations\",\"keywords\":[\"payment\",\"pay\",\"square\",\"collect\",\"balance\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.record-deposit\",\"title\":\"Record Deposit\",\"group\":\"Operations\",\"keywords\":[\"deposit\",\"payment\",\"record\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.open-active-ro\",\"title\":\"Open Active RO\",\"group\":\"Operations\",\"keywords\":[\"active\",\"ro\",\"open\",\"workboard\",\"repair\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null}]</script>\\n\n        <div class=\"modal d-block\" tabindex=\"-1\">\\n\n            <div class=\"modal-backdrop show z-0\" data-ops-global-search-backdrop></div>\\n\n            <div\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable\"\\n\n                data-ops-global-search-dialog\\n\n                role=\"dialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-label=\"Command palette\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header p-2\">\\n\n                        <label class=\"visually-hidden\" for=\"ops-global-search-input\">Search commands and records</label>\\n\n                        <div class=\"input-icon w-100\">\\n\n                            <span class=\"input-icon-addon\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                            </span>\\n\n                            <input\\n\n                                id=\"ops-global-search-input\"\\n\n                                type=\"search\"\\n\n                                class=\"form-control form-control-lg\"\\n\n                                data-ops-global-search-input\\n\n                                placeholder=\"Type a command or search\u2026\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"modal-body p-0\">\\n\n                        <div class=\"list-group list-group-flush\" data-ops-global-search-results>\\n\n                            <div class=\"list-group-item small text-secondary\">\u2318K \u00b7 Enter runs \u00b7 Esc closes</div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <div\\n\n    x-data=\"arkLearnGuideModal()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ark-learn-guide-modal\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"title || 'ARKademy guide'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close guide preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header align-items-start\">\\n\n                    <div class=\"overflow-hidden\">\\n\n                        <div class=\"subheader\" x-show=\"sectionLabel\" x-text=\"sectionLabel\"></div>\\n\n                        <h2 class=\"modal-title\" x-text=\"title || 'ARKademy'\"></h2>\\n\n                        <div class=\"small text-secondary\" x-show=\"summary\" x-text=\"summary\"></div>\\n\n                    </div>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"close()\" aria-label=\"Close\"></button>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-body\">\\n\n                    <div class=\"text-secondary\" x-show=\"loading\">\\n\n                        <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading guide\u2026\\n\n                    </div>\\n\n                    <div class=\"alert alert-danger mb-0\" role=\"alert\" x-show=\"error\" x-text=\"error\"></div>\\n\n                    \\n\n                    <div\\n\n                        class=\"ark-legacy bg-white text-dark rounded p-3 ops-learn-prose ops-learn-guide-modal__prose\"\\n\n                        x-show=\"! loading && ! error && html\"\\n\n                        x-html=\"html\"\\n\n                    ></div>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-footer\">\\n\n                                            <div class=\"small text-secondary me-auto\">Preview from ARK - open ARKademy for search, print, and full navigation.</div>\\n\n                                        <button type=\"button\" class=\"btn\" @click=\"close()\">Close</button>\\n\n                                            <a\\n\n                            :href=\"arkademyUrl\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-primary\"\\n\n                            x-show=\"arkademyUrl\"\\n\n                        >\\n\n                            Open in ARKademy\\n\n                        </a>\\n\n                                    </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n    <div x-data=\"arkCommsInterrupt()\" data-ark-comms-interrupt data-conversation-url-template=\"http://localhost/app/communications/inbox?conversation=__CONVERSATION__\" data-waiting-url=\"http://localhost/app/communications/inbox?filter=needs\">\\n\n        <div x-show=\"activeCall !== null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"callInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeCall\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-green\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"d-flex align-items-start gap-2\">\\n\n                                    <div class=\"flex-fill overflow-hidden\">\\n\n                                        <div class=\"small fw-bold text-uppercase text-green\" x-text=\"callEyebrow()\"></div>\\n\n                                        <template x-if=\"activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0 text-truncate\" x-text=\"activeCall.customer_name\"></div>\\n\n                                        </template>\\n\n                                        <template x-if=\"! activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0\">Unknown Caller</div>\\n\n                                        </template>\\n\n                                        <div class=\"text-secondary\" x-text=\"activeCall.display_phone\"></div>\\n\n                                        <template x-if=\"activeCall.owned_by_name\">\\n\n                                            <div class=\"small text-secondary mt-1\" x-text=\"ownerLabel()\"></div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                    <button type=\"button\" class=\"btn btn-sm\" @click=\"dismissCall()\">Dismiss</button>\\n\n                                </div>\\n\n\\n\n                                <template x-if=\"activeCall.matched\">\\n\n                                    <div class=\"mt-2\">\\n\n                                        <div class=\"small fw-medium text-truncate\" x-text=\"vehicleSummary()\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"openRoSummary()\"></div>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeCall.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeCall.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeCall.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeCall.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall.matched && previewOpenRos().length > 0\">\\n\n                                    <div class=\"list-group mt-2\">\\n\n                                        <template x-for=\"openRepairOrder in previewOpenRos()\" :key=\"openRepairOrder.repair_order_id\">\\n\n                                            <a\\n\n                                                :href=\"openRepairOrder.url\"\\n\n                                                class=\"list-group-item list-group-item-action d-flex align-items-center gap-2 small\"\\n\n                                                @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                            >\\n\n                                                <span class=\"fw-bold text-nowrap\" x-text=\"'RO #' + openRepairOrder.repair_order_id\"></span>\\n\n                                                <span class=\"flex-fill text-truncate text-secondary\" x-text=\"openRepairOrder.vehicle_name\"></span>\\n\n                                                <span class=\"text-secondary text-nowrap\" x-text=\"openRepairOrder.status_label\"></span>\\n\n                                            </a>\\n\n                                        </template>\\n\n                                        <template x-if=\"extraOpenRoCount() > 0 && activeCall.customer_url\">\\n\n                                            <a :href=\"activeCall.customer_url\" class=\"list-group-item list-group-item-action small\" @click=\"markCallHandledForId(activeCall.call_session_id)\">\\n\n                                                +<span x-text=\"extraOpenRoCount()\"></span> more on Customer Hub\\n\n                                            </a>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"lastConversationSnippet()\">\\n\n                                    <p class=\"small text-secondary mt-2 mb-0\" x-text=\"lastConversationSnippet()\"></p>\\n\n                                </template>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther() && activeCall.show_callback_action\"\\n\n                                    type=\"button\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"window.arkInitiateTelephonyCallback?.({\\n\n                                        customerId: activeCall.callback_customer_id,\\n\n                                        phone: activeCall.callback_phone,\\n\n                                        callSessionId: activeCall.call_session_id,\\n\n                                        button: $event.currentTarget,\\n\n                                    }); activeCall = null;\"\\n\n                                >Callback</button>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && activeCall.matched && activeCall.customer_url\"\\n\n                                    :href=\"activeCall.customer_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Open Customer</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched && activeCall.create_contact_url\"\\n\n                                    :href=\"activeCall.create_contact_url\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Create Contact</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched\"\\n\n                                    :href=\"activeCall.inta