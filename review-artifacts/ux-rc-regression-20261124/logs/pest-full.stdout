c_latest/work\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"VHsjhHda3vjR1XyGxNg1AM7Jr1IsxBrbOdheNE8j\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"action\" value=\"wait\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:14:14+00:00\">\\n\n                        <button type=\"submit\" class=\"dropdown-item\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M12 7v5l3 3\"/></svg>\\n\n                            Waiting on the customer\\n\n                        </button>\\n\n                    </form>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_latest/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"VHsjhHda3vjR1XyGxNg1AM7Jr1IsxBrbOdheNE8j\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:14:14+00:00\">\\n\n                    <button type=\"submit\" class=\"dropdown-item\" data-comms-work-unread>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                        Mark unread\\n\n                    </button>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                                    </div>\\n\n            </div>\\n\n            </div>\\n\n\\n\n            <section class=\"alert alert-danger m-2 mb-0 py-2 small\" aria-label=\"What to do next\" data-comms-decision=\"needs\">\\n\n    <div class=\"fw-bold\">\\n\n        Customer wrote last\\n\n                    <span class=\"fw-normal text-secondary\">Sep 29 \u00b7 3:00 PM</span>\\n\n            </div>\\n\n            <div class=\"text-secondary text-truncate d-none d-xxl-block\">Earlier text</div>\\n\n                <div class=\"text-secondary d-none d-xxl-block\">Customer wrote last - reply if needed, mark waiting if the shop is working this, or resolve if finished.</div>\\n\n    \\n\n    \\n\n    \\n\n</section>\\n\n    \\n\n    <div class=\"ark-comms-thread-wrap position-relative d-flex flex-column flex-fill\">\\n\n    <div\\n\n        id=\"comms-workspace-thread-messages\"\\n\n        class=\"card-body chat-bubbles ark-comms-thread gap-2 overflow-auto flex-fill p-2 p-md-3\"\\n\n        data-comms-thread-body\\n\n        aria-label=\"Conversation\"\\n\n                    data-mark-read-url=\"http://localhost/app/communications/platform-conversations/pc_latest/read\"\\n\n            data-conversation-key=\"platform:pc_latest\"\\n\n            >\\n\n                                <div class=\"text-center text-secondary small mt-1\" data-comms-date=\"2026-09-29\">Tue, Sep 29, 2026</div>\\n\n        <div data-comms-entry=\"\">\\n\n                    <div class=\"d-flex\">\\n\n            <article\\n\n                class=\"chat-bubble px-3 py-2\"\\n\n                style=\"max-width: 88%\"\\n\n                data-comms-bubble=\"inbound\"\\n\n            >\\n\n                <div class=\"chat-bubble-title small text-secondary\">\\n\n                    Received\\n\n                     \u00b7 SMS                      \u00b7 Sep 29 \u00b7 3:00 PM                 </div>\\n\n                <div class=\"chat-bubble-body\">\\n\n                                            <p class=\"mb-0\" style=\"white-space: pre-wrap\">Earlier text</p>\\n\n                                                                            </div>\\n\n            </article>\\n\n        </div>\\n\n        </div>\\n\n            </div>\\n\n        <button type=\"button\" class=\"btn btn-primary btn-sm rounded-pill shadow position-absolute bottom-0 start-50 translate-middle-x mb-2 d-none\" data-comms-new-below>\\n\n            New messages\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n        </button>\\n\n    </div>\\n\n\\n\n    \\n\n            <footer class=\"card-footer p-0\" data-comms-composer>\\n\n                                <div\\n\n                id=\"comms-thread-composer\"\\n\n                data-ark-workspace-dirty=\"off\"\\n\n                data-ark-conversation-composer\\n\n                data-platform-backed=\"1\"\\n\n                x-data=\"arkConversationQuickReply(JSON.parse('{\\u0022sendUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/communications\\\\\\/platform-conversations\\\\\\/pc_latest\\\\\\/messages\\u0022,\\u0022messagesListIds\\u0022:[\\u0022comms-workspace-thread-messages\\u0022],\\u0022hasConversationHistory\\u0022:true,\\u0022alwaysOpen\\u0022:true,\\u0022keepOpenAfterSend\\u0022:true,\\u0022customerPhoneDisplay\\u0022:\\u0022(719) 555-0511\\u0022,\\u0022showSmsComposer\\u0022:true,\\u0022platformBacked\\u0022:true}'))\"\\n\n            >\\n\n                <div class=\"px-3 py-2\">\\n\n                    <label class=\"visually-hidden\" for=\"comms-thread-composer-body\">Message</label>\\n\n                    <textarea\\n\n                        id=\"comms-thread-composer-body\"\\n\n                        x-ref=\"replyBody\"\\n\n                        x-model=\"body\"\\n\n                        rows=\"2\"\\n\n                        :placeholder=\"composerPlaceholder()\"\\n\n                        class=\"form-control\"\\n\n                        @keydown.meta.enter.prevent=\"send()\"\\n\n                        @keydown.ctrl.enter.prevent=\"send()\"\\n\n                    ></textarea>\\n\n                    <div class=\"mt-2\">\\n\n                        <div class=\"d-flex flex-wrap gap-1\" role=\"group\" aria-label=\"Quick replies\" data-comms-quick-replies>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for reaching out - we received your request and will follow up shortly with next steps.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Estimate received\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We can get you on the schedule. What day works best for you to bring the vehicle in?'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Scheduling\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for your patience - we are running a little behind today but will get back to you as soon as possible.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Running behind\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We offer several payment options at checkout. Let us know if you would like an estimate sent over to review.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Financing\\n\n            </button>\\n\n            </div>\\n\n                    </div>\\n\n                    <div class=\"small text-secondary text-truncate mt-1\" x-show=\"attachmentLabel\" x-text=\"attachmentLabel\" x-cloak></div>\\n\n                    <div class=\"small text-danger fw-medium mt-1\" x-show=\"error !== ''\" x-text=\"error\" x-cloak></div>\\n\n                </div>\\n\n                <div class=\"d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-top\" role=\"group\" aria-label=\"Conversation commands\">\\n\n                    <details\\n\n                        class=\"position-relative\"\\n\n                        x-ref=\"actionsMenu\"\\n\n                        @toggle=\"onActionsMenuToggle($event)\"\\n\n                        @click.outside=\"closeActionsMenu()\"\\n\n                    >\\n\n                        <summary class=\"btn btn-sm\">Actions</summary>\\n\n                        <div class=\"dropdown-menu show position-absolute bottom-100 mb-1\" data-comms-actions-panel>\\n\n                                                            <a href=\"tel:+17195550511\" class=\"dropdown-item\">\\n\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                