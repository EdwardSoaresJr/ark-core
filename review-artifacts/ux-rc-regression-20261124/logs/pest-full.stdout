            }\\n\n            } else {\\n\n                var doneMsg =\\n\n                    'All print jobs completed - ' +\\n\n                    ok +\\n\n                    ' key tag' +\\n\n                    (ok === 1 ? '' : 's') +\\n\n                    ' sent to printer';\\n\n                if (window.toastr && typeof window.toastr.success === 'function') {\\n\n                    window.toastr.success(doneMsg);\\n\n                }\\n\n            }\\n\n        }\\n\n    } catch (err) {\\n\n        console.error(err);\\n\n        arkNotifyPrintError(err);\\n\n    } finally {\\n\n        if (lockOwner) {\\n\n            arkReleaseLock(lockOwner);\\n\n        }\\n\n        if (btn) {\\n\n            btn.disabled = false;\\n\n        }\\n\n    }\\n\n}\\n\n\\n\nwindow.arkPrintKeyTagsBatch = arkPrintKeyTagsBatch;\\n\n\\n\nasync function arkPrintPartsLabelsBatch(urls, btn, batchOptions) {\\n\n    batchOptions = batchOptions || {};\\n\n    if (!urls || !urls.length) {\\n\n        return;\\n\n    }\\n\n    if (typeof window.ARK_PRINTERS === 'undefined' || !window.ARK_PRINTERS.keyTag || String(window.ARK_PRINTERS.keyTag).trim() === '') {\\n\n        if (window.toastr && typeof window.toastr.warning === 'function') {\\n\n            window.toastr.warning('Label printer is not configured');\\n\n        }\\n\n        return;\\n\n    }\\n\n    if (btn) {\\n\n        if (btn.dataset.printing === '1') {\\n\n            return;\\n\n        }\\n\n        btn.dataset.printing = '1';\\n\n        btn.disabled = true;\\n\n    }\\n\n    var lockOwner = null;\\n\n    var ok = 0;\\n\n    try {\\n\n        window.ARK_PRINT_QUEUE_LAST_HARD_ERROR = null;\\n\n        window.ARK_PRINT_QUEUE_LAST_FAIL_URL = null;\\n\n        var lockTtl = arkComputeLockTtl({ count: urls.length, bytes: 0 });\\n\n        lockOwner = arkAcquireLock(lockTtl);\\n\n        var sec = Math.ceil(lockTtl / 1000);\\n\n        if (window.toastr && typeof window.toastr.info === 'function') {\\n\n            