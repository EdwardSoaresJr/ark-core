    </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Repair order profitability</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Parts cost</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor cost</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">Assign technician cost</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Parts GP</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor GP</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Gross profit</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Target</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">Unknown</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Warranty exposure</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">None flagged</span>\\n\n                    </span>\\n\n                            </span>\\n\n                            <span class=\"d-block small fw-medium text-secondary border-top mt-2 pt-2\">Parts target 55%</span>\\n\n                    </span>\\n\n    </span>\\n\n                </div>\\n\n            </div>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100 ops-estimate-instrument-opens-context\"\\n\n                                            data-estimate-context-open=\"parts\"\\n\n                        role=\"button\"\\n\n                        tabindex=\"0\"\\n\n                        @click=\"toggleEstimateContext('parts')\"\\n\n                        @keydown.enter.prevent=\"toggleEstimateContext('parts')\"\\n\n                        @keydown.space.prevent=\"toggleEstimateContext('parts')\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"parts\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Parts</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">No shop parts</span>\\n\n                                                                                            </span>\\n\n                                                                                        <span class=\"d-block small text-secondary mt-1\">Parts readiness</span>\\n\n                                                    </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Parts procurement</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Shop parts</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">0 lines</span>\\n\n                    </span>\\n\n                            </span>\\n\n                    </span>\\n\n    </span>\\n\n                </div>\\n\n            </div>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"labor\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Labor</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">0 hrs</span>\\n\n                                                                                            </span>\\n\n                                                                                </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Labor</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Billed hours</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">0 hrs</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor sell</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor cost</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">Assign technician cost</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor margin</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">n/a</span>\\n\n                    </span>\\n\n                            </span>\\n\n                            <span class=\"d-block small fw-medium text-secondary border-top mt-2 pt-2\">Assigned \u00b7 Deion Hayes</span>\\n\n                    </span>\\n\n    </span>\\n\n                </div>\\n\n            </div>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100 ops-estimate-instrument-opens-context\"\\n\n                                            data-estimate-context-open=\"auth\"\\n\n                        role=\"button\"\\n\n                        tabindex=\"0\"\\n\n                        @click=\"toggleEstimateContext('auth')\"\\n\n                        @keydown.enter.prevent=\"toggleEstimateContext('auth')\"\\n\n                        @keydown.space.prevent=\"toggleEstimateContext('auth')\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"approval\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Approval</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">n/a</span>\\n\n                                                                                            </span>\\n\n                                                                                        <span class=\"d-block small text-secondary mt-1\">Authorization</span>\\n\n                                                    </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Customer approval</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Scopes</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">0</span>\\n\n                    </span>\\n\n                            </span>\\n\n                    </span>\\n\n    </span>\\n\n                </div>\\n\n            </div>\\n\n            </div>\\n\n</div>\\n\n</div>\\n\n\\n\n                    <div class=\"mb-0\" id=\"estimate-context-rail\" data-estimate-context>\\n\n    \\n\n    <div\\n\n        id=\"authorization-rail\"\\n\n        data-continuity-region=\"authorization-record\"\\n\n        class=\"card card-sm mt-2\"\\n\n        x-show=\"estimateContext === 'auth'\"\\n\n        x-cloak\\n\n    >\\n\n        <div class=\"card-body\">\\n\n            <div id=\"authorization-rail-panel\" data-authorization-panel>\\n\n    \\n\n    <div class=\"card-header\">\\n\n        <h3 class=\"card-title\">Customer Authorization</h3>\\n\n    </div>\\n\n\\n\n    <div\\n\n            id=\"authorization-record-1\"\\n\n            class=\"card-body\"\\n\n            data-authorization-record\\n\n        >\\n\n            <div class=\"subheader\">Record approval</div>\\n\n            <p class=\"small text-secondary mb-3\">\\n\n                                    There is no recommended work to authorize. Deferred and declined work stays as it is.\\n\n                            </p>\\n\n\\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/authorization\"\\n\n                data-worksheet-continuity\\n\n                data-refresh-scope=\"auth\"\\n\n                data-saving-label=\"Recording authorization\u2026\"\\n\n                data-continuity-focus=\"#financial-rail button[type='submit']\"\\n\n                @submit.prevent=\"window.arkWorksheetFormSubmit($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                \\n\n                <div class=\"mb-3\">\\n\n                    <label class=\"form-label\" for=\"authorization-source-1\">Method</label>\\n\n                    <select id=\"authorization-source-1\" name=\"source\" required class=\"form-select\">\\n\n                                                    <option value=\"phone\" >Phone</option>\\n\n                                                    <option value=\"sms\" >SMS</option>\\n\n                                                    <option value=\"portal\" >Portal</option>\\n\n                                                    <option value=\"email\" >Email</option>\\n\n                                                    <option value=\"in_person\" selected>In person</option>\\n\n                                            </select>\\n\n                </div>\\n\n\\n\n                <div class=\"mb-3\">\\n\n                    <label class=\"form-label\" for=\"authorization-approved-by-1\">Approved by</label>\\n\n                    <input\\n\n                        id=\"authorization-approved-by-1\"\\n\n                        type=\"text\"\\n\n                        name=\"approved_by\"\\n\n                        value=\"Landing Customer\"\\n\n                        required\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                </div>\\n\n\\n\n                <div class=\"mb-3\">\\n\n                    <label class=\"form-label\" for=\"authorization-approved-amount-1\">Authorized amount</label>\\n\n                    <p class=\"small mb-2\" data-authorization-scope-total>\\n\n                        Work this approval records: <span class=\"fw-medium ark-money\">$0.00</span>\\n\n                    </p>\\n\n                    <input\\n\n                        id=\"authorization-approved-amount-1\"\\n\n                        type=\"text\"\\n\n                        name=\"approved_amount\"\\n\n                        value=\"0.00\"\\n\n                        inputmode=\"decimal\"\\n\n                        class=\"form-control ark-money \"\\n\n                        placeholder=\"0.00\"\\n\n                        data-authorization-required-amount=\"0.00\"\\n\n                    >\\n\n                    <div class=\"form-hint\">\\n\n                        Must match the work total above. Changing this number does not authorize a partial labor or part line \u2014 defer or decline concerns (or split lines) first.\\n\n                                                    Defaults to the approved scope total when left blank.\\n\n                                            </div>\\n\n                                    </div>\\n\n\\n\n                <div class=\"mb-3\">\\n\n                    <label class=\"form-label\" for=\"authorization-notes-1\">Notes</label>\\n\n                    <textarea id=\"authorization-notes-1\" name=\"notes\" rows=\"2\" class=\"form-control\" placeholder=\"Optional authorization notes\"></textarea>\\n\n                </div>\\n\n\\n\n                \\n\n                <button type=\"submit\" class=\"btn btn-primary w-100\">\\n\n                    Record approval\\n\n                </button>\\n\n            </form>\\n\n        </div>\\n\n    \\n\n    <div class=\"card-body border-top pb-2\">\\n\n        <div class=\"subheader\">Authorization History</div>\\n\n    </div>\\n\n    <div class=\"list-group list-group-flush\" data-authorization-history>\\n\n                    <div class=\"list-group-item small text-secondary\">\\n\n                No customer approval has been recorded yet. Record approval once for the recommended work on this estimate.\\n\n            </div>\\n\n            </div>\\n\n</div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div\\n\n        id=\"customer-view\"\\n\n        class=\"card card-sm mt-2\"\\n\n        x-show=\"estimateContext === 'portal'\"\\n\n        x-cloak\\n\n    >\\n\n        <div class=\"card-body\">\\n\n            <div id=\"portal-rail\" data-portal-panel>\\n\n    <div class=\"card-header\">\\n\n        <div>\\n\n            <h3 class=\"card-title\">Customer Portal</h3>\\n\n            <p class=\"card-subtitle\">Copy customer links, preview estimate, inspection, and payment portals, and review real portal engagement for this repair order.</p>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card-body small text-secondary\" data-portal-link=\"estimate\">Add estimate lines before sharing a portal link.</div>\\n\n    \\n\n    <div class=\"card-body small text-secondary\" data-portal-link=\"inspection\">Record inspection findings before sharing a portal link.</div>\\n\n    \\n\n    \\n\n    <section class=\"card-body\" data-portal-activity>\\n\n        <div class=\"subheader\">Portal activity</div>\\n\n        <p class=\"small text-secondary mb-2\">Vehicle records, documents, and portal navigation - not estimate sends or estimate link opens.</p>\\n\n        <div class=\"list-group\">\\n\n                            <div class=\"list-group-item small text-secondary\">No customer portal engagement recorded for this repair order yet.</div>\\n\n                    </div>\\n\n    </section>\\n\n</div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    </div>\\n\n\\n\n                    \\n\n                    \\n\n                                        \\n\n                                            \\n\n                    \\n\n                    <div\\n\n    \\n\n    id=\"workspace-modal-host\"\\n\n    data-workspace-modal-open=\"0\"\\n\n    x-data=\"arkWorkspaceModal({\\n\n        initialTask: null,\\n\n        initialContext: [],\\n\n    })\"\\n\n    @keydown.escape.window=\"onEscape()\"\\n\n    @keydown.tab=\"trapFocus($event)\"\\n\n>\\n\n    <div x-show=\"open\" x-cloak data-workspace-modal-overlay>\\n\n        <div class=\"modal-backdrop show\" data-workspace-modal-static-backdrop></div>\\n\n        <div\\n\n            class=\"modal d-block\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            data-bs-backdrop=\"static\"\\n\n            data-bs-keyboard=\"false\"\\n\n            :aria-labelledby=\"open ? 'ops-workspace-modal-title' : null\"\\n\n            @keydown.escape.stop=\"onEscape()\"\\n\n        >\\n\n            <div\\n\n                x-ref=\"dialog\"\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header\">\\n\n                        <div class=\"overflow-hidden\">\\n\n                            <h2 id=\"ops-workspace-modal-title\" class=\"modal-title\" x-text=\"title()\"></h2>\\n\n                            <div class=\"small text-secondary\" x-show=\"helper()\" x-text=\"helper()\"></div>\\n\n                        </div>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close\" :disabled=\"saving || saved\" @click=\"requestClose()\"></button>\\n\n                    </div>\\n\n\\n\n                    <div id=\"workspace-modal-body\" class=\"modal-body\">\\n\n                        <div data-workspace-modal-panel x-show=\"task === 'add-work'\" x-cloak>\\n\n            <fieldset class=\"form-selectgroup form-selectgroup-boxes d-flex flex-column\" data-workspace-add-work-chooser>\\n\n                <legend class=\"visually-hidden\">What would you like to add?</legend>\\n\n                                    <label class=\"form-selectgroup-item flex-fill\">\\n\n                        <input\\n\n                            type=\"radio\"\\n\n                            class=\"form-selectgroup-input\"\\n\n                            name=\"add_work_choice\"\\n\n                            value=\"concern\"\\n\n                            x-model=\"addWorkChoice\"\\n\n                        >\\n\n                        <span class=\"form-selectgroup-label d-flex align-items-center p-3 text-start\">\\n\n                            <span class=\"me-3\">\\n\n                                <span class=\"form-selectgroup-check\"></span>\\n\n                            </span>\\n\n                            <span>\\n\n                                <span class=\"d-block fw-bold text-body\">Customer Concern</span>\\n\n                                <span class=\"d-block small text-secondary\">The problem or request the customer brought in.</span>\\n\n                            </span>\\n\n                        </span>\\n\n                    </label>\\n\n                                    <label class=\"form-selectgroup-item flex-fill\">\\n\n                        <input\\n\n                            type=\"radio\"\\n\n                            class=\"form-selectgroup-input\"\\n\n                            name=\"add_work_choice\"\\n\n                            value=\"oil\"\\n\n                            x-model=\"addWorkChoice\"\\n\n                        >\\n\n                        <span class=\"form-selectgroup-label d-flex align-items-center p-3 text-start\">\\n\n                            <span class=\"me-3\">\\n\n                                <span class=\"form-selectgroup-check\"></span>\\n\n                            </span>\\n\n                            <span>\\n\n                                <span class=\"d-block fw-bold text-body\">Engine Oil Service</span>\\n\n                                <span class=\"d-block small text-secondary\">Authorize a maintenance oil package for this vehicle.</span>\\n\n                            </span>\\n\n                        </span>\\n\n                    </label>\\n\n                                    <label class=\"form-selectgroup-item flex-fill\">\\n\n                        <input\\n\n                            type=\"radio\"\\n\n                            class=\"form-selectgroup-input\"\\n\n                            name=\"add_work_choice\"\\n\n                            value=\"testing\"\\n\n                            x-model=\"addWorkChoice\"\\n\n                        >\\n\n                        <span class=\"form-selectgroup-label d-flex align-items-center p-3 text-start\">\\n\n                            <span class=\"me-3\">\\n\n                                <span class=\"form-selectgroup-check\"></span>\\n\n                            </span>\\n\n                            <span>\\n\n                                <span class=\"d-block fw-bold text-body\">Testing Package</span>\\n\n                                <span class=\"d-block small text-secondary\">Authorize diagnostic or inspection testing.</span>\\n\n                            </span>\\n\n                        </span>\\n\n                    </label>\\n\n                                    <label class=\"form-selectgroup-item flex-fill\">\\n\n                        <input\\n\n                            type=\"radio\"\\n\n                            class=\"form-selectgroup-input\"\\n\n                            name=\"add_work_choice\"\\n\n                            value=\"saved-work\"\\n\n                            x-model=\"addWorkChoice\"\\n\n                        >\\n\n                        <span class=\"form-selectgroup-label d-flex align-items-center p-3 text-start\">\\n\n                            <span class=\"me-3\">\\n\n                                <span class=\"form-selectgroup-check\"></span>\\n\n                            </span>\\n\n                            <span>\\n\n                                <span class=\"d-block fw-bold text-body\">Common Job</span>\\n\n                                <span class=\"d-block small text-secondary\">Add a common job from a shop template - labor, parts, and fees in one step.</span>\\n\n                            </span>\\n\n                        </span>\\n\n                    </label>\\n\n                            </fieldset>\\n\n        </div>\\n\n        \\n\n                \\n\n        <div data-workspace-modal-panel x-show=\"task === 'concern'\" x-cloak>\\n\n            <div id=\"concern-store\">\\n\n                <form\\n\n    method=\"POST\"\\n\n    action=\"http://localhost/app/repair-orders/1/concerns\"\\n\n    id=\"concern-store-form\"\\n\n    data-continuity-region=\"composer\"\\n\n    data-worksheet-continuity\\n\n    data-refresh-scope=\"worksheet\"\\n\n    data-continuity-focus=\"#concern-store [name='summary']\"\\n\n    data-saving-label=\"Saving\u2026\"\\n\n     data-workspace-modal-form=\"concern\"     @submit=\"onFormSubmit()\"\\n\n    @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    x-data=\"arkScopeEntryIntake(JSON.parse('{\\u0022suggestUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/concerns\\\\\\/vocabulary-suggest\\u0022,\\u0022suggestMode\\u0022:\\u0022vocabulary\\u0022,\\u0022defaultEntryKind\\u0022:\\u0022customer_requested\\u0022,\\u0022eventUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/shop-memory\\\\\\/suggestion-events\\u0022,\\u0022rewriteUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/ai-rewrite\\u0022,\\u0022aiRewriteEnabled\\u0022:false,\\u0022repairOrderId\\u0022:1,\\u0022surface\\u0022:\\u0022add_concern\\u0022,\\u0022priorVisits\\u0022:[]}'))\"\\n\n    x-init=\"init()\"\\n\n    x-cloak\\n\n>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">    <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n    <input type=\"hidden\" name=\"scope_entry_kind\" :value=\"entryKind || ''\">\\n\n    <input type=\"hidden\" name=\"scope_entry_concept_id\" :value=\"selectedConceptId || ''\">\\n\n    <input type=\"hidden\" name=\"observed_summary\" :value=\"observedSummary || summary\">\\n\n\\n\n    \\n\n    <div>\\n\n                <label class=\"visually-hidden\" for=\"scope-entry-summary\">Add concern</label>\\n\n        <div class=\"position-relative\">\\n\n            <textarea\\n\n                id=\"scope-entry-summary\"\\n\n                name=\"summary\"\\n\n                required\\n\n                rows=\"3\"\\n\n                autocomplete=\"off\"\\n\n                spellcheck=\"true\"\\n\n                maxlength=\"2000\"\\n\n                class=\"form-control\"\\n\n                placeholder=\"e.g. Front brakes grinding, Check engine light, Oil change\"\\n\n                x-model=\"summary\"\\n\n                x-ref=\"summaryInput\"\\n\n                @keydown=\"handleKeydown($event)\"\\n\n                @input.debounce.150ms=\"handleSummaryInput()\"\\n\n                @focus=\"fetchSuggestions()\"\\n\n                            ></textarea>\\n\n            <div\\n\n                class=\"dropdown-menu w-100 top-100 start-0 mt-1\"\\n\n                :class=\"{ show: mentionOpen && mentionMatches.length > 0 }\"\\n\n                role=\"listbox\"\\n\n                aria-label=\"Previous visits\"\\n\n                data-scope-entry-mentions\\n\n            >\\n\n                <template x-for=\"(row, index) in mentionMatches\" :key=\"row.number\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item flex-column align-items-start text-wrap\"\\n\n                        :class=\"{ active: index === mentionActiveIndex }\"\\n\n                        role=\"option\"\\n\n                        @mousedown.prevent=\"choosePriorVisit(row)\"\\n\n                    >\\n\n                        <span class=\"fw-medium\" x-text=\"row.label\"></span>\\n\n                        <span class=\"small text-secondary\" x-text=\"row.detail\"></span>\\n\n                    </button>\\n\n                </template>\\n\n            </div>\\n\n            <div\\n\n                class=\"dropdown-menu w-100 top-100 start-0 mt-1 overflow-auto\"\\n\n                style=\"max-height: 20rem\"\\n\n                :class=\"{ show: suggestionsOpen && hasMatches }\"\\n\n                @click.outside=\"suggestionsOpen = false; activeSuggestionIndex = -1\"\\n\n                role=\"listbox\"\\n\n                aria-label=\"Shop Memory suggestions\"\\n\n                data-scope-entry-suggestions\\n\n            >\\n\n                <template x-if=\"featured?.summary\">\\n\n                    <div>\\n\n                        <h6 class=\"dropdown-header\">Most common at your shop</h6>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"dropdown-item text-wrap fw-medium\"\\n\n                            :class=\"{ active: isSuggestionActive(featured.entry_kind, featured.summary) }\"\\n\n                            @click=\"chooseSuggestion(featured.entry_kind, featured.summary, featured.concept_id, featured.suggestion_id, featured.provider)\"\\n\n                        >\\n\n                            <span\\n\n                                class=\"me-1\"\\n\n                                x-show=\"isSuggestionActive(featured.entry_kind, featured.summary)\"\\n\n                                aria-hidden=\"true\"\\n\n                            >\u2713</span>\\n\n                            <span x-text=\"featured.summary\"></span>\\n\n                        </button>\\n\n                    </div>\\n\n                </template>\\n\n\\n\n                <template x-for=\"group in suggestionGroups\" :key=\"group.entry_kind\">\\n\n                    <div>\\n\n                        <h6 class=\"dropdown-header\" x-text=\"group.label\"></h6>\\n\n                        <ul class=\"list-unstyled mb-0\">\\n\n                            <template x-for=\"row in group.suggestions\" :key=\"suggestionKey(group.entry_kind, typeof row === 'string' ? row : row.summary)\">\\n\n                                <li role=\"option\" :aria-selected=\"isSuggestionActive(group.entry_kind, typeof row === 'string' ? row : row.summary)\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"dropdown-item text-wrap\"\\n\n                                        :class=\"{ active: isSuggestionActive(group.entry_kind, typeof row === 'string' ? row : row.summary) }\"\\n\n                                        @click=\"chooseSuggestion(group.entry_kind, typeof row === 'string' ? row : row.summary, typeof row === 'object' ? row.concept_id : null, typeof row === 'object' ? row.suggestion_id : null, typeof row === 'object' ? row.provider : null)\"\\n\n                                    >\\n\n                                        <span\\n\n                                            class=\"me-1\"\\n\n                                            x-show=\"isSuggestionActive(group.entry_kind, typeof row === 'string' ? row : row.summary)\"\\n\n                                            aria-hidden=\"true\"\\n\n                                        >\u2713</span>\\n\n                                        <span x-text=\"typeof row === 'string' ? row : row.summary\"></span>\\n\n                                    </button>\\n\n                                </li>\\n\n                            </template>\\n\n                        </ul>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n                        \\n\n                    <template x-if=\"aiRewriteEnabled\">\\n\n                <div class=\"mt-3\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"btn\"\\n\n                        @click=\"rewriteSummary()\"\\n\n                        :disabled=\"! summary.trim() || rewriting\"\\n\n                    >\\n\n                        <span x-text=\"rewriting ? 'Rewriting\u2026' : 'Rewrite'\"></span>\\n\n                    </button>\\n\n                </div>\\n\n            </template>\\n\n        \\n\n        <p class=\"form-hint mt-2 mb-0\">\\n\n            <span class=\"fw-medium\">Keyboard:</span>\\n\n            <span x-show=\"hasMatches\">Enter fills top match \u00b7 \u2191\u2193 choose \u00b7 Esc dismiss \u00b7 Shift+Enter new line \u00b7 Create Concern saves</span>\\n\n            <span x-show=\"! hasMatches\">Enter or Create Concern continues \u00b7 Shift+Enter new line</span>\\n\n        </p>\\n\n    </div>\\n\n</form>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        \\n\n                                \\n\n            \\n\n                        <div\\n\n                id=\"concern-authoring-line-concern-1\"\\n\n                data-concern-authoring=\"1\"\\n\n                data-workspace-modal-panel\\n\n                x-show=\"['labor','part','sublet','note'].includes(task) && String(context.concernId) === '1' && (context.workGroupId == null || context.workGroupId === '')\"\\n\n                x-cloak\\n\n            >\\n\n                <form\\n\n                    id=\"workspace-line-create-concern-1\"\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/repair-orders/1/lines\"\\n\n                    data-workspace-modal-form=\"line-create\"\\n\n                    data-worksheet-continuity\\n\n                    data-continuity-region=\"composer\"\\n\n                    data-refresh-scope=\"worksheet\"\\n\n                    data-saving-label=\"Saving\u2026\"\\n\n                    @submit.prevent=\"submitLine($event)\"\\n\n                    x-data=\"arkPartPricing({ type: '', concernSummary: 'Check engine light', pricingMode: 'matrix', defaultPricingMode: 'matrix', defaultPartSell: '', matrixKey: '', explicitMatrix: false, cost: '', sell: '', sellEdited: false, defaultLaborRate: '165.00', laborCategories: JSON.parse('[{\\u0022key\\u0022:\\u0022comeback\\u0022,\\u0022name\\u0022:\\u0022Comeback\\u0022,\\u0022rate_cents\\u0022:0,\\u0022minimum_hours\\u0022:\\u00220.00\\u0022,\\u0022rounding_rule\\u0022:\\u0022tenth\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:true,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022courtesy\\u0022,\\u0022name\\u0022:\\u0022Courtesy\\u0022,\\u0022rate_cents\\u0022:0,\\u0022minimum_hours\\u0022:\\u00220.00\\u0022,\\u0022rounding_rule\\u0022:\\u0022tenth\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:true,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022diagnostic\\u0022,\\u0022name\\u0022:\\u0022Diagnostic\\u0022,\\u0022rate_cents\\u0022:16500,\\u0022minimum_hours\\u0022:\\u00221.00\\u0022,\\u0022rounding_rule\\u0022:\\u0022quarter\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:true,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022fabrication\\u0022,\\u0022name\\u0022:\\u0022Fabrication\\u0022,\\u0022rate_cents\\u0022:16500,\\u0022minimum_hours\\u0022:\\u00220.50\\u0022,\\u0022rounding_rule\\u0022:\\u0022quarter\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:true,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022mechanical\\u0022,\\u0022name\\u0022:\\u0022Mechanical\\u0022,\\u0022rate_cents\\u0022:16500,\\u0022minimum_hours\\u0022:\\u00220.50\\u0022,\\u0022rounding_rule\\u0022:\\u0022quarter\\u0022,\\u0022is_default\\u0022:true,\\u0022allows_modifiers\\u0022:true,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022programming\\u0022,\\u0022name\\u0022:\\u0022Programming\\u0022,\\u0022rate_cents\\u0022:16500,\\u0022minimum_hours\\u0022:\\u00220.50\\u0022,\\u0022rounding_rule\\u0022:\\u0022quarter\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:true,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022repairpal\\u0022,\\u0022name\\u0022:\\u0022RepairPal\\u0022,\\u0022rate_cents\\u0022:15000,\\u0022minimum_hours\\u0022:\\u00221.00\\u0022,\\u0022rounding_rule\\u0022:\\u0022quarter\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:false,\\u0022is_active\\u0022:true},{\\u0022key\\u0022:\\u0022warranty-other\\u0022,\\u0022name\\u0022:\\u0022Warranty - Other\\u0022,\\u0022rate_cents\\u0022:16500,\\u0022minimum_hours\\u0022:\\u00221.00\\u0022,\\u0022rounding_rule\\u0022:\\u0022quarter\\u0022,\\u0022is_default\\u0022:false,\\u0022allows_modifiers\\u0022:false,\\u0022is_active\\u0022:true}]'), defaultLaborCategoryKey: 'mechanical', laborCategoryKey: 'mechanical', laborEnteredHours: '1.00', laborAdjustment: 'normal', laborCustomFactor: '1.25', laborReason: '', laborReasonCustom: '', laborHoursOverridden: false, laborFinalHours: '1.00', laborOverrideReason: '', laborRateOverrideReason: '', laborAdjustExpanded: false }, partsMatrices, 'aft-parts', 'http://localhost/app/repair-orders/1/lines/pricing-preview')\"\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                    <input type=\"hidden\" name=\"repair_order_concern_id\" value=\"1\">\\n\n                    <input type=\"hidden\" name=\"type\" x-model=\"type\">\\n\n                    \\n\n                                        <template x-if=\"hasLineType() && type !== 'part'\">\\n\n                        <div class=\"mb-2\" data-line-entry-panel=\"simple\">\\n\n                            <div class=\"d-flex flex-column gap-3\" data-line-entry-simple :data-line-entry-type=\"type\">\\n\n            <label class=\"d-block\">\\n\n            <span class=\"form-label\" x-text=\"descriptionFieldLabel()\"></span>\\n\n            <template x-if=\"type === 'note'\">\\n\n                <textarea\\n\n                    name=\"description\"\\n\n                    rows=\"4\"\\n\n                    required\\n\n                    :placeholder=\"descriptionPlaceholder()\"\\n\n                    class=\"form-control\"\\n\n                ></textarea>\\n\n            </template>\\n\n                            <template x-if=\"type === 'labor'\">\\n\n                    <div\\n\n                        class=\"position-relative\"\\n\n                        data-labor-memory\\n\n                        x-data=\"arkLaborMemorySuggest(JSON.parse('{\\u0022suggestUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/labor-memory-suggest\\u0022,\\u0022eventUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/shop-memory\\\\\\/suggestion-events\\u0022,\\u0022repairOrderId\\u0022:1,\\u0022surface\\u0022:\\u0022labor_entry\\u0022}'), '')\"\\n\n                    >\\n\n                        <input\\n\n                            name=\"description\"\\n\n                            x-model=\"description\"\\n\n                            x-ref=\"descriptionInput\"\\n\n                            required\\n\n                            autocomplete=\"off\"\\n\n                            spellcheck=\"false\"\\n\n                            placeholder=\"Labor description\"\\n\n                            class=\"form-control\"\\n\n                            @input.debounce.150ms=\"handleInput()\"\\n\n                            @keydown=\"handleKeydown($event)\"\\n\n                            @focus=\"handleFocus()\"\\n\n                            @blur=\"handleBlur()\"\\n\n                        >\\n\n                        <div\\n\n                            class=\"dropdown-menu w-100 top-100 start-0 mt-1\"\\n\n                            :class=\"{ show: suggestionsOpen && hasMatches }\"\\n\n                            @click.outside=\"closeSuggestions()\"\\n\n                            role=\"listbox\"\\n\n                            aria-label=\"Shop labor language\"\\n\n                        >\\n\n                            <template x-for=\"(row, index) in suggestions\" :key=\"row.id || row.text\">\\n\n                                <div role=\"option\" :aria-selected=\"index === activeIndex\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"dropdown-item text-wrap\"\\n\n                                        :class=\"{ active: index === activeIndex }\"\\n\n                                        @mousedown.prevent=\"chooseSuggestion(row)\"\\n\n                                    >\\n\n                                        <span x-text=\"row.text\"></span>\\n\n                                    </button>\\n\n                                </div>\\n\n                            </template>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n                <template x-if=\"type !== 'note' && type !== 'labor'\">\\n\n                    <input\\n\n                        name=\"description\"\\n\n                        value=\"\"\\n\n                        required\\n\n                        :placeholder=\"descriptionPlaceholder()\"\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                </template>\\n\n                    </label>\\n\n    \\n\n    <template x-if=\"type !== 'note' && type === 'labor'\">\\n\n        <div class=\"d-flex flex-column gap-2\" data-labor-authority>\\n\n    <div class=\"row g-2\">\\n\n        <label class=\"col-6\">\\n\n            <span class=\"form-label\">Book hours</span>\\n\n            <input\\n\n                name=\"labor_entered_hours\"\\n\n                x-model=\"laborEnteredHours\"\\n\n                @input=\"onLaborAuthorityInput()\"\\n\n                required\\n\n                inputmode=\"decimal\"\\n\n                placeholder=\"1.50\"\\n\n                class=\"form-control text-end ark-money\"\\n\n            >\\n\n        </label>\\n\n        <label class=\"col-6\">\\n\n            <span class=\"form-label\">Billable hours</span>\\n\n            <input\\n\n                name=\"quantity\"\\n\n                x-model=\"laborFinalHours\"\\n\n                @input=\"onLaborFinalHoursInput()\"\\n\n                required\\n\n                inputmode=\"decimal\"\\n\n                :readonly=\"! laborCategoryAllowsModifiers()\"\\n\n                class=\"form-control text-end ark-money\"\\n\n                :class=\"! laborCategoryAllowsModifiers() ? 'bg-secondary-lt' : ''\"\\n\n            >\\n\n        </label>\\n\n    </div>\\n\n\\n\n    <div class=\"row g-2\">\\n\n        <label class=\"col-6\">\\n\n            <span class=\"form-label\">Rate ($/hr)</span>\\n\n            <input\\n\n                name=\"unit_price\"\\n\n                x-model=\"sell\"\\n\n                @input=\"onSellInput(); onLaborAuthorityInput(); syncLaborChargeFromRate()\"\\n\n                required\\n\n                inputmode=\"decimal\"\\n\n                placeholder=\"165.00\"\\n\n                :readonly=\"! laborCategoryAllowsModifiers() || laborChargeEdited\"\\n\n                class=\"form-control text-end ark-money\"\\n\n                :class=\"(! laborCategoryAllowsModifiers() || laborChargeEdited) ? 'bg-secondary-lt' : ''\"\\n\n            >\\n\n        </label>\\n\n        <label class=\"col-6\">\\n\n            <span class=\"form-label\">Labor category</span>\\n\n            <select\\n\n                name=\"labor_category_key\"\\n\n                x-model=\"laborCategoryKey\"\\n\n                @change=\"onLaborCategoryChange()\"\\n\n                required\\n\n                class=\"form-select\"\\n\n            >\\n\n                                    <option\\n\n                        value=\"comeback\"\\n\n                                            >Comeback</option>\\n\n                                    <option\\n\n                        value=\"courtesy\"\\n\n                                            >Courtesy</option>\\n\n                                    <option\\n\n                        value=\"diagnostic\"\\n\n                                            >Diagnostic</option>\\n\n                                    <option\\n\n                        value=\"fabrication\"\\n\n                                            >Fabrication</option>\\n\n                                    <option\\n\n                        value=\"mechanical\"\\n\n                                            >Mechanical</option>\\n\n                                    <option\\n\n                        value=\"programming\"\\n\n                                            >Programming</option>\\n\n                                    <option\\n\n                        value=\"repairpal\"\\n\n                                            >RepairPal</option>\\n\n                                    <option\\n\n                        value=\"warranty-other\"\\n\n                                            >Warranty - Other</option>\\n\n                            </select>\\n\n        </label>\\n\n    </div>\\n\n\\n\n    <div class=\"row g-2\">\\n\n        <label class=\"col-6\">\\n\n            <span class=\"form-label\">Labor charge ($)</span>\\n\n            <input\\n\n                name=\"labor_charge\"\\n\n                x-model=\"laborCharge\"\\n\n                @input=\"onLaborChargeInput()\"\\n\n                required\\n\n                inputmode=\"decimal\"\\n\n                placeholder=\"90.00\"\\n\n                :readonly=\"! laborCategoryAllowsModifiers()\"\\n\n                class=\"form-control text-end ark-money\"\\n\n                data-labor-charge\\n\n                :class=\"! laborCategoryAllowsModifiers() ? 'bg-secondary-lt' : ''\"\\n\n            >\\n\n        </label>\\n\n        <div class=\"col-6 d-flex flex-column justify-content-end gap-1 pb-1\">\\n\n            <span class=\"small\" x-show=\"laborChargeEdited\" x-cloak>\\n\n                <span class=\"badge bg-azure-lt text-azure\">Manual amount</span>\\n\n            </span>\\n\n            <span class=\"small text-secondary\" x-show=\"! laborChargeEdited\" x-cloak>Calculated from hours \u00d7 rate</span>\\n\n            <button\\n\n                type=\"button\"\\n\n                x-show=\"laborCategoryAllowsModifiers() && laborChargeEdited\"\\n\n                x-cloak\\n\n                class=\"btn btn-link btn-sm p-0 align-self-start\"\\n\n                data-use-calculated-labor-charge\\n\n                @click=\"useCalculatedLaborCharge()\"\\n\n            >Use calculated price</button>\\n\n        </div>\\n\n    </div>\\n\n    <input type=\"hidden\" name=\"labor_charge_overridden\" :value=\"laborChargeEdited && laborCategoryAllowsModifiers() ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"use_calculated_labor_charge\" :value=\"useCalculatedLaborChargeFlag ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"pricing_mode\" :value=\"laborChargeEdited ? 'manual' : ''\">\\n\n\\n\n    <p\\n\n        x-show=\"! laborCategoryAllowsModifiers()\"\\n\n        x-cloak\\n\n        class=\"form-hint mb-0\"\\n\n    >Program category - book hours and category rate apply. Adjust labor is hidden here so program billing stays clean.</p>\\n\n\\n\n    <input type=\"hidden\" name=\"labor_rate_overridden\" :value=\"sellEdited && laborCategoryAllowsModifiers() ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"reprice_labor\" :value=\"repriceLabor ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"labor_hours_overridden\" :value=\"laborHoursOverridden ? '1' : '0'\">\\n\n\\n\n    <div class=\"d-flex flex-wrap align-items-center gap-3 small\">\\n\n        <button\\n\n            type=\"button\"\\n\n            x-show=\"laborCategoryAllowsModifiers() && laborCanBillEnteredHours()\"\\n\n            x-cloak\\n\n            class=\"btn btn-link btn-sm p-0\"\\n\n            @click=\"billEnteredHours()\"\\n\n        >Bill book hours (<span x-text=\"laborEnteredHours\"></span>)</button>\\n\n        <button\\n\n            type=\"button\"\\n\n            x-show=\"laborCategoryAllowsModifiers() && laborHoursOverridden\"\\n\n            x-cloak\\n\n            class=\"btn btn-link btn-sm p-0\"\\n\n            @click=\"useCalculatedLaborHours()\"\\n\n        >Use calculated hours</button>\\n\n        <button\\n\n            type=\"button\"\\n\n            x-show=\"! laborChargeEdited && laborRateDiffersFromPolicy()\"\\n\n            x-cloak\\n\n            class=\"btn btn-link btn-sm p-0\"\\n\n            data-use-policy-labor-rate\\n\n            @click=\"usePolicyLaborRate()\"\\n\n        >Use policy rate ($<span x-text=\"laborPolicyRate()\"></span>)</button>\\n\n        <button\\n\n            type=\"button\"\\n\n            x-show=\"laborCategoryAllowsModifiers()\"\\n\n            x-cloak\\n\n            class=\"btn btn-link btn-sm p-0\"\\n\n            @click=\"toggleLaborAdjustExpanded()\"\\n\n            :aria-expanded=\"laborAdjustExpanded\"\\n\n            x-text=\"laborAdjustExpanded ? 'Hide difficulty adjustment' : 'Adjust difficulty'\"\\n\n        ></button>\\n\n        <span\\n\n            x-show=\"laborMinimumMessage()\"\\n\n            x-cloak\\n\n            class=\"text-warning fw-medium\"\\n\n            x-text=\"laborMinimumMessage()\"\\n\n        ></span>\\n\n        <span\\n\n            x-show=\"laborRoundingMessage()\"\\n\n            x-cloak\\n\n            class=\"text-warning fw-medium\"\\n\n            x-text=\"laborRoundingMessage()\"\\n\n        ></span>\\n\n    </div>\\n\n\\n\n    <label class=\"d-block\" x-show.important=\"laborHoursOverridden && laborCategoryAllowsModifiers()\" x-cloak>\\n\n        <span class=\"form-label\">Hours override reason</span>\\n\n        <input\\n\n            name=\"labor_override_reason\"\\n\n            x-model=\"laborOverrideReason\"\\n\n            :required=\"laborHoursOverridden\"\\n\n            placeholder=\"Why billable hours differ from category rules\"\\n\n            class=\"form-control\"\\n\n        >\\n\n    </label>\\n\n\\n\n    <div x-show=\"sellEdited && ! laborChargeEdited && laborCategoryAllowsModifiers()\" x-cloak>\\n\n        <p class=\"small text-warning fw-medium mb-1\">\\n\n            Custom rate - choose a reason before saving (e.g. Menu / package price for a $199 PPI).\\n\n        </p>\\n\n        <label class=\"d-block\">\\n\n            <span class=\"form-label\">Rate override reason</span>\\n\n            <select\\n\n                name=\"labor_rate_override_reason\"\\n\n                x-model=\"laborRateOverrideReason\"\\n\n                :required=\"sellEdited && ! laborChargeEdited && laborCategoryAllowsModifiers()\"\\n\n                class=\"form-select\"\\n\n            >\\n\n                <option value=\"\">Select reason</option>\\n\n                                    <option value=\"competitive_match\">Competitive Match</option>\\n\n                                    <option value=\"menu_or_package\">Menu / package price</option>\\n\n                                    <option value=\"customer_goodwill\">Customer Goodwill</option>\\n\n                                    <option value=\"management_approval\">Management Approval</option>\\n\n                                    <option value=\"other\">Other</option>\\n\n                            </select>\\n\n                    </label>\\n\n    </div>\\n\n\\n\n    <div x-show=\"laborAdjustExpanded && laborCategoryAllowsModifiers()\" x-cloak>\\n\n        <div class=\"d-flex flex-column gap-3 border-top pt-3\">\\n\n            <div class=\"row g-2\">\\n\n                <label class=\"col-6\">\\n\n                    <span class=\"form-label\">Difficulty</span>\\n\n                    <select\\n\n                        name=\"labor_adjustment\"\\n\n                        x-model=\"laborAdjustment\"\\n\n                        @change=\"onLaborAuthorityInput()\"\\n\n                        :disabled=\"!laborAdjustExpanded\"\\n\n                        class=\"form-select\"\\n\n                    >\\n\n                                                    <option value=\"normal\">Normal (0%)</option>\\n\n                                                    <option value=\"difficult\">Difficult (+25%)</option>\\n\n                                                    <option value=\"severe\">Severe (+50%)</option>\\n\n                                                    <option value=\"custom\">Custom</option>\\n\n                                            </select>\\n\n                </label>\\n\n                <label class=\"col-6\" x-show=\"laborAdjustment === 'custom'\" x-cloak>\\n\n                    <span class=\"form-label\">Custom factor</span>\\n\n                    <input\\n\n                        name=\"labor_adjustment_factor\"\\n\n                        x-model=\"laborCustomFactor\"\\n\n                        @input=\"onLaborAuthorityInput()\"\\n\n                        inputmode=\"decimal\"\\n\n                        placeholder=\"1.35\"\\n\n                        :disabled=\"!laborAdjustExpanded || laborAdjustment !== 'custom'\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n            </div>\\n\n\\n\n            <div x-show=\"laborAdjustmentRequiresReason()\" x-cloak>\\n\n                <div class=\"row g-2\">\\n\n                    <label class=\"col-6\">\\n\n                        <span class=\"form-label\">Adjustment reason</span>\\n\n                        <select\\n\n                            name=\"labor_adjustment_reason\"\\n\n                            x-model=\"laborReason\"\\n\n                            @change=\"onLaborAuthorityInput()\"\\n\n                            :disabled=\"!laborAdjustExpanded || !laborAdjustmentRequiresReason()\"\\n\n                            class=\"form-select\"\\n\n                        >\\n\n                            <option value=\"\">Select reason</option>\\n\n                                                            <option value=\"corrosion\">Corrosion</option>\\n\n                                                            <option value=\"previous_repairs\">Previous Repairs</option>\\n\n                                                            <option value=\"modified_vehicle\">Modified Vehicle</option>\\n\n                                                            <option value=\"high_disassembly\">High Disassembly</option>\\n\n                                                            <option value=\"access_difficulty\">Access Difficulty</option>\\n\n                                                            <option value=\"heavy_diagnostics\">Heavy Diagnostics</option>\\n\n                                                            <option value=\"custom\">Custom</option>\\n\n                                                    </select>\\n\n                    </label>\\n\n                    <label class=\"col-6\" x-show=\"laborReason === 'custom'\" x-cloak>\\n\n                        <span class=\"form-label\">Custom reason</span>\\n\n                        <input\\n\n                            name=\"labor_adjustment_reason_custom\"\\n\n                            x-model=\"laborReasonCustom\"\\n\n                            @input=\"onLaborAuthorityInput()\"\\n\n                            placeholder=\"Describe access or difficulty\"\\n\n                            :disabled=\"!laborAdjustExpanded || laborReason !== 'custom'\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                    </label>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <template x-if=\"! laborAdjustExpanded\">\\n\n        <input type=\"hidden\" name=\"labor_adjustment\" :value=\"laborAdjustment\">\\n\n    </template>\\n\n\\n\n    <p\\n\n        x-show=\"laborAuthorityPreview()\"\\n\n        x-cloak\\n\n        class=\"form-hint mb-0\"\\n\n        data-labor-authority-preview\\n\n        x-text=\"laborAuthorityPreview()\"\\n\n    ></p>\\n\n</div>\\n\n    </template>\\n\n\\n\n    <template x-if=\"type === 'sublet'\">\\n\n        <fieldset class=\"form-fieldset mb-0\">\\n\n            <legend class=\"subheader mb-2\" x-text=\"pricingHeading()\"></legend>\\n\n            <div class=\"row g-2\">\\n\n                <label class=\"col-6 col-md-3\">\\n\n                    <span class=\"form-label\">Vendor cost</span>\\n\n                    <input\\n\n                        name=\"part_cost\"\\n\n                        x-model=\"cost\"\\n\n                        @input=\"onSubletCostInput()\"\\n\n                        @blur=\"onCostBlur()\"\\n\n                        inputmode=\"decimal\"\\n\n                        :placeholder=\"costPlaceholder()\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n                <label class=\"col-6 col-md-3\">\\n\n                    <span class=\"form-label\">Markup %</span>\\n\n                    <input\\n\n                        x-model=\"markup\"\\n\n                        @input=\"onSubletMarkupInput()\"\\n\n                        inputmode=\"decimal\"\\n\n                        placeholder=\"e.g. 15\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n                <label class=\"col-6 col-md-3\">\\n\n                    <span class=\"form-label\">Sell price</span>\\n\n                    <input\\n\n                        name=\"unit_price\"\\n\n                        x-model=\"sell\"\\n\n                        @input=\"onSellInput()\"\\n\n                        required\\n\n                        inputmode=\"decimal\"\\n\n                        :placeholder=\"sellPlaceholder()\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n                <label class=\"col-6 col-md-3\">\\n\n                    <span class=\"form-label\" x-text=\"quantityFieldLabel()\"></span>\\n\n                    <input\\n\n                        name=\"quantity\"\\n\n                        value=\"1.00\"\\n\n                        required\\n\n                        inputmode=\"decimal\"\\n\n                        :placeholder=\"quantityPlaceholder()\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n            </div>\\n\n            <p class=\"form-hint mt-2 mb-0\">\\n\n                <span x-text=\"subletPricingGuidance()\"></span>\\n\n                <template x-if=\"marginPercentage\">\\n\n                    <span> \u00b7 Margin <span x-text=\"marginPercentage\"></span>%</span>\\n\n                </template>\\n\n                <template x-if=\"markupPercentage\">\\n\n                    <span> \u00b7 Markup <span x-text=\"markupPercentage\"></span>%</span>\\n\n                </template>\\n\n                <template x-if=\"previewing\">\\n\n                    <span> \u00b7 Checking price\u2026</span>\\n\n                </template>\\n\n            </p>\\n\n        </fieldset>\\n\n    </template>\\n\n\\n\n    <template x-if=\"type !== 'note' && type !== 'labor' && type !== 'sublet'\">\\n\n        <fieldset class=\"form-fieldset mb-0\">\\n\n            <legend class=\"subheader mb-2\" x-text=\"pricingHeading()\"></legend>\\n\n            <div class=\"row g-2\">\\n\n                <label class=\"col-6\">\\n\n                    <span class=\"form-label\" x-text=\"sellFieldLabel()\"></span>\\n\n                    <input\\n\n                        name=\"unit_price\"\\n\n                        x-model=\"sell\"\\n\n                        @input=\"onSellInput()\"\\n\n                        required\\n\n                        inputmode=\"decimal\"\\n\n                        :placeholder=\"sellPlaceholder()\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n                <label class=\"col-6\">\\n\n                    <span class=\"form-label\" x-text=\"quantityFieldLabel()\"></span>\\n\n                    <input\\n\n                        name=\"quantity\"\\n\n                        value=\"1.00\"\\n\n                        required\\n\n                        inputmode=\"decimal\"\\n\n                        :placeholder=\"quantityPlaceholder()\"\\n\n                        class=\"form-control text-end ark-money\"\\n\n                    >\\n\n                </label>\\n\n            </div>\\n\n        </fieldset>\\n\n    </template>\\n\n\\n\n    <template x-if=\"type === 'note'\">\\n\n        <div>\\n\n            <input type=\"hidden\" name=\"type\" value=\"note\">\\n\n            <input type=\"hidden\" name=\"unit_price\" value=\"0\">\\n\n            <input type=\"hidden\" name=\"quantity\" value=\"1\">\\n\n                        <div\\n\n    x-data=\"{\\n\n        advisor: true,\\n\n        technician: false,\\n\n        customer: false,\\n\n        audienceHint: '',\\n\n        _hintTimer: null,\\n\n        guardAudience(which) {\\n\n            if (this.advisor || this.technician || this.customer) {\\n\n                this.audienceHint = '';\\n\n                return;\\n\n            }\\n\n\\n\n            this[which] = true;\\n\n            this.audienceHint = 'Choose another view first, then you can turn this one off.';\\n\n            clearTimeout(this._hintTimer);\\n\n            this._hintTimer = setTimeout(() => { this.audienceHint = ''; }, 4000);\\n\n        }\\n\n    }\"\\n\n    class=\"\"\\n\n    data-note-privacy-field\\n\n>\\n\n    <input type=\"hidden\" name=\"visible_to_advisor\" :value=\"advisor ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"visible_to_technician\" :value=\"technician ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"visible_to_customer\" :value=\"customer ? '1' : '0'\">\\n\n\\n\n        <div class=\"form-label\">Visible to</div>\\n\n    <div class=\"form-selectgroup\">\\n\n                    <label class=\"form-selectgroup-item\" for=\"note-audience-6b05c69349846-advisor\">\\n\n                <input\\n\n                    id=\"note-audience-6b05c69349846-advisor\"\\n\n                    type=\"checkbox\"\\n\n                    x-model=\"advisor\"\\n\n                    x-on:change=\"guardAudience('advisor')\"\\n\n                    class=\"form-selectgroup-input\"\\n\n                >\\n\n                <span class=\"form-selectgroup-label\">\\n\n                    <span class=\"badge bg-green-lt\">Advisor</span>\\n\n                    <span class=\"d-block small text-secondary mt-1\">Repair Order</span>\\n\n                </span>\\n\n            </label>\\n\n                    <label class=\"form-selectgroup-item\" for=\"note-audience-6b05c69349846-technician\">\\n\n                <input\\n\n                    id=\"note-audience-6b05c69349846-technician\"\\n\n                    type=\"checkbox\"\\n\n                    x-model=\"technician\"\\n\n                    x-on:change=\"guardAudience('technician')\"\\n\n                    class=\"form-selectgroup-input\"\\n\n                >\\n\n                <span class=\"form-selectgroup-label\">\\n\n                    <span class=\"badge bg-azure-lt\">Technician</span>\\n\n                    <span class=\"d-block small text-secondary mt-1\">Tech Sheet</span>\\n\n                </span>\\n\n            </label>\\n\n                    <label class=\"form-selectgroup-item\" for=\"note-audience-6b05c69349846-customer\">\\n\n                <input\\n\n                    id=\"note-audience-6b05c69349846-customer\"\\n\n                    type=\"checkbox\"\\n\n                    x-model=\"customer\"\\n\n                    x-on:change=\"guardAudience('customer')\"\\n\n                    class=\"form-selectgroup-input\"\\n\n                >\\n\n                <span class=\"form-selectgroup-label\">\\n\n                    <span class=\"badge bg-red-lt\">Customer</span>\\n\n                    <span class=\"d-block small text-secondary mt-1\">Estimate / Portal</span>\\n\n                </span>\\n\n            </label>\\n\n            </div>\\n\n    <div x-show=\"audienceHint\" x-cloak x-text=\"audienceHint\" class=\"small text-warning mt-1\" role=\"status\"></div>\\n\n    </div>\\n\n        </div>\\n\n    </template>\\n\n\\n\n    <p x-show=\"simpleLineGuidance()\" class=\"form-hint mb-0\" x-text=\"simpleLineGuidance()\"></p>\\n\n\\n\n    </div>\\n\n                        </div>\\n\n                    </template>\\n\n                    <template x-if=\"hasLineType() && type === 'part'\">\\n\n                        <div class=\"mb-2\" data-line-entry-panel=\"part\">\\n\n                            <input type=\"hidden\" name=\"pricing_mode\" :value=\"pricingMode\">\\n\n<input type=\"hidden\" name=\"pricing_matrix_key\" :value=\"pricingMode === 'matrix' ? matrixKey : ''\">\\n\n<input type=\"hidden\" name=\"pricing_matrix_explicit\" :value=\"explicitMatrix ? '1' : '0'\">\\n\n<input type=\"hidden\" name=\"unit_price_override\" :value=\"sellEdited ? '1' : '0'\">\\n\n\\n\n<div class=\"d-flex flex-column gap-3\" data-line-entry-part>\\n\n    <label class=\"d-block\">\\n\n        <span class=\"form-label\">Part description</span>\\n\n        <input\\n\n            name=\"description\"\\n\n            value=\"\"\\n\n            required\\n\n            :placeholder=\"descriptionPlaceholder()\"\\n\n            class=\"form-control\"\\n\n        >\\n\n        <span class=\"form-hint\">Internal / ordering identity (brand, catalog name, part #).</span>\\n\n    </label>\\n\n\\n\n            <label class=\"d-block\">\\n\n            <span class=\"form-label\">Customer description</span>\\n\n            <input\\n\n                name=\"customer_description\"\\n\n                value=\"\"\\n\n                placeholder=\"Optional - clean label for estimate / PDF\"\\n\n                class=\"form-control\"\\n\n            >\\n\n            <span class=\"form-hint\">Shown on customer documents. Leave blank to use the shop presentation mode.</span>\\n\n        </label>\\n\n    \\n\n    <fieldset class=\"form-fieldset mb-0\">\\n\n        <legend class=\"subheader mb-2\">Pricing</legend>\\n\n        <div class=\"row g-2\">\\n\n            <label class=\"col-6 col-md-3\">\\n\n                <span class=\"form-label\">Your cost</span>\\n\n                <input\\n\n                    name=\"part_cost\"\\n\n                    x-model=\"cost\"\\n\n                    @input=\"onCostInput()\"\\n\n                    @blur=\"onCostBlur()\"\\n\n                    inputmode=\"decimal\"\\n\n                    placeholder=\"0.00\"\\n\n                    class=\"form-control text-end ark-money\"\\n\n                >\\n\n            </label>\\n\n            <label class=\"col-6 col-md-3\">\\n\n                <span class=\"form-label\">Parts matrix</span>\\n\n                <select\\n\n                    x-model=\"pricingSelection\"\\n\n                    @change=\"onPricingSelectionChange($event)\"\\n\n                    @input=\"onPricingSelectionChange($event)\"\\n\n                    class=\"form-select\"\\n\n                >\\n\n                                            <option value=\"aft-parts\">AFT Parts</option>\\n\n                                            <option value=\"filters\">Filters</option>\\n\n                                            <option value=\"fluids\">Fluids</option>\\n\n                                            <option value=\"oem-parts\">OEM Parts</option>\\n\n                                            <option value=\"warranty-no-markup\">Warranty (No Markup)</option>\\n\n                                        <option value=\"manual\">Manual price</option>\\n\n                </select>\\n\n            </label>\\n\n            <label class=\"col-6 col-md-3\">\\n\n                <span class=\"form-label\" x-text=\"pricingMode === 'matrix' && ! sellEdited ? 'Sell (from matrix)' : 'Sell price'\"></span>\\n\n                <input\\n\n                    name=\"unit_price\"\\n\n                    x-model=\"sell\"\\n\n                    @input=\"onSellInput()\"\\n\n                    :required=\"pricingMode === 'manual'\"\\n\n                    inputmode=\"decimal\"\\n\n                    placeholder=\"0.00\"\\n\n                    class=\"form-control text-end ark-money\"\\n\n                    :class=\"pricingMode === 'matrix' && ! sellEdited && sell ? 'bg-secondary-lt' : ''\"\\n\n                >\\n\n            </label>\\n\n            <label class=\"col-6 col-md-3\">\\n\n                <span class=\"form-label\">Quantity</span>\\n\n                <input\\n\n                    name=\"quantity\"\\n\n                    value=\"1.00\"\\n\n                    required\\n\n                    inputmode=\"decimal\"\\n\n                    placeholder=\"1\"\\n\n                    class=\"form-control text-end ark-money\"\\n\n                >\\n\n            </label>\\n\n        </div>\\n\n    </fieldset>\\n\n\\n\n    <fieldset class=\"form-fieldset mb-0\">\\n\n        <legend class=\"subheader mb-2\">Sourcing</legend>\\n\n        <div class=\"row g-2\">\\n\n            <label class=\"col-sm-6\">\\n\n                <span class=\"form-label\">Vendor</span>\\n\n                <input name=\"vendor_name\" value=\"\" placeholder=\"Worldpac, NAPA, dealer\u2026\" class=\"form-control\">\\n\n            </label>\\n\n            <label class=\"col-sm-6\">\\n\n                <span class=\"form-label\">Part number</span>\\n\n                <input name=\"part_number\" value=\"\" placeholder=\"Manufacturer or catalog #\" class=\"form-control\">\\n\n            </label>\\n\n            <label class=\"col-12\">\\n\n                <span class=\"form-label\">Order note</span>\\n\n                <input name=\"sourcing_notes\" value=\"\" placeholder=\"ETA, source, backorder, will-call\u2026\" class=\"form-control\">\\n\n            </label>\\n\n            <div class=\"col-12\">\\n\n                <div x-data=\"{ partSource: 'shop_supplied' }\" class=\"d-flex flex-column gap-2\">\\n\n    <div class=\"row g-2\">\\n\n        <label class=\"col-sm-4\">\\n\n            <span class=\"form-label\">Part source</span>\\n\n            <select name=\"part_source\" x-model=\"partSource\" class=\"form-select\">\\n\n                                    <option value=\"shop_supplied\" selected>Shop supplied</option>\\n\n                                    <option value=\"customer_supplied\" >Customer supplied</option>\\n\n                            </select>\\n\n        </label>\\n\n        <label class=\"col-sm-4\">\\n\n            <span class=\"form-label\">Part type</span>\\n\n            <select name=\"part_classification\" class=\"form-select\">\\n\n                <option value=\"\" selected>Not set</option>\\n\n                                    <option value=\"oem\" >OEM</option>\\n\n                                    <option value=\"aftermarket_replacement\" >Aftermarket replacement</option>\\n\n                                    <option value=\"performance_custom\" >Performance / custom</option>\\n\n                            </select>\\n\n        </label>\\n\n        <label class=\"col-sm-4\">\\n\n            <span class=\"form-label\">Warranty impact</span>\\n\n            <select name=\"part_warranty_impact\" class=\"form-select\">\\n\n                                    <option value=\"none\" selected>None</option>\\n\n                                    <option value=\"customer_supplied\" >Customer supplied</option>\\n\n                                    <option value=\"aftermarket_related\" >Aftermarket related</option>\\n\n                                    <option value=\"excluded\" >Excluded</option>\\n\n                            </select>\\n\n        </label>\\n\n    </div>\\n\n\\n\n    <div x-show=\"partSource === 'customer_supplied'\" x-cloak>\\n\n        <label class=\"d-block\">\\n\n            <span class=\"form-label\">Customer part posture</span>\\n\n            <select name=\"customer_part_posture\" class=\"form-select\">\\n\n                                    <option value=\"in_hand\" >Customer has part</option>\\n\n                                    <option value=\"waiting\" >Waiting on customer</option>\\n\n                            </select>\\n\n        </label>\\n\n        <p class=\"form-hint mt-1 mb-0\">\\n\n            Customer supplied parts skip shop ordering. Mark whether the part is already in hand or still waiting on the customer.\\n\n        </p>\\n\n    </div>\\n\n</div>\\n\n            </div>\\n\n            <div class=\"col-12 d-flex flex-wrap align-items-center gap-3\">\\n\n                <label class=\"form-check mb-0\">\\n\n                    <input type=\"hidden\" name=\"has_core\" value=\"0\">\\n\n                    <input type=\"checkbox\" name=\"has_core\" value=\"1\"  @change=\"onCoreChargeToggle()\" class=\"form-check-input\">\\n\n                    <span class=\"form-check-label\">Core charge</span>\\n\n                </label>\\n\n                <label class=\"form-check mb-0\">\\n\n                    <input type=\"hidden\" name=\"save_old_part\" value=\"0\">\\n\n                    <input type=\"checkbox\" name=\"save_old_part\" value=\"1\"  @change=\"onSaveOldPartToggle($event)\" class=\"form-check-input\">\\n\n                    <span class=\"form-check-label\">Save old part</span>\\n\n                </label>\\n\n            </div>\\n\n        </div>\\n\n    </fieldset>\\n\n\\n\n    <p class=\"form-hint mb-0\">\\n\n        <span x-text=\"suggestionText() || 'Enter your cost to load matrix sell guidance from the server.'\"></span>\\n\n        <template x-if=\"marginPercentage\">\\n\n            <span> \u00b7 Margin <span x-text=\"marginPercentage\"></span>%</span>\\n\n        </template>\\n\n        <template x-if=\"markupPercentage\">\\n\n            <span> \u00b7 Markup <span x-text=\"markupPercentage\"></span>%</span>\\n\n        </template>\\n\n        <template x-if=\"previewing\">\\n\n            <span> \u00b7 Checking server price\u2026</span>\\n\n        </template>\\n\n            </p>\\n\n\\n\n    </div>\\n\n                        </div>\\n\n                    </template>\\n\n                </form>\\n\n            </div>\\n\n\\n\n            \\n\n            <div\\n\n                data-workspace-modal-panel\\n\n                x-show=\"task === 'repair-action' && String(context.concernId) === '1'\"\\n\n                x-cloak\\n\n            >\\n\n                <form\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/repair-orders/1/concerns/1/work-groups\"\\n\n                    data-workspace-modal-form=\"repair-action\"\\n\n                    data-refresh-scope=\"worksheet\"\\n\n                    data-saving-label=\"Saving\u2026\"\\n\n                    @submit.prevent=\"submitWorksheetForm($event)\"\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                    <input type=\"hidden\" name=\"repair_order_concern_id\" value=\"1\">\\n\n                    <label class=\"form-label\" for=\"workspace-repair-action-title-1\">What are we doing?</label>\\n\n                    <input\\n\n                        id=\"workspace-repair-action-title-1\"\\n\n                        name=\"title\"\\n\n                        required\\n\n                        value=\"\"\\n\n                        placeholder=\"e.g. Replace water pump\"\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                    <div class=\"form-hint\">Name the repair - labor hours hang under it.</div>\\n\n                </form>\\n\n            </div>\\n\n        \\n\n        \\n\n        <div data-workspace-modal-panel x-show=\"task === 'oil'\" x-cloak>\\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/maintenance/engine-oil\"\\n\n                data-workspace-modal-form=\"oil\"\\n\n                data-refresh-scope=\"worksheet\"\\n\n                data-saving-label=\"Saving\u2026\"\\n\n                @submit.prevent=\"submitWorksheetForm($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <p class=\"mb-0\">\\n\n                    Authorize Engine Oil Service on this repair order. ARK creates the concern, repair action, and package line through Maintenance Service authority.\\n\n                </p>\\n\n                            </form>\\n\n        </div>\\n\n\\n\n        \\n\n        <div data-workspace-modal-panel x-show=\"task === 'testing'\" x-cloak>\\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/work-authorization/testing\"\\n\n                data-workspace-modal-form=\"testing\"\\n\n                data-refresh-scope=\"worksheet\"\\n\n                data-saving-label=\"Saving\u2026\"\\n\n                @submit.prevent=\"submitWorksheetForm($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <p class=\"mb-0\">\\n\n                    Authorize a Testing Package. ARK creates the concern, repair action, and package line through Work Authorization.\\n\n                </p>\\n\n            </form>\\n\n        </div>\\n\n\\n\n        \\n\n        <div\\n\n            data-workspace-modal-panel\\n\n            x-show=\"task === 'saved-work'\"\\n\n            x-cloak\\n\n            x-data=\"arkSavedWorkPicker({\\n\n                searchUrl: 'http:\\/\\/localhost\\/app\\/work-templates\\/search',\\n\n                recallUrlTemplate: '\\/app\\/repair-orders\\/1\\/work-templates\\/__TEMPLATE__\\/historical-recall',\\n\n                assistUrlTemplate: '\\/app\\/repair-orders\\/1\\/work-templates\\/__TEMPLATE__\\/historical-recall\\/assist',\\n\n                assistStatusUrlTemplate: '\\/app\\/repair-orders\\/1\\/dragon-assist\\/__ASSIST__',\\n\n                concernId: context.concernId || null,\\n\n                priorities: JSON.parse('[{\\u0022value\\u0022:\\u0022must_do\\u0022,\\u0022label\\u0022:\\u0022Must Do\\u0022},{\\u0022value\\u0022:\\u0022should_do\\u0022,\\u0022label\\u0022:\\u0022Should Do\\u0022},{\\u0022value\\u0022:\\u0022could_do\\u0022,\\u0022label\\u0022:\\u0022Could Do\\u0022},{\\u0022value\\u0022:\\u0022information_only\\u0022,\\u0022label\\u0022:\\u0022Information Only\\u0022}]'),\\n\n                defaultPosture: '',\\n\n            })\"\\n\n            x-init=\"boot()\"\\n\n        >\\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/work-templates/apply\"\\n\n                data-workspace-modal-form=\"saved-work\"\\n\n                data-refresh-scope=\"worksheet\"\\n\n                data-saving-label=\"Adding\u2026\"\\n\n                @submit.prevent=\"if (! canSubmit()) { return; }; $root.submitWorksheetForm($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <input type=\"hidden\" name=\"work_template_id\" :value=\"selectedId || ''\">\\n\n                <input type=\"hidden\" name=\"repair_order_concern_id\" :value=\"concernId || ''\">\\n\n                <input type=\"hidden\" name=\"recommendation_posture\" :value=\"concernId ? '' : recommendationPosture\">\\n\n                <input type=\"hidden\" name=\"historical_labor_hours\" :value=\"applyHoursValue()\">\\n\n                <input type=\"hidden\" name=\"historical_match_tier\" :value=\"recall?.tier || ''\">\\n\n                <input type=\"hidden\" name=\"historical_labor_confirmed\" :value=\"laborConfirmed ? '1' : '0'\">\\n\n\\n\n                <label class=\"form-label\" for=\"workspace-saved-work-search\">Search common jobs</label>\\n\n                <input\\n\n                    id=\"workspace-saved-work-search\"\\n\n                    type=\"search\"\\n\n                    x-model=\"query\"\\n\n                    @input.debounce.200ms=\"search()\"\\n\n                    class=\"form-control\"\\n\n                    placeholder=\"front bra\u2026\"\\n\n                    autocomplete=\"off\"\\n\n                >\\n\n\\n\n                <div class=\"list-group mt-3 overflow-auto\" style=\"max-height: 10rem\" role=\"listbox\" aria-label=\"Common jobs\">\\n\n                    <template x-for=\"item in results\" :key=\"item.id\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action fw-bold\"\\n\n                            role=\"option\"\\n\n                            :class=\"selectedId === item.id ? 'active' : ''\"\\n\n                            :aria-selected=\"selectedId === item.id\"\\n\n                            @click=\"select(item)\"\\n\n                            x-text=\"item.title\"\\n\n                        ></button>\\n\n                    </template>\\n\n                    <div x-show=\"! loading && results.length === 0\" class=\"list-group-item small text-secondary\">No matching Common Jobs.</div>\\n\n                </div>\\n\n\\n\n                <div x-show=\"selected\" x-cloak class=\"card card-sm mt-3\" data-saved-work-selected>\\n\n                    <div class=\"card-body small\">\\n\n                        <div class=\"fw-bold mb-1\" x-text=\"selected?.title\"></div>\\n\n                        <p class=\"text-secondary mb-3\" x-show=\"concernId\">Adds a Repair Action under this concern.</p>\\n\n\\n\n                        <div x-show=\"! concernId\" x-cloak class=\"mb-3\">\\n\n                            <label class=\"form-label\" for=\"workspace-saved-work-priority\">Priority</label>\\n\n                            <select id=\"workspace-saved-work-priority\" x-model=\"recommendationPosture\" class=\"form-select\">\\n\n                                <option value=\"\">Use saved work priority</option>\\n\n                                <template x-for=\"opt in priorities\" :key=\"opt.value\">\\n\n                                    <option :value=\"opt.value\" x-text=\"opt.label\"></option>\\n\n                                </template>\\n\n                            </select>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"recallLoading\" class=\"text-secondary mb-3\">Checking shop history\u2026</div>\\n\n\\n\n                        <div x-show=\"! recallLoading && recall && recall.tier !== 'none'\" class=\"border rounded p-2 mb-3\">\\n\n                            <div class=\"subheader mb-1\">\\n\n                                Historical Recall\\n\n                                <span class=\"badge bg-secondary-lt ms-1\" x-text=\"recall?.tier_label\"></span>\\n\n                            </div>\\n\n                            <div class=\"fw-medium\" x-text=\"recall?.comparable_vehicle_summary\"></div>\\n\n                            <div class=\"text-secondary\" x-text=\"recall?.sample_label\"></div>\\n\n                            <template x-for=\"reason in (recall?.reasons || [])\" :key=\"reason\">\\n\n                                <div class=\"text-secondary\" x-text=\"reason\"></div>\\n\n                            </template>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"assistStatus === 'reviewing'\" class=\"text-secondary mb-3\">Dragon reviewing\u2026</div>\\n\n\\n\n                        <div x-show=\"assist?.available\" x-cloak class=\"border rounded p-2 mb-3\">\\n\n                            <div class=\"subheader mb-1\">Dragon Assist</div>\\n\n                            <div x-text=\"assist?.summary\"></div>\\n\n                            <div x-show=\"assist?.confidence_comment\" class=\"text-secondary mt-1\" x-text=\"assist?.confidence_comment\"></div>\\n\n                            <template x-for=\"caution in (assist?.cautions || [])\" :key=\"caution\">\\n\n                                <div class=\"text-orange mt-1\">Caution: <span x-text=\"caution\"></span></div>\\n\n                            </template>\\n\n                            <div x-show=\"assist?.recommendation\" class=\"text-secondary mt-1\" x-text=\"assist?.recommendation\"></div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"! recallLoading && recall && recall.tier === 'none'\" class=\"text-secondary mb-3\">\\n\n                            No comparable shop history found.\\n\n                        </div>\\n\n\\n\n                        <div class=\"mb-3\">\\n\n                            <div class=\"subheader mb-1\">Labor</div>\\n\n                            <span x-show=\"recall?.prepares_labor\">\\n\n                                <label class=\"visually-hidden\" for=\"workspace-saved-work-hours\">Labor hours</label>\\n\n                                <input\\n\n                                    id=\"workspace-saved-work-hours\"\\n\n                                    type=\"number\"\\n\n                                    step=\"0.01\"\\n\n                                    min=\"0\"\\n\n                                    x-model=\"laborHours\"\\n\n                                    class=\"form-control form-control-sm d-inline-block\"\\n\n                                    style=\"width: 5rem\"\\n\n                                >\\n\n                                <span>hr</span>\\n\n                            </span>\\n\n                            <span x-show=\"! recall?.prepares_labor\">\\n\n                                <template x-for=\"line in (selected?.lines || []).filter(l => l.type === 'labor')\" :key=\"'labor-'+line.description\">\\n\n                                    <span>\\n\n                                        <span x-text=\"line.description\"></span>\\n\n                                        <span x-show=\"line.hours\" x-text=\"' - ' + line.hours + ' hr'\"></span>\\n\n                                    </span>\\n\n                                </template>\\n\n                            </span>\\n\n                            <div class=\"text-secondary mt-1\" x-text=\"recall?.source_label\"></div>\\n\n                            <div\\n\n                                x-show=\"recall?.prepares_labor && recall?.min_hours != null\"\\n\n                                class=\"text-secondary\"\\n\n                                x-text=\"recall ? ('Range ' + recall.min_hours + '\u2013' + recall.max_hours + ' hr') : ''\"\\n\n                            ></div>\\n\n                            <div\\n\n                                x-show=\"recall?.tier === 'possible' && recall?.median_hours != null\"\\n\n                                class=\"text-secondary mt-1\"\\n\n                                x-text=\"recall ? ('Historical reference: ' + recall.median_hours + ' hr') : ''\"\\n\n                            ></div>\\n\n                            <label x-show=\"recall?.requires_review\" class=\"form-check mt-2 mb-0\">\\n\n                                <input type=\"checkbox\" class=\"form-check-input\" x-model=\"laborConfirmed\">\\n\n                                <span class=\"form-check-label\">Use suggested hours from shop history</span>\\n\n                            </label>\\n\n                        </div>\\n\n\\n\n                        <div>\\n\n                            <div class=\"subheader mb-1\">Parts</div>\\n\n                            <template x-for=\"line in (selected?.lines || []).filter(l => l.type === 'part')\" :key=\"'part-'+line.description\">\\n\n                                <div>\\n\n                                    <span x-text=\"line.description\"></span>\\n\n                                    <span x-show=\"Number(line.quantity) > 1\" x-text=\"' \u00d7' + line.quantity\"></span>\\n\n                                </div>\\n\n                            </template>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </form>\\n\n        </div>\\n\n\\n\n        <div data-workspace-modal-panel x-show=\"task === 'visit-reason'\" x-cloak>\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/visit-reason\"\\n\n        data-workspace-modal-form=\"visit-reason\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-saving-label=\"Saving\u2026\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n        <label class=\"form-label\" for=\"workspace-visit-reason\">Reason for visit</label>\\n\n        <div\\n\n            class=\"position-relative\"\\n\n            x-data=\"arkRoMention([])\"\\n\n        >\\n\n            <textarea\\n\n                id=\"workspace-visit-reason\"\\n\n                name=\"visit_reason\"\\n\n                x-ref=\"field\"\\n\n                rows=\"4\"\\n\n                placeholder=\"What the customer said when they brought the vehicle in. Type @RO to mention a previous visit.\"\\n\n                class=\"form-control\"\\n\n                @input=\"onInput()\"\\n\n                @keydown=\"onKeydown($event)\"\\n\n            >Check engine light on highway.</textarea>\\n\n            <div\\n\n    class=\"dropdown-menu show w-100 mt-1\"\\n\n    x-show=\"open && matches.length > 0\"\\n\n    x-cloak\\n\n    role=\"listbox\"\\n\n    aria-label=\"Previous visits\"\\n\n    data-ro-mention-menu\\n\n>\\n\n    <template x-for=\"(row, index) in matches\" :key=\"row.number\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"dropdown-item d-block\"\\n\n            :class=\"{ 'active': index === activeIndex }\"\\n\n            role=\"option\"\\n\n            @mousedown.prevent=\"choose(row)\"\\n\n        >\\n\n            <span class=\"d-block fw-medium\" x-text=\"row.label\"></span>\\n\n            <span class=\"d-block small text-secondary\" x-text=\"row.detail\"></span>\\n\n        </button>\\n\n    </template>\\n\n</div>\\n\n        </div>\\n\n            </form>\\n\n</div>\\n\n\\n\n\\n\n\\n\n\\n\n\\n\n    <div\\n\n        data-workspace-modal-panel\\n\n        x-show=\"task === 'concern-narrative' && String(context.concernId) === '1'\"\\n\n        x-cloak\\n\n    >\\n\n        <form\\n\n            id=\"workspace-concern-narrative-1\"\\n\n            method=\"POST\"\\n\n            action=\"http://localhost/app/repair-orders/1/concerns/1\"\\n\n            data-workspace-modal-form=\"concern-narrative\"\\n\n            data-worksheet-surface=\"concern-narrative-1\"\\n\n            data-refresh-scope=\"worksheet\"\\n\n            data-saving-label=\"Saving\u2026\"\\n\n            @submit.prevent=\"submitWorksheetForm($event)\"\\n\n        >\\n\n            <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n            <div\\n\n                class=\"row g-3\"\\n\n                x-data=\"arkRoMention([])\"\\n\n            >\\n\n                <div class=\"col-12 position-relative\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-summary-1\">Concern</label>\\n\n                    <input\\n\n                        id=\"workspace-concern-summary-1\"\\n\n                        name=\"summary\"\\n\n                        x-ref=\"field\"\\n\n                        value=\"Check engine light\"\\n\n                        required\\n\n                        placeholder=\"The problem - e.g. Overheating, brake noise. Type @RO for a previous visit.\"\\n\n                        class=\"form-control\"\\n\n                        @input=\"onInput()\"\\n\n                        @keydown=\"onKeydown($event)\"\\n\n                    >\\n\n                    <div\\n\n    class=\"dropdown-menu show w-100 mt-1\"\\n\n    x-show=\"open && matches.length > 0\"\\n\n    x-cloak\\n\n    role=\"listbox\"\\n\n    aria-label=\"Previous visits\"\\n\n    data-ro-mention-menu\\n\n>\\n\n    <template x-for=\"(row, index) in matches\" :key=\"row.number\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"dropdown-item d-block\"\\n\n            :class=\"{ 'active': index === activeIndex }\"\\n\n            role=\"option\"\\n\n            @mousedown.prevent=\"choose(row)\"\\n\n        >\\n\n            <span class=\"d-block fw-medium\" x-text=\"row.label\"></span>\\n\n            <span class=\"d-block small text-secondary\" x-text=\"row.detail\"></span>\\n\n        </button>\\n\n    </template>\\n\n</div>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-priority-1\">Priority</label>\\n\n                    <select id=\"workspace-concern-priority-1\" name=\"recommendation_posture\" class=\"form-select\">\\n\n            <option value=\"\" selected>No priority</option>\\n\n                <option value=\"must_do\" >Must Do</option>\\n\n            <option value=\"should_do\" >Should Do</option>\\n\n            <option value=\"could_do\" >Could Do</option>\\n\n        <option value=\"information_only\" >Information Only</option>\\n\n</select>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-intent-1\">Work type</label>\\n\n                    <select id=\"workspace-concern-intent-1\" name=\"recommendation_intent\" class=\"form-select\" >\\n\n            <option value=\"\" >No work type</option>\\n\n                <option value=\"maintenance\" selected>Maintenance</option>\\n\n            <option value=\"diagnostic\" >Diagnostic</option>\\n\n            <option value=\"repair_verification\" >Repair Verification</option>\\n\n    </select>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-customer-states-1\">Customer states</label>\\n\n                    <textarea id=\"workspace-concern-customer-states-1\" name=\"customer_states\" rows=\"3\" class=\"form-control\" placeholder=\"What the customer reported\u2026\"></textarea>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-verified-findings-1\">Verified findings</label>\\n\n                    <textarea id=\"workspace-concern-verified-findings-1\" name=\"verified_findings\" rows=\"3\" class=\"form-control\" placeholder=\"What was verified\u2026\"></textarea>\\n\n                    <p class=\"small text-secondary mt-2 mb-0\">\\n\n            Faster with evidence?\\n\n            <a href=\"http://localhost/app/repair-orders/1/inspection?capture=1&amp;concern=1\">Open Inspection</a>\\n\n            - photo and measurement beat prose alone.\\n\n        </p>\\n\n                    </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-dtcs-1\">DTCs, if present</label>\\n\n                    <textarea id=\"workspace-concern-dtcs-1\" name=\"dtcs_summary\" rows=\"2\" class=\"form-control\" placeholder=\"e.g. P0303 current\"></textarea>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label class=\"form-label\" for=\"workspace-concern-recommendation-1\">Recommendation</label>\\n\n                    <textarea id=\"workspace-concern-recommendation-1\" name=\"recommendation\" rows=\"2\" class=\"form-control\" placeholder=\"Recommended repair\u2026\"></textarea>\\n\n                </div>\\n\n                <div class=\"col-12\">\\n\n                                    </div>\\n\n            </div>\\n\n        </form>\\n\n    </div>\\n\n\\n\n\\n\n    \\n\n    \\n\n    \\n\n                            \\n\n        \\n\n                <div\\n\n            id=\"worksheet-line-editor\"\\n\n                    >\\n\n                    </div>\\n\n        \\n\n        \\n\n        <div data-workspace-modal-panel x-show=\"task === 'evidence'\" x-cloak>\\n\n            \\n\n                            <form\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/repair-orders/1/evidence\"\\n\n                    enctype=\"multipart/form-data\"\\n\n                    data-workspace-modal-form=\"evidence\"\\n\n                    data-refresh-scope=\"worksheet\"\\n\n                    data-saving-label=\"Saving\u2026\"\\n\n                    @submit.prevent=\"submitWorksheetForm($event)\"\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                    <div class=\"row g-3\">\\n\n                        <div class=\"col-12\">\\n\n                            <label class=\"form-label\" for=\"workspace-evidence-file\">File</label>\\n\n                            <input id=\"workspace-evidence-file\" name=\"file\" type=\"file\" required accept=\"image/*,video/*,application/pdf\" class=\"form-control\">\\n\n                        </div>\\n\n                        <div class=\"col-12\">\\n\n                            <label class=\"form-label\" for=\"workspace-evidence-target\">Attach to</label>\\n\n                            <select\\n\n                                id=\"workspace-evidence-target\"\\n\n                                name=\"attachable_id\"\\n\n                                required\\n\n                                class=\"form-select\"\\n\n                                onchange=\"document.getElementById('workspace-evidence-attachable-kind').value = this.options[this.selectedIndex].dataset.kind\"\\n\n                            >\\n\n                                <option value=\"1\" data-kind=\"repair_order\" selected>General (this RO)</option>\\n\n                                                                    <option value=\"1\" data-kind=\"concern\">Check engine light</option>\\n\n                                                            </select>\\n\n                            <input type=\"hidden\" name=\"attachable_kind\" id=\"workspace-evidence-attachable-kind\" value=\"repair_order\">\\n\n                        </div>\\n\n                        <div class=\"col-12\">\\n\n                            <label class=\"form-label\" for=\"workspace-evidence-caption\">Caption</label>\\n\n                            <input id=\"workspace-evidence-caption\" name=\"caption\" type=\"text\" maxlength=\"500\" placeholder=\"What was seen (not a diagnosis)\" class=\"form-control\">\\n\n                        </div>\\n\n                        <div class=\"col-12\">\\n\n                            <label class=\"form-check mb-0\">\\n\n                                <input type=\"checkbox\" name=\"as_primary\" value=\"1\" class=\"form-check-input\">\\n\n                                <span class=\"form-check-label\">Primary</span>\\n\n                            </label>\\n\n                        </div>\\n\n                        <input type=\"hidden\" name=\"source\" value=\"upload\">\\n\n                    </div>\\n\n                </form>\\n\n                    </div>\\n\n\\n\n        \\n\n        <div data-workspace-modal-panel x-show=\"task === 'document'\" x-cloak>\\n\n            \\n\n                            <div\\n\n    data-add-document-panel\\n\n    x-data=\"arkDocumentAdd({\\n\n        initialMode: null,\\n\n        attachable: [],\\n\n    })\"\\n\n>\\n\n    <div x-show=\"! mode\">\\n\n        <div class=\"list-group\">\\n\n            <button type=\"button\" class=\"list-group-item list-group-item-action\" @click=\"choose('scan')\">\\n\n                <div class=\"fw-bold\">Scan Document</div>\\n\n                <div class=\"text-secondary small\">Capture pages with the camera into one PDF.</div>\\n\n            </button>\\n\n            <button type=\"button\" class=\"list-group-item list-group-item-action\" @click=\"choose('upload')\">\\n\n                <div class=\"fw-bold\">Upload PDF / File</div>\\n\n                <div class=\"text-secondary small\">Add a downloaded or scanned PDF, JPG, or PNG.</div>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n    <div x-show=\"mode === 'upload'\" x-cloak>\\n\n        <button type=\"button\" class=\"btn btn-link px-0 mb-2\" @click=\"back()\">\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n            Back\\n\n        </button>\\n\n        <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/documents\" enctype=\"multipart/form-data\" data-workspace-modal-form=\"document-upload\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_document_mode\" value=\"upload\">\\n\n                            <input type=\"hidden\" name=\"return_to_ro\" value=\"1\">\\n\n                        <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-file\">File</label>\\n\n                <input id=\"document-file\" name=\"file\" type=\"file\" required accept=\"application/pdf,image/jpeg,image/png,image/heic,image/heif,.pdf,.jpg,.jpeg,.png,.heic\" class=\"form-control\">\\n\n                <div class=\"form-hint\">PDF, JPG, PNG, or HEIC \u00b7 max 25 MB</div>\\n\n            </div>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-title\">Document name</label>\\n\n                <input id=\"document-title\" name=\"title\" type=\"text\" required maxlength=\"255\" value=\"\" class=\"form-control\" placeholder=\"ASC Vehicle Protection Plan\">\\n\n            </div>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-type\">Type</label>\\n\n                <select id=\"document-type\" name=\"type\" required class=\"form-select\">\\n\n                    <option value=\"general\" selected>General</option>\\n\n    <option value=\"service_record\" >Service Record</option>\\n\n    <option value=\"warranty\" >Warranty / Protection Plan</option>\\n\n    <option value=\"registration\" >Registration</option>\\n\n    <option value=\"insurance\" >Insurance</option>\\n\n    <option value=\"outside_invoice\" >Outside Invoice / Receipt</option>\\n\n    <option value=\"alignment\" >Alignment / Measurement</option>\\n\n    <option value=\"authorization\" >Authorization</option>\\n\n    <option value=\"diagnostic_report\" >Diagnostic Report</option>\\n\n    <option value=\"other\" >Other</option>\\n\n                </select>\\n\n            </div>\\n\n                        <button type=\"submit\" class=\"btn btn-primary\">Save Document</button>\\n\n        </form>\\n\n    </div>\\n\n\\n\n    <div x-show=\"mode === 'scan'\" x-cloak>\\n\n        <button type=\"button\" class=\"btn btn-link px-0 mb-2\" @click=\"back()\">\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n            Back\\n\n        </button>\\n\n        <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/documents/scan\" enctype=\"multipart/form-data\" data-workspace-modal-form=\"document-scan\" @submit=\"prepareScanSubmit($event)\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_document_mode\" value=\"scan\">\\n\n                            <input type=\"hidden\" name=\"return_to_ro\" value=\"1\">\\n\n                        <div class=\"card card-sm mb-3\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"btn-list\">\\n\n                        <label class=\"btn btn-outline-primary mb-0\">\\n\n                            Capture Page\\n\n                            <input type=\"file\" accept=\"image/*\" capture=\"environment\" class=\"visually-hidden\" @change=\"addFiles($event.target.files); $event.target.value = ''\">\\n\n                        </label>\\n\n                        <label class=\"btn mb-0\">\\n\n                            Add from Photos\\n\n                            <input type=\"file\" accept=\"image/*\" multiple class=\"visually-hidden\" @change=\"addFiles($event.target.files); $event.target.value = ''\">\\n\n                        </label>\\n\n                    </div>\\n\n                    <div class=\"form-hint mt-2\">Pages become one PDF when you save.</div>\\n\n                </div>\\n\n            </div>\\n\n            <ul class=\"list-group mb-3\" x-show=\"pages.length > 0\">\\n\n                <template x-for=\"(page, index) in pages\" :key=\"page.id\">\\n\n                    <li class=\"list-group-item d-flex align-items-center gap-2\">\\n\n                        <img :src=\"page.url\" alt=\"\" class=\"rounded object-fit-cover\" style=\"width: 2.75rem; height: 3.5rem\">\\n\n                        <div class=\"flex-fill\">\\n\n                            <div class=\"fw-medium\" x-text=\"'Page ' + (index + 1)\"></div>\\n\n                            <div class=\"btn-list mt-1\">\\n\n                                <button type=\"button\" class=\"btn btn-sm btn-ghost-secondary\" @click=\"movePage(page.id, -1)\">Up</button>\\n\n                                <button type=\"button\" class=\"btn btn-sm btn-ghost-secondary\" @click=\"movePage(page.id, 1)\">Down</button>\\n\n                                <button type=\"button\" class=\"btn btn-sm btn-ghost-danger\" @click=\"removePage(page.id)\">Remove</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </li>\\n\n                </template>\\n\n            </ul>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-scan-title\">Document name</label>\\n\n                <input id=\"document-scan-title\" name=\"title\" type=\"text\" required maxlength=\"255\" value=\"\" class=\"form-control\" placeholder=\"Warranty contract\">\\n\n            </div>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-scan-type\">Type</label>\\n\n                <select id=\"document-scan-type\" name=\"type\" required class=\"form-select\">\\n\n                    <option value=\"general\" >General</option>\\n\n    <option value=\"service_record\" >Service Record</option>\\n\n    <option value=\"warranty\" selected>Warranty / Protection Plan</option>\\n\n    <option value=\"registration\" >Registration</option>\\n\n    <option value=\"insurance\" >Insurance</option>\\n\n    <option value=\"outside_invoice\" >Outside Invoice / Receipt</option>\\n\n    <option value=\"alignment\" >Alignment / Measurement</option>\\n\n    <option value=\"authorization\" >Authorization</option>\\n\n    <option value=\"diagnostic_report\" >Diagnostic Report</option>\\n\n    <option value=\"other\" >Other</option>\\n\n                </select>\\n\n            </div>\\n\n                        <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"pages.length === 0\">Save Document</button>\\n\n        </form>\\n\n    </div>\\n\n\\n\n    </div>\\n\n            \\n\n                    </div>\\n\n\\n\n        <div data-workspace-modal-panel x-show=\"task === 'customer-identity'\" x-cloak>\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/customers/1\"\\n\n        data-workspace-modal-form=\"customer-identity\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-saving-label=\"Saving\u2026\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"repair_order_id\" value=\"1\">\\n\n        <input type=\"hidden\" name=\"notes\" value=\"\">\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-first-name\">First name</label>\\n\n                <input id=\"workspace-customer-first-name\" name=\"first_name\" value=\"Landing\" required class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-last-name\">Last name</label>\\n\n                <input id=\"workspace-customer-last-name\" name=\"last_name\" value=\"Customer\" required class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-type\">Billing class</label>\\n\n                                <select id=\"workspace-customer-type\" name=\"billing_class_key\" class=\"form-select\">\\n\n                                            <option value=\"retail\" selected>Retail</option>\\n\n                                            <option value=\"fleet\" >Fleet</option>\\n\n                                            <option value=\"warranty\" >Warranty</option>\\n\n                                            <option value=\"repairpal\" >RepairPal</option>\\n\n                                            <option value=\"internal\" >Internal</option>\\n\n                                            <option value=\"wholesale\" >Wholesale</option>\\n\n                                            <option value=\"comeback\" >Comeback</option>\\n\n                                            <option value=\"business\" >Business</option>\\n\n                                            <option value=\"military\" >Military</option>\\n\n                                    </select>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-contact-preference\">Preferred contact</label>\\n\n                <select id=\"workspace-customer-contact-preference\" name=\"contact_preference\" class=\"form-select\">\\n\n                    <option value=\"\">-</option>\\n\n                    <option value=\"text\" >Text</option>\\n\n                    <option value=\"call\" >Call</option>\\n\n                    <option value=\"email\" >Email</option>\\n\n                </select>\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-phone\">Phone</label>\\n\n                <input id=\"workspace-customer-phone\" name=\"phone\" value=\"7195554411\" class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-email\">Email</label>\\n\n                <input id=\"workspace-customer-email\" type=\"email\" name=\"email\" value=\"\" class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-12\">\\n\n                <label class=\"form-label\" for=\"workspace-customer-address-1\">Address</label>\\n\n                <input id=\"workspace-customer-address-1\" name=\"address_line_1\" value=\"\" class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-12\">\\n\n                <input name=\"address_line_2\" value=\"\" placeholder=\"Apt / unit\" aria-label=\"Apt / unit\" class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <input name=\"city\" value=\"\" placeholder=\"City\" aria-label=\"City\" class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-6 col-sm-3\">\\n\n                <input name=\"state\" value=\"\" placeholder=\"ST\" maxlength=\"32\" aria-label=\"State\" class=\"form-control\" />\\n\n            </div>\\n\n            <div class=\"col-6 col-sm-3\">\\n\n                <input name=\"postal_code\" value=\"\" placeholder=\"ZIP\" maxlength=\"16\" aria-label=\"ZIP\" class=\"form-control\" />\\n\n            </div>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n\\n\n<div data-workspace-modal-panel x-show=\"task === 'vehicle-identity'\" x-cloak>\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/customers/1/vehicles/1\"\\n\n        data-workspace-modal-form=\"vehicle-identity\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-saving-label=\"Saving\u2026\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"repair_order_id\" value=\"1\">\\n\n        <div\\n\n            x-data=\"arkVehicleDecode(JSON.parse('{\\u0022decodeUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/vehicles\\\\\\/decode-vin\\u0022,\\u0022csrfToken\\u0022:\\u0022WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\\u0022}'))\"\\n\n        >\\n\n            <div class=\"row g-3\">\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-vin\">VIN</label>\\n\n        <div class=\"input-group\">\\n\n            <input id=\"workspace-vehicle-vin\" name=\"vin\" value=\"4S4BRBCC5E1234599\" maxlength=\"17\" autocomplete=\"off\" autocapitalize=\"characters\" class=\"form-control font-monospace\" />\\n\n            <button type=\"button\" @click=\"decode($event)\" :disabled=\"decoding\" class=\"btn\">\\n\n                <span x-show=\"!decoding\">Decode VIN</span>\\n\n                <span x-show=\"decoding\" x-cloak>Decoding\u2026</span>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-plate\">Plate</label>\\n\n        <div class=\"input-group\">\\n\n            <input id=\"workspace-vehicle-plate\" name=\"plate\" value=\"LAND1\" autocomplete=\"off\" autocapitalize=\"characters\" class=\"form-control\" />\\n\n            <input name=\"plate_state\" value=\"\" maxlength=\"32\" autocomplete=\"off\" autocapitalize=\"characters\" aria-label=\"Plate state\" size=\"3\" class=\"form-control flex-grow-0 w-auto\" />\\n\n            <button type=\"button\" @click=\"decodePlate($event)\" :disabled=\"decoding\" class=\"btn\">\\n\n                <span x-show=\"!decoding\">Decode plate</span>\\n\n                <span x-show=\"decoding\" x-cloak>Decoding\u2026</span>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n    <div class=\"col-12\" x-show=\"message\" x-cloak>\\n\n        <div x-text=\"message\" class=\"small fw-medium\" :class=\"messageIsError ? 'text-danger' : 'text-secondary'\"></div>\\n\n    </div>\\n\n    <div class=\"col-4\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-year\">Year</label>\\n\n        <input id=\"workspace-vehicle-year\" name=\"year\" value=\"2014\" inputmode=\"numeric\" class=\"form-control\" />\\n\n            </div>\\n\n    <div class=\"col-8 col-sm-4\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-make\">Make</label>\\n\n        <input id=\"workspace-vehicle-make\" name=\"make\" value=\"Subaru\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n            </div>\\n\n    <div class=\"col-12 col-sm-4\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-model\">Model</label>\\n\n        <input id=\"workspace-vehicle-model\" name=\"model\" value=\"Outback\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n            </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-trim\">Trim</label>\\n\n        <input id=\"workspace-vehicle-trim\" name=\"trim\" value=\"\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-engine\">Engine</label>\\n\n        <input id=\"workspace-vehicle-engine\" name=\"engine\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-drive\">Drive</label>\\n\n        <input id=\"workspace-vehicle-drive\" name=\"drive\" value=\"\" placeholder=\"AWD, FWD, 4WD\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-transmission\">Transmission</label>\\n\n        <input id=\"workspace-vehicle-transmission\" name=\"transmission\" value=\"\" placeholder=\"Automatic, Manual\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-color\">Color</label>\\n\n        <input id=\"workspace-vehicle-color\" name=\"color\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-nickname\">Tag / nickname</label>\\n\n        <input id=\"workspace-vehicle-nickname\" name=\"nickname\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-public-notes\">Public notes</label>\\n\n        <input id=\"workspace-vehicle-public-notes\" name=\"public_notes\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"workspace-vehicle-private-notes\">Private notes</label>\\n\n        <input id=\"workspace-vehicle-private-notes\" name=\"private_notes\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n</div>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n\\n\n<div data-workspace-modal-panel x-show=\"task === 'visit-posture'\" x-cloak>\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/visit-posture\"\\n\n        data-workspace-modal-form=\"visit-posture\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-saving-label=\"Saving\u2026\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n        <label class=\"form-label\" for=\"workspace-visit-posture\">Visit type</label>\\n\n        <select\\n\n            id=\"workspace-visit-posture\"\\n\n            name=\"visit_mode\"\\n\n            required\\n\n            class=\"form-select\"\\n\n        >\\n\n            <option value=\"\" disabled selected>Choose visit type</option>\\n\n                            <option value=\"waiting_here\" >Waiting</option>\\n\n                            <option value=\"drop_off\" >Drop Off</option>\\n\n                            <option value=\"needs_shuttle\" >Shuttle</option>\\n\n                            <option value=\"tow_incoming\" >Tow-In</option>\\n\n                            <option value=\"on_site\" >On-site</option>\\n\n                    </select>\\n\n    </form>\\n\n</div>\\n\n\\n\n\\n\n<div data-workspace-modal-panel x-show=\"task === 'mileage'\" x-cloak>\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/mileage\"\\n\n        data-workspace-modal-form=\"mileage\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-saving-label=\"Saving\u2026\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-mileage-in\">Mileage in</label>\\n\n                <input\\n\n                    id=\"workspace-mileage-in\"\\n\n                    name=\"mileage_in\"\\n\n                    value=\"\"\\n\n                    inputmode=\"numeric\"\\n\n                    class=\"form-control\"\\n\n                                    />\\n\n            </div>\\n\n            <div class=\"col-12 col-sm-6\">\\n\n                <label class=\"form-label\" for=\"workspace-mileage-out\">Mileage out</label>\\n\n                <input\\n\n                    id=\"workspace-mileage-out\"\\n\n                    name=\"mileage_out\"\\n\n                    value=\"\"\\n\n                    inputmode=\"numeric\"\\n\n                    class=\"form-control\"\\n\n                />\\n\n            </div>\\n\n        </div>\\n\n    </form>\\n\n</div>\\n\n\\n\n        \\n\n                <div data-workspace-modal-panel x-show=\"task === 'review-request' && context.closePaid\" x-cloak>\\n\n            <p class=\"mb-0\">No text or email contact is available for this customer.</p>\\n\n            <div class=\"btn-list mt-3\">\\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/lifecycle\"\\n\n                data-refresh-scope=\"toolbar\"\\n\n                 data-workspace-modal-form=\"review-request\"                 @submit.prevent=\"submitWorksheetForm($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <input type=\"hidden\" name=\"status\" value=\"closed:paid\">\\n\n                <button type=\"submit\" class=\"btn btn-primary\">\\n\n                    Close paid\\n\n                </button>\\n\n            </form>\\n\n        </div>\\n\n            </div>\\n\n        <div data-workspace-modal-panel x-show=\"task === 'review-request' && ! context.closePaid\" x-cloak>\\n\n            <p class=\"mb-0\">No text or email contact is available for this customer.</p>\\n\n            </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"modal-footer flex-wrap\">\\n\n                        <div class=\"alert alert-danger w-100 mb-2\" x-show=\"validationMessage\" x-cloak x-text=\"validationMessage\" role=\"alert\"></div>\\n\n                        <div class=\"me-auto\">\\n\n                            <template x-if=\"showDelete()\">\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn\"\\n\n                                    :class=\"deleteConfirm ? 'btn-danger' : 'btn-outline-danger'\"\\n\n                                    :disabled=\"saving || saved\"\\n\n                                    :aria-label=\"deleteConfirm ? `Confirm delete within ${deleteConfirmSeconds} seconds` : 'Delete line'\"\\n\n                                    @click=\"armOrSubmitDelete()\"\\n\n                                    x-text=\"deleteLabel()\"\\n\n                                ></button>\\n\n                            </template>\\n\n                        </div>\\n\n                        <button type=\"button\" class=\"btn\" :disabled=\"saving || saved\" @click=\"requestClose()\">Cancel</button>\\n\n                        <button type=\"button\" class=\"btn\" x-show=\"showSaveAndRewrite()\" x-cloak :disabled=\"saving || saved\" @click=\"submitPrimaryAndRewrite()\">Save &amp; Generate</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn\"\\n\n                            x-ref=\"primaryBtn\"\\n\n                            x-show=\"showPrimary()\"\\n\n                            :disabled=\"saving || saved\"\\n\n                            :class=\"saved ? 'btn-success' : 'btn-primary'\"\\n\n                            @click=\"submitPrimary()\"\\n\n                        >\\n\n                            <span x-show=\"! saving && ! saved\" x-text=\"primaryLabel()\"></span>\\n\n                            <span x-show=\"saving\" x-cloak>Saving\u2026</span>\\n\n                            <span x-show=\"saved\" x-cloak>\u2713 Saved</span>\\n\n                        </button>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n                    <div data-worksheet-procurement>\\n\n                                                                                                    \\n\n                                                    <div\\n\n    id=\"dealer-quote-capture\"\\n\n    x-data=\"arkDealerQuoteCapture(JSON.parse('{\\u0022analyzeUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/dealer-quotes\\\\\\/analyze\\u0022,\\u0022importUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/dealer-quotes\\u0022,\\u0022pricingPreviewUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/repair-orders\\\\\\/1\\\\\\/lines\\\\\\/pricing-preview\\u0022,\\u0022csrfToken\\u0022:\\u0022WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\\u0022,\\u0022defaultConcernId\\u0022:1,\\u0022initialPartsMatrices\\u0022:[{\\u0022key\\u0022:\\u0022aft-parts\\u0022,\\u0022name\\u0022:\\u0022AFT Parts\\u0022},{\\u0022key\\u0022:\\u0022filters\\u0022,\\u0022name\\u0022:\\u0022Filters\\u0022},{\\u0022key\\u0022:\\u0022fluids\\u0022,\\u0022name\\u0022:\\u0022Fluids\\u0022},{\\u0022key\\u0022:\\u0022oem-parts\\u0022,\\u0022name\\u0022:\\u0022OEM Parts\\u0022},{\\u0022key\\u0022:\\u0022warranty-no-markup\\u0022,\\u0022name\\u0022:\\u0022Warranty (No Markup)\\u0022}],\\u0022initialConcerns\\u0022:[{\\u0022id\\u0022:1,\\u0022summary\\u0022:\\u0022Check engine light\\u0022,\\u0022default_parts_matrix_key\\u0022:\\u0022aft-parts\\u0022,\\u0022default_parts_matrix_name\\u0022:\\u0022AFT Parts\\u0022}]}'))\"\\n\n    x-cloak\\n\n>\\n\n    <div x-show=\"open\" x-cloak data-dealer-quote-dialog @keydown.escape.window=\"closeCapture()\">\\n\n        <div class=\"modal-backdrop show\"></div>\\n\n        <div\\n\n            class=\"modal d-block\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            aria-labelledby=\"dealer-quote-capture-title\"\\n\n            @click.self=\"closeCapture()\"\\n\n        >\\n\n            <div class=\"modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down\" @click.self=\"closeCapture()\">\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header\">\\n\n                        <div class=\"overflow-hidden\">\\n\n                            <h2 id=\"dealer-quote-capture-title\" class=\"modal-title\">Import Dealer Quote</h2>\\n\n                            <div class=\"small text-secondary\">PDF or pasted text \u2192 review \u2192 add parts to this estimate.</div>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn-close\"\\n\n                            aria-label=\"Close\"\\n\n                            @click=\"closeCapture()\"\\n\n                            :disabled=\"analyzing || importing\"\\n\n                        ></button>\\n\n                    </div>\\n\n\\n\n                    <div class=\"modal-body\">\\n\n                        <div x-show=\"error\" class=\"alert alert-danger\" role=\"alert\" x-text=\"error\"></div>\\n\n\\n\n                        <div x-show=\"step === 'upload'\">\\n\n                            <div class=\"mb-3\">\\n\n                                <label class=\"form-label\" for=\"dealer-quote-file\">Upload PDF or photo</label>\\n\n                                <input\\n\n                                    id=\"dealer-quote-file\"\\n\n                                    type=\"file\"\\n\n                                    accept=\".pdf,application/pdf,image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp,.txt,text/plain\"\\n\n                                    class=\"form-control\"\\n\n                                    @change=\"onFileChange($event)\"\\n\n                                >\\n\n                                <div x-show=\"quoteFileName\" class=\"small text-secondary mt-1\" x-text=\"quoteFileName\"></div>\\n\n                                <div class=\"form-hint\">Scanned dealer quotes are read with OCR automatically.</div>\\n\n                            </div>\\n\n\\n\n                            <div class=\"hr-text\">or</div>\\n\n\\n\n                            <div class=\"row g-3\">\\n\n                                <div class=\"col-12 col-lg-6\">\\n\n                                    <label class=\"form-label\" for=\"dealer-quote-text\">Paste copied text</label>\\n\n                                    <textarea\\n\n                                        id=\"dealer-quote-text\"\\n\n                                        x-model=\"quoteText\"\\n\n                                        rows=\"12\"\\n\n                                        class=\"form-control font-monospace small\"\\n\n                                        placeholder=\"1  06J-103-603-BD  Upper Oil Sump  406.08\"\\n\n                                    ></textarea>\\n\n                                </div>\\n\n\\n\n                                <div class=\"col-12 col-lg-6\">\\n\n                                    <div class=\"form-label\">Parts preview</div>\\n\n                                    <div class=\"border rounded p-2 small overflow-auto\" style=\"height: 17.5rem\">\\n\n                                        <template x-if=\"uploadPreviewLines().length === 0\">\\n\n                                            <p class=\"text-secondary mb-0\">Paste a quote to see part lines here \u00b7 Analyze to confirm.</p>\\n\n                                        </template>\\n\n                                        <div x-show=\"uploadPreviewLines().length > 0\" class=\"list-group list-group-flush\">\\n\n                                            <template x-for=\"(preview, previewIndex) in uploadPreviewLines()\" :key=\"'preview-' + previewIndex\">\\n\n                                                <div class=\"list-group-item d-flex gap-2 px-1\">\\n\n                                                    <span class=\"text-secondary ark-money flex-shrink-0\" style=\"width: 1.5rem\" x-text=\"preview.quantity\"></span>\\n\n                                                    <span class=\"flex-fill\" style=\"min-width: 0\">\\n\n                                                        <span class=\"d-block font-monospace\" x-text=\"preview.part_number || '-'\"></span>\\n\n                                                        <span class=\"d-block text-secondary\" x-text=\"preview.description || 'Part line'\"></span>\\n\n                                                    </span>\\n\n                                                    <span class=\"flex-shrink-0 ark-money\" x-text=\"preview.part_cost ? ('$' + preview.part_cost) : ''\"></span>\\n\n                                                </div>\\n\n                                            </template>\\n\n                                        </div>\\n\n                                    </div>\\n\n                                </div>\\n\n                            </div>\\n\n\\n\n                            <div class=\"btn-list justify-content-end mt-3\">\\n\n                                <button type=\"button\" class=\"btn\" @click=\"closeCapture()\">Cancel</button>\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    :disabled=\"analyzing || (! quoteFile && ! quoteText.trim())\"\\n\n                                    @click=\"analyzeQuote()\"\\n\n                                >\\n\n                                    <span x-text=\"analyzing ? 'Reading quote\u2026' : 'Analyze Quote'\"></span>\\n\n                                </button>\\n\n                            </div>\\n\n                        </div>\\n\n\\n\n                        <template x-if=\"step === 'review' && capture\">\\n\n                        <div>\\n\n                            <div class=\"datagrid mb-3\">\\n\n                                <div class=\"datagrid-item\">\\n\n                                    <div class=\"datagrid-title\">Supplier</div>\\n\n                                    <div class=\"datagrid-content\" x-text=\"capture.supplier_name || '-'\"></div>\\n\n                                </div>\\n\n                                <div class=\"datagrid-item\">\\n\n                                    <div class=\"datagrid-title\">Quote #</div>\\n\n                                    <div class=\"datagrid-content\" x-text=\"capture.quote_number || '-'\"></div>\\n\n                                </div>\\n\n                                <div class=\"datagrid-item\">\\n\n                                    <div class=\"datagrid-title\">Vehicle</div>\\n\n                                    <div class=\"datagrid-content\" x-text=\"capture.vehicle_description || '-'\"></div>\\n\n                                </div>\\n\n                                <div class=\"datagrid-item\">\\n\n                                    <div class=\"datagrid-title\">VIN</div>\\n\n                                    <div class=\"datagrid-content text-break\" x-text=\"capture.vin || '-'\"></div>\\n\n                                </div>\\n\n                            </div>\\n\n\\n\n                            <form method=\"POST\" :action=\"importUrl\" @submit=\"beforeSubmit($event)\" data-dealer-quote-import-form>\\n\n                                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                                <input type=\"hidden\" name=\"capture[supplier_name]\" :value=\"capture.supplier_name || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[quote_number]\" :value=\"capture.quote_number || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[vehicle_description]\" :value=\"capture.vehicle_description || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[vin]\" :value=\"capture.vin || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[dealer_total_cents]\" :value=\"capture.dealer_total_cents || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[raw_text]\" :value=\"capture.raw_text || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[original_filename]\" :value=\"capture.original_filename || ''\">\\n\n                                <input type=\"hidden\" name=\"capture[temp_storage_path]\" :value=\"capture.temp_storage_path || ''\">\\n\n\\n\n                                <template x-for=\"(line, index) in capture.lines\" :key=\"line.source_key\">\\n\n                                    <div>\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][source_key]'\" :value=\"line.source_key\">\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][quantity]'\" :value=\"line.quantity\">\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][part_number]'\" :value=\"line.part_number || ''\">\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][description]'\" :value=\"line.description\">\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][part_cost]'\" :value=\"line.part_cost\">\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][unit_cost_cents]'\" :value=\"line.unit_cost_cents || ''\">\\n\n                                        <input type=\"hidden\" :name=\"'capture[lines][' + index + '][extended_cost_cents]'\" :value=\"line.extended_cost_cents || ''\">\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-for=\"(row, index) in rows\" :key=\"'assign-' + row.source_key\">\\n\n                                    <div>\\n\n                                        <input type=\"hidden\" :name=\"'assignments[' + index + '][source_key]'\" :value=\"row.source_key\">\\n\n                                        <input\\n\n                                            type=\"hidden\"\\n\n                                            :name=\"'assignments[' + index + '][repair_order_concern_id]'\"\\n\n                                            :value=\"row.selected && row.concern_id ? row.concern_id : ''\"\\n\n                                        >\\n\n                                        <input\\n\n                                            type=\"hidden\"\\n\n                                            :name=\"'assignments[' + index + '][repair_order_work_group_id]'\"\\n\n                                            :value=\"row.selected && row.work_group_id ? row.work_group_id : ''\"\\n\n                                        >\\n\n                                        <template x-if=\"row.selected && row.concern_id\">\\n\n                                            <div>\\n\n                                                <input type=\"hidden\" :name=\"'assignments[' + index + '][part_cost]'\" :value=\"row.part_cost\">\\n\n                                                <input type=\"hidden\" :name=\"'assignments[' + index + '][description]'\" :value=\"row.description\">\\n\n                                                <input\\n\n                                                    type=\"hidden\"\\n\n                                                    :name=\"'assignments[' + index + '][pricing_matrix_key]'\"\\n\n                                                    :value=\"row.pricing_matrix_explicit && row.pricing_matrix_key ? row.pricing_matrix_key : ''\"\\n\n                                                >\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <details class=\"card card-sm mb-3\" open>\\n\n                                    <summary class=\"card-body py-2 subheader\">\\n\n                                        Quote text \u00b7 <span x-text=\"rows.length\"></span> parts\\n\n                                    </summary>\\n\n                                    <pre\\n\n                                        class=\"card-body border-top mb-0 small overflow-auto\"\\n\n                                        style=\"max-height: 9rem; white-space: pre-wrap\"\\n\n                                        x-text=\"capture.raw_text || quoteText || '-'\"\\n\n                                    ></pre>\\n\n                                </details>\\n\n\\n\n                                <div class=\"row g-2 align-items-end mb-3\" data-dealer-quote-bulk>\\n\n                                    <div class=\"col-12 col-sm\">\\n\n                                        <label class=\"form-label\" for=\"dealer-quote-bulk-concern\">Scope</label>\\n\n                                        <select\\n\n                                            id=\"dealer-quote-bulk-concern\"\\n\n                                            x-model=\"bulk.concern_id\"\\n\n                                            @change=\"onBulkConcernChange()\"\\n\n                                            class=\"form-select form-select-sm\"\\n\n                                        >\\n\n                                            <option value=\"\">Choose scope</option>\\n\n                                            <template x-for=\"concern in concerns\" :key=\"'bulk-c-' + concern.id\">\\n\n                                                <option :value=\"concern.id\" x-text=\"concern.summary\"></option>\\n\n                                            </template>\\n\n                                        </select>\\n\n                                    </div>\\n\n                                    <div class=\"col-6 col-sm-auto\">\\n\n                                        <label class=\"form-label\" for=\"dealer-quote-bulk-work-group\">Repair action</label>\\n\n                                        <select\\n\n                                            id=\"dealer-quote-bulk-work-group\"\\n\n                                            x-model=\"bulk.work_group_id\"\\n\n                                            class=\"form-select form-select-sm\"\\n\n                                            :disabled=\"workGroupsForConcern(bulk.concern_id).length === 0\"\\n\n                                        >\\n\n                                            <option value=\"\">Scope</option>\\n\n                                            <template x-for=\"workGroup in workGroupsForConcern(bulk.concern_id)\" :key=\"'bulk-wg-' + workGroup.id\">\\n\n                                                <option :value=\"workGroup.id\" x-text=\"workGroup.title\"></option>\\n\n                                            </template>\\n\n                                        </select>\\n\n                                    </div>\\n\n                                    <div class=\"col-6 col-sm-auto\">\\n\n                                        <label class=\"form-label\" for=\"dealer-quote-bulk-matrix\">Matrix</label>\\n\n                                        <select\\n\n                                            id=\"dealer-quote-bulk-matrix\"\\n\n                                            x-model=\"bulk.pricing_matrix_key\"\\n\n                                            class=\"form-select form-select-sm\"\\n\n                                        >\\n\n                                            <option value=\"\">Default</option>\\n\n                                            <template x-for=\"matrix in partsMatrices\" :key=\"'bulk-m-' + matrix.key\">\\n\n                                                <option :value=\"matrix.key\" x-text=\"matrixShortName(matrix)\"></option>\\n\n                                            </template>\\n\n                                        </select>\\n\n                                    </div>\\n\n                                    <div class=\"col-12 col-sm-auto\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"btn btn-sm w-100\"\\n\n                                            @click=\"applyToSelected()\"\\n\n                                            :disabled=\"importing || selectedCount() === 0\"\\n\n                                        >\\n\n                                            Apply to selected\\n\n                                        </button>\\n\n                                    </div>\\n\n                                </div>\\n\n\\n\n                                <div class=\"table-responsive border rounded\">\\n\n                                    <table class=\"table table-sm table-vcenter card-table mb-0\">\\n\n                                        <thead>\\n\n                                            <tr>\\n\n                                                <th class=\"w-1\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        class=\"form-check-input\"\\n\n                                                        aria-label=\"Select all parts\"\\n\n                                                        x-model=\"allSelected\"\\n\n                                                    >\\n\n                                                </th>\\n\n                                                <th class=\"text-end\">Qty</th>\\n\n                                                <th>Part #</th>\\n\n                                                <th style=\"min-width: 12rem\">Name</th>\\n\n                                                <th class=\"text-end\">Cost</th>\\n\n                                                <th class=\"text-end\">Sell</th>\\n\n                                                <th style=\"width: 5.5rem\">Matrix</th>\\n\n                                                <th style=\"min-width: 8rem\">Scope</th>\\n\n                                                <th style=\"width: 7.5rem\">Action</th>\\n\n                                            </tr>\\n\n                                        </thead>\\n\n                                        <tbody>\\n\n                                            <template x-for=\"row in rows\" :key=\"row.source_key\">\\n\n                                                <tr :class=\"row.selected ? '' : 'opacity-50'\">\\n\n                                                    <td>\\n\n                                                        <input type=\"checkbox\" x-model=\"row.selected\" class=\"form-check-input\" :aria-label=\"'Add ' + (row.description || 'part')\">\\n\n                                                    </td>\\n\n                                                    <td class=\"text-end ark-money\" x-text=\"row.quantity\"></td>\\n\n                                                    <td class=\"font-monospace small\" x-text=\"row.part_number || '-'\"></td>\\n\n                                                    <td>\\n\n                                                        <input\\n\n                                                            type=\"text\"\\n\n                                                            x-model=\"row.description\"\\n\n                                                            aria-label=\"Part name\"\\n\n                                                            class=\"form-control form-control-sm\"\\n\n                                                            style=\"min-width: 11rem\"\\n\n                                                        >\\n\n                                                    </td>\\n\n                                                    <td class=\"text-end\">\\n\n                                                        <input\\n\n                                                            type=\"text\"\\n\n                                                            inputmode=\"decimal\"\\n\n                                                            x-model=\"row.part_cost\"\\n\n                                                            @input=\"onRowCostInput(row)\"\\n\n                                                            aria-label=\"Cost\"\\n\n                                                            class=\"form-control form-control-sm text-end ark-money\"\\n\n                                                            style=\"width: 5rem\"\\n\n                                                        >\\n\n                                                    </td>\\n\n                                                    <td class=\"text-end ark-money\" x-text=\"row.sell || '-'\"></td>\\n\n                                                    <td>\\n\n                                                        <select\\n\n                                                            x-model=\"row.pricing_matrix_key\"\\n\n                                                            @change=\"onRowMatrixChange(row)\"\\n\n                                                            aria-label=\"Matrix\"\\n\n                                                            class=\"form-select form-select-sm\"\\n\n                                                            style=\"max-width: 5.5rem\"\\n\n                                                        >\\n\n                                                            <template x-for=\"matrix in partsMatrices\" :key=\"row.source_key + '-m-' + matrix.key\">\\n\n                                                                <option :value=\"matrix.key\" x-text=\"matrixShortName(matrix)\"></option>\\n\n                                                            </template>\\n\n                                                        </select>\\n\n                                                    </td>\\n\n                                                    <td>\\n\n                                                        <select\\n\n                                                            x-model=\"row.concern_id\"\\n\n                                                            @change=\"onRowConcernChange(row)\"\\n\n                                                            aria-label=\"Scope\"\\n\n                                                            class=\"form-select form-select-sm\"\\n\n                                                        >\\n\n                                                            <option value=\"\">Choose scope</option>\\n\n                                                            <template x-for=\"concern in concerns\" :key=\"row.source_key + '-c-' + concern.id\">\\n\n                                                                <option :value=\"concern.id\" x-text=\"concern.summary\"></option>\\n\n                                                            </template>\\n\n                                                        </select>\\n\n                                                    </td>\\n\n                                                    <td>\\n\n                                                        <select\\n\n                                                            x-model=\"row.work_group_id\"\\n\n                                                            @change=\"onRowWorkGroupChange(row)\"\\n\n                                                            aria-label=\"Repair action\"\\n\n                                                            class=\"form-select form-select-sm\"\\n\n                                                            style=\"max-width: 7.5rem\"\\n\n                                                            :disabled=\"workGroupsForConcern(row.concern_id).length === 0\"\\n\n                                                        >\\n\n                                                            <option value=\"\">Scope</option>\\n\n                                                            <template x-for=\"workGroup in workGroupsForConcern(row.concern_id)\" :key=\"row.source_key + '-wg-' + workGroup.id\">\\n\n                                                                <option :value=\"workGroup.id\" x-text=\"workGroup.title\"></option>\\n\n                                                            </template>\\n\n                                                        </select>\\n\n                                                    </td>\\n\n                                                </tr>\\n\n                                            </template>\\n\n                                        </tbody>\\n\n                                    </table>\\n\n                                </div>\\n\n\\n\n                                <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3\">\\n\n                                    <div class=\"small text-secondary\">\\n\n                                        <span class=\"fw-bold\">Dealer total</span>\\n\n                                        $<span class=\"ark-money\" x-text=\"capture.dealer_total || selectedDealerTotal()\"></span>\\n\n                                        \u00b7 Detected <span x-text=\"rows.length\"></span> parts\\n\n                                        \u00b7 Adding <span x-text=\"selectedCount()\"></span>\\n\n                                    </div>\\n\n                                    <div class=\"btn-list\">\\n\n                                        <button type=\"button\" class=\"btn\" @click=\"resetUpload()\" :disabled=\"importing\">Back</button>\\n\n                                        <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"importing || selectedCount() === 0\">\\n\n                                            <span x-text=\"importing ? 'Adding\u2026' : ('Add ' + selectedCount() + ' Parts to Estimate')\"></span>\\n\n                                        </button>\\n\n                                    </div>\\n\n                                </div>\\n\n                            </form>\\n\n                        </div>\\n\n                        </template>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n                                            </div>\\n\n\\n\n                                                \\n\n                        <div id=\"worksheet-concerns\" class=\"d-flex flex-column gap-3\">\\n\n                                                                                <section\\n\n                                id=\"concern-1\"\\n\n                                class=\"card scroll-mt-24\"\\n\n                                data-concern-priority=\"unset\"\\n\n                                data-concern-disposition=\"draft\"\\n\n                                data-concern-ordinal=\"1\"\\n\n                            >\\n\n                                <div class=\"card-header align-items-start flex-wrap gap-2 ops-concern-header-accent\">\\n\n        <div class=\"flex-fill\" style=\"min-width: 0\">\\n\n                            <div class=\"subheader mb-1 text-secondary\">Concern 1 \u00b7 </div>\\n\n                        <h3 class=\"card-title mb-0\">Check engine light</h3>\\n\n                            \\n\n                    </div>\\n\n                    <div class=\"d-flex flex-column align-items-end gap-1 ms-auto\">\\n\n                                    <div\\n\n                        class=\"h3 mb-0\"\\n\n                         id=\"concern-money-1\" data-continuity-region=\"concern-money\"                     >$0.00</div>\\n\n                                                    <div id=\"concern-authorization-1\" data-continuity-region=\"concern-authorization\">\\n\n    </div>\\n\n                            </div>\\n\n            </div>\\n\n            <div class=\"card-body border-bottom py-2 d-flex flex-wrap align-items-center gap-2\">\\n\n            <div class=\"d-flex flex-wrap flex-fill align-items-center justify-content-between gap-2\" data-scope-settings>\\n\n    <div class=\"d-flex flex-wrap align-items-center gap-2\" data-concern-status-controls>\\n\n                \\n\n        <div id=\"concern-disposition-1\" class=\"d-flex flex-wrap align-items-center gap-2\" data-continuity-region=\"concern-authorization\">\\n\n            <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/concerns/1/disposition\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-worksheet-continuity\\n\n        data-continuity-focus=\"#concern-1 [data-concern-decision-choices] .dropdown-toggle\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n        <input type=\"hidden\" name=\"disposition\" value=\"draft\">\\n\n        <div class=\"dropdown\" data-concern-decision-choices>\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                aria-expanded=\"false\"\\n\n                aria-label=\"Customer decision for Check engine light: Draft\"\\n\n                data-disposition-tone=\"draft\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-1\"><path d=\"M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4\"/><path d=\"M13.5 6.5l4 4\"/></svg>\\n\n                <span class=\"fw-medium\">Draft</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu\">\\n\n                <h6 class=\"dropdown-header\">Customer decision</h6>\\n\n                                                        \\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Still being built; not on the customer-facing total.\"\\n\n                        data-disposition-option=\"draft\"\\n\n                                                    aria-current=\"true\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-2\"><path d=\"M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4\"/><path d=\"M13.5 6.5l4 4\"/></svg>\\n\n                        <span class=\"me-3\">Draft</span>\\n\n                                                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon ms-auto text-primary\"><path d=\"M5 12l5 5l10 -10\"/></svg>\\n\n                                            </button>\\n\n                                                        \\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Suggested work; on the estimate until other scopes are approved.\"\\n\n                        data-disposition-option=\"recommended\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.disposition.value = 'recommended'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-blue me-2\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M12 7v5l3 3\"/></svg>\\n\n                        <span class=\"me-3\">Pending Approval</span>\\n\n                                            </button>\\n\n                                                        \\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Customer authorized; counts toward invoice and balance due.\"\\n\n                        data-disposition-option=\"approved\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.disposition.value = 'approved'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-green me-2\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M9 12l2 2l4 -4\"/></svg>\\n\n                        <span class=\"me-3\">Approved</span>\\n\n                                            </button>\\n\n                                                        \\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Not approved today; retained for a future visit follow-up.\"\\n\n                        data-disposition-option=\"deferred\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.disposition.value = 'deferred'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-yellow me-2\"><path d=\"M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4\"/><path d=\"M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0\"/><path d=\"M15 3v4\"/><path d=\"M7 3v4\"/><path d=\"M3 11h16\"/><path d=\"M18 16.496v1.504l1 1\"/></svg>\\n\n                        <span class=\"me-3\">Deferred</span>\\n\n                                            </button>\\n\n                                                        \\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Customer declined this work; not a follow-up opportunity.\"\\n\n                        data-disposition-option=\"declined\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.disposition.value = 'declined'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-red me-2\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M10 10l4 4m0 -4l-4 4\"/></svg>\\n\n                        <span class=\"me-3\">Declined</span>\\n\n                                            </button>\\n\n                            </div>\\n\n        </div>\\n\n    </form>\\n\n            <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/concerns/1/production-status\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-continuity-focus=\"#concern-1 [data-concern-work-status-choices] .dropdown-toggle\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <input type=\"hidden\" name=\"production_status\" value=\"pending\">\\n\n        <div class=\"dropdown\" data-concern-work-status-choices>\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                aria-expanded=\"false\"\\n\n                aria-label=\"Work status for Check engine light: Not started\"\\n\n                data-production-current=\"pending\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-1\"><path d=\"M8.56 3.69a9 9 0 0 0 -2.92 1.95\"/><path d=\"M3.69 8.56a9 9 0 0 0 -.69 3.44\"/><path d=\"M3.69 15.44a9 9 0 0 0 1.95 2.92\"/><path d=\"M8.56 20.31a9 9 0 0 0 3.44 .69\"/><path d=\"M15.44 20.31a9 9 0 0 0 2.92 -1.95\"/><path d=\"M20.31 15.44a9 9 0 0 0 .69 -3.44\"/><path d=\"M20.31 8.56a9 9 0 0 0 -1.95 -2.92\"/><path d=\"M15.44 3.69a9 9 0 0 0 -3.44 -.69\"/></svg>\\n\n                <span class=\"fw-medium\">Not started</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu\">\\n\n                <h6 class=\"dropdown-header\">Work status</h6>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Approved scope not started in the bay yet.\"\\n\n                        data-production-option=\"pending\"\\n\n                                                    aria-current=\"true\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-2\"><path d=\"M8.56 3.69a9 9 0 0 0 -2.92 1.95\"/><path d=\"M3.69 8.56a9 9 0 0 0 -.69 3.44\"/><path d=\"M3.69 15.44a9 9 0 0 0 1.95 2.92\"/><path d=\"M8.56 20.31a9 9 0 0 0 3.44 .69\"/><path d=\"M15.44 20.31a9 9 0 0 0 2.92 -1.95\"/><path d=\"M20.31 15.44a9 9 0 0 0 .69 -3.44\"/><path d=\"M20.31 8.56a9 9 0 0 0 -1.95 -2.92\"/><path d=\"M15.44 3.69a9 9 0 0 0 -3.44 -.69\"/></svg>\\n\n                        <span class=\"me-3\">Not started</span>\\n\n                                                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon ms-auto text-primary\"><path d=\"M5 12l5 5l10 -10\"/></svg>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Technician is actively working this scope.\"\\n\n                        data-production-option=\"in_progress\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.production_status.value = 'in_progress'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-azure me-2\"><path d=\"M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5\"/></svg>\\n\n                        <span class=\"me-3\">In progress</span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Scope is blocked on parts or an outside dependency.\"\\n\n                        data-production-option=\"waiting_parts\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.production_status.value = 'waiting_parts'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-yellow me-2\"><path d=\"M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5\"/><path d=\"M12 12l8 -4.5\"/><path d=\"M12 12l0 9\"/><path d=\"M12 12l-8 -4.5\"/><path d=\"M16 5.25l-8 4.5\"/></svg>\\n\n                        <span class=\"me-3\">Waiting parts</span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"This scope is finished - independent of other scopes on the RO.\"\\n\n                        data-production-option=\"completed\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.production_status.value = 'completed'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-green me-2\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M9 12l2 2l4 -4\"/></svg>\\n\n                        <span class=\"me-3\">Completed</span>\\n\n                                            </button>\\n\n                                            </div>\\n\n        </div>\\n\n    </form>\\n\n        </div>\\n\n        <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/concerns/1/billing-posture\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-continuity-focus=\"#concern-1 [data-concern-billing-choices] .dropdown-toggle\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n        <input type=\"hidden\" name=\"billing_posture\" value=\"customer_pay\">\\n\n        <div class=\"dropdown\" data-concern-billing-choices>\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                aria-expanded=\"false\"\\n\n                aria-label=\"Billing for Check engine light: Retail (Customer default), $165.00/hr \u00b7 AFT Parts \u00b7 No shop fees\"\\n\n                title=\"Retail (Customer default) \u00b7 Customer pays; shop fees apply on eligible lines at the shop rate. \u00b7 $165.00/hr labor \u00b7 AFT Parts parts \u00b7 No shop fees\"\\n\n                data-billing-current=\"customer_pay\"\\n\n                data-billing-source=\"customer\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-1\"><path d=\"M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16l-3 -2l-2 2l-2 -2l-2 2l-2 -2l-3 2m4 -14h6m-6 4h6m-2 4h2\"/></svg>\\n\n                <span class=\"fw-medium\">Retail (Customer default)</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu\">\\n\n                <h6 class=\"dropdown-header\">Billing</h6>\\n\n                                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Retail \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"customer_pay\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'customer_pay'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Retail</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 AFT Parts \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Fleet \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"fleet\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'fleet'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Fleet</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 AFT Parts \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Warranty \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"warranty_other\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'warranty_other'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Warranty</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"RepairPal \u00b7 $150.00/hr\"\\n\n                        data-billing-option=\"repairpal\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'repairpal'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>RepairPal</span>\\n\n                            <span class=\"small text-secondary\">$150.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Internal \u00b7 $0.00/hr\"\\n\n                        data-billing-option=\"internal\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'internal'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Internal</span>\\n\n                            <span class=\"small text-secondary\">$0.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Wholesale \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"wholesale\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'wholesale'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Wholesale</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 AFT Parts \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Comeback \u00b7 $0.00/hr\"\\n\n                        data-billing-option=\"comeback\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'comeback'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Comeback</span>\\n\n                            <span class=\"small text-secondary\">$0.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                            </div>\\n\n        </div>\\n\n    </form>\\n\n        <div class=\"dropdown\" data-concern-warranty-choices>\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"btn btn-sm dropdown-toggle\"\\n\n            data-bs-toggle=\"dropdown\"\\n\n            data-bs-auto-close=\"outside\"\\n\n            aria-expanded=\"false\"\\n\n            aria-label=\"Warranty for Check engine light: 24-month / 24,000-mile parts and labor\"\\n\n            title=\"24-month / 24,000-mile parts and labor\"\\n\n            data-warranty-source=\"shop\"\\n\n            data-warranty-inherits=\"1\"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-1\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M9 12l2 2l4 -4\"/></svg>\\n\n            <span class=\"fw-medium\">Warranty</span>\\n\n            <span class=\"small text-secondary ms-1 d-none d-xl-inline\">24-month / 24,000-mile parts...</span>\\n\n        </button>\\n\n        <div class=\"dropdown-menu dropdown-menu-card p-3\" style=\"min-width: 18rem;\">\\n\n            <div class=\"mb-2\">\\n\n                <div class=\"subheader mb-1\">Effective warranty</div>\\n\n                <div class=\"small\">24-month / 24,000-mile parts and labor</div>\\n\n                <div class=\"form-hint mb-0\">\\n\n                                            Inherited from the billing class on this repair order\u2019s frozen pricing.\\n\n                                    </div>\\n\n            </div>\\n\n\\n\n            \\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/concerns/1/warranty\"\\n\n                data-refresh-scope=\"worksheet\"\\n\n                data-continuity-focus=\"#concern-1 [data-concern-warranty-choices] .dropdown-toggle\"\\n\n                @submit.prevent=\"submitWorksheetForm($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <input type=\"hidden\" name=\"action\" value=\"override\">\\n\n                <div class=\"subheader mb-2\">Override for this concern</div>\\n\n                <div class=\"row g-2 mb-2\">\\n\n                    <div class=\"col-6\">\\n\n                        <label class=\"form-label mb-1\">Months</label>\\n\n                        <input type=\"number\" min=\"0\" name=\"warranty[months]\" class=\"form-control form-control-sm\" value=\"24\">\\n\n                    </div>\\n\n                    <div class=\"col-6\">\\n\n                        <label class=\"form-label mb-1\">Miles</label>\\n\n                        <input type=\"number\" min=\"0\" name=\"warranty[miles]\" class=\"form-control form-control-sm\" value=\"24000\">\\n\n                    </div>\\n\n                    <div class=\"col-12\">\\n\n                        <label class=\"form-check\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" name=\"warranty[covers_parts]\" value=\"1\" checked>\\n\n                            <span class=\"form-check-label\">Covers parts</span>\\n\n                        </label>\\n\n                        <label class=\"form-check\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" name=\"warranty[covers_labor]\" value=\"1\" checked>\\n\n                            <span class=\"form-check-label\">Covers labor</span>\\n\n                        </label>\\n\n                        <label class=\"form-check\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" name=\"warranty[third_party]\" value=\"1\" >\\n\n                            <span class=\"form-check-label\">Third-party</span>\\n\n                        </label>\\n\n                    </div>\\n\n                    <div class=\"col-12\">\\n\n                        <label class=\"form-label mb-1\">Description</label>\\n\n                        <textarea name=\"warranty[description]\" class=\"form-control form-control-sm\" rows=\"2\">Shop warranty on parts and labor for the covered repair.</textarea>\\n\n                    </div>\\n\n                    <div class=\"col-12\">\\n\n                        <label class=\"form-label mb-1\">Exclusions</label>\\n\n                        <textarea name=\"warranty[exclusions]\" class=\"form-control form-control-sm\" rows=\"2\">Customer-supplied and used parts may carry no warranty. Normal wear items and abuse are excluded.</textarea>\\n\n                    </div>\\n\n                </div>\\n\n                <button type=\"submit\" class=\"btn btn-primary btn-sm w-100\" data-warranty-action=\"override\">\\n\n                    Save concern warranty\\n\n                </button>\\n\n            </form>\\n\n        </div>\\n\n    </div>\\n\n    </div>\\n\n    <div class=\"d-flex flex-wrap align-items-center gap-1\">\\n\n                <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/concerns/1/move\" data-refresh-scope=\"worksheet\" data-continuity-focus=\"#concern-1 button[name='move-up']\" @submit.prevent=\"submitWorksheetForm($event)\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n            <input type=\"hidden\" name=\"direction\" value=\"up\">\\n\n            <button type=\"submit\" name=\"move-up\" disabled class=\"btn btn-sm btn-icon btn-ghost-secondary\" aria-label=\"Move scope up\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 11l-6 -6\"/><path d=\"M6 11l6 -6\"/></svg>\\n\n            </button>\\n\n        </form>\\n\n        <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/concerns/1/move\" data-refresh-scope=\"worksheet\" data-continuity-focus=\"#concern-1 button[name='move-down']\" @submit.prevent=\"submitWorksheetForm($event)\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n            <input type=\"hidden\" name=\"direction\" value=\"down\">\\n\n            <button type=\"submit\" name=\"move-down\" disabled class=\"btn btn-sm btn-icon btn-ghost-secondary\" aria-label=\"Move scope down\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n            </button>\\n\n        </form>\\n\n                                    <form\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/repair-orders/1/concerns/1/move-to-new-ro\"\\n\n                    onsubmit=\"return confirm('Move this entire scope and all its lines to a new draft repair order for the same vehicle?')\"\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                    <button\\n\n                        type=\"submit\"\\n\n                        class=\"btn btn-sm btn-ghost-secondary\"\\n\n                        title=\"Move this complete scope onto a new draft repair order\"\\n\n                    >\\n\n                        Move to new RO\\n\n                    </button>\\n\n                </form>\\n\n                                                                    <div\\n\n                    class=\"d-flex flex-wrap align-items-center gap-1\"\\n\n                    x-data=\"{\\n\n                        confirmDelete: false,\\n\n                        confirmTimer: null,\\n\n                        armDelete() {\\n\n                            this.confirmDelete = true;\\n\n                            this.clearDeleteTimer();\\n\n                            this.confirmTimer = setTimeout(() => {\\n\n                                this.confirmDelete = false;\\n\n                                this.confirmTimer = null;\\n\n                            }, 3000);\\n\n                        },\\n\n                        cancelDelete() {\\n\n                            this.clearDeleteTimer();\\n\n                            this.confirmDelete = false;\\n\n                        },\\n\n                        clearDeleteTimer() {\\n\n                            if (this.confirmTimer) {\\n\n                                clearTimeout(this.confirmTimer);\\n\n                                this.confirmTimer = null;\\n\n                            }\\n\n                        },\\n\n                        worksheetController() {\\n\n                            const root = this.$el.closest('[data-worksheet-root]');\\n\n                            if (! root || typeof window.Alpine?.$data !== 'function') {\\n\n                                return null;\\n\n                            }\\n\n                            return window.Alpine.$data(root);\\n\n                        },\\n\n                        async submitDelete(event) {\\n\n                            if (! this.confirmDelete) {\\n\n                                event.preventDefault();\\n\n                                this.armDelete();\\n\n                                return;\\n\n                            }\\n\n                            this.clearDeleteTimer();\\n\n                            const worksheet = this.worksheetController();\\n\n                            if (typeof worksheet?.submitWorksheetForm !== 'function') {\\n\n                                if (typeof worksheet?.surfaceWorksheetMessage === 'function') {\\n\n                                    worksheet.surfaceWorksheetMessage(\\n\n                                        'Could not update this repair order. Refresh and try again.',\\n\n                                        { tone: 'error' },\\n\n                                    );\\n\n                                } else if (typeof window.arkOpsToast === 'function') {\\n\n                                    window.arkOpsToast('Could not update this repair order. Refresh and try again.');\\n\n                                }\\n\n                                return;\\n\n                            }\\n\n                            await worksheet.submitWorksheetForm(event);\\n\n                        },\\n\n                    }\"\\n\n                >\\n\n                    <form\\n\n                        method=\"POST\"\\n\n                        action=\"http://localhost/app/repair-orders/1/concerns/1\"\\n\n                        data-refresh-scope=\"worksheet\"\\n\n                        data-continuity-focus=\"#concern-store [name='summary']\"\\n\n                        @submit.prevent=\"submitDelete($event)\"\\n\n                    >\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"WkNlxt8DJ1IB1pKGddkMYjGJ4ee5aMzZsd4RMaZc\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">                        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            x-show=\"! confirmDelete\"\\n\n                            class=\"btn btn-sm btn-ghost-danger\"\\n\n                            aria-label=\"Delete concern\"\\n\n                            title=\"Remove this unlinked concern (requires confirmation)\"\\n\n                            @click=\"armDelete()\"\\n\n                        >\\n\n                            Delete concern\\n\n                        </button>\\n\n                        <button\\n\n                            type=\"submit\"\\n\n                            x-show=\"confirmDelete\"\\n\n                            x-cloak\\n\n                            class=\"btn btn-sm btn-danger\"\\n\n                            aria-label=\"Confirm delete concern\"\\n\n                        >\\n\n                            Confirm delete\\n\n                        </button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            x-show=\"confirmDelete\"\\n\n                            x-cloak\\n\n                            class=\"btn btn-sm\"\\n\n                            aria-label=\"Cancel delete concern\"\\n\n                            @click=\"cancelDelete()\"\\n\n                        >\\n\n                            Cancel\\n\n                        </button>\\n\n                    </form>\\n\n                </div>\\n\n                        </div>\\n\n</div>\\n\n        </div>\\n\n    \\n\n                                <div id=\"concern-narrative-1\" class=\"card-body border-bottom\" data-concern-narrative>\\n\n    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2\">\\n\n        <h4 class=\"subheader mb-0\">Narrative</h4>\\n\n                    <div class=\"btn-list\">\\n\n                                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'concern-narrative', context: { concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    Edit\\n\n                </button>\\n\n            </div>\\n\n            </div>\\n\n\\n\n    <div class=\"d-flex align-items-start justify-content-between gap-2\">\\n\n        <p class=\"fw-medium mb-2\">Check engine light</p>\\n\n                                </div>\\n\n\\n\n            <p class=\"text-secondary mb-0\">No customer story or findings recorded yet.</p>\\n\n    \\n\n    <p class=\"small text-secondary mt-2 mb-0\">\\n\n            Faster with evidence?\\n\n            <a href=\"http://localhost/app/repair-orders/1/inspection?capture=1&amp;concern=1\">Open Inspection</a>\\n\n            - photo and measurement beat prose alone.\\n\n        </p>\\n\n    \\n\n    </div>\\n\n\\n\n                                <div id=\"concern-lines-1\" class=\"list-group list-group-flush\">\\n\n    \\n\n    </div>\\n\n\\n\n    \\n\n            \\n\n                <div class=\"card-body py-2 btn-list\" data-scope-compose=\"1\">\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm\"\\n\n                aria-label=\"Add Common Job\"\\n\n                title=\"Add Common Job to this concern\"\\n\n                @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'saved-work', context: { concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n            >\\n\n                <span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\\n\n                <path d=\"M5.2 2.2h9.6c.7 0 1.2.5 1.2 1.2v14.1c0 .4-.4.6-.7.5L10 14.6 4.7 18c-.3.1-.7-.1-.7-.5V3.4c0-.7.5-1.2 1.2-1.2Z\"/>\\n\n            </svg>\\n\n            </span>\\n\n                <span class=\"ms-1\" data-compose-label>Common Job</span>\\n\n            </button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    aria-label=\"Add Labor\"\\n\n                    title=\"Add Labor\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'labor', context: { lineType: 'labor', concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    <span class=\"text-green d-inline-flex\"><span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\\n\n        