-types\\u0022,\\u0022work_type_archive\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/work-types\\\\\\/archive\\u0022,\\u0022work_type_restore\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/work-types\\\\\\/restore\\u0022,\\u0022work_type_destroy\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/work-types\\\\\\/destroy\\u0022,\\u0022billing_class\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\u0022,\\u0022billing_class_archive\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\\\\\/archive\\u0022,\\u0022billing_class_restore\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\\\\\/restore\\u0022,\\u0022billing_class_destroy\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/labor-matrix\\\\\\/billing-classes\\\\\\/destroy\\u0022,\\u0022customer_types_show\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/customer-types\\u0022,\\u0022customer_type_update\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/customer-types\\\\\\/__KEY__\\u0022,\\u0022customer_types_store\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/settings\\\\\\/shop\\\\\\/customer-types\\u0022}}'), 'mechanical')\"\\n\n    x-cloak\\n\n>\\n\n    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3\">\\n\n        <div>\\n\n            <h3 class=\"mb-1\">Labor rate matrix</h3>\\n\n            <p class=\"text-secondary small mb-0\">\\n\n                Select a work type, then set hourly rates, billing minimums, and rounding for each billing class.\\n\n                Mechanical is the Default Work Type. Changes apply to new repair orders only. Use $0.00 for no charge.\\n\n            </p>\\n\n        </div>\\n\n        <div class=\"small\" aria-live=\"polite\">\\n\n            <span class=\"text-secondary\" x-show=\"status === 'saving'\">Saving\u2026</span>\\n\n            <span class=\"text-success\" x-show=\"status === 'saved'\">All changes saved</span>\\n\n            <span class=\"text-danger\" x-show=\"status === 'error'\">\\n\n                Could not save \u2014\\n\n                <button type=\"button\" class=\"btn btn-link btn-sm p-0 align-baseline\" @click=\"retryLast()\">Retry</button>\\n\n            </span>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"ops-financial-master-detail\">\\n\n        <div class=\"ops-financial-master-detail__nav\">\\n\n            <div class=\"list-group list-group-flush border rounded\" data-labor-work-type-nav>\\n\n                <template x-for=\"workType in matrix.work_types\" :key=\"workType.key\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"list-group-item list-group-item-action ops-financial-master-detail__nav-item\"\\n\n                        :class=\"{ active: selectedWorkType === workType.key }\"\\n\n                        @click=\"selectWorkType(workType.key)\"\\n\n                        :data-labor-work-type=\"workType.key\"\\n\n                    >\\n\n                        <span class=\"ops-financial-master-detail__nav-label\" x-text=\"workType.label\"></span>\\n\n                        <span class=\"badge bg-azure-lt text-azure\" x-show=\"workType.is_default\">Default</span>\\n\n                    </button>\\n\n                </template>\\n\n            </div>\\n\n            <button type=\"button\" class=\"btn btn-outline-primary btn-sm w-100 mt-2\" @click=\"promptAddWorkType()\">\\n\n                + Add Work Type\\n\n            </button>\\n\n        </div>\\n\n\\n\n        <div class=\"ops-financial-master-detail__editor\">\\n\n            <div class=\"mb-2 d-flex flex-wrap align-items-start justify-content-between gap-2\">\\n\n                <div>\\n\n                    <h4 class=\"mb-0\" data-labor-selected-heading>\\n\n                        Rates for <span x-text=\"selectedWorkTypeLabel()\"></span>\\n\n                    </h4>\\n\n                    <p class=\"form-hint mb-0\">\\n\n                        Hourly Rate and Round To are this work type \u00d7 billing class. Min Hrs is shared for the billing class across all work types. Class Settings opens commercial configuration.\\n\n                    </p>\\n\n                </div>\\n\n                <div class=\"dropdown\" x-data=\"{ open: false }\" @click.outside=\"open = false\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-ghost-secondary btn-icon btn-sm\"\\n\n                        :aria-expanded=\"open\"\\n\n                        aria-haspopup=\"true\"\\n\n                        aria-label=\"Work type actions\"\\n\n                        title=\"Work type actions\"\\n\n                        @click=\"open = !open\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon icon icon-sm\"><path d=\"M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/></svg>\\n\n                    </button>\\n\n                    <div class=\"dropdown-menu dropdown-menu-end\" :class=\"{ show: open }\" x-show=\"open\" x-cloak>\\n\n                        <button type=\"button\" class=\"dropdown-item\" x-show=\"selectedWorkTypeMeta()?.can_archive\" @click=\"open = false; archiveSelectedWorkType()\">Archive work type</button>\\n\n                        <button type=\"button\" class=\"dropdown-item text-danger\" x-show=\"selectedWorkTypeMeta()?.can_archive\" @click=\"open = false; deleteSelectedWorkType()\">Delete work type</button>\\n\n                        <div class=\"dropdown-item-text text-secondary small\" x-show=\"!selectedWorkTypeMeta()?.can_archive\">\\n\n                            Choose another default before archiving or deleting this work type.\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n            <div class=\"table-responsive border rounded\">\\n\n                <table class=\"table table-vcenter table-sm mb-0 labor-matrix-table labor-matrix-table--hybrid\" data-labor-rate-editor>\\n\n                    <thead>\\n\n                        <tr>\\n\n                            <th class=\"labor-matrix-th\">Billing Class</th>\\n\n                            <th class=\"labor-matrix-th\" style=\"min-width: 7.5rem\">Hourly Rate</th>\\n\n                            <th class=\"labor-matrix-th\" style=\"min-width: 11rem\">\\n\n                                Min Hrs\\n\n                                <div class=\"form-hint mb-0 fw-normal\">Shared \u00b7 all work types</div>\\n\n                            </th>\\n\n                            <th class=\"labor-matrix-th\" style=\"min-width: 9.5rem\">\\n\n                                Round To\\n\n                                <div class=\"form-hint mb-0 fw-normal\">This work type \u00d7 class</div>\\n\n                            </th>\\n\n                            <th class=\"labor-matrix-th text-end\" style=\"width: 5.5rem\">Class</th>\\n\n                        </tr>\\n\n                    </thead>\\n\n                    <tbody>\\n\n                        <template x-for=\"column in matrix.columns\" :key=\"column.value\">\\n\n                            <tr :data-billing-class=\"column.value\">\\n\n                                <td class=\"py-1\">\\n\n                                    <div class=\"d-flex align-items-center gap-2 flex-wrap\">\\n\n                                        <span class=\"fw-medium\" x-text=\"column.label\"></span>\\n\n                                        <span class=\"badge bg-azure-lt text-azure\" x-show=\"column.is_shop_default\">Default</span>\\n\n                                    </div>\\n\n                                </td>\\n\n                                <td class=\"py-1\">\\n\n                                    <div class=\"input-group input-group-sm\" style=\"max-width: 7.5rem\">\\n\n                                        <span class=\"input-group-text\">$</span>\\n\n                                        <input\\n\n                                            type=\"text\"\\n\n                                            class=\"form-control font-monospace text-end\"\\n\n                                            :value=\"rateInput(selectedWorkType, column.value)\"\\n\n                                            @change=\"setRateInput(selectedWorkType, column.value, $event.target.value); saveRate(selectedWorkType, column.value)\"\\n\n                                            @keydown.enter.prevent=\"setRateInput(selectedWorkType, column.value, $event.target.value); saveRate(selectedWorkType, column.value)\"\\n\n                                            inputmode=\"decimal\"\\n\n                                            :aria-label=\"`${selectedWorkTypeLabel()} ${column.label} hourly rate`\"\\n\n                                            data-labor-hourly-rate\\n\n                                        >\\n\n                                    </div>\\n\n                                </td>\\n\n                                <td class=\"py-1\">\\n\n                                    <div class=\"d-flex flex-wrap align-items-center gap-1\">\\n\n                                        <select\\n\n                                            class=\"form-select form-select-sm\"\\n\n                                            style=\"max-width: 6.75rem\"\\n\n                                            :value=\"minimumRow(column.value).mode\"\\n\n                                            @change=\"setMinimumMode(column.value, $event.target.value)\"\\n\n                                            :aria-label=\"`${column.label} minimum mode`\"\\n\n                                            data-labor-min-mode\\n\n                                        >\\n\n                                            <option value=\"none\">None</option>\\n\n                                            <option value=\"per_line\">Per line</option>\\n\n                                            <option value=\"per_concern\">Per concern</option>\\n\n                                            <option value=\"per_ro\">Per RO</option>\\n\n                                        </select>\\n\n                                        <input\\n\n                                            type=\"text\"\\n\n                                            class=\"form-control form-control-sm font-monospace\"\\n\n                                            style=\"max-width: 4.25rem\"\\n\n                                            :value=\"minimumRow(column.value).hours\"\\n\n                                            :disabled=\"minimumRow(column.value).mode === 'none'\"\\n\n                                            @change=\"setMinimumHours(column.value, $event.target.value)\"\\n\n                                            @keydown.enter.prevent=\"setMinimumHours(column.value, $event.target.value)\"\\n\n                                            inputmode=\"decimal\"\\n\n                                            :aria-label=\"`${column.label} minimum hours`\"\\n\n                                            data-labor-min-hours\\n\n                                        >\\n\n                                    </div>\\n\n                                </td>\\n\n                                <td class=\"py-1\">\\n\n                                    \\n\n                                    <select\\n\n                                        class=\"form-select form-select-sm\"\\n\n                                        :key=\"`rounding-${selectedWorkType}-${column.value}`\"\\n\n                                        :value=\"cell(selectedWorkType, column.value).rounding_rule || 'quarter'\"\\n\n                                        @change=\"saveCellRounding(column.value, $event.target.value)\"\\n\n                                        :aria-label=\"`${selectedWorkTypeLabel()} ${column.label} rounding`\"\\n\n                                        data-labor-rounding\\n\n                                    >\\n\n                                        <option value=\"exact\">No rounding</option>\\n\n                                        <option value=\"tenth\">Round up to 0.1 hr</option>\\n\n                                        <option value=\"quarter\">Round up to 0.25 hr</option>\\n\n                                        <option value=\"half\">Round up to 0.5 hr</option>\\n\n                                    </select>\\n\n                                </td>\\n\n                                <td class=\"py-1 text-end\">\\n\n                                    <template x-if=\"column.has_customer_class\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"btn btn-ghost-secondary btn-icon btn-sm\"\\n\n                                            @click=\"openClassSettings(column)\"\\n\n                                            data-labor-class-settings\\n\n                                            title=\"Class Settings\"\\n\n                                            aria-label=\"Class Settings\"\\n\n                                        >\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon icon icon-sm\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065\"/><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"/></svg>\\n\n                                        </button>\\n\n                                    </template>\\n\n                                    <template x-if=\"!column.has_customer_class\">\\n\n                                        <div class=\"dropdown d-inline-block\" x-data=\"{ open: false }\" @click.outside=\"open = false\">\\n\n                                            <button\\n\n                                                type=\"button\"\\n\n                                                class=\"btn btn-ghost-secondary btn-icon btn-sm\"\\n\n                                                :aria-expanded=\"open\"\\n\n                                                aria-haspopup=\"true\"\\n\n                                                aria-label=\"Labor column actions\"\\n\n                                                title=\"Labor column actions\"\\n\n                                                data-labor-only-column-actions\\n\n                                                @click=\"open = !open\"\\n\n                                            >\\n\n                                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon icon icon-sm\"><path d=\"M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/></svg>\\n\n                                            </button>\\n\n                                            <div class=\"dropdown-menu dropdown-menu-end\" :class=\"{ show: open }\" x-show=\"open\" x-cloak>\\n\n                                                <button type=\"button\" class=\"dropdown-item\" @click=\"open = false; archiveLaborOnlyColumn(column)\">Archive column</button>\\n\n                                                <button type=\"button\" class=\"dropdown-item text-danger\" @click=\"open = false; deleteLaborOnlyColumn(column)\">Delete column</button>\\n\n                                            </div>\\n\n                                        </div>\\n\n                                    </template>\\n\n                                </td>\\n\n                            </tr>\\n\n                        </template>\\n\n                        <template x-for=\"row in nonMatrixBillingClasses()\" :key=\"'extra-'+row.key\">\\n\n                            <tr :data-billing-class-key=\"row.key\" data-billing-class-extra>\\n\n                                <td class=\"py-1\">\\n\n                                    <div class=\"d-flex align-items-center gap-2 flex-wrap\">\\n\n                                        <span class=\"fw-medium\" x-text=\"row.name\"></span>\\n\n                                        <span class=\"badge bg-azure-lt text-azure\" x-show=\"row.is_default\">Default</span>\\n\n                                        <span class=\"badge bg-secondary-lt\" x-show=\"!row.is_active\">Archived</span>\\n\n                                    </div>\\n\n                                    <div class=\"form-hint mb-0\">Customer assignment only \u2014 no labor rates</div>\\n\n                                </td>\\n\n                                <td class=\"py-1 text-secondary small\" colspan=\"3\">\u2014</td>\\n\n                                <td class=\"py-1 text-end\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-ghost-secondary btn-icon btn-sm\"\\n\n                                        @click=\"openClassSettingsForKey(row.key)\"\\n\n                                        data-labor-class-settings\\n\n                                        title=\"Class Settings\"\\n\n                                        aria-label=\"Class Settings\"\\n\n                                    >\\n\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon icon icon-sm\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065\"/><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"/></svg>\\n\n                                    </button>\\n\n                                </td>\\n\n                            </tr>\\n\n                        </template>\\n\n                        <template x-for=\"column in (matrix.archived_orphan_labor_columns || [])\" :key=\"'archived-orphan-'+column.key\">\\n\n                            <tr :data-billing-class=\"column.key\" data-archived-orphan-labor-column>\\n\n                                <td class=\"py-1\">\\n\n                                    <div class=\"d-flex align-items-center gap-2 flex-wrap\">\\n\n                                        <span class=\"fw-medium\" x-text=\"column.label\"></span>\\n\n                                        <span class=\"badge bg-secondary-lt\">Archived</span>\\n\n                                    </div>\\n\n                                    <div class=\"form-hint mb-0\">Labor rates only \u2014 restore to edit rates</div>\\n\n                                </td>\\n\n                                <td class=\"py-1 text-secondary small\" colspan=\"3\">\u2014</td>\\n\n                                <td class=\"py-1 text-end\">\\n\n                                    <div class=\"dropdown d-inline-block\" x-data=\"{ open: false }\" @click.outside=\"open = false\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"btn btn-ghost-secondary btn-icon btn-sm\"\\n\n                                            :aria-expanded=\"open\"\\n\n                                            aria-haspopup=\"true\"\\n\n                                            aria-label=\"Archived labor column actions\"\\n\n                                            title=\"Archived labor column actions\"\\n\n                                            data-labor-only-column-actions\\n\n                                            @click=\"open = !open\"\\n\n                                        >\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon icon icon-sm\"><path d=\"M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/></svg>\\n\n                                        </button>\\n\n                                        <div class=\"dropdown-menu dropdown-menu-end\" :class=\"{ show: open }\" x-show=\"open\" x-cloak>\\n\n                                            <button type=\"button\" class=\"dropdown-item\" @click=\"open = false; restoreLaborOnlyColumn(column)\">Restore column</button>\\n\n                                            <button type=\"button\" class=\"dropdown-item text-danger\" @click=\"open = false; deleteLaborOnlyColumn(column)\">Delete column</button>\\n\n                                        </div>\\n\n                                    </div>\\n\n                                </td>\\n\n                            </tr>\\n\n                        </template>\\n\n                    </tbody>\\n\n                </table>\\n\n            </div>\\n\n            <div class=\"d-flex flex-wrap gap-2 mt-2\">\\n\n                <button type=\"button\" class=\"btn btn-outline-primary btn-sm\" @click=\"promptAddLaborColumn()\" data-labor-add-column>\\n\n                    + Add Billing Class\\n\n                </button>\\n\n            </div>\\n\n            <p class=\"form-hint mb-0 mt-1\">\\n\n                One billing-class registry. Add Billing Class creates customer assignment, concern override, labor rates, and Class Settings. The gear opens commercial, warranty, and document terms for that class.\\n\n            </p>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div\\n\n        class=\"modal modal-blur\"\\n\n        tabindex=\"-1\"\\n\n        data-labor-add-dialog\\n\n        x-cloak\\n\n        :class=\"{ show: !!addDialog }\"\\n\n        :style=\"addDialog\\n\n            ? 'display: block !important; background: rgba(22, 28, 45, 0.35);'\\n\n            : 'display: none !important'\"\\n\n    >\\n\n        <div class=\"modal-dialog modal-dialog-centered modal-sm\" role=\"document\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header\">\\n\n                    <h5 class=\"modal-title\" x-text=\"addDialog?.title\"></h5>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"addDialog = null\"></button>\\n\n                </div>\\n\n                <div class=\"modal-body\">\\n\n                    <label class=\"form-label\" x-text=\"addDialog?.label\"></label>\\n\n                    <input type=\"text\" class=\"form-control\" x-model=\"addDialogName\" @keydown.enter.prevent=\"confirmAddDialog()\" maxlength=\"64\">\\n\n                    <p class=\"form-hint mb-0 mt-2\" x-show=\"addDialog?.hint\" x-text=\"addDialog?.hint\"></p>\\n\n                </div>\\n\n                <div class=\"modal-footer\">\\n\n                    <button type=\"button\" class=\"btn\" @click=\"addDialog = null\">Cancel</button>\\n\n                    <button type=\"button\" class=\"btn btn-primary\" @click=\"confirmAddDialog()\">Add</button>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n<script>\\n\ndocument.addEventListener('alpine:init', () => {\\n\n    Alpine.data('arkLaborMatrix', (initial, initialWorkType = null) => ({\\n\n        matrix: initial,\\n\n        selectedWorkType: initialWorkType || initial.work_types?.[0]?.key || 'mechanical',\\n\n        status: 'idle',\\n\n        lastRequest: null,\\n\n        addDialog: null,\\n\n        addDialogName: '',\\n\n        init() {\\n\n            if (!this.matrix.work_types.some((row) => row.key === this.selectedWorkType)) {\\n\n                this.selectedWorkType = this.matrix.work_types[0]?.key || 'mechanical';\\n\n            }\\n\n            this.syncWorkTypeUrl(false);\\n\n            this.$watch('status', (value) => {\\n\n                if (value === 'saved') {\\n\n                    setTimeout(() => { if (this.status === 'saved') this.status = 'idle'; }, 1800);\\n\n                }\\n\n            });\\n\n            window.addEventListener('popstate', () => {\\n\n                const fromUrl = new URLSearchParams(window.location.search).get('work_type');\\n\n                if (fromUrl && this.matrix.work_types.some((row) => row.key === fromUrl)) {\\n\n                    this.selectedWorkType = fromUrl;\\n\n                }\\n\n            });\\n\n            this._onLaborMatrixRefresh = () => this.refreshMatrix();\\n\n            window.addEventListener('labor-matrix-refresh', this._onLaborMatrixRefresh);\\n\n            this.$el.addEventListener('labor-matrix-refresh', this._onLaborMatrixRefresh);\\n\n        },\\n\n        destroy() {\\n\n            if (this._onLaborMatrixRefresh) {\\n\n                window.removeEventListener('labor-matrix-refresh', this._onLaborMatrixRefresh);\\n\n            }\\n\n        },\\n\n        async refreshMatrix() {\\n\n            if (!this.matrix.routes?.rate) return;\\n\n            try {\\n\n                const response = await fetch(this.matrix.routes.rate.replace(/\\/rate$/, ''), {\\n\n                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },\\n\n                });\\n\n                // Prefer dedicated show route when present.\\n\n            } catch (e) {}\\n\n            try {\\n\n                const showUrl = 'http:\\/\\/localhost\\/app\\/settings\\/shop\\/labor-matrix';\\n\n                const response = await fetch(showUrl, {\\n\n                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },\\n\n                });\\n\n                const payload = await response.json();\\n\n                if (response.ok && payload.work_types) {\\n\n                    this.matrix = payload;\\n\n                    if (!this.matrix.work_types.some((row) => row.key === this.selectedWorkType)) {\\n\n                        this.selectedWorkType = this.matrix.work_types[0]?.key || 'mechanical';\\n\n                    }\\n\n                }\\n\n            } catch (e) {}\\n\n        },\\n\n        selectWorkType(key) {\\n\n            if (!this.matrix.work_types.some((row) => row.key === key)) {\\n\n                return;\\n\n            }\\n\n            this.selectedWorkType = key;\\n\n            this.syncWorkTypeUrl(true);\\n\n        },\\n\n        shopSettings() {\\n\n            const el = this.$el.closest('[data-shop-settings]');\\n\n            return el ? Alpine.$data(el) : null;\\n\n        },\\n\n        syncWorkTypeUrl(push) {\\n\n            // Labor stays mounted while other Financial tabs are shown; never steal the active tab.\\n\n            // Alpine $root is this component, not Shop Settings \u2014 read the shop host explicitly.\\n\n            if (this.shopSettings()?.financialTab !== 'labor') {\\n\n                return;\\n\n            }\\n\n            const url = new URL(window.location.href);\\n\n            url.searchParams.set('section', 'financial');\\n\n            url.searchParams.set('financial-tab', 'labor');\\n\n            url.searchParams.set('work_type', this.selectedWorkType);\\n\n            if (push) {\\n\n                window.history.pushState({}, '', url);\\n\n            } else {\\n\n                window.history.replaceState({}, '', url);\\n\n            }\\n\n        },\\n\n        selectedWorkTypeLabel() {\\n\n            return this.matrix.work_types.find((row) => row.key === this.selectedWorkType)?.label || 'Work type';\\n\n        },\\n\n        selectedWorkTypeMeta() {\\n\n            return this.matrix.work_types.find((row) => row.key === this.selectedWorkType) || null;\\n\n        },\\n\n        async archiveSelectedWorkType() {\\n\n            const meta = this.selectedWorkTypeMeta();\\n\n            if (!meta?.can_archive) return;\\n\n            if (!window.confirm('Archive \u201c' + meta.label + '\u201d? It leaves new selections but keeps historical labor lines.')) return;\\n\n            await this.request(this.matrix.routes.work_type_archive, 'POST', { work_type: meta.key });\\n\n        },\\n\n        async deleteSelectedWorkType() {\\n\n            const meta = this.selectedWorkTypeMeta();\\n\n            if (!meta?.can_archive) return;\\n\n            if (!window.confirm('Delete \u201c' + meta.label + '\u201d only if it was never used on a repair order or template?')) return;\\n\n            await this.request(this.matrix.routes.work_type_destroy, 'POST', { work_type: meta.key });\\n\n        },\\n\n        cell(workType, billingClass) {\\n\n            this.matrix.cells[workType] ||= {};\\n\n            this.matrix.cells[workType][billingClass] ||= {\\n\n                settings_mode: 'custom',\\n\n                effective_rate_cents: null,\\n\n                rate_display: '\u2014',\\n\n                rounding_rule: 'quarter',\\n\n            };\\n\n            return this.matrix.cells[workType][billingClass];\\n\n        },\\n\n        minimumRow(billingClass) {\\n\n            this.matrix.billing_minimums ||= {};\\n\n            this.matrix.billing_minimums[billingClass] ||= {\\n\n                mode: 'none',\\n\n                hours: '0.00',\\n\n                shortfall_rate_source: 'standard_mechanical',\\n\n                shortfall_rate_cents: this.matrix.standard_rate_cents,\\n\n            };\\n\n            return this.matrix.billing_minimums[billingClass];\\n\n        },\\n\n        rateInput(workType, billingClass) {\\n\n            const cents = this.cell(workType, billingClass).effective_rate_cents;\\n\n            return cents == null ? '' : (cents / 100).toFixed(2);\\n\n        },\\n\n        setRateInput(workType, billingClass, value) {\\n\n            const cents = Math.round(parseFloat(value || '0') * 100);\\n\n            this.cell(workType, billingClass).effective_rate_cents = Number.isFinite(cents) ? cents : 0;\\n\n            this.cell(workType, billingClass).rate_display = '$' + ((this.cell(workType, billingClass).effective_rate_cents || 0) / 100).toFixed(2);\\n\n        },\\n\n        async setMinimumMode(billingClass, mode) {\\n\n            const row = this.minimumRow(billingClass);\\n\n            row.mode = mode;\\n\n            if (mode === 'none') {\\n\n                row.hours = '0.00';\\n\n            } else if (!parseFloat(row.hours || '0')) {\\n\n                row.hours = '1.00';\\n\n            }\\n\n            await this.saveMinimum(billingClass);\\n\n        },\\n\n        async setMinimumHours(billingClass, hours) {\\n\n            const row = this.minimumRow(billingClass);\\n\n            const parsed = parseFloat(hours || '0');\\n\n            row.hours = Number.isFinite(parsed) ? parsed.toFixed(2) : '0.00';\\n\n            if (row.mode === 'none' && parsed > 0) {\\n\n                row.mode = 'per_line';\\n\n            }\\n\n            await this.saveMinimum(billingClass);\\n\n        },\\n\n        async saveMinimum(billingClass) {\\n\n            const row = this.minimumRow(billingClass);\\n\n            await this.request(this.matrix.routes.minimum, 'PATCH', {\\n\n                billing_class: billingClass,\\n\n                mode: row.mode || 'none',\\n\n                hours: row.hours || '0.00',\\n\n                shortfall_rate_source: row.shortfall_rate_source || 'standard_mechanical',\\n\n                shortfall_rate: row.shortfall_rate_cents != null\\n\n                    ? (row.shortfall_rate_cents / 100).toFixed(2)\\n\n                    : '',\\n\n            });\\n\n        },\\n\n        async saveCellRounding(billingClass, roundingRule) {\\n\n            this.cell(this.selectedWorkType, billingClass).rounding_rule = roundingRule;\\n\n            await this.request(this.matrix.routes.rounding || this.matrix.routes.work_type_rounding, 'PATCH', {\\n\n                work_type: this.selectedWorkType,\\n\n                billing_class: billingClass,\\n\n                rounding_rule: roundingRule,\\n\n            });\\n\n        },\\n\n        csrf() {\\n\n            return document.querySelector('meta[name=\"csrf-token\"]')?.content || '';\\n\n        },\\n\n        async request(url, method, body) {\\n\n            this.status = 'saving';\\n\n            this.lastRequest = { url, method, body };\\n\n            try {\\n\n                const response = await fetch(url, {\\n\n                    method,\\n\n                    headers: {\\n\n                        'Content-Type': 'application/json',\\n\n                        'Accept': 'application/json',\\n\n                        'X-CSRF-TOKEN': this.csrf(),\\n\n                        'X-Requested-With': 'XMLHttpRequest',\\n\n                    },\\n\n                    body: JSON.stringify({\\n\n                        ...body,\\n\n                        expected_version: this.matrix.labor_pricing_profile_version,\\n\n                    }),\\n\n                });\\n\n                const payload = await response.json().catch(() => ({}));\\n\n                if (!response.ok) {\\n\n                    this.status = 'error';\\n\n                    throw new Error(payload.message || Object.values(payload.errors || {})[0]?.[0] || 'Save failed');\\n\n                }\\n\n                if (payload.matrix) {\\n\n                    const selected = this.selectedWorkType;\\n\n                    this.matrix = payload.matrix;\\n\n                    if (!this.matrix.work_types.some((row) => row.key === selected)) {\\n\n                        this.selectedWorkType = this.matrix.work_types[0]?.key || selected;\\n\n                    } else {\\n\n                        this.selectedWorkType = selected;\\n\n                    }\\n\n                }\\n\n                this.status = 'saved';\\n\n                return payload;\\n\n            } catch (error) {\\n\n                this.status = 'error';\\n\n                throw error;\\n\n            }\\n\n        },\\n\n        async saveRate(workType, billingClass) {\\n\n            const cell = this.cell(workType, billingClass);\\n\n            const cents = Number(cell.effective_rate_cents || 0);\\n\n            const mode = cents <= 0 ? 'zero' : 'custom';\\n\n            cell.settings_mode = mode;\\n\n            await this.request(this.matrix.routes.rate, 'PATCH', {\\n\n                work_type: workType,\\n\n                billing_class: billingClass,\\n\n                mode,\\n\n                rate: (Math.max(0, cents) / 100).toFixed(2),\\n\n            });\\n\n        },\\n\n        promptAddWorkType() {\\n\n            this.addDialogName = '';\\n\n            this.addDialog = {\\n\n                kind: 'work_type',\\n\n                title: 'Add work type',\\n\n                label: 'Work type name',\\n\n                hint: 'Creates a selectable work type with rates for every billing class. Applies to new repair orders only.',\\n\n            };\\n\n        },\\n\n        promptAddLaborColumn() {\\n\n            this.addDialogName = '';\\n\n            this.addDialog = {\\n\n                kind: 'billing_class',\\n\n                title: 'Add billing class',\\n\n                label: 'Billing class name',\\n\n                hint: 'Creates one billing class: customer assignment, concern override, labor matrix column and commercial rules. Applies to new repair orders only.',\\n\n            };\\n\n        },\\n\n        promptAddBillingClass() {\\n\n            this.promptAddLaborColumn();\\n\n        },\\n\n        openClassSettings(column) {\\n\n            this.openClassSettingsForKey(column.customer_class_key || null);\\n\n        },\\n\n        openClassSettingsForKey(key) {\\n\n            this.$dispatch('labor-open-class-settings', { key: key || null });\\n\n        },\\n\n        nonMatrixBillingClasses() {\\n\n            const linked = new Set(\\n\n                (this.matrix.columns || [])\\n\n                    .map((column) => column.customer_class_key)\\n\n                    .filter(Boolean),\\n\n            );\\n\n            return (this.matrix.billing_classes || []).filter((row) => !linked.has(row.key));\\n\n        },\\n\n        laborOnlyColumnKey(column) {\\n\n            return column?.value || column?.key || null;\\n\n        },\\n\n        async archiveLaborOnlyColumn(column) {\\n\n            const key = this.laborOnlyColumnKey(column);\\n\n            if (!key) return;\\n\n            if (!window.confirm('Archive this labor-only column? Existing repair orders keep their rates.')) return;\\n\n            await this.request(this.matrix.routes.billing_class_archive, 'POST', { billing_class: key });\\n\n        },\\n\n        async restoreLaborOnlyColumn(column) {\\n\n            const key = this.laborOnlyColumnKey(column);\\n\n            if (!key) return;\\n\n            await this.request(this.matrix.routes.billing_class_restore, 'POST', { billing_class: key });\\n\n        },\\n\n        async deleteLaborOnlyColumn(column) {\\n\n            const key = this.laborOnlyColumnKey(column);\\n\n            if (!key) return;\\n\n            if (!window.confirm('Delete this labor-only column only if it was never used on a repair order?')) return;\\n\n            await this.request(this.matrix.routes.billing_class_destroy, 'POST', { billing_class: key });\\n\n        },\\n\n        async confirmAddDialog() {\\n\n            const name = (this.addDialogName || '').trim();\\n\n            if (!name || !this.addDialog) return;\\n\n            const kind = this.addDialog.kind;\\n\n            this.addDialog = null;\\n\n            if (kind === 'work_type') {\\n\n                const payload = await this.request(this.matrix.routes.work_type, 'POST', { name });\\n\n                if (payload.work_type?.key) {\\n\n                    this.selectWorkType(payload.work_type.key);\\n\n                }\\n\n                return;\\n\n            }\\n\n            await this.request(this.matrix.routes.billing_class, 'POST', {\\n\n                name,\\n\n                base_posture: 'customer_pay',\\n\n            });\\n\n        },\\n\n        async retryLast() {\\n\n            if (!this.lastRequest) return;\\n\n            await this.request(this.lastRequest.url, this.lastRequest.method, this.lastRequest.body);\\n\n        },\\n\n    }));\\n\n});\\n\n</script>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"financial-panel-tax\" role=\"tabpanel\" aria-labelledby=\"financial-tab-tax\" x-show=\"financialTab === 'tax'\" x-cloak>\\n\n                        <form\\n\n    method=\"POST\"\\n\n    action=\"http://localhost/app/settings/shop/tax\"\\n\n    data-settings-tax\\n\n    x-data=\"{ taxEnabled: false, selectedKey: 'shop-default', presentation: 'combined' }\"\\n\n>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n    \\n\n    <input type=\"hidden\" name=\"tax_label\" id=\"settings-tax-label\" value=\"Tax\">\\n\n    <input type=\"hidden\" name=\"default_tax_rate\" id=\"settings-tax-rate\" value=\"0.000\">\\n\n    <input type=\"hidden\" name=\"taxable_labor\" value=\"0\">\\n\n    <input type=\"hidden\" name=\"taxable_parts\" value=\"1\">\\n\n    <input type=\"hidden\" name=\"taxable_shop_fees\" value=\"0\">\\n\n\\n\n    <div class=\"d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3\">\\n\n        <div>\\n\n            <h3 class=\"mb-1\">Sales tax profiles</h3>\\n\n            <p class=\"text-secondary small mb-0\">\\n\n                Configure named jurisdictions with individual tax components. New repair orders stamp the\\n\n                <strong>default</strong> profile as TaxProfile schema 2 (components frozen on the RO). Changing these settings\\n\n                does not reprice existing open or closed ROs.\\n\n            </p>\\n\n        </div>\\n\n        <label class=\"form-check form-switch mb-0\">\\n\n            <input type=\"hidden\" name=\"tax_enabled\" value=\"0\">\\n\n            <input type=\"checkbox\" name=\"tax_enabled\" value=\"1\" x-model=\"taxEnabled\"  class=\"form-check-input\">\\n\n            <span class=\"form-check-label\">Charge sales tax</span>\\n\n        </label>\\n\n    </div>\\n\n\\n\n    <div class=\"card card-sm mb-3\" data-settings-tax-presentation>\\n\n        <div class=\"card-body\">\\n\n            <div class=\"subheader mb-1\">Customer document presentation</div>\\n\n            <p class=\"text-secondary small\">\\n\n                Shop-wide preference for how tax appears on estimates and invoices. Same underlying cents either way.\\n\n                Itemized document rendering lands in a later slice; the preference is stored now without rewriting issued documents.\\n\n            </p>\\n\n            <div class=\"d-flex flex-wrap gap-3\">\\n\n                <label class=\"form-check mb-0\">\\n\n                    <input type=\"radio\" class=\"form-check-input\" name=\"tax_document_presentation\" value=\"combined\" x-model=\"presentation\" checked>\\n\n                    <span class=\"form-check-label\">Combined \u2014 one Sales Tax line</span>\\n\n                </label>\\n\n                <label class=\"form-check mb-0\">\\n\n                    <input type=\"radio\" class=\"form-check-input\" name=\"tax_document_presentation\" value=\"itemized\" x-model=\"presentation\" >\\n\n                    <span class=\"form-check-label\">Itemized \u2014 named components</span>\\n\n                </label>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <p x-show=\"! taxEnabled\"  class=\"text-secondary small\">Tax is off. Estimates and invoices show no sales tax. Turn it on to edit profiles.</p>\\n\n\\n\n    <div x-show=\"taxEnabled\"  x-cloak >\\n\n        <div class=\"ops-financial-master-detail\">\\n\n            <div class=\"ops-financial-master-detail__nav\">\\n\n                <nav class=\"card sticky-lg-top\" style=\"top: 1rem\" aria-label=\"Tax profiles\" data-tax-profile-nav>\\n\n                    <div class=\"card-header py-2\">\\n\n                        <div class=\"subheader\">Tax profiles</div>\\n\n                    </div>\\n\n                    <div class=\"list-group list-group-flush\">\\n\n                                                    <button\\n\n                                type=\"button\"\\n\n                                class=\"list-group-item list-group-item-action ops-financial-master-detail__nav-item\"\\n\n                                :class=\"{ 'active': selectedKey === 'shop-default' }\"\\n\n                                @click=\"selectedKey = 'shop-default'\"\\n\n                                data-tax-profile-tab=\"shop-default\"\\n\n                            >\\n\n                                <span class=\"ops-financial-master-detail__nav-label\">Tax</span>\\n\n                                                                    <span class=\"badge bg-secondary-lt\">Default</span>\\n\n                                                                                            </button>\\n\n                                            </div>\\n\n                    <div class=\"card-footer py-2\">\\n\n                        <button\\n\n                            type=\"submit\"\\n\n                            class=\"btn btn-sm w-100\"\\n\n                            form=\"tax-add-profile\"\\n\n                                                        data-tax-add-profile-button\\n\n                        >\\n\n                            + Add tax profile\\n\n                        </button>\\n\n                    </div>\\n\n                </nav>\\n\n                <p class=\"small text-secondary mt-2 mb-0 d-lg-none\">Select a profile above, then edit its components.</p>\\n\n            </div>\\n\n\\n\n            <div class=\"ops-financial-master-detail__editor\">\\n\n                                    <div\\n\n                        data-tax-profile-editor=\"shop-default\"\\n\n                        x-show=\"selectedKey === 'shop-default'\"\\n\n                                            >\\n\n                        <input type=\"hidden\" name=\"tax_profiles[0][key]\" value=\"shop-default\">\\n\n                        <input type=\"hidden\" name=\"tax_profiles[0][is_active]\" value=\"1\">\\n\n                        <input type=\"hidden\" name=\"tax_profiles[0][is_default]\" value=\"1\">\\n\n\\n\n                        <div class=\"card card-sm\">\\n\n                            <div class=\"card-header\">\\n\n                                <div class=\"row g-2 align-items-center flex-fill\">\\n\n                                    <div class=\"col\">\\n\n                                        <label class=\"form-label visually-hidden\" for=\"tax-profile-name-shop-default\">Profile name</label>\\n\n                                        <input\\n\n                                            id=\"tax-profile-name-shop-default\"\\n\n                                            class=\"form-control fw-medium\"\\n\n                                            name=\"tax_profiles[0][name]\"\\n\n                                            value=\"Tax\"\\n\n                                            required\\n\n                                            maxlength=\"64\"\\n\n                                        >\\n\n                                    </div>\\n\n                                    <div class=\"col-auto\">\\n\n                                        <label class=\"form-check mb-0\">\\n\n                                            <input\\n\n                                                type=\"radio\"\\n\n                                                name=\"default_tax_profile_key\"\\n\n                                                value=\"shop-default\"\\n\n                                                checked                                                class=\"form-check-input\"\\n\n                                                onchange=\"this.form.querySelectorAll('[name^=\\'tax_profiles\\'][name$=\\'[is_default]\\']').forEach((el) => { el.value = '0'; }); this.form.querySelector('[name=\\'tax_profiles[0][is_default]\\']').value = '1';\"\\n\n                                            >\\n\n                                            <span class=\"form-check-label\">Default</span>\\n\n                                        </label>\\n\n                                    </div>\\n\n                                </div>\\n\n                            </div>\\n\n                            <div class=\"card-body vstack gap-3\">\\n\n                                <div class=\"row g-2\">\\n\n                                    <div class=\"col-6 col-md-2\">\\n\n                                        <label class=\"form-label\" for=\"tax-profile-state-shop-default\">State</label>\\n\n                                        <input id=\"tax-profile-state-shop-default\" class=\"form-control\" maxlength=\"2\" name=\"tax_profiles[0][state]\" value=\"\">\\n\n                                    </div>\\n\n                                    <div class=\"col-6 col-md-3\">\\n\n                                        <label class=\"form-label\" for=\"tax-profile-counties-shop-default\">Counties</label>\\n\n                                        <input id=\"tax-profile-counties-shop-default\" class=\"form-control\" name=\"tax_profiles[0][counties]\" value=\"\" placeholder=\"Optional\">\\n\n                                    </div>\\n\n                                    <div class=\"col-12 col-md-4\">\\n\n                                        <label class=\"form-label\" for=\"tax-profile-cities-shop-default\">Cities</label>\\n\n                                        <input id=\"tax-profile-cities-shop-default\" class=\"form-control\" name=\"tax_profiles[0][cities]\" value=\"\" placeholder=\"Comma-separated\">\\n\n                                    </div>\\n\n                                    <div class=\"col-12 col-md-3\">\\n\n                                        <label class=\"form-label\" for=\"tax-profile-zips-shop-default\">ZIP codes</label>\\n\n                                        <input id=\"tax-profile-zips-shop-default\" class=\"form-control\" name=\"tax_profiles[0][zip_codes]\" value=\"\" placeholder=\"Suggestive only\">\\n\n                                    </div>\\n\n                                    <div class=\"col-12\">\\n\n                                        <label class=\"form-label\" for=\"tax-profile-area-shop-default\">Service area notes</label>\\n\n                                        <input id=\"tax-profile-area-shop-default\" class=\"form-control\" maxlength=\"255\" name=\"tax_profiles[0][service_area_description]\" value=\"\" placeholder=\"Optional \u2014 not used for automatic rate selection\">\\n\n                                    </div>\\n\n                                </div>\\n\n\\n\n                                <fieldset>\\n\n                                    <legend class=\"form-label\">Apply this profile\u2019s tax to</legend>\\n\n                                    <div class=\"d-flex flex-wrap gap-4\">\\n\n                                        <label class=\"form-check mb-0\">\\n\n                                            <input type=\"hidden\" name=\"tax_profiles[0][taxable_labor]\" value=\"0\">\\n\n                                            <input type=\"checkbox\" class=\"form-check-input\" name=\"tax_profiles[0][taxable_labor]\" value=\"1\" >\\n\n                                            <span class=\"form-check-label\">Tax labor</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check mb-0\">\\n\n                                            <input type=\"hidden\" name=\"tax_profiles[0][taxable_parts]\" value=\"0\">\\n\n                                            <input type=\"checkbox\" class=\"form-check-input\" name=\"tax_profiles[0][taxable_parts]\" value=\"1\" checked>\\n\n                                            <span class=\"form-check-label\">Tax parts</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check mb-0\">\\n\n                                            <input type=\"hidden\" name=\"tax_profiles[0][taxable_shop_fees]\" value=\"0\">\\n\n                                            <input type=\"checkbox\" class=\"form-check-input\" name=\"tax_profiles[0][taxable_shop_fees]\" value=\"1\" >\\n\n                                            <span class=\"form-check-label\">Tax shop fees</span>\\n\n                                        </label>\\n\n                                    </div>\\n\n                                </fieldset>\\n\n\\n\n                                <div>\\n\n                                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2\">\\n\n                                        <div>\\n\n                                            <div class=\"subheader mb-0\">Tax components</div>\\n\n                                            <div class=\"small text-secondary\">Combined rate: <strong>0.000%</strong></div>\\n\n                                        </div>\\n\n                                        <button\\n\n                                            type=\"submit\"\\n\n                                            class=\"btn btn-sm\"\\n\n                                            form=\"tax-add-component-shop-default\"\\n\n                                                                                        data-tax-add-component-button\\n\n                                            data-tax-profile-key=\"shop-default\"\\n\n                                        >\\n\n                                            + Add component\\n\n                                        </button>\\n\n                                    </div>\\n\n                                    <div class=\"table-responsive border rounded\">\\n\n                                        <table class=\"table table-vcenter table-sm mb-0\">\\n\n                                            <thead>\\n\n                                                <tr>\\n\n                                                    <th>Name</th>\\n\n                                                    <th style=\"width: 7rem\">Rate %</th>\\n\n                                                    <th style=\"width: 9rem\">Type</th>\\n\n                                                    <th>Reporting code</th>\\n\n                                                    <th class=\"w-1\">Active</th>\\n\n                                                </tr>\\n\n                                            </thead>\\n\n                                            <tbody>\\n\n                                                                                                    <tr>\\n\n                                                        <td>\\n\n                                                            <input type=\"hidden\" name=\"tax_profiles[0][components][0][id]\" value=\"legacy-combined\">\\n\n                                                            <input type=\"hidden\" name=\"tax_profiles[0][components][0][sort_order]\" value=\"1\">\\n\n                                                            <input class=\"form-control form-control-sm\" required maxlength=\"64\" name=\"tax_profiles[0][components][0][name]\" value=\"Tax\">\\n\n                                                        </td>\\n\n                                                        <td>\\n\n                                                            <input class=\"form-control form-control-sm font-monospace\" inputmode=\"decimal\" required name=\"tax_profiles[0][components][0][rate]\" value=\"0.000\">\\n\n                                                        </td>\\n\n                                                        <td>\\n\n                                                            <select class=\"form-select form-select-sm\" name=\"tax_profiles[0][components][0][jurisdiction_type]\">\\n\n                                                                                                                                    <option value=\"state\" >state</option>\\n\n                                                                                                                                    <option value=\"county\" >county</option>\\n\n                                                                                                                                    <option value=\"city\" >city</option>\\n\n                                                                                                                                    <option value=\"special_district\" >special district</option>\\n\n                                                                                                                                    <option value=\"other\" selected>other</option>\\n\n                                                                                                                            </select>\\n\n                                                        </td>\\n\n                                                        <td>\\n\n                                                            <input class=\"form-control form-control-sm\" maxlength=\"64\" name=\"tax_profiles[0][components][0][reporting_code]\" value=\"\" placeholder=\"Optional\">\\n\n                                                        </td>\\n\n                                                        <td>\\n\n                                                            <input type=\"hidden\" name=\"tax_profiles[0][components][0][is_active]\" value=\"0\">\\n\n                                                            <input type=\"checkbox\" class=\"form-check-input\" name=\"tax_profiles[0][components][0][is_active]\" value=\"1\" checked title=\"Active components count toward the combined rate\">\\n\n                                                        </td>\\n\n                                                    </tr>\\n\n                                                                                            </tbody>\\n\n                                        </table>\\n\n                                    </div>\\n\n                                    <p class=\"form-hint mb-0 mt-2\">\\n\n                                        Component IDs stay stable. Uncheck Active to deactivate a component without deleting it so historical references remain meaningful.\\n\n                                    </p>\\n\n                                </div>\\n\n\\n\n                                                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"border rounded px-3 py-2 mt-3 small text-secondary\" data-settings-tax-saved>\\n\n        Saved projection for new ROs:\\n\n        Tax disabled\\n\n        \u00b7 presentation combined\\n\n        \u00b7 labor not taxable\\n\n        \u00b7 parts taxable\\n\n        \u00b7 shop fees not taxable.\\n\n    </div>\\n\n\\n\n        \\n\n    <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n        <button type=\"submit\" class=\"btn btn-primary\">Save Tax Rules</button>\\n\n    </div>\\n\n</form>\\n\n\\n\n\\n\n<form\\n\n    id=\"tax-add-profile\"\\n\n    method=\"POST\"\\n\n    action=\"http://localhost/app/settings/shop/tax/profiles\"\\n\n    class=\"d-none\"\\n\n    data-tax-add-profile\\n\n>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\"></form>\\n\n    <form\\n\n        id=\"tax-add-component-shop-default\"\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/settings/shop/tax/profiles/shop-default/components\"\\n\n        class=\"d-none\"\\n\n        data-tax-add-component\\n\n        data-tax-profile-key=\"shop-default\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    </form>\\n\n                        </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"financial-panel-shop-fees\" role=\"tabpanel\" aria-labelledby=\"financial-tab-shop-fees\" x-show=\"financialTab === 'shop-fees'\" x-cloak>\\n\n                                                <form\\n\n                            method=\"POST\"\\n\n                            action=\"http://localhost/app/settings/shop/fees\"\\n\n                            x-data=\"{ shopFeeEnabled: false, shopFeeMode: 'percent' }\"\\n\n                            style=\"max-width: 48rem\"\\n\n                            data-settings-fees\\n\n                        >\\n\n                            <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                            <p class=\"text-secondary small\">\\n\n                                Applies to new repair orders only. Existing open ROs keep the fee rules they were created with.\\n\n                                Billing on each scope still controls whether that work is fee-eligible.\\n\n                            </p>\\n\n                            <label class=\"form-check form-switch\">\\n\n                                <input type=\"hidden\" name=\"shop_fee_enabled\" value=\"0\">\\n\n                                <input type=\"checkbox\" name=\"shop_fee_enabled\" value=\"1\" x-model=\"shopFeeEnabled\"  class=\"form-check-input\">\\n\n                                <span class=\"form-check-label\">Charge a shop fee</span>\\n\n                            </label>\\n\n                            <p x-show=\"! shopFeeEnabled\"  class=\"text-secondary small\">No shop fee is added to estimates. Turn it on to choose percentage, flat per RO, or flat per concern.</p>\\n\n                            <div x-show=\"shopFeeEnabled\"  x-cloak  class=\"vstack gap-3\">\\n\n                                <fieldset class=\"mb-0\">\\n\n                                    <legend class=\"form-label mb-2\">Fee type</legend>\\n\n                                    <div class=\"d-flex flex-wrap gap-3\">\\n\n                                        <label class=\"form-check\">\\n\n                                            <input type=\"radio\" class=\"form-check-input\" name=\"shop_fee_mode\" value=\"percent\" x-model=\"shopFeeMode\" checked>\\n\n                                            <span class=\"form-check-label\">Percentage of eligible charges</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check\">\\n\n                                            <input type=\"radio\" class=\"form-check-input\" name=\"shop_fee_mode\" value=\"flat\" x-model=\"shopFeeMode\" >\\n\n                                            <span class=\"form-check-label\">Fixed dollar fee per RO</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check\">\\n\n                                            <input type=\"radio\" class=\"form-check-input\" name=\"shop_fee_mode\" value=\"per_concern\" x-model=\"shopFeeMode\" >\\n\n                                            <span class=\"form-check-label\">Fixed dollar fee per concern</span>\\n\n                                        </label>\\n\n                                    </div>\\n\n                                                                    </fieldset>\\n\n                                <fieldset class=\"mb-0\" data-settings-fees-applies-to>\\n\n                                    <legend class=\"form-label mb-2\">Apply shop fees to</legend>\\n\n                                    <div class=\"d-flex flex-wrap gap-3\">\\n\n                                        <label class=\"form-check\">\\n\n                                            <input type=\"radio\" class=\"form-check-input\" name=\"shop_fee_applies_to\" value=\"labor\" >\\n\n                                            <span class=\"form-check-label\">Labor only</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check\">\\n\n                                            <input type=\"radio\" class=\"form-check-input\" name=\"shop_fee_applies_to\" value=\"parts\" >\\n\n                                            <span class=\"form-check-label\">Parts only</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check\">\\n\n                                            <input type=\"radio\" class=\"form-check-input\" name=\"shop_fee_applies_to\" value=\"both\" checked>\\n\n                                            <span class=\"form-check-label\">Labor and parts</span>\\n\n                                        </label>\\n\n                                    </div>\\n\n                                    <div class=\"form-hint mb-0\">Package lines count with labor. Sublet and fee lines stay outside the shop fee. Applies to every fee type above.</div>\\n\n                                                                    </fieldset>\\n\n                                <div class=\"row g-3\">\\n\n                                    <div class=\"col-12 col-md-4\" x-show=\"shopFeeMode === 'percent'\" >\\n\n                                        <label for=\"settings-shop-fee-rate\" class=\"form-label\">Shop fee percentage</label>\\n\n                                        <input id=\"settings-shop-fee-rate\" name=\"shop_fee_rate\" value=\"0.000\" inputmode=\"decimal\" :disabled=\"shopFeeMode !== 'percent'\"  class=\"form-control\">\\n\n                                                                            </div>\\n\n                                    <div class=\"col-12 col-md-4\" x-show=\"shopFeeMode === 'flat' || shopFeeMode === 'per_concern'\"  x-cloak >\\n\n                                        <label for=\"settings-shop-fee-flat\" class=\"form-label\">\\n\n                                            <span x-show=\"shopFeeMode === 'flat'\"  x-cloak >Flat fee per RO ($)</span>\\n\n                                            <span x-show=\"shopFeeMode === 'per_concern'\"  x-cloak >Flat fee per eligible concern ($)</span>\\n\n                                        </label>\\n\n                                        <input id=\"settings-shop-fee-flat\" name=\"shop_fee_flat\" value=\"\" inputmode=\"decimal\" :disabled=\"shopFeeMode !== 'flat' && shopFeeMode !== 'per_concern'\" disabled class=\"form-control\">\\n\n                                                                                <div class=\"form-hint\" x-show=\"shopFeeMode === 'flat'\"  x-cloak >Charged once for the whole repair order. That amount is the maximum.</div>\\n\n                                        <div class=\"form-hint\" x-show=\"shopFeeMode === 'per_concern'\"  x-cloak >One fee per eligible concern, no matter how many labor or parts lines it has.</div>\\n\n                                    </div>\\n\n                                    <div class=\"col-12 col-md-4\" x-show=\"shopFeeMode === 'percent' || shopFeeMode === 'per_concern'\" >\\n\n                                        <label for=\"settings-shop-fee-cap\" class=\"form-label\">Maximum total shop fee per RO ($)</label>\\n\n                                        <input id=\"settings-shop-fee-cap\" name=\"shop_fee_cap\" value=\"\" inputmode=\"decimal\" placeholder=\"No cap\" :disabled=\"shopFeeMode !== 'percent' && shopFeeMode !== 'per_concern'\"  class=\"form-control\">\\n\n                                                                                <div class=\"form-hint\">Optional. Caps the total fee for the repair order, not each concern.</div>\\n\n                                    </div>\\n\n                                </div>\\n\n                            </div>\\n\n                            <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n                                <button type=\"submit\" class=\"btn btn-primary\">Save Shop Fees</button>\\n\n                            </div>\\n\n                        </form>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"financial-panel-deposits\" role=\"tabpanel\" aria-labelledby=\"financial-tab-deposits\" x-show=\"financialTab === 'deposits'\" x-cloak>\\n\n                                                <form method=\"POST\" action=\"http://localhost/app/settings/shop/deposits\" x-data=\"{ depositEnabled: true, depositIncludeDiagnostics: true }\" style=\"max-width: 48rem\" data-settings-deposits>\\n\n                            <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                            <p class=\"text-secondary small\">\\n\n                                Suggested deposit shown with the repair order financials and used for Square deposit capture. Sums billable estimate parts plus diagnostic labor on Diagnostics scopes only (tax and shop fees included per line).\\n\n                            </p>\\n\n                            <label class=\"form-check form-switch\">\\n\n                                <input type=\"hidden\" name=\"default_deposit_enabled\" value=\"0\">\\n\n                                <input type=\"checkbox\" name=\"default_deposit_enabled\" value=\"1\" x-model=\"depositEnabled\" checked class=\"form-check-input\">\\n\n                                <span class=\"form-check-label\">Suggest a default deposit</span>\\n\n                            </label>\\n\n                            <p x-show=\"! depositEnabled\"  x-cloak  class=\"text-secondary small\">No deposit is suggested on repair orders. Turn it on to choose what the deposit includes.</p>\\n\n                            <div x-show=\"depositEnabled\" >\\n\n                                <fieldset class=\"mb-3\">\\n\n                                    <legend class=\"form-label\">Include in the deposit</legend>\\n\n                                    <div class=\"d-flex flex-wrap gap-4\">\\n\n                                        <label class=\"form-check mb-0\">\\n\n                                            <input type=\"hidden\" name=\"default_deposit_include_parts\" value=\"0\">\\n\n                                            <input type=\"checkbox\" name=\"default_deposit_include_parts\" value=\"1\" checked class=\"form-check-input\">\\n\n                                            <span class=\"form-check-label\">Include parts</span>\\n\n                                        </label>\\n\n                                        <label class=\"form-check mb-0\">\\n\n                                            <input type=\"hidden\" name=\"default_deposit_include_diagnostics\" value=\"0\">\\n\n                                            <input type=\"checkbox\" name=\"default_deposit_include_diagnostics\" value=\"1\" x-model=\"depositIncludeDiagnostics\" checked class=\"form-check-input\">\\n\n                                            <span class=\"form-check-label\">Include diagnostics</span>\\n\n                                        </label>\\n\n                                    </div>\\n\n                                </fieldset>\\n\n                                <fieldset x-show=\"depositIncludeDiagnostics\"  class=\"border rounded p-3\">\\n\n                                    <legend class=\"subheader float-none w-auto px-1 mb-1\">Diagnostic labor categories</legend>\\n\n                                    <p class=\"text-secondary small\">On Diagnostics scopes only, labor in these categories counts toward the default deposit when diagnostics are included.</p>\\n\n                                    <div class=\"row g-2\">\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"comeback\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Comeback</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"courtesy\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Courtesy</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"diagnostic\"\\n\n                                                        checked                                                        class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Diagnostic</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"fabrication\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Fabrication</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"mechanical\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Mechanical</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"programming\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Programming</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"repairpal\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">RepairPal</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                                    <div class=\"col-12 col-sm-6\">\\n\n                                                <label class=\"form-check mb-0\">\\n\n                                                    <input\\n\n                                                        type=\"checkbox\"\\n\n                                                        name=\"default_deposit_diagnostic_labor_category_keys[]\"\\n\n                                                        value=\"warranty-other\"\\n\n                                                                                                                class=\"form-check-input\"\\n\n                                                    >\\n\n                                                    <span class=\"form-check-label\">Warranty - Other</span>\\n\n                                                </label>\\n\n                                            </div>\\n\n                                                                            </div>\\n\n                                                                    </fieldset>\\n\n                            </div>\\n\n                            <div class=\"d-flex justify-content-end border-top pt-3 mt-3\">\\n\n                                <button type=\"submit\" class=\"btn btn-primary\">Save Deposit Settings</button>\\n\n                            </div>\\n\n                        </form>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"financial-panel-parts\" role=\"tabpanel\" aria-labelledby=\"financial-tab-parts\" x-show=\"financialTab === 'parts'\" x-cloak>\\n\n                        <form id=\"delete-parts-matrix-aft-parts\" method=\"POST\" action=\"http://localhost/app/settings/shop/parts-matrices/aft-parts\" class=\"d-none\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">    </form>\\n\n    <form id=\"delete-parts-matrix-filters\" method=\"POST\" action=\"http://localhost/app/settings/shop/parts-matrices/filters\" class=\"d-none\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">    </form>\\n\n    <form id=\"delete-parts-matrix-fluids\" method=\"POST\" action=\"http://localhost/app/settings/shop/parts-matrices/fluids\" class=\"d-none\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">    </form>\\n\n    <form id=\"delete-parts-matrix-oem-parts\" method=\"POST\" action=\"http://localhost/app/settings/shop/parts-matrices/oem-parts\" class=\"d-none\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">    </form>\\n\n    <form id=\"delete-parts-matrix-warranty-no-markup\" method=\"POST\" action=\"http://localhost/app/settings/shop/parts-matrices/warranty-no-markup\" class=\"d-none\">\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"DELETE\">    </form>\\n\n\\n\n<script>\\n\n    window.partsMatricesPanel = function partsMatricesPanel(initialMatrices, initialDefaultKey) {\\n\n        const storageKey = 'ark:shop-settings:parts-matrix-key';\\n\n        const knownKeys = initialMatrices.map((matrix) => matrix.key);\\n\n        let storedKey = null;\\n\n\\n\n        try {\\n\n            storedKey = localStorage.getItem(storageKey);\\n\n        } catch (error) {\\n\n            storedKey = null;\\n\n        }\\n\n\\n\n        const selectedKey = knownKeys.includes(storedKey)\\n\n            ? storedKey\\n\n            : (knownKeys.includes(initialDefaultKey) ? initialDefaultKey : (knownKeys[0] || null));\\n\n\\n\n        return {\\n\n            matrices: initialMatrices.map((matrix) => ({\\n\n                ...matrix,\\n\n                rows: (matrix.rows || []).map((row, index) => ({\\n\n                    ...row,\\n\n                    uid: row.uid || `${matrix.key}-${index}-${Math.random().toString(36).slice(2)}`,\\n\n                })),\\n\n            })),\\n\n            defaultPartsMatrixKey: initialDefaultKey,\\n\n            selectedKey,\\n\n            statusText: 'Autosaves edits',\\n\n            deleteConfirming: false,\\n\n            deleteTypedName: '',\\n\n            deleteMatrixName: '',\\n\n            deleteMatrixKey: null,\\n\n            autosaveTimer: null,\\n\n            autosaveGeneration: 0,\\n\n            saveTail: Promise.resolve(),\\n\n            get selectedMatrix() {\\n\n                return this.matrices.find((matrix) => matrix.key === this.selectedKey) || this.matrices[0] || null;\\n\n            },\\n\n            get updateAction() {\\n\n                const key = this.selectedKey || this.defaultPartsMatrixKey;\\n\n\\n\n                return key ? `/app/settings/shop/parts-matrices/${key}` : '#';\\n\n            },\\n\n            async selectMatrix(key) {\\n\n                if (key === this.selectedKey) {\\n\n                    return;\\n\n                }\\n\n\\n\n                // Flush pending/debounced edits before switching so sibling state is persisted.\\n\n                if (this.autosaveTimer !== null || this.statusText === 'Saving...' || this.statusText === 'Save needed') {\\n\n                    clearTimeout(this.autosaveTimer);\\n\n                    this.autosaveTimer = null;\\n\n                    await this.autosave(true);\\n\n\\n\n                    if (this.statusText === 'Save needed') {\\n\n                        if (! window.confirm('This matrix has unsaved changes. Switch anyway?')) {\\n\n                            return;\\n\n                        }\\n\n                    }\\n\n                }\\n\n\\n\n                this.cancelDeleteConfirm();\\n\n                this.selectedKey = key;\\n\n\\n\n                try {\\n\n                    localStorage.setItem(storageKey, key);\\n\n                } catch (error) {\\n\n                    // Ignore storage failures; selection still works for the session.\\n\n                }\\n\n            },\\n\n            canDelete(matrix) {\\n\n                return this.matrices.length > 1 && matrix.key !== this.defaultPartsMatrixKey;\\n\n            },\\n\n            addRow(matrixIndex) {\\n\n                const matrix = this.matrices[matrixIndex];\\n\n\\n\n                if (! matrix) {\\n\n                    return;\\n\n                }\\n\n\\n\n                matrix.rows.push({\\n\n                    uid: `${Date.now()}-${Math.random().toString(36).slice(2)}`,\\n\n                    min_cost: '',\\n\n                    max_cost: '',\\n\n                    markup_percentage: '',\\n\n                    margin_percentage: null,\\n\n                    sort_order: matrix.rows.length + 1,\\n\n                });\\n\n                this.queueAutosave();\\n\n            },\\n\n            removeRow(matrixIndex, rowIndex) {\\n\n                const matrix = this.matrices[matrixIndex];\\n\n\\n\n                if (! matrix || matrix.rows.length === 1) {\\n\n                    return;\\n\n                }\\n\n\\n\n                matrix.rows.splice(rowIndex, 1);\\n\n                this.queueAutosave();\\n\n            },\\n\n            openDeleteConfirm(matrix) {\\n\n                this.deleteMatrixKey = matrix.key;\\n\n                this.deleteMatrixName = (matrix.name || '').trim();\\n\n                this.deleteConfirming = true;\\n\n                this.deleteTypedName = '';\\n\n                this.$nextTick(() => this.$refs.deleteConfirmInput?.focus());\\n\n            },\\n\n            cancelDeleteConfirm() {\\n\n                this.deleteConfirming = false;\\n\n                this.deleteTypedName = '';\\n\n                this.deleteMatrixKey = null;\\n\n                this.deleteMatrixName = '';\\n\n            },\\n\n            canConfirmDelete() {\\n\n                return this.deleteTypedName.trim() === this.deleteMatrixName.trim();\\n\n            },\\n\n            submitDelete() {\\n\n                if (! this.canConfirmDelete() || ! this.deleteMatrixKey) {\\n\n                    return;\\n\n                }\\n\n\\n\n                const form = document.getElementById(`delete-parts-matrix-${this.deleteMatrixKey}`);\\n\n\\n\n                if (! form) {\\n\n                    return;\\n\n                }\\n\n\\n\n                let input = form.querySelector('[name=confirm_name]');\\n\n\\n\n                if (! input) {\\n\n                    input = document.createElement('input');\\n\n                    input.type = 'hidden';\\n\n                    input.name = 'confirm_name';\\n\n                    form.appendChild(input);\\n\n                }\\n\n\\n\n                input.value = this.deleteTypedName.trim();\\n\n                form.submit();\\n\n            },\\n\n            queueAutosave() {\\n\n                this.statusText = 'Save needed';\\n\n                this.autosave(false);\\n\n            },\\n\n            buildPartsMatrixFormData() {\\n\n                const form = document.getElementById('parts-matrix-form');\\n\n                const fd = new FormData();\\n\n                const token = form?.querySelector('[name=\"_token\"]')?.value;\\n\n\\n\n                if (token) {\\n\n                    fd.append('_token', token);\\n\n                }\\n\n\\n\n                fd.append('_method', 'PATCH');\\n\n                fd.append('default_parts_matrix_key', this.defaultPartsMatrixKey);\\n\n\\n\n                this.matrices.forEach((matrix, matrixIndex) => {\\n\n                    fd.append(`parts_matrices[${matrixIndex}][key]`, matrix.key);\\n\n                    fd.append(`parts_matrices[${matrixIndex}][name]`, matrix.name ?? '');\\n\n\\n\n                    matrix.rows.forEach((row, rowIndex) => {\\n\n                        fd.append(`parts_matrices[${matrixIndex}][rows][${rowIndex}][min_cost]`, row.min_cost ?? '');\\n\n                        fd.append(`parts_matrices[${matrixIndex}][rows][${rowIndex}][max_cost]`, row.max_cost ?? '');\\n\n                        fd.append(`parts_matrices[${matrixIndex}][rows][${rowIndex}][markup_percentage]`, row.markup_percentage ?? '');\\n\n                        fd.append(`parts_matrices[${matrixIndex}][rows][${rowIndex}][sort_order]`, String(rowIndex + 1));\\n\n                    });\\n\n                });\\n\n\\n\n                return fd;\\n\n            },\\n\n            parseAutosaveCommit(response, payload) {\\n\n                // Only an explicit server commit counts as success. Redirects (login, HTML) do not.\\n\n                if (! response.ok || response.type === 'opaqueredirect') {\\n\n                    return false;\\n\n                }\\n\n\\n\n                return !! payload\\n\n                    && payload.ok === true\\n\n                    && payload.committed === true;\\n\n            },\\n\n            enqueueAutosave() {\\n\n                this.saveTail = this.saveTail.catch(() => {}).then(() => this.performAutosave());\\n\n\\n\n                return this.saveTail;\\n\n            },\\n\n            performAutosave() {\\n\n                const matrixKey = this.selectedKey;\\n\n\\n\n                if (! matrixKey) {\\n\n                    return Promise.resolve();\\n\n                }\\n\n\\n\n                // Serialize saves and build the body at execution time so older in-flight\\n\n                // payloads cannot overwrite newer matrix state on the server.\\n\n                const generation = ++this.autosaveGeneration;\\n\n                const body = this.buildPartsMatrixFormData();\\n\n                this.statusText = 'Saving...';\\n\n\\n\n                return fetch(`/app/settings/shop/parts-matrices/${matrixKey}`, {\\n\n                    method: 'POST',\\n\n                    body,\\n\n                    headers: {\\n\n                        'X-Requested-With': 'XMLHttpRequest',\\n\n                        'Accept': 'application/json',\\n\n                    },\\n\n                }).then(async (response) => {\\n\n                    let payload = null;\\n\n                    const contentType = response.headers.get('Content-Type') || '';\\n\n\\n\n                    if (contentType.includes('application/json')) {\\n\n                        try {\\n\n                            payload = await response.json();\\n\n                        } catch (error) {\\n\n                            payload = null;\\n\n                        }\\n\n                    }\\n\n\\n\n                    if (! this.parseAutosaveCommit(response, payload)) {\\n\n                        throw new Error('Save failed');\\n\n                    }\\n\n\\n\n                    if (generation === this.autosaveGeneration) {\\n\n                        this.statusText = 'Saved';\\n\n                    }\\n\n                }).catch(() => {\\n\n                    if (generation === this.autosaveGeneration) {\\n\n                        this.statusText = 'Save needed';\\n\n                    }\\n\n                });\\n\n            },\\n\n            autosave(immediate = false) {\\n\n                if (! this.selectedKey) {\\n\n                    return Promise.resolve();\\n\n                }\\n\n\\n\n                clearTimeout(this.autosaveTimer);\\n\n                this.autosaveTimer = null;\\n\n\\n\n                if (immediate) {\\n\n                    return this.enqueueAutosave();\\n\n                }\\n\n\\n\n                return new Promise((resolve) => {\\n\n                    this.autosaveTimer = setTimeout(() => {\\n\n                        this.autosaveTimer = null;\\n\n                        resolve(this.enqueueAutosave());\\n\n                    }, 700);\\n\n                });\\n\n            },\\n\n        };\\n\n    };\\n\n</script>\\n\n\\n\n<div\\n\n    data-settings-parts-matrices\\n\n    x-data=\"partsMatricesPanel(JSON.parse('[{\\u0022key\\u0022:\\u0022aft-parts\\u0022,\\u0022name\\u0022:\\u0022AFT Parts\\u0022,\\u0022is_default\\u0022:true,\\u0022index\\u0022:0,\\u0022rows\\u0022:[{\\u0022uid\\u0022:\\u0022aft-parts-0\\u0022,\\u0022min_cost\\u0022:\\u00220.00\\u0022,\\u0022max_cost\\u0022:\\u00225.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022180.00\\u0022,\\u0022margin_percentage\\u0022:\\u002264\\u0022,\\u0022sort_order\\u0022:1},{\\u0022uid\\u0022:\\u0022aft-parts-1\\u0022,\\u0022min_cost\\u0022:\\u00225.01\\u0022,\\u0022max_cost\\u0022:\\u002210.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022150.00\\u0022,\\u0022margin_percentage\\u0022:\\u002260\\u0022,\\u0022sort_order\\u0022:2},{\\u0022uid\\u0022:\\u0022aft-parts-2\\u0022,\\u0022min_cost\\u0022:\\u002210.01\\u0022,\\u0022max_cost\\u0022:\\u002225.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022120.00\\u0022,\\u0022margin_percentage\\u0022:\\u002255\\u0022,\\u0022sort_order\\u0022:3},{\\u0022uid\\u0022:\\u0022aft-parts-3\\u0022,\\u0022min_cost\\u0022:\\u002225.01\\u0022,\\u0022max_cost\\u0022:\\u002250.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022110.00\\u0022,\\u0022margin_percentage\\u0022:\\u002252\\u0022,\\u0022sort_order\\u0022:4},{\\u0022uid\\u0022:\\u0022aft-parts-4\\u0022,\\u0022min_cost\\u0022:\\u002250.01\\u0022,\\u0022max_cost\\u0022:\\u0022100.00\\u0022,\\u0022markup_percentage\\u0022:\\u002295.00\\u0022,\\u0022margin_percentage\\u0022:\\u002249\\u0022,\\u0022sort_order\\u0022:5},{\\u0022uid\\u0022:\\u0022aft-parts-5\\u0022,\\u0022min_cost\\u0022:\\u0022100.01\\u0022,\\u0022max_cost\\u0022:\\u0022200.00\\u0022,\\u0022markup_percentage\\u0022:\\u002285.00\\u0022,\\u0022margin_percentage\\u0022:\\u002246\\u0022,\\u0022sort_order\\u0022:6},{\\u0022uid\\u0022:\\u0022aft-parts-6\\u0022,\\u0022min_cost\\u0022:\\u0022200.01\\u0022,\\u0022max_cost\\u0022:\\u0022500.00\\u0022,\\u0022markup_percentage\\u0022:\\u002270.00\\u0022,\\u0022margin_percentage\\u0022:\\u002241\\u0022,\\u0022sort_order\\u0022:7},{\\u0022uid\\u0022:\\u0022aft-parts-7\\u0022,\\u0022min_cost\\u0022:\\u0022500.01\\u0022,\\u0022max_cost\\u0022:\\u00221000.00\\u0022,\\u0022markup_percentage\\u0022:\\u002255.00\\u00