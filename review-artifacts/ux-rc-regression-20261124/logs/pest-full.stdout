 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10\"/><path d=\"M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14\"/><path d=\"M4 20h14\"/></svg>\\n\n                                    </span>\\n\n                                    <span class=\"nav-link-title\">Reports</span>\\n\n                                                                    </a>\\n\n                            </li>\\n\n                                                            </ul>\\n\n            </div>\\n\n        </div>\\n\n    </aside>\\n\n\\n\n    <div class=\"page-wrapper\">\\n\n        \\n\n        <header class=\"navbar navbar-expand d-print-none ark-topbar\" data-ark-topbar>\\n\n            <div class=\"container-fluid gap-2 flex-nowrap\">\\n\n                        <div class=\"ark-page-context\" id=\"ark-page-context\" x-data data-ark-page-context>\\n\n    <div class=\"ark-page-context__heading\">\\n\n                    <ol class=\"breadcrumb ark-page-context__crumbs\" aria-label=\"Breadcrumbs\">\\n\n                                    <li class=\"breadcrumb-item\">\\n\n                                                    <a href=\"http://localhost/repair-orders\">Repair Orders</a>\\n\n                                            </li>\\n\n                            </ol>\\n\n                <h2 class=\"page-title\">RO #1</h2>\\n\n                    </div>\\n\n            <div class=\"ark-page-context__actions btn-list flex-nowrap\" role=\"group\" aria-label=\"Repair order commands\" data-ark-page-actions>\\n\n            <a href=\"http://localhost/app\" class=\"btn\" data-ark-page-action=\"secondary\" aria-label=\"Job Board\">\\n\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n    <span class=\"ark-page-action__label\">Job Board</span>\\n\n</a>\\n\n                                <div class=\"btn-list flex-nowrap\" role=\"group\" aria-label=\"Repair order commands\" data-ro-command-actions>\\n\n                        <button\\n\n                type=\"button\"\\n\n                class=\"btn\"\\n\n                title=\"Review Estimate Notes\"\\n\n                aria-label=\"Review Estimate Notes\"\\n\n                @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'review-estimate-notes', context: {}, invokeEl: $event.currentTarget } }))\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\"/><path d=\"M9 17h6\"/><path d=\"M9 13h6\"/></svg>\\n\n                <span class=\"ark-ro-visit__action-label\">Review Notes</span>\\n\n            </button>\\n\n            \\n\n    <div class=\"dropdown\" data-ro-print-menu>\\n\n    <button type=\"button\" class=\"btn dropdown-toggle\" data-bs-toggle=\"dropdown\" aria-expanded=\"false\" aria-label=\"Print\" title=\"Print\">\\n\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2\"/><path d=\"M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4\"/><path d=\"M7 15a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2l0 -4\"/></svg>\\n\n        <span class=\"ark-ro-visit__action-label\">Print</span>\\n\n    </button>\\n\n    <div class=\"dropdown-menu dropdown-menu-end\" role=\"menu\">\\n\n        <button\\n\n                type=\"button\"\\n\n                role=\"menuitem\"\\n\n                class=\"dropdown-item\"\\n\n                data-ro-print-item=\"key_tag\"\\n\n                @click=\"window.arkPrintDocument?.(window.ARK_PRINTERS?.keyTag, 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/print-key-tag', $event.currentTarget, { document: 'key_tag', resolvePrinter: true })\"\\n\n            >\\n\n                Print Key Tag\\n\n            </button>\\n\n                        <button\\n\n            type=\"button\"\\n\n            role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"oil_sticker\"\\n\n            @click=\"window.arkPrintDocument?.(window.ARK_PRINTERS?.oilSticker, 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/print-oil-change-sticker', $event.currentTarget, { document: 'oil_change_sticker', resolvePrinter: true })\"\\n\n        >\\n\n            Print Oil Sticker\\n\n        </button>\\n\n                <a\\n\n            href=\"http://localhost/app/repair-orders/1/sheets/intake/pdf\"\\n\n             target=\"_blank\" rel=\"noopener\"             role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"check_in_sheet\"\\n\n                    >\\n\n            Check In sheet\\n\n        </a>\\n\n                <a\\n\n            href=\"http://localhost/app/repair-orders/1/sheets/tech/pdf\"\\n\n             target=\"_blank\" rel=\"noopener\"             role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"tech_sheet\"\\n\n                    >\\n\n            Tech sheet\\n\n        </a>\\n\n                <a\\n\n    href=\"http://localhost/app/repair-orders/1/estimate/pdf\"\\n\n    target=\"_blank\"\\n\n    rel=\"noopener\"\\n\n    data-ark-pdf-preview\\n\n        data-pdf-title=\"Estimate \u00b7 RO #1\"\\n\n    data-pdf-view-url=\"http://