ern.exec(document.cookie)) !== null) {\\n\n            var value = decodeURIComponent(match[1]);\\n\n\\n\n            if (value === 'light' || value === 'dark') {\\n\n                return value;\\n\n            }\\n\n\\n\n            fallback = value;\\n\n        }\\n\n\\n\n        return fallback;\\n\n    }\\n\n\\n\n    function writeCookie(name, value) {\\n\n        var parts = [\\n\n            name + '=' + encodeURIComponent(value),\\n\n            'path=/',\\n\n            'max-age=' + String(60 * 60 * 24 * 365),\\n\n            'SameSite=Lax',\\n\n        ];\\n\n\\n\n        if (cookieDomain) {\\n\n            parts.push('domain=' + cookieDomain);\\n\n        }\\n\n\\n\n        if (window.location.protocol === 'https:') {\\n\n            parts.push('Secure');\\n\n        }\\n\n\\n\n        document.cookie = parts.join('; ');\\n\n    }\\n\n\\n\n    function normalizeTheme(value) {\\n\n        return value === 'light' || value === 'dark' || value === 'system' ? value : null;\\n\n    }\\n\n\\n\n    var fromCookie = normalizeTheme(readCookie(cookieName));\\n\n    var fromStorage = null;\\n\n\\n\n    try {\\n\n        fromStorage = normalizeTheme(localStorage.getItem(storageKey));\\n\n    } catch (error) {\\n\n        fromStorage = null;\\n\n    }\\n\n\\n\n    var explicitCookie = fromCookie === 'light' || fromCookie === 'dark' ? fromCookie : null;\\n\n    var explicitStorage = fromStorage === 'light' || fromStorage === 'dark' ? fromStorage : null;\\n\n    var stored = explicitCookie || explicitStorage;\\n\n    var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\\n\n    var dark = stored === 'dark' || (stored === null && systemDark);\\n\n\\n\n    if (stored === 'light') {\\n\n        dark = false;\\n\n    }\\n\n\\n\n    document.documentElement.classList.toggle('dark', dark);\\n\n    document.documentElement.dataset.customerTheme = stored === 'light' || stored === 'dark' ? stored : 'system';\\n\n    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';\\n\n\\n\n    // Keep localStorage and shared cookie aligned across website + portal hosts.\\n\n    if (stored === 'light' || stored === 'dark') {\\n\n        try {\\n\n            localStorage.setItem(storageKey, stored);\\n\n        } catch (error) {\\n\n            // ignore\\n\n        }\\n\n\\n\n        if (fromCookie !== stored) {\\n\n            writeCookie(cookieName, stored);\\n\n        }\\n\n    }\\n\n\\n\n    window.__arkCustomerTheme = {\\n\n        storageKey: storageKey,\\n\n        cookieName: cookieName,\\n\n        cookieDomain: cookieDomain,\\n\n        readCookie: readCookie,\\n\n        writeCookie: writeCookie,\\n\n        normalizeTheme: normalizeTheme,\\n\n    };\\n\n})();\\n\n</script>\\n\n\\n\n                    <link rel=\"preconnect\" href=\"https://fonts.bunny.net\">\\n\n                            <link href=\"https://fonts.bunny.net/css?family=figtree:400,500,600,700,800&amp;display=swap\" rel=\"stylesheet\">\\n\n                    \\n\n                <script>\\n\n    window.arkShopChannel = (name) => '' + name;\\n\n</script>\\n\n                <style data-customer-theme>.public-surface{--public-brand:#0b5ed7;--public-brand-rgb:11 94 215;--public-brand-hover:#0951b9;--public-on-brand:#ffffff;--public-on-brand-rgb:255 255 255;--public-accent:#f59f00;--public-accent-rgb:245 159 0;--public-on-accent:#0f172a;--public-ink:#0f172a;--public-ink-rgb:15 23 42;--public-on-ink:#ffffff;--public-font-body:'Figtree', ui-sans-serif, system-ui, sans-serif;--public-font-heading:'Figtree', ui-sans-serif, system-ui, sans-serif;--public-radius-control:0.375rem;--public-radius:0.5rem;--public-radius-media:0.5rem;}html:not(.dark) .public-surface{--public-link:#0b5ed7;--public-link-rgb:11 94 215;--public-link-hover:#094db0;--public-surface-shop:#ffffff;--public-surface-shop-alt:#f7f7f8;--public-text:#0f172a;--public-border:rgb(15 23 42 / 0.12);}html.dark .public-surface{--public-link:#4886e1;--public-link-rgb:72 134 225;--public-link-hover:#6d9ee7;--public-surface-shop:#0f172a;--public-surface-shop-alt:#1d2537;--public-text:#f1f5f9;--public-text-muted:#94a3b8;--public-border:rgb(148 163 184 / 0.2);--public-ink:#f8fafc;--public-ink-rgb:248 250 252;}</style>\\n\n    </head>\\n\n    <body\\n\n        class=\"flex min-h-screen flex-col font-sans text-slate-950 antialiased public-surface\"\\n\n        data-customer-header=\"light\"\\n\n         data-public-surface-page=\"home\"     >\\n\n                <div class=\"customer-shell flex flex-1 flex-col\">\\n\n                            <header\\n\n    class=\"customer-header\"\\n\n    x-data=\"{ menuOpen: false }\"\\n\n    @keydown.escape.window=\"menuOpen = false\"\\n\n>\\n\n    <div class=\"customer-header__bar\">\\n\n        <a href=\"http://lugsnplugs.arksms.com\" class=\"customer-header__brand\">\\n\n                        <span class=\"customer-header__identity\">\\n\n                <span class=\"customer-header__name\">Demo Auto Repair</span>\\n\n                <span class=\"customer-header__meta\"></span>\\n\n            </span>\\n\n        </a>\\n\n\\n\n        <div class=\"customer-header__contact\">\\n\n            <button\\n\n    type=\"button\"\\n\n    class=\"customer-header__theme-toggle\"\\n\n    data-public-surface-theme-toggle\\n\n    aria-pressed=\"false\"\\n\n    aria-label=\"Toggle color theme\"\\n\n>\\n\n    <svg class=\"customer-header__theme-toggle-icon customer-header__theme-toggle-icon--sun\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\">\\n\n        <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\\n\n        <path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41\"></path>\\n\n    </svg>\\n\n    <svg class=\"customer-header__theme-toggle-icon customer-header__theme-toggle-icon--moon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\">\\n\n        <path d=\"M20 14.5A7.5 7.5 0 0 1 9.5 4 6.5 6.5 0 1 0 20 14.5Z\"></path>\\n\n    </svg>\\n\n</button>\\n\n\\n\n            \\n\n                            <a href=\"http://lugsnplugs.arksms.com/book\" class=\"customer-header__book\" >\\n\n                    <span class=\"customer-header__book-label-short\">Book</span>\\n\n                    <span class=\"customer-header__book-label-full\">Request an appointment</span>\\n\n                </a>\\n\n            \\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"customer-header__menu-toggle\"\\n\n                    @click=\"menuOpen = ! menuOpen\"\\n\n                    :aria-expanded=\"menuOpen.toString()\"\\n\n                    aria-controls=\"customer-nav-mobile\"\\n\n                    aria-label=\"Menu\"\\n\n                >\\n\n                    <svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\">\\n\n                        <path stroke-linecap=\"round\" d=\"M3 5h14M3 10h14M3 15h14\" />\\n\n                    </svg>\\n\n                </button>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n            <nav class=\"customer-header__nav customer-header__nav--desktop\" aria-label=\"Customer\">\\n\n            <a\\n\n        href=\"http://lugsnplugs.arksms.com\"\\n\n        class=\"customer-header__nav-link customer-header__nav-link--active\"\\n\n    >\\n\n        Home\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/services\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Services\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/common-problems\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Problems\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/warranty\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Warranty\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/financing\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Financing\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/about\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        About\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/contact\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Contact\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/portal/access\"\\n\n        class=\"customer-header__nav-link customer-header__nav-link--utility\"\\n\n    >\\n\n        Sign In\\n\n    </a>\\n\n\\n\n        </nav>\\n\n        <nav\\n\n            id=\"customer-nav-mobile\"\\n\n            class=\"customer-header__nav customer-header__nav--mobile\"\\n\n            aria-label=\"Customer\"\\n\n            x-show=\"menuOpen\"\\n\n            x-cloak\\n\n            @click=\"menuOpen = false\"\\n\n        >\\n\n            <a\\n\n        href=\"http://lugsnplugs.arksms.com\"\\n\n        class=\"customer-header__nav-link customer-header__nav-link--active\"\\n\n    >\\n\n        Home\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/services\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Services\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/common-problems\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Problems\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/warranty\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Warranty\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/financing\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Financing\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/about\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        About\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/contact\"\\n\n        class=\"customer-header__nav-link\"\\n\n    >\\n\n        Contact\\n\n    </a>\\n\n    <a\\n\n        href=\"http://lugsnplugs.arksms.com/portal/access\"\\n\n        class=\"customer-header__nav-link customer-header__nav-link--utility\"\\n\n    >\\n\n        Sign In\\n\n    </a>\\n\n\\n\n                    </nav>\\n\n    </header>\\n\n            \\n\n                                        \\n\n            <main class=\"customer-shell__main flex-1 customer-shell__main--editorial\">\\n\n                <div class=\"public-home\">\\n\n        <section class=\"public-home__hero\">\\n\n            <div class=\"public-home__copy\">\\n\n                <p class=\"public-page-eyebrow\">Shop</p>\\n\n                <h1 class=\"public-page-title mt-2\">Accurate Diagnostics. Honest Repairs.</h1>\\n\n                <p class=\"public-page-lede\">We find the problem before we sell the repair.</p>\\n\n                <p class=\"public-page-lede\">Warning light that keeps coming back? Strange noise nobody can pin down? Car running differently? Been given a big repair estimate and want a second opinion?</p>\\n\n                <p class=\"public-page-lede\">Tell us what's happening. We'll start with the evidence and figure out what the vehicle actually needs.</p>\\n\n                <p class=\"mt-6 flex flex-wrap gap-3\">\\n\n                    <a class=\"public-cta public-cta--primary\" href=\"http://lugsnplugs.arksms.com/book\">Request an appointment</a>\\n\n                                    </p>\\n\n            </div>\\n\n                    </section>\\n\n\\n\n        <section class=\"public-home__section\">\\n\n            <div class=\"public-home__split\">\\n\n                                <div class=\"public-home__copy\">\\n\n                    <h2 class=\"public-section-title\">A repair shop built around doing it right</h2>\\n\n                    <p class=\"public-page-lede\">Shop is a repair shop built around a simple idea: diagnose the vehicle first, explain what we found, and let the customer make an informed decision.</p>\\n\n                    <p class=\"public-page-lede\">We're not trying to move cars through as fast as possible. Every vehicle that comes through our shop belongs to somebody who depends on it.</p>\\n\n                    <p class=\"public-home__personal\">Every job is personal.</p>\\n\n                </div>\\n\n            </div>\\n\n        </section>\\n\n\\n\n        <section class=\"public-home__section\">\\n\n            <div class=\"public-home__copy\">\\n\n                <h2 class=\"public-section-title\">We test before we replace.</h2>\\n\n                <p class=\"public-page-lede\">A warning light, a noise, or a low reading is a clue. It is not yet the repair.</p>\\n\n                <p class=\"public-page-lede\">Before we recommend replacing parts, we test the vehicle against how that system is supposed to work. That can mean scan data, electrical testing, fuel trims, a pressure or vacuum test, and a mechanical inspection. The recommendation comes from what those tests show.</p>\\n\n                <p class=\"public-page-lede\">After the repair, the same concern is checked again. The job is finished when the evidence says the problem is gone, not when the part is on the car.</p>\\n\n            </div>\\n\n            <div class=\"public-home__photos\">\\n\n                                            </div>\\n\n        </section>\\n\n\\n\n        <section class=\"public-home__section\">\\n\n            <div class=\"public-home__copy\">\\n\n                <h2 class=\"public-section-title\">What's your car doing?</h2>\\n\n                <p class=\"public-page-lede\">Pick the closest thing. Each page says what it can mean, whether you can keep driving, and how to request an appointment.</p>\\n\n            </div>\\n\n            <ul class=\"public-home__concerns\">\\n\n                                    <li><a class=\"public-home__choice\" href=\"http://lugsnplugs.arksms.com/common-problems/check-engine-light\">Check engine light</a></li>\\n\n                                                                <li>\\n\n                    <details class=\"public-home__noise\">\\n\n                        <summary class=\"public-home__choice\">Strange noise</summary>\\n\n                        <ul>\\n\n                                                                                                                                                                                                                                        </ul>\\n\n                    </details>\\n\n                </li>\\n\n                                                                <li><a class=\"public-home__choice\" href=\"http://lugsnplugs.arksms.com/book?concern=Something%20Else\">Something else</a></li>\\n\n            </ul>\\n\n        </section>\\n\n\\n\n        <section class=\"public-home__section\">\\n\n            <div class=\"public-home__copy\">\\n\n                <h2 class=\"public-section-title\">What drivers say</h2>\\n\n                                            </div>\\n\n            <div class=\"public-home__trust-items\">\\n\n                <div>\\n\n                    <h3>Warranty</h3>\\n\n                    <p>Qualifying shop repairs are covered for 24 months or 24,000 miles on parts and labor, whichever comes first. <a class=\"public-link\" href=\"http://lugsnplugs.arksms.com/warranty\">Shop warranty</a></p>\\n\n                </div>\\n\n                                            </div>\\n\n        </section>\\n\n\\n\n        <section class=\"public-home__close\">\\n\n            <div class=\"public-home__copy\">\\n\n                <h2 class=\"public-section-title\">Tell us what's happening</h2>\\n\n                <p class=\"public-page-lede\">An appointment request is how we start. It does not reserve a bay. Tell us the concern, the vehicle, and when you would like to come in. An advisor confirms the time during business hours.</p>\\n\n                                    <p class=\"public-page-lede\">Mon\u2013Fri: 9:00 AM \u2013 6:00 PM \u00b7 Sat\u2013Sun: Closed</p>\\n\n                                                                <p class=\"mt-6 flex flex-wrap gap-3\">\\n\n                    <a class=\"public-cta public-cta--primary\" href=\"http://lugsnplugs.arksms.com/book\">Request an appointment</a>\\n\n                                    </p>\\n\n            </div>\\n\n        </section>\\n\n    </div>\\n\n            </main>\\n\n\\n\n                            <footer class=\"customer-footer mt-auto\" aria-label=\"Site footer\">\\n\n    <div class=\"customer-footer__surface\">\\n\n        <div class=\"customer-footer__inner customer-page-inset mx-auto w-full\">\\n\n            <div class=\"customer-footer__grid\">\\n\n                <div class=\"customer-footer__brand\">\\n\n                    <p class=\"customer-footer__shop-name\">Demo Auto Repair</p>\\n\n                    <div class=\"customer-footer__meta\">\\n\n                        <p class=\"customer-footer__address\">Demo Auto Repair</p>\\n\n                                                    <p class=\"customer-footer__hours\">Mon\u2013Fri: 9:00 AM \u2013 6:00 PM \u00b7 Sat\u2013Sun: Closed</p>\\n\n                                            </div>\\n\n                    <div class=\"customer-footer__contact\">\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                                    <nav class=\"customer-footer__nav\" aria-label=\"Footer\">\\n\n                        <ul class=\"customer-footer__links\">\\n\n                                                            <li><a href=\"http://lugsnplugs.arksms.com\">Home</a></li>\\n\n                                                            <li><a href=\"http://lugsnplugs.arksms.com/services\">Services</a></li>\\n\n                                  