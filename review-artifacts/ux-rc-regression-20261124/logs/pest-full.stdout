vg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                        Email\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?conversation=1&amp;filter=waiting&amp;channel=portal\"\\n\n                        class=\"dropdown-item\"\\n\n                                                data-comms-channel-option=\"portal\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M3.6 9h16.8\"/><path d=\"M3.6 15h16.8\"/><path d=\"M11.5 3a17 17 0 0 0 0 18\"/><path d=\"M12.5 3a17 17 0 0 1 0 18\"/></svg>\\n\n                        Portal\\n\n                    </a>\\n\n                            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n        <div\\n\n            id=\"ops-comms-workspace-live\"\\n\n            class=\"row g-2 g-lg-3\"\\n\n            data-fragment-url=\"http://localhost/app/communications/workspace/fragment?filter=waiting&amp;conversation=1&amp;section=inbox\"\\n\n            data-poll-signature=\"c13f8ee0a8b6d0d6663bc236d69f6bc1\"\\n\n            data-live-events=\"[]\"\\n\n            data-section=\"inbox\"\\n\n        >\\n\n            <aside\\n\n                id=\"ops-comms-workspace-list\"\\n\n                class=\"col-12 col-lg-4 col-xl-3 flex-column\"\\n\n                :class=\"threadOpen ? 'd-none d-lg-flex' : 'd-flex'\"\\n\n                ari