all text-secondary mt-1\">Assigned: Terry Tech</div>\\n\n                \\n\n                            </div>\\n\n\\n\n                            <div\\n\n        style=\"min-width: 0\"\\n\n        data-inspection-template-select\\n\n        x-data=\"{\\n\n            currentId: 1,\\n\n            pendingId: null,\\n\n            hasEvidence: false,\\n\n            confirmOpen: false,\\n\n            reason: 'wrong_template_selected',\\n\n            select(id) {\\n\n                if (Number(id) === Number(this.currentId)) {\\n\n                    return;\\n\n                }\\n\n                if (this.hasEvidence) {\\n\n                    this.pendingId = Number(id);\\n\n                    this.confirmOpen = true;\\n\n                    return;\\n\n                }\\n\n                this.$refs.quickTemplateId.value = id;\\n\n                this.$refs.assignForm.requestSubmit();\\n\n            },\\n\n            cancel() {\\n\n                this.confirmOpen = false;\\n\n                this.pendingId = null;\\n\n                this.$el.querySelectorAll('input[name=inspection_template_choice]').forEach((radio) => {\\n\n                    radio.checked = Number(radio.value) === Number(this.currentId);\\n\n                });\\n\n            }\\n\n        }\"\\n\n    >\\n\n        <form\\n\n            method=\"post\"\\n\n            action=\"http://localhost/app/repair-orders/1/inspection/template\"\\n\n            x-ref=\"assignForm\"\\n\n        >\\n\n            <input type=\"hidden\" name=\"_token\" value=\"MGkEXaqLIVenJlJyzheg6yNnfuFjvH52DfpenE7B\" autocomplete=\"off\">            <input type=\"hidden\" name=\"inspection_template_id\" x-ref=\"quickTemplateId\" value=\"1\">\\n\n            <input type=\"hidden\" name=\"confirm_template_change\" :value=\"confirmOpen ? '1' : '0'\">\\n\n            <input type=\"hidden\" name=\"template_correction_reason\" :value=\"reason\">\\n\n\\n\n            <div class=\"d-flex flex-wrap gap-3\">\\n\n       