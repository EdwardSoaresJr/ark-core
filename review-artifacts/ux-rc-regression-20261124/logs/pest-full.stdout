ist-group-item\">\\n\n                                <label for=\"inspection-item-2-17-122\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-17-122\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][17][items][122][label]\"\\n\n                                    value=\"Parking brake function\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][17][items][122][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][17][items][122][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                            </div>\\n\n                </div>\\n\n                            <div class=\"card-body border-top\">\\n\n                    <div class=\"subheader mb-2\">Road test</div>\\n\n                    <div class=\"list-group\">\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-123\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-123\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][123][label]\"\\n\n                                    value=\"Road test performed\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][123][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][123][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-124\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-124\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][124][label]\"\\n\n                                    value=\"Start / idle / abnormal noises\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][124][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][124][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-125\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-125\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][125][label]\"\\n\n                                    value=\"Acceleration / hesitation\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][125][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][125][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-126\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-126\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][126][label]\"\\n\n                                    value=\"Transmission shift quality (as equipped)\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][126][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][126][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-127\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-127\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][127][label]\"\\n\n                                    value=\"Brake performance / pull\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][127][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][127][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-128\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-128\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][128][label]\"\\n\n                                    value=\"Steering pull / wander\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][128][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][128][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-129\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-129\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][129][label]\"\\n\n                                    value=\"Vibration / NVH\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][129][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][129][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-130\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-130\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][130][label]\"\\n\n                                    value=\"Cruise / ABS event if triggered (observe only)\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][130][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][130][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-18-131\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-18-131\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][18][items][131][label]\"\\n\n                                    value=\"Post-drive leak recheck\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][131][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][18][items][131][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                            </div>\\n\n                </div>\\n\n                            <div class=\"card-body border-top\">\\n\n                    <div class=\"subheader mb-2\">Maintenance evidence</div>\\n\n                    <div class=\"list-group\">\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-2-19-132\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-2-19-132\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[2][categories][19][items][132][label]\"\\n\n                                    value=\"Service history clues / stickers / visible evidence\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][19][items][132][enabled]\" value=\"1\" checked class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Enabled</span>\\n\n                                    </label>\\n\n                                    <label class=\"form-check mb-0\">\\n\n                                        <input type=\"checkbox\" name=\"templates[2][categories][19][items][132][requires_photo]\" value=\"1\"  class=\"form-check-input\">\\n\n                                        <span class=\"form-check-label\">Photo required</span>\\n\n                                    </label>\\n\n                                </div>\\n\n                                                            </div>\\n\n                                            </div>\\n\n                </div>\\n\n                    </div>\\n\n    \\n\n            <div class=\"d-flex justify-content-end border-top pt-3\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">Save inspection checklists</button>\\n\n        </div>\\n\n    </form>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"workflow-panel-saved-work\" role=\"tabpanel\" aria-labelledby=\"workflow-tab-saved-work\" x-show=\"workflowTab === 'saved-work'\" x-cloak>\\n\n                        <h3 class=\"mb-1\">Common Jobs</h3>\\n\n                        <p class=\"text-secondary small\">Repeat jobs that author a Repair Action plus labor, parts, and fees. After Add Work, the template owns nothing - edit the RO normally.</p>\\n\n                        <div data-settings-work-templates>\\n\n    <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/settings/shop/work-templates\"\\n\n        class=\"card card-sm mb-4\"\\n\n        x-data=\"{\\n\n            lines: [{ type: 'labor', description: '', quantity: '1.00', unit_price: '', part_cost: '' }],\\n\n            addLine() {\\n\n                this.lines.push({ type: 'labor', description: '', quantity: '1.00', unit_price: '', part_cost: '' });\\n\n            },\\n\n            removeLine(index) {\\n\n                if (this.lines.length <= 1) {\\n\n                    return;\\n\n                }\\n\n                this.lines.splice(index, 1);\\n\n            },\\n\n        }\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">        <div class=\"card-header\">\\n\n            <h4 class=\"card-title\">Create Common Job</h4>\\n\n        </div>\\n\n        <div class=\"card-body\">\\n\n            <div class=\"row g-3\">\\n\n                <div class=\"col-12\">\\n\n                    <label for=\"work-template-create-title\" class=\"form-label required\">Title</label>\\n\n                    <input id=\"work-template-create-title\" type=\"text\" name=\"title\" required maxlength=\"191\" class=\"form-control\" placeholder=\"Front Brake Service\">\\n\n                </div>\\n\n                <div class=\"col-12\">\\n\n                    <label for=\"work-template-create-description\" class=\"form-label\">Description <span class=\"text-secondary fw-normal\">(optional)</span></label>\\n\n                    <input id=\"work-template-create-description\" type=\"text\" name=\"description\" maxlength=\"1000\" class=\"form-control\">\\n\n                </div>\\n\n                <div class=\"col-12\">\\n\n                    <label for=\"work-template-create-note\" class=\"form-label\">Internal note <span class=\"text-secondary fw-normal\">(optional - becomes a private note line)</span></label>\\n\n                    <textarea id=\"work-template-create-note\" name=\"internal_note\" rows=\"2\" maxlength=\"2000\" class=\"form-control\"></textarea>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label for=\"work-template-create-priority\" class=\"form-label\">Priority</label>\\n\n                    <select id=\"work-template-create-priority\" name=\"recommendation_posture\" class=\"form-select\">\\n\n            <option value=\"\" selected>No priority</option>\\n\n                <option value=\"must_do\" >Must Do</option>\\n\n            <option value=\"should_do\" >Should Do</option>\\n\n            <option value=\"could_do\" >Could Do</option>\\n\n        <option value=\"information_only\" >Information Only</option>\\n\n</select>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-6\">\\n\n                    <label for=\"work-template-create-intent\" class=\"form-label\">Work type</label>\\n\n                    <select id=\"work-template-create-intent\" name=\"recommendation_intent\" class=\"form-select\" >\\n\n            <option value=\"\" >No work type</option>\\n\n                <option value=\"maintenance\" selected>Maintenance</option>\\n\n            <option value=\"diagnostic\" >Diagnostic</option>\\n\n            <option value=\"repair_verification\" >Repair Verification</option>\\n\n    </select>\\n\n                    <div class=\"form-hint\">Used when this saved job creates a new concern. Attaching to an existing concern keeps that concern\u2019s priority and work type.</div>\\n\n                </div>\\n\n            </div>\\n\n\\n\n            <div class=\"d-flex align-items-center justify-content-between mt-4 mb-2\">\\n\n                <div class=\"subheader\">Lines</div>\\n\n                <button type=\"button\" class=\"btn btn-sm\" @click=\"addLine()\">+ Line</button>\\n\n            </div>\\n\n            <template x-for=\"(line, index) in lines\" :key=\"index\">\\n\n                <div class=\"row g-2 align-items-end border rounded p-2 mx-0 mb-2\" data-work-template-line>\\n\n                    <div class=\"col-6 col-md-2\">\\n\n                        <label class=\"form-label\" :for=\"`work-template-line-${index}-type`\">Type</label>\\n\n                        <select :id=\"`work-template-line-${index}-type`\" :name=\"`lines[${index}][type]`\" x-model=\"line.type\" class=\"form-select\">\\n\n                            <option value=\"labor\">Labor</option>\\n\n                            <option value=\"part\">Part</option>\\n\n                            <option value=\"fee\">Fee</option>\\n\n                            <option value=\"note\">Note</option>\\n\n                        </select>\\n\n                    </div>\\n\n                    <div class=\"col-12 col-md-4 order-first order-md-0\">\\n\n                        <label class=\"form-label\" :for=\"`work-template-line-${index}-description`\">Description</label>\\n\n                        <input type=\"text\" :id=\"`work-template-line-${index}-description`\" :name=\"`lines[${index}][description]`\" x-model=\"line.description\" required maxlength=\"2000\" class=\"form-control\">\\n\n                    </div>\\n\n                    <div class=\"col-6 col-md-2\">\\n\n                        <label class=\"form-label\" :for=\"`work-template-line-${index}-quantity`\" x-text=\"line.type === 'labor' ? 'Hours' : 'Qty'\"></label>\\n\n                        <input type=\"number\" step=\"0.01\" min=\"0\" :id=\"`work-template-line-${index}-quantity`\" :name=\"`lines[${index}][quantity]`\" x-model=\"line.quantity\" class=\"form-control\">\\n\n                    </div>\\n\n                    <div class=\"col-5 col-md-2\">\\n\n                        <label class=\"form-label\" :for=\"`work-template-line-${index}-price`\" x-text=\"line.type === 'labor' ? 'Rate $' : (line.type === 'fee' ? 'Fee $' : 'Sell $')\"></label>\\n\n                        <input type=\"text\" inputmode=\"decimal\" :id=\"`work-template-line-${index}-price`\" :name=\"`lines[${index}][unit_price]`\" x-model=\"line.unit_price\" class=\"form-control\" placeholder=\"0.00\">\\n\n                    </div>\\n\n                    <div class=\"col-5 col-md-1\">\\n\n                        <label class=\"form-label\" :for=\"`work-template-line-${index}-cost`\">Cost $</label>\\n\n                        <input type=\"text\" inputmode=\"decimal\" :id=\"`work-template-line-${index}-cost`\" :name=\"`lines[${index}][part_cost]`\" x-model=\"line.part_cost\" class=\"form-control\" placeholder=\"parts\">\\n\n                    </div>\\n\n                    <div class=\"col-2 col-md-1 text-end\">\\n\n                        <button type=\"button\" class=\"btn btn-icon btn-ghost-secondary\" aria-label=\"Remove line\" @click=\"removeLine(index)\" :disabled=\"lines.length <= 1\">\u00d7</button>\\n\n                    </div>\\n\n                </div>\\n\n            </template>\\n\n        </div>\\n\n        <div class=\"card-footer text-end\">\\n\n            <button type=\"submit\" class=\"btn btn-primary\">Create Common Job</button>\\n\n        </div>\\n\n    </form>\\n\n\\n\n    <div class=\"subheader mb-2\">Shop library</div>\\n\n            <p class=\"text-secondary small mb-0\">No Common Jobs yet. Create Front Brake Service or similar above.</p>\\n\n    </div>\\n\n                    </div>\\n\n                </section>\\n\n\\n\n                <section class=\"card\" x-show=\"active === 'printing'\" x-cloak data-settings-section=\"printing\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">QZ Tray / Brother QL</div>\\n\n                            <h2 class=\"card-title\">Key tags and oil change stickers</h2>\\n\n                            <div class=\"card-subtitle\">Printer names must match the OS queue exactly. Defaults: Brother QL-800, 62 \u00d7 38.1 mm.</div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"card-header\">\\n\n                        <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Label Printing\">\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"printing-tab-printers\"\\n\n                                        aria-controls=\"printing-panel-printers\"\\n\n                                        :class=\"{ 'active': printingTab === 'printers' }\"\\n\n                                        :aria-selected=\"(printingTab === 'printers').toString()\"\\n\n                                        @click=\"setPrintingTab('printers')\"\\n\n                                    >Printers &amp; labels</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"printing-tab-certificates\"\\n\n                                        aria-controls=\"printing-panel-certificates\"\\n\n                                        :class=\"{ 'active': printingTab === 'certificates' }\"\\n\n                                        :aria-selected=\"(printingTab === 'certificates').toString()\"\\n\n                                        @click=\"setPrintingTab('certificates')\"\\n\n                                    >Certificates &amp; setup</button>\\n\n                                </li>\\n\n                                                    </ul>\\n\n                    </div>\\n\n\\n\n                    <form id=\"printing-panel-printers\" role=\"tabpanel\" aria-labelledby=\"printing-tab-printers\" x-show=\"printingTab === 'printers'\" method=\"POST\" action=\"http://localhost/app/settings/shop/printing\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                                                <div class=\"card-body\">\\n\n                            <label class=\"form-check form-switch mb-3\">\\n\n                                <input type=\"hidden\" name=\"qz_printing_enabled\" value=\"0\">\\n\n                                <input type=\"checkbox\" name=\"qz_printing_enabled\" value=\"1\" checked class=\"form-check-input\">\\n\n                                <span class=\"form-check-label\">Enable QZ label printing on repair orders</span>\\n\n                            </label>\\n\n                            <div class=\"row g-3\">\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-qz-key-tag-printer\" class=\"form-label\">Key tag printer</label>\\n\n                                    <input id=\"settings-qz-key-tag-printer\" type=\"text\" name=\"qz_printing_key_tag_printer\" value=\"\" placeholder=\"Brother QL-800\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-qz-oil-sticker-printer\" class=\"form-label\">Oil sticker printer</label>\\n\n                                    <input id=\"settings-qz-oil-sticker-printer\" type=\"text\" name=\"qz_printing_oil_sticker_printer\" value=\"\" placeholder=\"Same as key tag when empty\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label for=\"settings-qz-label-width\" class=\"form-label\">Label width (mm)</label>\\n\n                                    <input id=\"settings-qz-label-width\" type=\"number\" step=\"0.1\" min=\"10\" max=\"200\" name=\"qz_key_tag_label_width_mm\" value=\"\" placeholder=\"62\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label for=\"settings-qz-label-height\" class=\"form-label\">Label height (mm)</label>\\n\n                                    <input id=\"settings-qz-label-height\" type=\"number\" step=\"0.1\" min=\"10\" max=\"200\" name=\"qz_key_tag_label_height_mm\" value=\"\" placeholder=\"38.1\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-qz-orientation\" class=\"form-label\">Label orientation</label>\\n\n                                    <select id=\"settings-qz-orientation\" name=\"qz_key_tag_orientation\" class=\"form-select\">\\n\n                                        <option value=\"portrait\" >Portrait (QL-800 default)</option>\\n\n                                        <option value=\"landscape\" >Landscape</option>\\n\n                                        <option value=\"auto\" selected>Auto (wide label \u2192 portrait)</option>\\n\n                                    </select>\\n\n                                    <div class=\"form-hint\">Use Portrait for Brother QL-800 62\u00d738.1 mm key tags and oil stickers.</div>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-qz-media\" class=\"form-label\">Label media</label>\\n\n                                    <select id=\"settings-qz-media\" name=\"qz_key_tag_media_type\" class=\"form-select\">\\n\n                                        <option value=\"mono\" selected>Monochrome</option>\\n\n                                        <option value=\"red_black\" >Red / black (DK)</option>\\n\n                                    </select>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-qz-vin-display\" class=\"form-label\">Key tag VIN display</label>\\n\n                                    <select id=\"settings-qz-vin-display\" name=\"qz_key_tag_vin_display\" class=\"form-select\">\\n\n                                        <option value=\"last6\" selected>Last 6</option>\\n\n                                        <option value=\"last8\" >Last 8</option>\\n\n                                        <option value=\"full\" >Full VIN</option>\\n\n                                    </select>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-key-tag-mileage\" class=\"form-label\">Key tag mileage required</label>\\n\n                                    <select id=\"settings-key-tag-mileage\" name=\"key_tag_mileage_requirement\" class=\"form-select\">\\n\n                                        <option value=\"none\" selected>None - print without mileage in</option>\\n\n                                        <option value=\"in\" >Mileage in - don't print until it is entered</option>\\n\n                                    </select>\\n\n                                    <div class=\"form-hint\">A blocked print says mileage in is missing. It does not print a blank tag.</div>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-qz-raster-dpi\" class=\"form-label\">Raster DPI override</label>\\n\n                                    <select id=\"settings-qz-raster-dpi\" name=\"qz_raster_dpi\" class=\"form-select\">\\n\n                                        <option value=\"\" selected>Auto</option>\\n\n                                        <option value=\"203\" >203</option>\\n\n                                        <option value=\"300\" >300</option>\\n\n                                    </select>\\n\n                                </div>\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label for=\"settings-oil-interval\" class=\"form-label\">Oil change interval (miles)</label>\\n\n                                    <input id=\"settings-oil-interval\" type=\"number\" min=\"1000\" max=\"50000\" name=\"oil_change_interval_miles\" value=\"5000\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label for=\"settings-oil-due-months\" class=\"form-label\">Oil due months</label>\\n\n                                    <input id=\"settings-oil-due-months\" type=\"number\" min=\"1\" max=\"24\" name=\"oil_change_sticker_next_due_months\" value=\"6\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                            </div>\\n\n                        </div>\\n\n                        <div class=\"card-footer text-end\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary\">Save Printing</button>\\n\n                        </div>\\n\n                    </form>\\n\n\\n\n                    <div class=\"card-body\" id=\"printing-panel-certificates\" role=\"tabpanel\" aria-labelledby=\"printing-tab-certificates\" x-show=\"printingTab === 'certificates'\" x-cloak>\\n\n                        <div data-settings-qz-certificates>\\n\n    <div class=\"mb-3 d-flex flex-wrap justify-content-between align-items-start gap-2\">\\n\n        <div>\\n\n            <div class=\"subheader\">Certificate &amp; silent printing</div>\\n\n            <h3 class=\"mb-1\">ARK-owned QZ Tray signing</h3>\\n\n            <p class=\"text-secondary small mb-0\">The ARK server signs each print request with this shop's own certificate. Each print computer trusts it once, through ARK Print Setup; after that, printing needs no Allow prompt.</p>\\n\n        </div>\\n\n        <a class=\"btn btn-primary\" href=\"http://localhost/app/printing/setup\">Set Up Printing</a>\\n\n    </div>\\n\n\\n\n    <div class=\"row g-2 mb-3\">\\n\n        <div class=\"col-6 col-lg-3\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">Signing ready</div>\\n\n                    <div class=\"h3 mb-0 text-danger\">No</div>\\n\n                    <div class=\"small text-secondary\">No certificate yet</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-6 col-lg-3\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">Self-test</div>\\n\n                    <div class=\"h3 mb-0 text-danger\">Failed</div>\\n\n                    <div class=\"small text-secondary\">SHA512 sign + verify; key matches certificate</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-6 col-lg-3\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">Certificate valid until</div>\\n\n                    <div class=\"h3 mb-0\">\u2014</div>\\n\n                    <div class=\"small text-secondary\">Not available</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-6 col-lg-3\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">Workstation trust root</div>\\n\n                    <div class=\"h3 mb-0 text-danger\">Missing</div>\\n\n                    <div class=\"small text-secondary\">Needed for ARK Print Setup</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n                                                    <div class=\"alert alert-warning mb-2\" role=\"status\">This shop has no printing certificate on the server yet. ARK support creates it with <code>php artisan ark:printing:qz-certificate --generate</code> for this shop.</div>\\n\n        \\n\n    \\n\n    \\n\n    <p class=\"small text-secondary mb-0\">\\n\n        <a href=\"http://localhost/app/api/qz/sign-health\" target=\"_blank\" rel=\"noopener\">Signing health check</a>\\n\n                \u00b7 Operator notes: <code>docs/printing/workstation-setup.md</code>.\\n\n    </p>\\n\n</div>\\n\n                    </div>\\n\n                </section>\\n\n                <section class=\"card\" x-show=\"active === 'financial'\" x-cloak data-settings-section=\"financial\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Financial Rules</div>\\n\n                            <h2 class=\"card-title\">How estimates are priced</h2>\\n\n                            <div class=\"card-subtitle\">These rules flow into line pricing, tax, shop supplies, totals, and estimate snapshots.</div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"card-header\">\\n\n                        <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Financial Rules\">\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"financial-tab-labor\"\\n\n                                        aria-controls=\"financial-panel-labor\"\\n\n                                        :class=\"{ 'active': financialTab === 'labor' }\"\\n\n                                        :aria-selected=\"(financialTab === 'labor').toString()\"\\n\n                                        @click=\"setFinancialTab('labor')\"\\n\n                                    >Labor</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"financial-tab-tax\"\\n\n                                        aria-controls=\"financial-panel-tax\"\\n\n                                        :class=\"{ 'active': financialTab === 'tax' }\"\\n\n                                        :aria-selected=\"(financialTab === 'tax').toString()\"\\n\n                                        @click=\"setFinancialTab('tax')\"\\n\n                                    >Tax Rules</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"financial-tab-shop-fees\"\\n\n                                        aria-controls=\"financial-panel-shop-fees\"\\n\n                                        :class=\"{ 'active': financialTab === 'shop-fees' }\"\\n\n                                        :aria-selected=\"(financialTab === 'shop-fees').toString()\"\\n\n                                        @click=\"setFinancialTab('shop-fees')\"\\n\n                                    >Shop Fees</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"financial-tab-deposits\"\\n\n                                        aria-controls=\"financial-panel-deposits\"\\n\n                                        :class=\"{ 'active': financialTab === 'deposits' }\"\\n\n                                        :aria-selected=\"(financialTab === 'deposits').toString()\"\\n\n                                        @click=\"setFinancialTab('deposits')\"\\n\n                                    >Deposits</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"financial-tab-parts\"\\n\n                                        aria-controls=\"financial-panel-parts\"\\n\n                                        :class=\"{ 'active': financialTab === 'parts' }\"\\n\n                                        :aria-selected=\"(financialTab === 'parts').toString()\"\\n\n                                        @click=\"setFinancialTab('parts')\"\\n\n                                    >Parts Matrix</button>\\n\n                                </li>\\n\n                                                    </ul>\\n\n                    </div>\\n\n\\n\n                    <style>\\n\n    .ops-financial-master-detail {\\n\n        --ops-financial-nav-width: 240px;\\n\n    }\\n\n\\n\n    @media (min-width: 992px) {\\n\n        .ops-financial-master-detail {\\n\n            display: flex;\\n\n            flex-wrap: nowrap;\\n\n            align-items: flex-start;\\n\n            gap: 1rem;\\n\n        }\\n\n\\n\n        .ops-financial-master-detail__nav {\\n\n            flex: 0 0 var(--ops-financial-nav-width);\\n\n            width: var(--ops-financial-nav-width);\\n\n            max-width: var(--ops-financial-nav-width);\\n\n        }\\n\n\\n\n        .ops-financial-master-detail__editor {\\n\n            flex: 1 1 auto;\\n\n            min-width: 0;\\n\n        }\\n\n    }\\n\n\\n\n    .ops-financial-master-detail__nav .list-group-item {\\n\n        overflow-wrap: anywhere;\\n\n        word-break: break-word;\\n\n    }\\n\n\\n\n    .ops-financial-master-detail__nav-item {\\n\n        display: flex;\\n\n        flex-direction: column;\\n\n        align-items: flex-start;\\n\n        gap: 0.25rem;\\n\n        text-align: left;\\n\n    }\\n\n\\n\n    .ops-financial-master-detail__nav-label {\\n\n        display: block;\\n\n        width: 100%;\\n\n        line-height: 1.25;\\n\n        overflow-wrap: anywhere;\\n\n        word-break: break-word;\\n\n    }\\n\n\\n\n    .ops-financial-master-detail__nav-item .badge {\\n\n        align-self: flex-start;\\n\n        white-space: normal;\\n\n        max-width: 100%;\\n\n        text-align: left;\\n\n    }\\n\n\\n\n    .ops-financial-master-detail__editor > :first-child {\\n\n        margin-top: 0;\\n\n    }\\n\n\\n\n    /* Labor Matrix hybrid: denser Billing Class rows (#194). */\\n\n    .labor-matrix-table--hybrid > :is(thead, tbody) > tr > :is(th, td) {\\n\n        padding-top: 0.4rem;\\n\n        padding-bottom: 0.4rem;\\n\n        vertical-align: middle;\\n\n    }\\n\n\\n\n    .labor-matrix-table--hybrid .labor-matrix-th {\\n\n        /* Native Tabler tokens only \u2014 no light-mode hex fallbacks that flash white in dark theme. */\\n\n        background-color: var(--tblr-bg-surface-tertiary);\\n\n        color: var(--tblr-secondary);\\n\n        border-bottom-color: var(--tblr-border-color);\\n\n        font-weight: 600;\\n\n    }\\n\n\\n\n    .labor-matrix-table--hybrid .form-hint {\\n\n        font-size: 0.7rem;\\n\n        line-height: 1.2;\\n\n        color: var(--tblr-secondary);\\n\n    }\\n\n\\n\n    .labor-matrix-table--hybrid tbody tr:hover > td {\\n\n        background: color-mix(in srgb, var(--tblr-primary, #206bc4) 6%, transparent);\\n\n    }\\n\n\\n\n    @media (max-width: 991.98px) {\\n\n        .labor-matrix-table--hybrid {\\n\n            min-width: 44rem;\\n\n        }\\n\n    }\\n\n</style>\\n\n\\n\n                    <div class=\"card-body\" id=\"financial-panel-labor\" role=\"tabpanel\" aria-labelledby=\"financial-tab-labor\" x-show=\"financialTab === 'labor'\" data-settings-labor>\\n\n                        <div\\n\n    class=\"labor-matrix\"\\n\n    data-settings-labor-matrix\\n\n    data-labor-matrix\\n\n    x-data=\"arkLaborMatrix(JSON.parse('{\\u0022work_types\\u0022:[{\\u0022key\\u0022:\\u0022mechanical\\u0022,\\u0022label\\u0022:\\u0022Mechanical\\u0022,\\u0022operation_class_key\\u0022:\\u0022general_repair\\u0022,\\u0022labor_category_key\\u0022:\\u0022mechanical\\u0022,\\u0022shares_class_with\\u0022:null,\\u0022is_default\\u0022:true,\\u0022is_system\\u002