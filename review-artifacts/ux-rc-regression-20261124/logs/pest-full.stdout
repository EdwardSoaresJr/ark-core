ityId\":\"1\",\"route\":\"\\/app\\/customers\\/1\",\"title\":\"Filter Customer\",\"subtitle\":\"5550100\",\"type\":\"customer\",\"id\":\"1\"}};\\n\n    </script>\\n\n\\n\n                            \\n\n        \\n\n        <main>\\n\n            <div x-data=\"arkCustomerHubTabs('work')\" x-init=\"init()\">\\n\n        <div class=\"page-body\">\\n\n    <div class=\"container-fluid\">\\n\n        <div class=\"row g-3\">\\n\n                <div class=\"col-12 col-xl-4 col-xxl-3\">\\n\n                    <div class=\"row g-3\">\\n\n                        <div class=\"col-12 col-md col-xl-12\">\\n\n                            <div class=\"card\">\\n\n                                <div class=\"card-body\">\\n\n                                    <div class=\"text-secondary small\">\\n\n                                        Retail\\n\n                                                                                \u00b7 1 vehicle\\n\n                                        \u00b7 1 active RO\\n\n                                        \u00b7 1 recent visit\\n\n                                    </div>\\n\n\\n\n                                    <div class=\"mt-3 d-flex flex-column gap-1\">\\n\n                                        <div class=\"d-flex align-items-center gap-2\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                                                                                            <span class=\"fw-bold\">5550100</span>\\n\n                                                                                    </div>\\n\n                                        <div class=\"d-flex align-items-center gap-2 text-truncate\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                                                                                            <a href=\"mailto:customer@example.test\" class=\"text-truncate\">customer@example.test</a>\\n\n                                                                                    </div>\\n\n                                                                            </div>\\n\n\\n\n                                    \\n\n                                                                            <div class=\"mt-2 d-flex flex-wrap gap-1\">\\n\n                                                                                                                                        <span class=\"badge bg-orange-lt\">1 active RO</span>\\n\n                                                                                    </div>\\n\n                                                                    </div>\\n\n\\n\n                                                            </div>\\n\n                        </div>\\n\n\\n\n                                                    <div class=\"col-12 col-md col-xl-12\">\\n\n                                <section id=\"open-repair-orders\" class=\"card\">\\n\n        <div class=\"card-status-top bg-orange\"></div>\\n\n        <div class=\"card-header\">\\n\n            <div>\\n\n                <h3 class=\"card-title\">Active Work</h3>\\n\n                <div class=\"text-secondary small\">1 open repair order need attention</div>\\n\n            </div>\\n\n            <div class=\"card-actions\">\\n\n                <button type=\"button\" class=\"btn btn-sm\" x-on:click=\"selectTab('work')\">View all</button>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"list-group list-group-flush\">\\n\n                            <a\\n\n                    href=\"http://localhost/app/repair-orders/1\"\\n\n                    class=\"list-group-item list-group-item-action\"\\n\n                >\\n\n                    <div class=\"d-flex flex-wrap align-items-baseline gap-1\">\\n\n                        <span class=\"fw-bold\">RO #1</span>\\n\n                        <span class=\"text-secondary\">\u00b7</span>\\n\n                        <span class=\"fw-medium\">2021 Honda Civic</span>\\n\n                    </div>\\n\n                    <div class=\"d-flex flex-wrap justify-content-between gap-2 small text-secondary\">\\n\n                        <span>In Progress</span>\\n\n                        <span class=\"fw-medium\">No customer communication logged</span>\\n\n                    </div>\\n\n                </a>\\n\n                                </div>\\n\n    </section>\\n\n                            </div>\\n\n                                            </div>\\n\n                </div>\\n\n\\n\n                <div class=\"col-12 col-xl-8 col-xxl-9\">\\n\n                    \\n\n                    <div class=\"card\">\\n\n                        <div class=\"card-header\">\\n\n                            <ul class=\"nav nav-tabs card-header-tabs\" aria-label=\"Customer hub sections\">\\n\n                                                                    <li class=\"nav-item\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"nav-link\"\\n\n                                            :class=\"{ active: tab === 'work' }\"\\n\n                                            x-on:click=\"selectTab('work')\"\\n\n                                            :aria-current=\"tab === 'work' ? 'page' : false\"\\n\n                                        >\\n\n                                            Work\\n\n                                                                                            <span class=\"badge bg-secondary-lt ms-2\">1</span>\\n\n                                                                                    </button>\\n\n                                    </li>\\n\n                                                                    <li class=\"nav-item\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"nav-link\"\\n\n                                            :class=\"{ active: tab === 'vehicles' }\"\\n\n                                            x-on:click=\"selectTab('vehicles')\"\\n\n                                            :aria-current=\"tab === 'vehicles' ? 'page' : false\"\\n\n                                        >\\n\n                                            Vehicles\\n\n                                                                                            <span class=\"badge bg-secondary-lt ms-2\">1</span>\\n\n                                                                                    </button>\\n\n                                    </li>\\n\n                                                                    <li class=\"nav-item\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"nav-link\"\\n\n                                            :class=\"{ active: tab === 'comms' }\"\\n\n                                            x-on:click=\"selectTab('comms')\"\\n\n                                            :aria-current=\"tab === 'comms' ? 'page' : false\"\\n\n                                        >\\n\n                                            Comms\\n\n                                                                                    </button>\\n\n                                    </li>\\n\n                                                                    <li class=\"nav-item\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"nav-link\"\\n\n                                            :class=\"{ active: tab === 'visits' }\"\\n\n                                            x-on:click=\"selectTab('visits')\"\\n\n                                            :aria-current=\"tab === 'visits' ? 'page' : false\"\\n\n                                        >\\n\n                                            History\\n\n                                                                                            <span class=\"badge bg-secondary-lt ms-2\">1</span>\\n\n                                                                                    </button>\\n\n                                    </li>\\n\n                                                                    <li class=\"nav-item\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"nav-link\"\\n\n                                            :class=\"{ active: tab === 'documents' }\"\\n\n                                            x-on:click=\"selectTab('documents')\"\\n\n                                            :aria-current=\"tab === 'documents' ? 'page' : false\"\\n\n                                        >\\n\n                                            Documents\\n\n                                                                                    </button>\\n\n                                    </li>\\n\n                                                            </ul>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'work'\" x-cloak id=\"customer-work\">\\n\n                            <div  data-conversation-context>\\n\n    \\n\n    \\n\n    \\n\n        <div id=\"open-repair-orders\">\\n\n        <div class=\"card-body border-bottom py-2\">\\n\n            <h3 class=\"card-title mb-0\">Active Work</h3>\\n\n            <div class=\"text-secondary small\">\\n\n                                    Open repair orders across all vehicles - status, workflow posture, and next action.\\n\n                            </div>\\n\n        </div>\\n\n        <div class=\"list-group list-group-flush\">\\n\n                                            <div class=\"list-group-item\" data-open-repair-order=\"1\">\\n\n                    <div class=\"d-flex flex-wrap align-items-start justify-content-between gap-2\">\\n\n                        <div>\\n\n                            <div class=\"fw-bold\">2021 Honda Civic</div>\\n\n                            <div class=\"small\">\\n\n                                <a href=\"http://localhost/app/repair-orders/1#builder\">RO #1</a>\\n\n                                                            </div>\\n\n                        </div>\\n\n                        <div class=\"flex-shrink-0\">\\n\n                            <div\\n\n            class=\"d-inline-block\"\\n\n            x-data=\"arkFloatingCommsMenu({ align: 'right', minWidth: 176, flipThreshold: 240 })\"\\n\n            x-ref=\"menuRoot\"\\n\n            \\n\n        >\\n\n            <button\\n\n                type=\"button\"\\n\n                x-ref=\"menuTrigger\"\\n\n                class=\"badge bg-secondary-lt border-0 dropdown-toggle\"\\n\n                @click.stop=\"toggleMenu()\"\\n\n                :aria-expanded=\"menuOpen\"\\n\n                aria-haspopup=\"menu\"\\n\n                title=\"Change status\"\\n\n            >In Progress</button>\\n\n\\n\n            <template x-teleport=\"body\">\\n\n                <div\\n\n                    x-show=\"menuOpen\"\\n\n                    x-cloak\\n\n                    x-ref=\"menuPanel\"\\n\n                    :style=\"menuStyle\"\\n\n                    class=\"dropdown-menu show position-fixed\"\\n\n                    role=\"menu\"\\n\n                    @click.stop\\n\n                    @wheel.stop\\n\n                >\\n\n                    <h6 class=\"dropdown-header\" role=\"presentation\">Move to</h6>\\n\n                                                                        <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/lifecycle\" class=\"m-0\">\\n\n                                <input type=\"hidden\" name=\"_token\" value=\"ftEIYziWv8VR2oGfDtVpNy7oJYPq7RgVTLwnePEG\" autocomplete=\"off\">                                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                                <input type=\"hidden\" name=\"status\" value=\"ready_pickup\">\\n\n                                <button type=\"submit\" role=\"menuitem\" class=\"dropdown-item\">Ready for Pickup</button>\\n\n                            </form>\\n\n                                                                                                <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/lifecycle\" class=\"m-0\">\\n\n                                <input type=\"hidden\" name=\"_token\" value=\"ftEIYziWv8VR2oGfDtVpNy7oJYPq7RgVTLwnePEG\" autocomplete=\"off\">                                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                                <input type=\"hidden\" name=\"status\" value=\"quality_check\">\\n\n                                <button type=\"submit\" role=\"menuitem\" class=\"dropdown-item\">Quality Check</button>\\n\n                            </form>\\n\n                                                                                                <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/lifecycle\" class=\"m-0\">\\n\n                                <input type=\"hidden\" name=\"_token\" value=\"ftEIYziWv8VR2oGfDtVpNy7oJYPq7RgVTLwnePEG\" autocomplete=\"off\">                                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                                <input type=\"hidden\" name=\"status\" value=\"waiting_parts\">\\n\n                                <button type=\"submit\" role=\"menuitem\" class=\"dropdown-item\">Waiting Parts</button>\\n\n                            </form>\\n\n                                                            </div>\\n\n            </template>\\n\n        </div>\\n\n                            </div>\\n\n                    </div>\\n\n                    <div class=\"d-flex flex-wrap align-items-center column-gap-2 mt-1 small\">\\n\n                                                    <a href=\"http://localhost/app/customers/1\">Filter Customer</a>\\n\n                                                                            <a href=\"http://localhost/app/customers/1?compose=text#customer-communication\" title=\"Open communications\">5550100</a>\\n\n                                                                            <a href=\"http://localhost/app/repair-orders/1\">Open RO</a>\\n\n                                            </div>\\n\n                    <div class=\"mt-1 small\">\\n\n                        <span class=\"fw-bold\">Workflow:</span> No customer communication logged\\n\n                    </div>\\n\n                                            <div class=\"mt-2\">\\n\n                            <div class=\"border rounded p-2 small\" data-orientation-snippet>\\n\n        <div class=\"d-flex flex-wrap align-items-start justify-content-between gap-2\">\\n\n            <div class=\"fw-medium\">Repair In Progress</div>\\n\n                            <span class=\"d-inline-flex align-items-center gap-1 text-secondary\">\\n\n                    <span class=\"status-dot status-secondary\" data-orientation-owner-signal=\"advisor\" aria-hidden=\"true\"></span>\\n\n                    Advisor\\n\n                </span>\\n\n                    </div>\\n\n\\n\n                    <p class=\"mt-1 mb-0\">In Progress.</p>\\n\n        \\n\n                                    <div class=\"mt-1 text-secondary\">\\n\n                                            <p class=\"mb-0\">Continue approved work.</p>\\n\n                                    </div>\\n\n            \\n\n                            <ul class=\"mt-1 mb-0 ps-3 text-secondary\" style=\"list-style: disc\">\\n\n                                            <li>Customer concern captured</li>\\n\n                                            <li>Inspection findings recorded</li>\\n\n                                    </ul>\\n\n                        </div>\\n\n                        </div>\\n\n                                        <div class=\"small text-secondary\">No communication action pending</div>\\n\n                </div>\\n\n                    </div>\\n\n    </div>\\n\n    \\n\n    </div>\\n\n\\n\n\\n\n<div class=\"card-body border-top py-2\">\\n\n    <div class=\"subheader\">All visits</div>\\n\n    <div class=\"text-secondary small\">Closed and historical repair orders live on the History tab.</div>\\n\n</div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'vehicles'\">\\n\n                            <div class=\"card-body border-bottom py-2 d-flex flex-wrap align-items-center gap-2\">\\n\n    <h3 class=\"card-title mb-0 me-auto\">Fleet</h3>\\n\n            <button\\n\n            type=\"button\"\\n\n            class=\"btn\"\\n\n            title=\"Open to add vehicle\"\\n\n            x-on:click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'hub-vehicle-create', invokeEl: $event.currentTarget } }))\"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M5 12l14 0\"/></svg>\\n\n            Add vehicle\\n\n        </button>\\n\n    </div>\\n\n\\n\n<div class=\"card-body\" x-data=\"{ activeRoVehicleId: null, pendingRemoveVehicleId: null }\">\\n\n            <div class=\"ark-card-grid\" style=\"--ark-card-min-width: 22rem\">\\n\n                            \\n\n                <section id=\"vehicle-1\" class=\"card card-sm\">\\n\n                    <div class=\"card-status-start bg-orange\"></div>\\n\n                    <div class=\"card-body\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/customers/1?vehicle=1\"\\n\n                            class=\"d-block fw-bold text-reset text-truncate\"\\n\n                            title=\"2021 Honda Civic\"\\n\n                        >2021 Honda Civic</a>\\n\n                        <span class=\"badge mt-1 bg-orange-lt\">In Progress</span>\\n\n\\n\n                                                    <div class=\"small text-secondary mt-2\">Powertrain not recorded</div>\\n\n                        \\n\n                        \\n\n                        <div class=\"small text-secondary mt-1\">\\n\n                            Plate COM123                            \u00b7\\n\n                                                            <span\\n\n        class=\"d-inline-flex align-items-center gap-1\"\\n\n        x-data=\"arkVinDisplay('2HGFC2F59MH123456')\"\\n\n        data-vin-display\\n\n    >\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"trigger\"\\n\n            class=\"btn btn-link p-0 font-monospace text-reset ops-vin-copyable\"\\n\n            @click=\"copy()\"\\n\n            title=\"Click to copy VIN\"\\n\n            :aria-label=\"'Copy VIN ' + vin\"\\n\n        >\\n\n                            <span class=\"text-secondary\">2HGFC2F59</span>\\n\n                        <span class=\"fw-bold\">MH123456</span>\\n\n        </button>\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"readback\"\\n\n            class=\"btn btn-sm btn-ghost-secondary btn-icon p-0 ops-vin-readback-btn\"\\n\n            @click.stop=\"toggleReadback()\"\\n\n            @mouseenter=\"onReadbackHoverEnter()\"\\n\n            @mouseleave=\"onReadbackHoverLeave()\"\\n\n            @focus=\"onReadbackHoverEnter()\"\\n\n            @blur=\"onReadbackHoverLeave()\"\\n\n            :aria-expanded=\"readbackOpen ? 'true' : 'false'\"\\n\n            aria-controls=\"vin-readback-6b05baef779c4\"\\n\n            aria-haspopup=\"dialog\"\\n\n            aria-label=\"VIN readback\"\\n\n            title=\"VIN readback\"\\n\n            data-vin-readback-trigger\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 16v-6a2 2 0 1 1 4 0v6\"/><path d=\"M3 13h4\"/><path d=\"M10 8v6a2 2 0 1 0 4 0v-1a2 2 0 1 0 -4 0v1\"/><path d=\"M20.732 12a2 2 0 0 0 -3.732 1v1a2 2 0 0 0 3.726 1.01\"/></svg>\\n\n        </button>\\n\n        <span class=\"badge bg-green-lt\" x-show=\"copied\" x-cloak role=\"status\" aria-live=\"polite\">VIN copied</span>\\n\n\\n\n        <template x-teleport=\"body\">\\n\n            <div x-show=\"readbackOpen\" x-cloak data-vin-readback-layer>\\n\n                <div\\n\n                    x-ref=\"backdrop\"\\n\n                    x-show=\"sheetMode\"\\n\n                    x-cloak\\n\n                    class=\"offcanvas-backdrop fade show ops-vin-readback-backdrop\"\\n\n                    @click=\"closeReadback()\"\\n\n                ></div>\\n\n                <div\\n\n                    id=\"vin-readback-6b05baef779c4\"\\n\n                    x-ref=\"panel\"\\n\n                    :class=\"sheetMode\\n\n                        ? 'offcanvas offcanvas-bottom h-auto show ops-vin-readback-sheet'\\n\n                        : 'card card-sm shadow position-fixed p-2 ops-vin-tooltip-layer ops-vin-readback-popover'\"\\n\n                    :style=\"sheetMode ? '' : tooltipStyle\"\\n\n                    role=\"dialog\"\\n\n                    aria-modal=\"true\"\\n\n                    aria-label=\"VIN readback\"\\n\n                    tabindex=\"-1\"\\n\n                    data-vin-phonetic-readback\\n\n                    @mouseenter=\"onReadbackHoverEnter()\"\\n\n                    @mouseleave=\"onReadbackHoverLeave()\"\\n\n                    @keydown.escape.stop=\"closeReadback()\"\\n\n                >\\n\n                    <div class=\"d-flex align-items-start justify-content-between gap-2 mb-2\">\\n\n                        <span class=\"subheader mb-0\">VIN readback</span>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close VIN readback\" @click=\"closeReadback()\"></button>\\n\n                    </div>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small text-secondary\">\\n\n                                WMI\\n\n                                <span class=\"text-secondary fw-normal\">1\u20133 \u00b7 manufacturer</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">2</span>\\n\n                                        <span class=\"small text-secondary\">Two</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">H</span>\\n\n                                        <span class=\"small text-secondary\">Hotel</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">G</span>\\n\n                                        <span class=\"small text-secondary\">Golf</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small text-secondary\">\\n\n                                VDS\\n\n                                <span class=\"text-secondary fw-normal\">4\u20139 \u00b7 descriptor</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">F</span>\\n\n                                        <span class=\"small text-secondary\">Foxtrot</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">C</span>\\n\n      