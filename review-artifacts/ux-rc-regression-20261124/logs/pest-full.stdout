ted.phone\\n\n                            ? ('Text ' + this.selected.name + ' via shop SMS')\\n\n                            : (this.selected.name + ' has no phone on file');\\n\n                    },\\n\n                    get emailTitle() {\\n\n                        if (! this.selected) {\\n\n                            return 'Choose who to email';\\n\n                        }\\n\n\\n\n                        return this.selected.email\\n\n                            ? ('Email ' + this.selected.name)\\n\n                            : (this.selected.name + ' has no email on file');\\n\n                    },\\n\n                    async send(channel) {\\n\n                        if (this.sending !== null || ! this.selectedId) {\\n\n                            return;\\n\n                        }\\n\n\\n\n                        if (channel === 'sms' && ! this.canSms) {\\n\n                            return;\\n\n                        }\\n\n\\n\n                        if (channel === 'email' && ! this.canEmail) {\\n\n                            return;\\n\n                        }\\n\n\\n\n                        this.sending = channel;\\n\n                        this.status = null;\\n\n                        this.error = null;\\n\n\\n\n                        try {\\n\n                            const response = await fetch(this.sendUrl, {\\n\n                                method: 'POST',\\n\n                                headers: {\\n\n                                    'Accept': 'application/json',\\n\n                                    'Content-Type': 'application/json',\\n\n                                    'X-Requested-With': 'XMLHttpRequest',\\n\n                                    'X-CSRF-TOKEN': document.querySelector('meta[name=csrf-token]')?.content || '',\\n\n                                },\\n\n                                body: JSON.stringify({\\n\n                                    user_id: this.selectedId,\\n\n          