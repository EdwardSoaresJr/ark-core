-fill\">\\n\n        <div class=\"d-flex align-items-center gap-2 flex-shrink-0 mb-2\" data-comms-section-bar>\\n\n    <nav class=\"flex-fill overflow-auto ark-comms-lanes\" aria-label=\"Communications sections\" data-comms-section-nav>\\n\n        <ul class=\"nav nav-pills flex-nowrap\">\\n\n                                                <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?conversation=1&amp;filter=needs\"\\n\n                            title=\"Shop action is due now - reply, overdue follow-up, or unresolved call\"\\n\n                            class=\"nav-link text-nowrap\"\\n\n                                                    >\\n\n                            <span>Needs attention</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"needs\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?conversation=1&amp;filter=waiting\"\\n\n                            title=\"Open - awaiting a customer reply or a follow-up that is not due yet\"\\n\n                            class=\"nav-link text-nowrap active\"\\n\n                             aria-current=\"page\"                         >\\n\n                            <span>Waiting</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"waiting\">1</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?conversation