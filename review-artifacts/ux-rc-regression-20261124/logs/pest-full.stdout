0022:\\u0022Waiting\\u0022,\\u0022swatch\\u0022:\\u0022#f97316\\u0022,\\u0022chip_tone\\u0022:\\u0022approval\\u0022},{\\u0022key\\u0022:\\u0022info\\u0022,\\u0022label\\u0022:\\u0022Info\\u0022,\\u0022swatch\\u0022:\\u0022#f59e0b\\u0022,\\u0022chip_tone\\u0022:\\u0022blocked\\u0022},{\\u0022key\\u0022:\\u0022primary\\u0022,\\u0022label\\u0022:\\u0022In motion\\u0022,\\u0022swatch\\u0022:\\u0022#0ea5e9\\u0022,\\u0022chip_tone\\u0022:\\u0022motion\\u0022},{\\u0022key\\u0022:\\u0022success\\u0022,\\u0022label\\u0022:\\u0022Ready\\u0022,\\u0022swatch\\u0022:\\u0022#10b981\\u0022,\\u0022chip_tone\\u0022:\\u0022ready\\u0022}]'),\\n\n        get selected() {\\n\n            return this.options.find((option) => option.key === this.value) ?? this.options[0];\\n\n        },\\n\n        choose(key) {\\n\n            this.value = key;\\n\n            this.open = false;\\n\n        },\\n\n    }\"\\n\n    @keydown.escape.window=\"open = false\"\\n\n>\\n\n    <input type=\"hidden\" name=\"lanes[completed][color]\" x-model=\"value\">\\n\n\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"form-select d-flex align-items-center gap-2 text-start\"\\n\n        @click=\"open = !open\"\\n\n        :aria-expanded=\"open.toString()\"\\n\n        aria-haspopup=\"listbox\"\\n\n         aria-labelledby=\"lane-completed-color\"     >\\n\n        <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${selected?.swatch || '#94a3b8'}`\" aria-hidden=\"true\"></span>\\n\n        <span class=\"text-truncate\" x-text=\"selected?.label || 'Color'\"></span>\\n\n    </button>\\n\n\\n\n    <div\\n\n        x-show=\"open\"\\n\n        x-cloak\\n\n        @click.outside=\"open = false\"\\n\n        class=\"dropdown-menu show w-100\"\\n\n        role=\"listbox\"\\n\n    >\\n\n        <template x-for=\"option in options\" :key=\"option.key\">\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"dropdown-item d-flex align-items-center gap-2\"\\n\n                :class=\"{ 'active': option.key === value }\"\\n\n                @click=\"choose(option.key)\"\\n\n                role=\"option\"\\n\n                :aria-selected=\"(option.key === value).toString()\"\\n\n            >\\n\n                <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${option.swatch}`\" aria-hidden=\"true\"></span>\\n\n                <span x-text=\"option.label\"></span>\\n\n            </button>\\n\n        </template>\\n\n    </div>\\n\n</div>\\n\n                        </div>\\n\n                        <div class=\"col-4 col-sm-3 col-xl-1\">\\n\n                            <label for=\"lane-completed-order\" class=\"form-label\">Order</label>\\n\n                            <input\\n\n                                id=\"lane-completed-order\"\\n\n                                type=\"number\"\\n\n                                name=\"lanes[completed][sort_order]\"\\n\n                                value=\"4\"\\n\n                                min=\"0\"\\n\n                                max=\"999\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"col-8 col-sm-9 col-xl-3\">\\n\n                            <label class=\"form-check mb-2\">\\n\n                                <input type=\"hidden\" name=\"lanes[completed][active]\" value=\"0\">\\n\n                                <input\\n\n                                    type=\"checkbox\"\\n\n                                    name=\"lanes[completed][active]\"\\n\n                                    value=\"1\"\\n\n                                    checked                                    class=\"form-check-input\"\\n\n                                >\\n\n                                <span class=\"form-check-label\">Show on Job Board</span>\\n\n                            </label>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n    <div class=\"card card-sm\">\\n\n        <div class=\"card-header\">\\n\n            <div>\\n\n                <h4 class=\"card-title\">Add lane</h4>\\n\n                <div class=\"card-subtitle\">Add another shop queue, then assign statuses to it below.</div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"card-body\">\\n\n            <div class=\"row g-2 align-items-end\">\\n\n                <div class=\"col-12 col-md-5\">\\n\n                    <label for=\"lane-create-name\" class=\"form-label\">Name</label>\\n\n                    <input\\n\n                        id=\"lane-create-name\"\\n\n                        type=\"text\"\\n\n                        name=\"create[name]\"\\n\n                        value=\"\"\\n\n                        maxlength=\"64\"\\n\n                        placeholder=\"e.g. Sublet\"\\n\n                        class=\"form-control\"\\n\n                    >\\n\n                </div>\\n\n                <div class=\"col-12 col-md-4\">\\n\n                    <div id=\"lane-create-color\" class=\"form-label\">Color</div>\\n\n                    <div\\n\n    class=\"dropdown\"\\n\n    x-data=\"{\\n\n        open: false,\\n\n        value: 'secondary',\\n\n        options: JSON.parse('[{\\u0022key\\u0022:\\u0022dark\\u0022,\\u0022label\\u0022:\\u0022Slate\\u0022,\\u0022swatch\\u0022:\\u0022#334155\\u0022,\\u0022chip_tone\\u0022:\\u0022closed\\u0022},{\\u0022key\\u0022:\\u0022secondary\\u0022,\\u0022label\\u0022:\\u0022Neutral\\u0022,\\u0022swatch\\u0022:\\u0022#94a3b8\\u0022,\\u0022chip_tone\\u0022:\\u0022move\\u0022},{\\u0022key\\u0022:\\u0022warning\\u0022,\\u0022label\\u0022:\\u0022Waiting\\u0022,\\u0022swatch\\u0022:\\u0022#f97316\\u0022,\\u0022chip_tone\\u0022:\\u0022approval\\u0022},{\\u0022key\\u0022:\\u0022info\\u0022,\\u0022label\\u0022:\\u0022Info\\u0022,\\u0022swatch\\u0022:\\u0022#f59e0b\\u0022,\\u0022chip_tone\\u0022:\\u0022blocked\\u0022},{\\u0022key\\u0022:\\u0022primary\\u0022,\\u0022label\\u0022:\\u0022In motion\\u0022,\\u0022swatch\\u0022:\\u0022#0ea5e9\\u0022,\\u0022chip_tone\\u0022:\\u0022motion\\u0022},{\\u0022key\\u0022:\\u0022success\\u0022,\\u0022label\\u0022:\\u0022Ready\\u0022,\\u0022swatch\\u0022:\\u0022#10b981\\u0022,\\u0022chip_tone\\u0022:\\u0022ready\\u0022}]'),\\n\n        get selected() {\\n\n            return this.options.find((option) => option.key === this.value) ?? this.options[0];\\n\n        },\\n\n        choose(key) {\\n\n            this.value = key;\\n\n            this.open = false;\\n\n        },\\n\n    }\"\\n\n    @keydown.escape.window=\"open = false\"\\n\n>\\n\n    <input type=\"hidden\" name=\"create[color]\" x-model=\"value\">\\n\n\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"form-select d-flex align-items-center gap-2 text-start\"\\n\n        @click=\"open = !open\"\\n\n        :aria-expanded=\"open.toString()\"\\n\n        aria-haspopup=\"listbox\"\\n\n         aria-labelledby=\"lane-create-color\"     >\\n\n        <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${selected?.swatch || '#94a3b8'}`\" aria-hidden=\"true\"></span>\\n\n        <span class=\"text-truncate\" x-text=\"selected?.label || 'Color'\"></span>\\n\n    </button>\\n\n\\n\n    <div\\n\n        x-show=\"open\"\\n\n        x-cloak\\n\n        @click.outside=\"open = false\"\\n\n        class=\"dropdown-menu show w-100\"\\n\n        role=\"listbox\"\\n\n    >\\n\n        <template x-for=\"option in options\" :key=\"option.key\">\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"dropdown-item d-flex align-items-center gap-2\"\\n\n                :class=\"{ 'active': option.key === value }\"\\n\n                @click=\"choose(option.key)\"\\n\n                role=\"option\"\\n\n                :aria-selected=\"(option.key === value).toString()\"\\n\n            >\\n\n                <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${option.swatch}`\" aria-hidden=\"true\"></span>\\n\n                <span x-text=\"option.label\"></span>\\n\n            </button>\\n\n        </template>\\n\n    </div>\\n\n</div>\\n\n                </div>\\n\n                <div class=\"col-12 col-md-3 d-grid d-md-flex justify-content-md-end\">\\n\n                    <button type=\"submit\" class=\"btn btn-primary\">Save Job Board lanes</button>\\n\n                </div>\\n\n            </div>\\n\n                                </div>\\n\n    </div>\\n\n</form>\\n\n                        <h3 class=\"mt-5 mb-1\">RO statuses</h3>\\n\n                        <p class=\"text-secondary small\">Configured operational state for each vehicle. Status color is independent of lane color and of ARK attention.</p>\\n\n                        <div class=\"alert alert-warning mb-0\" role=\"status\">\\n\n        Status catalog not seeded yet. Run <code>php artisan db:seed --class=RepairOrderStatusCatalogSeeder</code>.\\n\n    </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"workflow-panel-inspections\" role=\"tabpanel\" aria-labelledby=\"workflow-tab-inspections\" x-show=\"workflowTab === 'inspections'\" x-cloak>\\n\n                        <h3 class=\"mb-1\">Inspection checklists</h3>\\n\n                        <p class=\"text-secondary small\">Mobile technician checklists - item labels, photo requirements, and measurements. Templates add the checklist rows to each RO. Technicians record findings on each checklist item.</p>\\n\n                        <form method=\"POST\" action=\"http://localhost/app/settings/shop/inspection-templates\" data-settings-inspection-templates>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n            <div class=\"card card-sm mb-3\">\\n\n            <div class=\"card-header\">\\n\n                <div>\\n\n                    <h4 class=\"card-title\">Standard Vehicle Inspection</h4>\\n\n                    <div class=\"card-subtitle\">Technicians see this as the vehicle inspection checklist on mobile.</div>\\n\n                </div>\\n\n                <div class=\"card-actions\">\\n\n                    <label class=\"form-check form-switch mb-0\">\\n\n                        <input\\n\n                            type=\"checkbox\"\\n\n                            name=\"templates[1][enabled]\"\\n\n                            value=\"1\"\\n\n                            checked                            class=\"form-check-input\"\\n\n                        >\\n\n                        <span class=\"form-check-label\">Enabled</span>\\n\n                    </label>\\n\n                </div>\\n\n            </div>\\n\n\\n\n                            <div class=\"card-body border-top\">\\n\n                    <div class=\"subheader mb-2\">Rear axle</div>\\n\n                    <div class=\"list-group\">\\n\n                                                                                <div class=\"list-group-item\">\\n\n                                <label for=\"inspection-item-1-1-1\" class=\"visually-hidden\">Checklist item</label>\\n\n                                <input\\n\n                                    id=\"inspection-item-1-1-1\"\\n\n                                    type=\"text\"\\n\n                                    name=\"templates[1][categories][1][items][1][label]\"\\n\n                                    value=\"Rear axle brake type\"\\n\n                                    class=\"form-control fw-medium\"\\n\n                                >\\n\n                                <div class=\"d-flex flex-wrap gap-3 mt-2\">\\n\n                                    <label class=\"form-check mb-0\">\\n\n              