t: 600;\\n\n        }\\n\n\\n\n        .charge-amount {\\n\n            color: #0f172a;\\n\n            font-size: 11px;\\n\n            font-weight: 700;\\n\n            text-align: right;\\n\n            white-space: nowrap;\\n\n            font-variant-numeric: tabular-nums;\\n\n        }\\n\n\\n\n        .charge-row--total {\\n\n            margin-top: 0.04in;\\n\n            padding-top: 0.06in;\\n\n            border-top: 1px solid #94a3b8;\\n\n        }\\n\n\\n\n        .charge-row--total .charge-desc,\\n\n        .charge-row--total .charge-amount {\\n\n            font-size: 12px;\\n\n            font-weight: 800;\\n\n        }\\n\n\\n\n        h1,\\n\n        h2,\\n\n        h3,\\n\n        p {\\n\n            margin: 0;\\n\n        }\\n\n\\n\n        h1 {\\n\n            font-size: 20px;\\n\n            line-height: 1.05;\\n\n        }\\n\n\\n\n        h2 {\\n\n            font-size: 14px;\\n\n        }\\n\n\\n\n        h3 {\\n\n            font-size: 12px;\\n\n        }\\n\n\\n\n        .approval-gate {\\n\n            display: grid;\\n\n            grid-template-columns: 1fr 1fr;\\n\n            gap: 0.08in;\\n\n            padding: 0.07in 0;\\n\n            border-bottom: 1px solid #e2e8f0;\\n\n        }\\n\n\\n\n        .box {\\n\n            border: 1px solid #e2e8f0;\\n\n            padding: 0.055in 0.065in;\\n\n        }\\n\n\\n\n        .box h3 {\\n\n            line-height: 1.25;\\n\n        }\\n\n\\n\n        .section {\\n\n            margin-top: 0.1in;\\n\n        }\\n\n\\n\n        .intake {\\n\n            padding: 0.075in 0.1in;\\n\n            border-left: 4px solid #475569;\\n\n            background: #f8fafc;\\n\n        }\\n\n\\n\n        .concern-header-intent {\\n\n            color: inherit;\\n\n        }\\n\n\\n\n        .concern-header-intent-sep {\\n\n            margin: 0 0.03in;\\n\n            color: #cbd5e1;\\n\n            font-weight: 500;\\n\n        }\\n\n\\n\n        .concern-header-decision {\\n\n            display: inline-flex;\\n\n            align-items: center;\\n\n            gap: 0.03in;\\n\n            color: #334155;\\n\n            font-size: 10px;\\n\n            font-weight: 800;\\n\n            letter-spacing: 0.02em;\\n\n            -webkit-print-color-adjust: exact;\\n\n            print-color-adjust: exact;\\n\n        }\\n\n\\n\n        .concern-header-decision-mark {\\n\n            font-size: 10px;\\n\n            font-weight: 900;\\n\n            line-height: 1;\\n\n        }\\n\n\\n\n        .concern-header-decision--approved {\\n\n            color: #166534;\\n\n        }\\n\n\\n\n        .concern-header-decision--approved .concern-header-decision-mark {\\n\n            color: #15803d;\\n\n        }\\n\n\\n\n        .concern-header-decision--deferred {\\n\n            color: #b45309;\\n\n        }\\n\n\\n\n        .concern-header-decision--deferred .concern-header-decision-mark {\\n\n            color: #d97706;\\n\n        }\\n\n\\n\n        .concern-header-decision--declined {\\n\n            color: #b91c1c;\\n\n        }\\n\n\\n\n        .concern-header-decision--declined .concern-header-decision-mark {\\n\n            color: #dc2626;\\n\n        }\\n\n\\n\n        .concern-header-decision--recommended {\\n\n            color: #1e40af;\\n\n        }\\n\n\\n\n        .line-item {\\n\n            display: grid;\\n\n            grid-template-columns: 0.44in minmax(0, 1fr) 0.35in 0.52in 0.52in 0.46in 0.46in 0.62in;\\n\n            gap: 0.05in;\\n\n            padding: 0.05in 0.1in 0.05in 0.12in;\\n\n            border-bottom: 1px solid #f1f5f9;\\n\n            break-inside: avoid;\\n\n            page-break-inside: avoid;\\n\n        }\\n\n\\n\n        .line-item--note {\\n\n            display: block;\\n\n            width: 100%;\\n\n            grid-template-columns: none;\\n\n        }\\n\n\\n\n        .line-item--note .line-desc-col--note {\\n\n            display: block;\\n\n            width: 100%;\\n\n            max-width: none;\\n\n            color: #334155;\\n\n            font-weight: 600;\\n\n        }\\n\n\\n\n        .line-note-label {\\n\n            color: #64748b;\\n\n            font-size: 9px;\\n\n            font-weight: 800;\\n\n            letter-spacing: 0.04em;\\n\n            line-height: 1.35;\\n\n            text-transform: uppercase;\\n\n            margin-bottom: 0.02in;\\n\n        }\\n\n\\n\n        .line-type-col {\\n\n            color: #64748b;\\n\n            font-size: 9px;\\n\n            font-weight: 800;\\n\n            letter-spacing: 0.04em;\\n\n            line-height: 1.35;\\n\n            text-transform: uppercase;\\n\n            white-space: nowrap;\\n\n        }\\n\n\\n\n        .line-desc-col {\\n\n            min-width: 0;\\n\n            color: #0f172a;\\n\n            font-weight: 750;\\n\n            line-height: 1.35;\\n\n            overflow-wrap: normal;\\n\n            word-break: normal;\\n\n        }\\n\n\\n\n        .line-desc-col--note {\\n\n            color: #334155;\\n\n            font-weight: 600;\\n\n        }\\n\n\\n\n        .line-desc-primary {\\n\n            display: block;\\n\n        }\\n\n\\n\n        .line-desc-procurement {\\n\n            display: block;\\n\n            margin-top: 0.02in;\\n\n            color: #64748b;\\n\n            font-size: 9px;\\n\n            font-weight: 600;\\n\n            line-height: 1.3;\\n\n        }\\n\n\\n\n        .line-desc-procurement-sep {\\n\n            margin: 0 0.03in;\\n\n            color: #cbd5e1;\\n\n        }\\n\n\\n\n        /* Repair is a section label inside the concern - never a nested panel. */\\n\n        .repair-action-group {\\n\n            margin-top: 0.07in;\\n\n            border: none;\\n\n            border-top: 1px solid #e2e8f0;\\n\n            background: transparent;\\n\n        }\\n\n\\n\n        .repair-action-group + .repair-action-group {\\n\n            margin-top: 0.06in;\\n\n        }\\n\n\\n\n        .repair-action-group + .line-item,\\n\n        .line-item + .repair-action-group {\\n\n            margin-top: 0.04in;\\n\n        }\\n\n\\n\n        .repair-action-header {\\n\n            padding: 0.06in 0.1in 0.03in 0.12in;\\n\n            background: transparent;\\n\n            border: none;\\n\n        }\\n\n\\n\n        /* What we're selling - same visual weight family as the finding, not washed-out chrome. */\\n\n        .repair-action-title {\\n\n            margin: 0;\\n\n            color: #0f172a;\\n\n            font-size: 11.5px;\\n\n            font-weight: 800;\\n\n            letter-spacing: -0.01em;\\n\n            line-height: 1.25;\\n\n            text-transform: none;\\n\n        }\\n\n\\n\n        .repair-action-lines .line-item {\\n\n            padding-left: 0.12in;\\n\n            background: transparent;\\n\n            border-bottom-color: #f1f5f9;\\n\n        }\\n\n\\n\n        .repair-action-lines .line-item:last-child {\\n\n            border-bottom: none;\\n\n        }\\n\n\\n\n        .line-item--grouped .line-desc-col--grouped {\\n\n            grid-column: 1 / 3;\\n\n        }\\n\n\\n\n        .line-desc-row {\\n\n            display: inline-flex;\\n\n            align-items: center;\\n\n            gap: 0.06in;\\n\n            min-width: 0;\\n\n        }\\n\n\\n\n        /* Quiet type labels - not bordered pills inside the concern frame. */\\n\n        .line-type-badge {\\n\n            display: inline-flex;\\n\n            flex-shrink: 0;\\n\n            align-items: center;\\n\n            padding: 0;\\n\n            border: none;\\n\n            border-radius: 0;\\n\n            background: transparent;\\n\n            font-size: 8.5px;\\n\n            font-weight: 800;\\n\n            letter-spacing: 0.04em;\\n\n            line-height: 1.2;\\n\n            white-space: nowrap;\\n\n            text-transform: uppercase;\\n\n        }\\n\n\\n\n        .line-type-badge--labor {\\n\n            color: #065f46;\\n\n            background: transparent;\\n\n            border: none;\\n\n        }\\n\n\\n\n        .line-type-badge--part {\\n\n            color: #075985;\\n\n            background: transparent;\\n\n            border: none;\\n\n        }\\n\n\\n\n        .line-desc-detail {\\n\n            color: #334155;\\n\n            font-size: 10px;\\n\n            font-weight: 650;\\n\n            line-height: 1.35;\\n\n        }\\n\n\\n\n        .line-desc-includes {\\n\n            margin: 4px 0 0;\\n\n            padding-left: 14px;\\n\n            color: #64748b;\\n\n            font-size: 9px;\\n\n            line-height: 1.45;\\n\n        }\\n\n\\n\n        .line-col {\\n\n            color: #0f172a;\\n\n            font-weight: 700;\\n\n            text-align: right;\\n\n            white-space: nowrap;\\n\n        }\\n\n\\n\n        .line-col--muted {\\n\n            color: #64748b;\\n\n            font-weight: 600;\\n\n        }\\n\n\\n\n        .line-col--total {\\n\n            font-size: 11px;\\n\n            font-weight: 800;\\n\n        }\\n\n\\n\n        .line-head {\\n\n            display: grid;\\n\n            grid-template-columns: 0.44in minmax(0, 1fr) 0.35in 0.52in 0.52in 0.46in 0.46in 0.62in;\\n\n            gap: 0.05in;\\n\n            padding: 0.05in 0.1in 0.045in 0.12in;\\n\n            background: transparent;\\n\n            border-bottom: 1px solid #e2e8f0;\\n\n            color: #64748b;\\n\n            font-size: 8px;\\n\n            font-weight: 700;\\n\n            letter-spacing: 0.06em;\\n\n            text-transform: uppercase;\\n\n            align-items: end;\\n\n        }\\n\n\\n\n        .line-head-work {\\n\n            grid-column: 1 / 3;\\n\n            color: #0f172a;\\n\n            font-size: 11.5px;\\n\n            font-weight: 800;\\n\n            letter-spacing: -0.01em;\\n\n            line-height: 1.25;\\n\n            text-transform: none;\\n\n        }\\n\n\\n\n        .line-head .line-head-work:empty {\\n\n            min-height: 0;\\n\n        }\\n\n\\n\n        /* When the first repair title owns the column-head row, don't double-stack chrome. */\\n\n        .repair-action-group > .line-head {\\n\n            margin: 0;\\n\n            border-top: none;\\n\n            background: transparent;\\n\n        }\\n\n\\n\n        .repair-action-group:first-child {\\n\n            border-top: none;\\n\n            margin-top: 0;\\n\n        }\\n\n\\n\n        table {\\n\n            width: 100%;\\n\n            border-collapse: collapse;\\n\n            margin-top: 0.08in;\\n\n        }\\n\n\\n\n        th {\\n\n            padding: 0.045in 0.06in;\\n\n            border-top: 1px solid #e2e8f0;\\n\n            border-bottom: 1px solid #e2e8f0;\\n\n            color: #64748b;\\n\n            font-size: 9px;\\n\n            letter-spacing: 0.06em;\\n\n            text-align: left;\\n\n            text-transform: uppercase;\\n\n        }\\n\n\\n\n        td {\\n\n            padding: 0.055in 0.06in;\\n\n            border-bottom: 1px solid #f1f5f9;\\n\n            vertical-align: top;\\n\n        }\\n\n\\n\n        .line-note {\\n\n            color: #334155;\\n\n            font-style: italic;\\n\n        }\\n\n\\n\n        .concern-subtotal {\\n\n            padding: 0.075in 0.11in;\\n\n            text-align: right;\\n\n            color: #334155;\\n\n            font-weight: 700;\\n\n        }\\n\n\\n\n        .additional-charges {\\n\n            margin-top: 0.16in;\\n\n            border-top: 1px solid #cbd5e1;\\n\n            border-bottom: 1px solid #e2e8f0;\\n\n            padding: 0.08in 0 0.04in;\\n\n        }\\n\n\\n\n        .additional-charges-header {\\n\n            display: flex;\\n\n            justify-content: space-between;\\n\n            gap: 0.15in;\\n\n            color: #475569;\\n\n        }\\n\n\\n\n        .additional-charges-title {\\n\n            color: #334155;\\n\n            font-size: 10px;\\n\n            font-weight: 800;\\n\n            letter-spacing: 0.06em;\\n\n            text-transform: uppercase;\\n\n        }\\n\n\\n\n        .additional-charges table {\\n\n            margin-top: 0.04in;\\n\n        }\\n\n\\n\n        .additional-charges th {\\n\n            padding: 0.04in 0.06in;\\n\n            border-top: 1px solid #f1f5f9;\\n\n            border-bottom: 1px solid #f1f5f9;\\n\n        }\\n\n\\n\n        .additional-charges td {\\n\n            padding: 0.045in 0.06in;\\n\n        }\\n\n\\n\n        .document-footer {\\n\n            margin-top: 0.1in;\\n\n            padding-top: 0.06in;\\n\n            border-top: 1px solid #94a3b8;\\n\n            break-inside: auto;\\n\n            page-break-inside: auto;\\n\n        }\\n\n\\n\n        .footer-notes {\\n\n            margin-bottom: 0.08in;\\n\n            padding-bottom: 0.06in;\\n\n            border-bottom: 1px solid #e2e8f0;\\n\n        }\\n\n\\n\n        .footer-notes--in-summary {\\n\n            margin: 0.1in 0 0;\\n\n            padding: 0.08in 0 0;\\n\n            border-top: 1px solid #cbd5e1;\\n\n            border-bottom: 0;\\n\n        }\\n\n\\n\n        .footer-eyebrow {\\n\n            margin: 0;\\n\n            color: #64748b;\\n\n            font-size: 8px;\\n\n            font-weight: 700;\\n\n            letter-spacing: 0.08em;\\n\n            text-transform: uppercase;\\n\n        }\\n\n\\n\n        .footer-eyebrow--terms {\\n\n            margin-top: 0.05in;\\n\n        }\\n\n\\n\n        .footer-bullets-compact {\\n\n            margin: 0.02in 0 0;\\n\n            padding-left: 0.11in;\\n\n            color: #475569;\\n\n            font-size: 7.5px;\\n\n            line-height: 1.22;\\n\n            columns: 2;\\n\n            column-gap: 0.1in;\\n\n        }\\n\n\\n\n        .footer-bullets-compact--pdf {\\n\n            columns: 1;\\n\n            font-size: 7.5px;\\n\n            line-height: 1.35;\\n\n            color: #475569;\\n\n        }\\n\n\\n\n        .footer-bullets-compact--single {\\n\n            columns: 1;\\n\n        }\\n\n\\n\n        .footer-bullets-compact li {\\n\n            margin-bottom: 0.0