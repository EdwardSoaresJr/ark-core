                    <span class=\"text-secondary fw-normal\">10\u201317 \u00b7 VIS</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">M</span>\\n\n                                        <span class=\"small text-secondary\">Mike</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">H</span>\\n\n                                        <span class=\"small text-secondary\">Hotel</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">1</span>\\n\n                                        <span class=\"small text-secondary\">One</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">2</span>\\n\n                                        <span class=\"small text-secondary\">Two</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">3</span>\\n\n                                        <span class=\"small text-secondary\">Three</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">4</span>\\n\n                                        <span class=\"small text-secondary\">Four</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">5</span>\\n\n                                        <span class=\"small text-secondary\">Five</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">6</span>\\n\n                                        <span class=\"small text-secondary\">Six</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                    </div>\\n\n            </div>\\n\n        </template>\\n\n    </span>\\n\n                                                                                </div>\\n\n\\n\n                                                    <a\\n\n                                href=\"http://localhost/app/repair-orders/1\"\\n\n                                class=\"d-block mt-2 p-2 rounded border border-orange bg-orange-lt text-reset small\"\\n\n                            >\\n\n                                <span class=\"fw-bold text-orange\">Active RO #1</span>\\n\n                                <span class=\"d-block text-truncate fw-medium\">Customer states vehicle needs service.</span>\\n\n                                <span class=\"d-block text-secondary\">Nov 24, 9:27 AM</span>\\n\n                            </a>\\n\n                        \\n\n                        \\n\n                        \\n\n                                                    <div class=\"btn-list mt-2\">\\n\n                                                                    <a href=\"http://localhost/app/repair-orders/1\" class=\"btn btn-sm\">\\n\n                                        RO #1 \u00b7 In Progress\\n\n                                    </a>\\n\n                                                            </div>\\n\n                        \\n\n                                                    <form\\n\n                                id=\"vehicle-ro-create-1\"\\n\n                                x-show=\"activeRoVehicleId === 1\"\\n\n                                x-cloak\\n\n                                method=\"POST\"\\n\n                                action=\"http://localhost/app/customers/1/repair-orders/drafts\"\\n\n                                class=\"mt-3 pt-3 border-top\"\\n\n                            >\\n\n                                <input type=\"hidden\" name=\"_token\" value=\"ftEIYziWv8VR2oGfDtVpNy7oJYPq7RgVTLwnePEG\" autocomplete=\"off\">                                <input type=\"hidden\" name=\"vehicle_id\" value=\"1\">\\n\n                                <label for=\"vehicle-ro-reason-1\" class=\"form-label\">Reason for visit</label>\\n\n                                <textarea\\n\n                                    id=\"vehicle-ro-reason-1\"\\n\n                                    name=\"visit_reason\"\\n\n                                    required\\n\n                                    rows=\"2\"\\n\n                                    placeholder=\"Why 2021 Honda Civic is here\"\\n\n                                    class=\"form-control\"\\n\n                                ></textarea>\\n\n                                <div class=\"btn-list justify-content-end mt-2\">\\n\n                                    <button type=\"button\" class=\"btn\" x-on:click=\"activeRoVehicleId = null\">Cancel</button>\\n\n                                    <button type=\"submit\" class=\"btn btn-primary\">Create Estimate / RO</button>\\n\n                                </div>\\n\n                            </form>\\n\n                                            </div>\\n\n\\n\n                    <div class=\"card-footer\">\\n\n                        <div class=\"btn-list\" aria-label=\"Vehicle commands\">\\n\n                                                                                        <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    x-on:click=\"activeRoVehicleId = activeRoVehicleId === 1 ? null : 1\"\\n\n                                    :aria-expanded=\"(activeRoVehicleId === 1).toString()\"\\n\n                                    aria-controls=\"vehicle-ro-create-1\"\\n\n                                >\\n\n                                    Start RO\\n\n                                </button>\\n\n                            \\n\n                                                            <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn\"\\n\n                                    title=\"Open to edit vehicle\"\\n\n                                    x-on:click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'hub-vehicle', context: { vehicleId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                                >\\n\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4\"/><path d=\"M13.5 6.5l4 4\"/></svg>\\n\n                                    Edit Vehicle\\n\n                                </button>\\n\n                                                                                    </div>\\n\n\\n\n                                                                                                </div>\\n\n                </section>\\n\n                    </div>\\n\n    </div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'comms'\" x-cloak>\\n\n                            <div\\n\n    id=\"customer-communication\"\\n\n    x-data=\"arkCustomerHubComms(JSON.parse('{\\u0022initialFilter\\u0022:\\u0022all\\u0022,\\u0022counts\\u0022:{\\u0022all\\u0022:2,\\u0022call\\u0022:1,\\u0022text\\u0022:1,\\u0022email\\u0022:0,\\u0022portal\\u0022:0,\\u0022logged\\u0022:0},\\u0022customerId\\u0022:1,\\u0022updatesUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/hub-comms\\\\\\/updates\\u0022,\\u0022messagesListId\\u0022:\\u0022conversation-messages-relationship\\u0022}'))\"\\n\n    x-init=\"init()\"\\n\n>\\n\n    <div class=\"card-body border-bottom py-2\">\\n\n        <h3 class=\"card-title mb-0\">Communications</h3>\\n\n        <div class=\"text-secondary small\">One timeline for calls, text, and email - filter by type when you need to focus.</div>\\n\n        <div class=\"btn-list mt-2\" role=\"group\" aria-label=\"Communication type filters\">\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('all') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('all').toString()\"\\n\n                    x-on:click=\"setFilter('all')\"\\n\n                >All \u00b7 2</button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('call') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('call').toString()\"\\n\n                    x-on:click=\"setFilter('call')\"\\n\n                >Calls \u00b7 1</button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('text') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('text').toString()\"\\n\n                    x-on:click=\"setFilter('text')\"\\n\n                >Text \u00b7 1</button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('email') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('email').toString()\"\\n\n                    x-on:click=\"setFilter('email')\"\\n\n                >Email \u00b7 0</button>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n    <div\\n\n                                data-ark-workspace-dirty=\"off\"\\n\n                data-ark-conversation-composer\\n\n                                x-data=\"arkConversationQuickReply(JSON.parse('{\\u0022sendUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-messages\\u0022,\\u0022repairOrderId\\u0022:null,\\u0022sendEstimateUrl\\u0022:null,\\u0022cancelScheduledEstimateUrl\\u0022:null,\\u0022cancelScheduledSmsUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-actions\\\\\\/c