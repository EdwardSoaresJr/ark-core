                          <button type=\"submit\" class=\"dropdown-item\">\\n\n                                    Test as technician\\n\n                                </button>\\n\n                            </form>\\n\n                                                                                            <div class=\"dropdown-divider\"></div>\\n\n\\n\n                        <form method=\"POST\" action=\"http://localhost/app/logout\">\\n\n                            <input type=\"hidden\" name=\"_token\" value=\"q4yNpXOorrBOCt4vVFL5uADVoJBRKiyziuSgGtdr\" autocomplete=\"off\">                            <button type=\"submit\" class=\"dropdown-item text-danger\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2\"/><path d=\"M9 12h12l-3 -3\"/><path d=\"M18 15l3 -3\"/></svg>\\n\n                                Sign out\\n\n                            </button>\\n\n                        </form>\\n\n                                            </div>\\n\n    </div>\\n\n                </div>\\n\n            </div>\\n\n        </header>\\n\n\\n\n        <div\\n\n            id=\"ops-workspace-tabs\"\\n\n            class=\"ark-workspace-tabs d-none d-print-none border-bottom bg-surface\"\\n\n            data-workspace-tabs\\n\n            data-workspace-tabs-ui=\"tabler\"\\n\n            data-ark-workspace-dirty=\"off\"\\n\n            aria-label=\"Workspaces\"\\n\n            aria-hidden=\"true\"\\n\n        ></div>\\n\n    \\n\n    <script>\\n\n        window.__ARK_WORKSPACE__ = {\"enabled\":true,\"maxTabs\":12,\"tabMinWidth\":176,\"desktopMinWidth\":1024,\"persistLocal\":true,\"interceptLinks\":true,\"storageKey\":\"ark_ws_v2_1\",\"types\":[\"intake\",\"repair_order\",\"customer\",\"vehicle\",\"inbox\",\"report\"],\"dashboardUrl\":\"http:\\/\\/localhost\\/app\",\"pathPatterns\":[{\"type\":\"intake\",\"pattern\":\"#^app\\/intake\\/new$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/edit$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/estimate-review$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"customer\",\"pattern\":\"#^app\\/customers\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"inbox\",\"pattern\":\"#^app\\/inbox\\/(\\\\d+)$#\",\"id_group\":1}],\"permanentPinned\":[],\"dockedContextual\":[{\"key\":\"intake:service\",\"entityType\":\"intake\",\"entityId\":\"service\",\"route\":\"\\/app\\/intake\\/new\",\"title\":\"Check In\",\"subtitle\":\"\"}],\"excludedWorkspaceKeys\":[\"report:operations\"],\"activityUrl\":\"http:\\/\\/localhost\\/app\\/workspace\\/activity\",\"resetIntake\":false,\"closeIntakeWorkspaceId\":null,\"boot\":null};\\n\n    </script>\\n\n\\n\n                            \\n\n        \\n\n        <main>\\n\n            <div class=\"page-body\">\\n\n    <div class=\"container-narrow\">\\n\n        <p class=\"text-secondary d-md-none\">Name the places where work happens. Phone device provisioning belongs to ARK Shop.</p>\\n\n\\n\n        \\n\n        \\n\n        \\n\n        <div class=\"d-flex flex-column gap-3\">\\n\n                            <div class=\"alert alert-secondary\" role=\"status\">\\n\n                    Physical workstations stay in Core. Hosted phone devices, SIP provisioning, and call routing belong to ARK Shop.\\n\n                </div>\\n\n                <section class=\"card\" aria-labelledby=\"shop-comms-stations\" data-shop-comms-stations>\\n\n    <div class=\"card-header\">\\n\n        <h2 class=\"card-title\" id=\"shop-comms-stations\">Stations</h2>\\n\n    </div>\\n\n\\n\n    \\n\n    <div class=\"list-group list-group-flush\">\\n\n                                                <a href=\"http://localhost/app/shop/devices/1\" class=\"list-group-item list-group-item-action\">\\n\n                            <div class=\"d-flex align-items-center gap-3\">\\n\n                    <div class=\"flex-fill overflow-hidden\">\\n\n                        <div class=\"fw-bold text-truncate\">Front Counter</div>\\n\n                        <div class=\"small text-secondary text-truncate\">Front Counter \u00b7 VVX450</div>\\n\n                    </div>\\n\n                    <span class=\"flex-shrink-0 small fw-bold text-uppercase text-success\">\\n\n                        Ready\\n\n                    </span>\\n\n                </div>\\n\n                            </a>\\n\n                        </div>\\n\n\\n\n            <details class=\"border-top\">\\n\n            <summary class=\"card-body py-2 fw-medium\">Add a station</summary>\\n\n            <form method=\"POST\" action=\"http://localhost/app/shop/workstations\" class=\"card-body pt-0\">\\n\n                <input type=\"hidden\" name=\"_token\" value=\"q4yNpXOorrBOCt4vVFL5uADVoJBRKiyziuSgGtdr\" autocomplete=\"off\">                <div class=\"row g-2\">\\n\n                    <div class=\"col-12 col-sm-6\">\\n\n                        <label class=\"visually-hidden\" for=\"shop-add-station-name\">Station name</label>\\n\n                        <input\\n\n                            id=\"shop-add-station-name\"\\n\n                            type=\"text\"\\n\n                            name=\"name\"\\n\n                            value=\"\"\\n\n                            required\\n\n                            placeholder=\"Front Counter\"\\n\n                            class=\"form-control\"\\n\n                        >\\n\n                                            </div>\\n\n                    <div class=\"col-12 col-sm-6\">\\n\n                        <label class=\"visually-hidden\" for=\"shop-add-station-location\">Location</label>\\n\n                        <input id=\"shop-add-station-location\" type=\"text\" name=\"location_label\" value=\"\" placeholder=\"Location (optional)\" class=\"form-control\">\\n\n                    </div>\\n\n                </div>\\n\n                <button type=\"submit\" class=\"btn btn-sm mt-2\">Add station</button>\\n\n            </form>\\n\n        </details>\\n\n    </section>\\n\n\\n\n    <details class=\"card\" data-shop-comms-station-names>\\n\n        <summary class=\"card-header\">\\n\n            <span class=\"card-title\">Manage station names</span>\\n\n        </summary>\\n\n        <div class=\"list-group list-group-flush\">\\n\n                            <details class=\"list-group-item\" >\\n\n                    <summary class=\"fw-medium\">\\n\n                        Front Counter\\n\n                    </summary>\\n\n                    <form\\n\n                        method=\"POST\"\\n\n                        action=\"http://localhost/app/shop/workstations/1\"\\n\n                        class=\"mt-2\"\\n\n                    >\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"q4yNpXOorrBOCt4vVFL5uADVoJBRKiyziuSgGtdr\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                        <input type=\"hidden\" name=\"edit_workstation_id\" value=\"1\">\\n\n                        <div class=\"mb-2\">\\n\n                            <label class=\"form-label\" for=\"shop-station-1-name\">Name</label>\\n\n                            <input\\n\n                                id=\"shop-station-1-name\"\\n\n                                type=\"text\"\\n\n                                name=\"name\"\\n\n                                value=\"Front Counter\"\\n\n                                required\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"mb-2\">\\n\n                            <label class=\"form-label\" for=\"shop-station-1-location\">Location <span class=\"text-secondary fw-normal\">(optional)</span></label>\\n\n                            <input\\n\n                                id=\"shop-station-1-location\"\\n\n                                type=\"text\"\\n\n                                name=\"location_label\"\\n\n                                value=\"\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <button type=\"submit\" class=\"btn btn-primary btn-sm\">Save</button>\\n\n                    </form>\\n\n                </details>\\n\n                    </div>\\n\n    </details>\\n\n                    </div>\\n\n    </div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"q4yNpXOorrBOCt4vVFL5uADVoJBRKiyziuSgGtdr\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/ap