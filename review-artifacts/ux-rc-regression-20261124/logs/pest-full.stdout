ion>\\n\n                                                                                    <option value=\"Pacific/Fiji\" >Pacific/Fiji</option>\\n\n                                                                                    <option value=\"Pacific/Funafuti\" >Pacific/Funafuti</option>\\n\n                                                                                    <option value=\"Pacific/Galapagos\" >Pacific/Galapagos</option>\\n\n                                                                                    <option value=\"Pacific/Gambier\" >Pacific/Gambier</option>\\n\n                                                                                    <option value=\"Pacific/Guadalcanal\" >Pacific/Guadalcanal</option>\\n\n                                                                                    <option value=\"Pacific/Guam\" >Pacific/Guam</option>\\n\n                                                                                    <option value=\"Pacific/Honolulu\" >Pacific/Honolulu</option>\\n\n                                                                                    <option value=\"Pacific/Kanton\" >Pacific/Kanton</option>\\n\n                                                                                    <option value=\"Pacific/Kiritimati\" >Pacific/Kiritimati</option>\\n\n                                                                                    <option value=\"Pacific/Kosrae\" >Pacific/Kosrae</option>\\n\n                                                                                    <option value=\"Pacific/Kwajalein\" >Pacific/Kwajalein</option>\\n\n                                                                                    <option value=\"Pacific/Majuro\" >Pacific/Majuro</option>\\n\n                                                                                    <option value=\"Pacific/Marquesas\" >Pacific/Marquesas</option>\\n\n                                                                                    <option value=\"Pacific/Midway\" >Pacific/Midway</option>\\n\n                                                                                    <option value=\"Pacific/Nauru\" >Pacific/Nauru</option>\\n\n                                                                                    <option value=\"Pacific/Niue\" >Pacific/Niue</option>\\n\n                                                                                    <option value=\"Pacific/Norfolk\" >Pacific/Norfolk</option>\\n\n                                                                                    <option value=\"Pacific/Noumea\" >Pacific/Noumea</option>\\n\n                                                                                    <option value=\"Pacific/Pago_Pago\" >Pacific/Pago_Pago</option>\\n\n                                                                                    <option value=\"Pacific/Palau\" >Pacific/Palau</option>\\n\n                                                                                    <option value=\"Pacific/Pitcairn\" >Pacific/Pitcairn</option>\\n\n                                                                                    <option value=\"Pacific/Pohnpei\" >Pacific/Pohnpei</option>\\n\n                                                                                    <option value=\"Pacific/Port_Moresby\" >Pacific/Port_Moresby</option>\\n\n                                                                                    <option value=\"Pacific/Rarotonga\" >Pacific/Rarotonga</option>\\n\n                                                                                    <option value=\"Pacific/Saipan\" >Pacific/Saipan</option>\\n\n                                                                                    <option value=\"Pacific/Tahiti\" >Pacific/Tahiti</option>\\n\n                                                                                    <option value=\"Pacific/Tarawa\" >Pacific/Tarawa</option>\\n\n                                                                                    <option value=\"Pacific/Tongatapu\" >Pacific/Tongatapu</option>\\n\n                                                                                    <option value=\"Pacific/Wake\" >Pacific/Wake</option>\\n\n                                                                                    <option value=\"Pacific/Wallis\" >Pacific/Wallis</option>\\n\n                                                                                    <option value=\"UTC\" >UTC</option>\\n\n                                                                            </select>\\n\n                                                                        <div class=\"form-hint\">All operational timestamps are stored in UTC and displayed in this timezone.</div>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-phone\" class=\"form-label\">Phone</label>\\n\n                                    <input id=\"settings-phone\" name=\"phone\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-email\" class=\"form-label\">Email</label>\\n\n                                    <input id=\"settings-email\" name=\"email\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-website\" class=\"form-label\">Website</label>\\n\n                                    <input id=\"settings-website\" name=\"website\" value=\"\" placeholder=\"https://example.com\" class=\"form-control\">\\n\n                                                                    </div>\\n\n                                <div class=\"col-12\">\\n\n                                    <label for=\"settings-address-1\" class=\"form-label\">Address line 1</label>\\n\n                                    <input id=\"settings-address-1\" name=\"address_line_1\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-12\">\\n\n                                    <label for=\"settings-address-2\" class=\"form-label\">Address line 2</label>\\n\n                                    <input id=\"settings-address-2\" name=\"address_line_2\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-city\" class=\"form-label\">City</label>\\n\n                                    <input id=\"settings-city\" name=\"city\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label for=\"settings-state\" class=\"form-label\">State</label>\\n\n                                    <input id=\"settings-state\" name=\"state\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-6 col-md-3\">\\n\n                                    <label for=\"settings-postal-code\" class=\"form-label\">Postal code</label>\\n\n                                    <input id=\"settings-postal-code\" name=\"postal_code\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                                                <div class=\"col-12\" data-document-typography-settings x-data=\"{ preset: 'standard', scales: JSON.parse('{\\u0022compact\\u0022:0.9,\\u0022standard\\u0022:1,\\u0022large\\u0022:1.15}') }\">\\n\n                                    <div class=\"border rounded p-3\">\\n\n                                        <div class=\"fw-medium\">Document print size</div>\\n\n                                        <div class=\"text-secondary small mb-2\">Type size on estimate and invoice documents (screen print and PDF). It does not change the app. Documents already issued keep the size they were created with.</div>\\n\n                                        <div class=\"row g-3\">\\n\n                                            <div class=\"col-12 col-md-4\">\\n\n                                                                                                    <label class=\"form-check mb-2\">\\n\n                                                        <input type=\"radio\" name=\"document_typography\" value=\"compact\" x-model=\"preset\" class=\"form-check-input\" >\\n\n                                                        <span class=\"form-check-label fw-medium\">Compact</span>\\n\n                                                        <span class=\"d-block text-secondary small\">Smaller type; fits more on each page.</span>\\n\n                                                    </label>\\n\n                                                                                                    <label class=\"form-check mb-2\">\\n\n                                                        <input type=\"radio\" name=\"document_typography\" value=\"standard\" x-model=\"preset\" class=\"form-check-input\" checked>\\n\n                                                        <span class=\"form-check-label fw-medium\">Standard</span>\\n\n                                                        <span class=\"d-block text-secondary small\">The default document appearance.</span>\\n\n                                                    </label>\\n\n                                                                                                    <label class=\"form-check mb-2\">\\n\n                                                        <input type=\"radio\" name=\"document_typography\" value=\"large\" x-model=\"preset\" class=\"form-check-input\" >\\n\n                                                        <span class=\"form-check-label fw-medium\">Large</span>\\n\n                                                        <span class=\"d-block text-secondary small\">Larger, easier-to-read type; may use more pages.</span>\\n\n                                                    </label>\\n\n                                                                                                                                            </div>\\n\n                                            <div class=\"col-12 col-md-8\">\\n\n                                                <div class=\"text-secondary small mb-1\">Preview (updates before saving)</div>\\n\n                                                <div class=\"border rounded bg-white p-2 text-dark overflow-hidden\" data-document-typography-preview>\\n\n                                                    <div :style=\"'zoom: ' + scales[preset]\" style=\"font-size: 11px; line-height: 1.45\">\\n\n                                                        <div class=\"fw-bold\" style=\"font-size: 18px; overflow-wrap: anywhere\">ARK</div>\\n\n                                                        <div class=\"text-secondary\" style=\"font-size: 9px\">RO #1001 Estimate</div>\\n\n                                                        <hr class=\"my-1\">\\n\n                                                        <div class=\"d-flex justify-content-between gap-2\"><span style=\"font-weight: 650\">Front brake pads and rotors, replace (includes hardware)</span><span class=\"fw-bold\">$412.00</span></div>\\n\n                                                        <div class=\"d-flex justify-content-between gap-2\"><span>Shop supplies</span><span>$18.00</span></div>\\n\n                                                        <div class=\"d-flex justify-content-between gap-2\"><span>Tax</span><span>$34.40</span></div>\\n\n                                                        <div class=\"d-flex justify-content-between gap-2 fw-bold\" style=\"font-size: 12px\"><span>Total</span><span>$464.40</span></div>\\n\n                                                        <div class=\"text-secondary mt-1\" style=\"font-size: 7.5px\">Estimate only. Prices may change if additional work is found.</div>\\n\n                                                    </div>\\n\n                                                </div>\\n\n                                            </div>\\n\n                                        </div>\\n\n                                    </div>\\n\n                                </div>\\n\n                            </div>\\n\n                        </div>\\n\n                        <div class=\"card-footer text-end\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary\">Save Shop Identity</button>\\n\n                        </div>\\n\n                    </form>\\n\n                </section>\\n\n                <section class=\"card\" x-show=\"active === 'estimates'\" x-cloak data-settings-section=\"estimates\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Documents / Disclaimers</div>\\n\n                            <h2 class=\"card-title\">Customer-facing document language</h2>\\n\n                            <div class=\"card-subtitle\">Global and customer-tag disclaimers copy into snapshots at generation. Invoices keep the language issued at that time.</div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <form method=\"POST\" action=\"http://localhost/app/settings/shop/estimates\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                        <div class=\"card-body\">\\n\n                            <div class=\"row g-3 mb-3\">\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <div class=\"subheader\">Global disclaimers</div>\\n\n                                    <div class=\"text-secondary small\">Always applied after totals on every estimate and invoice.</div>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <div class=\"subheader\">Billing class disclaimers</div>\\n\n                                    <div class=\"text-secondary small\">Applied automatically from the customer&apos;s classification.</div>\\n\n                                </div>\\n\n                            </div>\\n\n\\n\n                            <div class=\"mb-3\">\\n\n                                <label for=\"settings-estimate-disclaimer\" class=\"form-label\">Global estimate disclaimer</label>\\n\n                                <textarea id=\"settings-estimate-disclaimer\" name=\"estimate_disclaimer\" rows=\"5\" class=\"form-control\">Diagnostic findings are based on conditions observed at the time of inspection. Additional repairs may be required if further issues are discovered during disassembly. Parts and labor are covered by the shop warranty unless otherwise noted. Customer-supplied and used parts may carry no warranty. Pricing is valid for a limited time and may change due to supplier availability. Vehicle may require road testing before and after repairs.</textarea>\\n\n                            </div>\\n\n                            <div class=\"mb-3\">\\n\n                                <label for=\"settings-invoice-disclaimer\" class=\"form-label\">Global invoice disclaimer</label>\\n\n                                <textarea id=\"settings-invoice-disclaimer\" name=\"invoice_disclaimer\" rows=\"5\" class=\"form-control\">Diagnostic findings are based on conditions observed at the time of inspection. Additional repairs may be required if further issues are discovered during disassembly. Parts and labor are covered by the shop warranty unless otherwise noted. Customer-supplied and used parts may carry no warranty. Vehicle may require road testing before and after repairs.</textarea>\\n\n                            </div>\\n\n\\n\n                            <div class=\"hr-text\">Billing class disclaimers</div>\\n\n                            <p class=\"text-secondary small\">One disclaimer per configured billing class. Advisors do not pick these manually.</p>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-0\" class=\"form-label\">Retail</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-0\" name=\"customer_type_disclaimers[retail]\" rows=\"3\" class=\"form-control\">This estimate reflects repairs recommended based on our inspection. Additional concerns may exist that were not apparent during initial evaluation.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-1\" class=\"form-label\">Fleet</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-1\" name=\"customer_type_disclaimers[fleet]\" rows=\"3\" class=\"form-control\">Repairs will not begin until authorization is received from the fleet management company. Additional repairs requiring authorization may affect completion time.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-2\" class=\"form-label\">Warranty</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-2\" name=\"customer_type_disclaimers[warranty]\" rows=\"3\" class=\"form-control\">Estimate subject to third-party warranty authorization. Customer remains responsible for any non-covered charges.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-3\" class=\"form-label\">RepairPal</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-3\" name=\"customer_type_disclaimers[repairpal]\" rows=\"3\" class=\"form-control\">RepairPal program estimate. Customer remains responsible for any non-covered charges.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-4\" class=\"form-label\">Internal</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-4\" name=\"customer_type_disclaimers[internal]\" rows=\"3\" class=\"form-control\">Internal repair order. Customer authorization not required.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-5\" class=\"form-label\">Wholesale</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-5\" name=\"customer_type_disclaimers[wholesale]\" rows=\"3\" class=\"form-control\">Pricing and warranty terms are governed by the wholesale agreement on file.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-6\" class=\"form-label\">Comeback</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-6\" name=\"customer_type_disclaimers[comeback]\" rows=\"3\" class=\"form-control\">Comeback repair order for shop warranty rework. Labor is not billed unless authorized separately.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-7\" class=\"form-label\">Business</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-7\" name=\"customer_type_disclaimers[business]\" rows=\"3\" class=\"form-control\">This estimate reflects repairs recommended based on our inspection. Additional concerns may exist that were not apparent during initial evaluation.</textarea>\\n\n                                </div>\\n\n                                                                                            <div class=\"mb-3\">\\n\n                                    <label for=\"settings-type-disclaimer-8\" class=\"form-label\">Military</label>\\n\n                                    <textarea id=\"settings-type-disclaimer-8\" name=\"customer_type_disclaimers[military]\" rows=\"3\" class=\"form-control\">This estimate reflects repairs recommended based on our inspection. Additional concerns may exist that were not apparent during initial evaluation.</textarea>\\n\n                                </div>\\n\n                            \\n\n                            <div class=\"hr-text\">Authorization</div>\\n\n                            <div class=\"mb-3\">\\n\n                                <label for=\"settings-authorization-language\" class=\"form-label\">Authorization language</label>\\n\n                                <textarea id=\"settings-authorization-language\" name=\"authorization_language\" rows=\"3\" class=\"form-control\">By approving this estimate, I authorize {shop_name} to perform the approved repairs and services described above.\\n\n\\n\nI acknowledge that additional repairs may require separate authorization and agree to pay for authorized work performed, including diagnostic charges where applicable.</textarea>\\n\n                            </div>\\n\n                            <label class=\"form-check\">\\n\n                                <input type=\"checkbox\" name=\"portal_signature_required\" value=\"1\"  class=\"form-check-input\">\\n\n                                <span class=\"form-check-label\">Require customer signature on portal authorization</span>\\n\n                                <span class=\"form-check-description\">When enabled, customers must sign and acknowledge authorization language before submitting portal approval.</span>\\n\n                            </label>\\n\n\\n\n                            <div class=\"hr-text\">Customer Part Presentation</div>\\n\n                            <p class=\"text-secondary small\">Controls how part names appear on estimates, invoices, portal, and print. Full catalog details stay internal for ordering.</p>\\n\n                            <div class=\"mb-2\" style=\"max-width: 28rem\">\\n\n                                <label for=\"settings-part-description-mode\" class=\"form-label\">Description mode</label>\\n\n                                <select id=\"settings-part-description-mode\" name=\"customer_part_description_mode\" class=\"form-select\">\\n\n                                                                            <option value=\"cleaned\" selected>Cleaned</option>\\n\n                                                                            <option value=\"verbatim\" >Verbatim</option>\\n\n                                                                            <option value=\"cleaned_with_brand\" >Cleaned + Brand</option>\\n\n                                                                            <option value=\"manual\" >Manual</option>\\n\n                                                                    </select>\\n\n                            </div>\\n\n                            <ul class=\"text-secondary small mb-3\">\\n\n                                                                    <li><span class=\"fw-medium\">Cleaned:</span> Shows a customer-friendly functional part name while keeping full catalog details internal.</li>\\n\n                                                                    <li><span class=\"fw-medium\">Verbatim:</span> Shows the imported or entered part description as-is.</li>\\n\n                                                                    <li><span class=\"fw-medium\">Cleaned + Brand:</span> Shows the cleaned part name with the manufacturer brand.</li>\\n\n                                                                    <li><span class=\"fw-medium\">Manual:</span> Uses only advisor-entered customer descriptions.</li>\\n\n                                                            </ul>\\n\n                                                            <label class=\"form-check\">\\n\n                                    <input type=\"hidden\" name=\"customer_part_show_manufacturer_number\" value=\"0\">\\n\n                                    <input type=\"checkbox\" name=\"customer_part_show_manufacturer_number\" value=\"1\"  class=\"form-check-input\">\\n\n                                    <span class=\"form-check-label\">Show manufacturer part number</span>\\n\n                                </label>\\n\n                                                            <label class=\"form-check\">\\n\n                                    <input type=\"hidden\" name=\"customer_part_show_supplier\" value=\"0\">\\n\n                                    <input type=\"checkbox\" name=\"customer_part_show_supplier\" value=\"1\"  class=\"form-check-input\">\\n\n                                    <span class=\"form-check-label\">Show supplier name</span>\\n\n                                </label>\\n\n                                                            <label class=\"form-check\">\\n\n                                    <input type=\"hidden\" name=\"customer_part_show_supplier_sku\" value=\"0\">\\n\n                                    <input type=\"checkbox\" name=\"customer_part_show_supplier_sku\" value=\"1\"  class=\"form-check-input\">\\n\n                                    <span class=\"form-check-label\">Show supplier SKU</span>\\n\n                                </label>\\n\n                                                            <label class=\"form-check\">\\n\n                                    <input type=\"hidden\" name=\"customer_part_allow_description_override\" value=\"0\">\\n\n                                    <input type=\"checkbox\" name=\"customer_part_allow_description_override\" value=\"1\" checked class=\"form-check-input\">\\n\n                                    <span class=\"form-check-label\">Allow advisor override on individual lines</span>\\n\n                                </label>\\n\n                                                        <p class=\"text-secondary small\">Billing-class document profiles (Warranty / RepairPal) can still add part number or supplier for audit when those programs need them.</p>\\n\n\\n\n                            <div class=\"hr-text\">Recommendations and validity</div>\\n\n                            <div class=\"mb-3\">\\n\n                                <label for=\"settings-recommendation-disclaimer\" class=\"form-label\">\\n\n                                    Recommendation disclaimer\\n\n                                    <span class=\"text-secondary fw-normal\">(concern narrative context, not mixed with authorization)</span>\\n\n                                </label>\\n\n                                <textarea id=\"settings-recommendation-disclaimer\" name=\"recommendation_disclaimer\" rows=\"3\" class=\"form-control\">Recommendations are based on verified findings and current operating conditions. Further testing or disassembly may change the recommended repair path.</textarea>\\n\n                            </div>\\n\n                            <div style=\"max-width: 12rem\">\\n\n                                <label for=\"settings-estimate-validity\" class=\"form-label\">Estimate validity days</label>\\n\n                                <input id=\"settings-estimate-validity\" name=\"estimate_validity_days\" value=\"30\" required inputmode=\"numeric\" class=\"form-control\">\\n\n                            </div>\\n\n                        </div>\\n\n                        <div class=\"card-footer text-end\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary\">Save Document Settings</button>\\n\n                        </div>\\n\n                    </form>\\n\n                </section>\\n\n                <section class=\"card\" x-show=\"active === 'workflow'\" x-cloak data-settings-section=\"workflow\">\\n\n                    <div class=\"card-header\">\\n\n                        <div>\\n\n                            <div class=\"subheader\">Workflow Defaults</div>\\n\n                            <h2 class=\"card-title\">Check In defaults and Job Board</h2>\\n\n                            <div class=\"card-subtitle\">Shop-wide Check In defaults, Job Board lanes, and the repair order statuses that fill those lanes.</div>\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"card-header\">\\n\n                        <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Workflow Defaults\">\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"workflow-tab-defaults\"\\n\n                                        aria-controls=\"workflow-panel-defaults\"\\n\n                                        :class=\"{ 'active': workflowTab === 'defaults' }\"\\n\n                                        :aria-selected=\"(workflowTab === 'defaults').toString()\"\\n\n                                        @click=\"setWorkflowTab('defaults')\"\\n\n                                    >Check In defaults</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"workflow-tab-statuses\"\\n\n                                        aria-controls=\"workflow-panel-statuses\"\\n\n                                        :class=\"{ 'active': workflowTab === 'statuses' }\"\\n\n                                        :aria-selected=\"(workflowTab === 'statuses').toString()\"\\n\n                                        @click=\"setWorkflowTab('statuses')\"\\n\n                                    >Job Board</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"workflow-tab-inspections\"\\n\n                                        aria-controls=\"workflow-panel-inspections\"\\n\n                                        :class=\"{ 'active': workflowTab === 'inspections' }\"\\n\n                                        :aria-selected=\"(workflowTab === 'inspections').toString()\"\\n\n                                        @click=\"setWorkflowTab('inspections')\"\\n\n                                    >Inspection checklists</button>\\n\n                                </li>\\n\n                                                            <li class=\"nav-item\" role=\"presentation\">\\n\n                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"nav-link\"\\n\n                                        role=\"tab\"\\n\n                                        id=\"workflow-tab-saved-work\"\\n\n                                        aria-controls=\"workflow-panel-saved-work\"\\n\n                                        :class=\"{ 'active': workflowTab === 'saved-work' }\"\\n\n                                        :aria-selected=\"(workflowTab === 'saved-work').toString()\"\\n\n                                        @click=\"setWorkflowTab('saved-work')\"\\n\n                                    >Common Jobs</button>\\n\n                                </li>\\n\n                                                    </ul>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"workflow-panel-defaults\" role=\"tabpanel\" aria-labelledby=\"workflow-tab-defaults\" x-show=\"workflowTab === 'defaults'\" x-cloak>\\n\n                        <h3 class=\"mb-1\">Check In defaults</h3>\\n\n                        <p class=\"text-secondary small\">Pre-select the visit type, priority, work type, and note visibility for new work.</p>\\n\n                        <form method=\"POST\" action=\"http://localhost/app/settings/shop/workflow\">\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n    <div class=\"hr-text mt-0\">Check In visit</div>\\n\n    <div class=\"row g-3\">\\n\n        <div class=\"col-12 col-md-6\">\\n\n            <label for=\"settings-default-visit-mode\" class=\"form-label\">Default visit type</label>\\n\n            <select id=\"settings-default-visit-mode\" name=\"default_visit_mode\" required class=\"form-select\">\\n\n                                    <option value=\"waiting_here\" >Waiting</option>\\n\n                                    <option value=\"drop_off\" selected>Drop Off</option>\\n\n                                    <option value=\"needs_shuttle\" >Shuttle</option>\\n\n                                    <option value=\"tow_incoming\" >Tow-In</option>\\n\n                                    <option value=\"on_site\" >On-site</option>\\n\n                            </select>\\n\n            <div class=\"form-hint\">Pre-selected when opening a repair order from Check In.</div>\\n\n        </div>\\n\n        <div class=\"col-12 col-md-6 small text-secondary\">\\n\n            <div class=\"fw-medium text-body\">Billing at Check In</div>\\n\n            <p class=\"mb-2\">Fleet and warranty billing follow the billing class. Advisors can override per visit at Check In.</p>\\n\n            <p class=\"mb-2\">Fees and parts matrices: <button type=\"button\" class=\"btn btn-link p-0 align-baseline small\" @click=\"setActive('financial'); setFinancialTab('labor')\">Financial Rules \u2192 Labor \u2192 Class Settings</button>.</p>\\n\n            <p class=\"mb-0\">Whether a key tag needs mileage in before it prints: <button type=\"button\" class=\"btn btn-link p-0 align-baseline small\" @click=\"setActive('printing'); setPrintingTab('printers')\">Label Printing \u2192 Printers &amp; labels</button>.</p>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"hr-text\">Scopes &amp; concerns</div>\\n\n    <div class=\"row g-3\">\\n\n        <div class=\"col-12 col-md-6\">\\n\n            <label for=\"default_recommendation_posture\" class=\"form-label\">Default priority</label>\\n\n            <select id=\"default_recommendation_posture\" name=\"default_recommendation_posture\" class=\"form-select\">\\n\n            <option value=\"\" selected>No priority</option>\\n\n                <option value=\"must_do\" >Must Do</option>\\n\n            <option value=\"should_do\" >Should Do</option>\\n\n            <option value=\"could_do\" >Could Do</option>\\n\n        <option value=\"information_only\" >Information Only</option>\\n\n</select>\\n\n            <div class=\"form-hint\">Customer-facing order and color for new scopes. Information Only clears priority.</div>\\n\n        </div>\\n\n        <div class=\"col-12 col-md-6\">\\n\n            <label for=\"default_recommendation_intent\" class=\"form-label\">Default work type</label>\\n\n            <select id=\"default_recommendation_intent\" name=\"default_recommendation_intent\" class=\"form-select\" >\\n\n            <option value=\"\" >No work type</option>\\n\n                <option value=\"maintenance\" selected>Maintenance</option>\\n\n            <option value=\"diagnostic\" >Diagnostic</option>\\n\n            <option value=\"repair_verification\" >Repair Verification</option>\\n\n    </select>\\n\n            <div class=\"form-hint\">Diagnostic, maintenance, or repair verification. This is not urgency.</div>\\n\n        </div>\\n\n        <div class=\"col-12 small text-secondary\">\\n\n            <div class=\"fw-medium text-body\">Default labor category</div>\\n\n            <p class=\"mb-2\"><span class=\"fw-medium text-body\">Mechanical</span> at $165.00/hr - <button type=\"button\" class=\"btn btn-link p-0 align-baseline small\" @click=\"setActive('financial'); setFinancialTab('labor')\">Financial Rules \u2192 Labor</button>.</p>\\n\n            <p class=\"mb-0\">RO lifecycle status is configured under <button type=\"button\" class=\"btn btn-link p-0 align-baseline small\" @click=\"setWorkflowTab('statuses')\">RO statuses</button>.</p>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <div class=\"hr-text\">Worksheet notes</div>\\n\n    <div style=\"max-width: 32rem\">\\n\n                <div\\n\n    x-data=\"{\\n\n        advisor: true,\\n\n        technician: false,\\n\n        customer: false,\\n\n        audienceHint: '',\\n\n        _hintTimer: null,\\n\n        guardAudience(which) {\\n\n            if (this.advisor || this.technician || this.customer) {\\n\n                this.audienceHint = '';\\n\n                return;\\n\n            }\\n\n\\n\n            this[which] = true;\\n\n            this.audienceHint = 'Choose another view first, then you can turn this one off.';\\n\n            clearTimeout(this._hintTimer);\\n\n            this._hintTimer = setTimeout(() => { this.audienceHint = ''; }, 4000);\\n\n        }\\n\n    }\"\\n\n    class=\"\"\\n\n    data-note-privacy-field\\n\n>\\n\n    <input type=\"hidden\" name=\"default_notes_visible_to_advisor\" :value=\"advisor ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"default_notes_visible_to_technician\" :value=\"technician ? '1' : '0'\">\\n\n    <input type=\"hidden\" name=\"default_notes_visible_to_customer\" :value=\"customer ? '1' : '0'\">\\n\n\\n\n        <div class=\"form-label\">Visible to</div>\\n\n    <div class=\"form-selectgroup\">\\n\n                    <label class=\"form-selectgroup-item\" for=\"default-note-audience-advisor\">\\n\n                <input\\n\n                    id=\"default-note-audience-advisor\"\\n\n                    type=\"checkbox\"\\n\n                    x-model=\"advisor\"\\n\n                    x-on:change=\"guardAudience('advisor')\"\\n\n                    class=\"form-selectgroup-input\"\\n\n                >\\n\n                <span class=\"form-selectgroup-label\">\\n\n                    <span class=\"badge bg-green-lt\">Advisor</span>\\n\n                    <span class=\"d-block small text-secondary mt-1\">Repair Order</span>\\n\n                </span>\\n\n            </label>\\n\n                    <label class=\"form-selectgroup-item\" for=\"default-note-audience-technician\">\\n\n                <input\\n\n                    id=\"default-note-audience-technician\"\\n\n                    type=\"checkbox\"\\n\n                    x-model=\"technician\"\\n\n                    x-on:change=\"guardAudience('technician')\"\\n\n                    class=\"form-selectgroup-input\"\\n\n                >\\n\n                <span class=\"form-selectgroup-label\">\\n\n                    <span class=\"badge bg-azure-lt\">Technician</span>\\n\n                    <span class=\"d-block small text-secondary mt-1\">Tech Sheet</span>\\n\n                </span>\\n\n            </label>\\n\n                    <label class=\"form-selectgroup-item\" for=\"default-note-audience-customer\">\\n\n                <input\\n\n                    id=\"default-note-audience-customer\"\\n\n                    type=\"checkbox\"\\n\n                    x-model=\"customer\"\\n\n                    x-on:change=\"guardAudience('customer')\"\\n\n                    class=\"form-selectgroup-input\"\\n\n                >\\n\n                <span class=\"form-selectgroup-label\">\\n\n                    <span class=\"badge bg-red-lt\">Customer</span>\\n\n                    <span class=\"d-block small text-secondary mt-1\">Estimate / Portal</span>\\n\n                </span>\\n\n            </label>\\n\n            </div>\\n\n    <div x-show=\"audienceHint\" x-cloak x-text=\"audienceHint\" class=\"small text-warning mt-1\" role=\"status\"></div>\\n\n    </div>\\n\n        <div class=\"form-hint\">New notes start with these views selected. The same choices are on each note.</div>\\n\n    </div>\\n\n\\n\n    <div class=\"d-flex justify-content-end border-top pt-3 mt-4\">\\n\n        <button type=\"submit\" class=\"btn btn-primary\">Save Check In defaults</button>\\n\n    </div>\\n\n</form>\\n\n                    </div>\\n\n\\n\n                    <div class=\"card-body\" id=\"workflow-panel-statuses\" role=\"tabpanel\" aria-labelledby=\"workflow-tab-statuses\" x-show=\"workflowTab === 'statuses'\" x-cloak>\\n\n                        <h3 class=\"mb-1\">Job Board</h3>\\n\n                        <p class=\"text-secondary small\">Set up the shop queues and the statuses that live in each one. Attention stays derived - it is not a lane or a status color.</p>\\n\n                        <form method=\"POST\" action=\"http://localhost/app/settings/shop/job-board-lanes\" data-settings-job-board-lanes>\\n\n    <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">    <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n    <div class=\"card card-sm mb-3\">\\n\n        <div class=\"card-header\">\\n\n            <div>\\n\n                <h4 class=\"card-title\">Job Board lanes</h4>\\n\n                <div class=\"card-subtitle\">These are the shop queues on the Job Board. Rename, reorder, and recolor them. Lane color is visual identity - it is not ARK attention.</div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"list-group list-group-flush\">\\n\n                            <div class=\"list-group-item\">\\n\n                    <div class=\"row g-2 align-items-end\">\\n\n                        <div class=\"col-12 col-sm-6 col-xl-5\">\\n\n                            <label for=\"lane-estimates-name\" class=\"form-label\">Name</label>\\n\n                            <input\\n\n                                id=\"lane-estimates-name\"\\n\n                                type=\"text\"\\n\n                                name=\"lanes[estimates][name]\"\\n\n                                value=\"Estimates\"\\n\n                                maxlength=\"64\"\\n\n                                class=\"form-control fw-medium\"\\n\n                            >\\n\n                            <div class=\"form-hint font-monospace\">estimates</div>\\n\n                        </div>\\n\n                        <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                            <div id=\"lane-estimates-color\" class=\"form-label\">Color</div>\\n\n                            <div\\n\n    class=\"dropdown\"\\n\n    x-data=\"{\\n\n        open: false,\\n\n        value: 'secondary',\\n\n        options: JSON.parse('[{\\u0022key\\u0022:\\u0022dark\\u0022,\\u0022label\\u0022:\\u0022Slate\\u0022,\\u0022swatch\\u0022:\\u0022#334155\\u0022,\\u0022chip_tone\\u0022:\\u0022closed\\u0022},{\\u0022key\\u0022:\\u0022secondary\\u0022,\\u0022label\\u0022:\\u0022Neutral\\u0022,\\u0022swatch\\u0022:\\u0022#94a3b8\\u0022,\\u0022chip_tone\\u0022:\\u0022move\\u0022},{\\u0022key\\u0022:\\u0022warning\\u0022,\\u0022label\\u0022:\\u0022Waiting\\u0022,\\u0022swatch\\u0022:\\u0022#f97316\\u0022,\\u0022chip_tone\\u0022:\\u0022approval\\u0022},{\\u0022key\\u0022:\\u0022info\\u0022,\\u0022label\\u0022:\\u0022Info\\u0022,\\u0022swatch\\u0022:\\u0022#f59e0b\\u0022,\\u0022chip_tone\\u0022:\\u0022blocked\\u0022},{\\u0022key\\u0022:\\u0022primary\\u0022,\\u0022label\\u0022:\\u0022In motion\\u0022,\\u0022swatch\\u0022:\\u0022#0ea5e9\\u0022,\\u0022chip_tone\\u0022:\\u0022motion\\u0022},{\\u0022key\\u0022:\\u0022success\\u0022,\\u0022label\\u0022:\\u0022Ready\\u0022,\\u0022swatch\\u0022:\\u0022#10b981\\u0022,\\u0022chip_tone\\u0022:\\u0022ready\\u0022}]'),\\n\n        get selected() {\\n\n            return this.options.find((option) => option.key === this.value) ?? this.options[0];\\n\n        },\\n\n        choose(key) {\\n\n            this.value = key;\\n\n            this.open = false;\\n\n        },\\n\n    }\"\\n\n    @keydown.escape.window=\"open = false\"\\n\n>\\n\n    <input type=\"hidden\" name=\"lanes[estimates][color]\" x-model=\"value\">\\n\n\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"form-select d-flex align-items-center gap-2 text-start\"\\n\n        @click=\"open = !open\"\\n\n        :aria-expanded=\"open.toString()\"\\n\n        aria-haspopup=\"listbox\"\\n\n         aria-labelledby=\"lane-estimates-color\"     >\\n\n        <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${selected?.swatch || '#94a3b8'}`\" aria-hidden=\"true\"></span>\\n\n        <span class=\"text-truncate\" x-text=\"selected?.label || 'Color'\"></span>\\n\n    </button>\\n\n\\n\n    <div\\n\n        x-show=\"open\"\\n\n        x-cloak\\n\n        @click.outside=\"open = false\"\\n\n        class=\"dropdown-menu show w-100\"\\n\n        role=\"listbox\"\\n\n    >\\n\n        <template x-for=\"option in options\" :key=\"option.key\">\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"dropdown-item d-flex align-items-center gap-2\"\\n\n                :class=\"{ 'active': option.key === value }\"\\n\n                @click=\"choose(option.key)\"\\n\n                role=\"option\"\\n\n                :aria-selected=\"(option.key === value).toString()\"\\n\n            >\\n\n                <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${option.swatch}`\" aria-hidden=\"true\"></span>\\n\n                <span x-text=\"option.label\"></span>\\n\n            </button>\\n\n        </template>\\n\n    </div>\\n\n</div>\\n\n                        </div>\\n\n                        <div class=\"col-4 col-sm-3 col-xl-1\">\\n\n                            <label for=\"lane-estimates-order\" class=\"form-label\">Order</label>\\n\n                            <input\\n\n                                id=\"lane-estimates-order\"\\n\n                                type=\"number\"\\n\n                                name=\"lanes[estimates][sort_order]\"\\n\n                                value=\"0\"\\n\n                                min=\"0\"\\n\n                                max=\"999\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"col-8 col-sm-9 col-xl-3\">\\n\n                            <label class=\"form-check mb-2\">\\n\n                                <input type=\"hidden\" name=\"lanes[estimates][active]\" value=\"0\">\\n\n                                <input\\n\n                                    type=\"checkbox\"\\n\n                                    name=\"lanes[estimates][active]\"\\n\n                                    value=\"1\"\\n\n                                    checked                                    class=\"form-check-input\"\\n\n                                >\\n\n                                <span class=\"form-check-label\">Show on Job Board</span>\\n\n                            </label>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n                            <div class=\"list-group-item\">\\n\n                    <div class=\"row g-2 align-items-end\">\\n\n                        <div class=\"col-12 col-sm-6 col-xl-5\">\\n\n                            <label for=\"lane-waiting_approval-name\" class=\"form-label\">Name</label>\\n\n                            <input\\n\n                                id=\"lane-waiting_approval-name\"\\n\n                                type=\"text\"\\n\n                                name=\"lanes[waiting_approval][name]\"\\n\n                                value=\"Waiting Approval\"\\n\n                                maxlength=\"64\"\\n\n                                class=\"form-control fw-medium\"\\n\n                            >\\n\n                            <div class=\"form-hint font-monospace\">waiting_approval</div>\\n\n                        </div>\\n\n                        <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                            <div id=\"lane-waiting_approval-color\" class=\"form-label\">Color</div>\\n\n                            <div\\n\n    class=\"dropdown\"\\n\n    x-data=\"{\\n\n        open: false,\\n\n        value: 'warning',\\n\n        options: JSON.parse('[{\\u0022key\\u0022:\\u0022dark\\u0022,\\u0022label\\u0022:\\u0022Slate\\u0022,\\u0022swatch\\u0022:\\u0022#334155\\u0022,\\u0022chip_tone\\u0022:\\u0022closed\\u0022},{\\u0022key\\u0022:\\u0022secondary\\u0022,\\u0022label\\u0022:\\u0022Neutral\\u0022,\\u0022swatch\\u0022:\\u0022#94a3b8\\u0022,\\u0022chip_tone\\u0022:\\u0022move\\u0022},{\\u0022key\\u0022:\\u0022warning\\u0022,\\u0022label\\u0022:\\u0022Waiting\\u0022,\\u0022swatch\\u0022:\\u0022#f97316\\u0022,\\u0022chip_tone\\u0022:\\u0022approval\\u0022},{\\u0022key\\u0022:\\u0022info\\u0022,\\u0022label\\u0022:\\u0022Info\\u0022,\\u0022swatch\\u0022:\\u0022#f59e0b\\u0022,\\u0022chip_tone\\u0022:\\u0022blocked\\u0022},{\\u0022key\\u0022:\\u0022primary\\u0022,\\u0022label\\u0022:\\u0022In motion\\u0022,\\u0022swatch\\u0022:\\u0022#0ea5e9\\u0022,\\u0022chip_tone\\u0022:\\u0022motion\\u0022},{\\u0022key\\u0022:\\u0022success\\u0022,\\u0022label\\u0022:\\u0022Ready\\u0022,\\u0022swatch\\u0022:\\u0022#10b981\\u0022,\\u0022chip_tone\\u0022:\\u0022ready\\u0022}]'),\\n\n        get selected() {\\n\n            return this.options.find((option) => option.key === this.value) ?? this.options[0];\\n\n        },\\n\n        choose(key) {\\n\n            this.value = key;\\n\n            this.open = false;\\n\n        },\\n\n    }\"\\n\n    @keydown.escape.window=\"open = false\"\\n\n>\\n\n    <input type=\"hidden\" name=\"lanes[waiting_approval][color]\" x-model=\"value\">\\n\n\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"form-select d-flex align-items-center gap-2 text-start\"\\n\n        @click=\"open = !open\"\\n\n        :aria-expanded=\"open.toString()\"\\n\n        aria-haspopup=\"listbox\"\\n\n         aria-labelledby=\"lane-waiting_approval-color\"     >\\n\n        <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${selected?.swatch || '#94a3b8'}`\" aria-hidden=\"true\"></span>\\n\n        <span class=\"text-truncate\" x-text=\"selected?.label || 'Color'\"></span>\\n\n    </button>\\n\n\\n\n    <div\\n\n        x-show=\"open\"\\n\n        x-cloak\\n\n        @click.outside=\"open = false\"\\n\n        class=\"dropdown-menu show w-100\"\\n\n        role=\"listbox\"\\n\n    >\\n\n        <template x-for=\"option in options\" :key=\"option.key\">\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"dropdown-item d-flex align-items-center gap-2\"\\n\n                :class=\"{ 'active': option.key === value }\"\\n\n                @click=\"choose(option.key)\"\\n\n                role=\"option\"\\n\n                :aria-selected=\"(option.key === value).toString()\"\\n\n            >\\n\n                <span class=\"avatar avatar-xs rounded flex-shrink-0\" :style=\"`background: ${option.swatch}`\" aria-hidden=\"true\"></span>\\n\n                <span x-text=\"option.label\"></span>\\n\n            </button>\\n\n        </template>\\n\n    </div>\\n\n</div>\\n\n                        </div>\\n\n                        <div class=\"col-4 col-sm-3 col-xl-1\">\\n\n                            <label for=\"lane-waiting_approval-order\" class=\"form-label\">Order</label>\\n\n                            <input\\n\n                                id=\"lane-waiting_approval-order\"\\n\n                                type=\"number\"\\n\n                                name=\"lanes[waiting_approval][sort_order]\"\\n\n                                value=\"1\"\\n\n                                min=\"0\"\\n\n                                max=\"999\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"col-8 col-sm-9 col-xl-3\">\\n\n                            <label class=\"form-check mb-2\">\\n\n                                <input type=\"hidden\" name=\"lanes[waiting_approval][active]\" value=\"0\">\\n\n                                <input\\n\n                                    type=\"checkbox\"\\n\n                                    name=\"lanes[waiting_approval][active]\"\\n\n                                    value=\"1\"\\n\n                                    checked                                    class=\"form-check-input\"\\n\n                                >\\n\n                                <span class=\"form-check-label\">Show on Job Board</span>\\n\n                            </label>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n                            <div class=\"list-group-item\">\\n\n                    <div class=\"row g-2 align-items-end\">\\n\n                        <div class=\"col-12 col-sm-6 col-xl-5\">\\n\n                            <label for=\"lane-parts-name\" class=\"form-label\">Name</label>\\n\n                            <input\\n\n                                id=\"lane-parts-name\"\\n\n                                type=\"text\"\\n\n                                name=\"lanes[parts][name]\"\\n\n                                value=\"Waiting Parts\"\\n\n                                maxlength=\"64\"\\n\n                                class=\"form-control fw-medium\"\\n\n                            >\\n\n                            <div class=\"form-hint font-monospace\">parts</div>\\n\n                        </div>\\n\n                        <div class=\"col-12 col-sm-6 col-xl-3\">\\n\n                            <div id=\"lane-parts-color\" class=\"form-label\">Color</div>\\n\n                            <div\\n\n    class=\"dropdown\"\\n\n    x-data=\"{\\n\n        open: false,\\n\n        value: 'info',\\n\n        options: JSON.parse('[{\\u0022key\\u0022:\\u0022dark\\u0022,\\u0022label\\u0022:\\u0022Slate\\u0022,\\u0022swatch\\u0022:\\u0022#334155\\u0022,\\u0022chip_tone\\u0022:\\u0022closed\\u0022},{\\u0022key\\u0022:\\u0022secondary\\u0022,\\u0022label\\u0022:\\u0022Neutral\\u0022,\\u0022swatch\\u0022:\\u0022#94a3b8\\u0022,\\u0022chip_tone\\u0022:\\u0022move\\u0022},{\\u0022key\\u0022:\\u0022warning\\u0022,\\u0022label\\u0022:\\u0022Waiting\\u0022,\\u0022swatch\\u0022:\\u0022#f97316\\u0022,\\u0022chip_tone\\u0022:\\u0022approval\\u0022},{\\u0022key\\u0022:\\u0022info\\u0022,\\u0022label\\u0022:\\u0022Info\\u0022,\\u0022swatch\\u0022:\\u0022#f59e0b\\u0022,\\u0022chip_tone\\u0022:\\u0022blocked\\u0022},{\\u0022key\\u0022:\\u0022primary\\u0022,\\u0022label\\u0022:\\u0022In motion\\u0022,\\u0022swatch\\u0022:\\u0022#0ea5e9\\u0022,\\u0022chip_tone\\u0022:\\u0022motion\\u0022},{\\u0022key\\u0022:\\u0022success\\u0022,\\u0022label\\u0022:\\u0022Ready\\u0022,\\u0022swatch\\u0022:\\u0022#10b981\\u0022,\\u0022chip_tone\\u0022:\\u0022ready\\u0022}]'),\\n\n        get selected() {\\n\n            return this.options.find((option) => option.key === this.value) ?? this.options[0];\\n\n        },\\n\n        choose(key) {\\n\n            this.value = key;\\n\n            this.open = false;\\n\n        },\\n\n    }\"\\n\n    @keydown.escape.window=\"open = false\"\\n\n>\\n\n    <input type=\"hidden\" name=\"lanes[parts][color]\" x-model=\"value\">\\n\n\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"form-select d-flex align-items-center gap-2 text-start\"\\n\n        @click=\"open = !open\"\\n\n        :aria-expanded=\"open.toString()\"\\n\n        aria-haspopup=\"listbox\"\\n\n         aria-labelledby=\"lane-parts-color\"     >\\n\n        <span class=\"avatar avatar-xs rounded flex