ass=\"card-title\" id=\"shop-comms-stations\">Stations</h2>\\n\n    </div>\\n\n\\n\n    \\n\n    <div class=\"list-group list-group-flush\">\\n\n                                                <div class=\"list-group-item\">\\n\n                            <div class=\"d-flex align-items-center gap-3\">\\n\n                    <div class=\"flex-fill overflow-hidden\">\\n\n                        <div class=\"fw-bold text-truncate\">Left</div>\\n\n                        <div class=\"small text-secondary text-truncate\">No device attached</div>\\n\n                    </div>\\n\n                    <span class=\"flex-shrink-0 small fw-bold text-uppercase text-secondary\">\\n\n                        Needs device\\n\n                    </span>\\n\n                </div>\\n\n                            </div>\\n\n                                                            <div class=\"list-group-item\">\\n\n                            <div class=\"d-flex align-items-center gap-3\">\\n\n                    <div class=\"flex-fill overflow-hidden\">\\n\n                        <div class=\"fw-bold text-truncate\">Right</div>\\n\n                        <div class=\"small text-secondary text-truncate\">No device attached</div>\\n\n                    </div>\\n\n                    <span class=\"flex-shrink-0 small fw-bold text-uppercase text-secondary\">\\n\n                        Needs device\\n\n                    </span>\\n\n                </div>\\n\n                            </div>\\n\n                        </div>\\n\n\\n\n            <details class=\"border-top\">\\n\n            <summary class=\"card-body py-2 fw-medium\">Add a station</summary>\\n\n            <form method=\"POST\" action=\"http://localhost/app/shop/workstations\" class=\"card-body pt-0\">\\n\n                <input type=\"hidden\" name=\"_token\" value=\"vXn9Nkx8pwrOnP5MQQo1jKjoLB1wqO4xffITWYx0\" autocomplete=\"off\">                <div class=\"row g-2\">\\n\n                    <div class