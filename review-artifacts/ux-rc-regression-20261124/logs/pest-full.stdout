\\n\n        document.documentElement.style.colorScheme = \"light\";\\n\n    </script>\\n\n<script>\\n\n    (() => {\\n\n        const preference = \"light\";\\n\n        const media = window.matchMedia('(prefers-color-scheme: dark)');\\n\n\\n\n        const resolve = () => {\\n\n            if (preference === 'dark') return 'dark';\\n\n            if (preference === 'light') return 'light';\\n\n            if (preference === 'system') return media.matches ? 'dark' : 'light';\\n\n            return media.matches ? 'dark' : 'light';\\n\n        };\\n\n\\n\n        const apply = (resolved) => {\\n\n            const isDark = resolved === 'dark';\\n\n            document.documentElement.classList.toggle('dark', isDark);\\n\n            document.documentElement.setAttribute('data-bs-theme', resolved);\\n\n            document.documentElement.style.colorScheme = resolved;\\n\n            // Legacy key kept as last-resolved paint hint only \u2014 never the preference authority.\\n\n            try {\\n\n                localStorage.setItem('ark_theme', resolved);\\n\n                localStorage.removeItem('hs_theme');\\n\n            } catch (_) {}\\n\n        };\\n\n\\n\n        apply(resolve());\\n\n\\n\n        if (preference === 'system') {\\n\n            const onChange = () => apply(resolve());\\n\n            if (typeof media.addEventListener === 'function') {\\n\n                media.addEventListener('change', onChange);\\n\n            } else if (typeof media.addListener === 'function') {\\n\n                media.addListener(onChange);\\n\n            }\\n\n        }\\n\n\\n\n        window.arkApplyDisplayThemePreference = (nextPreference) => {\\n\n            const next = nextPreference === 'dark' || nextPreference === 'light' || nextPreference === 'system'\\n\n                ? nextPreference\\n\n                : 'light';\\n\n            const resolved = next === 'system'\\n\n                ? (media.matches ? 'dark' : 'light')\\n\n                : next;\\n\n            document.documentElement.setAttribute('data-ark-display-theme-preference', next);\\n\n            apply(resolved);\\n\n        };\\n\n\\n\n        document.documentElement.setAttribute('data-ark-display-theme-preference', preference);\\n\n\\n\n        window.arkToggleTheme = () => {\\n\n            const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';\\n\n            window.arkApplyDisplayThemePreference(nextTheme);\\n\n\\n\n            const token = document.querySelector('meta[name=\"csrf-token\"]')?.content;\\n\n            const url = \"http:\\/\\/localhost\\/app\\/profile\\/display-theme\";\\n\n            if (!token || !url) {\\n\n                return;\\n\n            }\\n\n\\n\n            fetch(url, {\\n\n                method: 'PATCH',\\n\n                headers: {\\n\n                    'Content-Type': 'application/json',\\n\n                    Accept: 'application/json',\\n\n                    'X-CSRF-TOKEN': token,\\n\n                },\\n\n                body: JSON.stringify({ display_theme: nextTheme }),\\n\n                credentials: 'same-origin',\\n\n            }).catch(() => {});\\n\n        };\\n\n    })();\\n\n</script>\\n\n                    <meta name=\"ark-comms-interrupt-url\" content=\"http://localhost/app/api/comms/interrupts\">\\n\n            <meta name=\"ark-staff-presence-heartbeat-url\" content=\"http://localhost/app/api/staff/presence/heartbeat\">\\n\n            <meta name=\"ark-incoming-call-dismiss-url\" content=\"http://localhost/app/api/telephony/incoming-call/dismiss\">\\n\n            <meta name=\"ark-website-lead-interrupt-dismiss-url\" content=\"http://localhost/app/api/leads/website-interrupt/dismiss\">\\n\n            <meta name=\"ark-portal-interrupt-dismiss-url\" content=\"http://localhost/app/api/portal/customer-activity-interrupt/dismiss\">\\n\n            <meta name=\"ark-call-queue-url\" content=\"http://localhost/app/api/telephony/call-queue\">\\n\n     