inejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M12 7v5l3 3\"/></svg>\\n\n                    Waiting\\n\n                </button>\\n\n            </form>\\n\n                            <div data-comms-context-check-in=\"check_in\">\\n\n                <a\\n\n                    href=\"http://localhost/app/intake/new?phone=7195550511\"\\n\n                    class=\"btn btn-sm w-100 btn-primary\"\\n\n                    data-comms-check-in\\n\n                                    >\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5\"/></svg>\\n\n                    Check In\\n\n                </a>\\n\n            </div>\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_latest/work\" class=\"d-flex\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"VHsjhHda3vjR1XyGxNg1AM7Jr1IsxBrbOdheNE8j\" autocomplete=\"off\">            <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:14:14+00:00\">\\n\n            <button type=\"submit\" class=\"btn btn-sm w-100\" data-comms-work-unread>\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 7a2 2 0 0 1 2 