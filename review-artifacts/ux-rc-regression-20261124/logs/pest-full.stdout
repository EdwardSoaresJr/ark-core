tp://localhost/app/communications/inbox?platform_conversation=pc_answered&amp;filter=all&amp;owner=mine\"\\n\n                        class=\"btn btn-sm\"\\n\n                                            >\\n\n                        Mine\\n\n                        <span class=\"text-secondary ms-1 d-lg-none d-xxl-inline\">0</span>\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?platform_conversation=pc_answered&amp;filter=all&amp;owner=unassigned\"\\n\n                        class=\"btn btn-sm\"\\n\n                                            >\\n\n                        Unassigned\\n\n                        <span class=\"text-secondary ms-1 d-lg-none d-xxl-inline\">1</span>\\n\n                    </a>\\n\n                            </div>\\n\n            <div class=\"small text-secondary mt-2 px-1\" data-comms-list-summary>\\n\n                <span data-comms-list-total>1 conversation</span>            </div>\\n\n        </nav>\\n\n    \\n\n            <div class=\"list-group list-group-flush overflow-auto flex-fill\" data-comms-list-items>\\n\n                            <a\\n\n    href=\"http://localhost/app/communications/inbox?filter=all&amp;platform_conversation=pc_answered\"\\n\n    data-comms-list-row\\n\n    data-comms-row-key=\"platform:pc_answered\"\\n\n    class=\"list-group-item list-group-item-action ark-comms-row px-3 py-2 active\"\\n\n     aria-current=\"true\" >\\n\n    <div class=\"d-flex gap-3\">\\n\n        <span class=\"avatar bg-secondary-lt flex-shrink-0\" aria-hidden=\"true\">75</span>\\n\n        <div class=\"flex-fill overflow-hidden\">\\n\n            <div class=\"d-flex align-items-center gap-1\">\\n\n                <span class=\"text-truncate fw-medium\">(719) 555-0513</span>\\n\n                                    <span class=\"ms-auto ps-1 small text-nowrap text-secondary\">1 month ago</span>\\n\n                            </div>\\n\n            <div class=\"d-flex align-items-center gap-2\">\\n\n                <div class=\"small text-truncate flex-fill text-secondary\">Answered call</div>\\n\n                            </div>\\n\n            <div class=\"d-flex flex-wrap align-items-center gap-1 mt-1 small\">\\n\n                                                    <span class=\"badge bg-secondary-lt\">SMS</span>\\n\n                                                                    <span class=\"badge bg-primary-lt\" >Needs attention</span>\\n\n                                                    <span class=\"text-secondary\">Unassigned</span>\\n\n                                                                            </div>\\n\n        </div>\\n\n    </div>\\n\n</a>\\n\n                                </div>\\n\n    </div>\\n\n                    </div>\\n\n                                    </div>\\n\n            </aside>\\n\n\\n\n            <section\\n\n                id=\"ops-comms-workspace-thread\"\\n\n                class=\"col-12 col-lg flex-column\"\\n\n                :class=\"! threadOpen ? 'd-none d-lg-flex' : (contextOpen ? 'd-none d-xl-flex' : 'd-flex')\"\\n\n                aria-label=\"Conversation\"\\n\n            >\\n\n                <div class=\"card chat flex-fill overflow-hidden\" data-comms-thread-card>\\n\n    <div class=\"card-header d-block py-2 ark-comms-thread-header\" data-comms-thread-identity>\\n\n                            \\n\n            <div class=\"d-flex align-items-center gap-2 ark-comms-thread-header-row\">\\n\n                                    <a class=\"btn btn-icon btn-sm btn-ghost-secondary d-lg-none flex-shrink-0\" href=\"http://localhost/app/communications/inbox?filter=all\" aria-label=\"Back to list\" title=\"Back to list\">\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n                    </a>\\n\n                                <div class=\"flex-fill overflow-hidden\">\\n\n                                        <div class=\"d-flex align-items-center column-gap-2 overflow-hidden\">\\n\n                        <h3 class=\"card-title mb-0 text-truncate\">(719) 555-0513</h3>\\n\n                        <span class=\"badge bg-red-lt flex-shrink-0 d-none d-xl-inline-flex\">Needs attention</span>\\n\n                    </div>\\n\n                    <div class=\"d-flex flex-nowrap align-items-center column-gap-2 small text-secondary overflow-hidden\" data-comms-thread-visit>\\n\n                        <span class=\"badge bg-red-lt flex-shrink-0 d-xl-none\">Needs attention</span>\\n\n                                                                                            </div>\\n\n                </div>\\n\n                \\n\n                <div class=\"btn-list ark-comms-actions flex-nowrap flex-shrink-0 d-xl-none\">\\n\n                                            <a href=\"tel:7195550513\" class=\"btn btn-sm\" title=\"Call\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                            <span class=\"ark-comms-action-label\">Call</span>\\n\n                        </a>\\n\n                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-sm\"\\n\n                        data-comms-context-toggle\\n\n                        aria-label=\"Customer\"\\n\n                        title=\"Customer\"\\n\n                        :aria-pressed=\"contextOpen.toString()\"\\n\n                        @click=\"contextOpen = ! contextOpen\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0\"/><path d=\"M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2\"/></svg>\\n\n                        <span class=\"ark-comms-action-label\">Customer</span>\\n\n                    </button>\\n\n                                            <div class=\"btn-list flex-nowrap\" role=\"group\" aria-label=\"Conversation work\" data-comms-work-actions=\"menu\">\\n\n                    <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_answered/work\" class=\"d-inline-flex\">\\n\n                <input type=\"hidden\" name=\"_token\" value=\"VIOa6MlKR9mLLI7EG8bjYRgQa9rHntf3jKTWpeVR\" autocomplete=\"off\">                <input type=\"hidden\" name=\"action\" value=\"resolve\"><input type=\"hidden\" name=\"filter\" value=\"all\"><input type=\"hidden\" name=\"owner\" value=\"everyone\">\\n\n                <button type=\"submit\" class=\"btn btn-sm btn-success\">\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l5 5l10 -10\"/></svg>\\n\n                    <span class=\"ark-comms-action-label\">Resolve</span>\\n\n                </button>\\n\n            </form>\\n\n                <div class=\"dropdown\">\\n\n            <button type=\"button\" class=\"btn btn-sm dropdown-toggle\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" data-bs-popper-config='{\"strategy\":\"fixed\"}' aria-expanded=\"false\" aria-label=\"Conversation actions\" title=\"Conversation actions\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/></svg>\\n\n                <span class=\"ark-comms-action-label\">Actions</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu dropdown-menu-end p-2\" style=\"min-width: 16rem\">\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_answered/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"VIOa6MlKR9mLLI7EG8bjYRgQa9rHntf3jKTWpeVR\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"all\"><input type=\"hidden\" name=\"owner\" value=\"everyone\">\\n\n                    <input type=\"hidden\" name=\"assign_to\" value=\"me\">\\n\n                    <button type=\"submit\" class=\"btn btn-sm w-100 mb-2\">Assign to me</button>\\n\n                </form>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_answered/work\" class=\"mb-2\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"VIOa6MlKR9mLLI7EG8bjYRgQa9rHntf3jKTWpeVR\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"all\"><input type=\"hidden\" name=\"owner\" value=\"everyone\">\\n\n                    <input type=\"hidden\" name=\"assign_to\" value=\"user\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-assign-menu\">Assign to</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <select id=\"comms-work-assign-menu\" name=\"user_id\" class=\"form-select\" required>\\n\n                            <option value=\"\" disabled selected>Choose\u2026</option>\\n\n                                                            <option value=\"1\" >Mr. Savion Carroll MD</option>\\n\n                                                    </select>\\n\n                        <button type=\"submit\" class=\"btn\">Assign</button>\\n\n                    </div>\\n\n                </form>\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_answered/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"VIOa6MlKR9mLLI7EG8bjYRgQa9rHntf3jKTWpeVR\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"follow_up\"><input type=\"hidden\" name=\"filter\" value=\"all\"><input type=\"hidden\" name=\"owner\" value=\"everyone\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-due-menu\">Follow up on</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <input id=\"comms-work-due-menu\" type=\"datetime-local\" name=\"due_at\" value=\"2026-11-25T08:00\" required class=\"form-control\">\\n\n                        <button type=\"submit\" class=\"btn\">Set</button>\\n\n                    </div>\\n\n                </form>\\n\n                <div class=\"dropdown-divider\"></div>\\n\n                                    <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_answered/work\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"VIOa6MlKR9mLLI7EG8bjYRgQa9rHntf3jKTWpeVR\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"action\" value=\"wait\"><input type=\"hidden\" name=\"filter\" value=\"all\"><input type=\"hidden\" name=\"owner\" value=\"everyone\">\\n\n                        <button type=\"submit\" class=\"dropdown-item\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M12 7v5l3 3\"/></svg>\\n\n                            Waiting on the customer\\n\n                        </button>\\n\n                    </form>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/platform-conversations/pc_answered/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"VIOa6MlKR9mLLI7EG8bjYRgQa9rHntf3jKTWpeVR\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"all\"><input type=\"hidden\" name=\"owner\" value=\"everyone\">\\n\n                    <button type=\"submit\" class=\"dropdown-item\" data-comms-work-unread>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                        Mark unread\\n\n                    </button>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                                    </div>\\n\n            </div>\\n\n            </div>\\n\n\\n\n            <section class=\"alert alert-danger m-2 mb-0 py-2 small\" aria-label=\"What to do next\" data-comms-decision=\"needs\">\\n\n    <div class=\"fw-bold\">\\n\n        Needs attention\\n\n            </div>\\n\n                <div class=\"text-secondary d-none d-xxl-block\">Shop action may be due. Reply if needed, mark waiting, or resolve.</div>\\n\n    \\n\n    \\n\n    \\n\n</section>\\n\n    \\n\n    <div class=\"ark-comms-thread-wrap position-relative d-flex flex-column flex-fill\">\\n\n    <div\\n\n        id=\"comms-workspace-thread-messages\"\\n\n        class=\"card-body chat-bubbles ark-comms-thread gap-2 overflow-auto flex-fill p-2 p-md-3\"\\n\n        data-comms-thread-body\\n\n        aria-label=\"Conversation\"\\n\n                    data-mark-read-url=\"http://localhost/app/communications/platform-conversations/pc_answered/read\"\\n\n            data-conversation-key=\"platform:pc_answered\"\\n\n            >\\n\n                    <div class=\"text-secondary text-center my-auto\">No messages yet.</div>\\n\n            </div>\\n\n        <button type=\"button\" class=\"btn btn-primary btn-sm rounded-pill shadow position-absolute bottom-0 start-50 translate-middle-x mb-2 d-none\" data-comms-new-below>\\n\n            New messages\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n        </button>\\n\n    </div>\\n\n\\n\n    \\n\n            <footer class=\"card-footer p-0\" data-comms-composer>\\n\n                                <div\\n\n                id=\"comms-thread-composer\"\\n\n                data-ark-workspace-dirty=\"off\"\\n\n                data-ark-conversation-composer\\n\n                data-platform-backed=\"1\"\\n\n                x-data=\"arkConversationQuickReply(JSON.parse('{\\u0022sendUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/communications\\\\\\/platform-conversations\\\\\\/pc_answered\\\\\\/messages\\u0022,\\u0022messagesListIds\\u0022:[\\u0022comms-workspace-thread-messages\\u0022],\\u0022hasConversationHistory\\u0022:false,\\u0022alwaysOpen\\u0022:true,\\u0022keepOpenAfterSend\\u0022:true,\\u0022customerPhoneDisplay\\u0022:\\u0022(719) 555-0513\\u0022,\\u0022showSmsComposer\\u0022:true,\\u0022platformBacked\\u0022:true}'))\"\\n\n            >\\n\n                <div class=\"px-3 py-2\">\\n\n                    <label class=\"visually-hidden\" for=\"comms-thread-composer-body\">Message</label>\\n\n                    <textarea\\n\n                        id=\"comms-thread-composer-body\"\\n\n                        x-ref=\"replyBody\"\\n\n                        x-model=\"body\"\\n\n                        rows=\"2\"\\n\n                        :placeholder=\"composerPlaceholder()\"\\n\n                        class=\"form-control\"\\n\n                        @keydown.meta.enter.prevent=\"send()\"\\n\n                        @keydown.ctrl.enter.prevent=\"send()\"\\n\n                    ></textarea>\\n\n                    <div class=\"mt-2\">\\n\n                        <div class=\"d-flex flex-wrap gap-1\" role=\"group\" aria-label=\"Quick replies\" data-comms-quick-replies>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for reaching out - we received your request and will follow up shortly with next steps.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Estimate received\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We can get you on the schedule. What day works best for you to bring the vehicle in?'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Scheduling\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for your patience - we are running a little behind today but will get back to you as soon as possible.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Running behind\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We offer several payment options at checkout. Let us know if you would like an estimate sent over to review.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Financing\\n\n            </button>\\n\n            </div>\\n\n                    </div>\\n\n                    <div class=\"small text-secondary text-truncate mt-1\" x-show=\"attachmentLabel\" x-text=\"attachmentLabel\" x-cloak></div>\\n\n                    <div class=\"small text-danger fw-medium mt-1\" x-show=\"error !== ''\" x-text=\"error\" x-cloak></div>\\n\n                </div>\\n\n                <div class=\"d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-top\" role=\"group\" aria-label=\"Conversation commands\">\\n\n                    <details\\n\n                        class=\"position-relative\"\\n\n                        x-ref=\"actionsMenu\"\\n\n                        @toggle=\"onActionsMenuToggle($event)\"\\n\n                        @click.outside=\"closeActionsMenu()\"\\n\n                    >\\n\n                        <summary class=\"btn btn-sm\">Actions</summary>\\n\n                        <div class=\"dropdown-menu show position-absolute bottom-100 mb-1\" data-comms-actions-panel>\\n\n                                   