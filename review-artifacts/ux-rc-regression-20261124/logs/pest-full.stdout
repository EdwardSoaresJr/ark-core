\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomIn()\"\\n\n                            :disabled=\"scale >= maxScale - 0.001\"\\n\n                            aria-label=\"Zoom in\"\\n\n                        >\\n\n                            +\\n\n                        </button>\\n\n                        <a\\n\n                            :href=\"src\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-sm\"\\n\n                            x-show=\"src\"\\n\n                        >\\n\n                            Open original\\n\n                        </a>\\n\n                        <button type=\"button\" class=\"btn btn-sm\" @click=\"close()\">Close</button>\\n\n                    </div>\\n\n                </div>\\n\n\\n\n                <div\\n\n                    x-ref=\"viewport\"\\n\n                    class=\"modal-body p-0 d-flex align-items-center justify-content-center overflow-hidden bg-black\"\\n\n                    style=\"height: 80vh\"\\n\n                    @wheel.prevent=\"onWheel($event)\"\\n\n                    @mousemove.window=\"onPan($event)\"\\n\n                    @mouseup.window=\"endPan()\"\\n\n                >\\n\n                    <img\\n\n                        :src=\"src\"\\n\n                        :alt=\"alt || 'Attachment preview'\"\\n\n                        class=\"user-select-none\"\\n\n                        style=\"max-width: none; max-height: none; touch-action: none\"\\n\n                        :style=\"imageTransform()\"\\n\n                        @load=\"onImageLoad($event)\"\\n\n                        @mousedown.prevent=\"startPan($event)\"\\n\n                        @click.stop\\n\n                        draggable=\"false\"\\n\n                    >