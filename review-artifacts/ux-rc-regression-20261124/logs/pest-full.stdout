              var doneMsg =\\n\n                    'All print jobs completed - ' +\\n\n                    ok +\\n\n                    ' parts label' +\\n\n                    (ok === 1 ? '' : 's') +\\n\n                    ' sent to printer';\\n\n                if (window.toastr && typeof window.toastr.success === 'function') {\\n\n                    window.toastr.success(doneMsg);\\n\n                }\\n\n            }\\n\n        }\\n\n    } catch (err) {\\n\n        console.error(err);\\n\n        arkNotifyPrintError(err);\\n\n    } finally {\\n\n        if (lockOwner) {\\n\n            arkReleaseLock(lockOwner);\\n\n        }\\n\n        if (btn) {\\n\n            btn.disabled = false;\\n\n            btn.dataset.printing = '';\\n\n        }\\n\n    }\\n\n}\\n\n\\n\nwindow.arkPrintPartsLabelsBatch = arkPrintPartsLabelsBatch;\\n\n\\n\ndocument.addEventListener('DOMContentLoaded', function() {\\n\n    if (typeof arkMonitorQZReconnect === 'function') {\\n\n        arkMonitorQZReconnect();\\n\n    }\\n\n    if (typeof arkApplyQzUntilVerifiedVisibility === 'function') {\\n\n        arkApplyQzUntilVerifiedVisibility();\\n\n    }\\n\n    setTimeout(function() {\\n\n        if (typeof arkRenderPrinterBanner === 'function') {\\n\n            arkRenderPrinterBanner();\\n\n        }\\n\n        if (typeof arkApplyQzUntilVerifiedVisibility === 'function') {\\n\n            arkApplyQzUntilVerifiedVisibility();\\n\n        }\\n\n    }, 300);\\n\n    setTimeout(function() {\\n\n        if (typeof arkScheduleKeyTagPreflight === 'function') {\\n\n            arkScheduleKeyTagPreflight();\\n\n        }\\n\n    }, 1500);\\n\n});\\n\n</script>\\n\n<style>\\n\n    /** QZ not connected after initial check - optional styling for admins (see arkInitQZPrinterHealthHint / ensureQZConnection). */\\n\n    body.ark-print-offline {\\n\n        box-shadow: inset 0 3px 0 0 rgba(255, 193, 7, 0.9);\\n\n    }\\n\n    .ark-print-queue-panel {\\n\n        position: fixed;\\n\n        bottom: 