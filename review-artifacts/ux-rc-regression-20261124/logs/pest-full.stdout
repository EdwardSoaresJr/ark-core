                  \\n\n        \\n\n        <main>\\n\n            <div\\n\n    class=\"d-flex flex-column flex-fill ark-split\"\\n\n    data-comms-workspace\\n\n    x-data=\"{ threadOpen: true, contextOpen: false }\"\\n\n    :class=\"{ 'ark-comms-thread-open': threadOpen || contextOpen }\"\\n\n>\\n\n    <div class=\"page-body\">\\n\n    <div class=\"container-fluid d-flex flex-column flex-fill\">\\n\n        <div class=\"d-flex align-items-center gap-2 flex-shrink-0 mb-2\" data-comms-section-bar>\\n\n    <nav class=\"flex-fill overflow-auto ark-comms-lanes\" aria-label=\"Communications sections\" data-comms-section-nav>\\n\n        <ul class=\"nav nav-pills flex-nowrap\">\\n\n                                                <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs\"\\n\n                            title=\"Shop action is due now - reply, overdue follow-up, or unresolved call\"\\n\n                            class=\"nav-link text-nowrap active\"\\n\n                             aria-current=\"page\"                         >\\n\n                            <span>Needs attention</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"needs\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?call=1&amp;filter=waiting\"\\n\n                            title=\"Open - awaiting a customer reply or a follow-up that is not due yet\"\\n\n                            class=\"nav-link text-nowrap\"\\n\n                                                    >\\n\n                            <span>Waiting</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"waiting\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?call=1&amp;filter=resolved\"\\n\n                            title=\"Finished communication work\"\\n\n                            class=\"nav-link text-nowrap\"\\n\n                                                    >\\n\n                            <span>Resolved</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"resolved\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                                        <li class=\"nav-item\">\\n\n                    <a\\n\n                        href=\"http://localhost/app/communications/calls\"\\n\n                        class=\"nav-link text-nowrap\"\\n\n                                            >Calls & VM</a>\\n\n                </li>\\n\n                <li class=\"nav-item\">\\n\n                    <a\\n\n                        href=\"http://localhost/app/communications/history\"\\n\n                        class=\"nav-link text-nowrap\"\\n\n                                            >History</a>\\n\n                </li>\\n\n                    </ul>\\n\n    </nav>\\n\n\\n\n            <div class=\"dropdown flex-shrink-0 ms-1\" data-comms-channel-filter>\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                aria-expanded=\"false\"\\n\n                aria-label=\"Channel: All channels\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-sm-1\"><path d=\"M21 14l-3 -3h-7a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1h9a1 1 0 0 1 1 1v10\"/><path d=\"M14 15v2a1 1 0 0 1 -1 1h-7l-3 3v-10a1 1 0 0 1 1 -1h2\"/></svg>\\n\n                <span class=\"d-none d-sm-inline\">All channels</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu dropdown-menu-end\">\\n\n                <span class=\"dropdown-header\">Channel</span>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs\"\\n\n                        class=\"dropdown-item active\"\\n\n                         aria-current=\"page\"                         data-comms-channel-option=\"all\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M21 14l-3 -3h-7a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1h9a1 1 0 0 1 1 1v10\"/><path d=\"M14 15v2a1 1 0 0 1 -1 1h-7l-3 3v-10a1 1 0 0 1 1 -1h2\"/></svg>\\n\n                        All channels\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs&amp;channel=phone\"\\n\n                        class=\"dropdown-item\"\\n\n                                                data-comms-channel-option=\"phone\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                        Phone\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs&amp;channel=sms\"\\n\n                        class=\"dropdown-item\"\\n\n                                                data-comms-channel-option=\"sms\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M8 9h8\"/><path d=\"M8 13h6\"/><path d=\"M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12\"/></svg>\\n\n                        SMS\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs&amp;channel=messenger\"\\n\n                        class=\"dropdown-item\"\\n\n                                                data-comms-channel-option=\"messenger\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><g transform=\"translate(1.8 1.8) scale(0.85)\"><path vector-effect=\"non-scaling-stroke\" d=\"M3 20l1.3 -3.9a9 8 0 1 1 3.4 2.9l-4.7 1\"/><path vector-effect=\"non-scaling-stroke\" d=\"M8 13l3 -2l2 2l3 -2\"/></g></svg>\\n\n                        Messenger\\n\n                    </a>\\n\n                                    <a\\n\n                        href=\