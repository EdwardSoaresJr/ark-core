                  <div  data-conversation-context>\\n\n    \\n\n    \\n\n    \\n\n        <div id=\"open-repair-orders\">\\n\n        <div class=\"card-body border-bottom py-2\">\\n\n            <h3 class=\"card-title mb-0\">Active Work</h3>\\n\n            <div class=\"text-secondary small\">\\n\n                                    Open repair orders across all vehicles - status, workflow posture, and next action.\\n\n                            </div>\\n\n        </div>\\n\n        <div class=\"list-group list-group-flush\">\\n\n                            <div class=\"list-group-item text-secondary small\">No open repair orders for this customer.</div>\\n\n                    </div>\\n\n    </div>\\n\n    \\n\n    </div>\\n\n\\n\n\\n\n<div class=\"card-body border-top py-2\">\\n\n    <div class=\"subheader\">All visits</div>\\n\n    <div class=\"text-secondary small\">Closed and historical repair orders live on the History tab.</div>\\n\n</div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'vehicles'\">\\n\n                            <div class=\"card-body border-bottom py-2 d-flex flex-wrap align-items-center gap-2\">\\n\n    <h3 class=\"card-title mb-0 me-auto\">Fleet</h3>\\n\n            <button\\n\n            type=\"button\"\\n\n            class=\"btn\"\\n\n            title=\"Open to add vehicle\"\\n\n            x-on:click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'hub-vehicle-create', invokeEl: $event.currentTarget } }))\"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M5 12l14 0\"/></svg>\\n\n            Add vehicle\\n\n        </button>\\n\n    </div>\\n\n\\n\n<div class=\"card-body\" x-data=\"{ activeRoVehicleId: null, pendingRemoveVehicleId: null }\">\\n\n            <div class=\"ark-card-grid\" style=\"--ark-card-min-width: 22rem\">\\n\n                            \\n\n                <section id=\"vehicle-1\" class=\"card card-sm\">\\n\n                    <div class=\"card-status-start bg-secondary\"></div>\\n\n                    <div class=\"card-body\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/customers/1?vehicle=1\"\\n\n                            class=\"d-block fw-bold text-reset text-truncate\"\\n\n                            title=\"2012 Chevrolet Tahoe LT\"\\n\n                        >2012 Chevrolet Tahoe LT</a>\\n\n                        <span class=\"badge mt-1 bg-secondary-lt\">No service history</span>\\n\n\\n\n                                                    <div class=\"small fw-medium mt-2\">5.3L V8 / 4WD/4-Wheel Drive/4x4 / Automatic</div>\\n\n                        \\n\n                        \\n\n                        <div class=\"small text-secondary mt-1\">\\n\n                            Plate MLT404 / CO                            \u00b7\\n\n                                                            <span\\n\n        class=\"d-inline-flex align-items-center gap-1\"\\n\n        x-data=\"arkVinDisplay('1GNSKCE07CR040404')\"\\n\n        data-vin-display\\n\n    >\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"trigger\"\\n\n            class=\"btn btn-link p-0 font-monospace text-reset ops-vin-copyable\"\\n\n            @click=\"copy()\"\\n\n            title=\"Click to copy VIN\"\\n\n            :aria-label=\"'Copy VIN ' + vin\"\\n\n        >\\n\n                            <span class=\"text-secondary\">1GNSKCE07</span>\\n\n                        <span class=\"fw-bold\">CR040404</span>\\n\n        </button>\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"readback\"\\n\n            class=\"btn btn-sm btn-ghost-secondary btn-icon p-0 ops-vin-readback-btn\"\\n\n            @click.stop=\"toggleReadback()\"\\n\n            @mouseenter=\"onReadbackHoverEnter()\"\\n\n            @mouseleave=\"onReadbackHoverLeave()\"\\n\n            @focus=\"onReadbackHoverEnter()\"\\n\n            @blur=\"onReadbackHoverLeave()\"\\n\n            :aria-expanded=\"readbackOpen ? 'true' : 'false'\"\\n\n            aria-controls=\"vin-readback-6b05bb21f172e\"\\n\n            aria-haspopup=\"dialog\"\\n\n            aria-label=\"VIN readback\"\\n\n            title=\"VIN readback\"\\n\n            data-vin-readback-trigger\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 16v-6a2 2 0 1 1 4 0v6\"/><path d=\"M3 13h4\"/><path d=\"M10 8v6a2 2 0 1 0 4 0v-1a2 2 0 1 0 -4 0v1\"/><path d=\"M20.732 12a2 2 0 0 0 -3.732 1v1a2 2 0 0 0 3.726 1.01\"/></svg>\\n\n        </button>\\n\n        <span class=\"badge bg-green-lt\" x-show=\"copied\" x-cloak role=\"status\" aria-live=\"polite\">VIN copied</span>\\n\n\\n\n        <template x-teleport=\"body\">\\n\n            <div x-show=\"readbackOpen\" x-cloak data-vin-readback-layer>\\n\n                <div\\n\n                    x-ref=\"backdrop\"\\n\n                    x-show=\"sheetMode\"\\n\n                    x-cloak\\n\n                    class=\"offcanvas-backdrop fade show ops-vin-readback-backdrop\"\\n\n                    @click=\"closeReadback()\"\\n\n                ></div>\\n\n                <div\\n\n                    id=\"vin-readback-6b05bb21f172e\"\\n\n                    x-ref=\"panel\"\\n\n                    :class=\"sheetMode\\n\n                        ? 'offcanvas offcanvas-bottom h-auto show ops-vin-readback-sheet'\\n\n                        : 'card card-sm shadow position-fixed p-2 ops-vin-tooltip-layer ops-vin-readback-popover'\"\\n\n                    :style=\"sheetMode ? '' : tooltipStyle\"\\n\n                    role=\"dialog\"\\n\n                    aria-modal=\"true\"\\n\n                    aria-label=\"VIN readback\"\\n\n                    tabindex=\"-1\"\\n\n                    data-vin-phonetic-readback\\n\n                    @mouseenter=\"onReadbackHoverEnter()\"\\n\n                    @mouseleave=\"onReadbackHoverLeave()\"\\n\n                    @keydown.escape.stop=\"closeReadback()\"\\n\n                >\\n\n                    <div class=\"d-flex align-items-start justify-content-between gap-2 mb-2\">\\n\n                        <span class=\"subheader mb-0\">VIN readback</span>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close VIN readback\" @click=\"closeReadback()\"></button>\\n\n                    </div>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small text-secondary\">\\n\n                                WMI\\n\n                                <span class=\"text-secondary fw-normal\">1\u20133 \u00b7 manufacturer</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">1</span>\\n\n                                        <span class=\"small text-secondary\">One</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">G</span>\\n\n                                        <span class=\"small text-secondary\">Golf</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">N</span>\\n\n                                        <span class=\"small text-secondary\">November</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small text-secondary\">\\n\n                                VDS\\n\n                                <span class=\"text-secondary fw-normal\">4\u20139 \u00b7 descriptor</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">S</span>\\n\n                                        <span class=\"small text-secondary\">Sierra</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">K</span>\\n\n                                        <span class=\"small text-secondary\">Kilo</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">C</span>\\n\n                                        <span class=\"small text-secondary\">Charlie</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">E</span>\\n\n                                        <span class=\"small text-secondary\">Echo</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">0</span>\\n\n                                        <span class=\"small text-secondary\">Zero</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1\">\\n\n                                        <span class=\"font-monospace fw-bold\">7</span>\\n\n                                        <span class=\"small text-secondary\">Seven</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                            <span class=\"d-block mb-1\">\\n\n                            <span class=\"d-block small fw-bold\">\\n\n                                Serial\\n\n                                <span class=\"text-secondary fw-normal\">10\u201317 \u00b7 VIS</span>\\n\n                            </span>\\n\n                            <span class=\"d-flex flex-wrap gap-1\">\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">C</span>\\n\n                                        <span class=\"small text-secondary\">Charlie</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">R</span>\\n\n                                        <span class=\"small text-secondary\">Romeo</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">0</span>\\n\n                                        <span class=\"small text-secondary\">Zero</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">4</span>\\n\n                                        <span class=\"small text-secondary\">Four</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">0</span>\\n\n                                        <span class=\"small text-secondary\">Zero</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">4</span>\\n\n                                        <span class=\"small text-secondary\">Four</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">0</span>\\n\n                                        <span class=\"small text-secondary\">Zero</span>\\n\n                                    </span>\\n\n                                                                    <span class=\"d-inline-flex flex-column align-items-center border rounded px-1 border-primary\">\\n\n                                        <span class=\"font-monospace fw-bold\">4</span>\\n\n                                        <span class=\"small text-secondary\">Four</span>\\n\n                                    </span>\\n\n                                                            </span>\\n\n                        </span>\\n\n                                    </div>\\n\n            </div>\\n\n        </template>\\n\n    </span>\\n\n                                                                                </div>\\n\n\\n\n                        \\n\n                        \\n\n                        \\n\n                        \\n\n                                                    <form\\n\n                                id=\"vehicle-ro-create-1\"\\n\n                                x-show=\"activeRoVehicleId === 1\"\\n\n                                x-cloak\\n\n                                method=\"POST\"\\n\n                                action=\"http://localhost/app/customers/1/repair-orders/drafts\"\\n\n                                class=\"mt-3 pt-3 border-top\"\\n\n                            >\\n\n                                <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">                                <input type=\"hidden\" name=\"vehicle_id\" value=\"1\">\\n\n                                <label for=\"vehicle-ro-reason-1\" class=\"form-label\">Reason for visit</label>\\n\n                                <textarea\\n\n                                    id=\"vehicle-ro-reason-1\"\\n\n                                    name=\"visit_reason\"\\n\n                                    required\\n\n                                    rows=\"2\"\\n\n                                    placeholder=\"Why 2012 Chevrolet Tahoe LT is here\"\\n\n                                    class=\"form-control\"\\n\n                                ></textarea>\\n\n                                <div class=\"btn-list justify-content-end mt-2\">\\n\n                                    <button type=\"button\" class=\"btn\" x-on:click=\"activeRoVehicleId = null\">Cancel</button>\\n\n                                    <button type=\"submit\" class=\"btn btn-primary\">Create Estimate / RO</button>\\n\n                                </div>\\n\n                            </form>\\n\n                                            </div>\\n\n\\n\n                    <div class=\"card-footer\">\\n\n                        <div class=\"btn-list\" aria-label=\"Vehicle commands\">\\n\n                                                                                        <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    x-on:click=\"activeRoVehicleId = activeRoVehicleId === 1 ? null : 1\"\\n\n                                    :aria-expanded=\"(activeRoVehicleId === 1).toString()\"\\n\n                                    aria-controls=\"vehicle-ro-create-1\"\\n\n                                >\\n\n                                    Start RO\\n\n                                </button>\\n\n                            \\n\n                                                            <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn\"\\n\n                                    title=\"Open to edit vehicle\"\\n\n                                    x-on:click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'hub-vehicle', context: { vehicleId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                                >\\n\n                                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4\"/><path d=\"M13.5 6.5l4 4\"/></svg>\\n\n                                    Edit Vehicle\\n\n                                </button>\\n\n                                                                    <button\\n\n                                        type=\"button\"\\n\n                                        class=\"btn btn-ghost-danger\"\\n\n                                        x-show=\"pendingRemoveVehicleId !== 1\"\\n\n                                        x-on:click=\"pendingRemoveVehicleId = 1\"\\n\n                                    >\\n\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 7l16 0\"/><path d=\"M10 11l0 6\"/><path d=\"M14 11l0 6\"/><path d=\"M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12\"/><path d=\"M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3\"/></svg>\\n\n                                        Remove Vehicle\\n\n                                    </button>\\n\n                                                                                    </div>\\n\n\\n\n                                                                                    <form\\n\n                                    x-show=\"pendingRemoveVehicleId === 1\"\\n\n                                    x-cloak\\n\n                                    method=\"POST\"\\n\n                                    action=\"http://localhost/app/customers/1/vehicles/1\"\\n\n                                    class=\"mt-2 p-2 rounded border border-danger\"\\n\n                                >\\n\n                                    <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">                                    <input type=\"hidden\" name=\"_method\" value=\"DELETE\">                                    <div class=\"small fw-medium text-danger mb-2\">Remove 2012 Chevrolet Tahoe LT?</div>\\n\n                                    <div class=\"btn-list\">\\n\n                                        <button type=\"submit\" class=\"btn btn-danger\">Confirm Remove</button>\\n\n                                        <button type=\"button\" class=\"btn\" x-on:click=\"pendingRemoveVehicleId = null\">Cancel</button>\\n\n                                    </div>\\n\n                                </form>\\n\n                                                                        </div>\\n\n                </section>\\n\n                    </div>\\n\n    </div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'comms'\" x-cloak>\\n\n                            <div\\n\n    id=\"customer-communication\"\\n\n    x-data=\"arkCustomerHubComms(JSON.parse('{\\u0022initialFilter\\u0022:\\u0022all\\u0022,\\u0022counts\\u0022:{\\u0022all\\u0022:0,\\u0022call\\u0022:0,\\u0022text\\u0022:0,\\u0022email\\u0022:0,\\u0022portal\\u0022:0,\\u0022logged\\u0022:0},\\u0022customerId\\u0022:1,\\u0022updatesUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/hub-comms\\\\\\/updates\\u0022,\\u0022messagesListId\\u0022:\\u0022conversation-messages-relationship\\u0022}'))\"\\n\n    x-init=\"init()\"\\n\n>\\n\n    <div class=\"card-body border-bottom py-2\">\\n\n        <h3 class=\"card-title mb-0\">Communications</h3>\\n\n        <div class=\"text-secondary small\">One timeline for calls, text, and email - filter by type when you need to focus.</div>\\n\n        <div class=\"btn-list mt-2\" role=\"group\" aria-label=\"Communication type filters\">\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('all') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('all').toString()\"\\n\n                    x-on:click=\"setFilter('all')\"\\n\n                >All \u00b7 0</button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('call') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('call').toString()\"\\n\n                    x-on:click=\"setFilter('call')\"\\n\n                >Calls \u00b7 0</button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('text') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('text').toString()\"\\n\n                    x-on:click=\"setFilter('text')\"\\n\n                >Text \u00b7 0</button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"isActive('email') ? 'btn-primary' : ''\"\\n\n                    :aria-pressed=\"isActive('email').toString()\"\\n\n                    x-on:click=\"setFilter('email')\"\\n\n                >Email \u00b7 0</button>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n    <div\\n\n                                data-ark-workspace-dirty=\"off\"\\n\n                data-ark-conversation-composer\\n\n                                x-data=\"arkConversationQuickReply(JSON.parse('{\\u0022sendUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-messages\\u0022,\\u0022repairOrderId\\u0022:null,\\u0022sendEstimateUrl\\u0022:null,\\u0022cancelScheduledEstimateUrl\\u0022:null,\\u0022cancelScheduledSmsUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-actions\\\\\\/cancel-scheduled-sms\\u0022,\\u0022sendPaymentUrl\\u0022:null,\\u0022sendDepositUrl\\u0022:null,\\u0022sendInspectionUrl\\u0022:null,\\u0022messageActions\\u0022:[],\\u0022contextEstimateSend\\u0022:null,\\u0022contextPaymentSend\\u0022:null,\\u0022contextDepositSend\\u0022:null,\\u0022contextInspectionSend\\u0022:null,\\u0022estimateSchedule\\u0022:{\\u0022shop_is_open\\u0022:true,\\u0022pending\\u0022:null},\\u0022smsSchedule\\u0022:{\\u0022shop_is_open\\u0022:true,\\u0022next_open_morning_label\\u0022:\\u0022Wed Nov 25 \u00b7 8:00 AM\\u0022,\\u0022upcoming\\u0022:[{\\u0022scheduled_for\\u0022:\\u00222026-11-25T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Wed Nov 25 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-25\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-26T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Thu Nov 26 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-26\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-27T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Fri Nov 27 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-27\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-30T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Mon Nov 30 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-30\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-12-01T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Tue Dec 1 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-12-01\\u0022}],\\u0022pending\\u0022:null},\\u0022openRepairOrders\\u0022:[],\\u0022customerId\\u0022:1,\\u0022messagesListIds\\u0022:[\\u0022conversation-messages-relationship\\u0022],\\u0022hasConversationHistory\\u0022:false,\\u0022autoOpenComposer\\u0022:true,\\u0022alwaysOpen\\u0022:true,\\u0022keepOpenAfterSend\\u0022:true,\\u0022customerPhoneDisplay\\u0022:\\u0022(719) 555-0113\\u0022,\\u0022customerEmail\\u0022:\\u0022robert@example.test\\u0022,\\u0022estimateDelivery\\u0022:\\u0022email\\u0022,\\u0022paymentDelivery\\u0022:\\u0022email\\u0022,\\u0022depositDelivery\\u0022:\\u0022email\\u0022,\\u0022depositAmount\\u0022:\\u0022\\u0022,\\u0022canSmsEstimate\\u0022:false,\\u0022canEmailEstimate\\u0022:false,\\u0022canSmsPayment\\u0022:false,\\u0022canEmailPayment\\u0022:false,\\u0022canSmsDeposit\\u0022:false,\\u0022canEmailDeposit\\u0022:false,\\u0022canSmsInspection\\u0022:false,\\u0022showSmsComposer\\u0022:false,\\u0022sendEstimateAddVinUrl\\u0022:null,\\u0022nudgeKey\\u0022:null,\\u0022entityKey\\u0022:null,\\u0022initialBody\\u0022:null,\\u0022platformBacked\\u0022:false}'))\"\\n\n                class=\"border-bottom\"\\n\n            >\\n\n                \\n\n                                <div x-show=\"estimateSchedule?.pending\" x-cloak class=\"alert alert-info m-2 mb-0 py-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                        <div>\\n\n                            Scheduled estimate \u00b7 <span x-text=\"estimateSchedule?.pending?.scheduled_for_label ?? estimateSchedule?.next_open_morning_label ?? smsSchedule?.next_open_morning_label ?? 'Next open morning'\"></span>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"cancelScheduledEstimate()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"smsSchedule?.pending\" x-cloak class=\"alert alert-info m-2 mb-0 py-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                        <div>\\n\n                            Scheduled reply \u00b7 <span x-text=\"smsSchedule?.pending?.scheduled_for_label ?? smsSchedule?.next_open_morning_label ?? 'Next open morning'\"></span>\\n\n                            <span\\n\n                                x-show.important=\"smsSchedule?.pending?.preview\"\\n\n                                class=\"d-block text-secondary\"\\n\n                                x-text=\"smsSchedule?.pending?.preview\"\\n\n                            ></span>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"cancelScheduledSms()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"afterHoursPromptOpen\" x-cloak class=\"alert alert-warning m-2 mb-0 py-2\" role=\"alert\">\\n\n                    <div class=\"fw-bold\">It's after business hours.</div>\\n\n                    <div>\\n\n                        Send now, or schedule for\\n\n                        <span x-text=\"smsSchedule?.next_open_morning_label ?? 'next open morning'\"></span>?\\n\n                    </div>\\n\n                    <div class=\"btn-list mt-2\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"confirmAfterHoursTiming('now')\"\\n\n                        >Send Now</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-warning\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"confirmAfterHoursNextOpenMorning()\"\\n\n                        >Schedule</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-ghost-secondary\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"dismissAfterHoursPrompt()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div class=\"\" data-comms-composer-stack>\\n\n                    <div\\n\n                        class=\"d-flex flex-wrap align-items-center gap-2 px-3 py-2\"\\n\n                        role=\"group\"\\n\n                        aria-label=\"Conversation commands\"\\n\n                    >\\n\n                                                                            <a href=\"tel:+17195550113\" class=\"btn btn-sm\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                                Call\\n\n                            </a>\\n\n                                                                                                                                                                                                                                                                                                                                                    </div>\\n\n\\n\n                    <div x-show=\"vinWarningOpen\" x-cloak class=\"alert alert-warning mx-3 mb-2\" role=\"alert\" data-estimate-vin-warning>\\n\n                        <div class=\"fw-bold\">VIN missing</div>\\n\n                        <div>\\n\n                            Parts lookup, labor guides, service history accuracy, and OEM information may be affected.\\n\n                        </div>\\n\n                        <div class=\"btn-list mt-2\">\\n\n                            <a :href=\"addVinUrl()\" class=\"btn btn-sm\" @click=\"cancelVinWarning()\">Add VIN</a>\\n\n                            <button type=\"button\" class=\"btn btn-sm btn-primary\" @click=\"continueWithoutVin()\">Continue anyway</button>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div x-show=\"showSmsComposer && open\" x-cloak>\\n\n                        <div class=\"px-3 py-2 border-top\">\\n\n                            <label class=\"visually-hidden\" for=\"ark-composer-1-body\">Message</label>\\n\n                            <textarea\\n\n                                id=\"ark-composer-1-body\"\\n\n                                x-ref=\"replyBody\"\\n\n                                x-model=\"body\"\\n\n                                rows=\"2\"\\n\n                                                                placeholder=\"First text or MMS to (719) 555-0113\"\\n\n                                :placeholder=\"composerPlaceholder()\"\\n\n                                class=\"form-control\"\\n\n                                @keydown.meta.enter.prevent=\"send()\"\\n\n                                @keydown.ctrl.enter.prevent=\"send()\"\\n\n                            ></textarea>\\n\n                                                                                    <div x-show=\"error\" x-cloak class=\"mt-1 small text-danger fw-medium\" x-text=\"error\"></div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"error && ! open\" x-cloak class=\"alert alert-danger mx-3 mb-2\" role=\"alert\">\\n\n                    <div class=\"fw-bold\">Could not send</div>\\n\n                    <div x-text=\"error\"></div>\\n\n                </div>\\n\n            </div>\\n\n        \\n\n            \\n\n    <div id=\"conversation-messages-relationship\">\\n\n                    <div data-conversation-empty class=\"px-3 py-2 text-secondary small\">\\n\n                No communications recorded for this customer yet.\\n\n            </div>\\n\n        \\n\n            </div>\\n\n</div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'visits'\" x-cloak id=\"customer-timeline\">\\n\n                                                        <div class=\"card-body border-bottom py-2\">\\n\n                                <h3 class=\"card-title mb-0\">Service History</h3>\\n\n                                <div class=\"text-secondary small\">Every repair order for this customer, newest first.</div>\\n\n                            </div>\\n\n                            <div class=\"list-group list-group-flush\">\\n\n            <div class=\"list-group-item text-secondary\">No repair orders yet.</div>\\n\n    </div>\\n\n                        </div>\\n\n\\n\n                        <div x-show=\"tab === 'documents'\" x-cloak>\\n\n                            <div id=\"customer-documents\">\\n\n    <div class=\"card-body border-bottom py-2 d-flex flex-wrap align-items-center gap-2\">\\n\n        <div class=\"me-auto\">\\n\n            <h3 class=\"card-title mb-0\">Documents</h3>\\n\n            <div class=\"text-secondary small\">Warranty contracts, registration, outside invoices, alignment sheets - paperwork for this customer.</div>\\n\n        </div>\\n\n                    <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-primary\"\\n\n                x-on:click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'hub-document', invokeEl: $event.currentTarget } }))\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M5 12l14 0\"/></svg>\\n\n                Add Document\\n\n            </button>\\n\n            </div>\\n\n\\n\n            <div class=\"card-body text-secondary\">No documents for this customer yet.</div>\\n\n    </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n    </div>\\n\n</div>\\n\n    </div>\\n\n\\n\n    <div\\n\n    \\n\n    id=\"workspace-modal-host\"\\n\n    data-workspace-modal-open=\"0\"\\n\n    x-data=\"arkWorkspaceModal({\\n\n        initialTask: null,\\n\n        initialContext: [],\\n\n    })\"\\n\n    @keydown.escape.window=\"onEscape()\"\\n\n    @keydown.tab=\"trapFocus($event)\"\\n\n>\\n\n    <div x-show=\"open\" x-cloak data-workspace-modal-overlay>\\n\n        <div class=\"modal-backdrop show\" data-workspace-modal-static-backdrop></div>\\n\n        <div\\n\n            class=\"modal d-block\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            data-bs-backdrop=\"static\"\\n\n            data-bs-keyboard=\"false\"\\n\n            :aria-labelledby=\"open ? 'ops-workspace-modal-title' : null\"\\n\n            @keydown.escape.stop=\"onEscape()\"\\n\n        >\\n\n            <div\\n\n                x-ref=\"dialog\"\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header\">\\n\n                        <div class=\"overflow-hidden\">\\n\n                            <h2 id=\"ops-workspace-modal-title\" class=\"modal-title\" x-text=\"title()\"></h2>\\n\n                            <div class=\"small text-secondary\" x-show=\"helper()\" x-text=\"helper()\"></div>\\n\n                        </div>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close\" :disabled=\"saving || saved\" @click=\"requestClose()\"></button>\\n\n                    </div>\\n\n\\n\n                    <div id=\"workspace-modal-body\" class=\"modal-body\">\\n\n                        <div data-workspace-modal-panel x-show=\"task === 'hub-customer'\" x-cloak>\\n\n        <form\\n\n            method=\"POST\"\\n\n            action=\"http://localhost/app/customers/1\"\\n\n            data-workspace-modal-form=\"hub-customer\"\\n\n        >\\n\n            <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <div class=\"row g-3\">\\n\n                <div class=\"col-md-6\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-first-name\">First name</label>\\n\n                    <input id=\"hub-customer-first-name\" name=\"first_name\" value=\"Robert\" required class=\"form-control\">\\n\n                                    </div>\\n\n                <div class=\"col-md-6\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-last-name\">Last name</label>\\n\n                    <input id=\"hub-customer-last-name\" name=\"last_name\" value=\"Kim\" required class=\"form-control\">\\n\n                                    </div>\\n\n                <div class=\"col-md-6\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-phone\">Phone</label>\\n\n                    <input id=\"hub-customer-phone\" name=\"phone\" value=\"7195550113\" class=\"form-control\">\\n\n                                    </div>\\n\n                <div class=\"col-md-6\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-email\">Email</label>\\n\n                    <input id=\"hub-customer-email\" name=\"email\" value=\"robert@example.test\" type=\"email\" class=\"form-control\">\\n\n                                    </div>\\n\n                <div class=\"col-md-6\">\\n\n                    <label for=\"hub-customer-contact-preference\" class=\"form-label\">\\n\n    Preferred contact\\n\n    <select\\n\n        id=\"hub-customer-contact-preference\"\\n\n        name=\"contact_preference\"\\n\n        class=\"form-select mt-2\"\\n\n            >\\n\n        <option value=\"\"  selected >Not set</option>\\n\n                    <option value=\"text\"   >\\n\n                Text me\\n\n            </option>\\n\n                    <option value=\"call\"   >\\n\n                Call me\\n\n            </option>\\n\n                    <option value=\"email\"   >\\n\n                Email me\\n\n            </option>\\n\n            </select>\\n\n</label>\\n\n                                    </div>\\n\n                <div class=\"col-12\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-messenger-psid\">Messenger PSID</label>\\n\n                    <input id=\"hub-customer-messenger-psid\" name=\"messenger_psid\" value=\"\" autocomplete=\"off\" class=\"form-control\">\\n\n                                    </div>\\n\n                <div class=\"col-12\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-type\">Billing class</label>\\n\n                                        <select id=\"hub-customer-type\" name=\"billing_class_key\" class=\"form-select\">\\n\n                                                    <option value=\"retail\" selected>Retail</option>\\n\n                                                    <option value=\"fleet\" >Fleet</option>\\n\n                                                    <option value=\"warranty\" >Warranty</option>\\n\n                                                    <option value=\"repairpal\" >RepairPal</option>\\n\n                                                    <option value=\"internal\" >Internal</option>\\n\n                                                    <option value=\"wholesale\" >Wholesale</option>\\n\n                                                    <option value=\"comeback\" >Comeback</option>\\n\n                                                    <option value=\"business\" >Business</option>\\n\n                                                    <option value=\"military\" >Military</option>\\n\n                                            </select>\\n\n                                                        </div>\\n\n                <div class=\"col-12\">\\n\n                    <label class=\"form-label\" for=\"hub-overpayment-disposition\">Overpayment default</label>\\n\n                    <select\\n\n                        id=\"hub-overpayment-disposition\"\\n\n                        name=\"overpayment_disposition_default\"\\n\n                        class=\"form-select\"\\n\n                    >\\n\n                                                    <option value=\"ask\" selected>\\n\n                                Ask every time\\n\n                            </option>\\n\n                                                    <option value=\"keep_credit\" >\\n\n                                Keep as account credit\\n\n                            </option>\\n\n                                                    <option value=\"return_change\" >\\n\n                                Return excess when possible\\n\n                            </option>\\n\n                                            </select>\\n\n                    <div class=\"form-hint\">When a payment exceeds selected invoices, ask staff, keep account credit, or return excess when possible. Staff can override on each payment.</div>\\n\n                                    </div>\\n\n                <div class=\"col-12\">\\n\n                    <label class=\"form-label\" for=\"hub-customer-notes\">Notes</label>\\n\n                    <textarea id=\"hub-customer-notes\" name=\"notes\" rows=\"8\" class=\"form-control font-monospace\"></textarea>\\n\n                                    </div>\\n\n            </div>\\n\n        </form>\\n\n    </div>\\n\n\\n\n            <div\\n\n            data-workspace-modal-panel\\n\n            x-show=\"task === 'hub-vehicle' && String(context.vehicleId) === '1'\"\\n\n            x-cloak\\n\n        >\\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/customers/1/vehicles/1\"\\n\n                data-workspace-modal-form=\"hub-vehicle\"\\n\n                x-data=\"arkVehicleDecode(JSON.parse('{\\u0022decodeUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/vehicles\\\\\\/decode-vin\\u0022,\\u0022csrfToken\\u0022:\\u0022pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\\u0022}'))\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                <div class=\"row g-3\">\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-vin\">VIN</label>\\n\n        <div class=\"input-group\">\\n\n            <input id=\"hub-vehicle-1-vin\" name=\"vin\" value=\"1GNSKCE07CR040404\" maxlength=\"17\" autocomplete=\"off\" autocapitalize=\"characters\" class=\"form-control font-monospace\" />\\n\n            <button type=\"button\" @click=\"decode($event)\" :disabled=\"decoding\" class=\"btn\">\\n\n                <span x-show=\"!decoding\">Decode VIN</span>\\n\n                <span x-show=\"decoding\" x-cloak>Decoding\u2026</span>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-plate\">Plate</label>\\n\n        <div class=\"input-group\">\\n\n            <input id=\"hub-vehicle-1-plate\" name=\"plate\" value=\"MLT404\" autocomplete=\"off\" autocapitalize=\"characters\" class=\"form-control\" />\\n\n            <input name=\"plate_state\" value=\"CO\" maxlength=\"32\" autocomplete=\"off\" autocapitalize=\"characters\" aria-label=\"Plate state\" size=\"3\" class=\"form-control flex-grow-0 w-auto\" />\\n\n            <button type=\"button\" @click=\"decodePlate($event)\" :disabled=\"decoding\" class=\"btn\">\\n\n                <span x-show=\"!decoding\">Decode plate</span>\\n\n                <span x-show=\"decoding\" x-cloak>Decoding\u2026</span>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n    <div class=\"col-12\" x-show=\"message\" x-cloak>\\n\n        <div x-text=\"message\" class=\"small fw-medium\" :class=\"messageIsError ? 'text-danger' : 'text-secondary'\"></div>\\n\n    </div>\\n\n    <div class=\"col-4\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-year\">Year</label>\\n\n        <input id=\"hub-vehicle-1-year\" name=\"year\" value=\"2012\" inputmode=\"numeric\" class=\"form-control\" />\\n\n            </div>\\n\n    <div class=\"col-8 col-sm-4\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-make\">Make</label>\\n\n        <input id=\"hub-vehicle-1-make\" name=\"make\" value=\"Chevrolet\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n            </div>\\n\n    <div class=\"col-12 col-sm-4\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-model\">Model</label>\\n\n        <input id=\"hub-vehicle-1-model\" name=\"model\" value=\"Tahoe\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n            </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-trim\">Trim</label>\\n\n        <input id=\"hub-vehicle-1-trim\" name=\"trim\" value=\"LT\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-engine\">Engine</label>\\n\n        <input id=\"hub-vehicle-1-engine\" name=\"engine\" value=\"5.3L V8\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-drive\">Drive</label>\\n\n        <input id=\"hub-vehicle-1-drive\" name=\"drive\" value=\"4WD/4-Wheel Drive/4x4\" placeholder=\"AWD, FWD, 4WD\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-transmission\">Transmission</label>\\n\n        <input id=\"hub-vehicle-1-transmission\" name=\"transmission\" value=\"Automatic\" placeholder=\"Automatic, Manual\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-color\">Color</label>\\n\n        <input id=\"hub-vehicle-1-color\" name=\"color\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-nickname\">Tag / nickname</label>\\n\n        <input id=\"hub-vehicle-1-nickname\" name=\"nickname\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-public-notes\">Public notes</label>\\n\n        <input id=\"hub-vehicle-1-public-notes\" name=\"public_notes\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-1-private-notes\">Private notes</label>\\n\n        <input id=\"hub-vehicle-1-private-notes\" name=\"private_notes\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n</div>\\n\n            </form>\\n\n        </div>\\n\n    \\n\n    <div data-workspace-modal-panel x-show=\"task === 'hub-vehicle-create'\" x-cloak>\\n\n        <form\\n\n            method=\"POST\"\\n\n            action=\"http://localhost/app/customers/1/vehicles\"\\n\n            data-workspace-modal-form=\"hub-vehicle-create\"\\n\n            x-data=\"arkVehicleDecode(JSON.parse('{\\u0022decodeUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/vehicles\\\\\\/decode-vin\\u0022,\\u0022csrfToken\\u0022:\\u0022pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\\u0022}'))\"\\n\n        >\\n\n            <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">            <div class=\"row g-3\">\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-vin\">VIN</label>\\n\n        <div class=\"input-group\">\\n\n            <input id=\"hub-vehicle-new-vin\" name=\"vin\" value=\"\" maxlength=\"17\" autocomplete=\"off\" autocapitalize=\"characters\" class=\"form-control font-monospace\" />\\n\n            <button type=\"button\" @click=\"decode($event)\" :disabled=\"decoding\" class=\"btn\">\\n\n                <span x-show=\"!decoding\">Decode VIN</span>\\n\n                <span x-show=\"decoding\" x-cloak>Decoding\u2026</span>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-plate\">Plate</label>\\n\n        <div class=\"input-group\">\\n\n            <input id=\"hub-vehicle-new-plate\" name=\"plate\" value=\"\" autocomplete=\"off\" autocapitalize=\"characters\" class=\"form-control\" />\\n\n            <input name=\"plate_state\" value=\"\" maxlength=\"32\" autocomplete=\"off\" autocapitalize=\"characters\" aria-label=\"Plate state\" size=\"3\" class=\"form-control flex-grow-0 w-auto\" />\\n\n            <button type=\"button\" @click=\"decodePlate($event)\" :disabled=\"decoding\" class=\"btn\">\\n\n                <span x-show=\"!decoding\">Decode plate</span>\\n\n                <span x-show=\"decoding\" x-cloak>Decoding\u2026</span>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n    <div class=\"col-12\" x-show=\"message\" x-cloak>\\n\n        <div x-text=\"message\" class=\"small fw-medium\" :class=\"messageIsError ? 'text-danger' : 'text-secondary'\"></div>\\n\n    </div>\\n\n    <div class=\"col-4\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-year\">Year</label>\\n\n        <input id=\"hub-vehicle-new-year\" name=\"year\" value=\"\" inputmode=\"numeric\" class=\"form-control\" />\\n\n            </div>\\n\n    <div class=\"col-8 col-sm-4\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-make\">Make</label>\\n\n        <input id=\"hub-vehicle-new-make\" name=\"make\" value=\"\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n            </div>\\n\n    <div class=\"col-12 col-sm-4\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-model\">Model</label>\\n\n        <input id=\"hub-vehicle-new-model\" name=\"model\" value=\"\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n            </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-trim\">Trim</label>\\n\n        <input id=\"hub-vehicle-new-trim\" name=\"trim\" value=\"\" class=\"form-control\" @blur=\"normalizeField($event)\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-engine\">Engine</label>\\n\n        <input id=\"hub-vehicle-new-engine\" name=\"engine\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-drive\">Drive</label>\\n\n        <input id=\"hub-vehicle-new-drive\" name=\"drive\" value=\"\" placeholder=\"AWD, FWD, 4WD\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-transmission\">Transmission</label>\\n\n        <input id=\"hub-vehicle-new-transmission\" name=\"transmission\" value=\"\" placeholder=\"Automatic, Manual\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-color\">Color</label>\\n\n        <input id=\"hub-vehicle-new-color\" name=\"color\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-sm-6\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-nickname\">Tag / nickname</label>\\n\n        <input id=\"hub-vehicle-new-nickname\" name=\"nickname\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-public-notes\">Public notes</label>\\n\n        <input id=\"hub-vehicle-new-public-notes\" name=\"public_notes\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n    <div class=\"col-12\">\\n\n        <label class=\"form-label\" for=\"hub-vehicle-new-private-notes\">Private notes</label>\\n\n        <input id=\"hub-vehicle-new-private-notes\" name=\"private_notes\" value=\"\" class=\"form-control\" />\\n\n    </div>\\n\n</div>\\n\n        </form>\\n\n    </div>\\n\n\\n\n    <div data-workspace-modal-panel x-show=\"task === 'hub-document'\" x-cloak>\\n\n        <div\\n\n    data-add-document-panel\\n\n    x-data=\"arkDocumentAdd({\\n\n        initialMode: null,\\n\n        attachable: [],\\n\n    })\"\\n\n>\\n\n    <div x-show=\"! mode\">\\n\n        <div class=\"list-group\">\\n\n            <button type=\"button\" class=\"list-group-item list-group-item-action\" @click=\"choose('scan')\">\\n\n                <div class=\"fw-bold\">Scan Document</div>\\n\n                <div class=\"text-secondary small\">Capture pages with the camera into one PDF.</div>\\n\n            </button>\\n\n            <button type=\"button\" class=\"list-group-item list-group-item-action\" @click=\"choose('upload')\">\\n\n                <div class=\"fw-bold\">Upload PDF / File</div>\\n\n                <div class=\"text-secondary small\">Add a downloaded or scanned PDF, JPG, or PNG.</div>\\n\n            </button>\\n\n                    </div>\\n\n    </div>\\n\n\\n\n    <div x-show=\"mode === 'upload'\" x-cloak>\\n\n        <button type=\"button\" class=\"btn btn-link px-0 mb-2\" @click=\"back()\">\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n            Back\\n\n        </button>\\n\n        <form method=\"POST\" action=\"http://localhost/app/customers/1/documents\" enctype=\"multipart/form-data\" data-workspace-modal-form=\"document-upload\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_document_mode\" value=\"upload\">\\n\n                        <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-file\">File</label>\\n\n                <input id=\"document-file\" name=\"file\" type=\"file\" required accept=\"application/pdf,image/jpeg,image/png,image/heic,image/heif,.pdf,.jpg,.jpeg,.png,.heic\" class=\"form-control\">\\n\n                <div class=\"form-hint\">PDF, JPG, PNG, or HEIC \u00b7 max 25 MB</div>\\n\n            </div>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-title\">Document name</label>\\n\n                <input id=\"document-title\" name=\"title\" type=\"text\" required maxlength=\"255\" value=\"\" class=\"form-control\" placeholder=\"ASC Vehicle Protection Plan\">\\n\n            </div>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-type\">Type</label>\\n\n                <select id=\"document-type\" name=\"type\" required class=\"form-select\">\\n\n                    <option value=\"general\" selected>General</option>\\n\n    <option value=\"service_record\" >Service Record</option>\\n\n    <option value=\"warranty\" >Warranty / Protection Plan</option>\\n\n    <option value=\"registration\" >Registration</option>\\n\n    <option value=\"insurance\" >Insurance</option>\\n\n    <option value=\"outside_invoice\" >Outside Invoice / Receipt</option>\\n\n    <option value=\"alignment\" >Alignment / Measurement</option>\\n\n    <option value=\"authorization\" >Authorization</option>\\n\n    <option value=\"diagnostic_report\" >Diagnostic Report</option>\\n\n    <option value=\"other\" >Other</option>\\n\n                </select>\\n\n            </div>\\n\n                            <div class=\"mb-3\">\\n\n                    <label class=\"form-label\" for=\"document-ro\">Attach to repair order (optional)</label>\\n\n                    <select id=\"document-ro\" name=\"repair_order_id\" class=\"form-select\">\\n\n                        <option value=\"\">Customer only</option>\\n\n                                            </select>\\n\n                </div>\\n\n                        <button type=\"submit\" class=\"btn btn-primary\">Save Document</button>\\n\n        </form>\\n\n    </div>\\n\n\\n\n    <div x-show=\"mode === 'scan'\" x-cloak>\\n\n        <button type=\"button\" class=\"btn btn-link px-0 mb-2\" @click=\"back()\">\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n            Back\\n\n        </button>\\n\n        <form method=\"POST\" action=\"http://localhost/app/customers/1/documents/scan\" enctype=\"multipart/form-data\" data-workspace-modal-form=\"document-scan\" @submit=\"prepareScanSubmit($event)\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_document_mode\" value=\"scan\">\\n\n                        <div class=\"card card-sm mb-3\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"btn-list\">\\n\n                        <label class=\"btn btn-outline-primary mb-0\">\\n\n                            Capture Page\\n\n                            <input type=\"file\" accept=\"image/*\" capture=\"environment\" class=\"visually-hidden\" @change=\"addFiles($event.target.files); $event.target.value = ''\">\\n\n                        </label>\\n\n                        <label class=\"btn mb-0\">\\n\n                            Add from Photos\\n\n                            <input type=\"file\" accept=\"image/*\" multiple class=\"visually-hidden\" @change=\"addFiles($event.target.files); $event.target.value = ''\">\\n\n                        </label>\\n\n                    </div>\\n\n                    <div class=\"form-hint mt-2\">Pages become one PDF when you save.</div>\\n\n                </div>\\n\n            </div>\\n\n            <ul class=\"list-group mb-3\" x-show=\"pages.length > 0\">\\n\n                <template x-for=\"(page, index) in pages\" :key=\"page.id\">\\n\n                    <li class=\"list-group-item d-flex align-items-center gap-2\">\\n\n                        <img :src=\"page.url\" alt=\"\" class=\"rounded object-fit-cover\" style=\"width: 2.75rem; height: 3.5rem\">\\n\n                        <div class=\"flex-fill\">\\n\n                            <div class=\"fw-medium\" x-text=\"'Page ' + (index + 1)\"></div>\\n\n                            <div class=\"btn-list mt-1\">\\n\n                                <button type=\"button\" class=\"btn btn-sm btn-ghost-secondary\" @click=\"movePage(page.id, -1)\">Up</button>\\n\n                                <button type=\"button\" class=\"btn btn-sm btn-ghost-secondary\" @click=\"movePage(page.id, 1)\">Down</button>\\n\n                                <button type=\"button\" class=\"btn btn-sm btn-ghost-danger\" @click=\"removePage(page.id)\">Remove</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </li>\\n\n                </template>\\n\n            </ul>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-scan-title\">Document name</label>\\n\n                <input id=\"document-scan-title\" name=\"title\" type=\"text\" required maxlength=\"255\" value=\"\" class=\"form-control\" placeholder=\"Warranty contract\">\\n\n            </div>\\n\n            <div class=\"mb-3\">\\n\n                <label class=\"form-label\" for=\"document-scan-type\">Type</label>\\n\n                <select id=\"document-scan-type\" name=\"type\" required class=\"form-select\">\\n\n                    <option value=\"general\" >General</option>\\n\n    <option value=\"service_record\" >Service Record</option>\\n\n    <option value=\"warranty\" selected>Warranty / Protection Plan</option>\\n\n    <option value=\"registration\" >Registration</option>\\n\n    <option value=\"insurance\" >Insurance</option>\\n\n    <option value=\"outside_invoice\" >Outside Invoice / Receipt</option>\\n\n    <option value=\"alignment\" >Alignment / Measurement</option>\\n\n    <option value=\"authorization\" >Authorization</option>\\n\n    <option value=\"diagnostic_report\" >Diagnostic Report</option>\\n\n    <option value=\"other\" >Other</option>\\n\n                </select>\\n\n            </div>\\n\n                            <div class=\"mb-3\">\\n\n                    <label class=\"form-label\" for=\"document-scan-ro\">Attach to repair order (optional)</label>\\n\n                    <select id=\"document-scan-ro\" name=\"repair_order_id\" class=\"form-select\">\\n\n                        <option value=\"\">Customer only</option>\\n\n                                            </select>\\n\n                </div>\\n\n                        <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"pages.length === 0\">Save Document</button>\\n\n        </form>\\n\n    </div>\\n\n\\n\n    </div>\\n\n    </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"modal-footer flex-wrap\">\\n\n                        <div class=\"alert alert-danger w-100 mb-2\" x-show=\"validationMessage\" x-cloak x-text=\"validationMessage\" role=\"alert\"></div>\\n\n                        <div class=\"me-auto\">\\n\n                            <template x-if=\"showDelete()\">\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn\"\\n\n                                    :class=\"deleteConfirm ? 'btn-danger' : 'btn-outline-danger'\"\\n\n                                    :disabled=\"saving || saved\"\\n\n                                    :aria-label=\"deleteConfirm ? `Confirm delete within ${deleteConfirmSeconds} seconds` : 'Delete line'\"\\n\n                                    @click=\"armOrSubmitDelete()\"\\n\n                                    x-text=\"deleteLabel()\"\\n\n                                ></button>\\n\n                            </template>\\n\n                        </div>\\n\n                        <button type=\"button\" class=\"btn\" :disabled=\"saving || saved\" @click=\"requestClose()\">Cancel</button>\\n\n                        <button type=\"button\" class=\"btn\" x-show=\"showSaveAndRewrite()\" x-cloak :disabled=\"saving || saved\" @click=\"submitPrimaryAndRewrite()\">Save &amp; Generate</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn\"\\n\n                            x-ref=\"primaryBtn\"\\n\n                            x-show=\"showPrimary()\"\\n\n                            :disabled=\"saving || saved\"\\n\n                            :class=\"saved ? 'btn-success' : 'btn-primary'\"\\n\n                            @click=\"submitPrimary()\"\\n\n                        >\\n\n                            <span x-show=\"! saving && ! saved\" x-text=\"primaryLabel()\"></span>\\n\n                            <span x-show=\"saving\" x-cloak>Saving\u2026</span>\\n\n                            <span x-show=\"saved\" x-cloak>\u2713 Saved</span>\\n\n                        </button>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"pvhipqKDPRru4a4qYsFKMBEjUVtYF3pax6UI9ttx\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox\",\"disabled_reason\":null},{\"id\":\"nav.reports\",\"title\":\"Reports\",\"group\":\"Navigate\",\"keywords\":[\"reports\",\"end of day\",\"operational\"],\"url\":\"http:\\/\\/localhost\\/app\\/reports\",\"disabled_reason\":null},{\"id\":\"create.repair-order\",\"title\":\"New Repair Order\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"ro\",\"repair\",\"intake\",\"check in\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.customer\",\"title\":\"New Customer\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"customer\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.vehicle\",\"title\":\"New Vehicle\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"vehicle\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.appointment\",\"title\":\"New Appointment\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"appointment\",\"schedule\"],\"url\":\"http:\\/\\/localhost\\/app\\/appointments\\/create\",\"disabled_reason\":null},{\"id\":\"create.message\",\"title\":\"New Message\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"message\",\"text\",\"sms\",\"email\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose\",\"disabled_reason\":null},{\"id\":\"create.sms\",\"title\":\"New SMS\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"sms\",\"text\",\"phone\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=sms\",\"disabled_reason\":null},{\"id\":\"create.email\",\"title\":\"New Email\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"email\",\"mail\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=email\",\"disabled_reason\":null},{\"id\":\"search.customer\",\"title\":\"Search Customers\",\"group\":\"Search\",\"keywords\":[\"search\",\"customer\",\"phone\",\"name\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.vehicle\",\"title\":\"Search Vehicles\",\"group\":\"Search\",\"keywords\":[\"search\",\"vehicle\",\"vin\",\"plate\",\"license\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.vin\",\"title\":\"Search by VIN\",\"group\":\"Search\",\"keywords\":[\"search\",\"vin\",\"vehicle\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.plate\",\"title\":\"Search by License Plate\",\"group\":\"Search\",\"keywords\":[\"search\",\"plate\",\"license\",\"tag\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.phone\",\"title\":\"Search by Phone\",\"group\":\"Search\",\"keywords\":[\"search\",\"phone\",\"customer\",\"number\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.repair-order\",\"title\":\"Search Repair Orders\",\"group\":\"Search\",\"keywords\":[\"search\",\"ro\",\"repair\",\"order\",\"number\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.estimate\",\"title\":\"Search Estimates\",\"group\":\"Search\",\"keywords\":[\"search\",\"estimate\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.invoice\",\"title\":\"Search Invoices\",\"group\":\"Search\",\"keywords\":[\"search\",\"invoice\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"ops.print-key-tag\",\"title\":\"Print Key Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"key\",\"tag\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-oil-sticker\",\"title\":\"Print Oil Sticker\",\"group\":\"Operations\",\"keywords\":[\"print\",\"oil\",\"sticker\",\"change\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-service-tag\",\"title\":\"Print Service Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"service\",\"tag\",\"tech\",\"sheet\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.take-payment\",\"title\":\"Take Payment\",\"group\":\"Operations\",\"keywords\":[\"payment\",\"pay\",\"square\",\"collect\",\"balance\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.record-deposit\",\"title\":\"Record Deposit\",\"group\":\"Operations\",\"keywords\":[\"deposit\",\"payment\",\"record\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.open-active-ro\",\"title\":\"Open Active RO\",\"group\":\"Operations\",\"keywords\":[\"active\",\"ro\",\"open\",\"workboard\",\"repair\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null}]</script>\\n\n        <div class=\"modal d-block\" tabindex=\"-1\">\\n\n            <div class=\"modal-backdrop show z-0\" data-ops-global-search-backdrop></div>\\n\n            <div\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable\"\\n\n                data-ops-global-search-dialog\\n\n                role=\"dialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-label=\"Command palette\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header p-2\">\\n\n                        <label class=\"visually-hidden\" for=\"ops-global-search-input\">Search commands and records</label>\\n\n                        <div class=\"input-icon w-100\">\\n\n                            <span class=\"input-icon-addon\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                            </span>\\n\n                            <input\\n\n                                id=\"ops-global-search-input\"\\n\n                                type=\"search\"\\n\n                                class=\"form-control form-control-lg\"\\n\n                                data-ops-global-search-input\\n\n                                placeholder=\"Type a command or search\u2026\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"modal-body p-0\">\\n\n                        <div class=\"list-group list-group-flush\" data-ops-global-search-results>\\n\n                            <div class=\"list-group-item small text-secondary\">\u2318K \u00b7 Enter runs \u00b7 Esc closes</div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <div\\n\n    x-data=\"arkLearnGuideModal()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ark-learn-guide-modal\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"title || 'ARKademy guide'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close guide preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header align-items-start\">\\n\n                    <div class=\"overflow-hidden\">\\n\n                        <div class=\"subheader\" x-show=\"sectionLabel\" x-text=\"sectionLabel\"></div>\\n\n                        <h2 class=\"modal-title\" x-text=\"title || 'ARKademy'\"></h2>\\n\n                        <div class=\"small text-secondary\" x-show=\"summary\" x-text=\"summary\"></div>\\n\n                    </div>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"close()\" aria-label=\"Close\"></button>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-body\">\\n\n                    <div class=\"text-secondary\" x-show=\"loading\">\\n\n                        <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading guide\u2026\\n\n                    </div>\\n\n                    <div class=\"alert alert-danger mb-0\" role=\"alert\" x-show=\"error\" x-text=\"error\"></div>\\n\n                    \\n\n                    <div\\n\n                        class=\"ark-legacy bg-white text-dark rounded p-3 ops-learn-prose ops-learn-guide-modal__prose\"\\n\n                        x-show=\"! loading && ! error && html\"\\n\n                        x-html=\"html\"\\n\n                    ></div>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-footer\">\\n\n                                            <div class=\"small text-secondary me-auto\">Preview from ARK - open ARKademy for search, print, and full navigation.</div>\\n\n                                        <button type=\"button\" class=\"btn\" @click=\"close()\">Close</button>\\n\n                                            <a\\n\n                            :href=\"arkademyUrl\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-primary\"\\n\n                            x-show=\"arkademyUrl\"\\n\n                        >\\n\n                            Open in ARKademy\\n\n                        </a>\\n\n                                    </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n    <div x-data=\"arkCommsInterrupt()\" data-ark-comms-interrupt data-conversation-url-template=\"http://localhost/app/communications/inbox?conversation=__CONVERSATION__\" data-waiting-url=\"http://localhost/app/communications/inbox?filter=needs\">\\n\n        <div x-show=\"activeCall !== null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"callInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeCall\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-green\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"d-flex align-items-start gap-2\">\\n\n                                    <div class=\"flex-fill overflow-hidden\">\\n\n                                        <div class=\"small fw-bold text-uppercase text-green\" x-text=\"callEyebrow()\"></div>\\n\n                                        <template x-if=\"activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0 text-truncate\" x-text=\"activeCall.customer_name\"></div>\\n\n                                        </template>\\n\n                                        <template x-if=\"! activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0\">Unknown Caller</div>\\n\n                                        </template>\\n\n                                        <div class=\"text-secondary\" x-text=\"activeCall.display_phone\"></div>\\n\n                                        <template x-if=\"activeCall.owned_by_name\">\\n\n                                            <div class=\"small text-secondary mt-1\" x-text=\"ownerLabel()\"></div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                    <button type=\"button\" class=\"btn btn-sm\" @click=\"dismissCall()\">Dismiss</button>\\n\n                                </div>\\n\n\\n\n                                <template x-if=\"activeCall.matched\">\\n\n                                    <div class=\"mt-2\">\\n\n                                        <div class=\"small fw-medium text-truncate\" x-text=\"vehicleSummary()\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"openRoSummary()\"></div>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeCall.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeCall.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeCall.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeCall.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall.matched && previewOpenRos().length > 0\">\\n\n                                    <div class=\"list-group mt-2\">\\n\n                                        <template x-for=\"openRepairOrder in previewOpenRos()\" :key=\"openRepairOrder.repair_order_id\">\\n\n                                            <a\\n\n                                                :href=\"openRepairOrder.url\"\\n\n                                                class=\"list-group-item list-group-item-action d-flex align-items-center gap-2 small\"\\n\n                                                @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                            >\\n\n                                                <span class=\"fw-bold text-nowrap\" x-text=\"'RO #' + openRepairOrder.repair_order_id\"></span>\\n\n                                                <span class=\"flex-fill text-truncate text-secondary\" x-text=\"openRepairOrder.vehicle_name\"></span>\\n\n                                                <span class=\"text-secondary text-nowrap\" x-text=\"openRepairOrder.status_label\"></span>\\n\n                                            </a>\\n\n                                        </template>\\n\n                                        <template x-if=\"extraOpenRoCount() > 0 && activeCall.customer_url\">\\n\n                                            <a :href=\"activeCall.customer_url\" class=\"list-group-item list-group-item-action small\" @click=\"markCallHandledForId(activeCall.call_session_id)\">\\n\n                                                +<span x-text=\"extraOpenRoCount()\"></span> more on Customer Hub\\n\n                                            </a>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"lastConversationSnippet()\">\\n\n                                    <p class=\"small text-secondary mt-2 mb-0\" x-text=\"lastConversationSnippet()\"></p>\\n\n                                </template>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther() && activeCall.show_callback_action\"\\n\n                                    type=\"button\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"window.arkInitiateTelephonyCallback?.({\\n\n                                        customerId: activeCall.callback_customer_id,\\n\n                                        phone: activeCall.callback_phone,\\n\n                                        callSessionId: activeCall.call_session_id,\\n\n                                        button: $event.currentTarget,\\n\n                                    }); activeCall = null;\"\\n\n  