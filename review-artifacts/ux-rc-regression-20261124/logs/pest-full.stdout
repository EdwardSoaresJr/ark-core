.classList.toggle('dark', isDark);\\n\n            document.documentElement.setAttribute('data-bs-theme', resolved);\\n\n            document.documentElement.style.colorScheme = resolved;\\n\n            // Legacy key kept as last-resolved paint hint only \u2014 never the preference authority.\\n\n            try {\\n\n                localStorage.setItem('ark_theme', resolved);\\n\n                localStorage.removeItem('hs_theme');\\n\n            } catch (_) {}\\n\n        };\\n\n\\n\n        apply(resolve());\\n\n\\n\n        if (preference === 'system') {\\n\n            const onChange = () => apply(resolve());\\n\n            if (typeof media.addEventListener === 'function') {\\n\n                media.addEventListener('change', onChange);\\n\n            } else if (typeof media.addListener === 'function') {\\n\n                media.addListener(onChange);\\n\n            }\\n\n        }\\n\n\\n\n        window.arkApplyDisplayThemePreference = (nextPreference) => {\\n\n            const next = nextPreference === 'dark' || nextPreference === 'light' || nextPreference === 'system'\\n\n                ? nextPreference\\n\n                : 'light';\\n\n            const resolved = next === 'system'\\n\n                ? (media.matches ? 'dark' : 'light')\\n\n                : next;\\n\n            document.documentElement.setAttribute('data-ark-display-theme-preference', next);\\n\n            apply(resolved);\\n\n        };\\n\n\\n\n        document.documentElement.setAttribute('data-ark-display-theme-preference', preference);\\n\n\\n\n        window.arkToggleTheme = () => {\\n\n            const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';\\n\n            window.arkApplyDisplayThemePreference(nextTheme);\\n\n\\n\n            const token = document.querySelector('meta[name=\"csrf-token\"]')?.content;\\n\n            const url = \"http:\\/\\/localhost\\/app\\/profile\\/display-theme\";\\n\n            if (!token || !url) {\\n\n                return;\\n\n            }\\n\n\\n\n            fetch(url, {\\n\n                method: 'PATCH',\\n\n                headers: {\\n\n                    'Content-Type': 'application/json',\\n\n                    Accept: 'application/json',\\n\n                    'X-CSRF-TOKEN': token,\\n\n                },\\n\n                body: JSON.stringify({ display_theme: nextTheme }),\\n\n                credentials: 'same-origin',\\n\n            }).catch(() => {});\\n\n        };\\n\n    })();\\n\n</script>\\n\n    <title>Inspection \u00b7 RO #1</title>\\n\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/favicon/favicon.ico\">\\n\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/favicon/ark-32x32.png\">\\n\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/favicon/ark-16x16.png\">\\n\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/ios/ark-180x180.png\">\\n\n<link rel=\"manifest\" href=\"http://localhost/assets/ARK_SMS_FINAL_DROP_IN_PACK/manifest.json\">\\n\n        <script>\\n\n    window.arkShopChannel = (name) => '' + name;\\n\n</script>\\n\n    <!-- vite: resources/css/app.css,resources/css/tabler.css,resources/js/app.js,resources/js/tabler.js --></head>\\n\n<body>\\n\n    <div class=\"page\" data-inspection-tablet-shell>\\n\n        <div class=\"page-wrapper\">\\n\n            <main>\\n\n                <div class=\"page-body\" data-inspection-surface=\"tablet\">\\n\n            <div class=\"container-narrow d-flex flex-column gap-3\">\\n\n                <header class=\"card\" data-inspection-tablet-header>\\n\n                    <div class=\"card-body p-3\">\\n\n                        <div class=\"row g-2 align-items-center\">\\n\n                            <div class=\"col-12 col-sm\" style=\"min-width: 0