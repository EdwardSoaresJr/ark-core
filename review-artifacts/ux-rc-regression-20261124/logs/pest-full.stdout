      <div class=\"col-12 col-md-3\">\\n\n                                            <div class=\"fw-medium\">Estimate logo</div>\\n\n                                            <div class=\"text-secondary small\">Used on estimate documents. PNG, JPG, or WebP up to 2 MB.</div>\\n\n                                        </div>\\n\n                                        <div class=\"col-12 col-sm-4 col-md-3\">\\n\n                                            <div class=\"d-flex align-items-center justify-content-center border rounded bg-white p-2\" style=\"min-height: 5rem\">\\n\n                                                                                                    <span class=\"subheader\">No logo</span>\\n\n                                                                                            </div>\\n\n                                        </div>\\n\n                                        <div class=\"col-12 col-sm\">\\n\n                                            <label for=\"settings-logo\" class=\"form-label\">Upload logo</label>\\n\n                                            <input id=\"settings-logo\" type=\"file\" name=\"logo\" accept=\"image/png,image/jpeg,image/webp\" class=\"form-control\">\\n\n                                                                                    </div>\\n\n                                    </div>\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                    <label for=\"settings-shop-name\" class=\"form-label\">Shop name</label>\\n\n                                    <input id=\"settings-shop-name\" name=\"shop_name\" value=\"\" class=\"form-control\">\\n\n                                </div>\\n\n                                <div class=\"col-12 col-md-6\">\\n\n                                                                        <label for=\"settings-shop-timezone\" class=\"form-label\">Shop timezone</l