e.now()\"\\n\n        >\\n\n            Estimate PDF\\n\n        </a>\\n\n        </div>\\n\n</div>\\n\n</div>\\n\n            <div class=\"dropdown\" data-ark-page-overflow hidden>\\n\n                <button type=\"button\" class=\"btn btn-icon\" data-bs-toggle=\"dropdown\" data-bs-display=\"static\" aria-expanded=\"false\" aria-label=\"More page actions\" title=\"More page actions\">\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/></svg>\\n\n                </button>\\n\n                <div class=\"dropdown-menu dropdown-menu-end\" data-ark-page-overflow-menu></div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                    <div class=\"navbar-nav flex-row align-items-center gap-2 ms-auto flex-shrink-0\">\\n\n                    \\n\n                                            <nav class=\"nav-item\" aria-label=\"Communications by channel\" data-ark-channel-strip>\\n\n    <div class=\"dropdown\">\\n\n        <a\\n\n            href=\"#\"\\n\n            class=\"nav-link px-2 gap-2\"\\n\n            data-bs-toggle=\"dropdown\"\\n\n            aria-expanded=\"false\"\\n\n            aria-label=\"Inbox, 0 need attention\"\\n\n            data-ark-inbox-menu\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M21 14l-3 -3h-7a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1h9a1 1 0 0 1 1 1v10\"/><path d=\"M14 15v2a1 1 0 0 1 -1 1h-7l-3 3v-10a1 1 0 0 1 1 -1h2\"/></svg>\\n\n            <span class=\"d-none d