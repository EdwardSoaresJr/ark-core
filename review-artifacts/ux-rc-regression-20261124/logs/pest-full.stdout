me</button>\\n\n                </form>\\n\n                                    <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                        <input type=\"hidden\" name=\"assign_to\" value=\"unassign\">\\n\n                        <button type=\"submit\" class=\"btn btn-sm w-100 mb-2\" data-comms-work-unassign>Unassign</button>\\n\n                    </form>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\" class=\"mb-2\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                    <input type=\"hidden\" name=\"assign_to\" value=\"user\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-assign-menu\">Assign to</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <select id=\"comms-work-assign-menu\" name=\"user_id\" class=\"form-select\" required>\\n\n                            <option value=\"\" disabled >Choose\u2026</option>\\n\n                                                            <option value=\"1\" selected>Lucile Gerhold PhD</option>\\n\n                                                    </select>\\n\n                        <button type=\"submit\" class=\"btn\">Assign</button>\\n\n                    </div>\\n\n                </form>\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"follow_up\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-due-menu\">Follow up on</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <input id=\"comms-work-due-menu\" type=\"datetime-local\" name=\"due_at\" value=\"2026-11-25T08:00\" required class=\"form-control\">\\n\n                        <button type=\"submit\" class=\"btn\">Set</button>\\n\n                    </div>\\n\n                </form>\\n\n                <div class=\"dropdown-divider\"></div>\\n\n                                    <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"action\" value=\"wait\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                        <button type=\"submit\" class=\"dropdown-item\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M12 7v5l3 3\"/></svg>\\n\n                            Waiting on the customer\\n\n                        </button>\\n\n                    </form>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                    <button type=\"submit\" class=\"dropdown-item\" data-comms-work-unread>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                        Mark unread\\n\n                    </button>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                                    </div>\\n\n            </div>\\n\n            </div>\\n\n\\n\n            <section class=\"alert alert-danger m-2 mb-0 py-2 small\" aria-label=\"What to do next\" data-comms-decision=\"needs\">\\n\n    <div class=\"fw-bold\">\\n\n        Customer wrote last\\n\n                    <span class=\"fw-normal text-secondary\">0s ago</span>\\n\n            </div>\\n\n            <div class=\"text-secondary text-truncate d-none d-xxl-block\">Can I get an appointment tomorrow?</div>\\n\n                <div class=\"text-secondary d-none d-xxl-block\">Customer wrote last - reply if needed, mark waiting if the shop is working this, or resolve if finished.</div>\\n\n    \\n\n    \\n\n    \\n\n</section>\\n\n    \\n\n    <div class=\"ark-comms-thread-wrap position-relative d-flex flex-column flex-fill\">\\n\n    <div\\n\n        id=\"comms-workspace-thread-messages\"\\n\n        class=\"card-body chat-bubbles ark-comms-thread gap-2 overflow-auto flex-fill p-2 p-md-3\"\\n\n        data-comms-thread-body\\n\n        aria-label=\"Conversation\"\\n\n                    data-mark-read-url=\"http://localhost/app/communications/conversations/1/mark-read\"\\n\n            data-conversation-key=\"conversation:1\"\\n\n            >\\n\n                                <div class=\"text-center text-secondary small mt-1\" data-comms-date=\"2026-11-24\">Tue, Nov 24, 2026</div>\\n\n        <div data-comms-entry=\"conversation_message:1\">\\n\n            <div\\n\n        class=\"d-flex\"\\n\n            >\\n\n        <div class=\"d-flex flex-column\" style=\"max-width: 88%\">\\n\n        <article\\n\n            class=\"chat-bubble px-3 py-2\"\\n\n            data-comms-bubble=\"inbound\"\\n\n        >\\n\n            <div class=\"chat-bubble-title small text-secondary\">\\n\n                                    <span class=\"badge bg-secondary-lt me-1\" data-comms-channel>SMS</span>\\n\n                                Incoming\\n\n                                \u00b7 Nov 24, 9:11 AM\\n\n                            </div>\\n\n            <div class=\"chat-bubble-body\">\\n\n                                                    <p class=\"mb-0\" style=\"white-space: pre-wrap\">Can I get an appointment tomorrow?</p>\\n\n                                                                                                                                        <details class=\"mt-1 small\" data-comms-details>\\n\n                        <summary class=\"text-secondary\">Details</summary>\\n\n                        <ul class=\"list-unstyled mb-0 mt-1\">\\n\n                                                            <li>Text message</li>\\n\n                                                            <li>Received Nov 24, 9:11 AM from Maria Lopez</li>\\n\n                                                                                </ul>\\n\n                    </details>\\n\n                            </div>\\n\n        </article>\\n\n                        </div>\\n\n    </div>\\n\n        </div>\\n\n            </div>\\n\n        <button type=\"button\" class=\"btn btn-primary btn-sm rounded-pill shadow position-absolute bottom-0 start-50 translate-middle-x mb-2 d-none\" data-comms-new-below>\\n\n            New messages\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n        </button>\\n\n    </div>\\n\n\\n\n    \\n\n            <footer class=\"card-footer p-0\" data-comms-composer>\\n\n            \\n\n                        <div x-data=\"{ tab: 'internal' }\" data-comms-composer-tabs>\\n\n            <ul class=\"nav nav-tabs px-2 pt-1\" role=\"tablist\" aria-label=\"Reply, email, or note\">\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"comms-composer-tab-reply\"\\n\n                            aria-controls=\"comms-composer-panel-reply\"\\n\n                            class=\"nav-link\"\\n\n                            :class=\"{ active: tab === 'reply' }\"\\n\n                            :aria-selected=\"(tab === 'reply').toString()\"\\n\n                                                            disabled\\n\n                                title=\"Texting is not set up for this shop.\"\\n\n                                data-comms-composer-unavailable=\"Texting is not set up for this shop.\"\\n\n                                                    >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M8 9h8\"/><path d=\"M8 13h6\"/><path d=\"M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12\"/></svg>\\n\n                            SMS\\n\n                        </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"comms-composer-tab-email\"\\n\n                            aria-controls=\"comms-composer-panel-email\"\\n\n                            class=\"nav-link\"\\n\n                            :class=\"{ active: tab === 'email' }\"\\n\n                            :aria-selected=\"(tab === 'email').toString()\"\\n\n                                                            disabled\\n\n                                title=\"This conversation is by text. Email the customer from the Customer panel.\"\\n\n                                data-comms-composer-unavailable=\"This conversation is by text. Email the customer from the Customer panel.\"\\n\n                                                    >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                            Email\\n\n                        </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"comms-composer-tab-internal\"\\n\n                            aria-controls=\"comms-composer-panel-internal\"\\n\n                            class=\"nav-link\"\\n\n                            :class=\"{ active: tab === 'internal' }\"\\n\n                            :aria-selected=\"(tab === 'internal').toString()\"\\n\n                                                            @click=\"tab = 'internal'\"\\n\n                                                    >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\"/><path d=\"M9 9l1 0\"/><path d=\"M9 13l6 0\"/><path d=\"M9 17l6 0\"/></svg>\\n\n                            Internal note\\n\n                        </button>\\n\n                    </li>\\n\n                            </ul>\\n\n\\n\n            <div\\n\n                id=\"comms-composer-panel-reply\"\\n\n                role=\"tabpanel\"\\n\n                aria-labelledby=\"comms-composer-tab-reply\"\\n\n                x-show=\"tab === 'reply'\"\\n\n                x-cloak\\n\n            >\\n\n                \\n\n                                    <div\\n\n                                    id=\"comms-thread-composer\"\\n\n                                data-ark-workspace-dirty=\"off\"\\n\n                data-ark-conversation-composer\\n\n                                x-data=\"arkConversationQuickReply(JSON.parse('{\\u0022sendUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-messages?conversation_id=1\\u0022,\\u0022repairOrderId\\u0022:null,\\u0022sendEstimateUrl\\u0022:null,\\u0022cancelScheduledEstimateUrl\\u0022:null,\\u0022cancelScheduledSmsUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-actions\\\\\\/cancel-scheduled-sms\\u0022,\\u0022sendPaymentUrl\\u0022:null,\\u0022sendDepositUrl\\u0022:null,\\u0022sendInspectionUrl\\u0022:null,\\u0022messageActions\\u0022:[],\\u0022contextEstimateSend\\u0022:null,\\u0022contextPaymentSend\\u0022:null,\\u0022contextDepositSend\\u0022:null,\\u0022contextInspectionSend\\u0022:null,\\u0022estimateSchedule\\u0022:{\\u0022shop_is_open\\u0022:true,\\u0022pending\\u0022:null},\\u0022smsSchedule\\u0022:{\\u0022shop_is_open\\u0022:true,\\u0022next_open_morning_label\\u0022:\\u0022Wed Nov 25 \u00b7 8:00 AM\\u0022,\\u0022upcoming\\u0022:[{\\u0022scheduled_for\\u0022:\\u00222026-11-25T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Wed Nov 25 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-25\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-26T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Thu Nov 26 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-26\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-27T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Fri Nov 27 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-27\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-30T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Mon Nov 30 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-30\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-12-01T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Tue Dec 1 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-12-01\\u0022}],\\u0022pending\\u0022:null},\\u0022openRepairOrders\\u0022:[],\\u0022customerId\\u0022:1,\\u0022messagesListIds\\u0022:[\\u0022comms-workspace-thread-messages\\u0022],\\u0022hasConversationHistory\\u0022:true,\\u0022autoOpenComposer\\u0022:true,\\u0022alwaysOpen\\u0022:true,\\u0022keepOpenAfterSend\\u0022:true,\\u0022customerPhoneDisplay\\u0022:\\u0022(719) 555-8810\\u0022,\\u0022customerEmail\\u0022:\\u0022maria@example.test\\u0022,\\u0022estimateDelivery\\u0022:\\u0022email\\u0022,\\u0022paymentDelivery\\u0022:\\u0022email\\u0022,\\u0022depositDelivery\\u0022:\\u0022email\\u0022,\\u0022depositAmount\\u0022:\\u0022\\u0022,\\u0022canSmsEstimate\\u0022:false,\\u0022canEmailEstimate\\u0022:false,\\u0022canSmsPayment\\u0022:false,\\u0022canEmailPayment\\u0022:false,\\u0022canSmsDeposit\\u0022:false,\\u0022canEmailDeposit\\u0022:false,\\u0022canSmsInspection\\u0022:false,\\u0022showSmsComposer\\u0022:false,\\u0022sendEstimateAddVinUrl\\u0022:null,\\u0022nudgeKey\\u0022:\\u0022conversation.sms_analysis_follow_up\\u0022,\\u0022entityKey\\u0022:\\u0022conversation:1\\u0022,\\u0022initialBody\\u0022:null,\\u0022platformBacked\\u0022:false}'))\"\\n\n                \\n\n            >\\n\n                \\n\n                                <div x-show=\"estimateSchedule?.pending\" x-cloak class=\"alert alert-info m-2 mb-0 py-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                        <div>\\n\n                            Scheduled estimate \u00b7 <span x-text=\"estimateSchedule?.pending?.scheduled_for_label ?? estimateSchedule?.next_open_morning_label ?? smsSchedule?.next_open_morning_label ?? 'Next open morning'\"></span>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"cancelScheduledEstimate()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"smsSchedule?.pending\" x-cloak class=\"alert alert-info m-2 mb-0 py-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                        <div>\\n\n                            Scheduled reply \u00b7 <span x-text=\"smsSchedule?.pending?.scheduled_for_label ?? smsSchedule?.next_open_morning_label ?? 'Next open morning'\"></span>\\n\n                            <span\\n\n                                x-show.important=\"smsSchedule?.pending?.preview\"\\n\n                                class=\"d-block text-secondary\"\\n\n                                x-text=\"smsSchedule?.pending?.preview\"\\n\n                            ></span>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"cancelScheduledSms()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"afterHoursPromptOpen\" x-cloak class=\"alert alert-warning m-2 mb-0 py-2\" role=\"alert\">\\n\n                    <div class=\"fw-bold\">It's after business hours.</div>\\n\n                    <div>\\n\n                        Send now, or schedule for\\n\n                        <span x-text=\"smsSchedule?.next_open_morning_label ?? 'next open morning'\"></span>?\\n\n                    </div>\\n\n                    <div class=\"btn-list mt-2\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"confirmAfterHoursTiming('now')\"\\n\n                        >Send Now</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-warning\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"confirmAfterHoursNextOpenMorning()\"\\n\n                        >Schedule</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-ghost-secondary\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"dismissAfterHoursPrompt()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div class=\"d-flex flex-column\" data-comms-composer-stack>\\n\n                    <div\\n\n                        class=\"d-flex flex-wrap align-items-center gap-2 px-3 py-2 justify-content-between order-last border-top\"\\n\n                        role=\"group\"\\n\n                        aria-label=\"Conversation commands\"\\n\n                    >\\n\n                                                    <details\\n\n                                class=\"position-relative\"\\n\n                                x-ref=\"actionsMenu\"\\n\n                                @toggle=\"onActionsMenuToggle($event)\"\\n\n                                @click.outside=\"closeActionsMenu()\"\\n\n                            >\\n\n                                <summary class=\"btn btn-sm\">Actions</summary>\\n\n                                <div class=\"dropdown-menu show position-absolute bottom-100 mb-1\" data-comms-actions-panel>\\n\n                                                                            <a href=\"tel:+17195558810\" class=\"dropdown-item\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                                            Call\\n\n                                        </a>\\n\n                                                                                                                                                                                                                                                        </div>\\n\n                            </details>\\n\n                                                                                                                                                </div>\\n\n\\n\n                    <div x-show=\"vinWarningOpen\" x-cloak class=\"alert alert-warning mx-3 mb-2\" role=\"alert\" data-estimate-vin-warning>\\n\n                        <div class=\"fw-bold\">VIN missing</div>\\n\n                        <div>\\n\n                            Parts lookup, labor guides, service history accuracy, and OEM information may be affected.\\n\n                        </div>\\n\n                        <div class=\"btn-list mt-2\">\\n\n                            <a :href=\"addVinUrl()\" class=\"btn btn-sm\" @click=\"cancelVinWarning()\">Add VIN</a>\\n\n                            <button type=\"button\" class=\"btn btn-sm btn-primary\" @click=\"continueWithoutVin()\">Continue anyway</button>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div x-show=\"showSmsComposer && open\" x-cloak>\\n\n                        <div class=\"px-3 py-2\">\\n\n                            <label class=\"visually-hidden\" for=\"comms-thread-composer-body\">Message</label>\\n\n                            <textarea\\n\n                                id=\"comms-thread-composer-body\"\\n\n                                x-ref=\"replyBody\"\\n\n                                x-model=\"body\"\\n\n                                rows=\"3\"\\n\n                                                                placeholder=\"Message or MMS to (719) 555-8810\"\\n\n                                :placeholder=\"composerPlaceholder()\"\\n\n                                class=\"form-control\"\\n\n                                @keydown.meta.enter.prevent=\"send()\"\\n\n                                @keydown.ctrl.enter.prevent=\"send()\"\\n\n                            ></textarea>\\n\n                                                            <div class=\"mt-2\">\\n\n                                    <div class=\"d-flex flex-wrap gap-1\" role=\"group\" aria-label=\"Quick replies\" data-comms-quick-replies>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for reaching out - we received your request and will follow up shortly with next steps.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Estimate received\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We can get you on the schedule. What day works best for you to bring the vehicle in?'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Scheduling\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for your patience - we are running a little behind today but will get back to you as soon as possible.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Running behind\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We offer several payment options at checkout. Let us know if you would like an estimate sent over to review.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Financing\\n\n            </button>\\n\n            </div>\\n\n                                </div>\\n\n                                                                                    <div x-show=\"error\" x-cloak class=\"mt-1 small text-danger fw-medium\" x-text=\"error\"></div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"error && ! open\" x-cloak class=\"alert alert-danger mx-3 mb-2\" role=\"alert\">\\n\n                    <div class=\"fw-bold\">Could not send</div>\\n\n                    <div x-text=\"error\"></div>\\n\n                </div>\\n\n            </div>\\n\n        \\n\n                                        </div>\\n\n\\n\n            \\n\n            <form\\n\n                id=\"comms-composer-panel-internal\"\\n\n                role=\"tabpanel\"\\n\n                aria-labelledby=\"comms-composer-tab-internal\"\\n\n                x-show=\"tab === 'internal'\"\\n\n                x-cloak\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/communications/conversations/1/internal-note\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                <input type=\"hidden\" name=\"section\" value=\"inbox\">\\n\n                <div class=\"px-3 py-2\">\\n\n                    <label class=\"visually-hidden\" for=\"comms-internal-note-body\">Internal note</label>\\n\n                    <textarea\\n\n                        id=\"comms-internal-note-body\"\\n\n                        name=\"body\"\\n\n                        rows=\"3\"\\n\n                        required\\n\n                        maxlength=\"2000\"\\n\n                        placeholder=\"Internal note - never sent to customer\"\\n\n                        class=\"form-control\"\\n\n                    ></textarea>\\n\n                </div>\\n\n                <div class=\"d-flex justify-content-end px-3 py-2 border-top\">\\n\n                    <button type=\"submit\" class=\"btn btn-yellow\">\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\"/><path d=\"M9 9l1 0\"/><path d=\"M9 13l6 0\"/><path d=\"M9 17l6 0\"/></svg>\\n\n                        Add internal note\\n\n                    </button>\\n\n                </div>\\n\n            </form>\\n\n        </div>\\n\n    </footer>\\n\n    \\n\n    <div class=\"position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-25 z-3 d-none\" data-comms-switch aria-hidden=\"true\">\\n\n        <div class=\"d-flex h-100 align-items-center justify-content-center\">\\n\n            <div class=\"card card-sm shadow\">\\n\n                <div class=\"card-body d-flex align-items-center gap-2\">\\n\n                    <span class=\"spinner-border text-secondary\"></span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n            </section>\\n\n\\n\n            <aside\\n\n                id=\"ops-comms-workspace-context\"\\n\n                class=\"col-12 col-lg col-xl-3 flex-column\"\\n\n                :class=\"contextOpen ? 'd-flex' : 'd-none d-xl-flex'\"\\n\n                aria-label=\"Customer and work\"\\n\n            >\\n\n                <div class=\"card flex-fill overflow-hidden\" data-comms-context-card>\\n\n    <div class=\"card-header py-2 d-xl-none\">\\n\n        <button type=\"button\" class=\"btn btn-sm btn-ghost-secondary ps-0\" @click=\"contextOpen = false\">\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n            Back to conversation\\n\n        </button>\\n\n    </div>\\n\n            <div class=\"card-body overflow-auto flex-fill p-0\" data-comms-context-rail>\\n\n                        <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-customer\">\\n\n                <div class=\"subheader mb-2\" id=\"comms-context-customer\">Customer</div>\\n\n                <div class=\"d-flex align-items-center gap-2\">\\n\n                    <span class=\"avatar bg-lime-lt flex-shrink-0\" aria-hidden=\"true\">ML</span>\\n\n                    <div class=\"overflow-hidden\">\\n\n                        <div class=\"fw-bold text-truncate\">Maria Lopez</div>\\n\n                        <div class=\"text-secondary small\">Customer</div>\\n\n                    </div>\\n\n                </div>\\n\n                <div class=\"btn-list mt-2\">\\n\n                                            <a href=\"tel:+17195558810\" class=\"btn btn-icon btn-sm\" aria-label=\"Call\" title=\"Call\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n</a>\\n\n                                                                <a href=\"#comms-thread-composer\" class=\"btn btn-icon btn-sm\" aria-label=\"Text\" title=\"Text\" @click=\"contextOpen = false\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M8 9h8\"/><path d=\"M8 13h6\"/><path d=\"M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12\"/></svg>\\n\n</a>\\n\n                                                                <a href=\"mailto:maria@example.test\" class=\"btn btn-icon btn-sm\" aria-label=\"Email\" title=\"Email\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n</a>\\n\n                                                                <a href=\"http://localhost/app/customers/1\" class=\"btn btn-sm\" title=\"View full profile\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0\"/><path d=\"M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2\"/></svg>\\n\n                            View full profile\\n\n                        </a>\\n\n                                    </div>\\n\n                <dl class=\"row g-0 small mt-3 mb-0\">\\n\n                                            <dt class=\"col-4 text-secondary fw-normal\">Phone</dt>\\n\n                        <dd class=\"col-8 mb-1\">(719) 555-8810</dd>\\n\n                                                                <dt class=\"col-4 text-secondary fw-normal\">Email</dt>\\n\n                        <dd class=\"col-8 mb-1 text-truncate\">maria@example.test</dd>\\n\n                                                        </dl>\\n\n            </section>\\n\n\\n\n                                        <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-work\" data-comms-work-summary>\\n\n                    <div class=\"subheader mb-1\" id=\"comms-context-work\">Conversation</div>\\n\n                    <dl class=\"row g-0 small mb-2\">\\n\n                        <dt class=\"col-4 text-secondary fw-normal\">Owner</dt>\\n\n                        <dd class=\"col-8 mb-1 fw-medium\">Lucile Gerhold PhD</dd>\\n\n                        <dt class=\"col-4 text-secondary fw-normal\">Follow-up</dt>\\n\n                        <dd class=\"col-8 mb-1\">None</dd>\\n\n                    </dl>\\n\n                    <div class=\"ark-comms-work-grid\" role=\"group\" aria-label=\"Conversation work\" data-comms-work-actions=\"rail\">\\n\n                    <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\" class=\"d-flex\">\\n\n                <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                <input type=\"hidden\" name=\"action\" value=\"resolve\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                <button type=\"submit\" class=\"btn btn-sm btn-success w-100\">\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l5 5l10 -10\"/></svg>\\n\n                    Resolve\\n\n                </button>\\n\n            </form>\\n\n                <div class=\"dropdown\">\\n\n            <button type=\"button\" class=\"btn btn-sm dropdown-toggle w-100\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" data-bs-popper-config='{\"strategy\":\"fixed\"}' aria-expanded=\"false\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0\"/><path d=\"M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2\"/></svg>\\n\n                Assign\\n\n            </button>\\n\n            <div class=\"dropdown-menu dropdown-menu-end p-2\" style=\"min-width: 16rem\">\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                    <input type=\"hidden\" name=\"assign_to\" value=\"me\">\\n\n                    <button type=\"submit\" class=\"btn btn-sm w-100 mb-2\">Assign to me</button>\\n\n                </form>\\n\n                                    <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                        <input type=\"hidden\" name=\"assign_to\" value=\"unassign\">\\n\n                        <button type=\"submit\" class=\"btn btn-sm w-100 mb-2\" data-comms-work-unassign>Unassign</button>\\n\n                    </form>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"assign\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                    <input type=\"hidden\" name=\"assign_to\" value=\"user\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-assign-rail\">Assign to</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <select id=\"comms-work-assign-rail\" name=\"user_id\" class=\"form-select\" required>\\n\n                            <option value=\"\" disabled >Choose\u2026</option>\\n\n                                                            <option value=\"1\" selected>Lucile Gerhold PhD</option>\\n\n                                                    </select>\\n\n                        <button type=\"submit\" class=\"btn\">Assign</button>\\n\n                    </div>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"dropdown\">\\n\n            <button type=\"button\" class=\"btn btn-sm dropdown-toggle w-100\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" data-bs-popper-config='{\"strategy\":\"fixed\"}' aria-expanded=\"false\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4\"/><path d=\"M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0\"/><path d=\"M15 3v4\"/><path d=\"M7 3v4\"/><path d=\"M3 11h16\"/><path d=\"M18 16.496v1.504l1 1\"/></svg>\\n\n                Follow-up\\n\n            </button>\\n\n            <div class=\"dropdown-menu dropdown-menu-end p-2\" style=\"min-width: 16rem\">\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"follow_up\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-due-rail\">Follow up on</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <input id=\"comms-work-due-rail\" type=\"datetime-local\" name=\"due_at\" value=\"2026-11-25T08:00\" required class=\"form-control\">\\n\n                        <button type=\"submit\" class=\"btn\">Set</button>\\n\n                    </div>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n                    <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\" class=\"d-flex\">\\n\n                <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">                <input type=\"hidden\" name=\"action\" value=\"wait\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n                <button type=\"submit\" class=\"btn btn-sm w-100\" title=\"Waiting on the customer\">\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M12 7v5l3 3\"/></svg>\\n\n                    Waiting\\n\n                </button>\\n\n            </form>\\n\n                            <div data-comms-context-check-in=\"check_in\">\\n\n                <a\\n\n                    href=\"http://localhost/app/intake/new?customer_id=1\"\\n\n                    class=\"btn btn-sm w-100 btn-primary\"\\n\n                    data-comms-check-in\\n\n                                    >\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5\"/></svg>\\n\n                    Check In\\n\n                </a>\\n\n            </div>\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\" class=\"d-flex\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\" autocomplete=\"off\">            <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"needs\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-24T16:11:10+00:00\">\\n\n            <button type=\"submit\" class=\"btn btn-sm w-100\" data-comms-work-unread>\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                Mark unread\\n\n            </button>\\n\n        </form>\\n\n    </div>\\n\n                </section>\\n\n            \\n\n            <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-vehicle\">\\n\n                <div class=\"subheader mb-1\" id=\"comms-context-vehicle\">Vehicle &amp; visit</div>\\n\n                                                    <div class=\"text-secondary small\">No current visit</div>\\n\n                                            </section>\\n\n\\n\n            <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-visits\">\\n\n                <div class=\"subheader mb-1\" id=\"comms-context-visits\">Recent visits</div>\\n\n                                    <div class=\"text-secondary small\">No visits yet</div>\\n\n                            </section>\\n\n        </div>\\n\n    </div>\\n\n            </aside>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"dgDL9lW6JJOZoeHcbgUmwjaylQZVrOBjV383llIE\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox\",\"disabled_reason\":null},{\"id\":\"nav.reports\",\"title\":\"Reports\",\"group\":\"Navigate\",\"keywords\":[\"reports\",\"end of day\",\"operational\"],\"url\":\"http:\\/\\/localhost\\/app\\/reports\",\"disabled_reason\":null},{\"id\":\"create.repair-order\",\"title\":\"New Repair Order\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"ro\",\"repair\",\"intake\",\"check in\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.customer\",\"title\":\"New Customer\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"customer\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.vehicle\",\"title\":\"New Vehicle\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"vehicle\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.appointment\",\"title\":\"New Appointment\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"appointment\",\"schedule\"],\"url\":\"http:\\/\\/localhost\\/app\\/appointments\\/create\",\"disabled_reason\":null},{\"id\":\"create.message\",\"title\":\"New Message\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"message\",\"text\",\"sms\",\"email\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose\",\"disabled_reason\":null},{\"id\":\"create.sms\",\"title\":\"New SMS\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"sms\",\"text\",\"phone\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=sms\",\"disabled_reason\":null},{\"id\":\"create.email\",\"title\":\"New Email\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"email\",\"mail\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=email\",\"disabled_reason\":null},{\"id\":\"search.customer\",\"title\":\"Search Customers\",\"group\":\"Search\",\"keywords\":[\"search\",\"customer\",\"phone\",\"name\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.vehicle\",\"title\":\"Search Vehicles\",\"group\":\"Search\",\"keywords\":[\"search\",\"vehicle\",\"vin\",\"plate\",\"license\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.vin\",\"title\":\"Search by VIN\",\"group\":\"Search\",\"keywords\":[\"search\",\"vin\",\"vehicle\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.plate\",\"title\":\"Search by License Plate\",\"group\":\"Search\",\"keywords\":[\"search\",\"plate\",\"license\",\"tag\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.phone\",\"title\":\"Search by Phone\",\"group\":\"Search\",\"keywords\":[\"search\",\"phone\",\"customer\",\"number\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.repair-order\",\"title\":\"Search Repair Orders\",\"group\":\"Search\",\"keywords\":[\"search\",\"ro\",\"repair\",\"order\",\"number\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.estimate\",\"title\":\"Search Estimates\",\"group\":\"Search\",\"keywords\":[\"search\",\"estimate\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.invoice\",\"title\":\"Search Invoices\",\"group\":\"Search\",\"keywords\":[\"search\",\"invoice\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"ops.print-key-tag\",\"title\":\"Print Key Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"key\",\"tag\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-oil-sticker\",\"title\":\"Print Oil Sticker\",\"group\":\"Operations\",\"keywords\":[\"print\",\"oil\",\"sticker\",\"change\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.print-service-tag\",\"title\":\"Print Service Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"service\",\"tag\",\"tech\",\"sheet\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.take-payment\",\"title\":\"Take Payment\",\"group\":\"Operations\",\"keywords\":[\"payment\",\"pay\",\"square\",\"collect\",\"balance\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.record-deposit\",\"title\":\"Record Deposit\",\"group\":\"Operations\",\"keywords\":[\"deposit\",\"payment\",\"record\"],\"url\":null,\"disabled_reason\":\"Open a repair order first.\"},{\"id\":\"ops.open-active-ro\",\"title\":\"Open Active RO\",\"group\":\"Operations\",\"keywords\":[\"active\",\"ro\",\"open\",\"workboard\",\"repair\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null}]</script>\\n\n        <div class=\"modal d-block\" tabindex=\"-1\">\\n\n            <div class=\"modal-backdrop show z-0\" data-ops-global-search-backdrop></div>\\n\n            <div\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable\"\\n\n                data-ops-global-search-dialog\\n\n                role=\"dialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-label=\"Command palette\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header p-2\">\\n\n                        <label class=\"visually-hidden\" for=\"ops-global-search-input\">Search commands and records</label>\\n\n                        <div class=\"input-icon w-100\">\\n\n                            <span class=\"input-icon-addon\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                            </span>\\n\n                            <input\\n\n                                id=\"ops-global-search-input\"\\n\n                                type=\"search\"\\n\n                                class=\"form-control form-control-lg\"\\n\n                                data-ops-global-search-input\\n\n                                placeholder=\"Type a command or search\u2026\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"modal-body p-0\">\\n\n                        <div class=\"list-group list-group-flush\" data-ops-global-search-results>\\n\n                            <div class=\"list-group-item small text-secondary\">\u2318K \u00b7 Enter runs \u00b7 Esc closes</div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <div\\n\n    x-data=\"arkLearnGuideModal()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ark-learn-guide-modal\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"title || 'ARKademy guide'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close guide preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header align-items-start\">\\n\n                    <div class=\"overflow-hidden\">\\n\n                        <div class=\"subheader\" x-show=\"sectionLabel\" x-text=\"sectionLabel\"></div>\\n\n                        <h2 class=\"modal-title\" x-text=\"title || 'ARKademy'\"></h2>\\n\n                        <div class=\"small text-secondary\" x-show=\"summary\" x-text=\"summary\"></div>\\n\n                    </div>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"close()\" aria-label=\"Close\"></button>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-body\">\\n\n                    <div class=\"text-secondary\" x-show=\"loading\">\\n\n                        <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading guide\u2026\\n\n                    </div>\\n\n                    <div class=\"alert alert-danger mb-0\" role=\"alert\" x-show=\"error\" x-text=\"error\"></div>\\n\n                    \\n\n                    <div\\n\n                        class=\"ark-legacy bg-white text-dark rounded p-3 ops-learn-prose ops-learn-guide-modal__prose\"\\n\n                        x-show=\"! loading && ! error && html\"\\n\n                        x-html=\"html\"\\n\n                    ></div>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-footer\">\\n\n                                            <div class=\"small text-secondary me-auto\">Preview from ARK - open ARKademy for search, print, and full navigation.</div>\\n\n                                        <button type=\"button\" class=\"btn\" @click=\"close()\">Close</button>\\n\n                                            <a\\n\n                            :href=\"arkademyUrl\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-primary\"\\n\n                            x-show=\"arkademyUrl\"\\n\n                        >\\n\n                            Open in ARKademy\\n\n                        </a>\\n\n                                    </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n    <div x-data=\"arkCommsInterrupt()\" data-ark-comms-interrupt data-conversation-url-template=\"http://localhost/app/communications/inbox?conversation=__CONVERSATION__\" data-waiting-url=\"http://localhost/app/communications/inbox?filter=needs\">\\n\n        <div x-show=\"activeCall !== null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"callInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeCall\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-green\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"d-flex align-items-start gap-2\">\\n\n                                    <div class=\"flex-fill overflow-hidden\">\\n\n                                        <div class=\"small fw-bold text-uppercase text-green\" x-text=\"callEyebrow()\"></div>\\n\n                                        <template x-if=\"activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0 text-truncate\" x-text=\"activeCall.customer_name\"></div>\\n\n                                        </template>\\n\n                                        <template x-if=\"! activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0\">Unknown Caller</div>\\n\n                                        </template>\\n\n                                        <div class=\"text-secondary\" x-text=\"activeCall.display_phone\"></div>\\n\n                                        <template x-if=\"activeCall.owned_by_name\">\\n\n                                            <div class=\"small text-secondary mt-1\" x-text=\"ownerLabel()\"></div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                    <button type=\"button\" class=\"btn btn-sm\" @click=\"dismissCall()\">Dismiss</button>\\n\n                                </div>\\n\n\\n\n                                <template x-if=\"activeCall.matched\">\\n\n                                    <div class=\"mt-2\">\\n\n                                        <div class=\"small fw-medium text-truncate\" x-text=\"vehicleSummary()\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"openRoSummary()\"></div>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeCall.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeCall.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeCall.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeCall.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall.matched && previewOpenRos().length > 0\">\\n\n                                    <div class=\"list-group mt-2\">\\n\n                                        <template x-for=\"openRepairOrder in previewOpenRos()\" :key=\"openRepairOrder.repair_order_id\">\\n\n                                            <a\\n\n                                                :href=\"openRepairOrder.url\"\\n\n                                                class=\"list-group-item list-group-item-action d-flex align-items-center gap-2 small\"\\n\n                                                @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                            >\\n\n                                                <span class=\"fw-bold text-nowrap\" x-text=\"'RO #' + openRepairOrder.repair_order_id\"></span>\\n\n                                                <span class=\"flex-fill text-truncate text-secondary\" x-text=\"openRepairOrder.vehicle_name\"></span>\\n\n                                                <span class=\"text-secondary text-nowrap\" x-text=\"openRepairOrder.status_label\"></span>\\n\n                                            </a>\\n\n                                        </template>\\n\n                                        <template x-if=\"extraOpenRoCount() > 0 && activeCall.customer_url\">\\n\n                                            <a :href=\"activeCall.customer_url\" class=\"list-group-item list-group-item-action small\" @click=\"markCallHandledForId(activeCall.call_session_id)\">\\n\n                                                +<span x-text=\"extraOpenRoCount()\"></span> more on Customer Hub\\n\n                                            </a>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"lastConversationSnippet()\">\\n\n                                    <p class=\"small text-secondary mt-2 mb-0\" x-text=\"lastConversationSnippet()\"></p>\\n\n                                </template>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther() && activeCall.show_callback_action\"\\n\n                                    type=\"button\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"window.arkInitiateTelephonyCallback?.({\\n\n                                        customerId: activeCall.callback_customer_id,\\n\n                                        phone: activeCall.callback_phone,\\n\n                                        callSessionId: activeCall.call_session_id,\\n\n                                        button: $event.currentTarget,\\n\n                                    }); activeCall = null;\"\\n\n                                >Callback</button>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && activeCall.matched && activeCall.customer_url\"\\n\n                                    :href=\"activeCall.customer_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Open Customer</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched && activeCall.create_contact_url\"\\n\n                                    :href=\"activeCall.create_contact_url\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Create Contact</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched\"\\n\n                                    :href=\"activeCall.intake_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Start Check In</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther()\"\\n\n                                    :href=\"activeCall.lookup_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Caller Lookup</a>\\n\n\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther()\"\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-ghost-secondary\"\\n\n                                    @click=\"markCallHandled()\"\\n\n                                >Mark Handled</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"activeMessage !== null && activeCall === null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"messageInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeMessage\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-azure\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"small fw-bold text-uppercase text-azure\" x-text=\"channelLabel()\"></div>\\n\n                                <div class=\"h3 mb-0 text-truncate\" x-text=\"activeMessage.headline ?? 'Unknown'\"></div>\\n\n                                <div class=\"text-secondary\" x-text=\"activeMessage.display_phone\"></div>\\n\n\\n\n                                <p\\n\n                                    class=\"fw-medium text-break mt-2 mb-0\"\\n\n                                    x-show=\"snippetPreview() !== ''\"\\n\n                                    x-text=\"snippetPreview()\"\\n\n                                ></p>\\n\n                                <a\\n\n                                    x-show=\"moreCount > 0 && waitingUrl() !== ''\"\\n\n                                    :href=\"waitingUrl()\"\\n\n                                    class=\"d-inline-block small mt-2\"\\n\n                                    data-comms-interrupt-more\\n\n                                    x-text=\"moreLabel()\"\\n\n                                ></a>\\n\n                                <template x-if=\"activeMessage?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeMessage.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeMessage.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeMessage.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                     