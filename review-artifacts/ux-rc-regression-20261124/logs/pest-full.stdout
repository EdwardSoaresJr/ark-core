ntrol\"\\n\n                    @click=\"zoomIn()\"\\n\n                    :disabled=\"scale >= maxScale - 0.001\"\\n\n                    aria-label=\"Zoom in\"\\n\n                >\\n\n                    +\\n\n                </button>\\n\n                <a\\n\n                    :href=\"src\"\\n\n                    target=\"_blank\"\\n\n                    rel=\"noopener noreferrer\"\\n\n                    class=\"ops-image-lightbox__link\"\\n\n                    x-show=\"src\"\\n\n                >\\n\n                    Open original\\n\n                </a>\\n\n                <button type=\"button\" class=\"ops-image-lightbox__close\" @click=\"close()\">Close</button>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div\\n\n            x-ref=\"viewport\"\\n\n            class=\"ops-image-lightbox__viewport\"\\n\n            @wheel.prevent=\"onWheel($event)\"\\n\n            @mousemove.window=\"onPan($event)\"\\n\n            @mouseup.window=\"endPan()\"\\n\n        >\\n\n            <img\\n\n                :src=\"src\"\\n\n                :alt=\"alt || 'Attachment preview'\"\\n\n                class=\"ops-image-lightbox__image\"\\n\n                :style=\"imageTransform()\"\\n\n                @load=\"onImageLoad($event)\"\\n\n                @mousedown.prevent=\"startPan($event)\"\\n\n                @click.stop\\n\n                draggable=\"false\"\\n\n            >\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n    </body>\\n\n</html>\\n\n' [UTF-8](length: 28213) contains \"Verify with email instead\" [ASCII](length: 25)."},{"test":"P\\Tests\\Feature\\Platform\\PublicWebsiteHostResolutionTest::__pest_evaluable_preferred_custom_domain_is_the_public_canonical_on_both_hosts","file":"/Users/edwardsoares/Herd/ark-core-ux-rc-bc5b8187/vendor/laravel/framework/src/Illuminate/Testing/TestResponseAssert.php","line":46,"message":"Failed asserting that '<!DOCTYPE html>\\n\n<html lang=\"en\">\\n\n    <head>\\n\n        <meta charset=\"utf-8\