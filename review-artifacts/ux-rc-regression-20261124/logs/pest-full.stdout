       </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <script type=\"application/json\" id=\"ark-call-queue-bootstrap\">{\"count\":0,\"summary\":{\"count\":0,\"call_count\":0,\"message_count\":0,\"since_last_shift_count\":0,\"has_live_calls\":false,\"urgency\":\"idle\",\"breakdown_label\":\"\",\"trigger_label\":\"\"},\"items\":[],\"calls\":[],\"messages\":[],\"queue_url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox?filter=needs\"}</script>\\n\n        <div\\n\n        data-call-queue-root\\n\n        x-data=\"arkCallQueue()\"\\n\n        @click.outside=\"open = false\"\\n\n        class=\"d-none\"\\n\n        aria-hidden=\"true\"\\n\n    ></div>\\n\n    <div\\n\n    x-data=\"arkImageLightbox()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ops-image-lightbox\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"alt || 'Image preview'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close image preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-dialog-centered modal-xl\" data-bs-theme=\"dark\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header flex-wrap gap-2 py-2\">\\n\n                    <div class=\"small fw-bold text-truncate flex-fill\" x-text=\"alt || 'Attachment preview'\"></div>\\n\n                    <div class=\"btn-list flex-nowrap\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomOut()\"\\n\n                            :disabled=\"scale <= minScale + 0.001\"\\n\n                            aria-label=\"Zoom out\"\\n\n                        >\\n\n                            \u2212\\n\n                        </button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            @click=\"fitToView()\"\\n\n                            x-text=\"zoomPercentLabel()\"\\n\n                            aria-label=\"Reset zoom to fit\"\\n\n                        ></button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomIn()\"\\n\n                            :disabled=\"scale >= maxScale - 0.001\"\\n\n                            aria-label=\"Zoom in\"\\n\n                        >\\n\n                            +\\n\n                        </button>\\n\n                        <a\\n\n                            :href=\"src\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-sm\"\\n\n                            x-show=\"src\"\\n\n                        >\\n\n                            Open original\\n\n                        </a>\\n\n                        <button type=\"button\" class=\"btn btn-sm\" @click=\"close()\">Close</button>\\n\n                    </div>\\n\n                </div>\\n\n\\n\n                <div\\n\n                    x-ref=\"viewport\"\\n\n                    class=\"modal-body p-0 d-flex align-items-center justify-content-center overflow-hidden bg-black\"\\n\n                    style=\"height: 80vh\"\\n\n                    @wheel.prevent=\"onWheel($event)\"\\n\n                    @mousemove.window=\"onPan($event)\"\\n\n                    @mouseup.window=\"endPan()\"\\n\n                >\\n\n                    <img\\n\n                        :src=\"src\"\\n\n                        :alt=\"alt || 'Attachment preview'\"\\n\n                        class=\"user-select-none\"\\n\n                        style=\"max-width: none; max-height: none; touch-action: none\"\\n\n                        :style=\"imageTransform()\"\\n\n                        @load=\"onImageLoad($event)\"\\n\n                        @mousedown.prevent=\"startPan($event)\"\\n\n                        @click.stop\\n\n                        draggable=\"false\"\\n\n                    >\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n        \\n\n                                </body>\\n\n</html>\\n\n' [UTF-8](length: 79551) contains \"Coverage today\" [ASCII](length: 14)."},{"test":"P\\Tests\\Feature\\Communications\\CommunicationsShopWorkspaceTest::__pest_evaluable_shop_communications_projects_live_calls_in_todays_coverage","file":"/Users/edwardsoares/Herd/ark-core-ux-rc-bc5b8187/vendor/laravel/framework/src/Illuminate/Testing/TestResponseAssert.php","line":46,"message":"Failed asserting that '<!DOCTYPE html>\\n\n<html lang=\"en\" class=\"h-full\"  data-accent=\"ark2\" >\\n\n    <head>\\n\n        <meta charset=\"utf-8\">\\n\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\\n\n        <meta name=\"csrf-token\" content=\"AowqhuCYXTylC5m8jWkU7KD9LBNareK6n1Kzxp1r\">\\n\n        <meta name=\"ark-ui-tenant-key\" content=\"localhost\">\\n\n        <meta name=\"ark-display-theme\" content=\"light\">\\n\n    <script>\\n\n        document.documentElement.classList.toggle('dark', false);\\n\n        document.documentElement.setAttribute('data-bs-theme', \"light\");\\n\n        document.documentElement.style.colorScheme = \"light\";\\n\n    </script>\\n\n<script>\\n\n    (() => {\\n\n        const preference = \"light\";\\n\n        const media = window.matchMedia('(prefers-color-scheme: dark)');\\n\n\\n\n        const resolve = () => {\\n\n            if (preference === 'dark') return 'dark';\\n\n            if (preference === 'light') return 'light';\\n\n            if (preference === 'system') return media.matches ? 'dark' : 'light';\\n\n            return media.matches ? 'dark' : 'light';\\n\n        };\\n\n\\n\n        const apply = (resolved) => {\\n\n            const isDark = resolved === 'dark';\\n\n            document.documentElement.classList.toggle('dark', isDark);\\n\n            document.documentElement.setAttribute('data-bs-theme', resolved);\\n\n            document.documentElement.style.colorScheme = resolved;\\n\n            // Legacy key kept as last-resolved paint hint only \u2014 never the preference authority.\\n\n            try {\\n\n                localStorage.setItem('ark_theme', resolved);\\n\n                localStorage.removeItem('hs_theme');\\n\n            } catch (_) {}\\n\n        };\\n\n\\n\n        apply(resolve());\\n\n\\n\n        if (preference === 'system') {\\n\n            const onChange = () => apply(resolve());\\n\n            if (typeof media.addEventListener === 'function') {\\n\n                media.addEventListener('change', onChange);\\n\n            } else if (typeof media.addListener === 'function') {\\n\n                media.addListener(onChange);\\n\n            }\\n\n        }\\n\n\\n\n        window.arkApplyDisplayThemePreference = (nextPreference) => {\\n\n            const next = nextPreference === 'dark' || nextPreference === 'light' || nextPreference === 'system'\\n\n                ? nextPreference\\n\n                : 'light';\\n\n            const resolved = next === 'system'\\n\n                ? (media.matches ? 'dark' : 'light')\\n\n                : next;\\n\n            document.documentElement.setAttribute('data-ark-display-theme-preference', next);\\n\n            apply(resolved);\\n\n        };\\n\n\\n\n        document.documentElement.setAttribute('data-ark-display-theme-preference', preference);\\n\n\\n\n        window.arkToggleTheme = () => {\\n\n            const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';\\n\n            window.arkApplyDisplayThemePreference(nextTheme);\\n\n\\n\n            const token = document.querySelector('meta[name=\"csrf-token\"]')?.content;\\n\n            const url = \"http:\\/\\/localhost\\/app\\/profile\\/display-theme\";\\n\n            if (!token || !url) {\\n\n                return;\\n\n            }\\n\n\\n\n            fetch(url, {\\n\n                method: 'PATCH',\\n\n                headers: {\\n\n                    'Content-Type': 'application/json',\\n\n                    Accept: 'application/json',\\n\n                    'X-CSRF-TOKEN': token,\\n\n                },\\n\n                body: JSON.stringify({ display_theme: nextTheme }),\\n\n                credentials: 'same-origin',\\n\n            }).catch(() => {});\\n\n        };\\n\n    })();\\n\n</script>\\n\n                    <meta name=\"ark-comms-interrupt-url\" content=\"http://localhost/app/api/comms/interrupts\">\\n\n            <meta name=\"ark-staff-presence-heartbeat-url\" content=\"http://localhost/app/api/staff/presence/heartbeat\">\\n\n            <meta name=\"ark-incoming-call-dismiss-url\" content=\"http://localhost/app/api/telephony/incoming-call/dismiss\">\\n\n            <meta name=\"ark-website-lead-interrupt-dismiss-url\" content=\"http://localhost/app/api/leads/website-interrupt/dismiss\">\\n\n            <meta name=\"ark-portal-interrupt-dismiss-url\" content=\"http://localhost/app/api/portal/customer-activity-interrupt/dismiss\">\\n\n            <meta name=\"ark-call-queue-url\" content=\"http://localhost/app/api/telephony/call-queue\">\\n\n            <meta name=\"ark-call-queue-mark-worked-url\" content=\"http://localhost/app/api/telephony/call-queue/__CALL_SESSION__/worked\">\\n\n            <meta name=\"ark-call-queue-claim-url\" content=\"http://localhost/app/telephony/calls/__CALL_SESSION__/claim\">\\n\n            <meta name=\"ark-telephony-callback-url\" content=\"http:/