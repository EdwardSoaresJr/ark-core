er\",\"vehicle\",\"inbox\",\"report\"],\"dashboardUrl\":\"http:\\/\\/localhost\\/app\",\"pathPatterns\":[{\"type\":\"intake\",\"pattern\":\"#^app\\/intake\\/new$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/edit$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/estimate-review$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"customer\",\"pattern\":\"#^app\\/customers\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"inbox\",\"pattern\":\"#^app\\/inbox\\/(\\\\d+)$#\",\"id_group\":1}],\"permanentPinned\":[],\"dockedContextual\":[{\"key\":\"intake:service\",\"entityType\":\"intake\",\"entityId\":\"service\",\"route\":\"\\/app\\/intake\\/new\",\"title\":\"Check In\",\"subtitle\":\"\"}],\"excludedWorkspaceKeys\":[\"report:operations\"],\"activityUrl\":\"http:\\/\\/localhost\\/app\\/workspace\\/activity\",\"resetIntake\":false,\"closeIntakeWorkspaceId\":null,\"boot\":null};\\n\n    </script>\\n\n\\n\n                            \\n\n        \\n\n        <main>\\n\n            <div\\n\n    class=\"d-flex flex-column flex-fill ark-split\"\\n\n    data-comms-workspace\\n\n    x-data=\"{ threadOpen: true, contextOpen: false }\"\\n\n    :class=\"{ 'ark-comms-thread-open': threadOpen || contextOpen }\"\\n\n>\\n\n    <div class=\"page-body\">\\n\n    <div class=\"container-fluid d-flex flex-column flex-fill\">\\n\n        <div class=\"alert alert-success flex-shrink-0 mb-2\" role=\"status\">\\n\n                Nudge dismissed.\\n\n            </div>\\n\n\\n\n        <div class=\"d-flex align-items-center gap-2 flex-shrink-0 mb-2\" data-comms-section-bar>\\n\n    <nav class=\"flex-fill overflow-auto ark-comms-lanes\" aria-label=\"Communications sections\" data-comms-section-nav>\\n\n        <ul class=\"nav nav-pills flex-nowrap\">\\n\n                                                <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs\"\\n\n                            title=\"Shop action is due now - reply, overdue follow-up, or unresolved call\"\\n\n                            class=\"nav-link text-nowrap active\"\\n\n                             aria-current=\"page\"                         >\\n\n                            <span>Needs attention</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"needs\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?call=1&amp;filter=waiting\"\\n\n                            title=\"Open - awaiting a customer reply or a follow-up that is not due yet\"\\n\n                            class=\"nav-link text-nowrap\"\\n\n                                                    >\\n\n                            <span>Waiting</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"waiting\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\">\\n\n                        <a\\n\n                            href=\"http://localhost/app/communications/inbox?call=1&amp;filter=resolved\"\\n\n                            title=\"Finished communication work\"\\n\n                            class=\"nav-link text-nowrap\"\\n\n                                                    >\\n\n                            <span>Resolved</span>\\n\n                                                            <span class=\"badge ms-2 bg-secondary-lt\" data-comms-lane-count=\"resolved\">0</span>\\n\n                                                    </a>\\n\n                    </li>\\n\n                                                        <li class=\"nav-item\">\\n\n                    <a\\n\n                        href=\"http://localhost/app/communications/calls\"\\n\n                        class=\"nav-link text-nowrap\"\\n\n                                            >Calls & VM</a>\\n\n                </li>\\n\n                <li class=\"nav-item\">\\n\n                    <a\\n\n                        href=\"http://localhost/app/communications/history\"\\n\n                        class=\"nav-link text-nowrap\"\\n\n                                            >History</a>\\n\n                </li>\\n\n                    </ul>\\n\n    </nav>\\n\n\\n\n            <div class=\"dropdown flex-shrink-0 ms-1\" data-comms-channel-filter>\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                aria-expanded=\"false\"\\n\n                aria-label=\"Channel: All channels\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-sm-1\"><path d=\"M21 14l-3 -3h-7a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1h9a1 1 0 0 1 1 1v10\"/><path d=\"M14 15v2a1 1 0 0 1 -1 1h-7l-3 3v-10a1 1 0 0 1 1 -1h2\"/></svg>\\n\n                <span class=\"d-none d-sm-inline\">All channels</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu dropdown-menu-end\">\\n\n                <span class=\"dropdown-header\">Channel</span>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/communications/inbox?call=1&amp;filter=needs\"\\n\n                        class=\"dropdo