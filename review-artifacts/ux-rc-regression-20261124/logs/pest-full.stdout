entColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                                        Phone\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=sms\" class=\"dropdown-item\" data-ark-inbox-channel=\"sms\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M8 9h8\"/><path d=\"M8 13h6\"/><path d=\"M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12\"/></svg>\\n\n                                        SMS\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=messenger\" class=\"dropdown-item\" data-ark-inbox-channel=\"messenger\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><g transform=\"translate(1.8 1.8) scale(0.85)\"><path vector-effect=\"non-scaling-stroke\" d=\"M3 20l1.3 -3.9a9 8 0 1 1 3.4 2.9l-4.7 1\"/><path vector-effect=\"non-scaling-stroke\" d=\"M8 13l3 -2l2 2l3 -2\"/></g></svg>\\n\n                                        Messenger\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=email\" clas