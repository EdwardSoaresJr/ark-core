a-label=\"Activity\">\\n\n                                                                                                                <a\\n\n                                    href=\"http://localhost/app/repair-orders/1#builder\"\\n\n                                    class=\"ark-job-board-activity-mark\"\\n\n                                    data-job-card-mark=\"estimate\"\\n\n                                    data-job-card-mark-state=\"ready\"\\n\n                                    data-job-board-activity-mark\\n\n                                    data-job-board-activity-link\\n\n                                    role=\"link\"\\n\n                                    title=\"Estimate - Ready\"\\n\n                                    aria-label=\"Estimate - Ready\"\\n\n                                >\\n\n                                    <span class=\"d-inline-flex\" aria-hidden=\"true\" data-job-card-mark-icon>\\n\n                                <svg width=\"16\" height=\"16\" viewBox=\"0 0 20 20\">\\n\n                    <path fill=\"currentColor\" d=\"M6 3.25h5.35L14.75 7.1v9.65H6V3.25Z\"/>\\n\n                </svg>\\n\n                        </span>\\n\n                                </a>\\n\n                                                                        </div>\\n\n                            </div>\\n\n            <span class=\"ms-auto small text-secondary text-nowrap\" data-job-card-clock>1s ago</span>\\n\n        </div>\\n\n    </div>\\n\n</article>\\n\n                    </div>\\n\n    </div>\\n\n            </div>\\n\n\\n\n                    </section>\\n\n    </div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"31Bdz41ngtQ5CPvRduImbHHOTKlwOMkxexaT9K9t\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox\",\"disabled_reason\":null},{\"id\":\"nav.reports\",\"title\":\"Reports\",\"group\":\"Navigate\",\"keywords\":[\"reports\",\"end of day\",\"operational\"],\"url\":\"http:\\/\\/localhost\\/app\\/reports\",\"disabled_reason\":null},{\"id\":\"create.repair-order\",\"title\":\"New Repair Order\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"ro\",\"repair\",\"intake\",\"check in\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.customer\",\"title\":\"New Customer\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"customer\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.vehicle\",\"title\":\"New Vehicle\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\