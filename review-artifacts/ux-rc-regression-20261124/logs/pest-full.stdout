       <div id=\"visit-reason\" class=\"card card-sm mb-3 scroll-mt-6\">\\n\n    <div class=\"card-body\">\\n\n        <div class=\"d-flex align-items-start justify-content-between gap-2\">\\n\n            <div class=\"flex-fill\" style=\"min-width: 0\">\\n\n                <h2 class=\"subheader mb-1\">Reason for Visit</h2>\\n\n                                    <p class=\"mb-0 text-secondary fst-italic\">Not recorded yet.</p>\\n\n                            </div>\\n\n                            <div class=\"btn-list flex-nowrap\">\\n\n                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-sm\"\\n\n                        @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'visit-reason', invokeEl: $event.currentTarget } }))\"\\n\n                    >\\n\n                        Add\\n\n                    </button>\\n\n                </div>\\n\n                    </div>\\n\n\\n\n            </div>\\n\n</div>\\n\n\\n\n                <div id=\"estimate-lines\" class=\"scroll-mt-6\" :class=\"worksheetBusyPending ? 'opacity-75 pe-none' : ''\">\\n\n                    <div class=\"mb-2\">\\n\n    <div class=\"d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-1\">\\n\n        <h2 class=\"subheader mb-0\">Recommended Work</h2>\\n\n        <span id=\"worksheet-count\" class=\"small text-secondary\" data-continuity-region=\"worksheet-count\">1 scopes \u00b7 0 lines</span>\\n\n    </div>\\n\n\\n\n    <div id=\"estimate-instruments\" data-continuity-region=\"authorized-money\">\\n\n    <div class=\"row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2\" aria-label=\"Estimate instruments\" data-estimate-instruments>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100 ops-estimate-instrument-opens-context\"\\n\n                                            data-estimate-context-open=\"portal\"\\n\n                        role=\"button\"\\n\n                        tabindex=\"0\"\\n\n                        @click=\"toggleEstimateContext('portal')\"\\n\n                        @keydown.enter.prevent=\"toggleEstimateContext('portal')\"\\n\n                        @keydown.space.prevent=\"toggleEstimateContext('portal')\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"total\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Customer total</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">$0.00</span>\\n\n                                                                                            </span>\\n\n                                                                                        <span class=\"d-block small text-secondary mt-1\">Customer View</span>\\n\n                                                    </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Estimate total</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Subtotal</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Customer total</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                            </span>\\n\n                            <span class=\"d-block small fw-medium text-secondary border-top mt-2 pt-2\">Customer-facing breakdown</span>\\n\n                    </span>\\n\n    </span>\\n\n                </div>\\n\n            </div>\\n\n                                <div class=\"col\">\\n\n                <div\\n\n                    class=\"h-100\"\\n\n                                    >\\n\n                    <span\\n\n    x-data=\"arkInspectPopover({ above: false, align: 'start' })\"\\n\n    class=\"position-relative card card-sm h-100\" data-instrument=\"margin\"\\n\n    data-inspect-popover\\n\n    data-line-card-ignore\\n\n    @mouseenter=\"enter()\"\\n\n    @mouseleave=\"leave()\"\\n\n    @click=\"toggle($event)\"\\n\n    @click.outside=\"close()\"\\n\n    @keydown.escape.window=\"close()\"\\n\n>\\n\n    <span class=\"card-body d-block\">\\n\n                            <span class=\"subheader d-block mb-1\">Margin</span>\\n\n                            <span class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                <span class=\"h3 mb-0\">n/a</span>\\n\n                                                                    <span class=\"badge bg-secondary-lt\">Unknown</span>\\n\n                                                                                            </span>\\n\n                                                                                </span>\\n\n\\n\n            <span x-show=\"touchMode && open\" x-cloak class=\"offcanvas-backdrop fade show\" @click.stop=\"close()\"></span>\\n\n        <span\\n\n            x-cloak\\n\n            :class=\"panelClasses()\"\\n\n            :style=\"touchMode ? 'max-height: 70dvh' : 'min-width: 11.5rem; max-width: 16rem'\"\\n\n            role=\"tooltip\"\\n\n            data-inspect-popover-panel\\n\n        >\\n\n            <span class=\"d-flex align-items-start gap-2\">\\n\n                                    <span class=\"subheader flex-fill mb-2\">Repair order profitability</span>\\n\n                                <button type=\"button\" class=\"btn-close ms-auto\" x-show=\"touchMode\" x-cloak aria-label=\"Close\" @click.stop=\"close()\"></button>\\n\n            </span>\\n\n            <span class=\"d-block\">\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Parts cost</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">$0.00</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"text-secondary\">Labor cost</span>\\n\n                        <span class=\"fw-bold text-end ark-money\">Assign technician cost</span>\\n\n                    </span>\\n\n                                    <span class=\"d-flex align-items-baseline justify-content-between gap-3 small\">\\n\n                        <span class=\"