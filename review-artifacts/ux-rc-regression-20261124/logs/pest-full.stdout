rk-comms-action-label\">Customer</span>\\n\n                    </button>\\n\n                                            <div class=\"btn-list flex-nowrap\" role=\"group\" aria-label=\"Conversation work\" data-comms-work-actions=\"menu\">\\n\n                    <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\" class=\"d-inline-flex\">\\n\n                <input type=\"hidden\" name=\"_token\" value=\"8JPmymLFOt6WtZONikhV9hiL5CmQZO8xcHzF1xXQ\" autocomplete=\"off\">                <input type=\"hidden\" name=\"action\" value=\"resolve\"><input type=\"hidden\" name=\"filter\" value=\"waiting\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-23T19:11:40+00:00\">\\n\n                <button type=\"submit\" class=\"btn btn-sm btn-success\">\\n\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l5 5l10 -10\"/></svg>\\n\n                    <span class=\"ark-comms-action-label\">Resolve</span>\\n\n                </button>\\n\n            </form>\\n\n                <div class=\"dropdown\">\\n\n            <button type=\"button\" class=\"btn btn-sm dropdown-toggle\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" data-bs-popper-config='{\"strategy\":\"fixed\"}' aria-expanded=\"false\" aria-label=\"Conversation actions\" title=\"Conversation actions\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/><path d=\"M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\"/>