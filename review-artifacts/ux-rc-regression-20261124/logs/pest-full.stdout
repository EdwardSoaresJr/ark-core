hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                                        Email\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=portal\" class=\"dropdown-item\" data-ark-inbox-channel=\"portal\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M3.6 9h16.8\"/><path d=\"M3.6 15h16.8\"/><path d=\"M11.5 3a17 17 0 0 0 0 18\"/><path d=\"M12.5 3a17 17 0 0 1 0 18\"/></svg>\\n\n                                        Portal\\n\n                                    </a>\\n\n                        <div class=\"dropdown-divider\"></div>\\n\n            <a href=\"#\" class=\"dropdown-item\" data-ops-global-search-open>\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                Search conversations\\n\n            </a>\\n\n        </div>\\n\n    </div>\\n\n</nav>\\n\n                                        <div\\n\n        class=\"nav-item d-flex align-items-center\"\\n\n        data-ark-workstation-presence\\n\n        data-locked=\"0\"\\n\n        data-needs-binding=\"0\"\\n\n        data-needs-unlock=\"0\"\\n\n        data-needs-pin-setup=\"0\"\\n\n        data-staff-url=\"http://localhost/app/api/workstation/staff\"\\n\n        data-unlock-url=\"http://localhost/app/workstation/unlock\"\\n\n        data-pin-store-url=\"http://localhost/app/workstation/pin\"\\n\n        data-pin-update-url=\"http://localhost/app/workstation/pin\"\\n\n        data-current-user-id=\"1\"\\n\n        data-lock-url=\"http://localhost/app/workstation/lock\"\\n\n        data-bind-url=\"http://localhost/app/workstation/bind\"\\n\n        data-bind-dismiss-url=\"http://localhost/app/workstation/bind/dismiss\"\\n\n        data-idle-lock-minutes=\"5\"\\n\n        data-station-operator-active=\"0\"\\n\n    >\\n\n        \\n\n        \\n\n        <div data-ws-overlay=\"change-pin\" hidden>\\n\n            <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ws-change-pin-title\" tabindex=\"-1\">\\n\n                <div class=\"modal-backdrop show opacity-100 z-0\" aria-hidden=\"true\"></div>\\n\n                <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                    <form data-ws-change-pin-form class=\"modal-content\" autocomplete=\"off\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                        <div class=\"modal-status bg-primary\"></div>\\n\n                        <div class=\"modal-header\">\\n\n                            <div class=\"overflow-hidden\">\\n\n                                <h2 class=\"modal-title\" id=\"ws-change-pin-title\">Change station PIN</h2>\\n\n                                <div class=\"small text-secondary text-truncate\">Earline O&#039;Conner</div>\\n\n                            </div>\\n\n                            <button type=\"button\" class=\"btn-close\" data-ws-action=\"close-overlay\" aria-label=\"Close\"></button>\\n\n                        </div>\\n\n                        <div class=\"modal-body\">\\n\n                            <p class=\"text-secondary\">Choose a new 4-digit PIN. Confirm with your ARK password.</p>\\n\n                            <div class=\"mb-3\">\\n\n                                <label class=\"form-label\" for=\"ws-change-pin-password\">Current password</label>\\n\n                                <input\\n\n                                    id=\"ws-change-pin-password\"\\n\n                                    type=\"password\"\\n\n                                    name=\"password\"\\n\n                                    required\\n\n                                    autocomplete=\"current-password\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            \\n\n                            <div class=\"mb-3\">\\n\n                                <label class=\"form-label\" for=\"ws-change-pin-new\">New PIN</label>\\n\n                                <input\\n\n                                    id=\"ws-change-pin-new\"\\n\n                                    type=\"tel\"\\n\n                                    name=\"pin\"\\n\n                                    required\\n\n                                    maxlength=\"4\"\\n\n                                    pattern=\"\\d{4}\"\\n\n                                    inputmode=\"numeric\"\\n\n                                    autocomplete=\"one-time-code\"\\n\n                                    data-ws-pin-field\\n\n                                    data-lpignore=\"true\"\\n\n                                    data-1p-ignore\\n\n                                    class=\"form-control font-monospace\"\\n\n                                    style=\"-webkit-text-security: disc\"\\n\n                                >\\n\n                            </div>\\n\n                            <div>\\n\n                                <label class=\"form-label\" for=\"ws-change-pin-confirm\">Confirm PIN</label>\\n\n                                <input\\n\n                                    id=\"ws-change-pin-confirm\"\\n\n                                    type=\"tel\"\\n\n                                    name=\"pin_confirmation\"\\n\n                                    required\\n\n                                    maxlength=\"4\"\\n\n                                    pattern=\"\\d{4}\"\\n\n                                    inputmode=\"numeric\"\\n\n                                    autocomplete=\"one-time-code\"\\n\n                                    data-ws-pin-field\\n\n                                    data-lpignore=\"true\"\\n\n                                    data-1p-ignore\\n\n                                    class=\"form-control font-monospace\"\\n\n                                    style=\"-webkit-text-security: disc\"\\n\n                                >\\n\n                            </div>\\n\n                            <div data-ws-change-pin-error class=\"alert alert-danger mt-3 mb-0\" role=\"alert\" hidden></div>\\n\n                        </div>\\n\n                        <div class=\"modal-footer\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary w-100\">Save PIN</button>\\n\n                        </div>\\n\n                    </form>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div data-ws-overlay=\"switch-station\" hidden>\\n\n            <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ws-switch-station-title\" tabindex=\"-1\">\\n\n                <div class=\"modal-backdrop show opacity-100 z-0\" aria-hidden=\"true\"></div>\\n\n                <div class=\"modal-dialog modal-dialog-centered modal-dialog-scrollable modal-sm\">\\n\n                    <form data-ws-switch-station-form class=\"modal-content\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                        <div class=\"modal-status bg-primary\"></div>\\n\n                        <div class=\"modal-header\">\\n\n                            <div>\\n\n                                <h2 class=\"modal-title\" id=\"ws-switch-station-title\">Switch station</h2>\\n\n                                <div class=\"small text-secondary\">Where are you working?</div>\\n\n                            </div>\\n\n                            <button type=\"button\" class=\"btn-close\" data-ws-action=\"close-overlay\" aria-label=\"Close\"></button>\\n\n                        </div>\\n\n                        <div class=\"modal-body\">\\n\n                            <div class=\"list-group\">\\n\n                                                            </div>\\n\n                        </div>\\n\n                        <div class=\"modal-footer\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary w-100\">Switch station</button>\\n\n                        </div>\\n\n                    </form>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                    <div class=\"nav-item dropdown\">\\n\n        <a\\n\n            href=\"#\"\\n\n            class=\"nav-link d-flex lh-1 p-0 px-2\"\\n\n            data-bs-toggle=\"dropdown\"\\n\n            aria-expanded=\"false\"\\n\n            aria-label=\"Account menu for Earline O&#039;Conner\"\\n\n            title=\"Earline O&#039;Conner \u00b7 admin\"\\n\n        >\\n\n            <span class=\"avatar avatar-sm text-white\" style=\"background-color: #0099cc\">EO</span>\\n\n            <span class=\"d-none d-xl-block ps-2\">\\n\n                <span class=\"d-block\">Earline O&#039;Conner</span>\\n\n                                    <span class=\"d-block mt-1 small text-secondary\">admin</span>\\n\n                            </span>\\n\n        </a>\\n\n        <div class=\"dropdown-menu dropdown-menu-end dropdown-menu-arrow\">\\n\n            <span class=\"dropdown-item-text small text-secondary\">moses88@example.org</span>\\n\n\\n\n                                                    <a href=\"http://localhost/app/profile\" class=\"dropdown-item\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0\"/><path d=\"M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2\"/></svg>\\n\n                            Profile\\n\n                        </a>\\n\n                                                                            <button type=\"button\" class=\"dropdown-item\" onclick=\"window.arkToggleTheme()\">\\n\n                            <span class=\"hide-theme-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008\"/></svg>\\n\nDark mode</span>\\n\n                            <span class=\"hide-theme-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0\"/><path d=\"M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7\"/></svg>\\n\nLight mode</span>\\n\n                        </button>\\n\n                                                                            <div class=\"dropdown-divider\"></div>\\n\n\\n\n                        <form method=\"POST\" action=\"http://localhost/app/logout\">\\n\n                            <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                            <button type=\"submit\" class=\"dropdown-item text-danger\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2\"/><path d=\"M9 12h12l-3 -3\"/><path d=\"M18 15l3 -3\"/></svg>\\n\n                                Sign out\\n\n                            </button>\\n\n                        </form>\\n\n                                            </div>\\n\n    </div>\\n\n                </div>\\n\n            </div>\\n\n        </header>\\n\n\\n\n        <div\\n\n            id=\"ops-workspace-tabs\"\\n\n            class=\"ark-workspace-tabs d-none d-print-none border-bottom bg-surface\"\\n\n            data-workspace-tabs\\n\n            data-workspace-tabs-ui=\"tabler\"\\n\n            data-ark-workspace-dirty=\"off\"\\n\n            aria-label=\"Workspaces\"\\n\n            aria-hidden=\"true\"\\n\n        ></div>\\n\n    \\n\n    <script>\\n\n        window.__ARK_WORKSPACE__ = {\"enabled\":true,\"maxTabs\":12,\"tabMinWidth\":176,\"desktopMinWidth\":1024,\"persistLocal\":true,\"interceptLinks\":true,\"storageKey\":\"ark_ws_v2_1\",\"types\":[\"intake\",\"repair_order\",\"customer\",\"vehicle\",\"inbox\",\"report\"],\"dashboardUrl\":\"http:\\/\\/localhost\\/app\",\"pathPatterns\":[{\"type\":\"intake\",\"pattern\":\"#^app\\/intake\\/new$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/edit$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/estimate-review$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"customer\",\"pattern\":\"#^app\\/customers\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"inbox\",\"pattern\":\"#^app\\/inbox\\/(\\\\d+)$#\",\"id_group\":1}],\"permanentPinned\":[],\"dockedContextual\":[{\"key\":\"intake:service\",\"entityType\":\"intake\",\"entityId\":\"service\",\"route\":\"\\/app\\/intake\\/new\",\"title\":\"Check In\",\"subtitle\":\"\"}],\"excludedWorkspaceKeys\":[\"report:operations\"],\"activityUrl\":\"http:\\/\\/localhost\\/app\\/workspace\\/activity\",\"resetIntake\":false,\"closeIntakeWorkspaceId\":null,\"boot\":null};\\n\n    </script>\\n\n\\n\n                            \\n\n        \\n\n        <main>\\n\n            <div class=\"page-body\">\\n\n    <div class=\"container-fluid\">\\n\n        <section\\n\n        data-shop-settings\\n\n        x-data=\"{\\n\n            active: (() => {\\n\n                const candidate = null || new URLSearchParams(window.location.search).get('section') || localStorage.getItem('ark:shop-settings:section') || 'general';\\n\n\\n\n                if (candidate === 'dragon-memory' || candidate === 'ark-cloud' || (candidate === 'communications' && !true)) {\\n\n                    return 'general';\\n\n                }\\n\n\\n\n                return candidate;\\n\n            })(),\\n\n            financialTab: (() => {\\n\n                const fromUrl = new URLSearchParams(window.location.search).get('financial-tab');\\n\n\\n\n                // Retired Financial \u2192 Billing Classes tab (#180): deep links land on Labor.\\n\n                if (fromUrl === 'billing-classes' || fromUrl === 'customer-types' || fromUrl === 'customer-tags' || fromUrl === 'labor-policies') {\\n\n                    return 'labor';\\n\n                }\\n\n\\n\n                if (['labor', 'tax', 'shop-fees', 'deposits', 'parts'].includes(fromUrl)) {\\n\n                    return fromUrl;\\n\n                }\\n\n\\n\n                const stored = localStorage.getItem('ark:shop-settings:financial-tab') || 'labor';\\n\n\\n\n                if (stored === 'labor-policies' || stored === 'billing-classes' || stored === 'customer-types' || stored === 'customer-tags') {\\n\n                    return 'labor';\\n\n                }\\n\n\\n\n                return stored;\\n\n            })(),\\n\n            printingTab: localStorage.getItem('ark:shop-settings:printing-tab') || 'printers',\\n\n            communicationsTab: (() => {\\n\n                const fromUrl = new URLSearchParams(window.location.search).get('communications-tab');\\n\n\\n\n                if (fromUrl) {\\n\n                    return fromUrl;\\n\n                }\\n\n\\n\n                return localStorage.getItem('ark:shop-settings:communications-tab') || 'general';\\n\n            })(),\\n\n            workflowTab: (() => {\\n\n                const fromUrl = new URLSearchParams(window.location.search).get('workflow-tab');\\n\n\\n\n                if (fromUrl === 'defaults' || fromUrl === 'statuses' || fromUrl === 'inspections' || fromUrl === 'saved-work') {\\n\n                    return fromUrl;\\n\n                }\\n\n\\n\n                return localStorage.getItem('ark:shop-settings:workflow-tab') || 'defaults';\\n\n            })(),\\n\n            nextCustomerTypeIndex: 9,\\n\n            setActive(section) {\\n\n                this.active = section;\\n\n                localStorage.setItem('ark:shop-settings:section', section);\\n\n                const url = new URL(window.location.href);\\n\n                url.searchParams.set('section', section);\\n\n                window.history.replaceState({}, '', url);\\n\n            },\\n\n            init() {\\n\n                const fromUrl = new URLSearchParams(window.location.search).get('financial-tab');\\n\n                if (fromUrl === 'billing-classes' || fromUrl === 'customer-types' || fromUrl === 'customer-tags') {\\n\n                    const url = new URL(window.location.href);\\n\n                    url.searchParams.set('section', 'financial');\\n\n                    url.searchParams.set('financial-tab', 'labor');\\n\n                    url.searchParams.delete('manage-billing-classes');\\n\n                    window.history.replaceState({}, '', url);\\n\n                    localStorage.setItem('ark:shop-settings:financial-tab', 'labor');\\n\n                }\\n\n            },\\n\n            setFinancialTab(tab) {\\n\n                if (tab === 'billing-classes' || tab === 'customer-types' || tab === 'customer-tags') {\\n\n                    this.financialTab = 'labor';\\n\n                    localStorage.setItem('ark:shop-settings:financial-tab', 'labor');\\n\n                    const url = new URL(window.location.href);\\n\n                    url.searchParams.set('financial-tab', 'labor');\\n\n                    url.searchParams.delete('manage-billing-classes');\\n\n                    window.history.replaceState({}, '', url);\\n\n                    return;\\n\n                }\\n\n                this.financialTab = tab;\\n\n                localStorage.setItem('ark:shop-settings:financial-tab', tab);\\n\n                const url = new URL(window.location.href);\\n\n                url.searchParams.set('financial-tab', tab);\\n\n                url.searchParams.delete('manage-billing-classes');\\n\n                window.history.replaceState({}, '', url);\\n\n            },\\n\n            setPrintingTab(tab) {\\n\n                this.printingTab = tab;\\n\n                localStorage.setItem('ark:shop-settings:printing-tab', tab);\\n\n            },\\n\n            setCommunicationsTab(tab) {\\n\n                this.communicationsTab = tab;\\n\n                localStorage.setItem('ark:shop-settings:communications-tab', tab);\\n\n                const url = new URL(window.location.href);\\n\n                url.searchParams.set('communications-tab', tab);\\n\n                window.history.replaceState({}, '', url);\\n\n            },\\n\n            setWorkflowTab(tab) {\\n\n                this.workflowTab = tab;\\n\n                localStorage.setItem('ark:shop-settings:workflow-tab', tab);\\n\n                const url = new URL(window.location.href);\\n\n                url.searchParams.set('workflow-tab', tab);\\n\n                window.history.replaceState({}, '', url);\\n\n            },\\n\n        }\"\\n\n    >\\n\n                        <p class=\"text-secondary small\">Labor rates and the Parts Matrix save as you edit. Tax, Shop Fees, Deposits, and Class Settings use their own Save buttons.</p>\\n\n\\n\n        <div class=\"row g-3\">\\n\n            <div class=\"col-12 d-lg-none\">\\n\n    <label for=\"settings-section\" class=\"form-label\">Section</label>\\n\n            <select id=\"settings-section\" class=\"form-select\" :value=\"active\" @change=\"$event.target.selectedOptions[0].dataset.href ? window.location.assign($event.target.selectedOptions[0].dataset.href) : setActive($event.target.value)\">\\n\n                            <optgroup label=\"Basic\">\\n\n                                            <option value=\"general\" >Shop Identity</option>\\n\n                                            <option value=\"operations\" >Appointments &amp; Setup</option>\\n\n                                            <option value=\"staff\" >Staff</option>\\n\n                                            <option value=\"financial\" >Financial Rules</option>\\n\n                                            <option value=\"estimates\" >Documents / Disclaimers</option>\\n\n                                    </optgroup>\\n\n                            <optgroup label=\"Optional\">\\n\n                                            <option value=\"booking\"  data-href=\"http://localhost/app/settings/booking\" >Online Requests</option>\\n\n                                            <option value=\"payments\" >Payment methods</option>\\n\n                                            <option value=\"partstech\" >Parts catalogs</option>\\n\n                                            <option value=\"communications\" >Communications</option>\\n\n                                    </optgroup>\\n\n                            <optgroup label=\"Advanced\">\\n\n                                            <option value=\"overhead\" >Shop Overhead</option>\\n\n                                            <option value=\"excellence\" >Owner Targets &amp; Reporting</option>\\n\n                                            <option value=\"workflow\" >Workflow Defaults</option>\\n\n                                            <option value=\"printing\" >Label Printing</option>\\n\n                                            <option value=\"stations\"  data-href=\"http://localhost/app/shop/communications\" >Stations &amp; Phones</option>\\n\n                                    </optgroup>\\n\n                    </select>\\n\n    </div>\\n\n<div class=\"col-12 col-lg-3 col-xxl-2 d-none d-lg-block\">\\n\n    <nav class=\"card sticky-lg-top\" style=\"top: 1rem\" aria-label=\"Shop settings sections\">\\n\n                    <div class=\"card-header py-2\">\\n\n                <div class=\"subheader text-uppercase fw-semibold\" style=\"font-weight: 600; letter-spacing: .04em;\">Basic</div>\\n\n            </div>\\n\n            <div class=\"list-group list-group-flush\">\\n\n                                                            <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'general' }\"\\n\n                            :aria-current=\"active === 'general' ? 'page' : null\"\\n\n                            @click=\"setActive('general')\"\\n\n                        >Shop Identity</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'operations' }\"\\n\n                            :aria-current=\"active === 'operations' ? 'page' : null\"\\n\n                            @click=\"setActive('operations')\"\\n\n                        >Appointments &amp; Setup</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'staff' }\"\\n\n                            :aria-current=\"active === 'staff' ? 'page' : null\"\\n\n                            @click=\"setActive('staff')\"\\n\n                        >Staff</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'financial' }\"\\n\n                            :aria-current=\"active === 'financial' ? 'page' : null\"\\n\n                            @click=\"setActive('financial')\"\\n\n                        >Financial Rules</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'estimates' }\"\\n\n                            :aria-current=\"active === 'estimates' ? 'page' : null\"\\n\n                            @click=\"setActive('estimates')\"\\n\n                        >Documents / Disclaimers</button>\\n\n                                                </div>\\n\n                    <div class=\"card-header py-2\">\\n\n                <div class=\"subheader text-uppercase fw-semibold\" style=\"font-weight: 600; letter-spacing: .04em;\">Optional</div>\\n\n            </div>\\n\n            <div class=\"list-group list-group-flush\">\\n\n                                                            <a href=\"http://localhost/app/settings/booking\" class=\"list-group-item list-group-item-action\">Online Requests</a>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'payments' }\"\\n\n                            :aria-current=\"active === 'payments' ? 'page' : null\"\\n\n                            @click=\"setActive('payments')\"\\n\n                        >Payment methods</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'partstech' }\"\\n\n                            :aria-current=\"active === 'partstech' ? 'page' : null\"\\n\n                            @click=\"setActive('partstech')\"\\n\n                        >Parts catalogs</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'communications' }\"\\n\n                            :aria-current=\"active === 'communications' ? 'page' : null\"\\n\n                            @click=\"setActive('communications')\"\\n\n                        >Communications</button>\\n\n                                                </div>\\n\n                    <div class=\"card-header py-2\">\\n\n                <div class=\"subheader text-uppercase fw-semibold\" style=\"font-weight: 600; letter-spacing: .04em;\">Advanced</div>\\n\n            </div>\\n\n            <div class=\"list-group list-group-flush\">\\n\n                                                            <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'overhead' }\"\\n\n                            :aria-current=\"active === 'overhead' ? 'page' : null\"\\n\n                            @click=\"setActive('overhead')\"\\n\n                        >Shop Overhead</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'excellence' }\"\\n\n                            :aria-current=\"active === 'excellence' ? 'page' : null\"\\n\n                            @click=\"setActive('excellence')\"\\n\n                        >Owner Targets &amp; Reporting</button>\\n\n                                                                                <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            :class=\"{ 'active': active === 'workflow' }\"\\n\n                            :aria-current=\"active === 'workflow' ? 'page' : null\"\\n\n                            @click=\"setActive('workflow')\"\\n\n                        >Workflow Defaults</button>\\n\n                                                                                <button\\n\n       