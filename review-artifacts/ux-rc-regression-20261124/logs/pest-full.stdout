                                                  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon ms-auto text-primary\"><path d=\"M5 12l5 5l10 -10\"/></svg>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Technician is actively working this scope.\"\\n\n                        data-production-option=\"in_progress\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.production_status.value = 'in_progress'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-azure me-2\"><path d=\"M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5\"/></svg>\\n\n                        <span class=\"me-3\">In progress</span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Scope is blocked on parts or an outside dependency.\"\\n\n                        data-production-option=\"waiting_parts\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.production_status.value = 'waiting_parts'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-yellow me-2\"><path d=\"M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5\"/><path d=\"M12 12l8 -4.5\"/><path d=\"M12 12l0 9\"/><path d=\"M12 12l-8 -4.5\"/><path d=\"M16 5.25l-8 4.5\"/></svg>\\n\n                        <span class=\"me-3\">Waiting parts</span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"This scope is finished - independent of other scopes on the RO.\"\\n\n                        data-production-option=\"completed\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.production_status.value = 'completed'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-green me-2\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M9 12l2 2l4 -4\"/></svg>\\n\n                        <span class=\"me-3\">Completed</span>\\n\n                                            </button>\\n\n                                                    \\n\n                    <div class=\"dropdown-divider\"></div>\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        data-authorization-exception-action=\"record\"\\n\n                        aria-haspopup=\"dialog\"\\n\n                        @click=\"window.dispatchEvent(new CustomEvent('ark-authorization-exception-open', { detail: { concernId: 1, mode: 'record', invokeEl: $el.closest('.dropdown')?.querySelector('[data-bs-toggle]') ?? $el } }))\"\\n\n                    >\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-yellow me-2\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\"/><path d=\"M9 17h6\"/><path d=\"M9 13h6\"/></svg>\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Record exception</span>\\n\n                            <span class=\"small text-secondary\">Not customer-approved</span>\\n\n                        </span>\\n\n                    </button>\\n\n                            </div>\\n\n        </div>\\n\n    </form>\\n\n        </div>\\n\n        <form\\n\n        method=\"POST\"\\n\n        action=\"http://localhost/app/repair-orders/1/concerns/1/billing-posture\"\\n\n        data-refresh-scope=\"worksheet\"\\n\n        data-continuity-focus=\"#concern-1 [data-concern-billing-choices] .dropdown-toggle\"\\n\n        @submit.prevent=\"submitWorksheetForm($event)\"\\n\n    >\\n\n        <input type=\"hidden\" name=\"_token\" value=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\" autocomplete=\"off\">        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n        <input type=\"hidden\" name=\"billing_posture\" value=\"customer_pay\">\\n\n        <div class=\"dropdown\" data-concern-billing-choices>\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                aria-expanded=\"false\"\\n\n                aria-label=\"Billing for Drivetrain noise: Retail (Customer default), $165.00/hr \u00b7 AFT Parts \u00b7 No shop fees\"\\n\n                title=\"Retail (Customer default) \u00b7 Customer pays; shop fees apply on eligible lines at the shop rate. \u00b7 $165.00/hr labor \u00b7 AFT Parts parts \u00b7 No shop fees\"\\n\n                data-billing-current=\"customer_pay\"\\n\n                data-billing-source=\"customer\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-1\"><path d=\"M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16l-3 -2l-2 2l-2 -2l-2 2l-2 -2l-3 2m4 -14h6m-6 4h6m-2 4h2\"/></svg>\\n\n                <span class=\"fw-medium\">Retail (Customer default)</span>\\n\n            </button>\\n\n            <div class=\"dropdown-menu\">\\n\n                <h6 class=\"dropdown-header\">Billing</h6>\\n\n                                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Retail \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"customer_pay\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'customer_pay'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Retail</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 AFT Parts \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Fleet \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"fleet\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'fleet'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Fleet</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 AFT Parts \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Warranty \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"warranty_other\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'warranty_other'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Warranty</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"RepairPal \u00b7 $150.00/hr\"\\n\n                        data-billing-option=\"repairpal\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'repairpal'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>RepairPal</span>\\n\n                            <span class=\"small text-secondary\">$150.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Internal \u00b7 $0.00/hr\"\\n\n                        data-billing-option=\"internal\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'internal'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Internal</span>\\n\n                            <span class=\"small text-secondary\">$0.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Wholesale \u00b7 $165.00/hr\"\\n\n                        data-billing-option=\"wholesale\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'wholesale'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Wholesale</span>\\n\n                            <span class=\"small text-secondary\">$165.00/hr \u00b7 AFT Parts \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                                                        <button\\n\n                        type=\"button\"\\n\n                        class=\"dropdown-item\"\\n\n                        title=\"Comeback \u00b7 $0.00/hr\"\\n\n                        data-billing-option=\"comeback\"\\n\n                                                    @click=\"preserveRepairOrderConcernScroll(1); $el.form.elements.billing_posture.value = 'comeback'; $el.form.requestSubmit()\"\\n\n                                            >\\n\n                        <span class=\"d-flex flex-column me-3\">\\n\n                            <span>Comeback</span>\\n\n                            <span class=\"small text-secondary\">$0.00/hr \u00b7 Warranty (No Markup) \u00b7 No shop fees</span>\\n\n                        </span>\\n\n                                            </button>\\n\n                            </div>\\n\n        </div>\\n\n    </form>\\n\n        <div class=\"dropdown\" data-concern-warranty-choices>\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"btn btn-sm dropdown-toggle\"\\n\n            data-bs-toggle=\"dropdown\"\\n\n            data-bs-auto-close=\"outside\"\\n\n            aria-expanded=\"false\"\\n\n            aria-label=\"Warranty for Drivetrain noise: 24-month / 24,000-mile parts and labor\"\\n\n            title=\"24-month / 24,000-mile parts and labor\"\\n\n            data-warranty-source=\"shop\"\\n\n            data-warranty-inherits=\"1\"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon text-secondary me-1\"><path d=\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\"/><path d=\"M9 12l2 2l4 -4\"/></svg>\\n\n            <span class=\"fw-medium\">Warranty</span>\\n\n            <span class=\"small text-secondary ms-1 d-none d-xl-inline\">24-month / 24,000-mile parts...</span>\\n\n        </button>\\n\n        <div class=\"dropdown-menu dropdown-menu-card p-3\" style=\"min-width: 18rem;\">\\n\n            <div class=\"mb-2\">\\n\n                <div class=\"subheader mb-1\">Effective warranty</div>\\n\n                <div class=\"small\">24-month / 24,000-mile parts and labor</div>\\n\n                <div class=\"form-hint mb-0\">\\n\n                                            Inherited from the billing class on this repair order\u2019s frozen pricing.\\n\n                                    </div>\\n\n            </div>\\n\n\\n\n            \\n\n            <form\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/repair-orders/1/concerns/1/warranty\"\\n\n                data-refresh-scope=\"worksheet\"\\n\n                data-continuity-focus=\"#concern-1 [data-concern-warranty-choices] .dropdown-toggle\"\\n\n                @submit.prevent=\"submitWorksheetForm($event)\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\" autocomplete=\"off\">                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                <input type=\"hidden\" name=\"action\" value=\"override\">\\n\n                <div class=\"subheader mb-2\">Override for this concern</div>\\n\n                <div class=\"row g-2 mb-2\">\\n\n                    <div class=\"col-6\">\\n\n                        <label class=\"form-label mb-1\">Months</label>\\n\n                        <input type=\"number\" min=\"0\" name=\"warranty[months]\" class=\"form-control form-control-sm\" value=\"24\">\\n\n                    </div>\\n\n                    <div class=\"col-6\">\\n\n                        <label class=\"form-label mb-1\">Miles</label>\\n\n                        <input type=\"number\" min=\"0\" name=\"warranty[miles]\" class=\"form-control form-control-sm\" value=\"24000\">\\n\n                    </div>\\n\n                    <div class=\"col-12\">\\n\n                        <label class=\"form-check\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" name=\"warranty[covers_parts]\" value=\"1\" checked>\\n\n                            <span class=\"form-check-label\">Covers parts</span>\\n\n                        </label>\\n\n                        <label class=\"form-check\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" name=\"warranty[covers_labor]\" value=\"1\" checked>\\n\n                            <span class=\"form-check-label\">Covers labor</span>\\n\n                        </label>\\n\n                        <label class=\"form-check\">\\n\n                            <input class=\"form-check-input\" type=\"checkbox\" name=\"warranty[third_party]\" value=\"1\" >\\n\n                            <span class=\"form-check-label\">Third-party</span>\\n\n                        </label>\\n\n                    </div>\\n\n                    <div class=\"col-12\">\\n\n                        <label class=\"form-label mb-1\">Description</label>\\n\n                        <textarea name=\"warranty[description]\" class=\"form-control form-control-sm\" rows=\"2\">Shop warranty on parts and labor for the covered repair.</textarea>\\n\n                    </div>\\n\n                    <div class=\"col-12\">\\n\n                        <label class=\"form-label mb-1\">Exclusions</label>\\n\n                        <textarea name=\"warranty[exclusions]\" class=\"form-control form-control-sm\" rows=\"2\">Customer-supplied and used parts may carry no warranty. Normal wear items and abuse are excluded.</textarea>\\n\n                    </div>\\n\n                </div>\\n\n                <button type=\"submit\" class=\"btn btn-primary btn-sm w-100\" data-warranty-action=\"override\">\\n\n                    Save concern warranty\\n\n                </button>\\n\n            </form>\\n\n        </div>\\n\n    </div>\\n\n    </div>\\n\n    <div class=\"d-flex flex-wrap align-items-center gap-1\">\\n\n                <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/concerns/1/move\" data-refresh-scope=\"worksheet\" data-continuity-focus=\"#concern-1 button[name='move-up']\" @submit.prevent=\"submitWorksheetForm($event)\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n            <input type=\"hidden\" name=\"direction\" value=\"up\">\\n\n            <button type=\"submit\" name=\"move-up\" disabled class=\"btn btn-sm btn-icon btn-ghost-secondary\" aria-label=\"Move scope up\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 11l-6 -6\"/><path d=\"M6 11l6 -6\"/></svg>\\n\n            </button>\\n\n        </form>\\n\n        <form method=\"POST\" action=\"http://localhost/app/repair-orders/1/concerns/1/move\" data-refresh-scope=\"worksheet\" data-continuity-focus=\"#concern-1 button[name='move-down']\" @submit.prevent=\"submitWorksheetForm($event)\">\\n\n            <input type=\"hidden\" name=\"_token\" value=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\" autocomplete=\"off\">            <input type=\"hidden\" name=\"_method\" value=\"PATCH\">            <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n            <input type=\"hidden\" name=\"direction\" value=\"down\">\\n\n            <button type=\"submit\" name=\"move-down\" disabled class=\"btn btn-sm btn-icon btn-ghost-secondary\" aria-label=\"Move scope down\">\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n            </button>\\n\n        </form>\\n\n                                    <form\\n\n                    method=\"POST\"\\n\n                    action=\"http://localhost/app/repair-orders/1/concerns/1/move-to-new-ro\"\\n\n                    onsubmit=\"return confirm('Move this entire scope and all its lines to a new draft repair order for the same vehicle?')\"\\n\n                >\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                    <button\\n\n                        type=\"submit\"\\n\n                        class=\"btn btn-sm btn-ghost-secondary\"\\n\n                        title=\"Move this complete scope onto a new draft repair order\"\\n\n                    >\\n\n                        Move to new RO\\n\n                    </button>\\n\n                </form>\\n\n                                                                    <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm btn-ghost-secondary\"\\n\n                    disabled\\n\n                    aria-disabled=\"true\"\\n\n                    aria-label=\"Cannot delete concern\"\\n\n                    title=\"Delete or move concern lines before deleting the concern.\"\\n\n                >\\n\n                    Cannot delete\\n\n                </button>\\n\n                <span class=\"text-secondary small text-wrap\" style=\"max-width: 16rem;\">Delete or move concern lines before deleting the concern.</span>\\n\n                        </div>\\n\n</div>\\n\n        </div>\\n\n    \\n\n                                <div id=\"concern-narrative-1\" class=\"card-body border-bottom\" data-concern-narrative>\\n\n    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2\">\\n\n        <h4 class=\"subheader mb-0\">Narrative</h4>\\n\n                    <div class=\"btn-list\">\\n\n                                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'concern-narrative', context: { concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    Edit\\n\n                </button>\\n\n            </div>\\n\n            </div>\\n\n\\n\n    <div class=\"d-flex align-items-start justify-content-between gap-2\">\\n\n        <p class=\"fw-medium mb-2\">Drivetrain noise</p>\\n\n                                </div>\\n\n\\n\n            <p class=\"text-secondary mb-0\">No customer story or findings recorded yet.</p>\\n\n    \\n\n    <p class=\"small text-secondary mt-2 mb-0\">\\n\n            Faster with evidence?\\n\n            <a href=\"http://localhost/app/repair-orders/1/inspection?capture=1&amp;concern=1\">Open Inspection</a>\\n\n            - photo and measurement beat prose alone.\\n\n        </p>\\n\n    \\n\n    </div>\\n\n\\n\n                                <div id=\"concern-lines-1\" class=\"list-group list-group-flush\">\\n\n            <div class=\"list-group-item ark-line-grid d-none d-md-grid py-2 subheader text-nowrap\">\\n\n    <span>Scope lines</span>\\n\n    <span class=\"text-end\">Qty/Hrs</span>\\n\n    <span class=\"text-end\">Price</span>\\n\n    <span class=\"text-end\">Subtotal</span>\\n\n    <span class=\"text-end\">Fees</span>\\n\n    <span class=\"text-end\">Tax</span>\\n\n    <span class=\"text-end\">Total</span>\\n\n</div>\\n\n    \\n\n            <div\\n\n    id=\"line-1\"\\n\n    data-continuity-region=\"line\"\\n\n    data-line-type=\"labor\"\\n\n        class=\"list-group-item scroll-mt-24 list-group-item-action\"\\n\n            @click=\"\\n\n            if ($event.target.closest('[data-line-card-ignore], a, button, select, input, textarea, summary, label')) {\\n\n                return;\\n\n            }\\n\n\\n\n            const editLink = $el.querySelector('[data-line-edit-trigger]');\\n\n\\n\n            if (editLink && typeof editLine === 'function') {\\n\n                editLine({ preventDefault() {}, currentTarget: editLink });\\n\n            }\\n\n        \"\\n\n        @keydown.enter.prevent=\"\\n\n            const editLink = $el.querySelector('[data-line-edit-trigger]');\\n\n            if (editLink && typeof editLine === 'function') {\\n\n                editLine({ preventDefault() {}, currentTarget: editLink });\\n\n            }\\n\n        \"\\n\n        @keydown.space.prevent=\"\\n\n            const editLink = $el.querySelector('[data-line-edit-trigger]');\\n\n            if (editLink && typeof editLine === 'function') {\\n\n                editLine({ preventDefault() {}, currentTarget: editLink });\\n\n            }\\n\n        \"\\n\n    >\\n\n        <div class=\"ark-line-grid\">\\n\n        <div style=\"min-width: 0\">\\n\n            <div class=\"d-flex align-items-start gap-2\">\\n\n                <div class=\"flex-fill\" style=\"min-width: 0\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                        <span class=\"subheader text-green\">Labor</span>\\n\n                                                                    </div>\\n\n                    <div class=\"fw-medium text-truncate\">Inspect driveshaft</div>\\n\n                </div>\\n\n                                    <a\\n\n                        href=\"http://localhost/app/repair-orders/1?editing_line=1\"\\n\n                        data-line-edit-trigger\\n\n                        data-line-card-ignore\\n\n                        data-refresh-scope=\"worksheet\"\\n\n                        data-continuity-focus=\"#line-update-1 [name='description']\"\\n\n                        @click.stop=\"typeof editLine === 'function' ? editLine($event) : null\"\\n\n                        class=\"btn btn-sm btn-ghost-secondary\"\\n\n                        aria-label=\"Edit Inspect driveshaft\"\\n\n                    >Edit</a>\\n\n                                <div class=\"fw-bold text-nowrap d-md-none\">$150.00</div>\\n\n            </div>\\n\n\\n\n            \\n\n            <div class=\"small text-secondary mt-1\">\\n\n                <span>Qty 1.00</span>\\n\n                <span class=\"mx-1\" aria-hidden=\"true\">\u2022</span>\\n\n                <span>Price $150.00</span>\\n\n                            </div>\\n\n\\n\n            \\n\n                    </div>\\n\n\\n\n        <div class=\"ark-line-ledger\" data-line-ledger>\\n\n            <div>\\n\n                <div class=\"subheader d-md-none\">Qty/Hrs</div>\\n\n                <div>1.00</div>\\n\n            </div>\\n\n\\n\n            <div>\\n\n                <div class=\"subheader d-md-none\">Price</div>\\n\n                <div>$150.00</div>\\n\n            </div>\\n\n\\n\n            <div class=\"d-none d-md-block\">\\n\n                <div>$150.00</div>\\n\n            </div>\\n\n\\n\n            <div class=\"d-none d-md-block\">\\n\n                <div class=\"text-secondary\">-</div>\\n\n            </div>\\n\n\\n\n            <div class=\"d-none d-md-block\">\\n\n                <div class=\"text-secondary\">-</div>\\n\n            </div>\\n\n\\n\n            <div>\\n\n                <div class=\"subheader d-md-none\">Total</div>\\n\n                                    <div class=\"fw-bold\">$150.00</div>\\n\n                            </div>\\n\n        </div>\\n\n        \\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    \\n\n            \\n\n                <div class=\"card-body py-2 btn-list\" data-scope-compose=\"1\">\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm\"\\n\n                aria-label=\"Add Common Job\"\\n\n                title=\"Add Common Job to this concern\"\\n\n                @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'saved-work', context: { concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n            >\\n\n                <span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\\n\n                <path d=\"M5.2 2.2h9.6c.7 0 1.2.5 1.2 1.2v14.1c0 .4-.4.6-.7.5L10 14.6 4.7 18c-.3.1-.7-.1-.7-.5V3.4c0-.7.5-1.2 1.2-1.2Z\"/>\\n\n            </svg>\\n\n            </span>\\n\n                <span class=\"ms-1\" data-compose-label>Common Job</span>\\n\n            </button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    aria-label=\"Add Labor\"\\n\n                    title=\"Add Labor\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'labor', context: { lineType: 'labor', concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    <span class=\"text-green d-inline-flex\"><span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\\n\n                <path d=\"M10 1.6a8.4 8.4 0 1 1 0 16.8A8.4 8.4 0 0 1 10 1.6Zm0 1.6a6.8 6.8 0 1 0 0 13.6A6.8 6.8 0 0 0 10 3.2Zm.1 2.2c.4 0 .7.3.7.7v4.1l2.4 1.4c.3.2.4.6.2.9-.2.3-.6.4-.9.2l-2.8-1.6a.7.7 0 0 1-.4-.7V6.1c0-.4.3-.7.8-.7Z\"/>\\n\n            </svg>\\n\n    </span>\\n\n</span>\\n\n                    <span class=\"ms-1\" data-compose-label>Labor</span>\\n\n                </button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    aria-label=\"Add Part\"\\n\n                    title=\"Add Part\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'part', context: { lineType: 'part', concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    <span class=\"text-azure d-inline-flex\"><span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 512 512\" fill=\"currentColor\">\\n\n                <path d=\"M352 320c88.4 0 160-71.6 160-160c0-15.3-2.2-30.1-6.2-44.2c-3.1-10.8-16.4-13.2-24.3-5.3l-76.8 76.8c-3 3-7.1 4.7-11.3 4.7L336 192c-8.8 0-16-7.2-16-16l0-57.4c0-4.2 1.7-8.3 4.7-11.3l76.8-76.8c7.9-7.9 5.4-21.2-5.3-24.3C382.1 2.2 367.3 0 352 0C263.6 0 192 71.6 192 160c0 19.1 3.4 37.5 9.5 54.5L19.9 396.1C7.2 408.8 0 426.1 0 444.1C0 481.6 30.4 512 67.9 512c18 0 35.3-7.2 48-19.9L297.5 310.5c17 6.2 35.4 9.5 54.5 9.5zM80 408a24 24 0 1 1 0 48 24 24 0 1 1 0-48z\"/>\\n\n            </svg>\\n\n            </span>\\n\n</span>\\n\n                    <span class=\"ms-1\" data-compose-label>Part</span>\\n\n                </button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    aria-label=\"Add Note\"\\n\n                    title=\"Add Note\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'note', context: { lineType: 'note', concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    <span class=\"text-pink d-inline-flex\"><span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\\n\n                <path d=\"M3.2 2.5h10.1c.7 0 1.3.6 1.3 1.3v8.2l-4.1 4.1H3.2c-.7 0-1.3-.6-1.3-1.3V3.8c0-.7.6-1.3 1.3-1.3Zm8.6 12.4 2.7-2.7h-2.1c-.3 0-.6.3-.6.6v2.1Z\"/>\\n\n            </svg>\\n\n            </span>\\n\n</span>\\n\n                    <span class=\"ms-1\" data-compose-label>Note</span>\\n\n                </button>\\n\n                            <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    aria-label=\"Add Sublet\"\\n\n                    title=\"Add Sublet\"\\n\n                    @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'sublet', context: { lineType: 'sublet', concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n                >\\n\n                    <span class=\"text-purple d-inline-flex\"><span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 512 512\" fill=\"currentColor\">\\n\n                <path d=\"M320 0c-17.7 0-32 14.3-32 32s14.3 32 32 32l82.7 0L201.4 265.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L448 109.3l0 82.7c0 17.7 14.3 32 32 32s32-14.3 32-32l0-160c0-17.7-14.3-32-32-32L320 0zM80 32C35.8 32 0 67.8 0 112L0 432c0 44.2 35.8 80 80 80l320 0c44.2 0 80-35.8 80-80l0-112c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 112c0 8.8-7.2 16-16 16L80 448c-8.8 0-16-7.2-16-16l0-320c0-8.8 7.2-16 16-16l112 0c17.7 0 32-14.3 32-32s-14.3-32-32-32L80 32z\"/>\\n\n            </svg>\\n\n            </span>\\n\n</span>\\n\n                    <span class=\"ms-1\" data-compose-label>Sublet</span>\\n\n                </button>\\n\n                        <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm\"\\n\n                aria-label=\"Add Photo\"\\n\n                title=\"Add Photo\"\\n\n                @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'evidence', context: { concernId: 1 }, invokeEl: $event.currentTarget } }))\"\\n\n            >\\n\n                <span class=\"d-inline-flex\" aria-hidden=\"true\">\\n\n                \\n\n            <svg class=\"icon icon-filled\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\\n\n                <path d=\"M7.1 3.2 6.3 4.5H3.8c-.9 0-1.6.7-1.6 1.6v8.6c0 .9.7 1.6 1.6 1.6h12.4c.9 0 1.6-.7 1.6-1.6V6.1c0-.9-.7-1.6-1.6-1.6h-2.5l-.8-1.3c-.2-.3-.5-.5-.9-.5H8c-.4 0-.7.2-.9.5ZM10 7.4a3.4 3.4 0 1 1 0 6.8 3.4 3.4 0 0 1 0-6.8Zm0 1.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8Z\"/>\\n\n            </svg>\\n\n            </span>\\n\n                <span class=\"ms-1\" data-compose-label>Photo</span>\\n\n            </button>\\n\n        </div>\\n\n    \\n\n                                <div\\n\n        x-data=\"arkAuthorizationExceptionDialog(JSON.parse('{\\u0022concernId\\u0022:1,\\u0022canRecord\\u0022:true,\\u0022reopen\\u0022:false}'))\"\\n\n    >\\n\n        <template x-teleport=\"body\">\\n\n            <div\\n\n                x-show=\"open\"\\n\n                x-cloak\\n\n                data-authorization-exception-dialog=\"1\"\\n\n                                @keydown.escape.window=\"onEscape($event)\"\\n\n                @keydown.tab=\"trapFocus($event)\"\\n\n            >\\n\n                <div class=\"modal-backdrop show\"></div>\\n\n                <div\\n\n                    class=\"modal d-block\"\\n\n                    role=\"dialog\"\\n\n                    aria-modal=\"true\"\\n\n                    :aria-labelledby=\"mode === 'inspect'\\n\n                        ? 'authorization-exception-inspect-title-1'\\n\n                        : 'authorization-exception-record-title-1'\"\\n\n                    @click.self=\"close()\"\\n\n                >\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\" @click.self=\"close()\">\\n\n                        <div class=\"modal-content\" x-ref=\"dialog\" tabindex=\"-1\">\\n\n                            <div class=\"modal-header\">\\n\n                                <div class=\"overflow-hidden\">\\n\n                                                                            <h2\\n\n                                            id=\"authorization-exception-record-title-1\"\\n\n                                            class=\"modal-title\"\\n\n                                            x-show=\"mode === 'record'\"\\n\n                                        >\\n\n                                            Record work exception\\n\n                                        </h2>\\n\n                                        <div class=\"small text-secondary\" x-show=\"mode === 'record'\" id=\"authorization-exception-record-help-1\">\\n\n                                            This documents an internal basis for proceeding. It does not record customer approval.\\n\n                                        </div>\\n\n                                                                                                        </div>\\n\n                                <button type=\"button\" class=\"btn-close\" aria-label=\"Close\" @click=\"close()\"></button>\\n\n                            </div>\\n\n\\n\n                                                            <div class=\"modal-body\" x-show=\"mode === 'record'\">\\n\n                                    <form\\n\n                                        id=\"authorization-exception-form-1\"\\n\n                                        method=\"POST\"\\n\n                                        action=\"http://localhost/app/repair-orders/1/concerns/1/authorization-exceptions\"\\n\n                                        @submit=\"submitRecord($event)\"\\n\n                                    >\\n\n                                        <input type=\"hidden\" name=\"_token\" value=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\" autocomplete=\"off\">                                        <input type=\"hidden\" name=\"opened_estimate_version\" value=\"1\">\\n\n                                        <input type=\"hidden\" name=\"authorization_exception_concern_id\" value=\"1\">\\n\n                                        <div class=\"mb-3\">\\n\n                                            <label class=\"form-label\" for=\"authorization-exception-reason-1\">Basis</label>\\n\n                                            <select\\n\n                                                id=\"authorization-exception-reason-1\"\\n\n                                                name=\"reason\"\\n\n                                                class=\"form-select\"\\n\n                                                required\\n\n                                                                                            >\\n\n                                                <option value=\"\" selected>Select a basis</option>\\n\n                                                                                                    <option value=\"diagnostic\" >Diagnostic</option>\\n\n                                                                                                    <option value=\"warranty\" >Warranty</option>\\n\n                                                                                                    <option value=\"internal\" >Internal</option>\\n\n                                                                                                    <option value=\"program\" >Program</option>\\n\n                                                                                                    <option value=\"comeback\" >Comeback</option>\\n\n                                                                                                    <option value=\"other\" >Other</option>\\n\n                                                                                            </select>\\n\n                                        </div>\\n\n\\n\n                                        <fieldset class=\"mb-3\">\\n\n                                            <legend class=\"form-label\">Work this covers</legend>\\n\n                                            <div class=\"list-group\" data-authorization-exception-lines>\\n\n                                                                                                                                                        <label class=\"list-group-item d-flex align-items-start gap-2\">\\n\n                                                        <input type=\"checkbox\" class=\"form-check-input flex-shrink-0 mt-1\" name=\"line_ids[]\" value=\"1\" >\\n\n                                                        <span class=\"flex-fill\" style=\"min-width: 0\">\\n\n                                                            <span class=\"d-block small text-secondary\">\\n\n                                                                Labor\\n\n                                                                                                                            </span>\\n\n                                                            <span class=\"d-block\">Inspect driveshaft</span>\\n\n                                                        </span>\\n\n                                                        <span class=\"flex-shrink-0 fw-medium ark-money\">$150.00</span>\\n\n                                                    </label>\\n\n                                                                                            </div>\\n\n                                        </fieldset>\\n\n\\n\n                                        <label class=\"form-label\" for=\"authorization-exception-note-1\">What this covers and why</label>\\n\n                                        <textarea\\n\n                                            id=\"authorization-exception-note-1\"\\n\n                                            name=\"note\"\\n\n                                            class=\"form-control\"\\n\n                                            required\\n\n                                            minlength=\"20\"\\n\n                                            maxlength=\"2000\"\\n\n                                            rows=\"4\"\\n\n                                            aria-describedby=\"authorization-exception-note-hint-1\"\\n\n                                                                                    ></textarea>\\n\n                                        <div class=\"form-hint\" id=\"authorization-exception-note-hint-1\">Name the work this covers and why this basis applies.</div>\\n\n                                    </form>\\n\n                                </div>\\n\n                                <div class=\"modal-footer flex-wrap\" x-show=\"mode === 'record'\">\\n\n                                    <div class=\"alert alert-danger w-100 mb-2\" role=\"alert\" x-show=\"lineError\" x-cloak>\\n\n                                        Select the labor or parts this exception covers.\\n\n                                    </div>\\n\n                                                                        <button type=\"button\" class=\"btn\" @click=\"close()\">Cancel</button>\\n\n                                    <button type=\"submit\" form=\"authorization-exception-form-1\" class=\"btn btn-primary\" :disabled=\"submitting\">Record exception</button>\\n\n                                </div>\\n\n                            \\n\n                                                    </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </template>\\n\n    </div>\\n\n                            </section>\\n\n                                                </div>\\n\n                </div>\\n\n        </div>\\n\n\\n\n                    <div\\n\n                x-show=\"tab === 'inspect'\"\\n\n                x-cloak\\n\n                role=\"tabpanel\"\\n\n                id=\"repair-order-workspace-panel-inspect\"\\n\n                aria-labelledby=\"repair-order-workspace-tab-inspect\"\\n\n            >\\n\n                <div x-show=\"tabErrors['inspect']\" x-cloak class=\"alert alert-danger\">Could not load this tab. Try selecting it again.</div>\\n\n                <p x-show=\"tabLoading['inspect']\" x-cloak class=\"text-secondary\">\\n\n                    <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading\u2026\\n\n                </p>\\n\n                <div data-workspace-tab-panel=\"inspect\"></div>\\n\n            </div>\\n\n                    <div\\n\n                x-show=\"tab === 'recommendations'\"\\n\n                x-cloak\\n\n                role=\"tabpanel\"\\n\n                id=\"repair-order-workspace-panel-recommendations\"\\n\n                aria-labelledby=\"repair-order-workspace-tab-recommendations\"\\n\n            >\\n\n                <div x-show=\"tabErrors['recommendations']\" x-cloak class=\"alert alert-danger\">Could not load this tab. Try selecting it again.</div>\\n\n                <p x-show=\"tabLoading['recommendations']\" x-cloak class=\"text-secondary\">\\n\n                    <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading\u2026\\n\n                </p>\\n\n                <div data-workspace-tab-panel=\"recommendations\"></div>\\n\n            </div>\\n\n                    <div\\n\n                x-show=\"tab === 'comms'\"\\n\n                x-cloak\\n\n                role=\"tabpanel\"\\n\n                id=\"repair-order-workspace-panel-comms\"\\n\n                aria-labelledby=\"repair-order-workspace-tab-comms\"\\n\n            >\\n\n                <div x-show=\"tabErrors['comms']\" x-cloak class=\"alert alert-danger\">Could not load this tab. Try selecting it again.</div>\\n\n                <p x-show=\"tabLoading['comms']\" x-cloak class=\"text-secondary\">\\n\n                    <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading\u2026\\n\n                </p>\\n\n                <div data-workspace-tab-panel=\"comms\"></div>\\n\n            </div>\\n\n                    <div\\n\n                x-show=\"tab === 'history'\"\\n\n                x-cloak\\n\n                role=\"tabpanel\"\\n\n                id=\"repair-order-workspace-panel-history\"\\n\n                aria-labelledby=\"repair-order-workspace-tab-history\"\\n\n            >\\n\n                <div x-show=\"tabErrors['history']\" x-cloak class=\"alert alert-danger\">Could not load this tab. Try selecting it again.</div>\\n\n                <p x-show=\"tabLoading['history']\" x-cloak class=\"text-secondary\">\\n\n                    <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading\u2026\\n\n                </p>\\n\n                <div data-workspace-tab-panel=\"history\"></div>\\n\n            </div>\\n\n            </div>\\n\n</div>\\n\n            </div>\\n\n\\n\n            <aside id=\"estimate-builder-rail\" class=\"ops-review-rail ops-review-rail--pinned gap-3\">\\n\n                                <div\\n\n    class=\"card\" id=\"estimate-total-panel\"\\n\n            x-data=\"{ totalsTab: window.location.hash === '#financial-rail' ? 'closeout' : 'estimate' }\"\\n\n        @ops-show-closeout.window=\"totalsTab = 'closeout'\"\\n\n        @hashchange.window=\"if (window.location.hash === '#financial-rail') totalsTab = 'closeout'\"\\n\n    >\\n\n    <div class=\"card-header\">\\n\n                    <ul class=\"nav nav-tabs card-header-tabs\" role=\"tablist\" aria-label=\"Estimate money\">\\n\n                <li class=\"nav-item\" role=\"presentation\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"nav-link\"\\n\n                        role=\"tab\"\\n\n                        data-totals-tab=\"estimate\"\\n\n                        :class=\"{ active: totalsTab === 'estimate' }\"\\n\n                        :aria-selected=\"totalsTab === 'estimate'\"\\n\n                        @click=\"totalsTab = 'estimate'; if (window.location.hash === '#financial-rail') history.replaceState(null, '', window.location.pathname + window.location.search)\"\\n\n                    >Estimate Total</button>\\n\n                </li>\\n\n                <li class=\"nav-item\" role=\"presentation\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"nav-link\"\\n\n                        role=\"tab\"\\n\n                        data-totals-tab=\"closeout\"\\n\n                        :class=\"{ active: totalsTab === 'closeout' }\"\\n\n                        :aria-selected=\"totalsTab === 'closeout'\"\\n\n                        @click=\"totalsTab = 'closeout'; history.replaceState(null, '', '#financial-rail')\"\\n\n                    >Closeout</button>\\n\n                </li>\\n\n            </ul>\\n\n            </div>\\n\n\\n\n            \\n\n        <dl id=\"rail-closeout-summary\" class=\"ops-rail-summary card-body py-2 border-bottom mb-0 small\" x-show=\"totalsTab === 'closeout'\" data-continuity-region=\"financial-position\" data-rail-summary>\\n\n                            <div>\\n\n                    <dt class=\"fw-normal text-secondary\">Estimate total</dt>\\n\n                    <dd class=\"mb-0 fw-semibold ark-money\">$150.00</dd>\\n\n                </div>\\n\n                <div class=\"text-end\">\\n\n                    <dt class=\"fw-normal text-secondary\">Owe today</dt>\\n\n                    <dd class=\"mb-0 fw-bold ark-money\">$0.00</dd>\\n\n                </div>\\n\n                    </dl>\\n\n    \\n\n    <div  x-show=\"totalsTab === 'estimate'\" >\\n\n    <div id=\"authorized-money\" data-continuity-region=\"authorized-money\">\\n\n        <div class=\"card-body border-bottom\" id=\"approval-forecast\" data-approval-forecast>\\n\n        <h4 class=\"subheader mb-2\">Approval Forecast</h4>\\n\n        <dl class=\"mb-0\">\\n\n            <div class=\"d-flex justify-content-between align-items-baseline gap-3\">\\n\n                <dt class=\"fw-normal text-secondary\">Approved</dt>\\n\n                <dd class=\"mb-0 fw-semibold ark-money\">$0.00</dd>\\n\n            </div>\\n\n                                    <div class=\"d-flex justify-content-between align-items-baseline gap-3 mt-1\">\\n\n                <dt class=\"fw-normal text-secondary\">\\n\n                    Needs Approval\\n\n                                            <span class=\"d-block small\">1 item</span>\\n\n                                    </dt>\\n\n                <dd class=\"mb-0 fw-semibold text-orange ark-money\">+$150.00</dd>\\n\n            </div>\\n\n                        <div class=\"d-flex justify-content-between align-items-baseline gap-3 border-top pt-2 mt-2\">\\n\n                <dt>If Approved</dt>\\n\n                <dd class=\"mb-0 fw-bold ark-money\">$150.00</dd>\\n\n            </div>\\n\n        </dl>\\n\n        <p class=\"small text-secondary mt-2 mb-0\">Conversation prep - not invoice authority.</p>\\n\n    </div>\\n\n    </div>\\n\n\\n\n    <div id=\"estimate-totals-region\" data-continuity-region=\"totals\">\\n\n        <dl class=\"card-body mb-0\">\\n\n                            <div class=\"mb-1\">\\n\n                                    </div>\\n\n                        <div class=\"d-flex justify-content-between align-items-baseline gap-3 py-1\">\\n\n                <dt class=\"fw-normal text-secondary\">Labor</dt>\\n\n                <dd class=\"mb-0 fw-semibold ark-money\">$150.00</dd>\\n\n            </div>\\n\n            <div class=\"d-flex justify-content-between align-items-baseline gap-3 py-1\">\\n\n                <dt class=\"fw-normal text-secondary\">Parts</dt>\\n\n                <dd class=\"mb-0 fw-semibold ark-money\">$0.00</dd>\\n\n            </div>\\n\n            <div class=\"d-flex justify-content-between align-items-baseline gap-3 py-1\">\\n\n                <dt class=\"fw-normal text-secondary\">Fees</dt>\\n\n                <dd class=\"mb-0 fw-semibold ark-money\">$0.00</dd>\\n\n            </div>\\n\n                                    <div class=\"d-flex justify-content-between align-items-baseline gap-3 py-1\" data-tax-summary-row>\\n\n                <dt class=\"fw-normal text-secondary mb-0\">\\n\n                                            Sales Tax\\n\n                                                    <span> \u00b7 Tax</span>\\n\n                                                                            <span> \u00b7 0%</span>\\n\n                                                            </dt>\\n\n                <dd class=\"mb-0 fw-semibold ark-money\">$0.00</dd>\\n\n            </div>\\n\n            <div class=\"d-flex justify-content-between align-items-baseline gap-3 border-top pt-2 mt-1\" data-total-row=\"final\">\\n\n                <dt class=\"h3 mb-0\">Total</dt>\\n\n                <dd class=\"h3 mb-0 ark-money\">$150.00</dd>\\n\n            </div>\\n\n        </dl>\\n\n    </div>\\n\n\\n\n    <div id=\"authorized-lines\" data-continuity-region=\"authorized-money\">\\n\n                    </div>\\n\n\\n\n    <div id=\"estimate-balance-region\" data-continuity-region=\"totals\">\\n\n                    <dl class=\"card-body border-top mb-0\">\\n\n                                                                            <div class=\"d-flex justify-content-between align-items-baseline gap-3 py-1\">\\n\n                        <dt class=\"fw-normal text-secondary\">\\n\n                            Suggested deposit\\n\n                            <span class=\"d-block small\">Shop policy quote - not collected</span>\\n\n                        </dt>\\n\n                        <dd class=\"mb-0 d-flex align-items-center gap-2 fw-semibold ark-money\">\\n\n                            <button\\n\n                                type=\"button\"\\n\n                                class=\"btn btn-link btn-sm p-0\"\\n\n                                data-ops-deposit-breakdown-open=\"deposit-breakdown-template-1\"\\n\n                            >\\n\n                                Breakdown\\n\n                            </button>\\n\n                            <span data-suggested-deposit-amount=\"1\"></span>\\n\n                        </dd>\\n\n                    </div>\\n\n                                            </dl>\\n\n            </div>\\n\n\\n\n            <div class=\"card-body border-top\">\\n\n            <div id=\"financial-payment-panel\" class=\"d-flex flex-column gap-2\">\\n\n    <div id=\"financial-position\" data-continuity-region=\"financial-position\">\\n\n            <p class=\"small mb-0\">Record deposits anytime. Final invoice issues when the vehicle is ready for pickup.</p>\\n\n        </div>\\n\n\\n\n    \\n\n    \\n\n            <div id=\"invoice-eligibility\" data-continuity-region=\"settlement\">\\n\n                    </div>\\n\n\\n\n        \\n\n                    <div\\n\n    data-payment-workspace\\n\n    data-payment-workspace-suggested=\"\"\\n\n    x-data=\"arkPaymentCapture({\\n\n        workspace: true,\\n\n        open: false,\\n\n        suggestedAmount: '',\\n\n        publicConfig: null,\\n\n        defaultMethod: 'cash',\\n\n        readers: [],\\n\n        readerStorageKey: 'ark:payment-reader:b72c3049-ae4b-429b-80fe-49bf06ec9953',\\n\n        manualMethods: JSON.parse('[{\\u0022key\\u0022:\\u0022check\\u0022,\\u0022label\\u0022:\\u0022Check\\u0022},{\\u0022key\\u0022:\\u0022card\\u0022,\\u0022label\\u0022:\\u0022External Card\\u0022},{\\u0022key\\u0022:\\u0022eft\\u0022,\\u0022label\\u0022:\\u0022EFT\\u0022}]'),\\n\n        paidDateToday: '2026-11-24',\\n\n        paidDateTodayLabel: 'Nov 24, 2026',\\n\n        paidOn: '',\\n\n        cardContainerId: 'ark-payment-capture-card-1',\\n\n        terminal: null,\\n\n    })\"\\n\n>\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"btn btn-primary w-100\"\\n\n        data-payment-workspace-open\\n\n        @click=\"openWorkspace()\"\\n\n    >\\n\n        Take payment\\n\n    </button>\\n\n\\n\n    \\n\n    <div\\n\n        x-cloak\\n\n        class=\"ops-workspace-modal\"\\n\n        data-payment-workspace-modal\\n\n        role=\"dialog\"\\n\n        aria-modal=\"true\"\\n\n        aria-labelledby=\"payment-workspace-title-1\"\\n\n        data-payment-workspace-dismiss=\"free\"\\n\n        :data-payment-workspace-dismiss=\"transactionBound() ? 'locked' : 'free'\"\\n\n        @keydown.escape.window=\"requestClose($event)\"\\n\n        @keydown.window=\"pressAmountKey($event)\"\\n\n    >\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"ops-workspace-modal__backdrop\"\\n\n            aria-label=\"Close\"\\n\n            @click=\"requestClose($event)\"\\n\n        ></button>\\n\n        <div class=\"card shadow-lg position-relative w-100\" style=\"max-width: 44rem; max-height: calc(100dvh - 1rem)\" @click.stop>\\n\n            <div class=\"card-header\">\\n\n                <h2 id=\"payment-workspace-title-1\" class=\"card-title\">Take payment</h2>\\n\n                <button type=\"button\" class=\"btn-close ms-auto\" aria-label=\"Close\" x-show=\"!transactionBound()\" @click=\"requestClose($event)\"></button>\\n\n            </div>\\n\n\\n\n            \\n\n            <div class=\"card-body d-flex flex-column gap-3 overflow-auto\" style=\"min-height: 0\">\\n\n                <div\\n\n                    data-terminal-payment\\n\n                    data-terminal-payment-phase=\"\"\\n\n                    role=\"status\"\\n\n                    aria-live=\"polite\"\\n\n                    x-show=\"terminalPhase\"\\n\n                    x-cloak\\n\n                    :data-terminal-payment-phase=\"terminalPhase\"\\n\n                >\\n\n                    <div class=\"d-flex flex-column align-items-center gap-3 py-4 text-center\">\\n\n                    <p class=\"h3 mb-0\" data-terminal-payment-headline x-text=\"terminalHeadline\"></p>\\n\n                    <p class=\"display-5 fw-bold ark-money mb-0\" data-terminal-payment-amount x-text=\"terminalAmount || amount\"></p>\\n\n                    <div class=\"spinner-border text-primary\" style=\"width: 3.5rem; height: 3.5rem\" role=\"presentation\" data-terminal-payment-spinner x-show=\"terminalSpinning\"  x-cloak ></div>\\n\n                    <p class=\"fw-medium mb-0\" x-show=\"terminalNote\" x-text=\"terminalNote\"></p>\\n\n                    <p class=\"text-secondary mb-0\" x-show=\"terminalDetail\" x-text=\"terminalDetail\"></p>\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-outline-secondary\"\\n\n                        data-payment-workspace-cancel\\n\n                                                 hidden                         :disabled=\"busy || !terminalCancelUrl\"\\n\n                        @click=\"cancelTerminal()\"\\n\n                    >\\n\n                        Cancel terminal\\n\n                    </button>\\n\n                    </div>\\n\n                </div>\\n\n\\n\n                <div x-show=\"!terminalPhase\" >\\n\n                <div class=\"d-flex flex-column gap-3\">\\n\n                    <p class=\"small fw-medium text-danger mb-0\" x-show=\"cardError\" x-cloak x-text=\"cardError\"></p>\\n\n                                    \\n\n                                            <p class=\"small text-secondary mb-0\">\\n\n                            Deposit is payment against authorized work \u2014 not a change to what the customer authorized.\\n\n                        </p>\\n\n                                            \\n\n                    <div>\\n\n                        <label class=\"subheader d-block text-center\" for=\"payment-workspace-amount-1\">Amount</label>\\n\n                        <div class=\"d-flex align-items-baseline justify-content-center gap-1\">\\n\n                            <span class=\"fs-1 fw-bold\">$</span>\\n\n                            <input\\n\n                                id=\"payment-workspace-amount-1\"\\n\n                                class=\"form-control-plaintext display-5 fw-bold ark-money text-center p-0\"\\n\n                                data-payment-workspace-amount\\n\n                                inputmode=\"decimal\"\\n\n                                autocomplete=\"off\"\\n\n                                :value=\"amount\"\\n\n                                @input=\"onAmountTyped($event)\"\\n\n                            >\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div class=\"d-grid gap-2\" style=\"grid-template-columns: repeat(3, minmax(0, 1fr))\" data-payment-workspace-keypad>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('1')\">\\n\n                                1\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('2')\">\\n\n                                2\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('3')\">\\n\n                                3\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('4')\">\\n\n                                4\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('5')\">\\n\n                                5\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('6')\">\\n\n                                6\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('7')\">\\n\n                                7\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('8')\">\\n\n                                8\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('9')\">\\n\n                                9\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('.')\">\\n\n                                .\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('0')\">\\n\n                                0\\n\n                            </button>\\n\n                                                    <button type=\"button\" class=\"btn btn-outline-secondary btn-lg fs-3 fw-bold ark-money\" @click=\"pressAmount('backspace')\">\\n\n                                Delete\\n\n                            </button>\\n\n                                            </div>\\n\n\\n\n                    <div class=\"d-flex flex-wrap gap-2\" role=\"group\" aria-label=\"Payment method\">\\n\n                                                                                            </div>\\n\n\\n\n                    \\n\n                    <div class=\"d-flex flex-column align-items-center\" data-payment-paid-date-picker @click.outside=\"closePaidDate()\">\\n\n                        <button type=\"button\" class=\"btn btn-link btn-sm\" data-payment-paid-date @click=\"togglePaidDate()\" :disabled=\"transactionBound()\" :aria-expanded=\"paidDateOpen\">\\n\n                            Paid <span class=\"ms-1\" x-text=\"paidDateLabel()\">Nov 24, 2026</span>\\n\n                        </button>\\n\n                        <div class=\"card card-sm mt-1\" style=\"width: 16rem\" x-show=\"paidDateOpen\" x-cloak>\\n\n                            <div class=\"card-body p-2\">\\n\n                                <div class=\"d-flex align-items-center justify-content-between gap-2 mb-1\">\\n\n                                    <button type=\"button\" class=\"btn btn-sm btn-icon btn-ghost-secondary\" aria-label=\"Previous month\" @click=\"shiftCalendar(-1)\">\\n\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n                                    </button>\\n\n                                    <span class=\"small fw-bold\" x-text=\"calendarTitle()\"></span>\\n\n                                    <button type=\"button\" class=\"btn btn-sm btn-icon btn-ghost-secondary\" aria-label=\"Next month\" @click=\"shiftCalendar(1)\" :disabled=\"!canShiftCalendar(1)\">\\n\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M13 18l6 -6\"/><path d=\"M13 6l6 6\"/></svg>\\n\n                                    </button>\\n\n                                </div>\\n\n                                <div class=\"d-grid text-center subheader\" style=\"grid-template-columns: repeat(7, minmax(0, 1fr))\" aria-hidden=\"true\">\\n\n                                    <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>\\n\n                                </div>\\n\n                                <div class=\"d-grid gap-1\" style=\"grid-template-columns: repeat(7, minmax(0, 1fr))\">\\n\n                                    <template x-for=\"(cell, index) in calendarCells()\" :key=\"index\">\\n\n                                        <button\\n\n                                            type=\"button\"\\n\n                                            class=\"btn btn-sm px-0\"\\n\n                                            :class=\"cell.selected ? 'btn-primary' : 'btn-ghost-secondary'\"\\n\n                                            :disabled=\"!cell.inMonth || cell.disabled\"\\n\n                                            x-text=\"cell.label\"\\n\n                                            @click=\"choosePaidDate(cell.iso)\"\\n\n                                        ></button>\\n\n                                    </template>\\n\n                                </div>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    \\n\n                                                    </div>\\n\n                </div>\\n\n\\n\n                                                            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n        \\n\n            \\n\n    <div id=\"settlement-history\" data-continuity-region=\"settlement\">\\n\n            </div>\\n\n\\n\n    <a href=\"#financial-rail\" class=\"btn btn-ghost-secondary w-100\" @click=\"$dispatch('ops-show-closeout')\">\\n\n        Full ledger &amp; closeout\\n\n    </a>\\n\n</div>\\n\n        </div>\\n\n        </div>\\n\n\\n\n            <div x-show=\"totalsTab === 'closeout'\" x-cloak>\\n\n            <div id=\"financial-rail\" class=\"scroll-mt-6\">\\n\n    <div class=\"card-body d-flex flex-column gap-3\">\\n\n        <div id=\"payment-posture\" data-continuity-region=\"settlement\" style=\"min-width: 0\">\\n\n            <div class=\"subheader\">Payment status</div>\\n\n            <div class=\"fw-bold\">Pre-invoice</div>\\n\n            <div class=\"small text-secondary\">Record deposits anytime. Final invoice issues when the vehicle is ready for pickup.</div>\\n\n        </div>\\n\n\\n\n        <div id=\"invoice-posture\" data-continuity-region=\"invoice-posture\">\\n\n                        </div>\\n\n\\n\n                    <div id=\"closeout-eligibility\" data-continuity-region=\"settlement\">\\n\n                            </div>\\n\n            </div>\\n\n\\n\n    <details class=\"border-top\" open>\\n\n        <summary class=\"card-body py-2 subheader\">Ledger &amp; documents</summary>\\n\n        <div class=\"card-body pt-0 d-flex flex-column gap-3\">\\n\n            <dl class=\"mb-0 border rounded small\">\\n\n                <div class=\"d-flex justify-content-between gap-3 px-3 py-2 border-bottom\">\\n\n                    <dt class=\"fw-normal text-secondary\">Estimate total</dt>\\n\n                    <dd class=\"mb-0 fw-medium ark-money\">$150.00</dd>\\n\n                </div>\\n\n                <div id=\"settlement-invoice\" data-continuity-region=\"settlement\" class=\"d-flex justify-content-between gap-3 px-3 py-2 border-bottom\">\\n\n                    <dt class=\"fw-normal text-secondary\">Invoice</dt>\\n\n                    <dd class=\"mb-0 fw-medium\">Not issued</dd>\\n\n                </div>\\n\n                                    <div id=\"settlement-balance\" data-continuity-region=\"settlement\"></div>\\n\n                    <div id=\"financial-position-closeout\" data-continuity-region=\"financial-position\" class=\"d-flex justify-content-between gap-3 px-3 py-2 bg-secondary-lt\">\\n\n                        <dt class=\"fw-bold\">Owe today</dt>\\n\n                        <dd class=\"mb-0 fw-bold ark-money\">$0.00</dd>\\n\n                    </div>\\n\n                            </dl>\\n\n\\n\n            \\n\n            \\n\n                            \\n\n                                    \\n\n                                                \\n\n            \\n\n            \\n\n                                        \\n\n            <div id=\"settlement-history-closeout\" data-continuity-region=\"settlement\" class=\"\">\\n\n                        </div>\\n\n        </div>\\n\n    </details>\\n\n</div>\\n\n        </div>\\n\n    \\n\n            <template id=\"deposit-breakdown-template-1\">\\n\n        <div\\n\n            class=\"card shadow-lg position-relative\"\\n\n            style=\"width: min(96vw, 44rem); max-height: min(88vh, 42rem)\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            aria-labelledby=\"deposit-breakdown-template-1-title\"\\n\n            data-deposit-breakdown-dialog\\n\n            data-repair-order-id=\"1\"\\n\n        >\\n\n            <div class=\"card-header align-items-start\">\\n\n                <div style=\"min-width: 0\">\\n\n                    <h2 id=\"deposit-breakdown-template-1-title\" class=\"card-title\">Deposit line breakdown</h2>\\n\n                    <p class=\"small text-secondary mb-0 mt-1\">Customer sell by line. Uncheck parts to exclude; check labor to add. Tax and shop fees included when they apply.</p>\\n\n                </div>\\n\n                <button type=\"button\" class=\"btn-close ms-auto\" aria-label=\"Close\" data-ops-deposit-breakdown-close></button>\\n\n            </div>\\n\n\\n\n            <div class=\"card-body p-0 overflow-auto\" style=\"min-height: 0\">\\n\n                <table class=\"table table-vcenter card-table mb-0\">\\n\n                    <thead>\\n\n                        <tr>\\n\n                            <th scope=\"col\" class=\"w-1\"><span class=\"visually-hidden\">Include</span></th>\\n\n                            <th scope=\"col\">Line</th>\\n\n                            <th scope=\"col\">Type</th>\\n\n                            <th scope=\"col\" class=\"text-end\">Sell</th>\\n\n                            <th scope=\"col\" class=\"text-end\">Tax</th>\\n\n                            <th scope=\"col\" class=\"text-end\">Shop fee</th>\\n\n                            <th scope=\"col\" class=\"text-end\">Total</th>\\n\n                        </tr>\\n\n                    </thead>\\n\n                    <tbody>\\n\n                        \\n\n                                                    <tr class=\"bg-secondary-lt\">\\n\n                                <td colspan=\"7\" class=\"subheader\">Labor</td>\\n\n                            </tr>\\n\n                                                            <tr class=\"opacity-50\" data-deposit-line>\\n\n    <td>\\n\n        <input\\n\n            type=\"checkbox\"\\n\n            class=\"form-check-input m-0 align-middle\"\\n\n            aria-label=\"Include Inspect driveshaft\"\\n\n            data-deposit-line-checkbox\\n\n            data-amount-cents=\"15000\"\\n\n                    >\\n\n    </td>\\n\n    <td>Inspect driveshaft</td>\\n\n    <td class=\"text-secondary\">Mechanical</td>\\n\n    <td class=\"text-end ark-money\">$150.00</td>\\n\n    <td class=\"text-end ark-money\">-</td>\\n\n    <td class=\"text-end ark-money\">-</td>\\n\n    <td class=\"text-end fw-bold ark-money\">$150.00</td>\\n\n</tr>\\n\n                                                                        </tbody>\\n\n                </table>\\n\n            </div>\\n\n\\n\n            <div class=\"card-footer d-flex justify-content-between\">\\n\n                <span class=\"fw-bold\">Deposit total</span>\\n\n                <span class=\"fw-bold ark-money\" data-deposit-breakdown-total></span>\\n\n            </div>\\n\n        </div>\\n\n    </template>\\n\n    </div>\\n\n\\n\n                \\n\n                \\n\n                            </aside>\\n\n        </div>\\n\n\\n\n        \\n\n        \\n\n        <div class=\"modal modal-blur fade\" id=\"ark-inline-pdf-viewer\" tabindex=\"-1\" aria-labelledby=\"ark-inline-pdf-viewer-title\" aria-hidden=\"true\" data-ark-inline-pdf-viewer>\\n\n    <div class=\"modal-dialog modal-xl modal-dialog-centered modal-fullscreen-md-down\" role=\"document\">\\n\n        <div class=\"modal-content\" style=\"height: min(92vh, 60rem)\">\\n\n            <div class=\"modal-header d-print-none\">\\n\n                <h2 class=\"modal-title h3\" id=\"ark-inline-pdf-viewer-title\" data-pdf-viewer-title>Document</h2>\\n\n                <div class=\"btn-list ms-auto me-3 flex-nowrap\" role=\"group\" aria-label=\"Document commands\">\\n\n                    <button type=\"button\" class=\"btn btn-sm\" data-pdf-viewer-print>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2\"/><path d=\"M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4\"/><path d=\"M7 15a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2l0 -4\"/></svg>\\n\n                        <span class=\"d-none d-sm-inline\">Print</span>\\n\n                    </button>\\n\n                    <a href=\"#\" class=\"btn btn-sm\" data-pdf-viewer-download>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n                        <span class=\"d-none d-sm-inline\">Download</span>\\n\n                    </a>\\n\n                    <a href=\"#\" class=\"btn btn-sm\" target=\"_blank\" rel=\"noopener\" data-pdf-viewer-new-tab>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6\"/><path d=\"M11 13l9 -9\"/><path d=\"M15 4h5v5\"/></svg>\\n\n                        <span class=\"d-none d-sm-inline\">Open in new tab</span>\\n\n                    </a>\\n\n                </div>\\n\n                <button type=\"button\" class=\"btn-close ms-0\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\\n\n            </div>\\n\n            <div class=\"modal-body p-0 d-flex flex-column\">\\n\n                <div class=\"alert alert-warning m-3 mb-0\" role=\"alert\" data-pdf-viewer-fallback hidden>\\n\n                    This browser can't show PDFs inside the page.\\n\n                    <a href=\"#\" target=\"_blank\" rel=\"noopener\" data-pdf-viewer-fallback-link>Open the PDF in a new tab</a>\\n\n                    or use Download.\\n\n                </div>\\n\n                <iframe src=\"about:blank\" title=\"Document preview\" class=\"d-block w-100 border-0 flex-grow-1 bg-white\" data-pdf-viewer-frame></iframe>\\n\n            </div>\\n\n            <div class=\"modal-footer d-print-none justify-content-between py-2\">\\n\n                <span class=\"small text-secondary\">Preview only. Nothing is sent or changed.</span>\\n\n                <button type=\"button\" class=\"btn btn-sm\" data-bs-dismiss=\"modal\">Close</button>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n\\n\n        <aside\\n\n        class=\"card sticky-bottom mt-3 shadow-lg\"\\n\n        id=\"ro-orientation-header\"\\n\n        data-ro-orientation-header\\n\n        aria-label=\"Repair Order next step\"\\n\n    >\\n\n        <div class=\"card-status-top bg-primary\"></div>\\n\n        <div class=\"card-body px-2 px-md-3 py-1 py-md-2\">\\n\n            \\n\n            <div class=\"d-flex flex-nowrap align-items-baseline justify-content-between gap-2 small\" data-ro-dock-summary>\\n\n                <div class=\"d-flex gap-1 gap-sm-2 min-w-0 text-truncate fw-bold\" title=\"RO #1 \u00b7 Amber Adams \u00b7 2011 Acura ZDX \u00b7 2HNYD2H66BH530414\">\\n\n                    <span class=\"flex-shrink-0\">RO #1</span>\\n\n                    <span class=\"text-secondary\" aria-hidden=\"true\">\u00b7</span>\\n\n                                            <span\\n\n        class=\"d-inline-flex align-items-center flex-shrink-0\"\\n\n        x-data=\"arkVinDisplay('2HNYD2H66BH530414', { inline: true })\"\\n\n        title=\"\"\\n\n        data-vin-chip\\n\n    >\\n\n        <button\\n\n            type=\"button\"\\n\n            x-ref=\"trigger\"\\n\n            class=\"btn btn-link p-0 border-0 font-monospace fw-bold text-reset ops-vin-copyable\"\\n\n            @pointerdown=\"pointerType = $event.pointerType\"\\n\n            @click=\"activate()\"\\n\n            @mouseenter=\"onReadbackHoverEnter()\"\\n\n            @mouseleave=\"onReadbackHoverLeave()\"\\n\n            @focus=\"onReadbackHoverEnter()\"\\n\n            @blur=\"onReadbackHoverLeave()\"\\n\n            :aria-describedby=\"readbackOpen ? 'vin-chip-readback-6b05beee08f49' : null\"\\n\n            :aria-expanded=\"readbackOpen ? 'true' : 'false'\"\\n\n            aria-haspopup=\"dialog\"\\n\n            aria-label=\"VIN 2HNYD2H66BH530414. Copy to clipboard; phonetic spelling on hover or focus.\"\\n\n            data-vin-copy\\n\n        >2HNYD2H66BH530414</button>\\n\n        <span class=\"visually-hidden\" role=\"status\" aria-live=\"polite\" x-text=\"copied ? 'VIN copied' : (copyFailed ? 'VIN could not be copied' : '')\"></span>\\n\n\\n\n        <template x-teleport=\"body\">\\n\n            <div x-show=\"readbackOpen\" x-cloak data-vin-readback-layer>\\n\n                <div\\n\n                    id=\"vin-chip-readback-6b05beee08f49\"\\n\n                    x-ref=\"panel\"\\n\n                    class=\"card card-sm shadow position-fixed p-2 ops-vin-tooltip-layer ops-vin-readback-popover\"\\n\n                    :style=\"tooltipStyle\"\\n\n                    role=\"dialog\"\\n\n                    aria-label=\"VIN phonetic spelling\"\\n\n                    tabindex=\"-1\"\\n\n                    data-vin-phonetic-readback\\n\n                    @mouseenter=\"onReadbackHoverEnter()\"\\n\n                    @mouseleave=\"onReadbackHoverLeave()\"\\n\n                    @keydown.escape.stop=\"closeReadback()\"\\n\n                >\\n\n                    <div class=\"d-flex align-items-start justify-content-between gap-2 mb-1\">\\n\n                        <span class=\"subheader mb-0 font-monospace\">2HNYD2H66BH530414</span>\\n\n                        <button type=\"button\" class=\"btn-close\" aria-label=\"Close VIN readback\" @click=\"closeReadback()\"></button>\\n\n                    </div>\\n\n                    <div class=\"small mb-1\" data-vin-copy-status>\\n\n                        <span class=\"text-green\" x-show=\"copied\" x-cloak>VIN copied</span>\\n\n                        <span class=\"text-danger\" x-show=\"copyFailed\" x-cloak>Could not copy. Select the VIN to copy it by hand.</span>\\n\n                        <span class=\"text-secondary\" x-show=\"! copied && ! copyFailed\">Click the VIN to copy</span>\\n\n                    </div>\\n\n                    <ol class=\"list-unstyled small mb-0 row row-cols-2 row-cols-sm-3 g-1\" data-vin-phonetic-list>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">2</span> \u2014 Two</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">H</span> \u2014 Hotel</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">N</span> \u2014 November</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">Y</span> \u2014 Yankee</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">D</span> \u2014 Delta</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">2</span> \u2014 Two</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">H</span> \u2014 Hotel</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">6</span> \u2014 Six</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">6</span> \u2014 Six</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">B</span> \u2014 Bravo</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">H</span> \u2014 Hotel</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">5</span> \u2014 Five</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">3</span> \u2014 Three</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">0</span> \u2014 Zero</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">4</span> \u2014 Four</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">1</span> \u2014 One</li>\\n\n                                                    <li class=\"col text-nowrap\"><span class=\"font-monospace fw-bold\">4</span> \u2014 Four</li>\\n\n                                            </ol>\\n\n                </div>\\n\n            </div>\\n\n        </template>\\n\n    </span>\\n\n                                        <span class=\"text-secondary\" aria-hidden=\"true\">\u00b7</span>\\n\n                    <span class=\"text-truncate\">Amber Adams</span>\\n\n                    <span class=\"text-secondary\" aria-hidden=\"true\">\u00b7</span>\\n\n                    <span class=\"text-truncate\">2011 Acura ZDX</span>\\n\n                </div>\\n\n\\n\n                <div class=\"d-flex align-items-center gap-2 min-w-0 ms-auto\" title=\"Building Estimate \u00b7 Advisor\">\\n\n                    \\n\n                    <span class=\"fw-bold text-truncate d-none d-sm-inline\" data-ro-dock-status>Building Estimate</span>\\n\n                    <span class=\"status-dot status-secondary flex-shrink-0\" data-ro-owner-signal=\"advisor\" aria-hidden=\"true\"></span>\\n\n                    <span class=\"text-secondary flex-shrink-0 d-none d-sm-inline\">Advisor</span>\\n\n                </div>\\n\n            </div>\\n\n\\n\n                            <footer\\n\n    class=\"border-top mt-1 pt-1 mt-md-2 pt-md-2\"\\n\n    data-ro-footer\\n\n     data-ro-footer-docked     aria-label=\"Repair Order actions\"\\n\n    x-data\\n\n>\\n\n    <div class=\"d-flex align-items-center flex-nowrap flex-md-wrap gap-1 gap-sm-2\">\\n\n        <div class=\"d-flex align-items-center gap-2\">\\n\n                                                <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-primary btn-sm\"\\n\n                         title=\"Add concern, oil service, or testing package\"                         data-workspace-modal-trigger=\"add-work\"\\n\n                        @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'add-work', invokeEl: $event.currentTarget } }))\"\\n\n                    >\\n\n                        + Add Work\\n\n                    </button>\\n\n                                    </div>\\n\n\\n\n                    <div class=\"d-none d-md-flex align-items-center gap-1\" role=\"group\" aria-label=\"Estimating tools\" data-ro-footer-tools>\\n\n    <button\\n\n        type=\"button\"\\n\n        class=\"btn btn-sm btn-ghost-secondary\"\\n\n        data-ro-footer-dealer-quote\\n\n        title=\"Import a dealer quote PDF or pasted text onto this estimate\"\\n\n        @click=\"window.dispatchEvent(new CustomEvent('ark:dealer-quote-capture-open'))\"\\n\n    >\\n\n        Import\\n\n    </button>\\n\n    \\n\n            <div class=\"position-relative\" data-toolbar-group=\"labor-guide\" @click.outside=\"laborGuideMenu = false\">\\n\n            <div class=\"btn-group\" role=\"group\" aria-label=\"Labor Guide\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm\"\\n\n                    :class=\"({ rte: &#039;btn-outline-teal&#039;, alldata: &#039;btn-outline-yellow&#039;, prodemand: &#039;btn-outline-indigo&#039; })[laborGuidePrimary()?.key] || 'btn-outline-secondary'\"\\n\n                    :title=\"laborGuidePrimary()?.title || ''\"\\n\n                    data-labor-guide-primary\\n\n                    @click=\"runLaborGuideItem(laborGuidePrimary())\"\\n\n                >\\n\n                    <span x-text=\"laborGuidePrimary()?.label\">Labor Guide</span>\\n\n                </button>\\n\n                <button\\n\n                    type=\"button\"\\n\n                    class=\"btn btn-sm dropdown-toggle dropdown-toggle-split\"\\n\n                    :class=\"({ rte: &#039;btn-outline-teal&#039;, alldata: &#039;btn-outline-yellow&#039;, prodemand: &#039;btn-outline-indigo&#039; })[laborGuidePrimary()?.key] || 'btn-outline-secondary'\"\\n\n                    x-show=\"laborGuideSecondary().length > 0\"\\n\n                    x-cloak\\n\n                    @click=\"laborGuideMenu = ! laborGuideMenu\"\\n\n                    :aria-expanded=\"laborGuideMenu ? 'true' : 'false'\"\\n\n                    aria-haspopup=\"menu\"\\n\n                    aria-label=\"Other labor guides\"\\n\n                    title=\"Other labor guides\"\\n\n                ></button>\\n\n            </div>\\n\n            <div class=\"dropdown-menu bottom-100 start-0 mb-1\" :class=\"{ show: laborGuideMenu && laborGuideSecondary().length > 0 }\" role=\"menu\">\\n\n                <template x-for=\"item in laborGuideSecondary()\" :key=\"'footer-guide-' + item.key\">\\n\n                    <div>\\n\n                        <button type=\"button\" class=\"dropdown-item\" role=\"menuitem\" :title=\"item.title\" :disabled=\"! item.can_open\" @click=\"runLaborGuideItem(item)\">\\n\n                            <span x-text=\"item.label\"></span>\\n\n                        </button>\\n\n                        <button type=\"button\" class=\"dropdown-item small text-secondary\" @click=\"setEstimateToolbarDefault('labor_guide', item.key)\">Make default</button>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n\\n\n<div class=\"d-md-none\" x-data=\"{ toolsOpen: false }\" @keydown.escape.window=\"toolsOpen = false\">\\n\n    <button type=\"button\" class=\"btn btn-sm\" @click=\"toolsOpen = true\" aria-label=\"Tools\" aria-haspopup=\"dialog\" :aria-expanded=\"toolsOpen\" data-ro-footer-tools-toggle>\\n\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5\"/></svg>\\n\n        <span class=\"ark-ro-footer-label\">Tools</span>\\n\n    </button>\\n\n    <div x-show=\"toolsOpen\" x-cloak>\\n\n        <div class=\"offcanvas-backdrop show\" @click=\"toolsOpen = false\"></div>\\n\n        \\n\n        <div\\n\n            class=\"offcanvas offcanvas-bottom h-auto ark-ro-footer-sheet\"\\n\n            :class=\"{ show: toolsOpen }\"\\n\n            role=\"dialog\"\\n\n            aria-modal=\"true\"\\n\n            aria-labelledby=\"ro-footer-tools-title\"\\n\n            data-ro-footer-tools-sheet\\n\n        >\\n\n            <div class=\"offcanvas-header py-2\">\\n\n                <h2 class=\"offcanvas-title h3\" id=\"ro-footer-tools-title\">Tools</h2>\\n\n                <button type=\"button\" class=\"btn-close\" aria-label=\"Close\" @click=\"toolsOpen = false\"></button>\\n\n            </div>\\n\n            <div class=\"list-group list-group-flush border-top\">\\n\n                <button\\n\n                    type=\"button\"\\n\n                    class=\"list-group-item list-group-item-action\"\\n\n                    data-ro-footer-dealer-quote\\n\n                    @click=\"toolsOpen = false; window.dispatchEvent(new CustomEvent('ark:dealer-quote-capture-open'))\"\\n\n                >Import Dealer Quote</button>\\n\n                                <template x-for=\"item in partsCatalogItems\" :key=\"'sheet-catalog-' + item.key\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"list-group-item list-group-item-action\"\\n\n                        :disabled=\"! item.can_open\"\\n\n                        @click=\"toolsOpen = false; openPartsCatalog(item.key)\"\\n\n                        x-text=\"item.open_label\"\\n\n                    ></button>\\n\n                </template>\\n\n                <template x-for=\"item in laborGuideItems\" :key=\"'sheet-guide-' + item.key\">\\n\n                    <button\\n\n                        type=\"button\"\\n\n                        class=\"list-group-item list-group-item-action\"\\n\n                        @click=\"toolsOpen = false; runLaborGuideItem(item)\"\\n\n                        x-text=\"item.label\"\\n\n                    ></button>\\n\n                </template>\\n\n                                                            <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action\"\\n\n                            @click=\"toolsOpen = false; window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'document', invokeEl: $event.currentTarget } }))\"\\n\n                        >+ Add Document</button>\\n\n                                                                                <a\\n\n                            href=\"http://localhost/app/repair-orders/1/customer-display\"\\n\n                             target=\"_blank\" rel=\"noopener\"                             class=\"list-group-item list-group-item-action\"\\n\n                            @click=\"toolsOpen = false\"\\n\n                        >Customer Display</a>\\n\n                                                </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n        \\n\n        <div class=\"flex-wrap align-items-center gap-1 flex-fill d-none d-md-flex\">\\n\n                                                <button\\n\n                        type=\"button\"\\n\n                        class=\"btn btn-ghost-secondary btn-sm\"\\n\n                         title=\"Scan, upload, or attach paperwork for this visit\"                         data-workspace-modal-trigger=\"document\"\\n\n                        @click=\"window.dispatchEvent(new CustomEvent('ark-workspace-modal-open', { detail: { task: 'document', invokeEl: $event.currentTarget } }))\"\\n\n                    >\\n\n                        + Add Document\\n\n                    </button>\\n\n                                                                <a\\n\n                        href=\"http://localhost/app/repair-orders/1/customer-display\"\\n\n                         target=\"_blank\" rel=\"noopener\"                         class=\"btn btn-ghost-secondary btn-sm\"\\n\n                         title=\"Present this estimate on the front-counter customer display\"                     >\\n\n                        Customer Display\\n\n                    </a>\\n\n                                    </div>\\n\n\\n\n        <div\\n\n            class=\"dropup ms-auto\"\\n\n            data-ro-footer-print\\n\n            data-ro-print-menu\\n\n        >\\n\n            <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-ghost-secondary btn-sm dropdown-toggle\"\\n\n                data-bs-toggle=\"dropdown\"\\n\n                data-bs-display=\"static\"\\n\n                aria-expanded=\"false\"\\n\n                aria-haspopup=\"menu\"\\n\n                aria-label=\"Print\"\\n\n                title=\"Print\"\\n\n            >\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2\"/><path d=\"M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4\"/><path d=\"M7 15a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2l0 -4\"/></svg>\\n\n                <span class=\"d-none d-sm-inline\">PRINT</span>\\n\n            </button>\\n\n            <div\\n\n                class=\"dropdown-menu dropdown-menu-end\"\\n\n                role=\"menu\"\\n\n                data-ro-footer-print-menu\\n\n                style=\"max-height: min(70vh, 24rem); overflow-y: auto;\"\\n\n            >\\n\n                <button\\n\n                type=\"button\"\\n\n                role=\"menuitem\"\\n\n                class=\"dropdown-item\"\\n\n                data-ro-print-item=\"key_tag\"\\n\n                @click=\"window.arkPrintDocument?.(window.ARK_PRINTERS?.keyTag, 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/print-key-tag', $event.currentTarget, { document: 'key_tag', resolvePrinter: true })\"\\n\n            >\\n\n                Print Key Tag\\n\n            </button>\\n\n                        <button\\n\n            type=\"button\"\\n\n            role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"oil_sticker\"\\n\n            @click=\"window.arkPrintDocument?.(window.ARK_PRINTERS?.oilSticker, 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/print-oil-change-sticker', $event.currentTarget, { document: 'oil_change_sticker', resolvePrinter: true })\"\\n\n        >\\n\n            Print Oil Sticker\\n\n        </button>\\n\n                <a\\n\n            href=\"http://localhost/app/repair-orders/1/sheets/intake/pdf\"\\n\n             target=\"_blank\" rel=\"noopener\"             role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"check_in_sheet\"\\n\n                    >\\n\n            Check In sheet\\n\n        </a>\\n\n                <a\\n\n            href=\"http://localhost/app/repair-orders/1/sheets/tech/pdf\"\\n\n             target=\"_blank\" rel=\"noopener\"             role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"tech_sheet\"\\n\n                    >\\n\n            Tech sheet\\n\n        </a>\\n\n                <a\\n\n    href=\"http://localhost/app/repair-orders/1/estimate/pdf\"\\n\n    target=\"_blank\"\\n\n    rel=\"noopener\"\\n\n    data-ark-pdf-preview\\n\n     data-document-id=\"1\"     data-pdf-title=\"Estimate \u00b7 RO #1\"\\n\n    data-pdf-view-url=\"http://localhost/app/repair-orders/1/estimate/pdf\"\\n\n    data-pdf-download-url=\"http://localhost/app/repair-orders/1/estimate/pdf/download\"\\n\n    data-pdf-new-tab-url=\"http://localhost/app/repair-orders/1/estimate/pdf\"\\n\n     data-pdf-cache-bust     role=\"menuitem\" class=\"dropdown-item\" data-ro-print-item=\"view_estimate\"\\n\n>View Estimate</a>\\n\n                <a\\n\n            href=\"http://localhost/app/repair-orders/1/estimate/pdf\"\\n\n             target=\"_blank\" rel=\"noopener\"             role=\"menuitem\"\\n\n            class=\"dropdown-item\"\\n\n            data-ro-print-item=\"estimate_pdf\"\\n\n            @click=\"$event.currentTarget.href = 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/estimate\\/pdf' + '?t=' + Date.now()\"\\n\n        >\\n\n            Estimate PDF\\n\n        </a>\\n\n                </div>\\n\n        </div>\\n\n\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"btn btn-icon btn-sm\"\\n\n            title=\"Back to top\"\\n\n            aria-label=\"Back to top\"\\n\n            data-ro-footer-top\\n\n            @click=\"\\n\n                const target = document.querySelector('[data-worksheet-root]')\\n\n                    || document.getElementById('review-toolbar');\\n\n                (target || document.documentElement).scrollIntoView({ behavior: 'smooth', block: 'start' });\\n\n            \"\\n\n        >\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 11l-6 -6\"/><path d=\"M6 11l6 -6\"/></svg>\\n\n        </button>\\n\n    </div>\\n\n</footer>\\n\n                    </div>\\n\n    </aside>\\n\n\\n\n        <script>\\n\n            (() => {\\n\n                const rail = document.getElementById('estimate-builder-rail');\\n\n                if (!rail) {\\n\n                    return;\\n\n                }\\n\n\\n\n                const gap = 16;\\n\n                let lastHeight = 0;\\n\n                let queued = false;\\n\n\\n\n                // From lg the rail is sticky below the top bar and workspace strip. One taller than the space above the\\n\n                // action dock scrolls on its own (ops-review-rail--scrolls, tabler.css) with its tabs and summary pinned.\\n\n                const fit = () => {\\n\n                    queued = false;\\n\n\\n\n                    if (window.innerWidth < 1024) {\\n\n                        rail.classList.remove('ops-review-rail--scrolls');\\n\n                        lastHeight = rail.scrollHeight;\\n\n                        return;\\n\n                    }\\n\n\\n\n                    // Continuity can replace the dock and the totals card, so look them up on every fit.\\n\n                    const footer = document.querySelector('[data-ro-orientation-header]');\\n\n                    const header = rail.querySelector('#estimate-total-panel > .card-header');\\n\n                    const summary = rail.querySelector('[data-rail-summary]');\\n\n                    const top = parseFloat(getComputedStyle(rail).top) || 0;\\n\n                    if (footer) {\\n\n                        const dockReserve = Math.ceil(footer.offsetHeight) + 'px';\\n\n                        document.documentElement.style.setProperty('--ops-ro-dock-reserve', dockReserve);\\n\n                        document.body.style.setProperty('--ops-ro-dock-reserve', dockReserve);\\n\n                    }\\n\n                    // A sticky rail cannot outrun its column, so on a short page also leave the room the page has below it.\\n\n                    const container = rail.parentElement.getBoundingClientRect().bottom + window.scrollY;\\n\n                    const below = document.documentElement.scrollHeight - container;\\n\n                    const reserved = Math.max((footer ? footer.offsetHeight : 0) + gap, below);\\n\n                    const available = Math.floor(window.innerHeight - top - reserved);\\n\n                    const height = rail.scrollHeight;\\n\n                    const grew = lastHeight > 0 && height > lastHeight + 1;\\n\n                    const scrolls = height > available + 1;\\n\n                    const headerHeight = header ? header.offsetHeight : 0;\\n\n\\n\n                    rail.style.setProperty('--ops-rail-max-height', available + 'px');\\n\n                    rail.style.setProperty('--ops-rail-header-height', headerHeight + 'px');\\n\n                    rail.style.setProperty('--ops-rail-pinned-height', (headerHeight + (summary ? summary.offsetHeight : 0)) + 'px');\\n\n                    rail.classList.toggle('ops-review-rail--scrolls', scrolls);\\n\n                    lastHeight = height;\\n\n\\n\n                    if (scrolls || !grew || !footer) {\\n\n                        return;\\n\n                    }\\n\n\\n\n                    // A rail that still fits but grew under the dock is brought into view, as before.\\n\n                    const hidden = rail.getBoundingClientRect().bottom - (footer.getBoundingClientRect().top - gap);\\n\n                    if (hidden > 1) {\\n\n                        document.scrollingElement.scrollTop += hidden;\\n\n                    }\\n\n                };\\n\n\\n\n                const schedule = () => {\\n\n                    if (!queued) {\\n\n                        queued = true;\\n\n                        requestAnimationFrame(fit);\\n\n                    }\\n\n                };\\n\n\\n\n                fit();\\n\n                // The sticky offset includes the workspace strip, whose height is set once the deferred scripts ran.\\n\n                document.addEventListener('DOMContentLoaded', schedule, { once: true });\\n\n                window.addEventListener('resize', schedule);\\n\n                // A tab opens at its own start.\\n\n                rail.addEventListener('click', (event) => {\\n\n                    if (event.target.closest('[data-totals-tab]')) {\\n\n                        rail.scrollTop = 0;\\n\n                    }\\n\n                });\\n\n                if (typeof ResizeObserver !== 'undefined') {\\n\n                    // While the rail scrolls its own box keeps one height, so watch its content too, and the workspace strip\\n\n                    // and action dock that bound the space it has (the strip's height lands after the deferred scripts run).\\n\n                    const sizes = new ResizeObserver(schedule);\\n\n                    const watch = () => {\\n\n                        sizes.disconnect();\\n\n                        sizes.observe(rail);\\n\n                        [...rail.children].forEach((child) => sizes.observe(child));\\n\n                        document.querySelectorAll('#ops-workspace-tabs, [data-ro-orientation-header]').forEach((bound) => sizes.observe(bound));\\n\n                    };\\n\n                    watch();\\n\n                    new MutationObserver(() => {\\n\n                        watch();\\n\n                        schedule();\\n\n                    }).observe(rail, { childList: true });\\n\n                }\\n\n            })();\\n\n        </script>\\n\n    </div>\\n\n</div>\\n\n    </section>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"1daDqEQzetiVmpOiGYToqBpLIDYrRb71VXan4nJc\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox\",\"disabled_reason\":null},{\"id\":\"nav.reports\",\"title\":\"Reports\",\"group\":\"Navigate\",\"keywords\":[\"reports\",\"end of day\",\"operational\"],\"url\":\"http:\\/\\/localhost\\/app\\/reports\",\"disabled_reason\":null},{\"id\":\"create.repair-order\",\"title\":\"New Repair Order\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"ro\",\"repair\",\"intake\",\"check in\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.customer\",\"title\":\"New Customer\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"customer\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.vehicle\",\"title\":\"New Vehicle\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"vehicle\",\"intake\"],\"url\":\"http:\\/\\/localhost\\/app\\/intake\\/new\",\"disabled_reason\":null},{\"id\":\"create.appointment\",\"title\":\"New Appointment\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"appointment\",\"schedule\"],\"url\":\"http:\\/\\/localhost\\/app\\/appointments\\/create\",\"disabled_reason\":null},{\"id\":\"create.message\",\"title\":\"New Message\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"message\",\"text\",\"sms\",\"email\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose\",\"disabled_reason\":null},{\"id\":\"create.sms\",\"title\":\"New SMS\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"sms\",\"text\",\"phone\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=sms\",\"disabled_reason\":null},{\"id\":\"create.email\",\"title\":\"New Email\",\"group\":\"Create\",\"keywords\":[\"create\",\"new\",\"email\",\"mail\",\"compose\"],\"url\":\"http:\\/\\/localhost\\/app\\/communications\\/compose?channel=email\",\"disabled_reason\":null},{\"id\":\"search.customer\",\"title\":\"Search Customers\",\"group\":\"Search\",\"keywords\":[\"search\",\"customer\",\"phone\",\"name\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.vehicle\",\"title\":\"Search Vehicles\",\"group\":\"Search\",\"keywords\":[\"search\",\"vehicle\",\"vin\",\"plate\",\"license\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.vin\",\"title\":\"Search by VIN\",\"group\":\"Search\",\"keywords\":[\"search\",\"vin\",\"vehicle\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.plate\",\"title\":\"Search by License Plate\",\"group\":\"Search\",\"keywords\":[\"search\",\"plate\",\"license\",\"tag\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"search.phone\",\"title\":\"Search by Phone\",\"group\":\"Search\",\"keywords\":[\"search\",\"phone\",\"customer\",\"number\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"search.repair-order\",\"title\":\"Search Repair Orders\",\"group\":\"Search\",\"keywords\":[\"search\",\"ro\",\"repair\",\"order\",\"number\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.estimate\",\"title\":\"Search Estimates\",\"group\":\"Search\",\"keywords\":[\"search\",\"estimate\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"search.invoice\",\"title\":\"Search Invoices\",\"group\":\"Search\",\"keywords\":[\"search\",\"invoice\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"ops.print-key-tag\",\"title\":\"Print Key Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"key\",\"tag\"],\"url\":\"http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/print-key-tag\",\"disabled_reason\":null},{\"id\":\"ops.print-oil-sticker\",\"title\":\"Print Oil Sticker\",\"group\":\"Operations\",\"keywords\":[\"print\",\"oil\",\"sticker\",\"change\"],\"url\":\"http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/print-oil-change-sticker\",\"disabled_reason\":null},{\"id\":\"ops.print-service-tag\",\"title\":\"Print Service Tag\",\"group\":\"Operations\",\"keywords\":[\"print\",\"service\",\"tag\",\"tech\",\"sheet\"],\"url\":\"http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/sheets\\/tech\\/pdf\",\"disabled_reason\":null},{\"id\":\"ops.take-payment\",\"title\":\"Take Payment\",\"group\":\"Operations\",\"keywords\":[\"payment\",\"pay\",\"square\",\"collect\",\"balance\"],\"url\":\"http:\\/\\/localhost\\/app\\/repair-orders\\/1#estimate-builder-rail\",\"disabled_reason\":null},{\"id\":\"ops.record-deposit\",\"title\":\"Record Deposit\",\"group\":\"Operations\",\"keywords\":[\"deposit\",\"payment\",\"record\"],\"url\":\"http:\\/\\/localhost\\/app\\/repair-orders\\/1#estimate-builder-rail\",\"disabled_reason\":null},{\"id\":\"ops.open-active-ro\",\"title\":\"Open Active RO\",\"group\":\"Operations\",\"keywords\":[\"active\",\"ro\",\"open\",\"workboard\",\"repair\"],\"url\":\"http:\\/\\/localhost\\/app\\/repair-orders\\/1\",\"disabled_reason\":null}]</script>\\n\n        <div class=\"modal d-block\" tabindex=\"-1\">\\n\n            <div class=\"modal-backdrop show z-0\" data-ops-global-search-backdrop></div>\\n\n            <div\\n\n                class=\"modal-dialog modal-lg modal-dialog-scrollable\"\\n\n                data-ops-global-search-dialog\\n\n                role=\"dialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-label=\"Command palette\"\\n\n            >\\n\n                <div class=\"modal-content\">\\n\n                    <div class=\"modal-header p-2\">\\n\n                        <label class=\"visually-hidden\" for=\"ops-global-search-input\">Search commands and records</label>\\n\n                        <div class=\"input-icon w-100\">\\n\n                            <span class=\"input-icon-addon\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                            </span>\\n\n                            <input\\n\n                                id=\"ops-global-search-input\"\\n\n                                type=\"search\"\\n\n                                class=\"form-control form-control-lg\"\\n\n                                data-ops-global-search-input\\n\n                                placeholder=\"Type a command or search\u2026\"\\n\n                                autocomplete=\"off\"\\n\n                            >\\n\n                        </div>\\n\n                    </div>\\n\n                    <div class=\"modal-body p-0\">\\n\n                        <div class=\"list-group list-group-flush\" data-ops-global-search-results>\\n\n                            <div class=\"list-group-item small text-secondary\">\u2318K \u00b7 Enter runs \u00b7 Esc closes</div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <div\\n\n    x-data=\"arkLearnGuideModal()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ark-learn-guide-modal\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"title || 'ARKademy guide'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close guide preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header align-items-start\">\\n\n                    <div class=\"overflow-hidden\">\\n\n                        <div class=\"subheader\" x-show=\"sectionLabel\" x-text=\"sectionLabel\"></div>\\n\n                        <h2 class=\"modal-title\" x-text=\"title || 'ARKademy'\"></h2>\\n\n                        <div class=\"small text-secondary\" x-show=\"summary\" x-text=\"summary\"></div>\\n\n                    </div>\\n\n                    <button type=\"button\" class=\"btn-close\" @click=\"close()\" aria-label=\"Close\"></button>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-body\">\\n\n                    <div class=\"text-secondary\" x-show=\"loading\">\\n\n                        <span class=\"spinner-border spinner-border-sm me-2\" aria-hidden=\"true\"></span>Loading guide\u2026\\n\n                    </div>\\n\n                    <div class=\"alert alert-danger mb-0\" role=\"alert\" x-show=\"error\" x-text=\"error\"></div>\\n\n                    \\n\n                    <div\\n\n                        class=\"ark-legacy bg-white text-dark rounded p-3 ops-learn-prose ops-learn-guide-modal__prose\"\\n\n                        x-show=\"! loading && ! error && html\"\\n\n                        x-html=\"html\"\\n\n                    ></div>\\n\n                </div>\\n\n\\n\n                <div class=\"modal-footer\">\\n\n                                            <div class=\"small text-secondary me-auto\">Preview from ARK - open ARKademy for search, print, and full navigation.</div>\\n\n                                        <button type=\"button\" class=\"btn\" @click=\"close()\">Close</button>\\n\n                                            <a\\n\n                            :href=\"arkademyUrl\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-primary\"\\n\n                            x-show=\"arkademyUrl\"\\n\n                        >\\n\n                            Open in ARKademy\\n\n                        </a>\\n\n                                    </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n    <div x-data=\"arkCommsInterrupt()\" data-ark-comms-interrupt data-conversation-url-template=\"http://localhost/app/communications/inbox?conversation=__CONVERSATION__\" data-waiting-url=\"http://localhost/app/communications/inbox?filter=needs\">\\n\n        <div x-show=\"activeCall !== null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"callInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeCall\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-green\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"d-flex align-items-start gap-2\">\\n\n                                    <div class=\"flex-fill overflow-hidden\">\\n\n                                        <div class=\"small fw-bold text-uppercase text-green\" x-text=\"callEyebrow()\"></div>\\n\n                                        <template x-if=\"activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0 text-truncate\" x-text=\"activeCall.customer_name\"></div>\\n\n                                        </template>\\n\n                                        <template x-if=\"! activeCall.matched\">\\n\n                                            <div class=\"h3 mb-0\">Unknown Caller</div>\\n\n                                        </template>\\n\n                                        <div class=\"text-secondary\" x-text=\"activeCall.display_phone\"></div>\\n\n                                        <template x-if=\"activeCall.owned_by_name\">\\n\n                                            <div class=\"small text-secondary mt-1\" x-text=\"ownerLabel()\"></div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                    <button type=\"button\" class=\"btn btn-sm\" @click=\"dismissCall()\">Dismiss</button>\\n\n                                </div>\\n\n\\n\n                                <template x-if=\"activeCall.matched\">\\n\n                                    <div class=\"mt-2\">\\n\n                                        <div class=\"small fw-medium text-truncate\" x-text=\"vehicleSummary()\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"openRoSummary()\"></div>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeCall.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeCall.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeCall.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeCall.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"activeCall.matched && previewOpenRos().length > 0\">\\n\n                                    <div class=\"list-group mt-2\">\\n\n                                        <template x-for=\"openRepairOrder in previewOpenRos()\" :key=\"openRepairOrder.repair_order_id\">\\n\n                                            <a\\n\n                                                :href=\"openRepairOrder.url\"\\n\n                                                class=\"list-group-item list-group-item-action d-flex align-items-center gap-2 small\"\\n\n                                                @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                            >\\n\n                                                <span class=\"fw-bold text-nowrap\" x-text=\"'RO #' + openRepairOrder.repair_order_id\"></span>\\n\n                                                <span class=\"flex-fill text-truncate text-secondary\" x-text=\"openRepairOrder.vehicle_name\"></span>\\n\n                                                <span class=\"text-secondary text-nowrap\" x-text=\"openRepairOrder.status_label\"></span>\\n\n                                            </a>\\n\n                                        </template>\\n\n                                        <template x-if=\"extraOpenRoCount() > 0 && activeCall.customer_url\">\\n\n                                            <a :href=\"activeCall.customer_url\" class=\"list-group-item list-group-item-action small\" @click=\"markCallHandledForId(activeCall.call_session_id)\">\\n\n                                                +<span x-text=\"extraOpenRoCount()\"></span> more on Customer Hub\\n\n                                            </a>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n\\n\n                                <template x-if=\"lastConversationSnippet()\">\\n\n                                    <p class=\"small text-secondary mt-2 mb-0\" x-text=\"lastConversationSnippet()\"></p>\\n\n                                </template>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther() && activeCall.show_callback_action\"\\n\n                                    type=\"button\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"window.arkInitiateTelephonyCallback?.({\\n\n                                        customerId: activeCall.callback_customer_id,\\n\n                                        phone: activeCall.callback_phone,\\n\n                                        callSessionId: activeCall.call_session_id,\\n\n                                        button: $event.currentTarget,\\n\n                                    }); activeCall = null;\"\\n\n                                >Callback</button>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && activeCall.matched && activeCall.customer_url\"\\n\n                                    :href=\"activeCall.customer_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Open Customer</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched && activeCall.create_contact_url\"\\n\n                                    :href=\"activeCall.create_contact_url\"\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Create Contact</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther() && ! activeCall.matched\"\\n\n                                    :href=\"activeCall.intake_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Start Check In</a>\\n\n\\n\n                                <a\\n\n                                    x-show=\"! ownedByOther()\"\\n\n                                    :href=\"activeCall.lookup_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"markCallHandledForId(activeCall.call_session_id)\"\\n\n                                >Caller Lookup</a>\\n\n\\n\n                                <button\\n\n                                    x-show=\"! ownedByOther()\"\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-ghost-secondary\"\\n\n                                    @click=\"markCallHandled()\"\\n\n                                >Mark Handled</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div x-show=\"activeMessage !== null && activeCall === null\" x-cloak>\\n\n            <div\\n\n                x-ref=\"messageInterruptDialog\"\\n\n                class=\"modal d-block\"\\n\n                role=\"alertdialog\"\\n\n                aria-modal=\"true\"\\n\n                aria-live=\"assertive\"\\n\n                tabindex=\"-1\"\\n\n                @mousedown=\"steerInterruptFocus($event)\"\\n\n                @keydown.enter.prevent=\"activateInterruptPrimary($event)\"\\n\n            >\\n\n                <div x-show=\"attentionGateEnabled()\" class=\"modal-backdrop show z-0\" aria-hidden=\"true\"></div>\\n\n                <template x-if=\"activeMessage\">\\n\n                    <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                        <div class=\"modal-content\">\\n\n                            <div class=\"modal-status bg-azure\"></div>\\n\n                            <div class=\"modal-body\">\\n\n                                <div class=\"small fw-bold text-uppercase text-azure\" x-text=\"channelLabel()\"></div>\\n\n                                <div class=\"h3 mb-0 text-truncate\" x-text=\"activeMessage.headline ?? 'Unknown'\"></div>\\n\n                                <div class=\"text-secondary\" x-text=\"activeMessage.display_phone\"></div>\\n\n\\n\n                                <p\\n\n                                    class=\"fw-medium text-break mt-2 mb-0\"\\n\n                                    x-show=\"snippetPreview() !== ''\"\\n\n                                    x-text=\"snippetPreview()\"\\n\n                                ></p>\\n\n                                <a\\n\n                                    x-show=\"moreCount > 0 && waitingUrl() !== ''\"\\n\n                                    :href=\"waitingUrl()\"\\n\n                                    class=\"d-inline-block small mt-2\"\\n\n                                    data-comms-interrupt-more\\n\n                                    x-text=\"moreLabel()\"\\n\n                                ></a>\\n\n                                <template x-if=\"activeMessage?.orientation?.situation\">\\n\n                                    <div class=\"border-start border-3 border-primary ps-2 mt-2\">\\n\n                                        <div class=\"subheader\">Current Situation</div>\\n\n                                        <div class=\"fw-medium\" x-text=\"activeMessage.orientation.situation\"></div>\\n\n                                        <div class=\"small text-secondary\" x-text=\"activeMessage.orientation.progress_stopped_because\"></div>\\n\n                                        <template x-if=\"activeMessage.orientation.next_action\">\\n\n                                            <div class=\"small mt-1\">\\n\n                                                <span class=\"fw-bold\">Next:</span>\\n\n                                                <span x-text=\"activeMessage.orientation.next_action\"></span>\\n\n                                            </div>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n                                <template x-if=\"messageAttachments().length > 0\">\\n\n                                    <div class=\"d-grid gap-2 mt-2\">\\n\n                                        <template x-for=\"attachment in messageAttachments()\" :key=\"attachment.id\">\\n\n                                            <template x-if=\"attachment.is_image && attachment.url\">\\n\n                                                <button\\n\n                                                    type=\"button\"\\n\n                                                    class=\"btn p-0 border-0 w-100\"\\n\n                                                    :data-ops-lightbox=\"attachment.url\"\\n\n                                                    data-ops-lightbox-alt=\"Message attachment\"\\n\n                                                    aria-label=\"View attachment\"\\n\n                                                >\\n\n                                                    <img\\n\n                                                        :src=\"attachment.url\"\\n\n                                                        alt=\"Attachment\"\\n\n                                                        class=\"w-100 rounded border object-fit-cover\"\\n\n                                                        style=\"max-height: 9rem\"\\n\n                                                    >\\n\n                                                </button>\\n\n                                            </template>\\n\n                                            <template x-if=\"attachment.is_video && attachment.url\">\\n\n                                                <video\\n\n                                                    controls\\n\n                                                    class=\"w-100 rounded border\"\\n\n                                                    style=\"max-height: 9rem\"\\n\n                                                    preload=\"metadata\"\\n\n                                                >\\n\n                                                    <source :src=\"attachment.url\" :type=\"attachment.content_type\">\\n\n                                                </video>\\n\n                                            </template>\\n\n                                            <template x-if=\"attachment.is_audio && attachment.url\">\\n\n                                                <audio\\n\n                                                    controls\\n\n                                                    class=\"w-100\"\\n\n                                                    preload=\"metadata\"\\n\n                                                >\\n\n                                                    <source :src=\"attachment.url\" :type=\"attachment.content_type\">\\n\n                                                </audio>\\n\n                                            </template>\\n\n                                            <template x-if=\"! attachment.is_image && ! attachment.is_video && ! attachment.is_audio && attachment.url\">\\n\n                                                <a\\n\n                                                    :href=\"attachment.url\"\\n\n                                                    target=\"_blank\"\\n\n                                                    rel=\"noopener\"\\n\n                                                    class=\"btn btn-sm\"\\n\n                                                    x-text=\"attachment.is_pdf ? 'PDF attachment' : 'Download attachment'\"\\n\n                                                ></a>\\n\n                                            </template>\\n\n                                        </template>\\n\n                                    </div>\\n\n                                </template>\\n\n                                <p\\n\n                                    class=\"small text-secondary mt-2 mb-0\"\\n\n                                    x-show=\"activeMessage.context_summary\"\\n\n                                    x-text=\"activeMessage.context_summary\"\\n\n                                ></p>\\n\n                            </div>\\n\n\\n\n                            <div class=\"modal-footer flex-wrap\">\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind === 'website_lead' && activeMessage?.intake_url\"\\n\n                                    :href=\"activeMessage.intake_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"openWebsiteLeadIntake($event)\"\\n\n                                >Check In</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind === 'portal' && activeMessage?.repair_order_url\"\\n\n                                    :href=\"activeMessage.repair_order_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"activeMessage?.show_mark_read_action ? markMessageRead() : dismissPortal()\"\\n\n                                >Open RO</a>\\n\n                                <a\\n\n                                    x-show=\"(activeMessage?.kind === 'sms' || activeMessage?.kind === 'mms') && conversationUrl() !== ''\"\\n\n                                    :href=\"conversationUrl()\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    data-comms-interrupt-open\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"openConversation($event)\"\\n\n                                >Open conversation</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind !== 'portal' && activeMessage?.direction === 'inbound' && activeMessage?.reply_url\"\\n\n                                    :href=\"activeMessage.reply_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                    @click=\"replyToMessage($event)\"\\n\n                                >Reply</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.matched && activeMessage?.customer_url\"\\n\n                                    :href=\"activeMessage.customer_url\"\\n\n                                    class=\"btn\"\\n\n                                >Open Customer</a>\\n\n                                <a\\n\n                                    x-show=\"! activeMessage?.matched && activeMessage?.create_contact_url && activeMessage?.kind !== 'website_lead'\"\\n\n                                    :href=\"activeMessage.create_contact_url\"\\n\n                                    data-comms-interrupt-primary\\n\n                                    class=\"btn btn-primary\"\\n\n                                >Create Contact</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.kind === 'website_lead' && ! activeMessage?.matched && activeMessage?.create_contact_url\"\\n\n                                    :href=\"activeMessage.create_contact_url\"\\n\n                                    class=\"btn\"\\n\n                                    @click=\"dismissWebsiteLead()\"\\n\n                                >Create contact</a>\\n\n                                <a\\n\n                                    x-show=\"! activeMessage?.matched && activeMessage?.intake_url && ! activeMessage?.reply_url && activeMessage?.kind !== 'website_lead'\"\\n\n                                    :href=\"activeMessage.intake_url\"\\n\n                                    class=\"btn\"\\n\n                                >Start Check In</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.lookup_url\"\\n\n                                    :href=\"activeMessage.lookup_url\"\\n\n                                    class=\"btn\"\\n\n                                >Lookup</a>\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-ghost-secondary\"\\n\n                                    @click=\"activeMessage?.kind === 'website_lead'\\n\n                                        ? dismissWebsiteLead()\\n\n                                        : (activeMessage?.kind === 'portal' ? dismissPortal() : dismissMessage())\"\\n\n                                >Dismiss</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <script type=\"application/json\" id=\"ark-call-queue-bootstrap\">{\"count\":0,\"summary\":{\"count\":0,\"call_count\":0,\"message_count\":0,\"since_last_shift_count\":0,\"has_live_calls\":false,\"urgency\":\"idle\",\"breakdown_label\":\"\",\"trigger_label\":\"\"},\"items\":[],\"calls\":[],\"messages\":[],\"queue_url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox?filter=needs\"}</script>\\n\n        <div\\n\n        data-call-queue-root\\n\n        x-data=\"arkCallQueue()\"\\n\n        @click.outside=\"open = false\"\\n\n        class=\"d-none\"\\n\n        aria-hidden=\"true\"\\n\n    ></div>\\n\n    <div\\n\n    x-data=\"arkImageLightbox()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ops-image-lightbox\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"alt || 'Image preview'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close image preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-dialog-centered modal-xl\" data-bs-theme=\"dark\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header flex-wrap gap-2 py-2\">\\n\n                    <div class=\"small fw-bold text-truncate flex-fill\" x-text=\"alt || 'Attachment preview'\"></div>\\n\n                    <div class=\"btn-list flex-nowrap\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomOut()\"\\n\n                            :disabled=\"scale <= minScale + 0.001\"\\n\n                            aria-label=\"Zoom out\"\\n\n                        >\\n\n                            \u2212\\n\n                        </button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            @click=\"fitToView()\"\\n\n                            x-text=\"zoomPercentLabel()\"\\n\n                            aria-label=\"Reset zoom to fit\"\\n\n                        ></button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomIn()\"\\n\n                            :disabled=\"scale >= maxScale - 0.001\"\\n\n                            aria-label=\"Zoom in\"\\n\n                        >\\n\n                            +\\n\n                        </button>\\n\n                        <a\\n\n                            :href=\"src\"\\n\n                            target=\"_blank\"\\n\n                            rel=\"noopener noreferrer\"\\n\n                            class=\"btn btn-sm\"\\n\n                            x-show=\"src\"\\n\n                        >\\n\n                            Open original\\n\n                        </a>\\n\n                        <button type=\"button\" class=\"btn btn-sm\" @click=\"close()\">Close</button>\\n\n                    </div>\\n\n                </div>\\n\n\\n\n                <div\\n\n                    x-ref=\"viewport\"\\n\n                    class=\"modal-body p-0 d-flex align-items-center justify-content-center overflow-hid