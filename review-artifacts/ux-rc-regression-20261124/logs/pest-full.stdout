|| {};\\n\n    if (!urls || !urls.length) {\\n\n        return;\\n\n    }\\n\n    if (typeof window.ARK_PRINTERS === 'undefined' || !window.ARK_PRINTERS.keyTag || String(window.ARK_PRINTERS.keyTag).trim() === '') {\\n\n        if (window.toastr && typeof window.toastr.warning === 'function') {\\n\n            window.toastr.warning('Key tag printer is not configured');\\n\n        }\\n\n        return;\\n\n    }\\n\n    if (btn) {\\n\n        btn.disabled = true;\\n\n    }\\n\n    var lockOwner = null;\\n\n    var ok = 0;\\n\n    try {\\n\n        window.ARK_PRINT_QUEUE_LAST_HARD_ERROR = null;\\n\n        window.ARK_PRINT_QUEUE_LAST_FAIL_URL = null;\\n\n        var lockTtl = arkComputeLockTtl({ count: urls.length, bytes: 0 });\\n\n        lockOwner = arkAcquireLock(lockTtl);\\n\n        var sec = Math.ceil(lockTtl / 1000);\\n\n        if (window.toastr && typeof window.toastr.info === 'function') {\\n\n            window.toastr.info(\\n\n                'Printing ' +\\n\n                    urls.length +\\n\n                    ' key tag' +\\n\n                    (urls.length === 1 ? '' : 's') +\\n\n                    ' (queued)\u2026 (~' +\\n\n                    sec +\\n\n                    's)'\\n\n            );\\n\n        }\\n\n        var batchId =\\n\n            batchOptions.batchId && String(batchOptions.batchId).trim() !== ''\\n\n                ? String(batchOptions.batchId).trim()\\n\n                : arkMakeBatchId();\\n\n        var n = urls.length;\\n\n        var i;\\n\n        for (i = 0; i < n; i++) {\\n\n            (function(url, idx) {\\n\n                arkEnqueuePrintItem(\\n\n                    arkMakeQueueItem(window.ARK_PRINTERS.keyTag, url, {\\n\n                        batchId: batchId,\\n\n                        skipLock: true,\\n\n                        document: 'key_tag',\\n\n                        printSource: 'batch'\\n\n                    }, function(p) {\\n\n                        return p\\n\n                            .then(function() {\\n\n                                ok++;\\n\n                                if (\\n\n                                    idx > 0 &&\\n\n                                    (idx + 1) % 5 === 0 &&\\n\n                                    window.toastr &&\\n\n                                    typeof window.toastr.info === 'function'\\n\n                                ) {\\n\n                                    window.toastr.info('Printed ' + (idx + 1) + '/' + n + ' key tags\u2026');\\n\n                                }\\n\n                            })\\n\n                            .catch(function(err) {\\n\n                                var c = arkClassifyError(err);\\n\n                                if (c === 'QZ_OFFLINE' || c === 'QZ_DISCONNECTED') {\\n\n                                    window.ARK_PRINT_QUEUE_LAST_FAIL_URL = url;\\n\n                                }\\n\n                                throw err;\\n\n                            });\\n\n                    })\\n\n                );\\n\n            })(urls[i], i);\\n\n        }\\n\n        await arkWaitPrintQueueIdle();\\n\n        var hard = window.ARK_PRINT_QUEUE_LAST_HARD_ERROR;\\n\n        var stoppedHard = !!hard;\\n\n        var pec = hard ? arkClassifyError(hard) : '';\\n\n        if (stoppedHard && (pec === 'QZ_OFFLINE' || pec === 'QZ_DISCONNECTED')) {\\n\n            if (window.toastr && typeof window.toastr.error === 'function') {\\n\n                window.toastr.error(\\n\n                    ok > 0\\n\n                        ? 'Batch stopped: printer connection lost after ' +\\n\n                              ok +\\n\n                              ' item' +\\n\n                              (ok === 1 ? '' : 's')\\n\n                        : 'Batch stopped: printer connection lost before any item printed'\\n\n                );\\n\n            }\\n\n            var failUrl = window.ARK_PRINT_QUEUE_LAST_FAIL_URL;\\n\n            if (failUrl) {\\n\n     