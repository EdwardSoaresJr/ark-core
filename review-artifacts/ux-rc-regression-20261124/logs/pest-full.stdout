url\"\\n\n                                    class=\"btn\"\\n\n                                >Start Check In</a>\\n\n                                <a\\n\n                                    x-show=\"activeMessage?.lookup_url\"\\n\n                                    :href=\"activeMessage.lookup_url\"\\n\n                                    class=\"btn\"\\n\n                                >Lookup</a>\\n\n                                <button\\n\n                                    type=\"button\"\\n\n                                    class=\"btn btn-ghost-secondary\"\\n\n                                    @click=\"activeMessage?.kind === 'website_lead'\\n\n                                        ? dismissWebsiteLead()\\n\n                                        : (activeMessage?.kind === 'portal' ? dismissPortal() : dismissMessage())\"\\n\n                                >Dismiss</button>\\n\n                            </div>\\n\n                        </div>\\n\n                    </div>\\n\n                </template>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n    <script type=\"application/json\" id=\"ark-call-queue-bootstrap\">{\"count\":0,\"summary\":{\"count\":0,\"call_count\":0,\"message_count\":0,\"since_last_shift_count\":0,\"has_live_calls\":false,\"urgency\":\"idle\",\"breakdown_label\":\"\",\"trigger_label\":\"\"},\"items\":[],\"calls\":[],\"messages\":[],\"queue_url\":\"http:\\/\\/localhost\\/app\\/communications\\/inbox?filter=needs\"}</script>\\n\n        <div\\n\n        data-call-queue-root\\n\n        x-data=\"arkCallQueue()\"\\n\n        @click.outside=\"open = false\"\\n\n        class=\"d-none\"\\n\n        aria-hidden=\"true\"\\n\n    ></div>\\n\n    <div\\n\n    x-data=\"arkImageLightbox()\"\\n\n    x-cloak\\n\n    x-show=\"open\"\\n\n    x-transition.opacity.duration.150ms\\n\n    @keydown.escape.window=\"close()\"\\n\n    data-ops-image-lightbox\\n\n>\\n\n    <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"alt || 'Image preview'\" tabindex=\"-1\">\\n\n        <button\\n\n            type=\"button\"\\n\n            class=\"modal-backdrop show z-0 border-0 p-0\"\\n\n            @click=\"close()\"\\n\n            aria-label=\"Close image preview\"\\n\n        ></button>\\n\n\\n\n        <div class=\"modal-dialog modal-dialog-centered modal-xl\" data-bs-theme=\"dark\">\\n\n            <div class=\"modal-content\">\\n\n                <div class=\"modal-header flex-wrap gap-2 py-2\">\\n\n                    <div class=\"small fw-bold text-truncate flex-fill\" x-text=\"alt || 'Attachment preview'\"></div>\\n\n                    <div class=\"btn-list flex-nowrap\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomOut()\"\\n\n                            :disabled=\"scale <= minScale + 0.001\"\\n\n                            aria-label=\"Zoom out\"\\n\n                        >\\n\n                            \u2212\\n\n                        </button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            @click=\"fitToView()\"\\n\n                            x-text=\"zoomPercentLabel()\"\\n\n                            aria-label=\"Reset zoom to fit\"\\n\n                        ></button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-icon\"\\n\n                            @click=\"zoomIn()\"\\n\n                            :disabled=\"scale >= maxScale - 0.001\"\\n\n                            aria-label=\"Zoom in\"\\n\n                        >\\n\n                            +\\n\n                        </button>\\n\n                        <a\\n\n                            :href=\"src\"\\n\n       