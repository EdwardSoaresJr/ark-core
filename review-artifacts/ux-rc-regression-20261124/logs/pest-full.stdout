   </details>\\n\n    </section>\\n\n\\n\n    <details class=\"card\" data-shop-comms-station-names>\\n\n        <summary class=\"card-header\">\\n\n            <span class=\"card-title\">Manage station names</span>\\n\n        </summary>\\n\n        <div class=\"list-group list-group-flush\">\\n\n                            <details class=\"list-group-item\" >\\n\n                    <summary class=\"fw-medium\">\\n\n                        Front Counter\\n\n                    </summary>\\n\n                    <form\\n\n                        method=\"POST\"\\n\n                        action=\"http://localhost/app/shop/workstations/1\"\\n\n                        class=\"mt-2\"\\n\n                    >\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"5tBWwD71pek3QPk1PzyR65dFQ4QDC924vjKdfZvT\" autocomplete=\"off\">                        <input type=\"hidden\" name=\"_method\" value=\"PATCH\">                        <input type=\"hidden\" name=\"edit_workstation_id\" value=\"1\">\\n\n                        <div class=\"mb-2\">\\n\n                            <label class=\"form-label\" for=\"shop-station-1-name\">Name</label>\\n\n                            <input\\n\n                                id=\"shop-station-1-name\"\\n\n                                type=\"text\"\\n\n                                name=\"name\"\\n\n                                value=\"Front Counter\"\\n\n                                required\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <div class=\"mb-2\">\\n\n                            <label class=\"form-label\" for=\"shop-station-1-location\">Location <span class=\"text-secondary fw-normal\">(optional)</span></label>\\n\n                            <input\\n\n                                id=\"shop-station-1-location\"\\n\n                                type=\"text\"\\n\n                                name=\"location_label\"\\n\n                                value=\"\"\\n\n                                class=\"form-control\"\\n\n                            >\\n\n                        </div>\\n\n                        <button type=\"submit\" class=\"btn btn-primary btn-sm\">Save</button>\\n\n                    </form>\\n\n                </details>\\n\n                    </div>\\n\n    </details>\\n\n                    </div>\\n\n    </div>\\n\n</div>\\n\n        </main>\\n\n    </div>\\n\n</div>\\n\n\\n\n\\n\n    <div\\n\n        data-ops-global-search\\n\n        data-ops-global-search-ui=\"tabler\"\\n\n        data-search-url=\"http://localhost/app/search\"\\n\n        data-compose-url=\"http://localhost/app/communications/compose\"\\n\n        data-csrf=\"5tBWwD71pek3QPk1PzyR65dFQ4QDC924vjKdfZvT\"\\n\n        hidden\\n\n        aria-hidden=\"true\"\\n\n    >\\n\n        <script type=\"application/json\" data-ops-global-search-commands>[{\"id\":\"nav.workboard\",\"title\":\"Job Board\",\"group\":\"Navigate\",\"keywords\":[\"job board\",\"workboard\",\"board\",\"today\",\"home\",\"attention\"],\"url\":\"http:\\/\\/localhost\\/app\",\"disabled_reason\":null},{\"id\":\"nav.repair-orders\",\"title\":\"Repair Orders\",\"group\":\"Navigate\",\"keywords\":[\"ro\",\"repair\",\"orders\",\"queue\"],\"url\":\"http:\\/\\/localhost\\/repair-orders\",\"disabled_reason\":null},{\"id\":\"nav.customers\",\"title\":\"Customers\",\"group\":\"Navigate\",\"keywords\":[\"customer\",\"people\",\"clients\"],\"url\":\"http:\\/\\/localhost\\/app\\/customers\\/search\",\"disabled_reason\":null},{\"id\":\"nav.vehicles\",\"title\":\"Vehicles\",\"group\":\"Navigate\",\"keywords\":[\"vehicle\",\"car\",\"vin\",\"plate\"],\"url\":\"http:\\/\\/localhost\\/app\\/vehicles\\/search\",\"disabled_reason\":null},{\"id\":\"nav.communications\",\"title\":\"Communications\",\"group\":\"Navigate\",\"keywords\":[\"comms\",\"inbox\",\"messages\",\"sms\",\"calls\"],\"url\":\"ht