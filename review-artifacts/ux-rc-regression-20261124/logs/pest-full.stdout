centage\\u0022:\\u002233\\u0022,\\u0022sort_order\\u0022:5},{\\u0022uid\\u0022:\\u0022filters-5\\u0022,\\u0022min_cost\\u0022:\\u0022250.01\\u0022,\\u0022max_cost\\u0022:\\u002299999.99\\u0022,\\u0022markup_percentage\\u0022:\\u002245.00\\u0022,\\u0022margin_percentage\\u0022:\\u002231\\u0022,\\u0022sort_order\\u0022:6}]},{\\u0022key\\u0022:\\u0022fluids\\u0022,\\u0022name\\u0022:\\u0022Fluids\\u0022,\\u0022is_default\\u0022:false,\\u0022index\\u0022:2,\\u0022rows\\u0022:[{\\u0022uid\\u0022:\\u0022fluids-0\\u0022,\\u0022min_cost\\u0022:\\u00220.00\\u0022,\\u0022max_cost\\u0022:\\u002210.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022150.00\\u0022,\\u0022margin_percentage\\u0022:\\u002260\\u0022,\\u0022sort_order\\u0022:1},{\\u0022uid\\u0022:\\u0022fluids-1\\u0022,\\u0022min_cost\\u0022:\\u002210.01\\u0022,\\u0022max_cost\\u0022:\\u002225.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022110.00\\u0022,\\u0022margin_percentage\\u0022:\\u002252\\u0022,\\u0022sort_order\\u0022:2},{\\u0022uid\\u0022:\\u0022fluids-2\\u0022,\\u0022min_cost\\u0022:\\u002225.01\\u0022,\\u0022max_cost\\u0022:\\u002250.00\\u0022,\\u0022markup_percentage\\u0022:\\u002280.00\\u0022,\\u0022margin_percentage\\u0022:\\u002244\\u0022,\\u0022sort_order\\u0022:3},{\\u0022uid\\u0022:\\u0022fluids-3\\u0022,\\u0022min_cost\\u0022:\\u002250.01\\u0022,\\u0022max_cost\\u0022:\\u0022100.00\\u0022,\\u0022markup_percentage\\u0022:\\u002265.00\\u0022,\\u0022margin_percentage\\u0022:\\u002239\\u0022,\\u0022sort_order\\u0022:4},{\\u0022uid\\u0022:\\u0022fluids-4\\u0022,\\u0022min_cost\\u0022:\\u0022100.01\\u0022,\\u0022max_cost\\u0022:\\u0022250.00\\u0022,\\u0022markup_percentage\\u0022:\\u002255.00\\u0022,\\u0022margin_percentage\\u0022:\\u002235\\u0022,\\u0022sort_order\\u0022:5},{\\u0022uid\\u0022:\\u0022fluids-5\\u0022,\\u0022min_cost\\u0022:\\u0022250.01\\u0022,\\u0022max_cost\\u0022:\\u002299999.99\\u0022,\\u0022markup_percentage\\u0022:\\u002245.00\\u0022,\\u0022margin_percentage\\u0022:\\u002231\\u0022,\\u0022sort_order\\u0022:6}]},{\\u0022key\\u0022:\\u0022oem-parts\\u0022,\\u0022name\\u0022:\\u0022OEM Parts\\u0022,\\u0022is_default\\u0022:false,\\u0022index\\u0022:3,\\u0022rows\\u0022:[{\\u0022uid\\u0022:\\u0022oem-parts-0\\u0022,\\u0022min_cost\\u0022:\\u00220.00\\u0022,\\u0022max_cost\\u0022:\\u002225.00\\u0022,\\u0022markup_percentage\\u0022:\\u002290.00\\u0022,\\u0022margin_percentage\\u0022:\\u002247\\u0022,\\u0022sort_order\\u0022:1},{\\u0022uid\\u0022:\\u0022oem-parts-1\\u0022,\\u0022min_cost\\u0022:\\u002225.01\\u0022,\\u0022max_cost\\u0022:\\u0022100.00\\u0022,\\u0022markup_percentage\\u0022:\\u002270.00\\u0022,\\u0022margin_percentage\\u0022:\\u002241\\u0022,\\u0022sort_order\\u0022:2},{\\u0022uid\\u0022:\\u0022oem-parts-2\\u0022,\\u0022min_cost\\u0022:\\u0022100.01\\u0022,\\u0022max_cost\\u0022:\\u0022250.00\\u0022,\\u0022markup_percentage\\u0022:\\u002255.00\\u0022,\\u0022margin_percentage\\u0022:\\u002235\\u0022,\\u0022sort_order\\u0022:3},{\\u0022uid\\u0022:\\u0022oem-parts-3\\u0022,\\u0022min_cost\\u0022:\\u0022250.01\\u0022,\\u0022max_cost\\u0022:\\u0022500.00\\u0022,\\u0022markup_percentage\\u0022:\\u002245.00\\u0022,\\u0022margin_percentage\\u0022:\\u002231\\u0022,\\u0022sort_order\\u0022:4},{\\u0022uid\\u0022:\\u0022oem-parts-4\\u0022,\\u0022min_cost\\u0022:\\u0022500.01\\u0022,\\u0022max_cost\\u0022:\\u00221000.00\\u0022,\\u0022markup_percentage\\u0022:\\u002240.00\\u0022,\\u0022margin_percentage\\u0022:\\u002229\\u0022,\\u0022sort_order\\u0022:5},{\\u0022uid\\u0022:\\u0022oem-parts-5\\u0022,\\u0022min_cost\\u0022:\\u00221000.01\\u0022,\\u0022max_cost\\u0022:\\u00222500.00\\u0022,\\u0022markup_percentage\\u0022:\\u002235.00\\u0022,\\u0022margin_percentage\\u0022:\\u002226\\u0022,\\u0022sort_order\\u0022:6},{\\u0022uid\\u0022:\\u0022oem-parts-6\\u0022,\\u0022min_cost\\u0022:\\u00222500.01\\u0022,\\u0022max_cost\\u0022:\\u002299999.99\\u0022,\\u0022markup_percentage\\u0022:\\u002232.00\\u0022,\\u0022margin_percentage\\u0022:\\u002224\\u0022,\\u0022sort_order\\u0022:7}]},{\\u0022key\\u0022:\\u0022warranty-no-markup\\u0022,\\u0022name\\u0022:\\u0022Warranty (No Markup)\\u0022,\\u0022is_default\\u0022:false,\\u0022index\\u0022:4,\\u0022rows\\u0022:[{\\u0022uid\\u0022:\\u0022warranty-no-markup-0\\u0022,\\u0022min_cost\\u0022:\\u00220.00\\u0022,\\u0022max_cost\\u0022:\\u0022\\u0022,\\u0022markup_percentage\\u0022:\\u00220.00\\u0022,\\u0022margin_percentage\\u0022:\\u00220\\u0022,\\u0022sort_order\\u0022:1}]}]'), 'aft-parts')\"\\n\n>\\n\n    <div class=\"row g-2 mb-3\">\\n\n        <div class=\"col-12 col-md-4\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">You set</div>\\n\n                    <div class=\"h3 mb-0\">Markup %</div>\\n\n                    <div class=\"small text-secondary\">Changes sell price policy</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-12 col-md-4\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">Calculated</div>\\n\n                    <div class=\"h3 mb-0\">Margin %</div>\\n\n                    <div class=\"small text-secondary\">Parts gross profit from your markup</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n        <div class=\"col-12 col-md-4\">\\n\n            <div class=\"card card-sm h-100\">\\n\n                <div class=\"card-body\">\\n\n                    <div class=\"subheader\">Target</div>\\n\n                    <div class=\"h3 mb-0\">45-60%</div>\\n\n                    <div class=\"small text-secondary\">Parts GP health</div>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n\\n\n    <p class=\"text-secondary small\">\\n\n        Markup is the editable pricing policy. Margin is calculated visibility for parts GP health. Matrices affect new part sell pricing; line overrides remain operational exceptions, not hidden settings behavior.\\n\n        <a href=\"http://localhost/app/owner/parts-matrix-tune\" class=\"fw-medium\">Matrix tune assistant</a>\\n\n        - simulate tier changes from closed part-line history before saving live policy.\\n\n    </p>\\n\n\\n\n    \\n\n    \\n\n    <div class=\"ops-financial-master-detail\">\\n\n        <div class=\"ops-financial-master-detail__nav\">\\n\n            <nav class=\"card sticky-lg-top\" style=\"top: 1rem\" aria-label=\"Parts matrices\" data-parts-matrix-nav>\\n\n                <div class=\"card-header py-2\">\\n\n                    <div class=\"subheader\">Parts matrices</div>\\n\n                </div>\\n\n                <div class=\"list-group list-group-flush\">\\n\n                    <template x-for=\"matrix in matrices\" :key=\"matrix.key\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"list-group-item list-group-item-action ops-financial-master-detail__nav-item\"\\n\n                            :class=\"{ 'active': selectedKey === matrix.key }\"\\n\n                            :aria-current=\"selectedKey === matrix.key ? 'page' : null\"\\n\n                            :data-parts-matrix-tab=\"matrix.key\"\\n\n                            @click=\"selectMatrix(matrix.key)\"\\n\n                        >\\n\n                            <span class=\"ops-financial-master-detail__nav-label\" x-text=\"matrix.name\"></span>\\n\n                            <span class=\"badge bg-secondary-lt\" x-show=\"matrix.key === defaultPartsMatrixKey\" x-cloak>Default</span>\\n\n                        </button>\\n\n                    </template>\\n\n                </div>\\n\n            </nav>\\n\n            <p class=\"small text-secondary mt-2 mb-0 d-lg-none\">Select a matrix above, then edit its pricing tiers.</p>\\n\n        </div>\\n\n\\n\n        <div class=\"ops-financial-master-detail__editor\">\\n\n            <form\\n\n                id=\"parts-matrix-form\"\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/settings/shop/parts-matrices/aft-parts\"\\n\n                :action=\"updateAction\"\\n\n                data-parts-matrix-editor\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"1iRwODkZLXTqrqT51lmNGZxHCofNuvMLJKcovT1H\" autocomplete=\"off\">                <input type=\"hidden\" name=\"_method\" value=\"PATCH\">\\n\n                \\n\n                <template x-for=\"(matrix, matrixIndex) in matrices\" :key=\"'fields-'+matrix.key\">\\n\n                    <template x-if=\"selectedKey === matrix.key\">\\n\n                        <div :data-parts-matrix=\"matrix.key\">\\n\n                            <div class=\"card card-sm\">\\n\n                                <div class=\"card-header\">\\n\n                                    <div class=\"row g-2 align-items-center flex-fill\">\\n\n                                        <div class=\"col\">\\n\n                                            <input type=\"hidden\" :name=\"`parts_matrices[${matrixIndex}][key]`\" :value=\"matrix.key\">\\n\n                                            <label class=\"form-label visually-hidden\" :for=\"'parts-matrix-name-'+matrix.key\">Matrix name</label>\\n\n                                            <input\\n\n                                                :id=\"'parts-matrix-name-'+matrix.key\"\\n\n                                                data-matrix-name-input\\n\n                                                :name=\"`parts_matrices[${matrixIndex}][name]`\"\\n\n                                                x-model=\"matrix.name\"\\n\n                                                @input=\"queueAutosave()\"\\n\n                                                required\\n\n                                                maxlength=\"64\"\\n\n                                                aria-label=\"Matrix name\"\\n\n                                                class=\"form-control fw-medium\"\\n\n                                            >\\n\n                                        </div>\\n\n                                        <div class=\"col-auto\">\\n\n                                            <label class=\"form-check mb-0\">\\n\n                                                <input\\n\n                                                    type=\"radio\"\\n\n                                                    name=\"default_parts_matrix_key\"\\n\n                                                    :value=\"matrix.key\"\\n\n                                                    x-model=\"defaultPartsMatrixKey\"\\n\n                                                    @change=\"queueAutosave()\"\\n\n                                                    class=\"form-check-input\"\\n\n                                                >\\n\n                                                <span class=\"form-check-label\">Default</span>\\n\n                                            </label>\\n\n                                        </div>\\n\n                                    </div>\\n\n                                </div>\\n\n\\n\n                                <div class=\"table-responsive\">\\n\n                                    <table class=\"table table-vcenter card-table mb-0\">\\n\n                                        <thead>\\n\n                                            <tr>\\n\n                                                <th scope=\"col\">Cost from</th>\\n\n                                                <th scope=\"col\">Cost to</th>\\n\n                                                <th scope=\"col\">Markup %</th>\\n\n                                                <th scope=\"col\">Margin</th>\\n\n                                                <th scope=\"col\" class=\"w-1\">Action</th>\\n\n                                            </tr>\\n\n                                        </thead>\\n\n                                        <tbody>\\n\n                                            <template x-for=\"(row, rowIndex) in matrix.rows\" :key=\"row.uid\">\\n\n                                                <tr @input=\"queueAutosave()\" @change=\"queueAutosave()\">\\n\n                                                    <td style=\"min-width: 9rem\">\\n\n                                                        <input\\n\n                                                            :name=\"`parts_matrices[${matrixIndex}][rows][${rowIndex}][min_cost]`\"\\n\n                                                            x-model=\"row.min_cost\"\\n\n                                                            required\\n\n                                                            inputmode=\"decimal\"\\n\n                                                            :aria-label=\"`Cost from, row ${rowIndex + 1}`\"\\n\n                                                            class=\"form-control font-monospace\"\\n\n                                                        >\\n\n                                                    </td>\\n\n                                                    <td style=\"min-width: 9rem\">\\n\n                                                        <input\\n\n                                                            :name=\"`parts_matrices[${matrixIndex}][rows][${rowIndex}][max_cost]`\"\\n\n                                                            x-model=\"row.max_cost\"\\n\n                                                            inputmode=\"decimal\"\\n\n                                                            placeholder=\"No upper limit\"\\n\n                                                            :aria-label=\"`Cost to, row ${rowIndex + 1}`\"\\n\n                                                            class=\"form-control font-monospace\"\\n\n                                                        >\\n\n                                                    </td>\\n\n                                                    <td style=\"min-width: 8rem\">\\n\n                                                        <input\\n\n                                                            :name=\"`parts_matrices[${matrixIndex}][rows][${rowIndex}][markup_percentage]`\"\\n\n                                                            x-model=\"row.markup_percentage\"\\n\n                                                            inputmode=\"decimal\"\\n\n                                                            :aria-label=\"`Markup percent, row ${rowIndex + 1}`\"\\n\n                                                            class=\"form-control font-monospace\"\\n\n                                                        >\\n\n                                                    </td>\\n\n                                                    <td class=\"text-secondary text-nowrap\">\\n\n                                                        <span x-text=\"row.margin_percentage ? `${row.margin_percentage}% saved` : 'Save for margin'\"></span>\\n\n                                                    </td>\\n\n                                                    <td>\\n\n                                                        <input type=\"hidden\" :name=\"`parts_matrices[${matrixIndex}][rows][${rowIndex}][sort_order]`\" :value=\"rowIndex + 1\">\\n\n                                                        <button\\n\n                                                            type=\"button\"\\n\n                                                            @click=\"removeRow(matrixIndex, rowIndex)\"\\n\n                                                            :disabled=\"matrix.rows.length === 1\"\\n\n                                                            class=\"btn btn-sm btn-ghost-danger\"\\n\n                                                        >\\n\n                                                            Remove\\n\n                                                        </button>\\n\n                                                    </td>\\n\n                                                </tr>\\n\n                                            </template>\\n\n                                        </tbody>\\n\n                                    </table>\\n\n                                </div>\\n\n\\n\n                                <div class=\"card-footer\">\\n\n                                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                                        <div class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                            <button type=\"button\" @click=\"addRow(matrixIndex)\" class=\"btn btn-sm\">Add Row</button>\\n\n                                            <template x-if=\"canDelete(matrix)\">\\n\n                                                <button\\n\n                                                    type=\"button\"\\n\n                                                    x-show=\"! deleteConfirming\"\\n\n                                                    @click=\"openDeleteConfirm(matrix)\"\\n\n                                                    class=\"btn btn-sm btn-ghost-secondary\"\\n\n                                                >\\n\n                                                    Delete matrix\u2026\\n\n                                                </button>\\n\n                                            </template>\\n\n                                            <template x-if=\"! canDelete(matrix) && matrix.key === defaultPartsMatrixKey && matrices.length > 1\">\\n\n                                                <span class=\"small text-secondary\">Default matrix</span>\\n\n                                            </template>\\n\n                                        </div>\\n\n                                        <div class=\"d-flex flex-wrap align-items-center gap-2\">\\n\n                                            <span id=\"parts-matrix-status\" class=\"small text-secondary\" role=\"status\" x-text=\"statusText\">Autosaves edits</span>\\n\n                                            <button type=\"button\" @click=\"autosave(true)\" class=\"btn btn-sm\">\\n\n                                                <span>Save <span x-text=\"matrix.name\"></span></span>\\n\n                                            </button>\\n\n                                        </div>\\n\n                                    </div>\\n\n                                </div>\\n\n\\n\n                                <div x-show=\"deleteConfirming && deleteMatrixKey === matrix.key\" x-cloak class=\"card-footer bg-danger-lt\" data-parts-matrix-delete>\\n\n                                    <p class=\"small mb-2\">\\n\n                                        Type <strong x-text=\"deleteMatrixName\"></strong> to permanently delete this matrix. Billing classes using it fall back to shop default. Existing part lines keep stored pricing.\\n\n                                    </p>\\n\n                                    <div class=\"row g-2 align-items-end\">\\n\n                                        <div class=\"col-12 col-sm\">\\n\n                                            <label :for=\"'parts-matrix-delete-confirm-'+matrix.key\" class=\"form-label\">Confirm matrix name</label>\\n\n                                            <input\\n\n                                                :id=\"'parts-matrix-delete-confirm-'+matrix.key\"\\n\n                                                x-model=\"deleteTypedName\"\\n\n                                                x-ref=\"deleteConfirmInput\"\\n\n                                                autocomplete=\"off\"\\n\n                                                spellcheck=\"false\"\\n\n                                                class=\"form-control\"\\n\n                                            >\\n\n                                        </div>\\n\n                                        <div class=\"col-12 col-sm-auto d-flex gap-2\">\\n\n                                            <button type=\"button\" @click=\"cancelDeleteConfirm()\" class=\"btn\">Cancel</button>\\n\n                                            <button\\n\n                                                type=\"button\"\\n\n                                                :disabled=\"! canConfirmDelete()\"\\n\n                                                @click=\"submitDelete()\"\\n\n                                                class=\"btn btn-danger\"\\n\n                                            >\\n\n                                                Delete permanently\\n\n                                            </button>\\n\n                                        </div>\\n\n                                    </div>\\n\n                                </div>\\n\n                            </div>\\n\n                        </div>\\n\n                    </template>\\n\n                </template>\\n\n            </form>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n                    </div>\\n\n\\n\n                    \\n\n                    <div\\n\n    data-billing-classes-shared\\n\n    style=\"display: contents\"\\n\n    x-data=\"arkBillingClasses(JSON.parse('{\\u0022classes\\u0022:[{\\u0022name\\u0022:\\u0022Retail\\u0022,\\u0022document_show_part_number\\u0022:false,\\u0022document_show_part_brand\\u0022:false,\\u0022document_show_vendor\\u0022:false,\\u0022document_presentation_profile\\u0022:\\u0022retail\\u0022,\\u0022shop_fees_enabled\\u0022:true,\\u0022shop_fee_rate_override\\u0022:null,\\u0022fee_override\\u0022:null,\\u0022discount_type\\u0022:\\u0022none\\u0022,\\u0022discount_amount\\u0022:null,\\u0022default_parts_matrix_key\\u0022:null,\\u0022pill_color\\u0022:\\u0022slate\\u0022,\\u0022is_active\\u0022:true,\\u0022is_default\\u0022:true,\\u0022warranty_mode\\u0022:\\u0022inherit_shop\\u0022,\\u0022warranty\\u0022:{\\u0022months\\u0022:null,\\u0022miles\\u0022:null,\\u0022covers_parts\\u0022:false,\\u0022covers_labor\\u0022:false,\\u0022description\\u0022:\\u0022\\u0022,\\u0022exclusions\\u0022:\\u0022\\u0022,\\u0022third_party\\u0022:false},\\u0022document_terms_mode\\u0022:\\u0022append\\u0022,\\u0022document_terms\\u0022:null,\\u0022key\\u0022:\\u0022retail\\u0022,\\u0022labor_column_key\\u0022:\\u0022customer_pay\\u0022,\\u0022is_labor_linked\\u0022:true,\\u0022is_customer_only\\u0022:false},{\\u0022name\\u0022:\\u0022Fleet\\u0022,\\u0022document_show_part_number\\u0022:false,\\u0022document_show_part_brand\\u0022:false,\\u0022document_show_vendor\\u0022:false,\\u0022document_presentation_profile\\u0022:\\u0022retail\\u0022,\\u0022shop_fees_enabled\\u0022:true,\\u0022shop_fee_rate_override\\u0022:null,\\u0022fee_override\\u0022:null,\\u0022discount_type\\u0022:\\u0022none\\u0022,\\u0022discount_amount\\u0022:null,\\u0022default_parts_matrix_key\\u0022:null,\\u0022pill_color\\u0022:\\u0022blue\\u0022,\\u0022is_active\\u0022:true,\\u0022is_default\\u0022:false,\\u0022warranty_mode\\u0022:\\u0022inherit_shop\\u0022,\\u0022warranty\\u0022:{\\u0022months\\u0022:null,\\u0022miles\\u0022:null,\\u0022covers_parts\\u0022:false,\\u0022covers_labor\\u0022:false,\\u0022description\\u0022:\\u0022\\u0022,\\u0022exclusions\\u0022:\\u0022\\u0022,\\u0022third_party\\u0022:false},\\u0022document_terms_mode\\u0022:\\u0022append\\u0022,\\u0022document_terms\\u0022:null,\\u0022key\\u0022:\\u0022fleet\\u0022,\\u0022labor_column_key\\u0022:\\u0022fleet\\u0022,\\u0022is_labor_linked\\u0022:true,\\u0022is_customer_only\\u0022:false},{\\u0022name\\u0022:\\u0022Warranty\\u0022,\\u0022document_show_part_number\\u0022:true,\\u0022docume