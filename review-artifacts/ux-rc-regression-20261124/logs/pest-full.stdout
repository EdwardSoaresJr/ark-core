                         </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=messenger\" class=\"dropdown-item\" data-ark-inbox-channel=\"messenger\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><g transform=\"translate(1.8 1.8) scale(0.85)\"><path vector-effect=\"non-scaling-stroke\" d=\"M3 20l1.3 -3.9a9 8 0 1 1 3.4 2.9l-4.7 1\"/><path vector-effect=\"non-scaling-stroke\" d=\"M8 13l3 -2l2 2l3 -2\"/></g></svg>\\n\n                                        Messenger\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=email\" class=\"dropdown-item\" data-ark-inbox-channel=\"email\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                                        Email\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=portal\" class=\"dropdown-item\" data-ark-inbox-channel=\"portal\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M3.6 9h16.8\"/><path d=\"M3.6 15h16.8\"/><path d=\"M11.5 3a17 17 0 0 0 0 18\"/><path d=\"M12.5 3a17 17 0 0 1 0 18\"/></svg>\\n\n                                        Portal\\n\n                                    </a>\\n\n                        <div class=\"dropdown-divider\"></div>\\n\n            <a href=\"#\" class=\"dropdown-item\" data-ops-global-search-open>\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                Search conversations\\n\n            </a>\\n\n        </div>\\n\n    </div>\\n\n</nav>\\n\n                                        <div\\n\n        class=\"nav-item d-flex align-items-center\"\\n\n        data-ark-workstation-presence\\n\n        data-locked=\"0\"\\n\n        data-needs-binding=\"0\"\\n\n        data-needs-unlock=\"0\"\\n\n        data-needs-pin-setup=\"0\"\\n\n        data-staff-url=\"http://localhost/app/api/workstation/staff\"\\n\n        data-unlock-url=\"http://localhost/app/workstation/unlock\"\\n\n        data-pin-store-url=\"http://localhost/app/workstation/pin\"\\n\n        data-pin-update-url=\"http://localhost/app/workstation/pin\"\\n\n        data-current-user-id=\"1\"\\n\n        data-lock-url=\"http://localhost/app/workstation/lock\"\\n\n        data-bind-url=\"http://localhost/app/workstation/bind\"\\n\n        data-bind-dismiss-url=\"http://localhost/app/workstation/bind/dismiss\"\\n\n        data-idle-lock-minutes=\"5\"\\n\n        data-station-operator-active=\"0\"\\n\n    >\\n\n        \\n\n        \\n\n        <div data-ws-overlay=\"change-pin\" hidden>\\n\n            <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ws-change-pin-title\" tabindex=\"-1\">\\n\n                <div class=\"modal-backdrop show opacity-100 z-0\" aria-hidden=\"true\"></div>\\n\n                <div class=\"modal-dialog modal-dialog-centered modal-sm\">\\n\n                    <form data-ws-change-pin-form class=\"modal-content\" autocomplete=\"off\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"P3jtebk7btjqcxp7h4CeEdRZ2uE0hQoawhVGA1UC\" autocomplete=\"off\">                        <div class=\"modal-status bg-primary\"></div>\\n\n                        <div class=\"modal-header\">\\n\n                            <div class=\"overflow-hidden\">\\n\n                                <h2 class=\"modal-title\" id=\"ws-change-pin-title\">Change station PIN</h2>\\n\n                                <div class=\"small text-secondary text-truncate\">Mariana Davis</div>\\n\n                            </div>\\n\n                            <button type=\"button\" class=\"btn-close\" data-ws-action=\"close-overlay\" aria-label=\"Close\"></button>\\n\n                        </div>\\n\n                        <div class=\"modal-body\">\\n\n                            <p class=\"text-secondary\">Choose a new 4-digit PIN. Confirm with your ARK password.</p>\\n\n                            <div class=\"mb-3\">\\n\n                                <label class=\"form-label\" for=\"ws-change-pin-password\">Current password</label>\\n\n                                <input\\n\n                                    id=\"ws-change-pin-password\"\\n\n                                    type=\"password\"\\n\n                                    name=\"password\"\\n\n                                    required\\n\n                                    autocomplete=\"current-password\"\\n\n                                    class=\"form-control\"\\n\n                                >\\n\n                            </div>\\n\n                            \\n\n                            <div class=\"mb-3\">\\n\n                                <label class=\"form-label\" for=\"ws-change-pin-new\">New PIN</label>\\n\n                                <input\\n\n                                    id=\"ws-change-pin-new\"\\n\n                                    type=\"tel\"\\n\n                                    name=\"pin\"\\n\n                                    required\\n\n                                    maxlength=\"4\"\\n\n                                    pattern=\"\\d{4}\"\\n\n                                    inputmode=\"numeric\"\\n\n                                    autocomplete=\"one-time-code\"\\n\n                                    data-ws-pin-field\\n\n                                    data-lpignore=\"true\"\\n\n                                    data-1p-ignore\\n\n                                    class=\"form-control font-monospace\"\\n\n                                    style=\"-webkit-text-security: disc\"\\n\n                                >\\n\n                            </div>\\n\n                            <div>\\n\n                                <label class=\"form-label\" for=\"ws-change-pin-confirm\">Confirm PIN</label>\\n\n                                <input\\n\n                                    id=\"ws-change-pin-confirm\"\\n\n                                    type=\"tel\"\\n\n                                    name=\"pin_confirmation\"\\n\n                                    required\\n\n                                    maxlength=\"4\"\\n\n                                    pattern=\"\\d{4}\"\\n\n                                    inputmode=\"numeric\"\\n\n                                    autocomplete=\"one-time-code\"\\n\n                                    data-ws-pin-field\\n\n                                    data-lpignore=\"true\"\\n\n                                    data-1p-ignore\\n\n                                    class=\"form-control font-monospace\"\\n\n                                    style=\"-webkit-text-security: disc\"\\n\n                                >\\n\n                            </div>\\n\n                            <div data-ws-change-pin-error class=\"alert alert-danger mt-3 mb-0\" role=\"alert\" hidden></div>\\n\n                        </div>\\n\n                        <div class=\"modal-footer\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary w-100\">Save PIN</button>\\n\n                        </div>\\n\n                    </form>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n\\n\n        <div data-ws-overlay=\"switch-station\" hidden>\\n\n            <div class=\"modal d-block\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ws-switch-station-title\" tabindex=\"-1\">\\n\n                <div class=\"modal-backdrop show opacity-100 z-0\" aria-hidden=\"true\"></div>\\n\n                <div class=\"modal-dialog modal-dialog-centered modal-dialog-scrollable modal-sm\">\\n\n                    <form data-ws-switch-station-form class=\"modal-content\">\\n\n                        <input type=\"hidden\" name=\"_token\" value=\"P3jtebk7btjqcxp7h4CeEdRZ2uE0hQoawhVGA1UC\" autocomplete=\"off\">                        <div class=\"modal-status bg-primary\"></div>\\n\n                        <div class=\"modal-header\">\\n\n                            <div>\\n\n                                <h2 class=\"modal-title\" id=\"ws-switch-station-title\">Switch station</h2>\\n\n                                <div class=\"small text-secondary\">Where are you working?</div>\\n\n                            </div>\\n\n                            <button type=\"button\" class=\"btn-close\" data-ws-action=\"close-overlay\" aria-label=\"Close\"></button>\\n\n                        </div>\\n\n                        <div class=\"modal-body\">\\n\n                            <div class=\"list-group\">\\n\n                                                            </div>\\n\n                        </div>\\n\n                        <div class=\"modal-footer\">\\n\n                            <button type=\"submit\" class=\"btn btn-primary w-100\">Switch station</button>\\n\n                        </div>\\n\n                    </form>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                    <div class=\"nav-item dropdown\">\\n\n        <a\\n\n            href=\"#\"\\n\n            class=\"nav-link d-flex lh-1 p-0 px-2\"\\n\n            data-bs-toggle=\"dropdown\"\\n\n            aria-expanded=\"false\"\\n\n            aria-label=\"Account menu for Mariana Davis\"\\n\n            title=\"Mariana Davis \u00b7 advisor\"\\n\n        >\\n\n            <span class=\"avatar avatar-sm text-white\" style=\"background-color: #0099cc\">MD</span>\\n\n            <span class=\"d-none d-xl-block ps-2\">\\n\n                <span class=\"d-block\">Mariana Davis</span>\\n\n                                    <span class=\"d-block mt-1 small text-secondary\">advisor</span>\\n\n                            </span>\\n\n        </a>\\n\n        <div class=\"dropdown-menu dropdown-menu-end dropdown-menu-arrow\">\\n\n            <span class=\"dropdown-item-text small text-secondary\">elenor.gaylord@example.net</span>\\n\n\\n\n                                                    <a href=\"http://localhost/app/profile\" class=\"dropdown-item\">\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0\"/><path d=\"M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2\"/></svg>\\n\n                            Profile\\n\n                        </a>\\n\n                                                                            <button type=\"button\" class=\"dropdown-item\" onclick=\"window.arkToggleTheme()\">\\n\n                            <span class=\"hide-theme-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008\"/></svg>\\n\nDark mode</span>\\n\n                            <span class=\"hide-theme-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0\"/><path d=\"M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7\"/></svg>\\n\nLight mode</span>\\n\n                        </button>\\n\n                                                                            <div class=\"dropdown-divider\"></div>\\n\n\\n\n                        <form method=\"POST\" action=\"http://localhost/app/logout\">\\n\n                            <input type=\"hidden\" name=\"_token\" value=\"P3jtebk7btjqcxp7h4CeEdRZ2uE0hQoawhVGA1UC\" autocomplete=\"off\">                            <button type=\"submit\" class=\"dropdown-item text-danger\">\\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2\"/><path d=\"M9 12h12l-3 -3\"/><path d=\"M18 15l3 -3\"/></svg>\\n\n                                Sign out\\n\n                            </button>\\n\n                        </form>\\n\n                                            </div>\\n\n    </div>\\n\n                </div>\\n\n            </div>\\n\n        </header>\\n\n\\n\n        <div\\n\n            id=\"ops-workspace-tabs\"\\n\n            class=\"ark-workspace-tabs d-none d-print-none border-bottom bg-surface\"\\n\n            data-workspace-tabs\\n\n            data-workspace-tabs-ui=\"tabler\"\\n\n            data-ark-workspace-dirty=\"off\"\\n\n            aria-label=\"Workspaces\"\\n\n            aria-hidden=\"true\"\\n\n        ></div>\\n\n    \\n\n    <script>\\n\n        window.__ARK_WORKSPACE__ = {\"enabled\":true,\"maxTabs\":12,\"tabMinWidth\":176,\"desktopMinWidth\":1024,\"persistLocal\":true,\"interceptLinks\":true,\"storageKey\":\"ark_ws_v2_1\",\"types\":[\"intake\",\"repair_order\",\"customer\",\"vehicle\",\"inbox\",\"report\"],\"dashboardUrl\":\"http:\\/\\/localhost\\/app\",\"pathPatterns\":[{\"type\":\"intake\",\"pattern\":\"#^app\\/intake\\/new$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/edit$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)\\/estimate-review$#\",\"id_group\":1},{\"type\":\"repair_order\",\"pattern\":\"#^app\\/repair-orders\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"customer\",\"pattern\":\"#^app\\/customers\\/(\\\\d+)$#\",\"id_group\":1},{\"type\":\"inbox\",\"pattern\":\"#^app\\/inbox\\/(\\\\d+)$#\",\"id_group\":1}],\"permanentPinned\":[],\"dockedContextual\":[{\"key\":\"intake:service\",\"entityType\":\"intake\",\"entityId\":\"service\",\"route\":\"\\/app\\/intake\\/new\",\"title\":\"Check In\",\"subtitle\":\"\"}],\"excludedWorkspaceKeys\":[\"report:operations\"],\"activityUrl\":\"http:\\/\\/localhost\\/app\\/workspace\\/activity\",\"resetIntake\":false,\"closeIntakeWorkspaceId\":null,\"boot\":{\"key\":\"repair_order:1\",\"entityType\":\"repair_order\",\"entityId\":\"1\",\"route\":\"\\/app\\/repair-orders\\/1\",\"title\":\"1 \\u00b7 Modal B.\",\"subtitle\":\"2018 Honda Civic\",\"type\":\"repair_order\",\"id\":\"1\",\"customerName\":\"Modal B.\",\"signals\":{\"estimateVersion\":1}}};\\n\n    </script>\\n\n\\n\n                            \\n\n        \\n\n        <main>\\n\n            <script>\\n\n        (() => {\\n\n            const lineScrollKey = 'ark:repair-order:1:line-scroll';\\n\n            const concernScrollKey = 'ark:repair-order:1:concern-scroll';\\n\n            const pendingLineScroll = sessionStorage.getItem(lineScrollKey);\\n\n            const pendingConcernScroll = sessionStorage.getItem(concernScrollKey);\\n\n\\n\n            window.preserveRepairOrderLineScroll = (lineId) => {\\n\n                const line = document.getElementById(`line-${lineId}`);\\n\n\\n\n                if (! line) {\\n\n                    return;\\n\n                }\\n\n\\n\n                sessionStorage.setItem(lineScrollKey, JSON.stringify({\\n\n                    lineId,\\n\n                    top: line.getBoundingClientRect().top,\\n\n                }));\\n\n            };\\n\n\\n\n            window.preserveRepairOrderConcernScroll = (concernId) => {\\n\n                const concern = document.getElementById(`concern-${concernId}`);\\n\n\\n\n                if (! concern) {\\n\n                    return;\\n\n                }\\n\n\\n\n                sessionStorage.setItem(concernScrollKey, JSON.stringify({\\n\n                    concernId,\\n\n                    top: concern.getBoundingClientRect().top,\\n\n                }));\\n\n            };\\n\n\\n\n            const restoreScroll = (pendingScroll, storageKey, idPrefix, idKey) => {\\n\n                if (! pendingScroll) {\\n\n                    return;\\n\n                }\\n\n\\n\n                sessionStorage.removeItem(storageKey);\\n\n\\n\n                requestAnimationFrame(() => {\\n\n                    const saved = JSON.parse(pendingScroll);\\n\n                    const target = document.getElementById(`${idPrefix}-${saved[idKey]}`);\\n\n\\n\n                    if (! target) {\\n\n                        return;\\n\n                    }\\n\n\\n\n                    window.scrollBy({\\n\n                        top: target.getBoundingClientRect().top - saved.top,\\n\n                        left: 0,\\n\n                        behavior: 'instant',\\n\n                    });\\n\n                });\\n\n            };\\n\n\\n\n            restoreScroll(pendingLineScroll, lineScrollKey, 'line', 'lineId');\\n\n            restoreScroll(pendingConcernScroll, concernScrollKey, 'concern', 'concernId');\\n\n        })();\\n\n\\n\n        window.arkPartPricing = (config, matrices, defaultMatrixKey, previewUrl) => ({\\n\n            type: config.type || '',\\n\n            concernSummary: config.concernSummary || '',\\n\n            pricingMode: config.pricingMode || config.defaultPricingMode || 'matrix',\\n\n            defaultPricingMode: config.defaultPricingMode || 'matrix',\\n\n            defaultPartSell: config.defaultPartSell ?? '',\\n\n            matrixKey: config.matrixKey || defaultMatrixKey || (matrices.find((matrix) => matrix.is_default)?.key ?? matrices[0]?.key ?? ''),\\n\n            defaultMatrixKey: defaultMatrixKey || (matrices.find((matrix) => matrix.is_default)?.key ?? matrices[0]?.key ?? ''),\\n\n            defaultLaborRate: config.defaultLaborRate || '',\\n\n            laborCategories: config.laborCategories || [],\\n\n            defaultLaborCategoryKey: config.defaultLaborCategoryKey || '',\\n\n            laborCategoryKey: config.laborCategoryKey || config.defaultLaborCategoryKey || '',\\n\n            laborEnteredHours: config.laborEnteredHours || '1.00',\\n\n            laborAdjustment: config.laborAdjustment || 'normal',\\n\n            laborCustomFactor: config.laborCustomFactor || '1.25',\\n\n            laborReason: config.laborReason || '',\\n\n            laborReasonCustom: config.laborReasonCustom || '',\\n\n            laborHoursOverridden: Boolean(config.laborHoursOverridden),\\n\n            laborFinalHours: config.laborFinalHours || config.laborEnteredHours || '1.00',\\n\n            laborOverrideReason: config.laborOverrideReason || '',\\n\n            laborRateOverrideReason: config.laborRateOverrideReason || '',\\n\n            laborRatePinned: Boolean(config.laborRatePinned),\\n\n            laborSavedRate: config.sell || '',\\n\n            repriceLabor: false,\\n\n            laborAdjustExpanded: Boolean(config.laborAdjustExpanded),\\n\n            laborDescriptionExpanded: Boolean(config.laborDescriptionExpanded),\\n\n            explicitMatrix: Boolean(config.explicitMatrix),\\n\n            cost: config.cost || '',\\n\n            sell: config.sell || '',\\n\n            markup: config.markup || '',\\n\n            sellEdited: Boolean(config.sellEdited),\\n\n            laborCharge: config.laborCharge || '',\\n\n            laborChargeEdited: Boolean(config.laborChargeEdited),\\n\n            useCalculatedLaborChargeFlag: false,\\n\n            guidance: '',\\n\n            marginPercentage: null,\\n\n            matrixMarginPercentage: null,\\n\n            markupPercentage: null,\\n\n            previewTimer: null,\\n\n            lineEntryScrollTimer: null,\\n\n            previewSequence: 0,\\n\n            previewing: false,\\n\n            pricingSelection: '',\\n\n            hasLineType() {\\n\n                return this.type !== '';\\n\n            },\\n\n            formHasLineType(form) {\\n\n                if (this.hasLineType()) {\\n\n                    return true;\\n\n                }\\n\n\\n\n                const typeInput = form?.querySelector('input[name=\"type\"]');\\n\n\\n\n                return Boolean(typeInput?.value?.trim());\\n\n            },\\n\n            syncFormLineType(form) {\\n\n                if (! form || ! this.type) {\\n\n                    return;\\n\n                }\\n\n\\n\n                const typeInput = form.querySelector('input[name=\"type\"]');\\n\n\\n\n                if (typeInput) {\\n\n                    typeInput.value = this.type;\\n\n                }\\n\n\\n\n                // Alpine x-model / x-if can lag one frame behind; force priced fields into FormData.\\n\n                const sellInput = form.querySelector('input[name=\"unit_price\"]');\\n\n\\n\n                if (sellInput && this.sell != null && String(this.sell).trim() !== '') {\\n\n                    sellInput.value = String(this.sell);\\n\n                }\\n\n\\n\n                const laborChargeInput = form.querySelector('input[name=\"labor_charge\"]');\\n\n\\n\n                if (laborChargeInput && this.laborCharge != null && String(this.laborCharge).trim() !== '') {\\n\n                    laborChargeInput.value = String(this.laborCharge);\\n\n                }\\n\n\\n\n                const costInput = form.querySelector('input[name=\"part_cost\"]');\\n\n\\n\n                if (costInput && this.cost != null) {\\n\n                    costInput.value = String(this.cost);\\n\n                }\\n\n            },\\n\n            init() {\\n\n                this.$watch('type', (value) => {\\n\n                    if (value !== '') {\\n\n                        this.scrollLineEntryIntoView();\\n\n                    }\\n\n                });\\n\n\\n\n                if (! this.hasLineType()) {\\n\n                    return;\\n\n                }\\n\n\\n\n                if (this.type === 'part' && ! this.explicitMatrix) {\\n\n                    this.pricingMode = this.defaultPricingMode;\\n\n                    this.matrixKey = this.defaultMatrixKey;\\n\n                    if (this.pricingMode === 'manual') {\\n\n                        this.pricingSelection = 'manual';\\n\n                        if (! this.sell) {\\n\n                            this.sell = this.defaultPartSell;\\n\n                        }\\n\n                    }\\n\n                } else if (this.type === 'labor') {\\n\n                    this.initializeLaborAuthority();\\n\n                    this.onLaborAuthorityInput();\\n\n                } else if (this.type === 'sublet') {\\n\n                    this.syncSubletMarkupFromCostAndSell();\\n\n                    this.queuePreview(0);\\n\n                }\\n\n\\n\n                this.pricingSelection = this.pricingMode === 'manual' ? 'manual' : this.matrixKey;\\n\n                this.queuePreview(0);\\n\n                this.scrollLineEntryIntoView();\\n\n                this.$nextTick(() => this.applyPartPullFlagCoupling());\\n\n            },\\n\n            applyPartPullFlagCoupling() {\\n\n                const coreCheckbox = this.$el.querySelector('input[name=\"has_core\"][type=\"checkbox\"]');\\n\n                const saveCheckbox = this.$el.querySelector('input[name=\"save_old_part\"][type=\"checkbox\"]');\\n\n\\n\n                if (! coreCheckbox || ! saveCheckbox) {\\n\n                    return;\\n\n                }\\n\n\\n\n                if (coreCheckbox.checked) {\\n\n                    saveCheckbox.checked = true;\\n\n                }\\n\n            },\\n\n            onCoreChargeToggle() {\\n\n                this.applyPartPullFlagCoupling();\\n\n            },\\n\n            onSaveOldPartToggle(event) {\\n\n                const coreCheckbox = this.$el.querySelector('input[name=\"has_core\"][type=\"checkbox\"]');\\n\n\\n\n                if (coreCheckbox?.checked && ! event.target.checked) {\\n\n                    event.target.checked = true;\\n\n                }\\n\n            },\\n\n            selectLineType(selectedType) {\\n\n                this.onTypeChange(selectedType);\\n\n            },\\n\n            onTypeChange(selectedType = null) {\\n\n                if (selectedType !== null) {\\n\n                    this.type = selectedType;\\n\n                }\\n\n\\n\n                if (this.type !== 'part') {\\n\n                    this.pricingMode = 'manual';\\n\n                    this.cost = '';\\n\n                    this.guidance = '';\\n\n                    this.marginPercentage = null;\\n\n                    this.matrixMarginPercentage = null;\\n\n                    this.markupPercentage = null;\\n\n                    this.sellEdited = false;\\n\n                    this.markup = '';\\n\n                    if (this.type === 'labor') {\\n\n                        this.initializeLaborAuthority();\\n\n                    } else if (this.type === 'sublet') {\\n\n                        this.sell = '';\\n\n                    } else if (this.type === 'note') {\\n\n                        this.sell = '0';\\n\n                    }\\n\n                } else if (! this.explicitMatrix) {\\n\n                    this.pricingMode = this.defaultPricingMode;\\n\n                    this.matrixKey = this.defaultMatrixKey;\\n\n                    this.pricingSelection = this.pricingMode === 'manual' ? 'manual' : this.matrixKey;\\n\n                    this.explicitMatrix = true;\\n\n                    this.sell = this.pricingMode === 'manual' ? this.defaultPartSell : '';\\n\n                    this.sellEdited = this.pricingMode === 'manual' && this.defaultPartSell !== '';\\n\n                    this.queuePreview(0);\\n\n                } else if (! this.pricingMode) {\\n\n                    this.pricingMode = this.defaultPricingMode;\\n\n                    this.pricingSelection = this.pricingMode === 'manual' ? 'manual' : this.matrixKey;\\n\n                }\\n\n            },\\n\n            scrollLineEntryIntoView() {\\n\n                if (! this.hasLineType()) {\\n\n                    return;\\n\n                }\\n\n\\n\n                window.clearTimeout(this.lineEntryScrollTimer);\\n\n\\n\n                this.lineEntryScrollTimer = window.setTimeout(() => {\\n\n                    this.$nextTick(() => {\\n\n                        requestAnimationFrame(() => {\\n\n                            requestAnimationFrame(() => {\\n\n                                const form = this.$el;\\n\n                                const picker = form.querySelector('.ops-line-type-picker');\\n\n\\n\n                                if (! picker) {\\n\n                                    return;\\n\n                                }\\n\n\\n\n                                const panel = form.querySelector(\\n\n                                    this.type === 'part'\\n\n                                        ? '[data-line-entry-panel=\"part\"]'\\n\n                                        : '[data-line-entry-panel=\"simple\"]',\\n\n                                );\\n\n                                const padding = 16;\\n\n                                const pickerRect = picker.getBoundingClientRect();\\n\n                                const panelRect = panel?.getBoundingClientRect();\\n\n                                const blockTop = panelRect && panelRect.height > 0\\n\n                                    ? panelRect.top\\n\n                                    : pickerRect.top;\\n\n                                const blockBottom = pickerRect.bottom;\\n\n                                const viewportTop = padding;\\n\n                                const viewportBottom = window.innerHeight - padding;\\n\n                                const blockHeight = blockBottom - blockTop;\\n\n                                const maxVisible = window.innerHeight - (padding * 2);\\n\n                                let delta = 0;\\n\n\\n\n                                if (blockBottom > viewportBottom) {\\n\n                                    delta = blockBottom - viewportBottom;\\n\n                                }\\n\n\\n\n                                const topAfter = blockTop - delta;\\n\n\\n\n                                if (topAfter < viewportTop) {\\n\n                                    if (blockHeight <= maxVisible) {\\n\n                                        delta += topAfter - viewportTop;\\n\n                                    } else {\\n\n                                        const uplift = viewportTop - topAfter;\\n\n                                        const pickerSlack = viewportBottom - (blockBottom - delta);\\n\n\\n\n                                        if (pickerSlack > 0) {\\n\n                                            delta -= Math.min(uplift, pickerSlack);\\n\n                                        } else if (blockBottom <= viewportBottom) {\\n\n                                            delta = blockTop - viewportTop;\\n\n                                        }\\n\n                                    }\\n\n                                }\\n\n\\n\n                                if (Math.abs(delta) > 2) {\\n\n                                    window.scrollBy({ top: delta, behavior: 'smooth' });\\n\n                                }\\n\n                            });\\n\n                        });\\n\n                    });\\n\n                }, 50);\\n\n            },\\n\n            onCostInput() {\\n\n                this.queuePreview(120);\\n\n            },\\n\n            onSubletCostInput() {\\n\n                if (String(this.markup).trim() !== '' && ! this.sellEdited) {\\n\n                    this.applySubletMarkupToSell();\\n\n                }\\n\n\\n\n                this.queuePreview(120);\\n\n            },\\n\n            onSubletMarkupInput() {\\n\n                this.applySubletMarkupToSell();\\n\n                this.queuePreview(120);\\n\n            },\\n\n            applySubletMarkupToSell() {\\n\n                const cost = Number.parseFloat(this.cost);\\n\n                const markup = Number.parseFloat(this.markup);\\n\n\\n\n                if (! Number.isFinite(cost) || cost <= 0 || ! Number.isFinite(markup) || markup < 0) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.sell = (cost * (1 + markup / 100)).toFixed(2);\\n\n                this.sellEdited = false;\\n\n            },\\n\n            syncSubletMarkupFromCostAndSell() {\\n\n                const cost = Number.parseFloat(this.cost);\\n\n                const sell = Number.parseFloat(this.sell);\\n\n\\n\n                if (! Number.isFinite(cost) || cost <= 0 || ! Number.isFinite(sell) || sell <= 0) {\\n\n                    this.markup = '';\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                this.markup = (((sell - cost) / cost) * 100).toFixed(2).replace(/\\.?0+$/, '');\\n\n            },\\n\n            subletPricingGuidance() {\\n\n                if (this.guidance) {\\n\n                    return this.guidance;\\n\n                }\\n\n\\n\n                return 'Enter vendor cost, apply markup, or set sell price directly.';\\n\n            },\\n\n            onCostBlur() {\\n\n                this.queuePreview(0);\\n\n            },\\n\n            onPricingSelectionChange(event) {\\n\n                const selection = event?.target?.value ?? this.pricingSelection;\\n\n                this.pricingSelection = selection;\\n\n                this.pricingMode = selection === 'manual' ? 'manual' : 'matrix';\\n\n\\n\n                if (this.pricingMode === 'matrix') {\\n\n                    this.matrixKey = selection;\\n\n                    this.explicitMatrix = true;\\n\n                    this.sellEdited = false;\\n\n\\n\n                    if (String(this.cost).trim() !== '') {\\n\n                        this.sell = '';\\n\n                    }\\n\n                } else {\\n\n                    this.explicitMatrix = true;\\n\n                }\\n\n\\n\n                clearTimeout(this.previewTimer);\\n\n\\n\n                if (this.type !== 'part') {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.$nextTick(() => this.refreshPreview());\\n\n            },\\n\n            onSellInput() {\\n\n                if (this.type === 'labor' && ! this.laborCategoryAllowsModifiers()) {\\n\n                    this.sellEdited = false;\\n\n                    this.laborRateOverrideReason = '';\\n\n                    this.sell = this.laborRatePinned ? this.laborSavedRate : this.laborPolicyRate();\\n\n                    this.syncLaborChargeFromRate();\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                this.sellEdited = true;\\n\n\\n\n                if (this.type === 'labor') {\\n\n                    this.laborChargeEdited = false;\\n\n                    this.useCalculatedLaborChargeFlag = false;\\n\n                    this.syncLaborChargeFromRate();\\n\n                }\\n\n\\n\n                if (this.type === 'sublet') {\\n\n                    this.syncSubletMarkupFromCostAndSell();\\n\n                }\\n\n\\n\n                this.queuePreview();\\n\n            },\\n\n            calculatedLaborCharge() {\\n\n                const hours = Number.parseFloat(this.laborFinalHours) || 0;\\n\n                const rate = Number.parseFloat(this.sell) || 0;\\n\n\\n\n                return (hours * rate).toFixed(2);\\n\n            },\\n\n            syncLaborChargeFromRate() {\\n\n                if (this.type !== 'labor' || this.laborChargeEdited) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.laborCharge = this.calculatedLaborCharge();\\n\n            },\\n\n            onLaborChargeInput() {\\n\n                if (this.type !== 'labor' || ! this.laborCategoryAllowsModifiers()) {\\n\n                    this.laborChargeEdited = false;\\n\n                    this.syncLaborChargeFromRate();\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                this.laborChargeEdited = true;\\n\n                this.useCalculatedLaborChargeFlag = false;\\n\n                this.sellEdited = false;\\n\n                this.laborRateOverrideReason = '';\\n\n            },\\n\n            useCalculatedLaborCharge() {\\n\n                if (this.type !== 'labor') {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.laborChargeEdited = false;\\n\n                this.useCalculatedLaborChargeFlag = true;\\n\n                this.laborCharge = this.calculatedLaborCharge();\\n\n            },\\n\n            usePolicyLaborRate() {\\n\n                if (this.type !== 'labor') {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.laborRatePinned = false;\\n\n                this.repriceLabor = true;\\n\n                this.sellEdited = false;\\n\n                this.laborRateOverrideReason = '';\\n\n                this.laborChargeEdited = false;\\n\n                this.useCalculatedLaborChargeFlag = true;\\n\n                this.onLaborCategoryChange(false);\\n\n            },\\n\n            laborPolicyRate() {\\n\n                const category = this.selectedLaborCategory();\\n\n\\n\n                return category ? (category.rate_cents / 100).toFixed(2) : '';\\n\n            },\\n\n            laborRateDiffersFromPolicy() {\\n\n                const policyRate = this.laborPolicyRate();\\n\n\\n\n                return this.type === 'labor'\\n\n                    && ! this.laborChargeEdited\\n\n                    && policyRate !== ''\\n\n                    && (Number.parseFloat(this.sell) || 0).toFixed(2) !== policyRate;\\n\n            },\\n\n            suggestionText() {\\n\n                return this.guidance;\\n\n            },\\n\n            scopeHint() {\\n\n                if (! this.concernSummary) {\\n\n                    return '';\\n\n                }\\n\n\\n\n                const summary = String(this.concernSummary);\\n\n                const trimmed = summary.length > 42 ? `${summary.slice(0, 39)}\u2026` : summary;\\n\n\\n\n                return ` \u00b7 ${trimmed}`;\\n\n            },\\n\n            descriptionPlaceholder() {\\n\n                const examples = {\\n\n                    labor: 'e.g. Diagnose check engine light',\\n\n                    part: 'e.g. Oil filter - OEM',\\n\n                    note: 'e.g. Customer will decide at next visit',\\n\n                    fee: 'e.g. Shop supplies / hazmat',\\n\n                    sublet: 'e.g. Alignment at tire shop',\\n\n                };\\n\n                const labels = {\\n\n                    labor: 'Labor description',\\n\n                    part: 'Part description',\\n\n                    note: 'Note for this scope',\\n\n                    fee: 'Fee description',\\n\n                    sublet: 'Sublet description',\\n\n                };\\n\n\\n\n                return `${labels[this.type] || 'Line description'}${this.scopeHint()} - ${examples[this.type] || 'required'}`;\\n\n            },\\n\n            descriptionFieldLabel() {\\n\n                const labels = {\\n\n                    labor: 'Labor description',\\n\n                    note: 'Note for this scope',\\n\n                    fee: 'Fee description',\\n\n                    sublet: 'Sublet description',\\n\n                };\\n\n\\n\n                return labels[this.type] || 'Description';\\n\n            },\\n\n            pricingHeading() {\\n\n                const headings = {\\n\n                    labor: 'Labor rate',\\n\n                    fee: 'Fee amount',\\n\n                    sublet: 'Sublet pricing',\\n\n                };\\n\n\\n\n                return headings[this.type] || 'Pricing';\\n\n            },\\n\n            sellFieldLabel() {\\n\n                if (this.type === 'labor') {\\n\n                    return 'Labor rate';\\n\n                }\\n\n\\n\n                if (this.type === 'sublet') {\\n\n                    return 'Sublet rate';\\n\n                }\\n\n\\n\n                return 'Amount';\\n\n            },\\n\n            quantityFieldLabel() {\\n\n                if (this.type === 'labor') {\\n\n                    return 'Hours';\\n\n                }\\n\n\\n\n                return 'Quantity';\\n\n            },\\n\n            addLineButtonLabel() {\\n\n                const labels = {\\n\n                    labor: 'Add Labor',\\n\n                    note: 'Add Note',\\n\n                    fee: 'Add Fee',\\n\n                    sublet: 'Add Sublet',\\n\n                };\\n\n\\n\n                return labels[this.type] || 'Add';\\n\n            },\\n\n            selectedLaborCategory() {\\n\n                return this.laborCategories.find((category) => category.key === this.laborCategoryKey)\\n\n                    || this.laborCategories[0]\\n\n                    || null;\\n\n            },\\n\n            laborCategoryAllowsModifiers() {\\n\n                const category = this.selectedLaborCategory();\\n\n\\n\n                return category ? category.allows_modifiers !== false : true;\\n\n            },\\n\n            clearLaborModifiersIfLocked() {\\n\n                if (this.laborCategoryAllowsModifiers()) {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.laborAdjustment = 'normal';\\n\n                this.laborReason = '';\\n\n                this.laborReasonCustom = '';\\n\n                this.laborHoursOverridden = false;\\n\n                this.laborOverrideReason = '';\\n\n                this.laborRateOverrideReason = '';\\n\n                this.laborAdjustExpanded = false;\\n\n                this.sellEdited = false;\\n\n                this.laborChargeEdited = false;\\n\n                this.useCalculatedLaborChargeFlag = false;\\n\n                this.sell = this.laborRatePinned ? this.laborSavedRate : this.laborPolicyRate();\\n\n\\n\n                this.onLaborAuthorityInput();\\n\n            },\\n\n            laborAdjustmentFactor() {\\n\n                const factors = {\\n\n                    normal: 1,\\n\n                    difficult: 1.25,\\n\n                    severe: 1.5,\\n\n                };\\n\n\\n\n                if (this.laborAdjustment === 'custom') {\\n\n                    const custom = Number.parseFloat(this.laborCustomFactor);\\n\n\\n\n                    return Number.isFinite(custom) && custom >= 1 ? custom : 1;\\n\n                }\\n\n\\n\n                return factors[this.laborAdjustment] ?? 1;\\n\n            },\\n\n            laborRoundingIncrement(rule) {\\n\n                const increments = {\\n\n                    exact: null,\\n\n                    tenth: 0.1,\\n\n                    quarter: 0.25,\\n\n                    half: 0.5,\\n\n                };\\n\n\\n\n                return increments[rule] ?? 0.25;\\n\n            },\\n\n            laborRoundingLabel(rule) {\\n\n                const labels = {\\n\n                    exact: 'exact hours',\\n\n                    tenth: '0.1 hr',\\n\n                    quarter: '0.25 hr',\\n\n                    half: '0.5 hr',\\n\n                };\\n\n\\n\n                return labels[rule] ?? '0.25 hr';\\n\n            },\\n\n            roundLaborHours(hours, rule) {\\n\n                if (rule === 'exact') {\\n\n                    return Math.round(hours * 100) / 100;\\n\n                }\\n\n\\n\n                const increment = this.laborRoundingIncrement(rule);\\n\n\\n\n                return Math.ceil((hours / increment) - 1e-9) * increment;\\n\n            },\\n\n            laborCalculatedHours() {\\n\n                const category = this.selectedLaborCategory();\\n\n\\n\n                if (! category) {\\n\n                    return Number.parseFloat(this.laborEnteredHours) || 0;\\n\n                }\\n\n\\n\n                const entered = Number.parseFloat(this.laborEnteredHours) || 0;\\n\n                const adjusted = entered * this.laborAdjustmentFactor();\\n\n                const minimum = Number.parseFloat(category.minimum_hours) || 0;\\n\n                const afterMinimum = Math.max(adjusted, minimum);\\n\n\\n\n                return this.roundLaborHours(afterMinimum, category.rounding_rule);\\n\n            },\\n\n            laborNeedsAdvancedPanel() {\\n\n                if (! this.laborCategoryAllowsModifiers()) {\\n\n                    return false;\\n\n                }\\n\n\\n\n                return this.laborAdjustment !== 'normal'\\n\n                    || this.laborHoursOverridden\\n\n                    || Boolean(this.laborOverrideReason);\\n\n            },\\n\n            toggleLaborAdjustExpanded() {\\n\n                if (! this.laborCategoryAllowsModifiers()) {\\n\n                    return;\\n\n                }\\n\n\\n\n                if (this.laborAdjustExpanded) {\\n\n                    this.laborAdjustment = 'normal';\\n\n                    this.laborReason = '';\\n\n                    this.laborReasonCustom = '';\\n\n                    this.onLaborAuthorityInput();\\n\n                }\\n\n\\n\n                this.laborAdjustExpanded = ! this.laborAdjustExpanded;\\n\n            },\\n\n            laborCanBillEnteredHours() {\\n\n                if (! this.laborCategoryAllowsModifiers()) {\\n\n                    return false;\\n\n                }\\n\n\\n\n                const entered = Number.parseFloat(this.laborEnteredHours) || 0;\\n\n                const final = Number.parseFloat(this.laborFinalHours) || 0;\\n\n\\n\n                return Math.abs(entered - final) >= 0.005;\\n\n            },\\n\n            billEnteredHours() {\\n\n                this.laborFinalHours = (Number.parseFloat(this.laborEnteredHours) || 0).toFixed(2);\\n\n                this.onLaborFinalHoursInput();\\n\n            },\\n\n            useCalculatedLaborHours() {\\n\n                this.laborHoursOverridden = false;\\n\n                this.laborOverrideReason = '';\\n\n                this.onLaborAuthorityInput();\\n\n            },\\n\n            laborMinimumApplied() {\\n\n                const category = this.selectedLaborCategory();\\n\n\\n\n                if (! category) {\\n\n                    return false;\\n\n                }\\n\n\\n\n                const entered = Number.parseFloat(this.laborEnteredHours) || 0;\\n\n                const adjusted = entered * this.laborAdjustmentFactor();\\n\n                const minimum = Number.parseFloat(category.minimum_hours) || 0;\\n\n\\n\n                return adjusted < minimum && minimum > 0;\\n\n            },\\n\n            laborMinimumMessage() {\\n\n                if (this.type !== 'labor' || ! this.laborMinimumApplied()) {\\n\n                    return '';\\n\n                }\\n\n\\n\n                const category = this.selectedLaborCategory();\\n\n                const entered = Number.parseFloat(this.laborEnteredHours) || 0;\\n\n                const calculated = this.laborCalculatedHours();\\n\n\\n\n                return `${category.name} minimum applied: ${entered.toFixed(2)} hr \u2192 ${calculated.toFixed(2)} hr`;\\n\n            },\\n\n            laborRoundingMessage() {\\n\n                if (this.type !== 'labor' || this.laborHoursOverridden || this.laborMinimumApplied()) {\\n\n                    return '';\\n\n                }\\n\n\\n\n                const category = this.selectedLaborCategory();\\n\n\\n\n                if (! category || category.rounding_rule === 'exact') {\\n\n                    return '';\\n\n                }\\n\n\\n\n                const entered = Number.parseFloat(this.laborEnteredHours) || 0;\\n\n                const adjusted = entered * this.laborAdjustmentFactor();\\n\n                const minimum = Number.parseFloat(category.minimum_hours) || 0;\\n\n                const afterMinimum = Math.max(adjusted, minimum);\\n\n                const calculated = this.laborCalculatedHours();\\n\n\\n\n                if (Math.abs(afterMinimum - calculated) < 0.005) {\\n\n                    return '';\\n\n                }\\n\n\\n\n                return `Rounded up to ${this.laborRoundingLabel(category.rounding_rule)}: ${afterMinimum.toFixed(2)} hr \u2192 ${calculated.toFixed(2)} hr`;\\n\n            },\\n\n            initializeLaborAuthority() {\\n\n                if (! this.laborCategoryKey && this.defaultLaborCategoryKey) {\\n\n                    this.laborCategoryKey = this.defaultLaborCategoryKey;\\n\n                }\\n\n\\n\n                if (! this.laborEnteredHours) {\\n\n                    this.laborEnteredHours = '1.00';\\n\n                }\\n\n\\n\n                if (! this.laborAdjustExpanded && this.laborNeedsAdvancedPanel()) {\\n\n                    this.laborAdjustExpanded = true;\\n\n                }\\n\n\\n\n                this.clearLaborModifiersIfLocked();\\n\n\\n\n                if (this.sellEdited || this.laborRatePinned) {\\n\n                    this.onLaborAuthorityInput();\\n\n                } else {\\n\n                    this.onLaborCategoryChange(false);\\n\n                }\\n\n            },\\n\n            onLaborCategoryChange(recalculate = true) {\\n\n                if (recalculate && this.laborRatePinned) {\\n\n                    this.laborRatePinned = false;\\n\n                    this.repriceLabor = true;\\n\n                }\\n\n\\n\n                if (this.laborPolicyRate() !== '') {\\n\n                    this.sell = this.laborPolicyRate();\\n\n                    this.sellEdited = false;\\n\n                    this.laborRateOverrideReason = '';\\n\n                }\\n\n\\n\n                if (recalculate) {\\n\n                    this.laborChargeEdited = false;\\n\n                    this.useCalculatedLaborChargeFlag = true;\\n\n                }\\n\n\\n\n                this.clearLaborModifiersIfLocked();\\n\n\\n\n                if (recalculate) {\\n\n                    this.onLaborAuthorityInput();\\n\n                } else {\\n\n                    this.syncLaborChargeFromRate();\\n\n                }\\n\n            },\\n\n            onLaborAuthorityInput() {\\n\n                if (! this.laborHoursOverridden) {\\n\n                    this.laborFinalHours = this.laborCalculatedHours().toFixed(2);\\n\n                }\\n\n\\n\n                this.syncLaborChargeFromRate();\\n\n            },\\n\n            onLaborFinalHoursInput() {\\n\n                const calculated = this.laborCalculatedHours().toFixed(2);\\n\n\\n\n                this.laborHoursOverridden = this.laborFinalHours !== calculated;\\n\n            },\\n\n            laborAdjustmentRequiresReason() {\\n\n                return this.laborAdjustment !== 'normal';\\n\n            },\\n\n            laborAuthorityPreview() {\\n\n                const category = this.selectedLaborCategory();\\n\n\\n\n                if (! category || this.type !== 'labor') {\\n\n                    return '';\\n\n                }\\n\n\\n\n                const calculated = this.laborCalculatedHours().toFixed(2);\\n\n                const adjustmentLabel = {\\n\n                    normal: 'Normal',\\n\n                    difficult: 'Difficult (+25%)',\\n\n                    severe: 'Severe (+50%)',\\n\n                    custom: `Custom (\u00d7${this.laborAdjustmentFactor().toFixed(2)})`,\\n\n                }[this.laborAdjustment] || 'Normal';\\n\n\\n\n                let preview = `Book ${this.laborEnteredHours} hr \u00b7 ${category.name} \u00b7 ${adjustmentLabel} \u00b7 Calculated ${calculated} hr`;\\n\n\\n\n                if (this.laborHoursOverridden) {\\n\n                    preview += ` \u00b7 Advisor override ${this.laborFinalHours} hr`;\\n\n                }\\n\n\\n\n                if (this.laborChargeEdited) {\\n\n                    preview += ` \u00b7 Manual charge $${this.laborCharge}`;\\n\n                } else if (this.sellEdited) {\\n\n                    preview += ` \u00b7 Custom rate $${this.sell}/hr \u00b7 Charge $${this.laborCharge || this.calculatedLaborCharge()}`;\\n\n                } else if (this.laborRatePinned && this.laborRateDiffersFromPolicy()) {\\n\n                    preview += ` \u00b7 Saved rate $${this.sell}/hr (policy now $${this.laborPolicyRate()}/hr) \u00b7 Charge $${this.laborCharge || this.calculatedLaborCharge()}`;\\n\n                } else {\\n\n                    preview += ` \u00b7 Charge $${this.laborCharge || this.calculatedLaborCharge()}`;\\n\n                }\\n\n\\n\n                return preview;\\n\n            },\\n\n            simpleLineGuidance() {\\n\n                const guidance = {\\n\n                    labor: 'Book hours are what you quote. Billable hours apply category minimums and rounding - edit billable hours directly or use Bill book hours.',\\n\n                    fee: 'Flat fee or per-quantity shop charge on the estimate.',\\n\n                    sublet: 'Vendor work billed through this scope - enter cost, markup, or sell price. Rolls into labor totals.',\\n\n                };\\n\n\\n\n                return guidance[this.type] || '';\\n\n            },\\n\n            quantityPlaceholder() {\\n\n                if (this.type === 'labor') {\\n\n                    return 'Hours';\\n\n                }\\n\n\\n\n                return 'Qty';\\n\n            },\\n\n            sellPlaceholder() {\\n\n                if (this.type === 'part' && this.pricingMode === 'matrix') {\\n\n                    return 'Matrix sell $';\\n\n                }\\n\n\\n\n                if (this.type === 'labor') {\\n\n                    return 'Labor rate $';\\n\n                }\\n\n\\n\n                if (this.type === 'sublet') {\\n\n                    return 'Sell price $';\\n\n                }\\n\n\\n\n                if (this.type === 'fee') {\\n\n                    return 'Fee amount $';\\n\n                }\\n\n\\n\n                if (this.type === 'note') {\\n\n                    return 'No charge';\\n\n                }\\n\n\\n\n                return 'Sell $';\\n\n            },\\n\n            costPlaceholder() {\\n\n                return 'Your cost $';\\n\n            },\\n\n            vendorPlaceholder() {\\n\n                return 'Vendor - e.g. Worldpac, NAPA';\\n\n            },\\n\n            partNumberPlaceholder() {\\n\n                return 'Manufacturer part #';\\n\n            },\\n\n            sourcingPlaceholder() {\\n\n                return 'Source, ETA, or order note';\\n\n            },\\n\n            queuePreview(delay = 200) {\\n\n                clearTimeout(this.previewTimer);\\n\n\\n\n                if (this.type !== 'part' && this.type !== 'sublet') {\\n\n                    return;\\n\n                }\\n\n\\n\n                this.previewTimer = setTimeout(() => this.refreshPreview(), delay);\\n\n            },\\n\n            applyMatrixSellFromServer(payload) {\\n\n                if (this.pricingMode !== 'matrix' || this.sellEdited) {\\n\n                    return;\\n\n                }\\n\n\\n\n                if (payload.sell_from_matrix != null && payload.sell_from_matrix !== '') {\\n\n                    this.sell = payload.sell_from_matrix;\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                if (payload.suggested_sell) {\\n\n                    this.sell = payload.suggested_sell.replace('$', '').replace(/,/g, '');\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                if (! String(this.cost).trim()) {\\n\n                    this.sell = '';\\n\n                }\\n\n            },\\n\n            worksheetFormFrom(eventOrForm) {\\n\n                if (eventOrForm instanceof HTMLFormElement) {\\n\n                    return eventOrForm;\\n\n                }\\n\n\\n\n                return eventOrForm?.target?.closest?.('form') ?? eventOrForm?.currentTarget ?? null;\\n\n            },\\n\n            async invokeWorksheetSubmit(form) {\\n\n                const worksheet = this.$el.closest('[data-worksheet-root]')?._x_dataStack?.[0];\\n\n\\n\n                if (typeof worksheet?.submitWorksheetForm === 'function') {\\n\n                    await worksheet.submitWorksheetForm(form);\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                if (typeof this.$parent?.submitWorksheetForm === 'function') {\\n\n                    await this.$parent.submitWorksheetForm(form);\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                form?.submit();\\n\n            },\\n\n            async submitLine(event) {\\n\n                const worksheet = this.$el.closest('[data-worksheet-root]')?._x_dataStack?.[0];\\n\n\\n\n                if (worksheet?.worksheetBusyPending || worksheet?.worksheetSaving) {\\n\n                    worksheet?.surfaceWorksheetMessage?.(\\n\n                        'Still saving the last change. Wait a moment, then try again.',\\n\n                    );\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                const form = this.worksheetFormFrom(event);\\n\n\\n\n                if (! form || ! this.formHasLineType(form)) {\\n\n                    worksheet?.surfaceWorksheetMessage?.(\\n\n                        'Choose a line type (labor, part, fee, sublet, or note) before adding.',\\n\n                    );\\n\n\\n\n                    return;\\n\n                }\\n\n\\n\n                this.syncFormLineType(form);\\n\n\\n\n                if (this.type === 'labor' && this.laborCategoryAllowsModifiers() && this.sellEdited && ! this.laborChargeEdited) {\\n\n                    const reason = String(this.laborRateOverrideReason ?? '').trim();\\n\n\\n\n                    if (reason === '') {\\n\n                        const modal = document.querySelector('#workspace-modal-host')?._x_dataStack?.[0];\\n\n\\n\n                        if (modal) {\\n\n                            modal.validationMessage = 'Custom labor rate needs a reason - choose Menu / package price for a flat PPI, or another reason.';\\n\n                            modal.saving = false;\\n\n                        }\\n\n\\n\n                        worksheet?.surfaceWorksheetMessage?.(\\n\n                            'Choose a rate override reason before saving custom labor.',\\n\n                            { tone: 'warn' },\\n\n                        );\\n\n                        this.$nextTick(() => form.querySelector('[name=\"labor_rate_override_reason\"]')?.focus());\\n\n\\n\n                        return;\\n\n                    }\\n\n                }\\n\n\\n\n                if (this.type === 'part') {\\n\n                    this.explicitMatrix = true;\\n\n                }\\n\n\\n\n                if (this.type === 'part' && this.pricingMode === 'matrix' && String(this.cost).trim() !== '' && ! this.sellEdited) {\\n\n                    try {\\n\n                        await Promise.race([\\n\n                            this.refreshPreview(),\\n\n                            new Promise((resolve) => setTimeout(resolve, 4000)),\\n\n                        ]);\\n\n                    } catch {\\n\n                        // Server prices the line authoritatively on save.\\n\n                    }\\n\n                }\\n\n\\n\n                await this.invokeWorksheetSubmit(form);\\n\n            },\\n\n            async refreshPreview() {\\n\n                const requestId = ++this.previewSequence;\\n\n                this.previewing = true;\\n\n                const controller = new AbortController();\\n\n                const timeoutId = setTimeout(() => controller.abort(), 8000);\\n\n\\n\n                try {\\n\n                    const params = {\\n\n                        type: this.type,\\n\n                        part_cost: this.cost,\\n\n                        pricing_mode: this.pricingMode,\\n\n                        pricing_matrix_key: this.matrixKey,\\n\n                        pricing_matrix_explicit: this.explicitMatrix ? '1' : '0',\\n\n                        unit_price_override: this.sellEdited ? '1' : '0',\\n\n                    };\\n\n\\n\n                    if (this.sellEdited || this.pricingMode === 'manual') {\\n\n                        params.unit_price = this.sell;\\n\n                    }\\n\n\\n\n                    const response = await fetch(previewUrl, {\\n\n                        method: 'POST',\\n\n                        body: new URLSearchParams(params),\\n\n                        signal: controller.signal,\\n\n                        headers: {\\n\n                            'X-CSRF-TOKEN': 'P3jtebk7btjqcxp7h4CeEdRZ2uE0hQoawhVGA1UC',\\n\n                            'X-Requested-With': 'XMLHttpRequest',\\n\n                            'Accept': 'application/json',\\n\n                            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',\\n\n                        },\\n\n                    });\\n\n\\n\n                    if (! response.ok) {\\n\n                        this.guidance = 'Server pricing guidance is unavailable.';\\n\n\\n\n                        return;\\n\n                    }\\n\n\\n\n                    const payload = await response.json();\\n\n\\n\n                    if (requestId !== this.previewSequence) {\\n\n                        return;\\n\n                    }\\n\n\\n\n                    this.guidance = payload.guidance || '';\\n\n                    this.marginPercentage = payload.margin_percentage;\\n\n                    this.matrixMarginPercentage = payload.matrix_margin_percentage;\\n\n                    this.markupPercentage = payload.markup_percentage;\\n\n                    this.applyMatrixSellFromServer(payload);\\n\n\\n\n                    if (this.type === 'sublet' && ! this.sellEdited && payload.markup_percentage) {\\n\n                        this.markup = payload.markup_percentage;\\n\n                    }\\n\n                } catch {\\n\n                    this.guidance = 'Server pricing guidance is unavailable.';\\n\n                } finally {\\n\n                    clearTimeout(timeoutId);\\n\n\\n\n                    if (requestId === this.previewSequence) {\\n\n                        this.previewing = false;\\n\n                    }\\n\n                }\\n\n            },\\n\n        });\\n\n\\n\n    </script>\\n\n\\n\n        <section\\n\n        data-worksheet-root\\n\n                                x-data=\"Object.assign(arkWorksheetCollaboration({\\n\n            repairOrderId: 1,\\n\n            estimateVersion: 1,\\n\n            currentUserId: 1,\\n\n            estimateVersionField: 'opened_estimate_version',\\n\n            surface: 'repair_order',\\n\n            conflictFragment: 'estimate-lines',\\n\n            heartbeatUrl: 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/worksheet-sessions\\/heartbeat',\\n\n            releaseUrl: 'http:\\/\\/localhost\\/app\\/repair-orders\\/1\\/worksheet-sessions\\/release',\\n\n            broadcastEnabled: false,\\n\n            broadcastChannel: 'operations.repair-orders.1',\\n\n        }), arkWorksheetContinuity({\\n\n            worksheetScopeId: 'estimate-lines',\\n\n            continuityPanelIds: ['worksheet-status-flash', 'ro-identity-band', 'ro-inspection-tab-signal', 'visit-reason', 'estimate-builder-rail', 'estimate-total-panel', 'review-toolbar', 'workspace-modal-host', 'ro-orientation-header', 'ark-page-context'],\\n\n            conflictFragment: 'estimate-lines',\\n\n            refreshScopeMap: {\\n\n                worksheet: 'estimate-lines',\\n\n                rail: 'estimate-builder-rail',\\n\n                toolbar: 'review-toolbar',\\n\n                financial: 'estimate-builder-rail',\\n\n            },\\n\n        }), {\\n\n            partsMatrices: JSON.parse('[{\\u0022key\\u0022:\\u0022aft-parts\\u0022,\\u0022name\\u0022:\\u0022AFT Parts\\u0022,\\u0022is_default\\u0022:true,\\u0022rows\\u0022:[{\\u0022min_cost\\u0022:\\u00220.00\\u0022,\\u0022max_cost\\u0022:\\u00225.00\\u0022,\\u0022markup_percentage\\u0022:\\u0022180.00\\u0022,\\u0022sort_order\\u0022:1,\\u0022margin_percentage\\u0022:\\u002264\\u0022},{\\u0022min_cost\\u0022:\\u00225.01\\u0022,\\u0022max_cost\\u0022:\\u002210.00\\u0022,\\u0022markup_perce