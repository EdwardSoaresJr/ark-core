     >\\n\n                                    <span class=\"status-dot status-secondary\" aria-hidden=\"true\"></span>\\n\n                                    <span class=\"d-none d-sm-inline\">Not Started</span>\\n\n                                    <span class=\"visually-hidden d-sm-none\">Not Started</span>\\n\n                                </span>\\n\n                                                                                </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-recommendations\"\\n\n                            aria-controls=\"repair-order-workspace-panel-recommendations\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"recommendations\"\\n\n                            :class=\"{ active: tab === 'recommendations' }\"\\n\n                            x-on:click=\"selectTab('recommendations')\"\\n\n                            :aria-selected=\"tab === 'recommendations'\"\\n\n                        >\\n\n                            Recommendations\\n\n                                                                                </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"repair-order-workspace-tab-comms\"\\n\n                            aria-controls=\"repair-order-workspace-panel-comms\"\\n\n                            class=\"nav-link\"\\n\n                            data-workspace-tab=\"comms\"\\n\n                            :class=\"{ active: tab === 'comms' }\"\\n\n        