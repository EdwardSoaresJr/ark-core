                      <option value=\"1\" >Elvera Kemmer</option>\\n\n                                                    </select>\\n\n                        <button type=\"submit\" class=\"btn\">Assign</button>\\n\n                    </div>\\n\n                </form>\\n\n                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"8JPmymLFOt6WtZONikhV9hiL5CmQZO8xcHzF1xXQ\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"follow_up\"><input type=\"hidden\" name=\"filter\" value=\"waiting\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-23T19:11:40+00:00\">\\n\n                    <label class=\"form-label small mb-1\" for=\"comms-work-due-menu\">Follow up on</label>\\n\n                    <div class=\"input-group input-group-sm\">\\n\n                        <input id=\"comms-work-due-menu\" type=\"datetime-local\" name=\"due_at\" value=\"2026-11-25T08:00\" required class=\"form-control\">\\n\n                        <button type=\"submit\" class=\"btn\">Set</button>\\n\n                    </div>\\n\n                </form>\\n\n                <div class=\"dropdown-divider\"></div>\\n\n                                <form method=\"POST\" action=\"http://localhost/app/communications/conversations/1/work\">\\n\n                    <input type=\"hidden\" name=\"_token\" value=\"8JPmymLFOt6WtZONikhV9hiL5CmQZO8xcHzF1xXQ\" autocomplete=\"off\">                    <input type=\"hidden\" name=\"action\" value=\"unread\"><input type=\"hidden\" name=\"filter\" value=\"waiting\"><input type=\"hidden\" name=\"owner\" value=\"everyone\"><input type=\"hidden\" name=\"posture_changed_at\" value=\"2026-11-23T19:11:40+00:00\">\\n\n                    <button type=\"submit\" class=\"dropdown-item\" data-comms-work-unread>\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                        Mark unread\\n\n                    </button>\\n\n                </form>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n                                    </div>\\n\n            </div>\\n\n            </div>\\n\n\\n\n            <section class=\"alert alert-warning m-2 mb-0 py-2 small\" aria-label=\"What to do next\" data-comms-decision=\"waiting\">\\n\n    <div class=\"fw-bold\">\\n\n        Waiting\\n\n            </div>\\n\n                <div class=\"text-secondary d-none d-xxl-block\">Open - waiting on the customer since Nov 23 \u00b7 12:11 PM. Not forgotten.</div>\\n\n    \\n\n    \\n\n    \\n\n</section>\\n\n    \\n\n    <div class=\"ark-comms-thread-wrap position-relative d-flex flex-column flex-fill\">\\n\n    <div\\n\n        id=\"comms-workspace-thread-messages\"\\n\n        class=\"card-body chat-bubbles ark-comms-thread gap-2 overflow-auto flex-fill p-2 p-md-3\"\\n\n        data-comms-thread-body\\n\n        aria-label=\"Conversation\"\\n\n                    data-mark-read-url=\"http://localhost/app/communications/conversations/1/mark-read\"\\n\n            data-conversation-key=\"conversation:1\"\\n\n            >\\n\n                                <div class=\"text-center text-secondary small mt-1\" data-comms-date=\"2026-11-23\">Mon, Nov 23, 2026</div>\\n\n        <div data-comms-entry=\"conversation_message:1\">\\n\n            <div\\n\n        class=\"d-flex justify-content-end\"\\n\n            >\\n\n        <div class=\"d-flex flex-column align-items-end\" style=\"max-width: 88%\">\\n\n        <article\\n\n            class=\"chat-bubble px-3 py-2 chat-bubble-me\"\\n\n            data-comms-bubble=\"outbound\"\\n\n        >\\n\n            <div class=\"chat-bubble-title small text-secondary\">\\n\n                                    <span class=\"badge bg-secondary-lt me-1\" data-comms-channel>SMS</span>\\n\n                                Outgoing\\n\n                                \u00b7 Nov 23, 12:11 PM\\n\n                            </div>\\n\n            <div class=\"chat-bubble-body\">\\n\n                                                    <p class=\"mb-0\" style=\"white-space: pre-wrap\">We sent the estimate.</p>\\n\n                                                                                                                                        <details class=\"mt-1 small\" data-comms-details>\\n\n                        <summary class=\"text-secondary\">Details</summary>\\n\n                        <ul class=\"list-unstyled mb-0 mt-1\">\\n\n                                                            <li>Text message</li>\\n\n                                                            <li>Sent Nov 23, 12:11 PM by Pedro Benavides</li>\\n\n                                                                                </ul>\\n\n                    </details>\\n\n                            </div>\\n\n        </article>\\n\n                        </div>\\n\n    </div>\\n\n        </div>\\n\n            </div>\\n\n        <button type=\"button\" class=\"btn btn-primary btn-sm rounded-pill shadow position-absolute bottom-0 start-50 translate-middle-x mb-2 d-none\" data-comms-new-below>\\n\n            New messages\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M12 5l0 14\"/><path d=\"M18 13l-6 6\"/><path d=\"M6 13l6 6\"/></svg>\\n\n        </button>\\n\n    </div>\\n\n\\n\n    \\n\n            <footer class=\"card-footer p-0\" data-comms-composer>\\n\n            \\n\n                        <div x-data=\"{ tab: 'internal' }\" data-comms-composer-tabs>\\n\n            <ul class=\"nav nav-tabs px-2 pt-1\" role=\"tablist\" aria-label=\"Reply, email, or note\">\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"comms-composer-tab-reply\"\\n\n                            aria-controls=\"comms-composer-panel-reply\"\\n\n                            class=\"nav-link\"\\n\n                            :class=\"{ active: tab === 'reply' }\"\\n\n                            :aria-selected=\"(tab === 'reply').toString()\"\\n\n                                                            disabled\\n\n                                title=\"Texting is not set up for this shop.\"\\n\n                                data-comms-composer-unavailable=\"Texting is not set up for this shop.\"\\n\n                                                    >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M8 9h8\"/><path d=\"M8 13h6\"/><path d=\"M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12\"/></svg>\\n\n                            SMS\\n\n                        </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"comms-composer-tab-email\"\\n\n                            aria-controls=\"comms-composer-panel-email\"\\n\n                            class=\"nav-link\"\\n\n                            :class=\"{ active: tab === 'email' }\"\\n\n                            :aria-selected=\"(tab === 'email').toString()\"\\n\n                                                            disabled\\n\n                                title=\"This conversation is by text. Email the customer from the Customer panel.\"\\n\n                                data-comms-composer-unavailable=\"This conversation is by text. Email the customer from the Customer panel.\"\\n\n                                                    >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                            Email\\n\n                        </button>\\n\n                    </li>\\n\n                                    <li class=\"nav-item\" role=\"presentation\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            role=\"tab\"\\n\n                            id=\"comms-composer-tab-internal\"\\n\n                            aria-controls=\"comms-composer-panel-internal\"\\n\n                            class=\"nav-link\"\\n\n                            :class=\"{ active: tab === 'internal' }\"\\n\n                            :aria-selected=\"(tab === 'internal').toString()\"\\n\n                                                            @click=\"tab = 'internal'\"\\n\n                                                    >\\n\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\"/><path d=\"M9 9l1 0\"/><path d=\"M9 13l6 0\"/><path d=\"M9 17l6 0\"/></svg>\\n\n                            Internal note\\n\n                        </button>\\n\n                    </li>\\n\n                            </ul>\\n\n\\n\n            <div\\n\n                id=\"comms-composer-panel-reply\"\\n\n                role=\"tabpanel\"\\n\n                aria-labelledby=\"comms-composer-tab-reply\"\\n\n                x-show=\"tab === 'reply'\"\\n\n                x-cloak\\n\n            >\\n\n                \\n\n                                    <div\\n\n                                    id=\"comms-thread-composer\"\\n\n                                data-ark-workspace-dirty=\"off\"\\n\n                data-ark-conversation-composer\\n\n                                x-data=\"arkConversationQuickReply(JSON.parse('{\\u0022sendUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-messages?conversation_id=1\\u0022,\\u0022repairOrderId\\u0022:null,\\u0022sendEstimateUrl\\u0022:null,\\u0022cancelScheduledEstimateUrl\\u0022:null,\\u0022cancelScheduledSmsUrl\\u0022:\\u0022http:\\\\\\/\\\\\\/localhost\\\\\\/app\\\\\\/api\\\\\\/customers\\\\\\/1\\\\\\/conversation-actions\\\\\\/cancel-scheduled-sms\\u0022,\\u0022sendPaymentUrl\\u0022:null,\\u0022sendDepositUrl\\u0022:null,\\u0022sendInspectionUrl\\u0022:null,\\u0022messageActions\\u0022:[],\\u0022contextEstimateSend\\u0022:null,\\u0022contextPaymentSend\\u0022:null,\\u0022contextDepositSend\\u0022:null,\\u0022contextInspectionSend\\u0022:null,\\u0022estimateSchedule\\u0022:{\\u0022shop_is_open\\u0022:true,\\u0022pending\\u0022:null},\\u0022smsSchedule\\u0022:{\\u0022shop_is_open\\u0022:true,\\u0022next_open_morning_label\\u0022:\\u0022Wed Nov 25 \u00b7 8:00 AM\\u0022,\\u0022upcoming\\u0022:[{\\u0022scheduled_for\\u0022:\\u00222026-11-25T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Wed Nov 25 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-25\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-26T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Thu Nov 26 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-26\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-27T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Fri Nov 27 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-27\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-11-30T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Mon Nov 30 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-11-30\\u0022},{\\u0022scheduled_for\\u0022:\\u00222026-12-01T15:00:00+00:00\\u0022,\\u0022label\\u0022:\\u0022Tue Dec 1 \u00b7 8:00 AM\\u0022,\\u0022day_key\\u0022:\\u00222026-12-01\\u0022}],\\u0022pending\\u0022:null},\\u0022openRepairOrders\\u0022:[],\\u0022customerId\\u0022:1,\\u0022messagesListIds\\u0022:[\\u0022comms-workspace-thread-messages\\u0022],\\u0022hasConversationHistory\\u0022:true,\\u0022autoOpenComposer\\u0022:true,\\u0022alwaysOpen\\u0022:true,\\u0022keepOpenAfterSend\\u0022:true,\\u0022customerPhoneDisplay\\u0022:\\u0022(719) 555-3102\\u0022,\\u0022customerEmail\\u0022:\\u0022pedro.benavides.7195553102@example.test\\u0022,\\u0022estimateDelivery\\u0022:\\u0022email\\u0022,\\u0022paymentDelivery\\u0022:\\u0022email\\u0022,\\u0022depositDelivery\\u0022:\\u0022email\\u0022,\\u0022depositAmount\\u0022:\\u0022\\u0022,\\u0022canSmsEstimate\\u0022:false,\\u0022canEmailEstimate\\u0022:false,\\u0022canSmsPayment\\u0022:false,\\u0022canEmailPayment\\u0022:false,\\u0022canSmsDeposit\\u0022:false,\\u0022canEmailDeposit\\u0022:false,\\u0022canSmsInspection\\u0022:false,\\u0022showSmsComposer\\u0022:false,\\u0022sendEstimateAddVinUrl\\u0022:null,\\u0022nudgeKey\\u0022:null,\\u0022entityKey\\u0022:null,\\u0022initialBody\\u0022:null,\\u0022platformBacked\\u0022:false}'))\"\\n\n                \\n\n            >\\n\n                \\n\n                                <div x-show=\"estimateSchedule?.pending\" x-cloak class=\"alert alert-info m-2 mb-0 py-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                        <div>\\n\n                            Scheduled estimate \u00b7 <span x-text=\"estimateSchedule?.pending?.scheduled_for_label ?? estimateSchedule?.next_open_morning_label ?? smsSchedule?.next_open_morning_label ?? 'Next open morning'\"></span>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"cancelScheduledEstimate()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"smsSchedule?.pending\" x-cloak class=\"alert alert-info m-2 mb-0 py-2\">\\n\n                    <div class=\"d-flex flex-wrap align-items-center justify-content-between gap-2\">\\n\n                        <div>\\n\n                            Scheduled reply \u00b7 <span x-text=\"smsSchedule?.pending?.scheduled_for_label ?? smsSchedule?.next_open_morning_label ?? 'Next open morning'\"></span>\\n\n                            <span\\n\n                                x-show.important=\"smsSchedule?.pending?.preview\"\\n\n                                class=\"d-block text-secondary\"\\n\n                                x-text=\"smsSchedule?.pending?.preview\"\\n\n                            ></span>\\n\n                        </div>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"cancelScheduledSms()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"afterHoursPromptOpen\" x-cloak class=\"alert alert-warning m-2 mb-0 py-2\" role=\"alert\">\\n\n                    <div class=\"fw-bold\">It's after business hours.</div>\\n\n                    <div>\\n\n                        Send now, or schedule for\\n\n                        <span x-text=\"smsSchedule?.next_open_morning_label ?? 'next open morning'\"></span>?\\n\n                    </div>\\n\n                    <div class=\"btn-list mt-2\">\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"confirmAfterHoursTiming('now')\"\\n\n                        >Send Now</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-warning\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"confirmAfterHoursNextOpenMorning()\"\\n\n                        >Schedule</button>\\n\n                        <button\\n\n                            type=\"button\"\\n\n                            class=\"btn btn-sm btn-ghost-secondary\"\\n\n                            :disabled=\"sending\"\\n\n                            @click=\"dismissAfterHoursPrompt()\"\\n\n                        >Cancel</button>\\n\n                    </div>\\n\n                </div>\\n\n                <div class=\"d-flex flex-column\" data-comms-composer-stack>\\n\n                    <div\\n\n                        class=\"d-flex flex-wrap align-items-center gap-2 px-3 py-2 justify-content-between order-last border-top\"\\n\n                        role=\"group\"\\n\n                        aria-label=\"Conversation commands\"\\n\n                    >\\n\n                                                    <details\\n\n                                class=\"position-relative\"\\n\n                                x-ref=\"actionsMenu\"\\n\n                                @toggle=\"onActionsMenuToggle($event)\"\\n\n                                @click.outside=\"closeActionsMenu()\"\\n\n                            >\\n\n                                <summary class=\"btn btn-sm\">Actions</summary>\\n\n                                <div class=\"dropdown-menu show position-absolute bottom-100 mb-1\" data-comms-actions-panel>\\n\n                                                                            <a href=\"tel:+17195553102\" class=\"dropdown-item\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon dropdown-item-icon\"><path d=\"M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2\"/></svg>\\n\n                                            Call\\n\n                                        </a>\\n\n                                                                                                                                                                                                                                                        </div>\\n\n                            </details>\\n\n                                                                                                                                                </div>\\n\n\\n\n                    <div x-show=\"vinWarningOpen\" x-cloak class=\"alert alert-warning mx-3 mb-2\" role=\"alert\" data-estimate-vin-warning>\\n\n                        <div class=\"fw-bold\">VIN missing</div>\\n\n                        <div>\\n\n                            Parts lookup, labor guides, service history accuracy, and OEM information may be affected.\\n\n                        </div>\\n\n                        <div class=\"btn-list mt-2\">\\n\n                            <a :href=\"addVinUrl()\" class=\"btn btn-sm\" @click=\"cancelVinWarning()\">Add VIN</a>\\n\n                            <button type=\"button\" class=\"btn btn-sm btn-primary\" @click=\"continueWithoutVin()\">Continue anyway</button>\\n\n                        </div>\\n\n                    </div>\\n\n\\n\n                    <div x-show=\"showSmsComposer && open\" x-cloak>\\n\n                        <div class=\"px-3 py-2\">\\n\n                            <label class=\"visually-hidden\" for=\"comms-thread-composer-body\">Message</label>\\n\n                            <textarea\\n\n                                id=\"comms-thread-composer-body\"\\n\n                                x-ref=\"replyBody\"\\n\n                                x-model=\"body\"\\n\n                                rows=\"3\"\\n\n                                                                placeholder=\"Message or MMS to (719) 555-3102\"\\n\n                                :placeholder=\"composerPlaceholder()\"\\n\n                                class=\"form-control\"\\n\n                                @keydown.meta.enter.prevent=\"send()\"\\n\n                                @keydown.ctrl.enter.prevent=\"send()\"\\n\n                            ></textarea>\\n\n                                                            <div class=\"mt-2\">\\n\n                                    <div class=\"d-flex flex-wrap gap-1\" role=\"group\" aria-label=\"Quick replies\" data-comms-quick-replies>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for reaching out - we received your request and will follow up shortly with next steps.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Estimate received\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We can get you on the schedule. What day works best for you to bring the vehicle in?'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Scheduling\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'Thanks for your patience - we are running a little behind today but will get back to you as soon as possible.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Running behind\\n\n            </button>\\n\n                                <button\\n\n                type=\"button\"\\n\n                class=\"btn btn-sm \"\\n\n                data-quick-reply-color=\"neutral\"\\n\n                @click=\"body = 'We offer several payment options at checkout. Let us know if you would like an estimate sent over to review.'; $refs.replyBody?.focus()\"\\n\n            >\\n\n                Financing\\n\n            </button>\\n\n            </div>\\n\n                                </div>\\n\n                                                                                    <div x-show=\"error\" x-cloak class=\"mt-1 small text-danger fw-medium\" x-text=\"error\"></div>\\n\n                        </div>\\n\n                    </div>\\n\n                </div>\\n\n                <div x-show=\"error && ! open\" x-cloak class=\"alert alert-danger mx-3 mb-2\" role=\"alert\">\\n\n                    <div class=\"fw-bold\">Could not send</div>\\n\n                    <div x-text=\"error\"></div>\\n\n                </div>\\n\n            </div>\\n\n        \\n\n                                        </div>\\n\n\\n\n            \\n\n            <form\\n\n                id=\"comms-composer-panel-internal\"\\n\n                role=\"tabpanel\"\\n\n                aria-labelledby=\"comms-composer-tab-internal\"\\n\n                x-show=\"tab === 'internal'\"\\n\n                x-cloak\\n\n                method=\"POST\"\\n\n                action=\"http://localhost/app/communications/conversations/1/internal-note\"\\n\n            >\\n\n                <input type=\"hidden\" name=\"_token\" value=\"8JPmymLFOt6WtZONikhV9hiL5CmQZO8xcHzF1xXQ\" autocomplete=\"off\">                <input type=\"hidden\" name=\"section\" value=\"inbox\">\\n\n                <div class=\"px-3 py-2\">\\n\n                    <label class=\"visually-hidden\" for=\"comms-internal-note-body\">Internal note</label>\\n\n                    <textarea\\n\n                        id=\"comms-internal-note-body\"\\n\n                        name=\"body\"\\n\n                        rows=\"3\"\\n\n                        required\\n\n                        maxlength=\"2000\"\\n\n                        placeholder=\"Internal note - never sent to customer\"\\n\n                        class=\"form-control\"\\n\n                    ></textarea>\\n\n                </div>\\n\n                <div class=\"d-flex justify-content-end px-3 py-2 border-top\">\\n\n                    <button type=\"submit\" class=\"btn btn-yellow\">\\n\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\"/><path d=\"M9 9l1 0\"/><path d=\"M9 13l6 0\"/><path d=\"M9 17l6 0\"/></svg>\\n\n                        Add internal note\\n\n                    </button>\\n\n                </div>\\n\n            </form>\\n\n        </div>\\n\n    </footer>\\n\n    \\n\n    <div class=\"position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-25 z-3 d-none\" data-comms-switch aria-hidden=\"true\">\\n\n        <div class=\"d-flex h-100 align-items-center justify-content-center\">\\n\n            <div class=\"card card-sm shadow\">\\n\n                <div class=\"card-body d-flex align-items-center gap-2\">\\n\n                    <span class=\"spinner-border text-secondary\"></span>\\n\n                </div>\\n\n            </div>\\n\n        </div>\\n\n    </div>\\n\n</div>\\n\n            </section>\\n\n\\n\n            <aside\\n\n                id=\"ops-comms-workspace-context\"\\n\n                class=\"col-12 col-lg col-xl-3 flex-column\"\\n\n                :class=\"contextOpen ? 'd-flex' : 'd-none d-xl-flex'\"\\n\n                aria-label=\"Customer and work\"\\n\n            >\\n\n                <div class=\"card flex-fill overflow-hidden\" data-comms-context-card>\\n\n    <div class=\"card-header py-2 d-xl-none\">\\n\n        <button type=\"button\" class=\"btn btn-sm btn-ghost-secondary ps-0\" @click=\"contextOpen = false\">\\n\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon\"><path d=\"M5 12l14 0\"/><path d=\"M5 12l6 6\"/><path d=\"M5 12l6 -6\"/></svg>\\n\n            Back to conversation\\n\n        </button>\\n\n    </div>\\n\n            <div class=\"card-body overflow-auto flex-fill p-0\" data-comms-context-rail>\\n\n                        <section class=\"p-3 border-bottom\" aria-labelledby=\"comms-context-customer\">\\n\n                <div class=\"subheader mb-2\" id=\"comms-context-customer\">Customer</div>\\n\n                <div class=\"d-flex align-items-center gap-2\">\\