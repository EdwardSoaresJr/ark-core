ox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10\"/><path d=\"M3 7l9 6l9 -6\"/></svg>\\n\n                                        Email\\n\n                                    </a>\\n\n                            <a href=\"http://localhost/app/communications/inbox?filter=needs&amp;channel=portal\" class=\"dropdown-item\" data-ark-inbox-channel=\"portal\">\\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\"/><path d=\"M3.6 9h16.8\"/><path d=\"M3.6 15h16.8\"/><path d=\"M11.5 3a17 17 0 0 0 0 18\"/><path d=\"M12.5 3a17 17 0 0 1 0 18\"/></svg>\\n\n                                        Portal\\n\n                                    </a>\\n\n                        <div class=\"dropdown-divider\"></div>\\n\n            <a href=\"#\" class=\"dropdown-item\" data-ops-global-search-open>\\n\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\" class=\"icon me-2 text-secondary\"><path d=\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"/><path d=\"M21 21l-6 -6\"/></svg>\\n\n                Search conversations\\n\n            </a>\\n\n        </div>\\n\n    </div>\\n\n</nav>\\n\n                                        <div\\n\n        class=\"nav-item d-flex align-items-center\"\\n\n        data-ark-workstation-presence\\n\n        data-locked=\"0\"\\n\n        data-needs-binding=\"0\"\\n