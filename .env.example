# =============================================================================
# ARK environment example
# -----------------------------------------------------------------------------
# REQUIRED BOOTSTRAP - needed before/during first-run (or inject via platform):
#   APP_KEY, APP_URL, DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# Normal installs use the browser wizard at /setup instead of hand-editing this file.
#
# OPTIONAL INTEGRATIONS - leave empty; configure in Settings after install:
#   labor-guide URLs, etc.
# =============================================================================

APP_NAME=ARK
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Email verification (staff / cloud accounts). Null = auto (off on local + demo.* hosts).
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Surface domains (deploy / local routing only - not shop content)
# PUBLIC_DOMAIN is optional customer/portal host routing, not a marketing website product.
# SURFACE_DOMAINS_ENABLED=true
# APP_DOMAIN=app.demo-auto.test
# PORTAL_DOMAIN=portal.demo-auto.test
# PUBLIC_DOMAIN=demo-auto.test
# Extra public hostnames for the same website. Comma-separated. Not a second publication.
# SURFACE_PUBLIC_ALIASES=
# LEARN_DOMAIN=learn.demo-auto.test

# Optional external booking origin. Core serves /book when this is empty.
# BOOKING_SURFACE_BASE_URL=
# BOOKING_SURFACE_ENFORCE=true
# BOOKING_SURFACE_PROTECTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Optional. Published images write /app/.ark-source-commit; do not put a git SHA in ARK_IMAGE_DIGEST.
# APP_VERSION=
# APP_RELEASE=
# APP_COMMIT=
# ARK_SOURCE_COMMIT_FILE=/app/.ark-source-commit
# ARK_IMAGE_DIGEST=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ark
DB_USERNAME=root
DB_PASSWORD=

# Compose installs set this so /setup uses the runtime database without asking for credentials.
# ARK_MANAGED_DATABASE=true

# Legacy ARK-SMS database (read-only import source)
ARKSMS_LEGACY_HOST=127.0.0.1
ARKSMS_LEGACY_PORT=3306
ARKSMS_LEGACY_DATABASE=arksms
ARKSMS_LEGACY_USERNAME=root
ARKSMS_LEGACY_PASSWORD=
# First-run / self-host defaults: file drivers (no Redis required).
# Production shops may switch to redis/database after install.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
ARK_ECOSYSTEM_COOKIE_DOMAIN=
ARK_OPERATIONS_URL=
ARK_ARKADEMY_URL=
ARK_PLATFORM_URL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=
HORIZON_PREFIX=

REVERB_APP_ID=ark-sms-local
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Public WebSocket host for browsers. Optional - when unset, derived from APP_URL host.
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Server-side publish API (Laravel -> Reverb). Always internal; not the browser host.
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT="${REVERB_SERVER_PORT}"
REVERB_BROADCAST_SCHEME=http

# Vite build-time fallbacks only. Runtime Echo uses window.location.hostname + meta ark-reverb-app-key.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=
# VITE_REVERB_SCHEME=

# Mail - local log/array for development; production customer email uses ARK Email via Settings.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@demo-auto.test
MAIL_FROM_NAME="${APP_NAME}"
# ARK Email is configured in Settings (Cloud pairing). Do not paste provider API tokens into Core.
# ARK_MAIL_SERVICE_URL=
# ARK_PLATFORM_BASE_URL=
# Deprecated alias - dual-read with ARK_PLATFORM_BASE_URL
ARK_CLOUD_BASE_URL=https://cloud.arksms.com
# ARK_CLOUD_OFFLINE_RECOVERY_PUBLIC_KEY=
# Optional reply-to defaults (also editable in Settings → Email)
# MAIL_REPLY_TO_ADDRESS=hello@demo-auto.test
# MAIL_REPLY_TO_NAME=
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

# Error reporting - email on server errors (500+). Throttled to avoid duplicate alerts.
ERROR_REPORT_ENABLED=true
ERROR_REPORT_EMAIL=you@example.com
ERROR_REPORT_THROTTLE=300
ERROR_REPORT_QUEUE=true
ERROR_REPORT_FILE_ENABLED=true
ERROR_REPORT_FILE_RETENTION_DAYS=30

# Operational reports - ignore repair orders opened before this date (legacy cleanup window).
OPERATIONAL_REPORT_TRUSTWORTHY_START=2026-06-01

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Telephony ingress (optional server fallback - prefer Settings → Communications).
# Shop deployment origin - all HTTP capability URLs derive from this (defaults to APP_URL).
SHOP_BASE_URL=

# ARK Platform company product (autorepairkeeper.com). Empty locally → /cloud on app host.
# COMPANY_DOMAIN=autorepairkeeper.com

# Public Cloud marketing posture (company site). Self-host install is unaffected.
# ARK_CLOUD_PUBLIC_SIGNUPS=false
# ARK_CLOUD_PUBLIC_PRICING=false
# ARK_CLOUD_INTEREST_EMAIL=hello@autorepairkeeper.com
# COMPANY_WWW_DOMAIN=www.autorepairkeeper.com
# CLOUD_APP_DOMAIN=app.autorepairkeeper.com

# ARK Platform Coolify adapter (Sprint 2 - prove contract; default milestone 1 = authenticate only)
# COOLIFY_ENABLED=false
# COOLIFY_BASE_URL=https://platform.autorepairkeeper.com
# COOLIFY_API_TOKEN=
# COOLIFY_TIMEOUT=15
# COOLIFY_ADAPTER_MILESTONE=1
# COOLIFY_DEPLOY_APPLICATION_UUID=
# COOLIFY_POLL_INTERVAL=2
# COOLIFY_POLL_TIMEOUT=60

# Desk phone microbrowser - http avoids VVX TLS handshake failures (token-gated read-only screen).
SHOP_MICROBROWSER_SCHEME=http


# ARK Mobile push - optional server file fallback when JSON is not stored in Settings.
# Mobile push - platform transport (one Firebase project for the ARK Staff app binary).
# Not configured per shop in Settings. Mount service account JSON on the runtime host.
# FCM_ENABLED=true enables push by default when shop has not set mobile_push.enabled.
# FIREBASE_PROJECT_ID= optional override; otherwise read from service account JSON project_id.
# Production example: /data/ark-shared/secrets/firebase-mobile-service-account.json
# FCM_ENABLED=true
# FIREBASE_CREDENTIALS=

# Repair Time Engine (RTE labor guide). null = auto-detect; false = hide; true = force on.
# RTE_LABOR_GUIDE_ENABLED=

# Labor guides (browser launch - set URLs to your shop login entry points).
LABOR_GUIDE_ALLDATA_URL=https://my.alldata.com/repair
LABOR_GUIDE_ALLDATA_LOGIN_PATH=
LABOR_GUIDE_PRODEMAND_URL=https://www.prodemand.com
LABOR_GUIDE_PRODEMAND_LOGIN_PATH=

# Estimate PDFs (Browsershot + Puppeteer). Leave blank locally - ARK auto-discovers Herd Node + ~/.cache/puppeteer Chrome.
# After npm install: npx puppeteer browsers install chrome
# Production: infra/releasepanel/install-pdf-runtime.sh sets PDF_* and PUPPETEER_CACHE_DIR on the VPS.
PDF_NODE_BINARY=
PDF_NPM_BINARY=
PDF_CHROME_PATH=
PUPPETEER_CACHE_DIR=
PDF_INCLUDE_PATH=
PDF_NO_SANDBOX=false

# QZ Tray signing (label printing). PEM paths outside public/; chmod 600 private key, 644 cert.
# Production: store under shared storage on the VPS (see docs/printing/qz-certificate-investigation.md).
# Development POC (ARK-owned self-signed chain - do not deploy these files):
#   bash infra/qz-dev/generate-ark-printing-certs.sh
#   QZ_CERTIFICATE_PATH=infra/qz-dev/certs/digital-certificate.txt
#   QZ_PRIVATE_KEY_PATH=infra/qz-dev/certs/private-key.pem
# See docs/printing/ark-self-signed-feasibility.md
QZ_CERTIFICATE_PATH=
QZ_PRIVATE_KEY_PATH=
QZ_PRIVATE_KEY_PASSPHRASE=
QZ_SIGNATURE_ALGORITHM=sha512


# ARK-hosted Dragon. Stock Core has no hosted model provider; tests may set DRAGON_PROVIDER=fake.
# Import arkai knowledge/memories (does not contact arkai):
# php artisan dragon:import-arkai-dump
# Floor quality cert: php artisan dragon:floor-bakeoff --dry-run

# Handheld voice lab (ESP WAV → STT only). Off in production. Not VoiceDevice / Dragon / TTS.
# VOICE_LAB_ENABLED=true
# VOICE_LAB_SECRET=generate-a-long-random-string

# LugsNPlugs cutover: keep website/Growth tables. Omit on fresh public installs.
# ARK_PRESERVE_WEBSITE_GROWTH_SCHEMA=true
